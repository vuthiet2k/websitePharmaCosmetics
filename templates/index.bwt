<h1 class="visually-hidden">{{store.name}} - {{store.description}}</h1>
{%- comment -%}
  Whitelist các section hợp lệ — PHẢI khớp với options nhóm "Trang chủ" trong settings_schema.json.
  Guard này tránh lỗi "file section_xxx.bwt không tìm thấy" khi settings (data trên store) còn sót
  giá trị module cũ đã bị xóa snippet. Thêm section mới: cập nhật cả đây và schema.
{%- endcomment -%}
{%- comment -%}
  REOPEN 2026-09-11: thêm 4 section mới (clinical_banner/trust_strip/protocol/zalo_consult) —
  phát hiện thiếu khi đối chiếu với Pharma_Cosmetics_Desktop_Homepage_Figma_260-84.html (mockup
  gốc trong "Pharma Cosmetics-20260910T092731Z-1-001/Pharma Cosmetics/"), theo yêu cầu người
  dùng test giao diện sau REOPEN ADR-007.
{%- endcomment -%}
{%- comment -%}
  REOPEN 2026-09-13: thêm rail nav chấm bên trái (theo design/homepage-concepts/
  v2-clinical-dashboard.html mà người dùng chọn) — bọc mỗi section đang bật trong
  <div id="{{ sec }}"> để làm anchor cho scrollspy, KHÔNG sửa nội dung/logic bên trong
  từng section_*.bwt. Nhãn rail lấy từ map cố định theo tên section, ẩn dưới 1280px
  vì không đủ chỗ và tránh đè lên nội dung mobile.
{%- endcomment -%}
{% assign valid_sections = 'section_hero,section_flash_sale,section_solutions,section_brand_marquee,section_spa,section_why_us,section_testimonials,section_feedback,section_ingredients,section_featured_products,section_collection_bestseller,section_collection_cta,section_stats,section_expert_team,section_clinical_banner,section_trust_strip,section_protocol,section_zalo_consult' | split: ',' %}

{%- capture rail_sections_csv -%}
{%- for i in (1..18) -%}
{%- capture enable -%}home_section_{{i}}{%- endcapture -%}
{%- assign sec = settings[enable] -%}
{%- if sec and sec != 'none' and valid_sections contains sec -%}{{ sec }},{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign rail_sections = rail_sections_csv | split: ',' -%}

{%- if rail_sections.size > 1 -%}
<nav class="pc-rail" id="pcRail" aria-label="Điều hướng nhanh trang chủ">
  {%- for sec in rail_sections -%}
  {%- capture rail_label -%}
    {%- case sec -%}
      {%- when 'section_hero' -%}Đầu trang
      {%- when 'section_flash_sale' -%}Flash Sale
      {%- when 'section_trust_strip' -%}Cam kết
      {%- when 'section_solutions' -%}Giải pháp
      {%- when 'section_featured_products' -%}Sản phẩm nổi bật
      {%- when 'section_protocol' -%}Quy trình
      {%- when 'section_expert_team' -%}Chuyên gia
      {%- when 'section_testimonials' -%}Minh chứng
      {%- when 'section_spa' -%}Skin Health Beauty
      {%- when 'section_brand_marquee' -%}Thương hiệu
      {%- when 'section_ingredients' -%}Khoa học
      {%- when 'section_zalo_consult' -%}Tư vấn AI
      {%- when 'section_clinical_banner' -%}Chuyên khoa
      {%- when 'section_why_us' -%}Vì sao chọn
      {%- when 'section_feedback' -%}Đánh giá
      {%- when 'section_collection_bestseller' -%}Bán chạy
      {%- when 'section_collection_cta' -%}Danh mục
      {%- when 'section_stats' -%}Số liệu
      {%- else -%}{{ sec }}
    {%- endcase -%}
  {%- endcapture -%}
  <button type="button" data-target="#{{ sec }}" aria-label="{{ rail_label | strip }}">
    <span class="pc-rail-tooltip">{{ rail_label | strip }}</span>
  </button>
  {%- endfor -%}
</nav>
<style>
  .pc-rail{position:fixed;left:22px;top:50%;transform:translateY(-50%);z-index:900;display:flex;flex-direction:column;gap:14px}
  .pc-rail button{width:8px;height:8px;padding:0;border-radius:50%;background:var(--line,#E2E8F0);border:none;cursor:pointer;transition:transform .25s,background .25s;position:relative}
  .pc-rail button.is-active{background:var(--mainColor,#3CB371);transform:scale(1.5)}
  .pc-rail-tooltip{position:absolute;left:16px;top:50%;transform:translateY(-50%);white-space:nowrap;background:var(--ink,#13241F);color:#fff;font-family:var(--font-secondary,'Inter',sans-serif);font-size:11px;font-weight:600;padding:4px 10px;border-radius:4px;opacity:0;pointer-events:none;transition:opacity .2s}
  .pc-rail button:hover .pc-rail-tooltip{opacity:1}
  @media (max-width: 1280px){ .pc-rail{display:none} }
</style>
<script>
(function(){
  // QUAN TRỌNG: script này nằm TRƯỚC các <div id="section_..."> trong luồng HTML
  // (rail nav render trước nội dung để giữ đúng vị trí fixed từ đầu trang) — nên
  // phải đợi DOMContentLoaded trước khi querySelector các target, nếu không
  // document.querySelector trả về null hết vì các div đó chưa được parse.
  function init(){
    var rail = document.getElementById('pcRail');
    if (!rail) return;
    var buttons = Array.prototype.slice.call(rail.querySelectorAll('button'));
    var targets = buttons.map(function(b){ return document.querySelector(b.getAttribute('data-target')); }).filter(Boolean);
    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){
        var el = document.querySelector(btn.getAttribute('data-target'));
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      });
    });
    if (!targets.length) return;
  // Scrollspy theo mốc "đầu section gần nhất phía trên đường tham chiếu" —
  // đáng tin cậy hơn IntersectionObserver threshold cố định vì các section
  // trang chủ cao thấp rất khác nhau (nhiều section cao hơn hẳn viewport).
  var scrollTimer = null;
  function updateActive(){
    var refY = window.innerHeight * 0.35;
    var activeIdx = 0;
    for (var i = 0; i < targets.length; i++) {
      if (targets[i].getBoundingClientRect().top <= refY) activeIdx = i;
    }
    buttons.forEach(function(b){ b.classList.remove('is-active'); });
    buttons[activeIdx].classList.add('is-active');
  }
  // setTimeout thay vì requestAnimationFrame để throttle — rAF có thể không
  // được trình duyệt cấp phát đều đặn khi tab/khung nhìn không active.
  window.addEventListener('scroll', function(){
      if (scrollTimer) return;
      scrollTimer = setTimeout(function(){ scrollTimer = null; updateActive(); }, 80);
    }, { passive: true });
    updateActive();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
{%- endif -%}

{% for sec in rail_sections %}
<div id="{{ sec }}">{% include sec %}</div>
{% endfor %}
<div class="ab-most-view-product-module ab-hide"></div>
