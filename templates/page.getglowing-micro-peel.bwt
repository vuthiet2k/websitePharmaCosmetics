{% layout 'theme' %}
{%- comment -%}
  templates/page.getglowing-micro-peel.bwt — Trang dịch vụ GetGlowing Micro-Peel chuẩn y khoa.
  Dự án: Pharma Cosmetics — Skin Health Beauty (Hà Nội).
  Kế thừa: layout master 'theme.bwt'.
  Cấu trúc: 7 module y khoa chuyên biệt, độc lập khỏi catalog sản phẩm.
  Dữ liệu hình ảnh: Hỗ trợ nạp trực tiếp từ khung soạn thảo page.content qua cơ chế Tagged Alt Text ([hero-desktop], [concern-1]..[concern-5], [product-kit]) kết hợp fallback y khoa mặc định.
{%- endcomment -%}

{{ 'service-getglowing.css' | asset_url | stylesheet_tag }}

<div id="getglowing-service-page" class="pc-peel-page bg-slate-50 text-slate-800 font-sans antialiased">
  {%- comment -%} Thẻ chứa dữ liệu thô ẩn phục vụ cơ chế Tagged Image Pipeline từ page.content {%- endcomment -%}
  <div id="service-raw-data" class="hidden" style="display: none;" aria-hidden="true">
    {{ page.content }}
  </div>

  {%- comment -%} Breadcrumb Y khoa {%- endcomment -%}
  <div class="pc-peel-breadcrumb bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex text-xs text-slate-500 gap-2 items-center" aria-label="Breadcrumb">
        <a href="/" class="hover:text-emerald-700 transition-colors">Trang chủ</a>
        <span aria-hidden="true" class="text-slate-300">/</span>
        <a href="/dich-vu" class="hover:text-emerald-700 transition-colors">Dịch vụ Clinic</a>
        <span aria-hidden="true" class="text-slate-300">/</span>
        <span class="text-slate-800 font-semibold" aria-current="page">GetGlowing Micro-Peel Hà Nội</span>
      </nav>
    </div>
  </div>

  {%- comment -%} 7 Module Giao diện Chuẩn Bàn giao IT {%- endcomment -%}
  {% include 'service_getglowing_banner' %}
  {% include 'service_getglowing_concerns' %}
  {% include 'service_getglowing_mechanism' %}
  {% include 'service_getglowing_steps' %}
  {% include 'service_getglowing_cases' %}
  {% include 'service_getglowing_info_cta' %}
  {% include 'service_getglowing_faq' %}
</div>

<script defer src="{{ 'service-getglowing.js' | asset_url }}"></script>
