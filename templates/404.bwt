{% include 'breadcrumb' %}
<section class="py-12 lg:py-16 text-center">
	<div class="container mx-auto px-4">
		<div class="mx-auto max-w-lg flex flex-col items-center">
			{%- if settings.page_404_image != blank -%}
			<img class="mb-6 h-auto max-w-full" src="{{ settings.page_404_image | img_url: 'grande' }}" width="536" height="341" alt="Không tìm thấy trang"/>
			{%- endif -%}
			<h1 class="mb-3 text-2xl font-bold text-ink sm:text-3xl">Oops! Trang bạn tìm kiếm không tồn tại.</h1>
			<p class="mb-6 text-sm text-slate-500 leading-relaxed sm:text-base">Chúng tôi không thể tìm thấy trang bạn yêu cầu.<br/> Bạn vui lòng trở lại trang chủ, thử tìm kiếm với từ khóa khác hoặc tiếp tục mua sắm!</p>
			<a href="/" class="inline-flex min-h-11 items-center justify-center rounded-full bg-btn px-6 text-sm font-semibold text-white no-underline transition-colors hover:bg-btn-hover">
				QUAY LẠI TRANG CHỦ
			</a>
		</div> 
	</div>
</section>
