{% layout none %}
{%- comment -%} 2026-10-08: kết quả lọc AJAX của trang danh mục cũng in sao đánh giá thật như lần tải đầu. {%- endcomment -%}
{%- assign pc_card_rating = true -%}
<div class="category-products">
	<div class="section">
		{%include 'collection-sortby'%}
	</div>
	{% paginate search.results by settings.collection_number_product %}	
	{% if search.results.size > 0 %}
	{%- comment -%} 14/11/2026: lưới + thẻ sản phẩm 100% class Tailwind (ui_product_card — thẻ duy nhất của theme). {%- endcomment -%}
	<ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 lg:gap-4 xl:grid-cols-4 [html[data-pc-view=list]_&]:grid-cols-1">
		{% for product in search.results %}
		<li class="min-w-0">{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: true -%}</li>
		{% endfor %}
	</ul>
	{% else %}
	<div class="alert alert-warning green-alert section" role="alert">
		Không có sản phẩm nào trong danh mục này.
	</div>
	{% endif %}
	{% if paginate.pages > 1 %}
	<div>
		{% if paginate.pages > 1 %}
		{% include 'collection-paginate-pages' %}
		{% endif %}
	</div>
	{%endif%}
	{% endpaginate %}
</div>