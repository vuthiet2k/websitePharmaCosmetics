{%- comment -%}
  page.clinical-proof.bwt (T-34) — trang "Trước & Sau · Chăm sóc da từ xa".
  2026-10-07: dựng lại theo thiết kế người dùng gửi (Claude Design "Pharma Cosmetics - Trước và Sau", 2 artboard
  Máy tính 1360 / Điện thoại 390: hero + ảnh trước/sau, dải điểm mạnh, 4 bước chăm sóc từ xa,
  mốc thời gian, kết quả khách hàng theo nhóm vấn đề da có điều hướng từng ca, khối CTA cuối). Header/footer dùng
  layout chung của theme (không dựng header/footer riêng như bản thiết kế).

  Nguồn dữ liệu:
  - Câu chữ, link, ảnh hero: Theme Settings → "Trang Minh chứng lâm sàng" (field clinical_*). Ảnh hero trống ⇒ lấy
    cặp ảnh của ca đầu tiên có đủ ảnh; không có ca nào ⇒ hero chỉ còn chữ.
  - Ca khách hàng = bài viết trong blog settings.clinical_case_blog_handle (mặc định truoc-va-sau-1 — trên Sapo alias truoc-va-sau đã thuộc một Trang nội dung), đọc qua
    snippets/ba_case_source.bwt (2026-10-17): ảnh trước/sau = tag anhtruoc:/anhsau: HOẶC 2 ảnh đầu chèn trong nội dung
    bài (BẮT BUỘC đủ 2 ảnh, thiếu ⇒ không hiện ca). Hướng dẫn nhập: docs/huong-dan-tao-ca-truoc-sau.md. Tag phụ
    nhom:<vấn đề da> (gom nhóm; không có ⇒ nhóm clinical_group_other), tuoi:<số>, tinh:<tỉnh/thành>,
    tuan:<số tuần theo dõi>, phacdo:<tên phác đồ/sản phẩm chính>. Thiếu tag nào ⇒ ẩn phần đó.
    Chỉ đăng ca thật đã được khách đồng ý công bố — theme không tự sinh ca/số liệu.
  - 2026-10-18: kết quả = tab lọc theo nhom: + lưới thẻ ảnh (cả thẻ là link chi tiết ca); không còn nút tư vấn từng ca —
    lời mời tư vấn chỉ ở hero + khối cuối.
{%- endcomment -%}
{%- assign pc_ba_blog_handle = settings.clinical_case_blog_handle | default: 'truoc-va-sau-1' -%}
{%- assign pc_ba_blog = blogs[pc_ba_blog_handle] -%}
{%- assign pc_ba_cta_link = settings.clinical_hero_cta_link | default: '/kham-da-ai' -%}
{%- assign pc_ba_group_other = settings.clinical_group_other | default: 'Kết quả khác' -%}

{%- comment -%} Lượt 1: gom tên nhóm (giữ thứ tự xuất hiện) + tìm cặp ảnh dự phòng cho hero. {%- endcomment -%}
{%- assign pc_ba_groups = '' -%}{%- assign pc_ba_has_other = false -%}
{%- assign pc_ba_first_before = '' -%}
{%- assign pc_ba_first_after = '' -%}
{%- assign pc_ba_first_title = '' -%}
{%- for pc_ba in pc_ba_blog.articles limit: 50 -%}
  {%- assign pc_bs_article = pc_ba -%}{%- include 'ba_case_source' -%}
  {%- assign pc_ba_before = pc_bs_before -%}{%- assign pc_ba_after = pc_bs_after -%}{%- assign pc_ba_group = pc_bs_group -%}
  {%- if pc_ba_before != blank and pc_ba_after != blank -%}
    {%- comment -%} 2026-10-18: ca không gắn nhom: gom vào nhóm "khác" — luôn đứng cuối (tab lọc). {%- endcomment -%}
    {%- if pc_ba_group == blank or pc_ba_group == pc_ba_group_other -%}{%- assign pc_ba_has_other = true -%}{%- else -%}
    {%- assign pc_ba_wrapped = '|' | append: pc_ba_group | append: '|' -%}
    {%- unless pc_ba_groups contains pc_ba_wrapped -%}{%- assign pc_ba_groups = pc_ba_groups | append: pc_ba_wrapped -%}{%- endunless -%}
    {%- endif -%}
    {%- if pc_ba_first_before == blank -%}
      {%- assign pc_ba_first_before = pc_ba_before -%}{%- assign pc_ba_first_after = pc_ba_after -%}{%- assign pc_ba_first_title = pc_ba.title -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if pc_ba_has_other -%}{%- assign pc_ba_groups = pc_ba_groups | append: '|' | append: pc_ba_group_other | append: '|' -%}{%- endif -%}
{%- assign pc_ba_group_list = pc_ba_groups | split: '|' -%}

{%- if settings.clinical_hero_before != blank and settings.clinical_hero_after != blank -%}
  {%- assign pc_ba_hero_before = settings.clinical_hero_before | img_url: 'large' -%}
  {%- assign pc_ba_hero_after = settings.clinical_hero_after | img_url: 'large' -%}
{%- else -%}
  {%- assign pc_ba_hero_before = pc_ba_first_before -%}
  {%- assign pc_ba_hero_after = pc_ba_first_after -%}
{%- endif -%}

{% include 'breadcrumb' %}
<main class="pc-ba">
  <section class="container pc-ba-hero{% if pc_ba_hero_before == blank %} pc-ba-hero--text{% endif %}">
    <div class="pc-ba-hero__text">
      <p class="pc-ba-kicker">{{ settings.clinical_hero_kicker | default: 'TRƯỚC & SAU · CHĂM SÓC DA TỪ XA' }}</p>
      <h1 class="pc-ba-hero__title">{{ settings.clinical_hero_title | default: page.title }}</h1>
      {%- if settings.clinical_intro != blank -%}<p class="pc-ba-hero__lead">{{ settings.clinical_intro }}</p>{%- endif -%}
      <div class="pc-ba-actions">
        <a href="{{ pc_ba_cta_link }}" class="pc-ba-btn pc-ba-btn--primary">{{ settings.clinical_hero_cta_label | default: 'Nhận phân tích da miễn phí' }}</a>
        {%- if pc_ba_group_list.size > 0 -%}
        <a href="#pc-ba-results" class="pc-ba-btn pc-ba-btn--outline">{{ settings.clinical_hero_cta2_label | default: 'Xem kết quả khách hàng' }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if pc_ba_hero_before != blank -%}
    <div class="pc-ba-pair pc-ba-pair--hero">
      <figure class="pc-ba-frame pc-ba-frame--before">
        <img src="{{ pc_ba_hero_before }}" alt="{{ pc_ba_first_title | default: page.title | escape }} — trước" width="420" height="420" fetchpriority="high">
        <figcaption class="pc-ba-badge">TRƯỚC</figcaption>
      </figure>
      <figure class="pc-ba-frame pc-ba-frame--after">
        <img src="{{ pc_ba_hero_after }}" alt="{{ pc_ba_first_title | default: page.title | escape }} — sau" width="420" height="420" fetchpriority="high">
        <figcaption class="pc-ba-badge pc-ba-badge--after">SAU</figcaption>
      </figure>
    </div>
    {%- endif -%}
  </section>

  {%- assign pc_ba_strip = settings.clinical_strip | default: 'Dược mỹ phẩm toàn cầu;Giao hàng toàn quốc;Phân tích da;Phác đồ cá nhân hóa;Trị liệu da 1:1 tại Hà Nội' | split: ';' -%}
  <section class="pc-ba-strip">
    <div class="container pc-ba-strip__inner">
      {%- for pc_ba_item in pc_ba_strip -%}{%- assign pc_ba_item_s = pc_ba_item | strip -%}{%- if pc_ba_item_s != blank -%}<span>{{ pc_ba_item_s }}</span>{%- endif -%}{%- endfor -%}
    </div>
  </section>

  <section class="container pc-ba-section">
    <h2 class="pc-ba-h2">{{ settings.clinical_steps_title | default: 'Chăm sóc từ xa hoạt động như thế nào' }}</h2>
    {%- if settings.clinical_steps_sub != blank -%}<p class="pc-ba-sub">{{ settings.clinical_steps_sub }}</p>{%- endif -%}
    <div class="pc-ba-steps">
      {%- for i in (1..4) -%}
      {%- capture pc_ba_k_t -%}clinical_step_{{ i }}_title{%- endcapture -%}
      {%- capture pc_ba_k_d -%}clinical_step_{{ i }}_desc{%- endcapture -%}
      {%- if settings[pc_ba_k_t] != blank -%}
      <div class="pc-ba-card pc-ba-step">
        <div class="pc-ba-step__no">0{{ i }}</div>
        <h3 class="pc-ba-step__title">{{ settings[pc_ba_k_t] }}</h3>
        {%- if settings[pc_ba_k_d] != blank -%}<p class="pc-ba-step__desc">{{ settings[pc_ba_k_d] }}</p>{%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="container pc-ba-section">
    <div class="pc-ba-card pc-ba-time">
      <h2 class="pc-ba-h2 pc-ba-h2--sm">{{ settings.clinical_time_title | default: 'Hãy cho làn da một khoảng thời gian thực tế' }}</h2>
      {%- if settings.clinical_time_sub != blank -%}<p class="pc-ba-time__sub">{{ settings.clinical_time_sub }}</p>{%- endif -%}
      <div class="pc-ba-time__grid">
        {%- for i in (1..3) -%}
        {%- capture pc_ba_k_t -%}clinical_time_{{ i }}_title{%- endcapture -%}
        {%- capture pc_ba_k_d -%}clinical_time_{{ i }}_desc{%- endcapture -%}
        {%- if settings[pc_ba_k_t] != blank -%}
        <div class="pc-ba-time__item">
          <div class="pc-ba-time__title">{{ settings[pc_ba_k_t] }}</div>
          {%- if settings[pc_ba_k_d] != blank -%}<div class="pc-ba-time__desc">{{ settings[pc_ba_k_d] }}</div>{%- endif -%}
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 2026-10-03: 4 ô chỉ số chỉ hiện khi nhập số liệu thật (clinical_stat_*), trống cả 4 ⇒ ẩn. {%- endcomment -%}
  {%- assign pc_cp_stats = 0 -%}
  {%- for i in (1..4) -%}
    {%- capture pc_k_val -%}clinical_stat_{{ i }}_value{%- endcapture -%}
    {%- if settings[pc_k_val] != blank -%}{%- assign pc_cp_stats = pc_cp_stats | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- if pc_cp_stats > 0 -%}
  <section class="container pc-ba-section">
    <div class="pc-ba-stats">
      {%- for i in (1..4) -%}
      {%- capture pc_k_val -%}clinical_stat_{{ i }}_value{%- endcapture -%}
      {%- capture pc_k_lbl -%}clinical_stat_{{ i }}_label{%- endcapture -%}
      {%- if settings[pc_k_val] != blank -%}
      <div class="pc-ba-card pc-ba-stat"><div class="pc-ba-stat__value">{{ settings[pc_k_val] }}</div><div class="pc-ba-stat__label">{{ settings[pc_k_lbl] }}</div></div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- if pc_ba_group_list.size > 0 -%}
  {%- comment -%}
    2026-10-18 (người dùng: "Proof Gallery"): bỏ khung từng nhóm có nút ‹ › + nút Zalo lặp lại. Thay bằng
    thanh tab lọc tức thì theo nhóm (tab = các giá trị tag nhom: THẬT đang có ca — không dựng tab rỗng) + lưới thẻ
    "visual-first": cặp ảnh TRƯỚC/SAU chiếm phần lớn thẻ, 1 dòng thông số + tiêu đề, cả thẻ là link sang trang chi
    tiết ca. Lời mời tư vấn chỉ còn ở hero và khối cuối trang.
  {%- endcomment -%}
  <section class="container pc-ba-section" id="pc-ba-results">
    <h2 class="pc-ba-h2">{{ settings.clinical_results_title | default: 'Kết quả của khách hàng' | escape }}</h2>
    {%- if settings.clinical_results_sub != blank -%}<p class="pc-ba-sub">{{ settings.clinical_results_sub | escape }}</p>{%- endif -%}

    {%- assign pc_ba_total_all = 0 -%}
    {%- capture pc_ba_cards -%}
      {%- for pc_ba in pc_ba_blog.articles limit: 50 -%}
        {%- assign pc_bs_article = pc_ba -%}{%- include 'ba_case_source' -%}
        {%- if pc_bs_before != blank and pc_bs_after != blank -%}
        {%- assign pc_ba_total_all = pc_ba_total_all | plus: 1 -%}
        {%- assign pc_ba_group = pc_bs_group | default: pc_ba_group_other -%}
        {%- assign pc_ba_cond = pc_bs_cond | default: pc_ba_group -%}
        {%- assign pc_ba_bl = settings.clinical_card_before_label | default: 'Trước' -%}{%- assign pc_ba_al = settings.clinical_card_after_label | default: 'Sau' -%}
        {%- if pc_bs_weeks != blank -%}{%- assign pc_ba_bl = pc_ba_bl | append: ' · Tuần 0' -%}{%- assign pc_ba_al = pc_ba_al | append: ' · Tuần ' | append: pc_bs_weeks -%}{%- endif -%}
        <a class="pc-bg-card" href="{{ pc_ba.url }}" data-ba-cat="{{ pc_ba_group | handleize }}">
          <span class="pc-bg-card__pair">
            <span class="pc-bg-card__shot">
              <img src="{{ pc_bs_before }}" alt="{{ pc_ba.title | escape }} — trước" width="400" height="533" loading="lazy" decoding="async">
              <span class="pc-bg-card__tag">{{ pc_ba_bl | escape }}</span>
            </span>
            <span class="pc-bg-card__shot pc-bg-card__shot--after">
              <img src="{{ pc_bs_after }}" alt="{{ pc_ba.title | escape }} — sau" width="400" height="533" loading="lazy" decoding="async">
              <span class="pc-bg-card__tag">{{ pc_ba_al | escape }}</span>
            </span>
            <span class="pc-bg-card__more">{{ settings.clinical_case_more_label | default: 'Xem chi tiết ca' | escape }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          </span>
          <span class="pc-bg-card__body">
            <span class="pc-bg-card__meta">
              <span class="pc-bg-card__cond">{{ pc_ba_cond | escape }}</span>
              {%- if pc_bs_age != blank -%}{%- assign pc_ba_age_l = pc_bs_age | downcase -%}<span>{{ pc_bs_age | escape }}{% unless pc_ba_age_l contains 'tuổi' %} tuổi{% endunless %}</span>{%- endif -%}
              {%- if pc_bs_weeks != blank -%}<span>{{ pc_bs_weeks | escape }} tuần</span>{%- endif -%}
            </span>
            <span class="pc-bg-card__title">{{ pc_ba.title | escape }}</span>
          </span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign pc_ba_gn = 0 -%}{%- for pc_ba_g in pc_ba_group_list -%}{%- if pc_ba_g != blank -%}{%- assign pc_ba_gn = pc_ba_gn | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- comment -%} Chỉ 1 nhóm thì không cần tab. {%- endcomment -%}
    {%- if pc_ba_gn > 1 -%}
    <div class="pc-bg-tabs" role="toolbar" aria-label="{{ settings.clinical_filter_label | default: 'Lọc theo vấn đề da' | escape }}">
      <button type="button" class="pc-bg-tab" data-ba-filter="" aria-pressed="true">{{ settings.clinical_filter_all | default: 'Tất cả' | escape }} <span>{{ pc_ba_total_all }}</span></button>
      {%- for pc_ba_group_name in pc_ba_group_list -%}
      {%- if pc_ba_group_name != blank -%}
      {%- assign pc_ba_cnt = 0 -%}
      {%- for pc_ba in pc_ba_blog.articles limit: 50 -%}
        {%- assign pc_bs_article = pc_ba -%}{%- include 'ba_case_source' -%}
        {%- assign pc_ba_group = pc_bs_group | default: pc_ba_group_other -%}
        {%- if pc_bs_before != blank and pc_bs_after != blank and pc_ba_group == pc_ba_group_name -%}{%- assign pc_ba_cnt = pc_ba_cnt | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      <button type="button" class="pc-bg-tab" data-ba-filter="{{ pc_ba_group_name | handleize }}" aria-pressed="false">{{ pc_ba_group_name | escape }} <span>{{ pc_ba_cnt }}</span></button>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    <div class="pc-bg-grid" aria-live="polite">{{ pc_ba_cards }}</div>
    {%- if settings.clinical_note != blank -%}<p class="pc-ba-note">{{ settings.clinical_note | escape }}</p>{%- endif -%}
  </section>
  {%- endif -%}

  <section class="container pc-ba-section pc-ba-section--last">
    <div class="pc-ba-final">
      <div class="pc-ba-final__text">
        <h2 class="pc-ba-final__title">{{ settings.clinical_final_title | default: 'Bạn gặp tình trạng da tương tự?' }}</h2>
        {%- if settings.clinical_final_text != blank -%}<p class="pc-ba-final__desc">{{ settings.clinical_final_text }}</p>{%- endif -%}
      </div>
      <div class="pc-ba-actions">
        <a href="{{ pc_ba_cta_link }}" class="pc-ba-btn pc-ba-btn--light">{{ settings.clinical_final_cta_label | default: 'Phân tích da miễn phí' }}</a>
        {%- if settings.clinical_final_cta2_label != blank -%}
        <a href="{{ settings.clinical_final_cta2_link | default: '/dat-lich-tu-van' }}" class="pc-ba-btn pc-ba-btn--ghost">{{ settings.clinical_final_cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</main>
<script>
  /* 2026-10-18: lọc tức thì theo nhóm vấn đề da (không tải lại trang). */
  (function () {
    var tabs = document.querySelectorAll('[data-ba-filter]');
    var cards = document.querySelectorAll('.pc-bg-card[data-ba-cat]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var cat = tab.getAttribute('data-ba-filter');
        tabs.forEach(function (t) { t.setAttribute('aria-pressed', t === tab ? 'true' : 'false'); });
        cards.forEach(function (c) { c.hidden = cat !== '' && c.getAttribute('data-ba-cat') !== cat; });
      });
    });
  })();
</script>
