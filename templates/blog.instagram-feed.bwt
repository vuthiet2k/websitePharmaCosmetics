{% layout 'theme' %}
{%- comment -%}
  blog.instagram-feed.bwt — 2026-10-18 (người dùng: "lấy theo bài viết mới nhất — ý tưởng từ Instagram — thu hút người dùng vào đọc
  thông tin mới trên mobile"). Sapo Admin → Danh mục bài viết → Khung giao diện: blog.instagram-feed.
  · Tên blog = h1 ẩn (khối hồ sơ đầu trang đã bỏ theo người dùng 18/10).
  · Story = các blog trong settings.feed_story_blogs (handle, cách nhau dấu phẩy): ảnh bài mới nhất của blog, nhãn MỚI nếu có bài
    trong 7 ngày, blog đang xem được đánh dấu.
  · Feed = bài mới nhất gom từ MỌI danh mục settings.news_hub_blogs (cùng nguồn khối "Tin mới nhất"), 12 bài + "Xem thêm" (tối đa 36).
    Mỗi bài: chuyên mục (tag chude: hoặc
    tên blog) · thời gian "x giờ/ngày trước" · ảnh 4:5 (bài có tag youtube: ⇒ ảnh video + nút ▶) · nhãn MỚI (< 3 ngày) · tim / bình
    luận / chia sẻ / lưu · tiêu đề + tóm tắt 2 dòng "xem thêm" · hashtag (tag thường) · số bình luận THẬT nếu có.
  · Tim/lưu chỉ ghi trên máy người xem (localStorage) — KHÔNG hiện số lượt bịa (bản cũ tính comments_count × 17 + 900).
  · Bỏ thanh điều hướng đáy tự dựng (trùng bottom-nav chung của theme), bỏ chữ ghi cứng (story, tài khoản, badge, nút CTA).
  CSS: assets/page_blog_feed.scss.bwt.
{%- endcomment -%}
{{ 'page_blog_feed.scss.css' | asset_url | stylesheet_tag }}
{%- assign pc_ig_name = settings.feed_account_name | default: settings.store_name | default: store.name -%}
{%- assign pc_ig_now = 'now' | date: '%s' | plus: 0 -%}
{%- assign pc_ig_has_now = false -%}{%- if pc_ig_now > 1000000000 -%}{%- assign pc_ig_has_now = true -%}{%- endif -%}
{%- capture pc_ig_avatar -%}<span class="pc-ig-avatar" aria-hidden="true"><img src="{{ 'favicon.png' | asset_url }}" alt="" width="64" height="64" loading="lazy"></span>{%- endcapture -%}

<div class="pc-ig">
  {%- comment -%} 2026-10-18 (người dùng): bỏ khối hồ sơ đầu trang — giữ h1 ẩn (UI-2.5: mỗi trang 1 h1). {%- endcomment -%}
  <h1 class="sr-only">{{ blog.title | default: page_title | escape }}</h1>

  {%- comment -%} ═══ Story: các chuyên mục ═══ {%- endcomment -%}
  {%- assign pc_ig_story_handles = settings.feed_story_blogs | default: 'tin-tuc-va-kien-thuc,bi-quyet,video,truoc-va-sau-1,hoat-chat,chuyen-gia' | split: ',' -%}
  {%- capture pc_ig_stories -%}
    {%- for pc_ig_h in pc_ig_story_handles -%}
      {%- assign pc_ig_h = pc_ig_h | strip -%}
      {%- assign pc_ig_b = blogs[pc_ig_h] -%}
      {%- if pc_ig_h != blank and pc_ig_b and pc_ig_b.url != blank -%}
        {%- assign pc_ig_first = pc_ig_b.articles | first -%}
        {%- assign pc_ig_new = false -%}
        {%- if pc_ig_has_now and pc_ig_first -%}
          {%- assign pc_ig_pub = pc_ig_first.published_on | date: '%s' | plus: 0 -%}
          {%- assign pc_ig_age = pc_ig_now | minus: pc_ig_pub -%}
          {%- if pc_ig_age < 604800 and pc_ig_age >= 0 -%}{%- assign pc_ig_new = true -%}{%- endif -%}
        {%- endif -%}
        <li>
          <a class="pc-ig-story{% if pc_ig_b.url == blog.url %} is-current{% endif %}{% if pc_ig_new %} is-new{% endif %}" href="{{ pc_ig_b.url }}"{% if pc_ig_b.url == blog.url %} aria-current="page"{% endif %}>
            <span class="pc-ig-story__ring">
              {%- assign pc_ig_story_yt = '' -%}{%- assign pc_vs_src = '' -%}
              {%- assign pc_ig_fimg = pc_ig_first.image.src | default: '' -%}
              {%- if pc_ig_first and pc_ig_fimg == '' -%}{%- assign pc_vs_article = pc_ig_first -%}{%- include 'video_source' -%}{%- if pc_vs_src == 'youtube' -%}{%- assign pc_ig_story_yt = pc_vs_id -%}{%- endif -%}{%- endif -%}
              {%- if pc_ig_first and pc_ig_first.image.src != blank -%}
              <img src="{{ pc_ig_first.image.src | img_url: 'small' }}" alt="" width="100" height="100" loading="lazy">
              {%- elsif pc_ig_story_yt != blank -%}
              <img src="https://i.ytimg.com/vi/{{ pc_ig_story_yt }}/mqdefault.jpg" alt="" width="100" height="100" loading="lazy">
              {%- else -%}
              <span class="pc-ig-story__ph" aria-hidden="true"><i class="fa-solid {% if pc_vs_src != '' %}fa-video{% else %}fa-newspaper{% endif %}"></i></span>
              {%- endif -%}
              {%- if pc_ig_new -%}<span class="pc-ig-story__new">{{ settings.feed_new_label | default: 'Mới' | escape }}</span>{%- endif -%}
            </span>
            <span class="pc-ig-story__label">{{ pc_ig_b.title | escape }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign pc_ig_stories_s = pc_ig_stories | strip -%}
  {%- if pc_ig_stories_s != blank -%}
  <nav class="pc-ig-stories" aria-label="{{ settings.feed_story_label | default: 'Chuyên mục' | escape }}"><ul>{{ pc_ig_stories }}</ul></nav>
  {%- endif -%}

  {%- comment -%}
    ═══ Feed bài mới nhất ═══ 2026-10-18 (người dùng: "cùng lấy theo tin mới nhất nhưng data khác nhau"): dùng CHUNG nguồn + cách
    xếp với khối "Tin mới nhất" trang tin tức (snippets/page_tin_tuc_hub.bwt): gom bài MỌI danh mục trong settings.news_hub_blogs,
    khoá "yyyyMMddHHmmss|handle|vị trí" ⇒ sort chuỗi = sort thời gian, duyệt reversed (mới → cũ); lấy bài bằng for … offset: limit: 1
    (DotLiquid Sapo lỗi chỉ số mảng tính từ plus: 0). Tối đa 36 bài, hiện 12, nút "Xem thêm" mở thêm 12 (không tải lại trang).
  {%- endcomment -%}
  {%- assign pc_ig_raw = settings.news_hub_blogs | strip -%}
  {%- if pc_ig_raw == blank -%}{%- assign pc_ig_raw = blog.handle | default: 'tin-tuc-va-kien-thuc' -%}{%- endif -%}
  {%- assign pc_ig_list = pc_ig_raw | split: ',' -%}
  {%- assign pc_ig_seen = ',' -%}
  {%- capture pc_ig_keys -%}
    {%- for pc_ig_h in pc_ig_list -%}
      {%- assign pc_ig_hs = pc_ig_h | strip -%}
      {%- assign pc_ig_hk = ',' | append: pc_ig_hs | append: ',' -%}
      {%- unless pc_ig_hs == blank or pc_ig_seen contains pc_ig_hk -%}
        {%- assign pc_ig_seen = pc_ig_seen | append: pc_ig_hs | append: ',' -%}
        {%- for pc_ig_a in blogs[pc_ig_hs].articles -%}{{ pc_ig_a.published_on | date: 'yyyyMMddHHmmss' }}|{{ pc_ig_hs }}|{{ forloop.index0 }};{%- endfor -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign pc_ig_keys = pc_ig_keys | split: ';' | sort -%}
  {%- assign pc_ig_page = 12 -%}{%- assign pc_ig_max = 36 -%}{%- assign pc_ig_n = 0 -%}
  <div class="pc-ig-feed" data-ig-feed>
    {%- for pc_ig_k in pc_ig_keys reversed -%}
      {%- if pc_ig_k != blank and pc_ig_n < pc_ig_max -%}
        {%- assign pc_ig_kp = pc_ig_k | split: '|' -%}{%- assign pc_ig_kh = pc_ig_kp[1] -%}{%- assign pc_ig_ki = pc_ig_kp[2] | plus: 0 -%}
        {%- assign pc_ig_kb = blogs[pc_ig_kh] -%}
        {%- assign pc_ig_n = pc_ig_n | plus: 1 -%}
        {%- for article in pc_ig_kb.articles offset: pc_ig_ki limit: 1 -%}
          {%- comment -%} Chuyên mục = tag chude:, hashtag = tag thường (bỏ tag hệ thống khoá:giá trị / duocsi_ / video). {%- endcomment -%}
          {%- assign pc_ig_topic = '' -%}{%- assign pc_ig_tags = '' -%}
          {%- for pc_ig_t in article.tags -%}
            {%- if pc_ig_t contains ':' -%}
              {%- assign pc_ig_k = pc_ig_t | split: ':' | first | strip | downcase -%}
              {%- if pc_ig_k == 'chude' -%}{%- assign pc_ig_topic = pc_ig_t | remove_first: 'chude:' | strip -%}{%- endif -%}
            {%- else -%}
              {%- unless pc_ig_t contains 'duocsi_' or pc_ig_t contains 'video' or pc_ig_t contains '|' -%}{%- assign pc_ig_tags = pc_ig_tags | append: pc_ig_t | append: '|' -%}{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign pc_vs_article = article -%}{%- include 'video_source' -%}
          {%- comment -%} 2026-10-18 (người dùng): ưu tiên VIDEO trước ảnh bài viết — YouTube > Facebook (tag hoặc video trong bài). {%- endcomment -%}
          {%- assign pc_ig_yt = '' -%}{%- assign pc_ig_fb = '' -%}
          {%- if pc_vs_list != '' -%}
            {%- assign pc_ig_vitems = pc_vs_list | split: '||' -%}
            {%- for pc_ig_vi in pc_ig_vitems -%}{%- assign pc_ig_vp = pc_ig_vi | split: '~' -%}
              {%- if pc_ig_yt == '' and pc_ig_vp[0] == 'youtube' -%}{%- assign pc_ig_yt = pc_ig_vp[1] -%}{%- endif -%}
              {%- if pc_ig_fb == '' and pc_ig_vp[0] == 'facebook' -%}{%- assign pc_ig_fb = pc_ig_vp[2] -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if pc_ig_yt == '' and pc_vs_src == 'youtube' -%}{%- assign pc_ig_yt = pc_vs_id -%}{%- endif -%}
          {%- if pc_ig_fb == '' and pc_vs_src == 'facebook' -%}{%- assign pc_ig_fb = pc_vs_fb -%}{%- endif -%}
          {%- if pc_ig_yt != '' -%}{%- assign pc_ig_fb = '' -%}{%- endif -%}
          {%- assign pc_ig_ago = '' -%}{%- assign pc_ig_fresh = false -%}
          {%- if pc_ig_has_now -%}
            {%- assign pc_ig_pub = article.published_on | date: '%s' | plus: 0 -%}
            {%- assign pc_ig_age = pc_ig_now | minus: pc_ig_pub -%}
            {%- if pc_ig_age >= 0 -%}
              {%- if pc_ig_age < 3600 -%}{%- assign pc_ig_ago = settings.feed_just_now | default: 'Vừa đăng' -%}
              {%- elsif pc_ig_age < 86400 -%}{%- assign pc_ig_ago = pc_ig_age | divided_by: 3600 | append: ' giờ trước' -%}
              {%- elsif pc_ig_age < 604800 -%}{%- assign pc_ig_ago = pc_ig_age | divided_by: 86400 | append: ' ngày trước' -%}
              {%- endif -%}
              {%- if pc_ig_age < 259200 -%}{%- assign pc_ig_fresh = true -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}
          {%- if pc_ig_ago == blank -%}{%- assign pc_ig_ago = article.published_on | date: '%d/%m/%Y' -%}{%- endif -%}
          {%- assign pc_ig_sum = article.summary | default: article.excerpt | strip_html | strip -%}
          <article class="pc-ig-post"{% if pc_ig_n > pc_ig_page %} hidden{% endif %} data-ig-post="{{ article.url }}">
            <header class="pc-ig-post__head">
              <span class="pc-ig-post__avatar">{{ pc_ig_avatar }}</span>
              <div class="pc-ig-post__who">
                <span class="pc-ig-post__name">{{ pc_ig_name | escape }} <i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                <span class="pc-ig-post__sub">{{ pc_ig_topic | default: pc_ig_kb.title | escape }}</span>
              </div>
              <time class="pc-ig-post__time" datetime="{{ article.published_on | date: '%Y-%m-%dT%H:%M:%S' }}">{{ pc_ig_ago }}</time>
            </header>
            <a class="pc-ig-post__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}"{% if pc_ig_yt != '' %} data-ig-video="youtube" data-ig-vid="{{ pc_ig_yt }}"{% elsif pc_ig_fb != '' %} data-ig-video="facebook" data-ig-vfb="{{ pc_ig_fb | escape }}"{% endif %}>
              {%- if pc_ig_yt != blank -%}
              <img src="https://i.ytimg.com/vi/{{ pc_ig_yt }}/hqdefault.jpg" alt="{{ article.title | escape }}" width="480" height="360" {% if pc_ig_n > 1 %}loading="lazy" {% endif %}decoding="async">
              {%- elsif article.image.src != blank -%}
              <img src="{{ article.image.src | img_url: 'grande' }}" alt="{{ article.image.alt | default: article.title | escape }}" width="600" height="750" {% if pc_ig_n > 1 %}loading="lazy" {% endif %}decoding="async">
              {%- else -%}
              <span class="pc-ig-post__ph" aria-hidden="true"><i class="fa-solid fa-newspaper"></i><span>{{ article.title | escape }}</span></span>
              {%- endif -%}
              {%- if pc_ig_yt != blank or pc_ig_fb != blank -%}<span class="pc-ig-post__play" aria-hidden="true"><i class="fa-solid fa-play"></i></span><span class="pc-ig-post__vid" aria-hidden="true"><i class="fa-solid fa-video"></i></span>{%- endif -%}
              {%- if pc_ig_fresh -%}<span class="pc-ig-post__new">{{ settings.feed_new_label | default: 'Mới' | escape }}</span>{%- endif -%}
            </a>
            <div class="pc-ig-post__actions">
              <button type="button" class="pc-ig-act" data-ig-like aria-pressed="false" aria-label="{{ settings.feed_like_label | default: 'Thích' | escape }}"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
              <a class="pc-ig-act" href="{{ article.url }}{% if pc_ig_kb.comments_enabled %}#article_comments{% endif %}" aria-label="{{ settings.feed_comment_label | default: 'Bình luận' | escape }}"><i class="fa-solid fa-comment" aria-hidden="true"></i></a>
              <button type="button" class="pc-ig-act" data-ig-share data-title="{{ article.title | escape }}" aria-label="{{ settings.feed_share_label | default: 'Chia sẻ' | escape }}"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
              <button type="button" class="pc-ig-act pc-ig-act--save" data-ig-save aria-pressed="false" aria-label="{{ settings.feed_save_label | default: 'Lưu bài' | escape }}"><i class="fa-regular fa-bookmark" aria-hidden="true"></i></button>
            </div>
            <div class="pc-ig-post__caption">
              <a class="pc-ig-post__title" href="{{ article.url }}"><strong>{{ pc_ig_name | escape }}</strong> {{ article.title | escape }}</a>
              {%- if pc_ig_sum != blank -%}
              <p class="pc-ig-post__text">{{ pc_ig_sum | truncate: 220 }}</p>
              <a class="pc-ig-post__more" href="{{ article.url }}">{{ settings.feed_more_text | default: 'xem thêm' | escape }}</a>
              {%- endif -%}
              {%- if pc_ig_tags != blank -%}
              {%- assign pc_ig_tag_list = pc_ig_tags | split: '|' -%}
              <p class="pc-ig-post__tags">{%- for pc_ig_t in pc_ig_tag_list limit: 4 -%}{%- if pc_ig_t != blank -%}<a href="/blogs/all/tagged/(({{ pc_ig_t | replace: ' ', '%20' }}))">#{{ pc_ig_t | replace: ' ', '' | replace: '-', '' }}</a> {% endif -%}{%- endfor -%}</p>
              {%- endif -%}
              {%- if pc_ig_kb.comments_enabled and article.comments_count > 0 -%}
              <a class="pc-ig-post__comments" href="{{ article.url }}#article_comments">{{ settings.feed_comments_view | default: 'Xem bình luận' | escape }} ({{ article.comments_count }})</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if pc_ig_n == 0 -%}<p class="pc-ig-empty">{{ settings.feed_empty_text | default: 'Chuyên mục đang cập nhật bài viết.' | escape }}</p>{%- endif -%}
  </div>
  {%- if pc_ig_n > pc_ig_page -%}
  <div class="pc-ig-more"><button type="button" class="pc-ig-more__btn" data-ig-more data-step="{{ pc_ig_page }}">{{ settings.feed_load_more | default: 'Xem thêm bài viết' | escape }} <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button></div>
  {%- endif -%}
  <div class="pc-ig-toast" role="status" aria-live="polite" hidden></div>
</div>
<script>
  /* 2026-10-18: tim / lưu ghi trên máy người xem (localStorage, không hiện số lượt); chia sẻ = Web Share API, không có ⇒ chép link. */
  (function () {
    var KEY_L = 'pc_ig_like', KEY_S = 'pc_ig_save';
    function read(k) { try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch (e) { return []; } }
    function write(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
    var toast = document.querySelector('.pc-ig-toast'), tt;
    function say(msg) { if (!toast) return; toast.textContent = msg; toast.hidden = false; clearTimeout(tt); tt = setTimeout(function () { toast.hidden = true; }, 1800); }
    function bind(sel, key, on, off, msgOn) {
      var list = read(key);
      document.querySelectorAll('[data-ig-post]').forEach(function (post) {
        var btn = post.querySelector(sel), url = post.getAttribute('data-ig-post'), icon = btn && btn.querySelector('i');
        if (!btn) return;
        function paint(v) { btn.setAttribute('aria-pressed', v ? 'true' : 'false'); btn.classList.toggle('is-on', v); icon.className = (v ? 'fa-solid ' : 'fa-regular ') + (v ? on : off); }
        paint(list.indexOf(url) > -1);
        btn.addEventListener('click', function () {
          list = read(key); var i = list.indexOf(url), v = i < 0;
          if (v) list.push(url); else list.splice(i, 1);
          write(key, list); paint(v); btn.classList.remove('is-pop'); void btn.offsetWidth; btn.classList.add('is-pop');
          if (v && msgOn) say(msgOn);
        });
      });
    }
    bind('[data-ig-like]', KEY_L, 'fa-heart', 'fa-heart', '');
    bind('[data-ig-save]', KEY_S, 'fa-bookmark', 'fa-bookmark', {{ settings.feed_saved_toast | default: 'Đã lưu bài viết' | json }});
    /* 2026-10-18: video tự phát (tắt tiếng, lặp) khi bài vào màn hình — chỉ nạp iframe lúc đó, gỡ khi ra khỏi; tắt khi giảm chuyển động. */
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          var m = en.target, fr = m.querySelector('iframe');
          if (en.isIntersecting && !fr && !m.closest('[hidden]')) {
            fr = document.createElement('iframe');
            if (m.dataset.igVideo === 'youtube') {
              var id = m.dataset.igVid;
              fr.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&mute=1&loop=1&playlist=' + id + '&controls=0&playsinline=1&rel=0&modestbranding=1';
            } else {
              fr.src = 'https://www.facebook.com/plugins/video.php?href=' + encodeURIComponent(m.dataset.igVfb) + '&show_text=false&autoplay=true&mute=1';
            }
            fr.title = m.getAttribute('aria-label') || ''; fr.allow = 'autoplay; encrypted-media; picture-in-picture'; fr.setAttribute('tabindex', '-1');
            m.appendChild(fr); m.classList.add('is-playing');
          } else if (!en.isIntersecting && fr) { fr.remove(); m.classList.remove('is-playing'); }
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-ig-video]').forEach(function (m) { vio.observe(m); });
    }
    var more = document.querySelector('[data-ig-more]');
    if (more) more.addEventListener('click', function () {
      var hidden = [].slice.call(document.querySelectorAll('[data-ig-feed] .pc-ig-post[hidden]')), step = parseInt(more.getAttribute('data-step'), 10) || 12;
      hidden.slice(0, step).forEach(function (el) { el.hidden = false; });
      if (hidden.length <= step) more.parentNode.remove();
    });
    document.querySelectorAll('[data-ig-share]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = new URL(btn.closest('[data-ig-post]').getAttribute('data-ig-post'), location.href).href, title = btn.getAttribute('data-title');
        if (navigator.share) { navigator.share({ title: title, url: url }).catch(function () {}); return; }
        if (navigator.clipboard) navigator.clipboard.writeText(url).then(function () { say({{ settings.feed_copied_toast | default: 'Đã sao chép liên kết' | json }}); });
      });
    });
  })();
</script>
