													{{settings.product_link_2_title}}
												</a>{%endif%}
											</div> 
										</div>
									</div>
								</div>

							</div>
							{% endif %}


						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
					{%- if settings.metafield_show -%}
					{%- assign metafields_combo = product.metafields.custom.Combo -%}
					{%- assign cleaned_ids_combo = metafields_combo | remove: "[" | remove: "]" -%}
					{%- assign cleaned_comma_combo = cleaned_ids_combo | remove: '"' -%}
					{%- assign product_ids_array_combo = cleaned_comma_combo | split: "," -%}
					{%- endif -%}
					{%- if cleaned_comma_combo != null and cleaned_comma_combo != '' and cleaned_comma_combo !="" -%}
					{%- include 'combo_pro_metafield' -%}
					{%- else -%}
					{%- if tag_combo -%}
					{% capture tag_str_prefix_val %}combo{% endcapture %}
					{%- include 'combo_pro' -%}
					{%- endif -%}
					{%- endif -%}

				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row">
						<div class="col-12 product-review-details {%if product.content contains '<h6>' or settings.product_combo_compat_enable%} col-lg-12 col-xl-8{%else%} col-lg-12 col-xl-12{%endif%}">
							{%include 'tab_product'%}
						</div>
						{%if product.content contains '<h6>' or settings.product_combo_compat_enable %} 
						<div class="col-lg-12 col-xl-4 col-12 product-sidebar">
							<div class="sticky-box">
								{%if product.content contains '<h6>'%} 
								{% include "specifications" %}
								{%endif%}
								{%if settings.product_combo_compat_enable %} 
								<div class="product-favorite">

									<div class="section-title a-left txt-uppercese">
										<h2>
											<a href="/{{ settings.product_related_collection }}" title="{{settings.product_related_title | strip_html}}">{{settings.product_related_title}}</a>
										</h2>
									</div>

									<div class="row">
										{%- if collections[settings.product_related_collection].products.size > 0 -%}
										{%- for product in collections[settings.product_related_collection].products limit: settings.product_related_limit -%}
										<div class="col-xl-6 col-lg-3 col-md-4 col-xs-6 col-6">
											<div class="item_product_main">
												{%include 'product_grid_office'%}
											</div>
										</div>
										{% endfor %}
										{%else%}
										<div class="alert alert-warning alert-warning2 alert-dismissible margin-top-15 section" role="alert">
											Sản phẩm đang được cập nhật.
										</div>
										{%endif%}
									</div>
								</div>
								{%endif%}
							</div>
						</div>
						{%endif%}
					</div>
				</div>
				{%- comment -%}
				  T-23/T-24 (product-detail + product-vella, ADR-004: nội dung khác cùng template,
				  không tách riêng) — 2 khối tĩnh minh hoạ theo Pharma_Cosmetics_Figma_Project/
				  product-detail.html (dòng ~200-286): Active Ingredients Matrix + Doctor Clinical
				  Endorsement. Không có field thành phần hoạt chất theo cấu trúc trên product thật
				  -> dùng nội dung minh hoạ tĩnh (đúng mock_policy#frontend_theme). Endorsement bind
				  vào doctors[0] (data/doctors.js, quy ước đã dùng ở templates/page.chuyen-gia.bwt)
				  thay vì bịa tên/trích dẫn lâm sàng không kiểm chứng được.
				  LƯU Ý: dùng Tailwind utility thuần (không dùng .btn-primary/.btn-secondary của
				  snippets/pharma_ui_kit.bwt) vì các class đó đã tồn tại từ trước cho nút Bootstrap
				  (.btn.btn-primary) ở assets/global_core.scss.bwt, assets/page_account.scss.bwt,
				  assets/page_collection.scss.bwt — include global pharma_ui_kit ở layouts/theme.bwt
				  có nguy cơ đè style các nút .btn-primary hiện có toàn site (cần rà soát riêng,
				  ngoài phạm vi task này).
				{%- endcomment -%}
				<div class="col-12">
					<div class="bg-gray-50 rounded-3xl p-6 sm:p-8 mb-8 border border-gray-200">
						<h2 class="text-lg sm:text-xl font-bold text-forest-900 font-heading mb-6 text-center">
							Thành Phần Hoạt Chất &amp; Cơ Chế Tác Động Y Khoa
						</h2>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
							<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
								<div class="w-10 h-10 rounded-lg bg-emerald-100 text-clinical-700 flex items-center justify-center font-bold text-sm mb-3">B5</div>
								<h3 class="text-sm font-bold text-gray-900 mb-1">Panthenol (B5) 10%</h3>
								<p class="text-xs text-gray-600 leading-relaxed">Cấp ẩm sâu, kích thích tăng sinh nguyên bào sợi và đẩy nhanh tốc độ phục hồi biểu bì.</p>
							</div>
							<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
								<div class="w-10 h-10 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-sm mb-3">CER</div>
								<h3 class="text-sm font-bold text-gray-900 mb-1">Ceramide NP Đa Tầng</h3>
								<p class="text-xs text-gray-600 leading-relaxed">Hàn gắn các đứt gãy trong lớp màng lipid, ngăn chặn hiện tượng mất nước qua biểu bì (TEWL).</p>
							</div>
							<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
								<div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-sm mb-3">MAD</div>
								<h3 class="text-sm font-bold text-gray-900 mb-1">Madecassoside (Rau Má)</h3>
								<p class="text-xs text-gray-600 leading-relaxed">Ức chế phản ứng viêm dưới da, làm mát tức thì và làm mờ các nốt mao mạch nông nổi li ti.</p>
							</div>
							<div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
								<div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm mb-3">HA</div>
								<h3 class="text-sm font-bold text-gray-900 mb-1">Multi-Molecular HA</h3>
								<p class="text-xs text-gray-600 leading-relaxed">3 tầng phân tử ngậm nước giúp căng bóng đa tầng, củng cố liên kết gian bào của da thiếu ẩm.</p>
							</div>
						</div>
					</div>

					{%- assign endorse_doc = doctors[0] -%}
					{%- if endorse_doc -%}
					<div class="bg-forest-900 text-white rounded-3xl p-6 sm:p-10 mb-8 shadow-lg">
						<div class="flex flex-col md:flex-row items-center gap-6 sm:gap-8">
							{%- if endorse_doc.photo.src -%}
							<img src="{{ endorse_doc.photo.src }}" alt="{{ endorse_doc.photo.alt | default: endorse_doc.name }}" class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-4 border-white/20 flex-shrink-0" loading="lazy">
							{%- endif -%}
							<div class="space-y-3 text-center md:text-left">
								<span class="text-xs font-bold text-clinical-600 uppercase tracking-widest">
									Ý kiến chuyên gia &bull; {{ endorse_doc.name }} &bull; {{ endorse_doc.title }} ({{ endorse_doc.years_experience }} năm kinh nghiệm)
								</span>
								<p class="text-sm sm:text-base italic text-emerald-100 leading-relaxed">{{ endorse_doc.quote }}</p>
								<div class="pt-2">
									<a href="/dat-lich-tu-van" class="inline-flex items-center gap-2 bg-white text-forest-900 hover:bg-emerald-100 font-bold text-xs py-2.5 px-5 rounded-lg transition">
										Đặt lịch tư vấn cùng {{ endorse_doc.name }} <i class="fas fa-arrow-right" aria-hidden="true"></i>
									</a>
								</div>
							</div>
						</div>
					</div>
					{%- endif -%}
				</div>

				{%- if settings.product_recent_enable -%}
				{%- assign check11 = product.url -%}
				{%- assign productRelate = product.collections.first.alias -%}
				{%- assign productRelateCheck = product.collections.size -%}
				{%- assign productRelateCheck2 = product.collections.first.products_count -%}					
				{%- if productRelateCheck > 0 and settings.product_upsell_enable and productRelateCheck2 > 1 -%}
				<div class="col-12">
					<div class="product-related product-swipers">
						<div class="section-title a-left txt-uppercese">
							<h2>
								<a href="/{{ productRelate | handleize }}" title="{{settings.product_same_cate_title | strip_html}}">{{settings.product_same_cate_title}}</a>
							</h2>
						</div>

						<div class="swiper_product_related swiper-container">
							<div class="swiper-wrapper">
								{% for product in collections[productRelate].products limit: settings.product_same_cate_limit %}
								<div class="swiper-slide">
									<div class="item_product_main">
										{%include 'product_grid_office'%}
									</div>
								</div>
								{% endfor %}
							</div>
							<div class="swiper-button-prev">
								<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
							<div class="swiper-button-next">
								<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
						</div>
						<div class="show-more-same">
							<a class='show-more btn btn-primary frame flexbtn' href='/{{ productRelate | handleize }}' title='Xem thêm'>
								Xem thêm <svg height="64" viewBox="0 0 24 24" width="64" xmlns="http://www.w3.org/2000/svg" data-name="Layer 2"><path d="m22.707 11.293-7-7a1 1 0 0 0 -1.414 1.414l5.293 5.293h-17.586a1 1 0 0 0 0 2h17.586l-5.293 5.293a1 1 0 1 0 1.414 1.414l7-7a1 1 0 0 0 0-1.414z"></path></svg>
							</a>
						</div>
					</div>
				</div>
				<script>
					var swiper_related = new Swiper('.swiper_product_related', {
						slidesPerView: 4,
						spaceBetween: 20,
						slidesPerGroup: 1,
						navigation: {
							nextEl: '.swiper_product_related .swiper-button-next',
							prevEl: '.swiper_product_related .swiper-button-prev',
						},
						breakpoints: {
							280: {
								slidesPerView: 2,
								spaceBetween: 15
							},
							640: {
								slidesPerView: 2,
								spaceBetween: 15
							},
							768: {
								slidesPerView: 3,
								spaceBetween: 15
							},
							992: {
								slidesPerView: 4,
								spaceBetween: 15
							},
							1025: {
								slidesPerView: 5,
								spaceBetween: 20
							}
						}
					});
				</script>
				{%- endif -%}
				{%- endif -%}
				{%if settings.product_same_enable%}
				<div class="col-12">
					{% include 'section_same_price' %}
				</div>
				{%endif%}
			</div>
		</div>
	</div>

</section>
{% if settings.product_viewed_enable %}
{% include 'section_product_viewed' %}
{% endif %}
{%- if product.content contains '<h6>' -%}
