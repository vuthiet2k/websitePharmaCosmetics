{% assign variantCount = product.variants | size %}{% assign on_var = false %}{% if variantCount > 1 %}{% assign on_var = true %}{% endif %}{%assign contacts = false%}{%if product.price == 0 %}{%assign contacts = true%}{%endif%}
{%assign price = product.variants[0].price  -%}
{%assign compare_at_price = product.variants[0].compare_at_price  -%}
{%if on_var and product.selected_or_first_available_variant.available -%}
{% assign price = product.selected_or_first_available_variant.price -%}
{% assign compare_at_price = product.selected_or_first_available_variant.compare_at_price  -%}
{%endif-%}
{%if price == 0 -%}
{%assign contact = true -%}
{%endif -%}
{% if compare_at_price > price and compare_at_price > 0 %}
{% assign pt = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | round %}
{% if pt > 99 %}{% assign pt = 99 %}{% endif %}
{% if pt < 1 %}{% assign pt = 1 %}{% endif %}
{% capture discount %}{{ pt }}%{% endcapture %}
{% assign on_sale = true %}
{% endif %}
{% assign variantCount = product.variants | size %}
{% assign on_var = false %}
{% if variantCount > 1 %}
{% assign on_var = true %}
{% endif %}
{%- assign tag_qt_1 = settings.tag_qt_1 -%}
{%- assign tag_qt = false -%}
{%- assign tag_combo = false -%}
{%- assign video = false -%}
{%- assign quycach = false -%}
{%- assign duocsi = false -%}
{%- assign preorder = false -%}
{%- for tag in product.tags -%} 
{%- assign tags = tag -%} 
{%- if tags contains tag_qt_1 -%}
{%- assign tag_qttitle_1 = tags | remove: tag_qt_1 -%}
{%- assign tag_qt = true -%}			
{%- endif -%}
{%- if tags contains 'combo_' -%}
{%- assign tag_combo = true -%}
{%- endif -%}
{% if tags contains 'video:' %} 
{% assign itemvideo = tags | remove: 'video:' %}
{% assign video = true %} 
{% endif %}
{%- if tags contains 'quycach_'-%} 
{%- assign quycach = true -%} 
{% assign itemquycach = tags | remove: 'quycach_' %}
{%- endif -%}
{%- if tags contains 'duocsi_'-%} 
{%- assign duocsi = true -%} 
{% assign itemduocsi = tags | remove: 'duocsi_' %}
{%- endif -%}
{%- if tags contains 'Pre-order' or tags contains 'pre-order' -%} 
{%- assign preorder = true -%} 
{%- endif -%}
{%- endfor -%}
{%- comment -%}
  2026-10-05 (PDP V3 — PRD mục 13): link Shopee Mall lấy từ tag "shopee_<url>". Cách cũ
  `split: '_' | last` cắt mất mọi đoạn trước dấu "_" cuối cùng ⇒ URL Shopee chứa "_" bị hỏng.
  Không có tag ⇒ pc_shopee_url rỗng ⇒ ẩn nút Shopee.
{%- endcomment -%}
{%- assign pc_shopee_url = '' -%}
{%- for pc_tag in product.tags -%}
  {%- assign pc_tag_lc = pc_tag | downcase -%}
  {%- if pc_tag_lc contains 'shopee_' -%}
    {%- assign pc_shopee_url = pc_tag | remove_first: 'shopee_' | remove_first: 'Shopee_' | remove_first: 'SHOPEE_' | strip -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{% include 'breadcrumb' %}   
<section class="product layout-product">	
	{%- include 'product_schema' -%}
	<div class="container">
		<div class="details-product">
			<div class="margin-bottom-30">
				<div class="row">
					<div class="col-xl-4 col-lg-4 col-md-12 col-12 product-detail-left product-images">
						<div class="sticky">
							<div class="product-image-block relative">
								{%if product.images.size > 0 %}
								<div class="swiper-container gallery-top">
									<div class="swiper-wrapper" id="lightgallery">
										{% for image in product.images %}
										<a class="swiper-slide" data-hash="{{ forloop.index0 }}" href="{{ image.src | img_url:'1024x1024' }}" title="Click để xem">
											{%- if forloop.first -%}
											<img height="480" width="720"
												src="{{ image.src | img_url: 'grande' }}"
												alt="{{ product.name | escape }}"
												loading="eager"
												class="img-responsive mx-auto d-block" />
											{%- else -%}
											<img height="480" width="720"
												src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
												data-src="{{ image.src | img_url: 'grande' }}"
												alt="{{ product.name | escape }}"
												class="img-responsive mx-auto d-block lazyload swiper-lazy" />
											{%- endif -%}
										</a>
										{% endfor %}
									</div>
									{%- if settings.metafield_show -%}
									{%- assign metafields_video = product.metafields.custom.Video -%}
									{%- assign cleaned_video = metafields_video | remove: "[" | remove: "]" -%}
									{%- assign video_id = cleaned_video | remove: '"' -%}
									{%- endif -%}
									{%- if video_id != null and video_id != '' and video_id !="" -%}
									<a class="play-video playVideo" href="javascript:void(0)" data-video="{{video_id}}" title="{{settings.product_video_title}}">
										<span>{{settings.product_video_title}}</span>
										<img width="64" height="64" src="{{'icon_youtube.png' | asset_url}}" title="video">
									</a>
									{%- else -%}
									{%- if video -%}
									<a class="play-video playVideo" href="javascript:void(0)" data-video="{{itemvideo}}" title="{{settings.product_video_title}}">
										<span>{{settings.product_video_title}}</span>
										<img width="64" height="64" src="{{'icon_youtube.png' | asset_url}}" title="video">
									</a>
									{%- endif -%}
									{%- endif -%}
								</div>
								{%if product.images.size > 0 %}
								<div class="swiper-container gallery-thumbs {% if product.images.size == 1%} d-none{%endif%}">
									<div class="swiper-wrapper">
										{% for image in product.images %}
										<div class="swiper-slide" data-hash="{{ forloop.index0 }}">
											<div class="p-100">
												<img height="160" width="240" src="{{ image.src | img_url:'medium' }}" alt="{{ product.name | escape}}" data-image="{{ image.src | img_url:'medium'}}" class="swiper-lazy" />
											</div>	
										</div>
										{% endfor %}
									</div>
									<div class="swiper-button-next">
									</div>
									<div class="swiper-button-prev">
									</div>
								</div>
								{%endif%}
								{% else %}
								<img src="{% include 'placeholder_img_url' %}" alt="{{ product.name | escape}}" data-src="{% include 'placeholder_img_url' %}" data-image="{% include 'placeholder_img_url' %}" class="img-responsive center-block">
								{% endif %}
							</div>
						</div>

					</div>
					<div class="col-xl-5 col-lg-5 col-md-12 col-12 details-pro">
						{%- if settings.metafield_show -%}
						{%- assign metafields_quycach = product.metafields.custom.Quycach -%}
						{%- assign cleaned_quycach = metafields_quycach | remove: "[" | remove: "]" -%}
						{%- assign quycach_id = cleaned_quycach | remove: '"' -%}
						{%- if quycach_id != null and quycach_id != '' and quycach_id !="" -%}
						<div class="badge_product">
							<span class="new">{{quycach_id}}</span>	
						</div>
						{% endif %}
						{%else%}
						{%if quycach%}
						<div class="badge_product">
							<span class="new">{{itemquycach}}</span>	
						</div>
						{% endif %}
						{% endif %}
						{%- comment -%}
						  T-135 (2026-09-12) — RULE-P0-01: tên sản phẩm chứa nồng độ hoạt chất và tên
						  thương hiệu quốc tế (Retinol 0.3%, SPF50+ PA++++, Azelaic 15%...). Gắn
						  notranslate để Google Translate KHÔNG dịch/đổi các con số và thuật ngữ dược —
						  dịch sai nồng độ là rủi ro an toàn, không chỉ là lỗi hiển thị.
						{%- endcomment -%}
						<h1 class="title-product notranslate" translate="no">{{ product.name | escape}}</h1>
						<div class="product-top clearfix">
							{{product.variants[0].barcode}}
							{% assign current_variant = product.selected_or_first_available_variant %}
							<div class="sku-product clearfix">
								<span class="d-none">Thương hiệu: <strong class="notranslate" translate="no">{% if product.vendor.size > 0 %}{{ product.vendor }}{% else %}{{ store.name }}{% endif %}</strong></span>
								<span class="variant-sku"  content="{% if product.variants[0].sku != "" and product.variants[0].sku != null %}{{product.variants[0].sku}}{% else %}Đang cập nhật{% endif %}">Mã: <span class="a-sku notranslate" translate="no">{%if product.variants[0].sku != "" and product.variants[0].sku != null %}{{product.variants[0].sku}}{% else %}Đang cập nhật{% endif %}</span></span>
								<br>
								<span class="d-none" >Chất liệu: <strong>{% if product.type.size > 0 %}{{ product.type }}{% else %}Đang cập nhật{% endif %}</strong></span>
							</div>
							{%if settings.product_tab3_enable%}
							<div class="product-review">
								<div class="sapo-product-reviews-badge " data-id="{{ product.id }}" ></div>
								{%- comment -%}
								  T-128 (2026-09-12) — báo cáo audit: "Mất icon 5 ngôi sao bên cạnh số lượng
								  review, chỉ còn chữ số trơ trọi". .sapo-product-reviews-badge ở trên là chỗ
								  app Sapo Product Reviews render vào trên store thật; khi app chưa bật/chưa có
								  dữ liệu thì khối đó RỖNG nên chỉ còn mỗi "(170 đánh giá)". Vẽ sẵn widget sao
								  từ metafields.bpr.rating làm lớp nền — app Sapo (nếu có) vẫn ghi đè badge như
								  cũ, không xung đột.
								{%- endcomment -%}
								{%- comment -%} 2026-10-05 (PRD mục 2 — người dùng chốt): chỉ in sao khi có đánh giá thật
								  (votes > 0); rating > 0 mà votes = 0 là số liệu không có căn cứ ⇒ ẩn. {%- endcomment -%}
								{% if product.metafields.bpr.rating > 0 and product.metafields.bpr.votes > 0 %}
								{% assign pc_rating = product.metafields.bpr.rating %}
								{% assign pc_r_floor = pc_rating | floor %}
								{% assign pc_r_frac = pc_rating | minus: pc_r_floor %}
								{% assign pc_r_half = 0 %}
								{% if pc_r_frac >= 0.25 %}{% assign pc_r_half = pc_r_floor | plus: 1 %}{% endif %}
								<span class="pc-stars" role="img" aria-label="Đánh giá {{ pc_rating }} trên 5 sao">
									{% for i in (1..5) %}
									{% if i <= pc_r_floor %}<i class="fa-solid fa-star pc-stars__on"></i>
									{% elsif i == pc_r_half %}<i class="fa-solid fa-star-half-stroke pc-stars__on"></i>
									{% else %}<i class="fa-regular fa-star pc-stars__off"></i>{% endif %}
									{% endfor %}
									<b class="pc-stars__score">{{ pc_rating }}</b>
								</span>
								{% endif %}
								{% if product.metafields.bpr.votes > 0 %}
								<span>({{ product.metafields.bpr.votes }} đánh giá)</span>
								{%endif%}
							</div>
							{%endif%}
						</div>

						<div class="inventory_quantity">

							<span class="mb-break">
								<span class="stock-brand-title">Tình trạng:</span>
								{% if on_var %} 
								{%if product.selected_or_first_available_variant.available%}
								<span class="a-stock">
									Còn hàng
								</span>
								{%elsif product.selected_or_first_available_variant.inventory_quantity == 0 and product.selected_or_first_available_variant.inventory_policy == 'continue'%}
								<span class="a-stock">
									Còn hàng
								</span>
								{%else%}
								<span class="a-stock">
									Hết hàng
								</span>
								{%endif%}
								{%else%}
								{%if product.available%}
								<span class="a-stock">
									Còn hàng
								</span>
								{%elsif product.inventory_quantity == 0 and product.inventory_policy == 'continue'%}
								<span class="a-stock">
									Còn hàng
								</span>
								{%else%}
								<span class="a-stock">
									Hết hàng
								</span>
								{%endif%}
								{%endif%}
							</span>
						</div>
						{%- if settings.product_flashsale_enable and settings.home_flashsale_countdown_enable and product.available -%}
						{%- for collection in product.collections -%}
						{%- assign url_text = collection.url | remove: "/" -%}
						{%- if url_text == settings.home_flashsale_collection -%}
						{% include 'flashsale_gift' %}
						{%- endif -%}
						{%- endfor -%}
						{%- endif -%}

						<form enctype="multipart/form-data" data-cart-form id="add-to-cart-form" action="/cart/add" method="post" class="form-inline">
							<div class="price-box clearfix">
								{%if on_var%}
								<span class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>

								</span>
								<span class="old-price">
									<del class="price product-price-old">
										{% if product.variants[0].compare_at_price > 0 %}{{ product.variants[0].compare_at_price | money }}{% endif %}
									</del>

								</span>

								{%elseif contacts%}
								<div class="special-price">
									<span class="price product-price"><a style="color: #d31100;" target="_blank" href="https://zalo.me/{{ settings.contact_zalo | remove: ' '}}">Liên hệ </a></span>

							</div>

								{%elseif product.variants[0].compare_at_price > product.variants[0].price%}
								<span class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>

								</span>
								<span class="old-price">
									<del class="price product-price-old">
										{{ product.variants[0].compare_at_price | money }}
									</del>

								</span>

								{% else %}
								<div class="special-price">
									<span class="price product-price">{{ product.variants[0].price | money }}</span>

							</div>
								{% endif %}
								{%if discount.size > 0%}
								<span class="sale-off">- {{ discount }}</span>
								{%endif%}
							</div>
							{% assign variant = product.variants[0] %}
							<div class="form-product">
								{% if settings.product_swatch_enable and product.variants.size > 1 %}
								{% unless product.tags contains "liệu trình" %}
								<div class="select-swatch">
									{% for option in product.options %}
									{% include 'swatch' with option %}
									{% endfor %}
								</div>
								{% endunless %}
								{% endif %}
								<div class="box-variant clearfix {% if settings.product_swatch_enable%} d-none {%endif%}">
									{% if variantCount > 1 %} 
									<select id="product-selectors" class="form-control form-control-lg" name="variantId" style="display:none">
										{% for variant in product.variants %}
										<option {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}">{{ variant.title | escape}} - {{ variant.price | money }}</option>
										{% endfor %}
									</select>
									{% else %}
									<input type="hidden" id="one_variant" name="variantId" value="{{ product.variants[0].id }}" />
									{% endif %}
								</div>

								<div class="boz-form {%if contacts%}d-none{%endif%}">
									{%- if tag_qt-%}
									{%- for i in (1..10) -%}
									{%- capture imga -%}icon_fra_{{i}}.jpg{%- endcapture -%}
									{%- capture namefr -%}tag_fra_{{i}}{%- endcapture -%}
									{%- if settings[namefr] == tag_qttitle_1 -%}
									<input type="hidden" id="quatang" name="properties[Quà tặng]" value="{{settings[namefr]}}"/>
									{%- endif -%}
									{%- endfor -%}
									{%- endif -%}
									<div class="flex-quantity">
										<div class="custom custom-btn-number {% if product.available %}show{%else%}d-none{%endif%}">
											<span>Số lượng: </span>
											<div class="input_number_product">									
												<button class="btn_num num_1 button button_qty" onClick="var result = document.getElementById('qtym'); var qtypro = result.value; if( !isNaN( qtypro ) &amp;&amp; qtypro &gt; 1 ) result.value--;return false;" type="button">-</button>
												<input type="number" id="qtym" name="quantity" value="1" min="1" max="999" class="form-control prd_quantity" onchange="if(!this.value||this.value<1)this.value=1;">
												<button class="btn_num num_2 button button_qty" onClick="var result = document.getElementById('qtym'); var qtypro = result.value; if( !isNaN( qtypro )) result.value++;return false;" type="button"><span>+</span></button>
											</div>
										</div>
										{%if preorder%}
										<div class="btn-mua button_actions clearfix">
											<a id="buyButton" onclick="sapo_calc('{{ product.variants[0].price }}')" class="btn btn-installment tragop-button" href="javascript:;" title="">
												{{settings.product_installment_title}}
											</a>
										</div>
										{%else%}
										<div class="btn-mua button_actions clearfix">
											{% if product.available %}	
											<div class="box_btn_acc">
												<a href="javascript:void(0)" class="buynow btn-buyNow" title="">
													<i class="fas fa-bolt" aria-hidden="true"></i>
													<div class="buynow-text">{{settings.product_buynow_title}}</div>
												</a>
												<button type="submit" class="btn btn_base normal_button btn_add_cart add_to_cart btn-cart">
													<i class="fas fa-cart-shopping" aria-hidden="true"></i>
													<span class="txt-main text_1">Thêm vào giỏ hàng</span>
												</button>
											</div>

											{% if pc_shopee_url != blank %}
											<div class="mua_shop">
												<a href="{{ pc_shopee_url }}" target="_blank" rel="noopener">
													{%- if settings.product_shopee_icon != blank -%}<img src="{{ settings.product_shopee_icon | img_url: 'master' }}" alt="shopee" width="40" height="40" style="width: 40px;margin-right: 5px;" loading="lazy" />{%- endif -%}
													Mua hàng tại shopee
												</a>
											</div>

											{% endif %}


											{% else %}
											<button class="btn btn-lg btn-style btn-style-active btn-cart btn-soldout btn_base btn_dis" disabled="disabled" >
												<span class="txt-main">Hết hàng</span>
											</button>
											{% endif %}
										</div>


										{%endif%}
									</div>
									{%comment%}
									{%if settings.product_store_enable%}
									<a class="btn-hethong" href="javascript:" title="Gợi ý tìm size">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
											<path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"></path>
											<path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path>
										</svg> <span>{{settings.product_store_title}}</span>                              
									</a>
									{% endif %}
									{%endcomment%}
									{% include 'buyxgety-module-detail' %}
									{%- comment -%} 2026-10-05 (PDP V3 — PRD mục 2): bỏ cụm "Chia sẻ" mạng xã hội và nút
									  "Thêm vào yêu thích" khỏi trang sản phẩm — yếu tố gây nhiễu cạnh tranh với CTA mua. {%- endcomment -%}
								</div>

								<div class="boz-form-1 d-none">

									<div class="flex-quantity">

										<div class="btn-mua button_actions clearfix">

											{% unless product.tags contains "liệu trình" %}
											{% if pc_shopee_url != blank %}
											<div class="mua_shop">
												<a href="{{ pc_shopee_url }}" target="_blank" rel="noopener">
													ĐẶT HÀNG TẠI SHOPEE MALL
												</a>
											</div>
											{% endif %}
											{% endunless %}
										</div>



									</div>

								</div>

							</div>
							{%- comment -%} 2026-10-05 (PRD mục 2): bỏ widget lượt xem/lượt mua .abps-productdetail. {%- endcomment -%}
						</form>

						{%if product.summary != null and product.summary != '' and product.summary !=""%}
						<div class="product-summary">
							<div class="rte">
								{{product.summary}}
							</div>
						</div>
						{%endif%}


						{% if settings.product_promo_enable %}
						{% unless product.tags contains "liệu trình" %}
						<div class="khuyen-mai">
							<h3 class="product-promotion__heading">
								{%- if settings.product_gift_icon != blank -%}<img src="{{ settings.product_gift_icon | img_url: 'master' }}" alt="" width="64" height="64" class="mr-2" loading="lazy">{%- endif -%}
								{{settings.product_promo_text}}
							</h3>
							<div class="content">
								{%- if settings.metafield_show -%}
								{%- assign metafields_promotion = product.metafields.custom.Promotion -%}
								{%- assign promotion_video = metafields_promotion | remove: "[" | remove: "]" -%}
								{%- assign promotion = promotion_video | remove: '"' -%}
								{%- endif -%}
								{%- if promotion.size > 0-%}
								{{promotion}}
								{%- else -%}
								<ul>
									{%- for i in (1..2) -%}
									{%- capture naviimage -%}km_product_{{i}}.png{%- endcapture -%}
									{%- capture text -%}km_product{{i}}_text{%- endcapture -%}
									{%- if settings[text] != null and settings[text] != '' -%}
									<li><span class="nb_dis"><img width="24" height="24" src="{{naviimage | asset_url}}" alt="{{settings[text]}}"></span>
										<span class="content_dis">{{settings[text]}}</span>
									</li>
									{%- endif -%}
									{%- endfor -%}
								</ul>
								{%- endif -%}
							</div>
						</div>
						{% endunless %}
						{% endif %}
						{%if settings.product_coupon_enable%}
						{% unless product.tags contains "liệu trình" %}
						{% include 'coupon_products' %}
						{% endunless %}
						{%endif%}

						{%if settings.product_policy_enable%}
						{% unless product.tags contains "liệu trình" %}
						<div class="clearfix"></div>
						<div class="product-policises-wrapper">
							<ul class="product-policises">
								{% for i in (1..4) %}
								{% capture policy_product_use %}product_policy_{{i}}_enable{% endcapture %} {% capture policy_product_title %}product_policy_{{i}}_title{% endcapture %} {% capture policy_product_image %}policy_image_{{i}}.png{% endcapture %}
								{% if settings[policy_product_use] %}
								<li class="item_poli">
									<div class="img_poly">
										<img width="32" height="32" class="lazyload" src="data:image/png;base64,"  
											 data-src="{{ policy_product_image | asset_url}}" alt="{{settings[policy_product_title]}}"/>
									</div>
									<div class="content_poli"> 
										{{settings[policy_product_title]}}
									</div>
								</li>
								{% endif %}
								{% endfor %}
							</ul>
						</div>	
						{% endunless %}
						{% endif %}

						{% if product.tags contains "liệu trình" %}
						<div class="form-inline-1">
							{% if settings.product_swatch_enable and product.variants.size > 0 %}
							<div class="select-swatch">

								{% for option in product.options %}
								{% include 'swatch' with option %}
								{% endfor %}
							</div>
							{% endif %}
						</div>	
						{% endif %}

					</div> 
					<div class="col-xl-3 col-lg-3 col-md-12 col-12 details-pro">
						<div class="box_info_right"> 
							{%if settings.product_info_enable%}
							<div class="store-folow">
								<div class="item_store">
									<div class="item_image_store">
										<div class="image">
											<img width="100" height="100" class="lazyload" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC"  data-src="{{'img_info_icon.jpg' | asset_url }}" alt="{{settings.product_info_title_2}}"/>
										</div>
									</div>
									<div class="info_store">
										<p class="text m-0">{{settings.product_info_title}}</p>
										<p class="name_title">{{settings.product_info_title_2}}</p>
										<div class="title">
											<div class="button-group">
												{%if settings.product_link_1_title.size > 0%}
												<a class="style-button" href="{{settings.product_link_1_url}}" title="{{settings.product_link_1_title}}">
													{{settings.product_link_1_title}}
												</a>
												{%endif%}
												{%if settings.product_link_2_title.size > 0%}
												<a class="style-button" href="{{settings.product_link_2_url}}" title="{{settings.product_link_2_title}}">
													<svg xmlns="http://www.w3.org/2000/svg" enable-background="new 0 0 512 512" height="512" viewBox="0 0 512 512" width="512"><g><g><path d="m474.426 189.681h-436.852c-18.649 0-33.768-15.118-33.768-33.768v-122.145c0-18.65 15.118-33.768 33.768-33.768h436.853c18.649 0 33.768 15.118 33.768 33.768v122.146c-.001 18.649-15.119 33.767-33.769 33.767z" fill="#b3dafe"/><path d="m474.426 0h-30.446c18.649 0 33.768 15.118 33.768 33.768v122.146c0 18.649-15.118 33.768-33.768 33.768h30.446c18.649 0 33.768-15.118 33.768-33.768v-122.146c0-18.65-15.118-33.768-33.768-33.768z" fill="#8ac9fe"/><g fill="#fff"><path d="m448.994 70.173c-3.967-1.377-8.308.72-9.689 4.691l-16.149 46.461-15.869-46.912c-1.818-6.032-11.641-7.542-14.387-.097l-16.701 47.26-15.876-46.589c-1.356-3.978-5.68-6.104-9.66-4.75-3.979 1.357-6.106 5.681-4.75 9.66l22.949 67.348c1.046 3.068 3.92 5.138 7.162 5.157h.044c3.224 0 6.101-2.033 7.176-5.075l16.675-47.185 15.929 47.088c1.042 3.08 3.926 5.159 7.178 5.172h.032c3.239 0 6.125-2.051 7.189-5.113l23.436-67.427c1.382-3.971-.718-8.309-4.689-9.689z"/><path d="m142.441 70.184c-22.513 0-40.828 18.441-40.828 41.108 0 22.668 18.315 41.109 40.828 41.109s40.828-18.441 40.828-41.109c0-22.667-18.316-41.108-40.828-41.108zm0 66.994c-14.119 0-25.605-11.612-25.605-25.886s11.486-25.885 25.605-25.885 25.605 11.611 25.605 25.885-11.487 25.886-25.605 25.886z"/><path d="m300.747 70.184c-22.513 0-40.828 18.441-40.828 41.108 0 22.668 18.315 41.109 40.828 41.109s40.828-18.441 40.828-41.109c0-22.667-18.315-41.108-40.828-41.108zm0 66.994c-14.119 0-25.605-11.612-25.605-25.886s11.486-25.885 25.605-25.885 25.605 11.611 25.605 25.885-11.486 25.886-25.605 25.886z"/><path d="m205.268 37.28c-4.204 0-7.611 3.407-7.611 7.611v99.898c0 4.204 3.408 7.611 7.611 7.611 4.204 0 7.611-3.407 7.611-7.611v-99.897c0-4.204-3.408-7.612-7.611-7.612z"/><path d="m240.234 37.28c-4.204 0-7.611 3.407-7.611 7.611v99.898c0 4.204 3.408 7.611 7.611 7.611s7.611-3.407 7.611-7.611v-99.897c.001-4.204-3.407-7.612-7.611-7.612z"/><path d="m94.456 37.89c-1.144-.268-11.39-2.422-18.781 3.451-2.995 2.38-6.563 6.931-6.563 15.103v15.275h-3.607c-4.204 0-7.611 3.407-7.611 7.611s3.408 7.611 7.611 7.611h3.607v57.848c0 4.204 3.408 7.611 7.611 7.611s7.611-3.407 7.611-7.611v-57.847h7.204c4.204 0 7.611-3.407 7.611-7.611s-3.408-7.611-7.611-7.611h-7.204v-15.276c0-.76.078-2.592.802-3.177 1.132-.917 4.224-.897 5.934-.535 4.077.916 8.136-1.63 9.081-5.708.95-4.095-1.599-8.185-5.695-9.134z"/></g></g><g><path d="m346.189 313.133.004-41.01c.001-9.944 8.062-18.004 18.005-18.004 9.944 0 18.006 8.054 18.006 17.998.002 31.488.002 94.645.002 109.465 0 2.108-.222 4.203-.663 6.265l-17.432 81.551-116.052-9.534-85.088-148.683c-4.586-8.834-3.321-19.571 3.193-27.096 5.548-6.411 15.411-6.651 21.265-.518l42.449 44.475c2.984 3.127 8.257 1.014 8.257-3.308v-134.547c0-9.946 8.063-18.009 18.009-18.009 9.946 0 18.009 8.063 18.009 18.009v122.946z" fill="#ffcebf"/><g fill="#ffb09e"><path d="m166.389 283.851 39.621 41.512c6.257 6.556 16.314 7.685 23.869 2.679l-42.449-44.475c-5.778-6.055-15.455-5.887-21.041.284z"/><path d="m252.841 190.187v112.29c0 5.885 4.771 10.656 10.656 10.656 5.885 0 10.656-4.771 10.656-10.656v-111.853c0-9.4-7.027-17.547-16.39-18.374-4.616-.408-8.889.95-12.275 3.443 4.452 3.279 7.353 8.541 7.353 14.494z"/><path d="m382.205 272.117c-.001-9.944-8.062-17.997-18.006-17.997-3.992 0-7.669 1.315-10.654 3.514 4.449 3.276 7.348 8.533 7.348 14.484.002 35.823.002 112.63.002 112.63l-17.727 82.931 20.944 1.721 17.432-81.551c.441-2.061.663-4.161.663-6.268 0-14.83 0-77.979-.002-109.464z"/></g><path d="m274.154 313.133v-41.005c0-9.946 8.063-18.009 18.009-18.009 9.946 0 18.009 8.063 18.009 18.009v41.005z" fill="#ffcebf"/><path d="m221.946 512c-2.242 0-4.059-1.817-4.059-4.059l-.001-32.549c-.001-13.231 10.727-23.959 23.958-23.96h116.284c13.231-.001 23.95 10.722 23.952 23.953l.001 32.556c0 2.242-1.817 4.06-4.059 4.06h-156.076z" fill="#aee49e"/><path d="m382.079 475.385c-.001-13.231-10.72-23.955-23.952-23.953h-116.284c-.001 0-.003 0-.004 0h85.842c13.231-.001 23.95 10.722 23.952 23.953l.001 32.556c0 2.242-1.817 4.059-4.059 4.059h30.446c2.242 0 4.059-1.818 4.059-4.059z" fill="#8bd8a5"/><path d="m310.171 272.128c0-9.946 8.063-18.009 18.009-18.009 9.946 0 18.009 8.063 18.009 18.009v41.005h-36.018z" fill="#ffcebf"/><g fill="#ffb09e"><path d="m328.18 254.119c-4.021 0-7.722 1.334-10.719 3.561 4.416 3.282 7.29 8.523 7.29 14.447v30.286c0 5.92 4.799 10.719 10.719 10.719s10.719-4.799 10.719-10.719v-30.286c0-9.945-8.063-18.008-18.009-18.008z"/><path d="m292.162 254.119c-4.021 0-7.721 1.334-10.719 3.561 4.416 3.282 7.29 8.523 7.29 14.447v30.286c0 5.92 4.799 10.719 10.719 10.719s10.719-4.799 10.719-10.719v-30.286c0-9.945-8.063-18.008-18.009-18.008z"/></g></g></g></svg>
													{{settings.product_link_2_title}}
												</a>{%endif%}
											</div> 
										</div>
									</div>
								</div>

							</div>
							{% endif %}


						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
					{%- if settings.metafield_show -%}
					{%- assign metafields_combo = product.metafields.custom.Combo -%}
					{%- assign cleaned_ids_combo = metafields_combo | remove: "[" | remove: "]" -%}
					{%- assign cleaned_comma_combo = cleaned_ids_combo | remove: '"' -%}
					{%- assign product_ids_array_combo = cleaned_comma_combo | split: "," -%}
					{%- endif -%}
					{%- if cleaned_comma_combo != null and cleaned_comma_combo != '' and cleaned_comma_combo !="" -%}
					{%- include 'combo_pro_metafield' -%}
					{%- else -%}
					{%- if tag_combo -%}
					{% capture tag_str_prefix_val %}combo{% endcapture %}
					{%- include 'combo_pro' -%}
					{%- endif -%}
					{%- endif -%}

				</div>
			</div>
			<div class="row">
				<div class="col-12">
					<div class="row">
						<div class="col-12 product-review-details {%if product.content contains '<h6>' or settings.product_combo_compat_enable%} col-lg-12 col-xl-8{%else%} col-lg-12 col-xl-12{%endif%}">
							{%include 'tab_product'%}
						</div>
						{%if product.content contains '<h6>' or settings.product_combo_compat_enable %} 
						<div class="col-lg-12 col-xl-4 col-12 product-sidebar">
							<div class="sticky-box">
								{%if product.content contains '<h6>'%} 
								{% include "specifications" %}
								{%endif%}
								{%if settings.product_combo_compat_enable %} 
								<div class="product-favorite">

									<div class="section-title a-left txt-uppercese">
										<h2>
											<a href="/{{ settings.product_related_collection }}" title="{{settings.product_related_title | strip_html}}">{{settings.product_related_title}}</a>
										</h2>
									</div>

									{%- comment -%}
									  T-128 (2026-09-12) — báo cáo audit: khối "Có thể bạn thích" hiện cảnh báo
									  vàng "Sản phẩm đang được cập nhật.", làm đứt luồng bán chéo ngay tại trang
									  quyết định mua. Nguyên nhân đo thật: settings.product_related_collection trỏ
									  vào 1 collection CÓ TỒN TẠI nhưng RỖNG (0 sản phẩm) — đã đổi sang collection
									  có hàng ở configs/settings_data.json. Thêm lớp dự phòng ngay tại template để
									  sự cố "trỏ vào collection rỗng" không bao giờ lại đẩy khách vào ngõ cụt:
									  rơi về "san-pham-ban-chay-noi-bat", cuối cùng mới tới "all".
									{%- endcomment -%}
									{%- assign pc_rel = collections[settings.product_related_collection] -%}
									{%- if pc_rel.products.size == 0 -%}{%- assign pc_rel = collections['san-pham-ban-chay-noi-bat'] -%}{%- endif -%}
									{%- if pc_rel.products.size == 0 -%}{%- assign pc_rel = collections['all'] -%}{%- endif -%}
									<div class="row">
										{%- if pc_rel.products.size > 0 -%}
										{%- for product in pc_rel.products limit: settings.product_related_limit -%}
										<div class="col-xl-6 col-lg-3 col-md-4 col-xs-6 col-6">
											<div class="item_product_main">
												{%include 'product_grid_office'%}
											</div>
										</div>
										{% endfor %}
										{%else%}
										<div class="alert alert-warning alert-warning2 alert-dismissible margin-top-15 section" role="alert">
											Sản phẩm đang được cập nhật.
										</div>
										{%endif%}
									</div>
								</div>
								{%endif%}
							</div>
						</div>
						{%endif%}
					</div>
				</div>
				{%- comment -%} 2026-10-03: đã xoá khối "Thành phần hoạt chất" trùng lặp (khối cuối trang
				  pc-pdp-ingredients-section giữ lại, đọc Blog Sapo) và khối "Ý kiến chuyên gia" dùng
				  doctors[0] (biến mock, luôn ẩn trên Sapo; thay bằng pc-pdp-expert-section) — người dùng chốt.
				{%- endcomment -%}

				{%- if settings.product_recent_enable -%}
				{%- assign check11 = product.url -%}
				{%- assign productRelate = product.collections.first.alias -%}
				{%- assign productRelateCheck = product.collections.size -%}
				{%- assign productRelateCheck2 = product.collections.first.products_count -%}					
				{%- if productRelateCheck > 0 and settings.product_upsell_enable and productRelateCheck2 > 1 -%}
				<div class="col-12">
					<div class="product-related product-swipers">
						<div class="section-title a-left txt-uppercese">
							<h2>
								<a href="/{{ productRelate | handleize }}" title="{{settings.product_same_cate_title | strip_html}}">{{settings.product_same_cate_title}}</a>
							</h2>
						</div>

						<div class="swiper_product_related swiper-container">
							<div class="swiper-wrapper">
								{% for product in collections[productRelate].products limit: settings.product_same_cate_limit %}
								<div class="swiper-slide">
									<div class="item_product_main">
										{%include 'product_grid_office'%}
									</div>
								</div>
								{% endfor %}
							</div>
							<div class="swiper-button-prev">
								<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
							<div class="swiper-button-next">
								<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
						</div>
						<div class="show-more-same">
							<a class='show-more btn btn-primary frame flexbtn' href='/{{ productRelate | handleize }}' title='Xem thêm'>
								Xem thêm <svg height="64" viewBox="0 0 24 24" width="64" xmlns="http://www.w3.org/2000/svg" data-name="Layer 2"><path d="m22.707 11.293-7-7a1 1 0 0 0 -1.414 1.414l5.293 5.293h-17.586a1 1 0 0 0 0 2h17.586l-5.293 5.293a1 1 0 1 0 1.414 1.414l7-7a1 1 0 0 0 0-1.414z"></path></svg>
							</a>
						</div>
					</div>
				</div>
				<script>
					var swiper_related = new Swiper('.swiper_product_related', {
						slidesPerView: 4,
						spaceBetween: 20,
						slidesPerGroup: 1,
						navigation: {
							nextEl: '.swiper_product_related .swiper-button-next',
							prevEl: '.swiper_product_related .swiper-button-prev',
						},
						breakpoints: {
							280: {
								slidesPerView: 2,
								spaceBetween: 15
							},
							640: {
								slidesPerView: 2,
								spaceBetween: 15
							},
							768: {
								slidesPerView: 3,
								spaceBetween: 15
							},
							992: {
								slidesPerView: 4,
								spaceBetween: 15
							},
							1025: {
								slidesPerView: 5,
								spaceBetween: 20
							}
						}
					});
				</script>
				{%- endif -%}
				{%- endif -%}
				{%if settings.product_same_enable%}
				<div class="col-12">
					{% include 'section_same_price' %}
				</div>
				{%endif%}
			</div>
		</div>
	</div>

</section>
{% if settings.product_viewed_enable %}
{% include 'section_product_viewed' %}
{% endif %}
{%- if product.content contains '<h6>' -%}
{%- assign description_parts = product.content | split: "<h6>" -%}
{%- for part in description_parts -%}
{%- assign fp = part | append: " " | split: "</h6>" | last -%}
{%- assign p = part | append: " " | split: "</h6>" | last | strip_html | replace: "&nbsp;", "" | replace: " ", "" | strip_newlines -%}
{%- if p != "" or fp contains "<img" or fp contains "<iframe" -%}
{%- if forloop.index0 == '1' -%}
<div id="specificationsModal" class="modal-specifications" style="display:none;">
	<div class="modalsize-overlay fancybox-overlay fancybox-overlay-fixed"></div>
	<div class="modal-specificationsModal-product">
		<div class="chosee_size">
			<p class="title-popup">
				{{settings.product_specifications_title}}
			</p>
			<a title="Close" class="specifications-close close-window" href="javascript:;">
				<svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="times" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" class="svg-inline--fa fa-times fa-w-10"><path fill="currentColor" d="M207.6 256l107.72-107.72c6.23-6.23 6.23-16.34 0-22.58l-25.03-25.03c-6.23-6.23-16.34-6.23-22.58 0L160 208.4 52.28 100.68c-6.23-6.23-16.34-6.23-22.58 0L4.68 125.7c-6.23 6.23-6.23 16.34 0 22.58L112.4 256 4.68 363.72c-6.23 6.23-6.23 16.34 0 22.58l25.03 25.03c6.23 6.23 16.34 6.23 22.58 0L160 303.6l107.72 107.72c6.23 6.23 16.34 6.23 22.58 0l25.03-25.03c6.23-6.23 6.23-16.34 0-22.58L207.6 256z" class=""></path></svg>
			</a>
		</div>
		<div class="modal-body">
			{{ part | split: "</h6>" | last | replace: "<div", "<span" | replace: "</div", "</span"}}
		</div>
	</div>
</div>
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%include 'popup_tragop'%} 
{%if settings.product_store_enable%}
<div id="modal-store-product" class="modalstore-product" style="display:none;">
	<div class="modalstore-overlay fancybox-overlay fancybox-overlay-fixed"></div>
	<div class="modal-store-product">
		{% include 'product-hethong' %}
		<a title="Close" class="modalstore-close close-window" href="javascript:;">
			<svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="times" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" class="svg-inline--fa fa-times fa-w-10"><path fill="currentColor" d="M207.6 256l107.72-107.72c6.23-6.23 6.23-16.34 0-22.58l-25.03-25.03c-6.23-6.23-16.34-6.23-22.58 0L160 208.4 52.28 100.68c-6.23-6.23-16.34-6.23-22.58 0L4.68 125.7c-6.23 6.23-6.23 16.34 0 22.58L112.4 256 4.68 363.72c-6.23 6.23-6.23 16.34 0 22.58l25.03 25.03c6.23 6.23 16.34 6.23 22.58 0L160 303.6l107.72 107.72c6.23 6.23 16.34 6.23 22.58 0l25.03-25.03c6.23-6.23 6.23-16.34 0-22.58L207.6 256z" class=""></path></svg>
		</a>
	</div>
</div>
{%- if video -%}
<div class="popup-video">
	<div class="body-popup">
	</div>
	<div class="close-popup-video">
		<i class="fa fa-close"></i>
		Đóng
	</div>
</div>
{%- endif -%}
<script>
	$(document).on('click', '.modalstore-close, #modal-store-product .modalstore-overlay, .fancybox-overlay', function(e){
		$("#modal-store-product").fadeOut(0);
		awe_hidePopup();
	});
	$(document).ready(function ($){
		var modal = $('.modalstore-product');
		var btn = $('.btn-hethong');
		var span = $('.modalstore-close');
		btn.click(function () {
			modal.show();
		});
		span.click(function () {
			modal.hide();
		});
		$(window).on('click', function (e) {
			if ($(e.target).is('.modal')) {
				modal.hide();
			}
		});
	});
</script>
{%endif%}
<script> 
	var variantsize = false;
	var ww = $(window).width();
	function validate(evt) {
		var theEvent = evt || window.event;
		var key = theEvent.keyCode || theEvent.which;
		key = String.fromCharCode( key );
		var regex = /[0-9]|\./;
		if( !regex.test(key) ) {
			theEvent.returnValue = false;
			if(theEvent.preventDefault) theEvent.preventDefault();
		}
	}
	var selectCallback = function(variant, selector) {
		if (variant) {
			var form = jQuery('#' + selector.domIdPrefix).closest('form');
			for (var i=0,length=variant.options.length; i<length; i++) {
				var radioButton = form.find('.swatch[data-option-index="' + i + '"] :radio[value="' + variant.options[i] +'"]');
				if (radioButton.size()) {
					radioButton.get(0).checked = true;
				}
			}
		}
		var addToCart = jQuery('.form-product .btn-cart.normal_button'),
			FastAddToCart = jQuery('.form-product .btn-buyNow'),
			form = jQuery('.form-product .boz-form'),
			form1 = jQuery('.form-product .boz-form-1'),
			productPrice = jQuery('.details-pro .special-price .product-price'),
			qty = jQuery('.inventory_quantity .a-stock'),
			comparePrice = jQuery('.details-pro .old-price .product-price-old'),
			comparePriceText = jQuery('.details-pro .old-price'),
			savePrice = jQuery('.details-pro .save-price .product-price-save'),
			savePriceText = jQuery('.details-pro .save-price'),
			qtyBtn = jQuery('.form-product .custom-btn-number'),
			BtnSold = jQuery('.form-product .form-group .btn-mua'),
			product_sku = jQuery('.details-product .sku-product .variant-sku');
		if (variant && variant.sku != "" && variant.sku != null){
			product_sku.html("Mã: <span class='a-sku notranslate' translate='no'>" + variant.sku + "</span>");
		} else {
			product_sku.html('Mã: <span class="a-sku notranslate" translate="no">Đang cập nhật</span>');
		}
		FastAddToCart.addClass('d-none');
		if (variant && variant.available) {
			if(variant.inventory_management == "bizweb"){
				if (variant.inventory_quantity != 0) {
					qty.html('<span class="a-stock">Còn hàng</span>');
				} else if (variant.inventory_quantity == ''){
					if (variant.inventory_policy == "continue"){
						qty.html('<span class="a-stock">Còn hàng</span>');
					} else {
						qty.html('<span class="a-stock a-stock-out">Hết hàng</span>');
					}
				}
			}else{
				qty.html('<span class="a-stock">Còn hàng</span>');
			}
			FastAddToCart.removeClass('d-none');
			addToCart.html('<span class="txt-main">Thêm vào giỏ hàng</span>').removeAttr('disabled');	
			BtnSold.removeClass('btnsold');
			qtyBtn.removeClass('d-none');
			if(variant.price == 0){
				console.log("vafo owr day")
				productPrice.html('Liên hệ');
				comparePrice.hide();
				savePrice.hide();
				comparePriceText.hide();
				jQuery('.sale-off').hide();
				savePriceText.hide();
				form.addClass('d-none');
				form1.removeClass('d-none');
			}else{
				form.removeClass('d-none');
				productPrice.html(Bizweb.formatMoney(variant.price, "{{ store.money_format }}"));

													 if ( variant.compare_at_price > variant.price ) {
								  comparePrice.html(Bizweb.formatMoney(variant.compare_at_price, "{{ store.money_format }}")).show();
								  savePrice.html(Bizweb.formatMoney(variant.compare_at_price - variant.price, "{{ store.money_format }}")).show();
								  comparePriceText.show();
				jQuery('.sale-off').html("-" + (Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100)) + "%").show();
				savePriceText.show();
			} else {
				comparePrice.hide();   
				savePrice.hide();
				comparePriceText.hide();
				savePriceText.hide();
				jQuery('.sale-off').hide();
			}       										
		}
	} else {	
		qty.html('<span class="a-stock a-stock-out">Hết hàng</span>');
		FastAddToCart.addClass('d-none');
		addToCart.html('<span class="txt-main">Hết hàng</span>').attr('disabled', 'disabled');
		BtnSold.addClass('btnsold');
		qtyBtn.addClass('d-none');
		if(variant){
			if(variant.price != 0){
				form.removeClass('d-none');
				productPrice.html(Bizweb.formatMoney(variant.price, "{{ store.money_format }}"));
													 if ( variant.compare_at_price > variant.price ) {
								  FastAddToCart.addClass('d-none');
				addToCart.html('<span class="txt-main">Hết hàng</span>').attr('disabled', 'disabled');
				comparePrice.html(Bizweb.formatMoney(variant.compare_at_price, "{{ store.money_format }}")).show();
													 savePrice.html(Bizweb.formatMoney(variant.compare_at_price - variant.price, "{{ store.money_format }}")).show();
													 comparePriceText.show();
								  jQuery('.sale-off').html("-" + (Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100)) + "%").show();
				savePriceText.show();
			} else {
				comparePrice.hide();  
				savePrice.hide();
				comparePriceText.hide();
				savePriceText.hide();
				FastAddToCart.addClass('d-none');
				addToCart.html('<span class="txt-main">Hết hàng</span>').attr('disabled', 'disabled');
			}     
		}else{
			console.log("vafo owr day 1")
			productPrice.html('Liên hệ');
			comparePrice.hide();
			savePrice.hide();
			comparePriceText.hide();
			jQuery('.sale-off').hide();
			savePriceText.hide();
			form.addClass('d-none');
			form1.removeClass('d-none');
		}
	}else{
		console.log("vafo owr day 2")
		productPrice.html('Liên hệ');
		comparePrice.hide();
		savePrice.hide();
		comparePriceText.hide();
		jQuery('.sale-off').hide();
		savePriceText.hide();
		form.addClass('d-none');
		form1.removeClass('d-none');
	}
	}
	/*begin variant image*/
	if (variant && variant.image) {  
		var originalImage = jQuery(".gallery-thumbs img");
		var stickoriginalImage = jQuery(".nd-product-news img");
		var newImage = variant.image;
		var element = originalImage[0];
		Bizweb.Image.switchImage(newImage, element, function (newImageSizedSrc, newImage, element) {
			$('.gallery-thumbs .swiper-slide').each(function(){
				var $this = $(this);
				var imgThis = $this.find('img').attr('data-image');
				if(newImageSizedSrc.split("?")[0] == imgThis.split("?")[0]){
					var pst = $this.attr('data-hash');
					galleryTop.slideTo(pst, 1000,false);
				}
				jQuery(stickoriginalImage).attr('src', newImageSizedSrc);
			});
		});
	}
	/*end of variant image*/
	};
	jQuery(function($) {
		{% if  product.variants.size > 1 %}
		new Bizweb.OptionSelectors('product-selectors', {
			product: {{ product | json }},
			onVariantSelected: selectCallback, 
			enableHistoryState: true
		});      
		{% endif %}
		// Add label if only one product option and it isn't 'Title'. Could be 'Size'.
		{% if product.options.size == 1 and product.options.first != 'Title' %}
		$('.selector-wrapper:eq(0)').prepend('<label>{{ product.options.first }}</label>');
											 {% endif %}
											 // Hide selectors if we only have 1 variant and its title contains 'Default'.
											 {% if product.variants.size == 1 and product.variants.first.title contains 'Default' %}
											 $('.selector-wrapper').hide();
		{% endif %} 
		$('.selector-wrapper').css({
			'text-align':'left',
			'margin-bottom':'15px'
		});
	});

	jQuery('.swatch :radio').change(function() {
		var optionIndex = jQuery(this).closest('.swatch').attr('data-option-index');
		var optionValue = jQuery(this).val();
		jQuery(this)
			.closest('form')
			.find('.single-option-selector')
			.eq(optionIndex)
			.val(optionValue)
			.trigger('change');
		$(this).closest('.swatch').find('.header .value-roperties').html(optionValue);
	});
	setTimeout(function(){
		$('.swatch .swatch-element').each(function(){
			$(this).closest('.swatch').find('.header .value-roperties').html($(this).closest('.swatch').find('input:checked').val());
		});
	}, 500);
	$(document).on('click', '.btn-buy-now', function(){
		var _variantID = $('#product-selectors').val();
		var _Qty = parseInt($('#qtym').val()) || 1;
		if(_variantID == null){
			_variantID = $('#one_variant').val();
		}
		jQuery.ajax({
			type: "POST",
			url: "/cart/add.js",
			data: "quantity=" + _Qty + "&variantId=" + _variantID,
			dataType: "json",
			success: function(e) {
				window.location = '/checkout';
			},
			error: function(e, t) {
				Bizweb.onError(e, t);
			}
		});
	});

	$('.slider-big-video .slider-for a').each(function() {
		$(this).attr('rel','lightbox-demo'); 
	});

</script>
<script>
	{%if settings.product_recent_enable%}
	var getLimit = {{ settings.product_recent_limit | default: 6 }};
	var alias = '{{product.alias}}';
	{%endif%}
	function activeTab(obj){
		$('.product-tab ul .tab-link').removeClass('active');
		$(obj).addClass('active');
		var id = $(obj).attr('data-tab');
		$('.tab-content').removeClass('active');
		$(id).addClass('active');
	}


	$('.product-tab ul .tab-link').click(function(){
		activeTab(this);
		return false;
	});
	var galleryThumbs = new Swiper('.gallery-thumbs', {
		spaceBetween: 5,
		slidesPerView: 10,
		freeMode: true,
		lazy: true,
		watchSlidesVisibility: true,
		watchSlidesProgress: true,
		hashNavigation: true,
		slideToClickedSlide: true,
		breakpoints: {
			260: {
				slidesPerView: 3,
				spaceBetween: 10,
			},
			300: {
				slidesPerView: 4,
				spaceBetween: 10,
			},
			500: {
				slidesPerView: 4,
				spaceBetween: 10,
			},
			640: {
				slidesPerView: 4,
				spaceBetween: 10,
			},
			768: {
				slidesPerView: 5,
				spaceBetween: 10
			},
			992: {
				slidesPerView: 4,
				spaceBetween: 10,
			},
			1024: {
				slidesPerView: 4,
				spaceBetween: 10
			},
			1199: {
				slidesPerView: 4,
				spaceBetween: 10
			}
		},
		navigation: {
			nextEl: '.gallery-thumbs .swiper-button-next',
			prevEl: '.gallery-thumbs .swiper-button-prev',
		},
	});
	var galleryTop = new Swiper('.gallery-top', {
		spaceBetween: 10,
		lazy: true,
		hashNavigation: true,
		thumbs: {
			swiper: galleryThumbs
		}
	});
	var swiper = new Swiper('.product-relate-swiper', {
		slidesPerView: 4,
		loop: false,
		grabCursor: true,
		spaceBetween: 30,
		roundLengths: true,
		slideToClickedSlide: false,
		navigation: {
			nextEl: '.product-relate-swiper .swiper-button-next',
			prevEl: '.product-relate-swiper .swiper-button-prev',
		},
		autoplay: false,
		breakpoints: {
			260: {
				slidesPerView: 'auto',
				spaceBetween: 15
			},
			500: {
				slidesPerView: 2,
				spaceBetween: 15
			},
			640: {
				slidesPerView: 3,
				spaceBetween: 15
			},
			768: {
				slidesPerView: 3,
				spaceBetween: 30
			},
			991: {
				slidesPerView: 4,
				spaceBetween: 30
			},
			1200: {
				slidesPerView: 4,
				spaceBetween: 30
			}
		}
	});
	$(document).ready(function() {
		$("#lightgallery").lightGallery({
			thumbnail: false
		}); 
		$("#videolary").lightGallery({
			thumbnail: false
		}); 
	});
	$('.btn-buyNow').on('click', function(event) {
		$.ajax({
			url:'/cart/add.js',
			type: "post",
			data: $("#add-to-cart-form").serialize(),
			datatype: "json",
			success: function(data){
				window.location.href = "/checkout";
			},
			error: function(){
			}
		});
		event.preventDefault();
	});
	$('.btn--view-more').on('click', function(e){
		e.preventDefault();
		var $this = $(this);
		if( $('.product-review-details .product-review-content').hasClass('expanded')) {
			$('html, body').animate({ scrollTop: $('.product-review-details').offset().top - 110 }, 'slow');
		}
		$this.parents('.product-review-details').find('.product-review-content').toggleClass('expanded');
		$(this).toggleClass('active');
		return false;
	});
	{% if settings.product_viewed_enable %}
	$(document).ready(function ($){
		var product = {{ product | json }};
		var alias_pro = '{{ product.alias }}';
		var array_list = [product];
		var list_viewed_pro_old = localStorage.getItem('last_viewed_products');
		var last_viewed_pro_new = "";
		if(list_viewed_pro_old == null || list_viewed_pro_old == '')
			last_viewed_pro_new = array_list;
		else{
			var list_viewed_pro_old = JSON.parse(localStorage.last_viewed_products);
			list_viewed_pro_old.splice(5, 1);
			for (i = 0; i < list_viewed_pro_old.length; i++) {
				if ( list_viewed_pro_old[i].alias == alias_pro ) {
					list_viewed_pro_old.splice(i,1);
					break;
				}
			}
			list_viewed_pro_old.unshift(array_list[0]);
			last_viewed_pro_new = list_viewed_pro_old;
		}
		localStorage.setItem('last_viewed_products',JSON.stringify(last_viewed_pro_new));
	});
	{% endif %}

	$('.playVideo').on('click', function(e){
		var idVideo = $(this).attr('data-video');
		$('.popup-video').addClass('active');
		$('.popup-video .body-popup').html(`<iframe width="560" height="315" src="https://www.youtube.com/embed/` + idVideo + `" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`)
	});
	$('.close-popup-video').on('click', function(e){
		$('.popup-video').removeClass('active');
		$('.popup-video .body-popup').html(' ');
	});
	$(document).ready(function () {
		$('.lc-option-box-size .cursor-pointer').click(function () {
			$('.lc-option-box-size .cursor-pointer').removeClass('active');
			$(this).addClass('active');
			const selectedText = $(this).text().trim();
			if (selectedText === 'Lớn hơn') {
				$('.ba-text-fpt').addClass('font-large');
			} else {
				$('.ba-text-fpt').removeClass('font-large');
			}
		});
	});
</script>
{% include 'product-recommend' %}

{%- comment -%}
  2026-10-03: "Thành phần hoạt chất" đọc từ blog hoạt chất (settings.ingredient_blog_handle — cùng
  blog của trang Tra cứu hoạt chất) thay 4 thẻ ghi cứng (trước đây giống nhau ở mọi sản phẩm).
  Sản phẩm gắn tag "hoatchat:<handle bài hoạt chất>" (nhiều tag được, hiện theo thứ tự tag).
  Thẻ: tiêu đề bài = tên, summary = cơ chế tác động, tag "icon:<ký hiệu>" (tuỳ chọn) trên bài.
  Sản phẩm không có tag hoặc không khớp bài nào → ẩn khối (người dùng chốt).
{%- endcomment -%}
{%- assign pc_pi_blog_handle = settings.ingredient_blog_handle | default: 'hoat-chat' -%}
{%- assign pc_pi_blog = blogs[pc_pi_blog_handle] -%}
{%- capture pc_pi_cards -%}
{%- for pc_pi_tag in product.tags -%}
  {%- if pc_pi_tag contains ':' -%}
    {%- assign pc_pi_raw_key = pc_pi_tag | split: ':' | first -%}
    {%- assign pc_pi_key = pc_pi_raw_key | strip | downcase -%}
    {%- if pc_pi_key == 'hoatchat' -%}
      {%- assign pc_pi_handle = pc_pi_tag | remove_first: pc_pi_raw_key | remove_first: ':' | strip | downcase -%}
      {%- for pc_pi in pc_pi_blog.articles -%}
        {%- assign pc_pi_item_handle = pc_pi.url | split: '/' | last -%}
        {%- if pc_pi_item_handle == pc_pi_handle -%}
          {%- assign pc_pi_icon = '' -%}
          {%- for pc_pi_atag in pc_pi.tags -%}
            {%- assign pc_pi_akey = pc_pi_atag | split: ':' | first | strip | downcase -%}
            {%- if pc_pi_atag contains ':' and pc_pi_akey == 'icon' -%}
              {%- assign pc_pi_araw = pc_pi_atag | split: ':' | first -%}
              {%- assign pc_pi_icon = pc_pi_atag | remove_first: pc_pi_araw | remove_first: ':' | strip -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if pc_pi_icon == blank -%}{%- assign pc_pi_icon = pc_pi.title | slice: 0, 2 | upcase -%}{%- endif -%}
      <div class="pc-pdp-ing-card">
        <span class="pc-pdp-ing-icon">{{ pc_pi_icon }}</span>
        <h3>{{ pc_pi.title }}</h3>
        {%- if pc_pi.summary != blank -%}<p>{{ pc_pi.summary | strip_html }}</p>{%- endif -%}
      </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if pc_pi_cards != blank -%}
<section class="pc-pdp-ingredients-section">
  <div class="container">
    <h2 class="pc-section-title pc-pdp-ingredients-title">Thành Phần Hoạt Chất &amp; Cơ Chế Tác Động Y Khoa</h2>
    <div class="pc-pdp-ingredients-grid">
      {{ pc_pi_cards }}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%}
  2026-10-03: "Ý kiến chuyên gia" đọc từ Blog Sapo (settings.expert_opinion_blog_handle) thay câu
  trích dẫn + tên chuyên gia ghi cứng (trước đây hiện GIỐNG NHAU ở mọi sản phẩm). Mỗi ý kiến = 1 bài
  viết: summary (hoặc content) = lời trích dẫn; tag "sanpham:<alias sản phẩm>" (gắn nhiều được) để
  chọn sản phẩm; tag "chuyengia:<handle bài hồ sơ>" lấy tên/ảnh/năm KN từ blog chuyên gia
  (snippets/expert_fields.bwt). Sản phẩm không có ý kiến riêng → ẩn khối (người dùng chốt).
{%- endcomment -%}
{%- assign pc_op_blog_handle = settings.expert_opinion_blog_handle | default: 'y-kien-chuyen-gia' -%}
{%- assign pc_op_blog = blogs[pc_op_blog_handle] -%}
{%- assign pc_op_alias = product.alias | downcase -%}
{%- assign pc_op = false -%}
{%- assign pc_op_found = false -%}
{%- assign pc_op_expert_handle = '' -%}
{%- for pc_op_item in pc_op_blog.articles -%}
  {%- unless pc_op_found -%}
    {%- assign pc_op_item_expert = '' -%}
    {%- for pc_op_tag in pc_op_item.tags -%}
      {%- if pc_op_tag contains ':' -%}
        {%- assign pc_op_raw_key = pc_op_tag | split: ':' | first -%}
        {%- assign pc_op_key = pc_op_raw_key | strip | downcase -%}
        {%- assign pc_op_val = pc_op_tag | remove_first: pc_op_raw_key | remove_first: ':' | strip -%}
        {%- if pc_op_key == 'chuyengia' -%}{%- assign pc_op_item_expert = pc_op_val -%}{%- endif -%}
        {%- if pc_op_key == 'sanpham' -%}
          {%- assign pc_op_val_lc = pc_op_val | downcase -%}
          {%- if pc_op_val_lc == pc_op_alias -%}{%- assign pc_op = pc_op_item -%}{%- assign pc_op_found = true -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if pc_op_found -%}{%- assign pc_op_expert_handle = pc_op_item_expert -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- if pc_op_found -%}
{%- assign pc_op_expert = false -%}
{%- if pc_op_expert_handle != blank -%}
  {%- assign pc_ex_blog_handle = settings.expert_blog_handle | default: 'chuyen-gia' -%}
  {%- assign pc_ex_blog = blogs[pc_ex_blog_handle] -%}
  {%- for pc_ex_item in pc_ex_blog.articles -%}
    {%- assign pc_ex_item_handle = pc_ex_item.url | split: '/' | last -%}
    {%- if pc_ex_item_handle == pc_op_expert_handle -%}{%- assign pc_op_expert = pc_ex_item -%}{%- endif -%}
  {%- endfor -%}
  {%- if pc_op_expert -%}{%- assign pc_ex = pc_op_expert -%}{%- include 'expert_fields' -%}{%- endif -%}
{%- endif -%}
{%- if pc_op_expert -%}{%- assign pc_op_name = pc_op_expert.title -%}{%- else -%}{%- assign pc_op_name = pc_op.author -%}{%- endif -%}
{%- assign pc_op_quote = pc_op.summary | default: pc_op.content | strip_html | strip -%}
<section class="pc-pdp-expert-section">
  <div class="container">
    <div class="pc-pdp-expert-card">
      <div class="pc-testi-avatar pc-pdp-expert-avatar{% if pc_op_expert and pc_op_expert.image.src != blank %} pc-testi-avatar--img{% endif %}">
        {%- if pc_op_expert and pc_op_expert.image.src != blank -%}
        <img src="{{ pc_op_expert.image.src | img_url: 'medium' }}" alt="{{ pc_op_name | escape }}" width="64" height="64" loading="lazy"
          onerror="this.onerror=null;this.closest('.pc-testi-avatar').classList.remove('pc-testi-avatar--img');this.remove();">
        {%- endif -%}
        <span class="pc-testi-avatar-initials">{{ pc_op_name | slice: 0, 2 | upcase }}</span>
      </div>
      <div class="pc-pdp-expert-content">
        <span class="pc-pdp-expert-label">Ý KIẾN CHUYÊN GIA{% if pc_op_name != blank %} • {{ pc_op_name | upcase }}{% endif %}{% if pc_op_expert and pc_ex_years != blank %} ({{ pc_ex_years }} NĂM KINH NGHIỆM){% endif %}</span>
        <p class="pc-pdp-expert-quote">"{{ pc_op_quote }}"</p>
        <a href="/pages/dat-lich-tu-van" class="pc-cg-cta-btn pc-pdp-expert-btn">Đặt Lịch Tư Vấn Phác Đồ Cùng Chuyên Gia ➔</a>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%}
  2026-10-03: đánh giá khách hàng đọc từ Blog Sapo (settings.testimonial_blog_handle) thay biến
  mock `patient_testimonials` (chỉ có ở preview-mock.js). Tiêu đề bài = tên khách, ảnh bài =
  avatar, summary (hoặc content) = lời đánh giá, tag "ketqua:..." = kết quả điều trị.
  Blog trống → ẩn cả section, không hiển thị đánh giá mẫu.
{%- endcomment -%}
{%- assign pc_tm_blog_handle = settings.testimonial_blog_handle | default: 'danh-gia-khach-hang' -%}
{%- assign pc_tm_blog = blogs[pc_tm_blog_handle] -%}
{%- if pc_tm_blog.articles.size > 0 -%}
<section class="pc-pdp-reviews-section">
  <div class="container">
    <h2 class="pc-section-title pc-pdp-reviews-title">Đánh Giá Từ Bệnh Nhân Đã Điều Trị Thực Tế</h2>
    <div class="pc-pdp-reviews-grid">
      {% for pc_tm in pc_tm_blog.articles limit: 3 %}
      {%- assign pc_tm_quote = pc_tm.summary | default: pc_tm.content | strip_html | strip -%}
      {%- assign pc_tm_result = '' -%}
      {%- for pc_tm_tag in pc_tm.tags -%}
        {%- assign pc_tm_raw_key = pc_tm_tag | split: ':' | first -%}
        {%- assign pc_tm_key = pc_tm_raw_key | strip | downcase -%}
        {%- if pc_tm_tag contains ':' and pc_tm_key == 'ketqua' -%}
          {%- assign pc_tm_result = pc_tm_tag | remove_first: pc_tm_raw_key | remove_first: ':' | strip -%}
        {%- endif -%}
      {%- endfor -%}
      <div class="pc-testi-card pc-pdp-review-card">
        <div class="pc-testi-card-inner">
          <div class="pc-testi-author-row">
            <div class="pc-testi-avatar{% if pc_tm.image.src != blank %} pc-testi-avatar--img{% endif %}">
              {%- if pc_tm.image.src != blank -%}
              <img src="{{ pc_tm.image.src | img_url: 'medium' }}" alt="{{ pc_tm.title | escape }}" width="48" height="48" loading="lazy"
                onerror="this.onerror=null;this.closest('.pc-testi-avatar').classList.remove('pc-testi-avatar--img');this.remove();">
              {%- endif -%}
              <span class="pc-testi-avatar-initials">{{ pc_tm.title | slice: 0, 2 | upcase }}</span>
            </div>
            <div>
              <div class="pc-testi-author-name">{{ pc_tm.title }}</div>
              {%- if pc_tm_result != blank -%}<div class="pc-cg-testi-result">{{ pc_tm_result }}</div>{%- endif -%}
            </div>
          </div>
          <p class="pc-testi-result-desc pc-pdp-review-quote">"{{ pc_tm_quote }}"</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%}
  2026-10-03: FAQ trang sản phẩm đọc từ Blog Sapo (settings.product_faq_blog_handle) thay biến
  mock `faqs.product` (chỉ có ở preview-mock.js). Mỗi câu hỏi = 1 bài viết: tiêu đề = câu hỏi,
  nội dung = câu trả lời. Blog trống → ẩn section.
{%- endcomment -%}
{%- assign pc_faq_blog_handle = settings.product_faq_blog_handle | default: 'cau-hoi-san-pham' -%}
{%- assign pc_faq_blog = blogs[pc_faq_blog_handle] -%}
{%- if pc_faq_blog.articles.size > 0 -%}
<section class="pc-booking-faq-section pc-pdp-faq-section">
  <div class="container">
    <h2 class="pc-section-title pc-booking-faq-title">Câu Hỏi Thường Gặp</h2>
    <div class="pc-booking-faq-list">
      {% for pc_faq in pc_faq_blog.articles %}
      <details class="pc-faq-item">
        <summary class="pc-faq-q">{{ pc_faq.title }}</summary>
        <div class="pc-faq-a">{{ pc_faq.content }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif -%}

<div class="ab-most-view-product-module ab-hide"></div>
