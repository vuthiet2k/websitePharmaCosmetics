{% include 'breadcrumb' %}
{%- comment -%}
  2026-10-15: dòng quà tặng / ô cam kết trước đây hardcode cứng trong template —
  dòng "Tặng 01 Tuýp Mini Kem Chống Nắng 10ml (Đã chọn ✓)" hiện với MỌI giỏ hàng dù không có quà nào
  được thêm vào đơn (bịa ưu đãi). Nay đọc từ settings (Cài đặt giao diện → Nội dung trang giỏ hàng);
  quà tặng để trống = ẩn. Thanh "1. Giỏ hàng → 2. Thông tin giao hàng → 3. Thanh toán" + dòng lưu ý
  "Chuyên gia sẽ gọi điện…" đã bỏ hẳn: bấm Đặt hàng là sang checkout của Sapo (có luồng bước riêng) nên thừa; quà thật phải cấu hình ở Sapo Admin (module Mua X tặng Y).
{%- endcomment -%}
{%- if settings.cart_gift_text != blank and cart.item_count > 0 -%}
<div class="container pc-cart-gift mt-2">
	<div class="pc-kit-badge-gold text-xs sm:text-sm !inline-flex w-auto"><i class="fa-solid fa-gift" aria-hidden="true"></i> {{ settings.cart_gift_text }}</div>
</div>
{%- endif -%}
{% assign invoice = 'Xuất hóa đơn' %}
{% assign company_name = 'Tên công ty' %}
{% assign company_address = 'Địa chỉ công ty' %}
{% assign tax_code = 'Mã số thuế' %}
{% assign invoice_email = 'Email nhận hóa đơn' %}
<section class="main-cart-page main-container col1-layout">
	<div class="main container cartpcstyle">
		<div class="wrap_background_aside margin-bottom-40">
			<div class="row">
				<div class="col-xl-8 col-lg-7 col-12 col-cart-left">
					<div class="bg-shadow margin-bottom-20">
						<div class="header-cart border-b border-gray-100 pb-3 mb-2">
							<div class="title-block-page">
								<h1 class="title_cart font-heading text-forest-900 text-xl sm:text-2xl font-extrabold flex items-center gap-2">
									<i class="fa-solid fa-bag-shopping text-clinical-700 text-lg" aria-hidden="true"></i>
									<span>Giỏ hàng của bạn</span>
								</h1>
								{%- comment -%} 2026-10-16 (thiết kế giỏ hàng): số sản phẩm dưới tiêu đề, thay dòng "Số sản phẩm" trong khung đơn hàng; JS cập nhật theo 'ajaxCart'. {%- endcomment -%}
								{%- assign _cart_count_text = settings.cart_count_text | default: '{so} sản phẩm' -%}
								<p class="cart-head-count" data-cart-count data-template="{{ _cart_count_text | escape }}">{{ _cart_count_text | replace: '{so}', cart.item_count }}</p>
							</div>
						</div>
						<div class="cart-page d-xl-block d-none">
							<div class="drawer__inner">
								<div class="CartPageContainer">
									{%- comment -%} SSR fallback — JS sẽ overwrite ngay khi /cart.js về {%- endcomment -%}
									{%- include 'cart_initial_ssr', target: 'desktop' -%}
								</div>
							</div>
						</div>
						<div class="cart-mobile-page d-block d-xl-none">
							<div class="CartMobileContainer">
								{%- include 'cart_initial_ssr', target: 'mobile' -%}
							</div>
						</div>
					</div>
					{%- comment -%} 2026-10-16 (thiết kế giỏ hàng): "Tiếp tục mua hàng" chuyển từ khung đơn hàng xuống dưới bảng sản phẩm. {%- endcomment -%}
					<a class="cart-continue-link" href="{{ settings.cart_continue_url | default: '/collections/all' | escape }}"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {{ settings.cart_continue_label | default: 'Tiếp tục mua hàng' | escape }}</a>
					{%- comment -%} 2026-10-16: cá nhân hoá theo kết quả soi da / khảo sát (localStorage + GAS) — xem snippets/cart_skin_plan.bwt. {%- endcomment -%}
					{%- if settings.cart_skin_enable -%}
					{%- include 'customer_context_extractor' -%}
					{%- include 'pc_result_store' -%}
					<script src="{{ 'crm-intake.js' | asset_url }}" defer></script>
					{%- include 'cart_skin_plan' -%}
					{%- endif -%}
					{%if settings.cart_suggest_product_enable%}
					{% if collections[settings.cart_suggest_product_col].products_count > 0 %}
					{% assign sudes_product_suggest = settings.cart_suggest_product_col %}
					{% else %}
					{% assign sudes_product_suggest = 'all' %}
					{% endif %}
					<div class="bg-shadow margin-bottom-20">
						<div class="product-suggest product-swipers">
							<div class="section-title a-left txt-uppercese">
								<h2>
									<a href="/collections/{{ sudes_product_suggest }}" title="{{settings.cart_suggest_product_title | strip_html}}">{{settings.cart_suggest_product_title}}</a>
								</h2>
							</div>
							{% assign count = collections[sudes_product_suggest].products_count %}
							{% if count > 0 %}
							<div class="swiper_suggest swiper-container">
								<div class="swiper-wrapper">
									{% for product in collections[sudes_product_suggest].products limit: settings.cart_suggest_product_limit %}
									<div class="swiper-slide">
										<div class="item_product_main">
											{%include 'product_grid_office'%}
										</div>
									</div>
									{% endfor %}
								</div>
								<div class="swiper-button-prev">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L18.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
								<div class="swiper-button-next">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
							</div>
							{%else%}
							<div class="alert alert-warning alert-dismissible show margin-bottom-0" role="alert">
								<span>Danh mục đang cập nhật sản phẩm.</span>
							</div>
							{%endif%}
						</div>
					</div>
					<script>
						var swiper_suggest = null;
						function initSwiperSuggest() {
							swiper_suggest = new Swiper('.swiper_suggest', {
								slidesPerView: 4,
								spaceBetween: 20,
								slidesPerGroup: 1,
								navigation: {
									nextEl: '.swiper_suggest .swiper-button-next',
									prevEl: '.swiper_suggest .swiper-button-prev',
								},
								breakpoints: {
									768: {
										slidesPerView: 3,
										spaceBetween: 20
									},
									992: {
										slidesPerView: 3,
										spaceBetween: 20
									},
									1024: {
										slidesPerView: 2.5,
										spaceBetween: 20
									},
									1200: {
										slidesPerView: 3,
										spaceBetween: 20
									}
								}
							});
						}
						function destroySwiperSuggest() {
							if (swiper_suggest) {
								swiper_suggest.destroy(true, true);
								swiper_suggest = null;
							}
						}
						function toggleSwiperSuggest() {
							if ($(window).width() <= 767 && swiper_suggest) {
								destroySwiperSuggest();
							} else if ($(window).width() > 767 && !swiper_suggest) {
								initSwiperSuggest();
							}
						}
						toggleSwiperSuggest();
						$(window).resize(toggleSwiperSuggest);
					</script>
					{%endif%}
				</div>
				<div class="col-xl-4 col-lg-5 col-12 col-cart-right">
					<div class="sticky">
						<div class="bg-shadow margin-bottom-20">
							<div class="ajaxcart__footer">
								{%- comment -%} 2026-10-16: khung đơn hàng dựng lại theo thiết kế giỏ hàng — Tạm tính · Phí vận chuyển · Mã giảm giá · Tổng thanh toán · Đặt hàng ngay · 4 ô cam kết. {%- endcomment -%}
								<h2 class="checkout-header"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> {{ settings.cart_summary_title | default: 'Thông tin đơn hàng' | escape }}</h2>
								<div class="checkout-body">
									<div class="summary-total">
										{%- include 'cart_initial_ssr', target: 'footer' -%}
									</div>
									{%- comment -%} Phí vận chuyển: phí thật do checkout Sapo tính; ở giỏ chỉ báo "Miễn phí" khi đạt mức settings.free_shipping_price
									(thay thanh tiến độ freeship cũ), chưa đạt thì báo số tiền còn thiếu; tắt freeship ⇒ "tính ở bước thanh toán". {%- endcomment -%}
									{%- assign _ship_min = settings.free_shipping_price | default: 0 | plus: 0 -%}
									<div class="cart-shipping-row" data-cart-shipping data-enabled="{% if settings.free_shipping_enable and _ship_min > 0 %}1{% else %}0{% endif %}" data-min="{{ _ship_min }}" data-free="{{ settings.cart_shipping_free | default: 'Miễn phí' | escape }}" data-more="{{ settings.cart_shipping_more | default: 'Mua thêm {so_tien} để được miễn phí' | escape }}" data-pending="{{ settings.cart_shipping_pending | default: 'Tính ở bước thanh toán' | escape }}">
										<span class="cart-shipping-row__label">{{ settings.cart_shipping_label | default: 'Phí vận chuyển' | escape }}</span>
										<span class="cart-shipping-row__value" data-cart-shipping-value>
											{%- if settings.free_shipping_enable and _ship_min > 0 -%}
												{%- if cart.total_price >= _ship_min -%}<i class="fa-solid fa-truck-fast" aria-hidden="true"></i> {{ settings.cart_shipping_free | default: 'Miễn phí' }}
												{%- else -%}{%- assign _ship_left = _ship_min | minus: cart.total_price | money -%}{{ settings.cart_shipping_more | default: 'Mua thêm {so_tien} để được miễn phí' | replace: '{so_tien}', _ship_left }}{%- endif -%}
											{%- else -%}{{ settings.cart_shipping_pending | default: 'Tính ở bước thanh toán' }}{%- endif -%}
										</span>
									</div>
									{%if settings.delivery_show or settings.use_cart_vat%}
									<div class="summary-vat">

										<form method="post" action="/cart" novalidate="" class="formVAT">
											{%if settings.delivery_show %}
											<h4>
												{{settings.delivery_heading}}
											</h4>
											<div class="timedeli-modal">
												<fieldset class="input_group date_pick">
													<input type="text" placeholder="Chọn ngày" readonly id="date" name="attributes[shipdate]" class="date_picker" required>
												</fieldset>
												<fieldset class="input_group date_time">
													<select name="time" class="timeer timedeli-cta" >
														<option value="" selected>{{settings.delivery_time_default | default: 'Chọn khung giờ'}}</option>
														{%assign options = settings.delivery_time | split: ';'%}
														{%for opt in options%}
														{%- assign _opt = opt | strip -%}{%- if _opt != blank -%}<option value="{{_opt}}">{{_opt}}</option>{%- endif -%}
														{%endfor%}
													</select>
												</fieldset>
											</div>
											{% endif %}
											{% if settings.use_cart_vat %}
											<div class="r-bill">
												<div class="checkbox">
													<input type="hidden" name="attributes[invoice]" id="re-checkbox-bill"
														   value='không'>
													<input type="checkbox" id="checkbox-bill" name="attributes[invoice]" value="có"  {% if cart.attributes["invoice"] == "có" %} checked{% endif %}
														   class="regular-checkbox" />
													<label for="checkbox-bill" class="box"></label>
													<label for="checkbox-bill" class="title">Xuất hóa đơn công ty</label>
												</div>
												<p class="text-[11px] text-gray-500 mt-1.5 mb-2 leading-relaxed">
													Thông tin công ty/mã số thuế chỉ dùng để xuất hoá đơn VAT theo quy định, không dùng cho mục đích khác.
													Xem <a href="/chinh-sach-bao-mat" class="text-clinical-700 underline hover:text-clinical-600">Chính sách bảo mật</a>.
												</p>
												<div class="bill-field">
													<div class="form-group">
														<label>Tên công ty</label>
														<input type="text" class="form-control val-f" 
															   name="attributes[company_name]" 
															   value="{{ cart.attributes["company_name"] }}"
															   placeholder="Tên công ty" >
													</div>	
													<div class="form-group">
														<label>Mã số thuế</label>
														<input type="text" pattern=".{10,}" onkeypress="if ( isNaN(this.value + String.fromCharCode(event.keyCode) )) return false;" class="form-control val-f val-n" name="attributes[tax_code]"   value="{{ cart.attributes["tax_code"] }}"  placeholder="Mã số thuế">
													</div>
													<div class="form-group">
														<label>Địa chỉ công ty</label>
														<textarea class="form-control val-f" 
																  name="attributes[company_address]"
																  placeholder="Nhập địa chỉ công ty (bao gồm Phường/Xã, Quận/Huyện, Tỉnh/Thành phố nếu có)">{{ cart.attributes["company_address"] }}</textarea>
													</div>
													<div class="form-group">
														<label>Email nhận hoá đơn</label>
														<input type="email" class="form-control val-f val-email" 
															   name="attributes[invoice_email]" 
															   value="{{ cart.attributes["invoice_email"] }}" 
															   placeholder="Email nhận hoá đơn">
													</div>
												</div>
											</div>
											{% endif %}
										</form>
									</div>
									{%endif%}
									{%- if settings.use_cart_coupons -%}
									<div class="summary-coupon">
										<label class="coupon-label" for="coupon-code-input"><i class="fa-solid fa-ticket" aria-hidden="true"></i> {{ settings.cart_coupon_label | default: 'Mã giảm giá' | escape }}</label>
										<div class="coupon-input-wrap">
											<input type="text" class="coupon-code-input" id="coupon-code-input" placeholder="{{ settings.cart_coupon_placeholder | default: 'Nhập mã giảm giá' | escape }}" autocomplete="off">
											<button type="button" class="coupon-apply-btn js-apply-coupon">{{ settings.cart_coupon_apply_label | default: 'Áp dụng' | escape }}</button>
										</div>
										<p class="coupon-feedback"></p>
										{%- comment -%} 2026-10-16: mã voucher đang bật (Cài đặt › Mã giảm giá, promo_coupon_N_*) — bấm để điền vào ô, mô tả ưu đãi hiện bên dưới. {%- endcomment -%}
										{%- capture _cp_chips -%}
										{%- for i in (1..6) -%}
										{%- capture _cp_en -%}promo_coupon_{{ i }}_enable{%- endcapture -%}
										{%- capture _cp_code -%}promo_coupon_{{ i }}_code{%- endcapture -%}
										{%- capture _cp_value -%}promo_coupon_{{ i }}_value{%- endcapture -%}
										{%- if settings[_cp_en] and settings[_cp_code] != blank -%}
										<button type="button" class="coupon-chip js-coupon-chip" data-code="{{ settings[_cp_code] | strip | escape }}" data-desc="{{ settings[_cp_value] | strip_html | strip | escape }}">{{ settings[_cp_code] | strip }}</button>
										{%- endif -%}
										{%- endfor -%}
										{%- endcapture -%}
										{%- if _cp_chips != blank -%}
										<div class="coupon-chips">
											<span class="coupon-chips__label">{{ settings.cart_coupon_list_label | default: 'Mã đang có' | escape }}:</span>
											{{ _cp_chips }}
										</div>
										{%- endif -%}
									</div>
									{%- endif -%}
									{%- comment -%} Tổng thanh toán = cart.total_price (đã trừ khuyến mãi tự động của Sapo); JS cập nhật theo 'ajaxCart'. {%- endcomment -%}
									<div class="cart-total-row">
										<span class="cart-total-row__label">{{ settings.cart_total_label | default: 'Tổng thanh toán' | escape }}</span>
										<span class="cart-total-row__value" data-cart-total>{{ cart.total_price | money }}</span>
									</div>
									<div class="summary-button">
										<div class="cart__btn-proceed-checkout-dt">
											{%- assign _checkout_label = settings.cart_checkout_label | default: 'Đặt hàng ngay' -%}
											<button onclick="cartGoToCheckout(event)" type="button" class="button btn btn-default cart__btn-proceed-checkout btn-primary duration-300" id="btn-proceed-checkout" title="{{ _checkout_label | escape }}"><i class="fa-solid fa-lock" aria-hidden="true"></i> <span>{{ _checkout_label | escape }}</span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
										</div>
									{%- if settings.cart_trust_enable and settings.cart_trust_text != blank -%}
									{%- assign _trust_items = settings.cart_trust_text | split: ';' -%}
									{%- assign _trust_icons = settings.cart_trust_icons | default: 'fa-hand-holding-dollar;fa-rotate;fa-circle-check;fa-headset' | split: ';' -%}
									<div class="cart-trust-grid">
										{%- for _trust in _trust_items limit: 4 -%}
										<div class="cart-trust-item">
											<i class="fas {{ _trust_icons[forloop.index0] | strip | default: 'fa-circle-check' }}" aria-hidden="true"></i>
											<span>{{ _trust | strip }}</span>
										</div>
										{%- endfor -%}
									</div>
									{%- endif -%}
									</div>
								</div>
							</div>
						</div>
						{%- comment -%} 2026-10-16: bỏ include 'coupon_products' ở giỏ — trang giỏ không có JS mở popup/sao chép của khối đó (bấm không có tác dụng). Mã voucher hiện thành nút trong ô "Mã giảm giá" ở trên. {%- endcomment -%}
					</div>
					{%if settings.cart_suggest_product_enable%}
					{% if collections[settings.cart_suggest_product_col].products_count > 0 %}
					{% assign sudes_product_suggest = settings.cart_suggest_product_col %}
					{% else %}
					{% assign sudes_product_suggest = 'all' %}
					{% endif %}
					<div class="bg-shadow margin-bottom-20">
						<div class="product-suggest-mob product-swipers">
							<div class="section-title a-left txt-uppercese">
								<h2>
									<a href="/collections/{{ sudes_product_suggest }}" title="{{settings.cart_suggest_product_title | strip_html}}">{{settings.cart_suggest_product_title}}</a>
								</h2>
							</div>
							{% assign count = collections[sudes_product_suggest].products_count %}
							{% if count > 0 %}
							<div class="swiper_suggest_mob swiper-container">
								<div class="swiper-wrapper">
									{% for product in collections[sudes_product_suggest].products limit: settings.cart_suggest_product_limit %}
									<div class="swiper-slide">
										<div class="item_product_main">
											{%include 'product_grid_office'%}
										</div>
									</div>
									{% endfor %}
								</div>
								<div class="swiper-button-prev">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L18.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
								<div class="swiper-button-next">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
							</div>
							{%else%}
							<div class="alert alert-warning alert-dismissible show margin-bottom-0" role="alert">
								<span>Danh mục đang cập nhật sản phẩm.</span>
							</div>
							{%endif%}
						</div>
					</div>
					<script>
						var swiper_suggest_mob = null;
						var _mobSwiperTimer = null;
						function initSwiperSuggestmob() {
							if (swiper_suggest_mob) return;
							swiper_suggest_mob = new Swiper('.swiper_suggest_mob', {
								slidesPerView: 1.5,
								spaceBetween: 12,
								slidesPerGroup: 1,
								navigation: {
									nextEl: '.swiper_suggest_mob .swiper-button-next',
									prevEl: '.swiper_suggest_mob .swiper-button-prev',
								},
								breakpoints: {
									480: { slidesPerView: 2,   spaceBetween: 12 },
									768: { slidesPerView: 3,   spaceBetween: 14 },
									992: { slidesPerView: 2,   spaceBetween: 14 },
									1200:{ slidesPerView: 1.5, spaceBetween: 12 }
								}
							});
						}
						function destroySwiperSuggestmob() {
							if (swiper_suggest_mob) {
								swiper_suggest_mob.destroy(true, true);
								swiper_suggest_mob = null;
							}
						}
						initSwiperSuggestmob();
						$(window).on('resize.mobSuggest', function() {
							clearTimeout(_mobSwiperTimer);
							_mobSwiperTimer = setTimeout(function() {
								destroySwiperSuggestmob();
								initSwiperSuggestmob();
							}, 200);
						});
					</script>
					{%endif%}
				</div>
			</div>
		</div>
	</div>
</section>
{%- comment -%} 2026-10-15: script giỏ hàng trước đây nằm trong điều kiện settings.cart_suggest_product_enable ⇒ tắt khối gợi ý là nút Đặt hàng ngay (cartGoToCheckout) không còn tác dụng. Đưa ra ngoài mọi điều kiện. {%- endcomment -%}
<script>
(function($) {

	/* 2026-10-15: bỏ JS "chọn sản phẩm để tính tổng" — ô chọn đã bị ẩn (page_cart.scss: checkout Sapo luôn
	   lấy TOÀN BỘ giỏ) nhưng JS vẫn đổi số Tạm tính, còn bản mobile lại hiện ô chọn không có tác dụng. */
	function proceedCheckout(e) {
		{%- if settings.delivery_show or settings.use_cart_vat -%}
		if (typeof goToCheckout === 'function') { goToCheckout(e || { preventDefault: function(){} }); return; }
		{%- endif -%}
		window.location.href = window.cartCheckoutUrl || '/checkout';
	}

	/* 2026-10-16 (thiết kế giỏ hàng): số SP dưới tiêu đề, Phí vận chuyển, Tổng thanh toán nằm ngoài FooterCartTemplate
	   ⇒ cập nhật theo sự kiện 'ajaxCart' (buildCart bắn kèm object giỏ sau mỗi lần thêm/xoá/đổi số lượng). */
	function cartMoney(v) {
		return (window.Bizweb && Bizweb.formatMoney) ? Bizweb.formatMoney(v, Bizweb.money_format) : String(v);
	}
	$(document).on('ajaxCart', function(e, cart) {
		if (!cart || cart.total_price == null) return;
		var $count = $('[data-cart-count]');
		$count.text(String($count.data('template') || '').replace('{so}', cart.item_count));
		$('[data-cart-total]').text(cartMoney(cart.total_price));
		var $ship = $('[data-cart-shipping]');
		var $val = $ship.find('[data-cart-shipping-value]');
		if (String($ship.data('enabled')) !== '1') { $val.text($ship.data('pending')); return; }
		var min = Number($ship.data('min')) || 0;
		if (cart.total_price >= min) {
			$val.empty().append('<i class="fa-solid fa-truck-fast" aria-hidden="true"></i> ').append(document.createTextNode($ship.data('free')));
		} else {
			$val.text(String($ship.data('more')).replace('{so_tien}', cartMoney(min - cart.total_price)));
		}
	});

	/* ── Đặt hàng: toàn bộ giỏ hàng ── */
	window.cartGoToCheckout = function(e) {
		if (e && e.preventDefault) e.preventDefault();
		proceedCheckout(e);
	};

	/* Mã giảm giá: được áp ở trang checkout ⇒ đi qua cùng luồng đặt hàng (ngày giao, VAT) thay vì nhảy thẳng sang /checkout bỏ qua các bước đó như trước. */
	$(document).on('click', '.js-apply-coupon', function(e) {
		var code = $('#coupon-code-input').val().trim();
		var $feedback = $('.coupon-feedback');
		if (!code) {
			$feedback.removeClass('coupon-feedback--success').addClass('coupon-feedback--error').text('Vui lòng nhập mã giảm giá.');
			return;
		}
		$feedback.removeClass('coupon-feedback--error').addClass('coupon-feedback--success').text('Mã sẽ được áp dụng ở bước thanh toán.');
		window.cartCheckoutUrl = '/checkout?discount=' + encodeURIComponent(code);
		window.cartGoToCheckout(e);
	});
	$(document).on('click', '.js-coupon-chip', function() {
		var $chip = $(this);
		$('.js-coupon-chip').removeClass('is-active');
		$chip.addClass('is-active');
		$('#coupon-code-input').val($chip.data('code')).trigger('focus');
		$('.coupon-feedback').removeClass('coupon-feedback--error').addClass('coupon-feedback--success').text($chip.data('desc') || '');
	});
	$(document).on('keydown', '#coupon-code-input', function(e) {
		if (e.key === 'Enter') { e.preventDefault(); $('.js-apply-coupon').trigger('click'); }
	});

})(jQuery);
</script>
{% if settings.use_cart_vat or settings.delivery_show%}
<script src='{{"sweetalert-min.js" | asset_url}}'></script>
<link rel="preload" as="script" href="{{ 'bootstrap-datepicker.js' | asset_url}}" />
{{ 'bootstrap-datepicker.js' | asset_url | script_tag }}
<script>
	$(document).ready(function(){
		var today    = new Date();
		var tomorrow = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);

		$('.input_group #date').datepicker({
			format: "dd/mm/yyyy",
			orientation: "top right",
			todayHighlight: true,
			startDate: tomorrow
		});

		{%- if settings.delivery_show -%}
		/* Validate delivery date ≥ tomorrow before proceeding to checkout */
		var _baseCheckout = window.cartGoToCheckout;
		window.cartGoToCheckout = function(e) {
			if (e) e.preventDefault();
			var dateVal = $('#date').val().trim();
			if (!dateVal) {
				swal('Vui lòng chọn ngày giao hàng', '', 'warning');
				return;
			}
			var parts = dateVal.split('/');
			if (parts.length === 3) {
				var sel = new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
				if (sel < tomorrow) {
					swal('Ngày giao hàng phải từ ngày mai trở đi', '', 'warning');
					return;
				}
			}
			if (typeof _baseCheckout === 'function') _baseCheckout(e);
		};
		{%- endif -%}
	})
</script>
{%include 'vat-cart'%}
{%endif%}
{% if cart.item_count > 0 %}{% for item in cart.items %}<div class="product-id-in-cart hidden">{{item.product.id}}</div>{% endfor %}{% endif %}{% include 'product-recommend' %}
