{%- comment -%}
  templates/page.ui-kit.bwt (14/11/2026 — chủ dự án: "tạo thêm 1 trang tuỳ chỉnh cho tôi check").
  TRANG KIỂM TRA TUỲ CHỈNH: hiện toàn bộ màu của Cấu hình theme › Màu sắc và các thành phần dựng từ màu đó
  (nút, thẻ sản phẩm, thẻ flash sale, cỡ chữ). Đổi màu trong admin ⇒ tải lại trang này để xem kết quả.
  Trên Sapo: tạo Trang nội dung alias ui-kit, chọn giao diện page.ui-kit (không gắn vào menu).
  QUY ƯỚC: trang này 100% class Tailwind (assets/pc-ui.css) — KHÔNG class CSS tự đặt, KHÔNG style="", KHÔNG <style>.
  Dữ liệu lấy từ object Sapo (page.title, collections.all.products) — không nhập tay trong cấu hình.
{%- endcomment -%}
<main class="bg-surface-page font-sans text-ink">
  <div class="mx-auto box-border w-full max-w-content px-4 py-8 lg:px-6 lg:py-12">
    <header class="mb-8 border-0 border-b border-solid border-line pb-6">
      <p class="m-0 text-xs font-bold uppercase tracking-wider text-primary">Cấu hình theme › Màu sắc</p>
      <h1 class="m-0 mt-2 text-2xl font-bold text-ink lg:text-4xl">{{ page.title | default: 'Kiểm tra tuỳ chỉnh giao diện' | escape }}</h1>
      <p class="m-0 mt-2 max-w-3xl text-sm text-ink-secondary lg:text-base">Mỗi ô dưới đây dùng đúng một class Tailwind. Đổi màu ở Cấu hình theme rồi tải lại trang: ô nào không đổi theo nghĩa là khối đó chưa chuyển sang class.</p>
    </header>

    <section class="mb-10" aria-labelledby="kit-brand">
      <h2 id="kit-brand" class="m-0 mb-4 text-xl font-bold text-ink">1. Thương hiệu</h2>
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 lg:grid-cols-6">
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-primary"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-primary</strong>Màu chính</span></li>
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-primary-hover"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-primary-hover</strong>Màu chính đậm</span></li>
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-primary-darkest"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-primary-darkest</strong>Tối nhất</span></li>
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-primary-accent"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-primary-accent</strong>Nhấn trang trí</span></li>
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-primary-tint"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-primary-tint</strong>Nền nhạt</span></li>
        <li class="overflow-hidden border border-solid border-line bg-white rounded-xl"><span class="block h-16 bg-secondary"></span><span class="block p-3 text-xs"><strong class="block text-sm text-ink">bg-secondary</strong>Màu phụ</span></li>
      </ul>
    </section>

    <section class="mb-10" aria-labelledby="kit-text">
      <h2 id="kit-text" class="m-0 mb-4 text-xl font-bold text-ink">2. Chữ, giá, khuyến mãi</h2>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4">
        <p class="m-0 border border-solid border-line bg-white p-4 text-base font-semibold text-ink rounded-xl">text-ink — Chữ chính</p>
        <p class="m-0 border border-solid border-line bg-white p-4 text-base text-ink-secondary rounded-xl">text-ink-secondary — Chữ phụ</p>
        <p class="m-0 border border-solid border-line bg-white p-4 text-base font-bold text-price rounded-xl">text-price — 850.000₫</p>
        <p class="m-0 border border-solid border-line bg-white p-4 text-base font-bold text-sale rounded-xl">text-sale — Giảm 29%</p>
      </div>
      <div class="mt-4 border border-solid border-line bg-white p-4 rounded-xl">
        <p class="m-0 text-xs text-ink-secondary">text-xs · 12px — chú thích nhỏ nhất</p>
        <p class="m-0 mt-1 text-sm text-ink">text-sm · 14px — chữ thân trên mobile</p>
        <p class="m-0 mt-1 text-base text-ink">text-base · 16px — chữ thân</p>
        <p class="m-0 mt-1 text-lg font-semibold text-ink">text-lg · 18px</p>
        <p class="m-0 mt-1 text-xl font-semibold text-ink">text-xl · 20px</p>
        <p class="m-0 mt-1 text-2xl font-bold text-ink">text-2xl · 24px</p>
        <p class="m-0 mt-1 text-3xl font-bold text-ink">text-3xl · 30px</p>
      </div>
    </section>

    <section class="mb-10" aria-labelledby="kit-btn">
      <h2 id="kit-btn" class="m-0 mb-4 text-xl font-bold text-ink">3. Nút bấm</h2>
      <div class="flex flex-wrap items-center gap-3 border border-solid border-line bg-white p-4 rounded-xl">
        <button type="button" class="inline-flex min-h-11 cursor-pointer items-center justify-center border-0 bg-btn px-5 text-sm font-semibold text-btn-text rounded-full hover:bg-btn-hover">Nút chính (bg-btn)</button>
        <button type="button" class="inline-flex min-h-11 cursor-pointer items-center justify-center border-2 border-solid border-primary bg-transparent px-5 text-sm font-semibold text-primary rounded-full hover:bg-primary-tint">Nút phụ (border-primary)</button>
        <button type="button" class="inline-flex min-h-12 cursor-pointer items-center justify-center border-0 bg-btn px-6 text-base font-semibold text-btn-text rounded-full hover:bg-btn-hover">Nút lớn</button>
        <button type="button" class="inline-flex min-h-11 cursor-not-allowed items-center justify-center border border-solid border-line bg-surface-soft px-5 text-sm font-semibold text-ink-secondary rounded-full" disabled>Hết hàng</button>
        <a href="#kit-card" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4 hover:no-underline">Nút dạng link</a>
      </div>
    </section>

    {%- assign kit_products = collections.all.products -%}
    <section class="mb-10" aria-labelledby="kit-card">
      <h2 id="kit-card" class="m-0 mb-1 text-xl font-bold text-ink">4. Thẻ sản phẩm</h2>
      <p class="m-0 mb-4 text-sm text-ink-secondary">Dữ liệu thật từ object <code>product</code> (tên, hãng, giá, ảnh) — không nhập tay. Class: bg-card, border-card-line, bg-card-btn, text-card-btn-text.</p>
      {%- if kit_products.size > 0 -%}
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-4 lg:gap-4">
        {%- for product in kit_products limit: 4 -%}
        {%- assign kit_var = product.selected_or_first_available_variant | default: product.variants.first -%}
        <li class="flex min-w-0 flex-col overflow-hidden border border-solid border-card-line bg-card rounded-2xl">
          <a href="{{ product.url }}" class="relative block aspect-square w-full overflow-hidden bg-slate-100" tabindex="-1" aria-hidden="true">
            <img class="block h-full w-full object-cover" src="{% if product.featured_image.src != blank %}{{ product.featured_image.src | img_url: 'medium' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ product.featured_image.alt | default: product.name | escape }}" width="240" height="240" loading="lazy">
            {%- if kit_var.compare_at_price > kit_var.price and kit_var.price > 0 -%}
            <span class="absolute left-2 top-2 bg-sale px-2 py-1 text-xs font-bold text-white rounded-full">-{{ kit_var.compare_at_price | minus: kit_var.price | times: 100 | divided_by: kit_var.compare_at_price | round }}%</span>
            {%- endif -%}
          </a>
          <div class="flex min-w-0 flex-1 flex-col gap-1 p-3">
            <p class="notranslate m-0 truncate text-xs font-medium uppercase text-ink-secondary" translate="no">{{ product.vendor | escape }}</p>
            <h3 class="notranslate m-0 line-clamp-2 text-sm font-semibold text-ink" translate="no"><a class="text-ink no-underline hover:text-primary" href="{{ product.url }}">{{ product.name }}</a></h3>
            <p class="m-0 mt-auto flex flex-wrap items-baseline gap-x-2 pt-2">
              <span class="text-base font-bold text-price">{{ kit_var.price | money }}</span>
              {%- if kit_var.compare_at_price > kit_var.price -%}<s class="text-xs text-ink-secondary">{{ kit_var.compare_at_price | money }}</s>{%- endif -%}
            </p>
            <a href="{{ product.url }}" class="mt-2 inline-flex min-h-11 items-center justify-center bg-card-btn px-3 text-sm font-semibold text-card-btn-text no-underline rounded-full hover:bg-btn-hover">Xem chi tiết</a>
          </div>
        </li>
        {%- endfor -%}
      </ul>
      {%- else -%}
      <p class="m-0 border border-solid border-line bg-white p-4 text-sm text-ink-secondary rounded-xl">Cửa hàng chưa có sản phẩm để xem thử.</p>
      {%- endif -%}
    </section>

    <section class="mb-10" aria-labelledby="kit-flash">
      <h2 id="kit-flash" class="m-0 mb-1 text-xl font-bold text-ink">5. Thẻ Flash sale</h2>
      <p class="m-0 mb-4 text-sm text-ink-secondary">Class: bg-flash, text-flash-text, bg-flash-badge, text-flash-badge-text.</p>
      {%- if kit_products.size > 0 -%}
      <div class="bg-flash p-3 rounded-2xl lg:p-4">
        <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-4 lg:gap-4">
          {%- for product in kit_products limit: 4 -%}
          {%- assign kit_var = product.selected_or_first_available_variant | default: product.variants.first -%}
          <li class="flex min-w-0 flex-col overflow-hidden bg-card rounded-xl">
            <a href="{{ product.url }}" class="relative block aspect-square w-full overflow-hidden bg-slate-100" tabindex="-1" aria-hidden="true">
              <img class="block h-full w-full object-cover" src="{% if product.featured_image.src != blank %}{{ product.featured_image.src | img_url: 'medium' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ product.featured_image.alt | default: product.name | escape }}" width="240" height="240" loading="lazy">
              {%- if kit_var.compare_at_price > kit_var.price and kit_var.price > 0 -%}
              <span class="absolute left-2 top-2 bg-flash-badge px-2 py-1 text-xs font-bold text-flash-badge-text rounded-full">-{{ kit_var.compare_at_price | minus: kit_var.price | times: 100 | divided_by: kit_var.compare_at_price | round }}%</span>
              {%- endif -%}
            </a>
            <div class="flex min-w-0 flex-1 flex-col gap-1 p-3">
              <h3 class="notranslate m-0 line-clamp-2 text-sm font-semibold text-ink" translate="no"><a class="text-ink no-underline" href="{{ product.url }}">{{ product.name }}</a></h3>
              <p class="m-0 mt-auto flex flex-wrap items-baseline gap-x-2 pt-2">
                <span class="text-base font-bold text-flash-text">{{ kit_var.price | money }}</span>
                {%- if kit_var.compare_at_price > kit_var.price -%}<s class="text-xs text-ink-secondary">{{ kit_var.compare_at_price | money }}</s>{%- endif -%}
              </p>
            </div>
          </li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
    </section>

    <section aria-labelledby="kit-surface">
      <h2 id="kit-surface" class="m-0 mb-4 text-xl font-bold text-ink">6. Nền &amp; viền</h2>
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-4">
        <li class="border border-solid border-line bg-surface-page p-4 text-sm text-ink rounded-xl">bg-surface-page</li>
        <li class="border border-solid border-line bg-surface-card p-4 text-sm text-ink rounded-xl">bg-surface-card</li>
        <li class="border border-solid border-line-soft bg-surface-soft p-4 text-sm text-ink rounded-xl">bg-surface-soft</li>
        <li class="bg-surface-footer p-4 text-sm text-white rounded-xl">bg-surface-footer</li>
      </ul>
    </section>
  </div>
</main>
