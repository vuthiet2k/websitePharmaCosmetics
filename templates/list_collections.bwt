{%- comment -%}
  list_collections.bwt — trang liệt kê toàn bộ danh mục (route /collections không kèm
  handle). Đối tượng `collections` là hash alias → collection (giống `linklists`), nên
  duyệt bằng {% for c in collections %} sẽ trả cặp [alias, collection] — dùng c[1] để
  lấy object thật, không phải {% for collection in collections %} như collection.bwt.
{%- endcomment -%}
{% paginate collections by 24 %}
<div class="layout-collection pc-list-collections">
	{% include 'breadcrumb' %}
	<div class="container">
		<div class="col-title d-none">
			<h1>{{ settings.list_collections_title | default: 'Tất cả danh mục' }}</h1>
		</div>

		{% assign _col_total = 0 %}
		{% for c in collections %}{% if c[1].id > 0 %}{% assign _col_total = _col_total | plus: 1 %}{% endif %}{% endfor %}

		{% if _col_total > 0 %}
		<div class="pc-list-collections__grid">
			{% for c in collections %}
			{% assign col = c[1] %}
			{% if col.id > 0 %}
			<a class="pc-list-collections__item" href="{{ col.url }}" title="{{ col.name }}">
				<div class="pc-list-collections__thumb">
					{% if col.image != blank %}
					<img class="lazyload" width="400" height="400"
						src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC"
						data-src="{{ col.image | img_url: '400x400' }}" alt="{{ col.name }}">
					{% else %}
					<img class="lazyload" width="400" height="400" src="{{ 'no-image.jpg' | asset_url }}" alt="{{ col.name }}">
					{% endif %}
				</div>
				<div class="pc-list-collections__info">
					<h2 class="pc-list-collections__name">{{ col.name }}</h2>
					{% if col.products_count > 0 %}
					<span class="pc-list-collections__count">{{ col.products_count }} sản phẩm</span>
					{% endif %}
				</div>
			</a>
			{% endif %}
			{% endfor %}
		</div>
		{% else %}
		<div class="pc-list-collections__empty">
			<p>{{ settings.list_collections_empty | default: 'Chưa có danh mục nào.' }}</p>
		</div>
		{% endif %}
	</div>
</div>

<style>
.pc-list-collections .col-title h1 {
	font-family: var(--font-heading, var(--font-primary));
	font-size: var(--fs-h2, 28px);
	color: var(--mainColorDark, #166B55);
	margin: 24px 0;
}
.pc-list-collections__grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 16px;
	padding: 16px 0 40px;
}
.pc-list-collections__item {
	display: block;
	text-decoration: none;
	color: inherit;
	border: 1px solid var(--lineColor, #e5e5e5);
	border-radius: 8px;
	overflow: hidden;
	transition: box-shadow .2s, transform .2s;
}
.pc-list-collections__item:hover {
	box-shadow: 0 4px 16px rgba(0,0,0,.08);
	transform: translateY(-2px);
}
.pc-list-collections__thumb {
	aspect-ratio: 1 / 1;
	background: var(--mint-50, #f5f5f5);
	overflow: hidden;
}
.pc-list-collections__thumb img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}
.pc-list-collections__info {
	padding: 12px 14px;
}
.pc-list-collections__name {
	font-size: var(--fs-base, 15px);
	font-weight: 600;
	margin: 0 0 4px;
	color: var(--mainColorDark, #166B55);
}
.pc-list-collections__count {
	font-size: 13px;
	color: var(--text-muted, #888);
}
.pc-list-collections__empty {
	padding: 60px 0;
	text-align: center;
	color: var(--text-muted, #888);
}
@media (min-width: 768px) {
	.pc-list-collections__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 993px) {
	.pc-list-collections__grid { grid-template-columns: repeat(4, 1fr); gap: 24px; }
}
</style>
{% endpaginate %}
