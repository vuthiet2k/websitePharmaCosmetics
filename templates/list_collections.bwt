{%- comment -%}
  list_collections.bwt — trang liệt kê toàn bộ danh mục (route /collections không kèm
  handle). Đối tượng `collections` là hash alias → collection (giống `linklists`), nên
  duyệt bằng `for c in collections` sẽ trả cặp [alias, collection] — dùng c[1] để
  lấy object thật, không phải `for collection in collections` như collection.bwt.
{%- endcomment -%}
{% paginate collections by 24 %}
<div class="layout-collection">
	{% include 'breadcrumb' %}
	<div class="container py-4">
		<div class="my-6">
			<h1 class="text-2xl lg:text-3xl font-bold text-primary font-heading m-0">{{ settings.list_collections_title | default: 'Tất cả danh mục' }}</h1>
		</div>

		{% assign _col_total = 0 %}
		{% for c in collections %}{% if c[1].id > 0 %}{% assign _col_total = _col_total | plus: 1 %}{% endif %}{% endfor %}

		{% if _col_total > 0 %}
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6 pb-10">
			{% for c in collections %}
			{% assign col = c[1] %}
			{% if col.id > 0 %}
			<a class="group block no-underline text-inherit border border-solid border-line rounded-xl overflow-hidden bg-card transition-all duration-200 hover:shadow-md hover:-translate-y-0.5" href="{{ col.url }}" title="{{ col.name }}">
				<div class="aspect-square bg-slate-100 overflow-hidden">
					{% if col.image != blank %}
					<img class="lazyload w-full h-full object-cover block transition-transform duration-300 group-hover:scale-105" width="400" height="400"
						src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC"
						data-src="{{ col.image | img_url: 'large' }}" alt="{{ col.name }}">
					{% else %}
					<img class="lazyload w-full h-full object-cover block" width="400" height="400" src="{% include 'placeholder_img_url' %}" alt="{{ col.name }}">
					{% endif %}
				</div>
				<div class="p-3 sm:p-4">
					<h2 class="text-sm sm:text-base font-semibold m-0 mb-1 text-primary group-hover:text-primary-dark transition-colors line-clamp-1">{{ col.name }}</h2>
					{% if col.products_count > 0 %}
					<span class="text-xs sm:text-sm text-slate-500">{{ col.products_count }} sản phẩm</span>
					{% endif %}
				</div>
			</a>
			{% endif %}
			{% endfor %}
		</div>
		{% else %}
		<div class="py-16 text-center text-slate-500">
			<p>{{ settings.list_collections_empty | default: 'Chưa có danh mục nào.' }}</p>
		</div>
		{% endif %}
	</div>
</div>
{% endpaginate %}
