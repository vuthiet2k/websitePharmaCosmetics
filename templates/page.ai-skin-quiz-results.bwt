{%- comment -%}
  page.ai-skin-quiz-results.bwt (T-32) — Trang kết quả đầy đủ cho AI Skin Diagnostic Quiz,
  đối chiếu Pharma_Cosmetics_Figma_Project/ai-results.html. Quiz (page.ai-skin-quiz.bwt) chạy
  hoàn toàn client-side, không có backend lưu phiên làm bài — nên trang này nhận kết quả qua
  sessionStorage theo tab (key 'pc_quiz_skin_type', ghi bởi finishQuiz() trong page.ai-skin-quiz.bwt) thay vì
  qua Liquid/query param. Nếu truy cập trực tiếp (chưa làm quiz), hiển thị bản DEMO minh hoạ với
  cảnh báo rõ ràng đây là ví dụ, không phải kết quả thật — không tự nhận là dữ liệu đã đo thật
  (không bịa số đo lâm sàng chính xác kiểu "62/100", "TEWL 35%" như bản Figma tĩnh — sai lệch
  đó có thể gây hiểu nhầm y khoa, xem POLICY.yaml#pii_form_gate + Luật 91/2025/QH15).
{%- endcomment -%}
{{ 'page_ai_skin_quiz.scss.css' | asset_url | stylesheet_tag }}
{% include 'breadcrumb' %}
{% include 'customer_context_extractor' %}
<script src="{{ 'crm-intake.js' | asset_url }}" defer></script>

<section class="py-6 sm:py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">

    <div class="bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm rounded-xl p-4 flex items-start gap-3">
      <i class="fas fa-triangle-exclamation text-amber-500 mt-0.5"></i>
      <div>
        <strong>{{ settings.ai_skin_scan_disclaimer_title | default: 'Lưu ý về kết quả' | escape }}:</strong>
        {{ settings.ai_skin_scan_disclaimer | default: 'Kết quả là gợi ý tự động để tham khảo, không phải chẩn đoán y khoa và không thay thế đánh giá trực tiếp từ chuyên gia phù hợp. Nếu có lo ngại về da, hãy trao đổi với chuyên gia y tế.' | escape }}
      </div>
    </div>

    <div id="pcQuizResultsRoot" data-demo="true">
      <!-- Được JS điền động bên dưới (đọc sessionStorage 'pc_quiz_skin_type') -->
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200">
        <div class="flex items-center gap-3 mb-4">
          <span class="pc-kit-badge-clinical text-xs font-semibold" data-result-demo-flag hidden>Bản xem trước minh hoạ</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-forest-900 font-heading mb-2">
          Hồ Sơ Da Của Bạn: <span data-result-title>—</span>
        </h1>
        <p class="text-sm text-gray-600" data-result-summary>Đang tải kết quả…</p>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 mt-6 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <div>
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">HOẠT CHẤT ĐƯỢC ĐỀ XUẤT</span>
            <h3 class="text-lg font-bold text-forest-900 font-heading">Định Hướng Phác Đồ Tham Khảo</h3>
          </div>
          <span class="pc-kit-badge-clinical text-xs font-semibold">{{ settings.skin_scan_recommendation_badge | default: 'Gợi ý tham khảo' | escape }}</span>
        </div>
        <div class="flex flex-wrap gap-2" data-result-recommend></div>
        <div class="flex flex-wrap gap-2" data-scan-products hidden aria-label="{{ settings.skin_scan_products_label | default: 'Sản phẩm liên quan' | escape }}"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3" data-scan-scores hidden></div>
        <figure class="pc-skin-radar" data-scan-radar hidden>
          <h3>{{ settings.skin_scan_radar_title | default: 'Biểu đồ 5 chỉ số soi da' | escape }}</h3>
          <svg viewBox="0 0 360 320" role="img" aria-labelledby="skinRadarSvgTitle" aria-describedby="skinRadarData">
            <title id="skinRadarSvgTitle">{{ settings.skin_scan_radar_title | default: 'Biểu đồ 5 chỉ số soi da' | escape }}</title>
            <g class="pc-skin-radar__grid" aria-hidden="true">
              <polygon points="180,139 200,153 192,176 168,176 160,153"></polygon>
              <polygon points="180,118 220,147 205,192 155,192 140,147"></polygon>
              <polygon points="180,97 240,140 218,208 142,208 120,140"></polygon>
              <polygon points="180,76 260,133 230,224 130,224 100,133"></polygon>
              <polygon points="180,55 280,127 242,245 118,245 80,127"></polygon>
              <path d="M180 160V55 M180 160L280 127 M180 160L242 245 M180 160L118 245 M180 160L80 127"></path>
            </g>
            <polygon class="pc-skin-radar__area" data-scan-radar-shape points="180,160 180,160 180,160 180,160 180,160"></polygon>
            <g class="pc-skin-radar__labels" aria-hidden="true">
              <text x="180" y="34" text-anchor="middle">{{ settings.skin_scan_score_acne | default: 'Mụn' | escape }}</text>
              <text x="300" y="121" text-anchor="start">{{ settings.skin_scan_score_pigmentation | default: 'Sắc tố' | escape }}</text>
              <text x="256" y="273" text-anchor="middle">{{ settings.skin_scan_score_wrinkles | default: 'Nếp nhăn' | escape }}</text>
              <text x="104" y="273" text-anchor="middle">{{ settings.skin_scan_score_redness | default: 'Độ đỏ' | escape }}</text>
              <text x="60" y="121" text-anchor="end">{{ settings.skin_scan_score_pores | default: 'Lỗ chân lông' | escape }}</text>
            </g>
          </svg>
          <figcaption>{{ settings.skin_scan_radar_description | default: 'Vùng tô đậm biểu thị raw_score chuẩn hóa (0–1); giá trị cao hơn nghĩa là chỉ số concern cao hơn, không phải điểm sức khỏe.' | escape }}</figcaption>
          <ul class="sr-only" id="skinRadarData" data-scan-radar-values></ul>
        </figure>
        <p class="text-sm text-gray-600" data-scan-age hidden></p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          <div class="p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200 space-y-2">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">GIAI ĐOẠN 1</span>
            <h4 class="text-sm font-bold text-gray-900">Làm Dịu &amp; Ổn Định</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Ưu tiên hoạt chất dịu nhẹ, ngưng các bước gây kích ứng, phục hồi ngưỡng chịu đựng của da.</p>
            <div class="flex flex-wrap gap-2" data-scan-stage-products="1" hidden></div>
          </div>
          <div class="p-5 rounded-2xl bg-teal-50/50 border border-teal-200 space-y-2">
            <span class="text-xs font-bold text-teal-800 uppercase tracking-wider">GIAI ĐOẠN 2</span>
            <h4 class="text-sm font-bold text-gray-900">Phục Hồi Hàng Rào Bảo Vệ Da</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Bổ sung dưỡng ẩm/ceramide theo nhóm hoạt chất đề xuất phía trên, tăng dần theo khả năng dung nạp.</p>
            <div class="flex flex-wrap gap-2" data-scan-stage-products="2" hidden></div>
          </div>
          <div class="p-5 rounded-2xl bg-cyan-50/50 border border-cyan-200 space-y-2">
            <span class="text-xs font-bold text-cyan-800 uppercase tracking-wider">GIAI ĐOẠN 3</span>
            <h4 class="text-sm font-bold text-gray-900">Điều Trị Chuyên Sâu Theo Mục Tiêu</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Tên sản phẩm/liều lượng cụ thể sẽ được chuyên gia chỉ định trực tiếp, phù hợp cơ địa của bạn.</p>
            <div class="flex flex-wrap gap-2" data-scan-stage-products="3" hidden></div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 mt-6 space-y-4">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Bước Tiếp Theo</h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <a class="flex-1 pc-kit-btn-primary py-3.5 text-center justify-center font-bold" data-result-search-link href="/search">
            <i class="fas fa-magnifying-glass"></i> Xem Sản Phẩm Phù Hợp
          </a>
          <a href="/pages/dat-lich-tu-van" class="pc-kit-btn-secondary py-3.5 text-center justify-center">
            <i class="fas fa-calendar-check"></i> Đặt Lịch Chuyên Gia Thăm Khám 1:1
          </a>
        </div>
        <button type="button" class="btn-result-crm" data-skin-save-result hidden>{{ settings.crm_consent_open_label | default: 'Lưu kết quả tư vấn' | escape }}</button>
        <a href="/pages/ai-skin-quiz" class="text-xs font-semibold text-emerald-700 hover:underline inline-block pt-2">&larr; Làm lại khảo sát</a>
      </div>
    </div>

  </div>
</section>

{% include 'skin_consent_modal' %}

<script>
(function () {
  var resultsData = {{ quiz_results | json }};
  var root = document.getElementById('pcQuizResultsRoot');
  if (!root) return;

  var skinType = null;
  var isDemo = true;
  var skinScan = null;
  try {
    skinType = sessionStorage.getItem('pc_quiz_skin_type');
    if (skinType) isDemo = false;
    skinScan = JSON.parse(sessionStorage.getItem('pc_skin_scan_result') || 'null');
  } catch (e) { /* Web Storage bị chặn — dùng bản demo */ }
  try {
    localStorage.removeItem('pc_quiz_skin_type');
    localStorage.removeItem('pc_quiz_scores');
  } catch (e) {}

  if (!skinType || !resultsData[skinType]) {
    // Chưa làm quiz (truy cập trực tiếp) → dùng 1 kết quả minh hoạ, đánh dấu rõ là DEMO.
    skinType = Object.keys(resultsData)[0];
    isDemo = true;
  }
  root.dataset.demo = String(isDemo);

  var result = resultsData[skinType];
  root.querySelector('[data-result-title]').textContent = result.skin_type;
  root.querySelector('[data-result-summary]').textContent = isDemo
    ? 'Đây là ví dụ minh hoạ giao diện kết quả — hãy làm bài khảo sát 17 câu hỏi để nhận gợi ý phù hợp với da của bạn.'
    : 'Dựa trên câu trả lời của bạn ở bài khảo sát 17 câu hỏi.';

  var demoFlag = root.querySelector('[data-result-demo-flag]');
  if (demoFlag) demoFlag.hidden = !isDemo;

  var rec = root.querySelector('[data-result-recommend]');
  (result.recommend || []).forEach(function (r) {
    var span = document.createElement('span');
    span.className = 'pc-kit-badge-gold';
    span.textContent = r;
    rec.appendChild(span);
  });

  var searchLink = root.querySelector('[data-result-search-link]');
  if (searchLink && result.recommend && result.recommend[0]) {
    searchLink.href = '/search?query=' + encodeURIComponent(result.recommend[0]);
  }

  if (skinScan && skinScan.scores) {
    isDemo = false;
    root.dataset.demo = 'false';
    root.querySelector('[data-result-title]').textContent = 'Báo cáo soi da tham khảo';
    root.querySelector('[data-result-summary]').textContent = 'Các chỉ số được xử lý cục bộ từ phiên soi da hiện tại. Ảnh khuôn mặt không được lưu trong báo cáo này.';
    if (demoFlag) demoFlag.hidden = true;
    var scoreList = root.querySelector('[data-scan-scores]');
    var names = {
      acne: {{ settings.skin_scan_score_acne | default: 'Mụn' | json }},
      pigmentation: {{ settings.skin_scan_score_pigmentation | default: 'Sắc tố' | json }},
      wrinkles: {{ settings.skin_scan_score_wrinkles | default: 'Nếp nhăn' | json }},
      redness: {{ settings.skin_scan_score_redness | default: 'Độ đỏ' | json }},
      pores: {{ settings.skin_scan_score_pores | default: 'Lỗ chân lông' | json }}
    };
    var radarKeys = ['acne', 'pigmentation', 'wrinkles', 'redness', 'pores'];
    var radarPoints = radarKeys.map(function (key, index) {
      var raw = Number(skinScan.scores[key] && skinScan.scores[key].raw_score) || 0;
      var value = Math.max(0, Math.min(1, raw));
      var angle = (-90 + index * 72) * Math.PI / 180;
      return { key: key, raw: value, x: 180 + Math.cos(angle) * 105 * value, y: 160 + Math.sin(angle) * 105 * value };
    });
    root.querySelector('[data-scan-radar-shape]').setAttribute('points', radarPoints.map(function (point) { return point.x.toFixed(1) + ',' + point.y.toFixed(1); }).join(' '));
    var radarValues = root.querySelector('[data-scan-radar-values]');
    radarPoints.forEach(function (point) { var item = document.createElement('li'); item.textContent = names[point.key] + ': ' + point.raw.toFixed(2); radarValues.appendChild(item); });
    root.querySelector('[data-scan-radar]').hidden = false;
    Object.keys(skinScan.scores).forEach(function (key) {
      var item = document.createElement('div');
      item.className = 'rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-center';
      var name = document.createElement('strong'); name.className = 'block text-emerald-900'; name.textContent = names[key] || key;
      var score = document.createElement('span'); score.className = 'text-2xl font-extrabold text-emerald-700'; score.textContent = String(skinScan.scores[key].ui_score || '—');
      var level = document.createElement('small'); level.className = 'block text-gray-600'; level.textContent = skinScan.scores[key].level || '';
      item.appendChild(name); item.appendChild(score); item.appendChild(level);
      scoreList.appendChild(item);
    });
    scoreList.hidden = false;
    if (skinScan.skin_age) { var age = root.querySelector('[data-scan-age]'); age.textContent = {{ settings.skin_scan_age_label | default: 'Tuổi da tham khảo: ' | json }} + skinScan.skin_age; age.hidden = false; }
    rec.innerHTML = '';
    (skinScan.regimen || []).forEach(function (stage) { var tag = document.createElement('span'); tag.className = 'pc-kit-badge-gold'; tag.textContent = stage; rec.appendChild(tag); });
    var productList = root.querySelector('[data-scan-products]');
    (skinScan.recommended_products || []).forEach(function (product) {
      if (!product || !/^\/[a-z0-9-]+$/.test(product.url || '')) return;
      var link = document.createElement('a'); link.className = 'pc-kit-btn-secondary px-4 py-2'; link.href = product.url; link.textContent = product.label || {{ settings.skin_scan_product_link_label | default: 'Xem sản phẩm tham khảo' | json }};
      productList.appendChild(link);
      var stageProducts = root.querySelector('[data-scan-stage-products="' + Number(product.stage) + '"]');
      if (stageProducts) { stageProducts.appendChild(link.cloneNode(true)); stageProducts.hidden = false; }
    });
    productList.hidden = !productList.childElementCount;
    root.querySelector('[data-skin-save-result]').hidden = false;
  }

  var modal = document.getElementById('aiSkinCrmConsentModal');
  var trigger = root.querySelector('[data-skin-save-result]');
  var accept = document.getElementById('aiSkinCrmConsentAccept');
  var close = function () { modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); if (trigger) trigger.focus(); };
  if (trigger) trigger.addEventListener('click', function () { modal.hidden = false; modal.setAttribute('aria-hidden', 'false'); accept.focus(); });
  document.querySelectorAll('[data-crm-consent-close]').forEach(function (button) { button.addEventListener('click', close); });
  document.addEventListener('keydown', function (event) {
    if (modal.hidden) return;
    if (event.key === 'Escape') { close(); return; }
    if (event.key !== 'Tab') return;
    var focusable = Array.prototype.slice.call(modal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter(function (item) { return !item.hidden; });
    if (!focusable.length) return;
    if (event.shiftKey && document.activeElement === focusable[0]) { event.preventDefault(); focusable[focusable.length - 1].focus(); }
    else if (!event.shiftKey && document.activeElement === focusable[focusable.length - 1]) { event.preventDefault(); focusable[0].focus(); }
  });
  accept.addEventListener('click', function () {
    if (!skinScan || !window.PharmaCrmIntake) return;
    accept.disabled = true;
    window.PharmaCrmIntake.submitSkinAnalysis(Object.assign({}, skinScan, { consent: true, consent_at: new Date().toISOString() })).then(function () { document.getElementById('aiSkinCrmConsentStatus').textContent = {{ settings.crm_consent_success_message | default: 'Kết quả đã được lưu.' | json }}; }).catch(function () { accept.disabled = false; document.getElementById('aiSkinCrmConsentStatus').textContent = {{ settings.crm_consent_error_message | default: 'Chưa thể lưu kết quả lúc này.' | json }}; });
  });
})();
</script>
