{%- comment -%}
  page.ai-skin-quiz-results.bwt — Trang kết quả tư vấn lâm sàng AI Skin Diagnostic
  Chuẩn hóa thiết kế hệ thống theo tiêu chuẩn Astra Workflow:
  - Khung ngoài dùng .container SSOT (2026-10-08: trước đây max-w-5xl hẹp hơn header nên bị thụt vào).
  - Tích hợp Thẻ Khách Hàng & Trạng Thái Đồng Bộ GAS Google Sheets CRM.
  - Bổ sung 2 Section Sapo: Sản phẩm đề xuất theo phác đồ & Bài viết chuyên gia khuyên đọc.
{%- endcomment -%}
{{ 'page_ai_skin_quiz.scss.css' | asset_url | stylesheet_tag }}
{% include 'breadcrumb' %}
{% include 'customer_context_extractor' %}
{% include 'pc_result_store' %}
<script src="{{ 'crm-intake.js' | asset_url }}" defer></script>
{%- comment -%} 2026-10-05: engine Tier/Case/cờ an toàn dùng chung với trang quiz (nạp đồng bộ). {%- endcomment -%}
<script src="{{ 'skin-quiz-engine.js' | asset_url }}"></script>

<script>
  // Dữ liệu sản phẩm và bài viết từ Sapo cung cấp qua Liquid context
  // 2026-10-03: bỏ biến mock `products`/`articles`/`quiz_results` (không có trên Sapo). Bài viết
  // khuyên đọc lấy từ blog settings.quiz_article_blog_handle; bảng kết quả dùng chung với trang quiz.
  {%- comment -%}
    2026-10-05 (review hiệu năng): không in nguyên object `collections['all'].products | json` (kèm mô tả
    HTML, variants, options… → HTML phình hàng trăm KB). Chỉ xuất đúng trường lưới "Sản phẩm đề xuất" dùng,
    ảnh qua img_url, và bỏ luôn sản phẩm kê toa (loai:ke-toa) ngay tại máy chủ.
  {%- endcomment %}
  window.PharmaSapoProducts = [
    {%- assign pc_qr_first = true -%}
    {%- for product in collections['all'].products limit: 50 -%}
    {%- include 'pc_is_rx' -%}
    {%- unless pc_is_rx -%}
    {%- unless pc_qr_first %},{% endunless -%}
    {%- assign pc_qr_first = false %}
    {
      "name": {{ product.name | json }},
      "alias": {{ product.alias | json }},
      "url": {{ product.url | json }},
      "tags": {{ product.tags | json }},
      "price": {{ product.price | default: 0 | json }},
      "compare_at_price": {{ product.compare_at_price | default: 0 | json }},
      "featured_image": {% if product.featured_image.src != blank %}{ "src": {{ product.featured_image.src | img_url: 'large' | json }} }{% else %}null{% endif %}
    }
    {%- endunless -%}
    {%- endfor -%}
  ];
  {%- assign pc_qz_blog_handle = settings.quiz_article_blog_handle | default: 'tin-tuc' -%}
  {%- assign pc_qz_blog = blogs[pc_qz_blog_handle] %}
  window.PharmaSapoArticles = [
    {%- for a in pc_qz_blog.articles limit: 30 -%}
    {
      "title": {{ a.title | json }},
      "url": {{ a.url | json }},
      "excerpt": {{ a.summary | default: a.content | strip_html | truncate: 200 | json }},
      "tags": {{ a.tags | json }},
      "author": {{ a.author | json }},
      "published_on": {{ a.published_on | date: '%Y-%m-%dT%H:%M:%S+07:00' | json }},
      "image": {% if a.image.src != blank %}{ "src": {{ a.image.src | img_url: 'large' | json }} }{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  window.PharmaQuizResultsData = {% include 'quiz_results_data' %};
  window.PharmaQuizSafetyCopy = {% include 'quiz_safety_copy' %};
  {%- comment -%}
    2026-10-09: 8 danh mục tự động theo phác đồ (tạo trên Sapo 09/10/2026) — badge hoạt chất và 3 thẻ giai
    đoạn bấm được để xem sản phẩm. Chỉ xuất danh mục có sản phẩm ⇒ danh mục chưa tạo/trống thì link tự ẩn.
  {%- endcomment %}
  window.PharmaResultCollections = {
    {%- assign pc_rc_first = true -%}
    {%- capture pc_rc_list -%}
      bha:{{ settings.skin_result_col_bha | default: 'hoat-chat-bha-salicylic' }},
      niacinamide:{{ settings.skin_result_col_niacinamide | default: 'tinh-chat-niacinamide' }},
      barrier:{{ settings.skin_result_col_barrier | default: 'phuc-hoi-hang-rao-bao-ve-da' }},
      hydration:{{ settings.skin_result_col_hydration | default: 'duong-am-phuc-hoi-b5-ha' }},
      soothing:{{ settings.skin_result_col_soothing | default: 'lam-diu-on-dinh-nen-da' }},
      retinoid:{{ settings.skin_result_col_retinoid | default: 'retinol-chong-lao-hoa' }},
      brightening:{{ settings.skin_result_col_brightening | default: 'tri-nam-sang-da-tranexamic-vitc' }},
      sunscreen:{{ settings.skin_result_col_sunscreen | default: 'kem-chong-nang-pho-rong' }}
    {%- endcapture -%}
    {%- assign pc_rc_pairs = pc_rc_list | strip_newlines | remove: ' ' | split: ',' -%}
    {%- for pc_rc_pair in pc_rc_pairs -%}
    {%- assign pc_rc_kv = pc_rc_pair | split: ':' -%}
    {%- assign pc_rc_handle = pc_rc_kv.last -%}
    {%- assign pc_rc = collections[pc_rc_handle] -%}
    {%- if pc_rc.products_count > 0 -%}
    {%- unless pc_rc_first %},{% endunless -%}
    {%- assign pc_rc_first = false %}
    {{ pc_rc_kv.first | json }}: { "url": {{ pc_rc.url | json }}, "title": {{ pc_rc.name | json }}, "count": {{ pc_rc.products_count | json }}, "products": [
      {%- comment -%} 2026-10-10: tối đa 8 SP (bỏ kê toa) mỗi danh mục làm nguồn "Sản phẩm đề xuất" theo đúng hoạt chất/giai đoạn. {%- endcomment -%}
      {%- assign pc_rcp_n = 0 -%}
      {%- for product in pc_rc.products limit: 16 -%}
      {%- if pc_rcp_n < 8 -%}
      {%- include 'pc_is_rx' -%}
      {%- unless pc_is_rx -%}
      {%- if pc_rcp_n > 0 %},{% endif -%}
      {%- assign pc_rcp_n = pc_rcp_n | plus: 1 %}
      {%- assign pc_rcp_vid = '' -%}
      {%- if product.available and product.variants.size == 1 -%}{%- assign pc_rcp_vid = product.variants.first.id -%}{%- endif %}
      { "name": {{ product.name | json }}, "alias": {{ product.alias | json }}, "url": {{ product.url | json }}, "vendor": {{ product.vendor | json }}, "variant_id": {{ pc_rcp_vid | json }}, "tags": {{ product.tags | json }}, "price": {{ product.price | default: 0 | json }}, "compare_at_price": {{ product.compare_at_price | default: 0 | json }}, "featured_image": {% if product.featured_image.src != blank %}{ "src": {{ product.featured_image.src | img_url: 'large' | json }} }{% else %}null{% endif %} }
      {%- endunless -%}
      {%- endif -%}
      {%- endfor %}
    ] }
    {%- endif -%}
    {%- endfor %}
  };
</script>

<section class="py-6 sm:py-10 bg-slate-50/50 min-h-screen">
  <div class="container space-y-6">

    <!-- 1. Disclaimer Banner -->
    <div data-result-disclaimer class="bg-amber-50/90 border border-amber-200/90 text-amber-900 text-xs sm:text-sm rounded-2xl p-4 sm:p-5 flex items-start gap-3.5 shadow-sm">
      <i class="fas fa-triangle-exclamation text-amber-500 text-base mt-0.5 shrink-0" aria-hidden="true"></i>
      <div class="leading-relaxed">
        <strong class="font-bold">{{ settings.ai_skin_scan_disclaimer_title | default: 'Lưu ý về kết quả' | escape }}:</strong>
        {{ settings.ai_skin_scan_disclaimer | default: 'Kết quả là gợi ý tự động để tham khảo, không phải chẩn đoán y khoa và không thay thế đánh giá trực tiếp từ chuyên gia phù hợp. Nếu có lo ngại về da, hãy trao đổi với chuyên gia y tế.' | escape }}
      </div>
    </div>

    <div id="pcQuizResultsRoot" data-demo="true" class="space-y-6">

      {%- comment -%}
        2026-10-10: trạng thái CHƯA CÓ HỒ SƠ theo thiết kế design/ket-qua-da/chua-co-ho-so.png — thanh cảnh báo ở trên,
        bên dưới là khối giới thiệu + thẻ "Soi da bằng AI qua camera". Mọi chữ/ảnh lấy từ settings.skin_result_empty_*;
        ảnh để trống thì bố cục chỉ còn chữ. Ảnh dùng loading="lazy" vì khối này chỉ hiện khi KHÔNG có kết quả
        (ẩn sẵn ở máy chủ) — tải sẵn/preload sẽ lãng phí với khách đã có kết quả.
      {%- endcomment %}
      <div class="pc-result-empty" data-result-empty-view hidden>
        <div class="pc-result-empty__warning" role="status" data-result-empty-warning>
          <i class="fas fa-triangle-exclamation pc-result-empty__warning-icon" aria-hidden="true"></i>
          <div class="pc-result-empty__warning-text">
            <strong data-result-empty-title>{{ settings.skin_result_empty_title | default: 'Bạn chưa có hồ sơ chăm sóc da' | escape }}</strong>
            <span data-result-empty-text>{{ settings.skin_result_empty_text | default: 'Hãy khảo sát da để nhận phác đồ và gợi ý sản phẩm phù hợp với tình trạng da hiện tại của bạn.' | escape }}</span>
          </div>
          {%- if settings.skin_result_empty_learn_url != blank %}
          <a class="pc-result-empty__learn" href="{{ settings.skin_result_empty_learn_url | escape }}">{{ settings.skin_result_empty_learn_label | default: 'Tìm hiểu thêm' | escape }} <i class="fas fa-chevron-right" aria-hidden="true"></i></a>
          {%- endif %}
          <button type="button" class="pc-result-empty__close" aria-label="Đóng thông báo" data-result-empty-close><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </div>

        <div class="pc-result-empty__hero{% if settings.skin_result_empty_hero_image != blank %} has-image{% endif %}">
          <div class="pc-result-empty__intro">
            <p class="pc-result-empty__eyebrow">{{ settings.skin_result_empty_eyebrow | default: 'PHARMA COSMETICS' | escape }}</p>
            <p class="pc-result-empty__headline" data-result-empty-headline>{{ settings.skin_result_empty_headline | default: 'Hiểu làn da để chăm đúng cách' | escape }}</p>
            <p class="pc-result-empty__lead">{{ settings.skin_result_empty_lead | default: 'Khảo sát da bằng AI, nhận phân tích chi tiết và gợi ý chăm sóc cá nhân hoá.' | escape }}</p>
            <span class="pc-result-empty__rule" aria-hidden="true"></span>
          </div>
          {%- if settings.skin_result_empty_hero_image != blank %}
          <img class="pc-result-empty__hero-img" src="{{ settings.skin_result_empty_hero_image | img_url: '1024x1024' }}" alt="{{ settings.skin_result_empty_hero_alt | default: settings.skin_result_empty_headline | escape }}" width="1024" height="576" loading="lazy">
          {%- endif %}
        </div>

        <div class="pc-result-empty__card">
          {%- if settings.skin_result_empty_card_image != blank %}
          <img class="pc-result-empty__thumb" src="{{ settings.skin_result_empty_card_image | img_url: 'large' }}" alt="{{ settings.skin_result_empty_card_alt | default: settings.skin_result_empty_card_title | escape }}" width="480" height="340" loading="lazy">
          {%- endif %}
          <div class="pc-result-empty__card-body">
            <h2 class="pc-result-empty__card-title">{{ settings.skin_result_empty_card_title | default: 'Soi da bằng AI qua camera' | escape }}</h2>
            <p class="pc-result-empty__card-text">{{ settings.skin_result_empty_card_text | default: 'Phân tích tình trạng da, nhận biết vấn đề và gợi ý sản phẩm phù hợp chỉ trong vài phút.' | escape }}</p>
            <div class="pc-result-empty__actions">
              <a href="/ai-skin-quiz?tab=camera" class="pc-result-empty__btn pc-result-empty__btn--primary" data-result-empty-scan>
                <i class="fas fa-camera" aria-hidden="true"></i> {{ settings.skin_result_empty_scan_label | default: 'Bắt đầu ngay' | escape }} <i class="fas fa-chevron-right" aria-hidden="true"></i>
              </a>
              <a href="/ai-skin-quiz" class="pc-result-empty__btn pc-result-empty__btn--secondary" data-result-empty-quiz>
                <i class="far fa-comment-dots" aria-hidden="true"></i> {{ settings.skin_result_empty_quiz_label | default: 'Khảo sát da chat' | escape }}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 2026-10-10: Mời tạo hồ sơ CRM — chỉ hiện khi CÓ kết quả trên thiết bị nhưng GAS chưa có hồ sơ của kết quả này.
           Đã đăng nhập ⇒ nút mở hộp đồng ý lưu; khách vãng lai ⇒ nút đăng nhập (bắt buộc đăng nhập mới tạo hồ sơ). -->
      <div class="pc-profile-prompt bg-emerald-50 border border-emerald-200 rounded-2xl sm:rounded-3xl p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center gap-4" data-profile-prompt hidden>
        <div class="w-11 h-11 rounded-full bg-emerald-600 text-white flex items-center justify-center text-lg shrink-0" aria-hidden="true">
          <i class="fas fa-file-medical"></i>
        </div>
        <div class="flex-1 space-y-1">
          <p class="text-sm sm:text-base font-bold text-forest-900">{{ settings.skin_profile_prompt_title | default: 'Bạn đã có kết quả phân tích da' | escape }}</p>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed" data-profile-prompt-text></p>
        </div>
        <button type="button" class="pc-kit-btn-primary px-5 py-3 text-sm font-bold justify-center shrink-0" data-profile-prompt-action></button>
      </div>

      <!-- 2. Thẻ Thông Tin Khách Hàng & Trạng Thái Đồng Bộ GAS CRM -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200/90" data-customer-card data-result-section>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-5 border-b border-gray-100 gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg font-bold">
              <i class="fas fa-user-check"></i>
            </div>
            <div>
              <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">HỒ SƠ KHÁCH HÀNG</span>
              <h2 class="text-base sm:text-lg font-bold text-gray-900 font-heading" data-customer-name>Khách Hàng Tư Vấn</h2>
            </div>
          </div>
          <div class="flex items-center gap-2" data-crm-sync-container>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200" data-crm-status-badge>
              <i class="fas fa-circle-notch fa-spin text-emerald-600"></i> Đang đối soát CRM...
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-gray-50/80 border border-gray-100 space-y-1">
            <span class="text-gray-500 block text-xs">Liên hệ:</span>
            <strong class="text-gray-900 block font-semibold" data-customer-contact>Chưa đăng nhập</strong>
            <span class="text-[11px] text-emerald-700 block font-medium" data-customer-tier>Khách vãng lai</span>
          </div>

          <div class="p-4 rounded-xl bg-gray-50/80 border border-gray-100 space-y-1">
            <span class="text-gray-500 block text-xs">Nguồn phân tích:</span>
            <strong class="text-gray-900 block font-semibold" data-consultation-source>Khảo sát chuyên sâu câu</strong>
            <span class="text-[11px] text-gray-500 block" data-consultation-date>Hôm nay</span>
          </div>

          <div class="p-4 rounded-xl bg-gray-50/80 border border-gray-100 space-y-1">
            <span class="text-gray-500 block text-xs">Trạng thái lưu trữ GAS:</span>
            <div class="flex items-center justify-between">
              <strong class="text-gray-900 block font-semibold" data-crm-storage-state>Phiên hiện tại</strong>
              <button type="button" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 underline ml-2" data-trigger-crm-save>Lưu ngay</button>
            </div>
            <span class="text-[11px] text-gray-500 block truncate" data-crm-submission-id>Chưa cấp mã lưu</span>
          </div>
        </div>
      </div>

      <!-- 3. Hồ Sơ Da Tổng Quan (2026-10-10: chưa có dữ liệu ⇒ khối này hiện trạng thái "chưa có hồ sơ", giữ h1 duy nhất) -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200/90" data-result-profile>
        <div class="flex items-center gap-3 mb-4">
          <span class="pc-kit-badge-clinical text-xs font-semibold" data-result-demo-flag hidden>Bản xem trước minh hoạ</span>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200" data-result-verified-badge>
            <i class="fas fa-microscope text-[10px]"></i> Đã phân tích quang học
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-forest-900 font-heading mb-2">
          Hồ Sơ Da Của Bạn: <span data-result-title>—</span>
        </h1>
        <p class="text-sm text-gray-600 leading-relaxed" data-result-summary>Đang tải kết quả…</p>
      </div>

      <!-- 4. Hoạt Chất Đề Xuất & Định Hướng Phác Đồ — 2026-10-10: bố cục theo design/ket-qua-da/dinh-huong-phac-do.png:
           5 thẻ chỉ số → 3 giai đoạn (mỗi giai đoạn 1 dải sản phẩm thật từ danh mục tự động) + cột phải (radar, gợi ý
           chuyên gia, lưu ý) → 3 thẻ "Giai đoạn điều trị khuyến nghị". Chữ lấy từ settings.skin_plan_*. -->
      <div class="pc-plan bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-sm border border-gray-200/90" data-result-section>
        <div class="pc-plan__head">
          <div>
            <span class="pc-plan__eyebrow">HOẠT CHẤT ĐƯỢC ĐỀ XUẤT</span>
            <h3 class="pc-plan__title">Định Hướng Phác Đồ Tham Khảo</h3>
            <p class="pc-plan__subtitle">{{ settings.skin_plan_subtitle | default: 'Dựa trên kết quả phân tích làn da, chúng tôi gợi ý các nhóm hoạt chất phù hợp và sản phẩm tiêu biểu giúp bạn xây dựng phác đồ chăm sóc da hiệu quả hơn.' | escape }}</p>
          </div>
          <span class="pc-kit-badge-clinical text-xs font-semibold pc-plan__badge"><i class="fas fa-shield-heart" aria-hidden="true"></i> {{ settings.skin_scan_recommendation_badge | default: 'Gợi ý tham khảo' | escape }}</span>
        </div>

        <div class="pc-plan__actives">
          <h4 class="pc-plan__actives-label">Nhóm thành phần hoạt tính ưu tiên:</h4>
          <div class="flex flex-wrap gap-2.5" data-result-recommend></div>
        </div>

        <div class="pc-plan__scores" data-scan-scores hidden></div>
        <p class="text-sm text-gray-600" data-scan-age hidden></p>

        <div class="pc-quiz-alert" data-quiz-alert hidden></div>
        <div class="pc-quiz-routine" data-quiz-routine hidden></div>

        <div class="pc-plan__layout">
          <div class="pc-plan__stages" data-plan-stages hidden></div>
          <aside class="pc-plan__aside">
            <figure class="pc-skin-radar" data-scan-radar hidden>
              <h3>{{ settings.skin_scan_radar_title | default: 'Biểu đồ 5 chỉ số soi da' | escape }}</h3>
              <svg width="360" height="320" viewBox="0 0 360 320" role="img" aria-labelledby="skinRadarSvgTitle" aria-describedby="skinRadarData">
                <title id="skinRadarSvgTitle">{{ settings.skin_scan_radar_title | default: 'Biểu đồ 5 chỉ số soi da' | escape }}</title>
                <g class="pc-skin-radar__grid" aria-hidden="true">
                  <polygon points="180,139 200,153 192,176 168,176 160,153"></polygon>
                  <polygon points="180,118 220,147 205,192 155,192 140,147"></polygon>
                  <polygon points="180,97 240,140 218,208 142,208 120,140"></polygon>
                  <polygon points="180,76 260,133 230,224 130,224 100,133"></polygon>
                  <polygon points="180,55 280,127 242,245 118,245 80,127"></polygon>
                  <path d="M180 160V55 M180 160L280 127 M180 160L242 245 M180 160L118 245 M180 160L80 127"></path>
                </g>
                <polygon class="pc-skin-radar__area" data-scan-radar-shape points="180,160 180,160 180,160 180,160 180,160"></polygon>
                <g class="pc-skin-radar__labels" aria-hidden="true">
                  <text x="180" y="34" text-anchor="middle">{{ settings.skin_scan_score_acne | default: 'Mụn' | escape }}</text>
                  <text x="300" y="121" text-anchor="start">{{ settings.skin_scan_score_pigmentation | default: 'Sắc tố' | escape }}</text>
                  <text x="256" y="273" text-anchor="middle">{{ settings.skin_scan_score_wrinkles | default: 'Nếp nhăn' | escape }}</text>
                  <text x="104" y="273" text-anchor="middle">{{ settings.skin_scan_score_redness | default: 'Độ đỏ' | escape }}</text>
                  <text x="60" y="121" text-anchor="end">{{ settings.skin_scan_score_pores | default: 'Lỗ chân lông' | escape }}</text>
                </g>
              </svg>
              <figcaption>{{ settings.skin_scan_radar_description | default: 'Vùng tô đậm biểu thị raw_score chuẩn hóa (0–1); giá trị cao hơn nghĩa là chỉ số concern cao hơn, không phải điểm sức khỏe.' | escape }}</figcaption>
              <ul class="sr-only" id="skinRadarData" data-scan-radar-values></ul>
            </figure>
            <div class="pc-plan__box">
              <h4 class="pc-plan__box-title"><i class="fas fa-user-doctor" aria-hidden="true"></i> {{ settings.skin_plan_expert_title | default: 'Gợi ý từ chuyên gia' | escape }}</h4>
              <div class="pc-plan__expert">
                <p>{{ settings.skin_plan_expert_text | default: 'Các sản phẩm trên được gợi ý dựa trên kết quả phân tích làn da của bạn. Để xây dựng phác đồ chi tiết và phù hợp nhất, bạn nên tham khảo ý kiến chuyên gia.' | escape }}</p>
                <a class="pc-plan__expert-btn" href="{{ settings.skin_plan_expert_url | default: '/dat-lich-tu-van' | escape }}">{{ settings.skin_plan_expert_label | default: 'Đặt lịch tư vấn ngay' | escape }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
              </div>
            </div>
            {%- comment -%} Lưu ý: mỗi dòng của settings.skin_plan_notes là 1 mục (trống ⇒ 3 lưu ý mặc định). {%- endcomment -%}
            {%- capture pc_plan_notes_raw -%}{{ settings.skin_plan_notes | newline_to_br }}{%- endcapture -%}
            {%- if settings.skin_plan_notes == blank -%}
              {%- assign pc_plan_notes_raw = 'Ưu tiên thử sản phẩm ở vùng da nhỏ trước khi sử dụng toàn mặt.<br />Kết hợp chống nắng hằng ngày để bảo vệ da tốt hơn.<br />Tham khảo ý kiến chuyên gia nếu có dấu hiệu kích ứng kéo dài.' -%}
            {%- endif -%}
            {%- assign pc_plan_notes = pc_plan_notes_raw | split: '<br />' %}
            <div class="pc-plan__box">
              <h4 class="pc-plan__box-title"><i class="far fa-file-lines" aria-hidden="true"></i> {{ settings.skin_plan_notes_title | default: 'Lưu ý khi sử dụng' | escape }}</h4>
              <ul class="pc-plan__notes">
                {%- for pc_note in pc_plan_notes -%}
                {%- assign pc_note_text = pc_note | strip_newlines | strip -%}
                {%- if pc_note_text != blank %}
                <li><i class="fas fa-circle-check" aria-hidden="true"></i> {{ pc_note_text | escape }}</li>
                {%- endif -%}
                {%- endfor %}
              </ul>
            </div>
          </aside>
        </div>

        <div class="pc-plan__stage-cards" data-stage-section>
          <h4 class="pc-plan__section-title"><i class="far fa-lightbulb" aria-hidden="true"></i> {{ settings.skin_plan_stages_heading | default: 'Giai đoạn điều trị khuyến nghị' | escape }}</h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2" data-stage-grid>
          <div class="p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80 space-y-2">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">GIAI ĐOẠN 1</span>
            <h4 class="text-sm font-bold text-gray-900">Làm Dịu &amp; Ổn Định Nền Da</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Ưu tiên hoạt chất dịu nhẹ, ngưng các bước gây kích ứng, phục hồi ngưỡng chịu đựng của da.</p>
            <div class="flex flex-wrap gap-2 pt-1" data-scan-stage-products="1" hidden></div>
          </div>
          <div class="p-5 rounded-2xl bg-teal-50/60 border border-teal-200/80 space-y-2">
            <span class="text-xs font-bold text-teal-800 uppercase tracking-wider block">GIAI ĐOẠN 2</span>
            <h4 class="text-sm font-bold text-gray-900">Phục Hồi Hàng Rào Bảo Vệ Da</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Bổ sung dưỡng ẩm, Ceramide, Vitamin B5 theo nhóm hoạt chất đề xuất, tăng dần khả năng dung nạp.</p>
            <div class="flex flex-wrap gap-2 pt-1" data-scan-stage-products="2" hidden></div>
          </div>
          <div class="p-5 rounded-2xl bg-cyan-50/60 border border-cyan-200/80 space-y-2">
            <span class="text-xs font-bold text-cyan-800 uppercase tracking-wider block">GIAI ĐOẠN 3</span>
            <h4 class="text-sm font-bold text-gray-900">Điều Trị Chuyên Sâu Theo Mục Tiêu</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Hoạt chất đặc trị nồng độ chuẩn y khoa (BHA, Tranexamic, Retinol) theo hướng dẫn chuyên gia 1:1.</p>
            <div class="flex flex-wrap gap-2 pt-1" data-scan-stage-products="3" hidden></div>
          </div>
        </div>
        </div>
      </div>

      <!-- 5. BỔ SUNG SECTION 1: Sản Phẩm Sapo Phù Hợp Nền Da -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200/90 space-y-6" data-result-products-section data-result-section>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-2">
          <div>
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block">DƯỢC MỸ PHẨM CHÍNH HÃNG</span>
            <h3 class="text-lg font-bold text-forest-900 font-heading">Sản Phẩm Đề Xuất Phù Hợp Nền Da</h3>
          </div>
          <a href="/collections/all" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1" data-products-all-link>
            Xem tất cả sản phẩm <i class="fas fa-chevron-right text-[10px]"></i>
          </a>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          Các sản phẩm được chọn lọc chuẩn khoa học từ hệ thống Pharma Cosmetics, chứa hoạt chất tương thích với phác đồ chăm sóc làn da của bạn.
        </p>
        <p class="inline-flex flex-wrap items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200" data-products-basis hidden></p>

        <!-- Product Grid Dynamic Container -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6" data-sapo-products-grid>
          <!-- Sẽ được JS render động từ PharmaSapoProducts khớp theo loại da -->
        </div>
      </div>

      <!-- 6. BỔ SUNG SECTION 2: Bài Viết Chuyên Gia Khuyên Đọc Từ Sapo Blog -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200/90 space-y-6" data-result-blogs-section data-result-section>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-2">
          <div>
            <span class="text-xs font-bold text-teal-700 uppercase tracking-wider block">GÓC CHUYÊN GIA PHARMA COSMETICS</span>
            <h3 class="text-lg font-bold text-forest-900 font-heading">Kiến Thức &amp; Bài Viết Chuyên Sâu Khuyên Đọc</h3>
          </div>
          <a href="/blogs/tin-tuc" class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1">
            Xem chuyên mục tin tức <i class="fas fa-chevron-right text-[10px]"></i>
          </a>
        </div>
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
          Cẩm nang kiến thức y khoa, giải mã thành phần và hướng dẫn chăm sóc chuẩn chuyên gia giúp bạn đạt hiệu quả phục hồi tốt nhất.
        </p>

        <!-- Blog Articles Grid Container -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-sapo-articles-grid>
          <!-- Sẽ được JS render động từ PharmaSapoArticles khớp theo vấn đề da -->
        </div>
      </div>

      <!-- 7. Hành Động Tiếp Theo -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-200/90 space-y-5" data-result-section>
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Hành Động Khuyên Dùng</h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <a class="flex-1 pc-kit-btn-primary py-3.5 text-center justify-center font-bold shadow-sm" data-result-search-link href="/search">
            <i class="fas fa-magnifying-glass"></i> Khám Phá Sản Phẩm Theo Hoạt Chất
          </a>
          <a href="/dat-lich-tu-van" class="flex-1 pc-kit-btn-secondary py-3.5 text-center justify-center font-bold shadow-sm">
            <i class="fas fa-calendar-check text-emerald-600"></i> Đặt Lịch Chuyên Gia Thăm Khám 1:1
          </a>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between pt-3 border-t border-gray-100 text-xs text-gray-500 gap-3">
          <a href="/ai-skin-quiz" class="font-semibold text-emerald-700 hover:underline inline-flex items-center gap-1.5">
            <i class="fas fa-arrow-left"></i> Làm lại khảo sát câu hỏi
          </a>
          <a href="/ai-skin-quiz?tab=camera" class="font-semibold text-teal-700 hover:underline inline-flex items-center gap-1.5">
            <i class="fas fa-camera"></i> Soi da lại bằng camera 3 góc
          </a>
          <button type="button" class="font-semibold text-gray-600 hover:text-emerald-700" data-skin-save-result>
            <i class="fas fa-cloud-arrow-up"></i> Lưu kết quả tư vấn vào CRM
          </button>
          <button type="button" class="font-semibold text-gray-500 hover:text-red-700" data-result-clear hidden>
            <i class="fas fa-trash-can"></i> {{ settings.skin_result_clear_label | default: 'Xoá kết quả trên thiết bị này' | escape }}
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

{% include 'skin_consent_modal' %}

<script>
(function () {
  'use strict';

  var resultsData = window.PharmaQuizResultsData || {};
  var allProducts = window.PharmaSapoProducts || [];
  var allArticles = window.PharmaSapoArticles || [];
  var root = document.getElementById('pcQuizResultsRoot');
  if (!root) return;

  var skinType = null;
  var isDemo = true;
  var skinScan = null;
  // 2026-10-10: đọc kết quả qua PharmaResultStore (localStorage có hạn dùng + sessionStorage) — khách quay lại trang
  // kết quả trong thời hạn vẫn thấy đúng kết quả của mình và được mời tạo hồ sơ.
  var resultStore = window.PharmaResultStore || {
    get: function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } },
    clearAll: function () {}
  };

  try {
    skinType = resultStore.get('pc_quiz_skin_type');
    if (skinType) isDemo = false;
    skinScan = JSON.parse(resultStore.get('pc_skin_scan_result') || 'null');
    if (skinScan && skinScan.scores) isDemo = false;
    // 2026-10-08: phiên có cả soi da AI lẫn khảo sát chat ⇒ dùng kết quả làm SAU CÙNG (theo saved_at).
    var quizSavedAt = Number(resultStore.get('pc_quiz_saved_at') || 0);
    var scanSavedAt = skinScan ? Number(skinScan.saved_at || 0) : 0;
    if (skinScan && skinType && quizSavedAt && scanSavedAt && quizSavedAt > scanSavedAt) skinScan = null;
  } catch (e) {
    /* Safe fallback if storage blocked */
  }
  // Vấn đề trọng tâm của soi da → nhóm loại da dùng để lọc sản phẩm/bài viết (cùng bảng từ khoá bên dưới).
  var scanConcernSkin = { acne: 'oily', pores: 'oily', pigmentation: 'pigmentation', wrinkles: 'aging', redness: 'sensitive' };
  var scanConcernNames = { acne: 'Mụn & bít tắc', pores: 'Lỗ chân lông & dầu thừa', pigmentation: 'Sắc tố & thâm sạm', wrinkles: 'Nếp nhăn & lão hóa', redness: 'Da đỏ & nhạy cảm' };
  function basisSkin() {
    if (skinScan && skinScan.scores) return scanConcernSkin[skinScan.primary_concern] || 'normal';
    return skinType || 'oily';
  }

  if (!skinType || !resultsData[skinType]) {
    if (!skinScan) {
      skinType = Object.keys(resultsData)[0] || 'oily';
      isDemo = true;
    }
  }

  root.dataset.demo = String(isDemo);
  var demoFlag = root.querySelector('[data-result-demo-flag]');
  if (demoFlag) demoFlag.hidden = !isDemo;

  // 2026-10-05: Tier/Case/cờ an toàn do trang quiz lưu (pc_quiz_result, không có thông tin cá nhân).
  var engine = window.PharmaSkinQuizEngine || null;
  var safety = window.PharmaQuizSafetyCopy || {};
  var quizResult = null;
  try { quizResult = JSON.parse(resultStore.get('pc_quiz_result') || 'null'); } catch (e) {}
  if (skinScan || isDemo) quizResult = null;
  var excluded = (quizResult && quizResult.excluded_actives) || [];
  var quizCase = (quizResult && resultsData.cases) ? resultsData.cases[quizResult.case_id] : null;

  var result = resultsData[skinType] || {
    skin_type: 'Làn Da Dầu / Dễ Nổi Mụn',
    recommend: ['Salicylic Acid (BHA 2%)', 'Niacinamide 10%', 'Gel Dưỡng Không Dầu Oil-Free']
  };

  if (!skinScan) {
    root.querySelector('[data-result-title]').textContent = (quizResult && quizResult.tier === 1)
      ? (safety.redFlagTitle || result.skin_type)
      : (quizCase ? quizCase.title : result.skin_type);
    root.querySelector('[data-result-summary]').textContent = 'Dựa trên câu trả lời thực tế của bạn ở bài khảo sát câu hỏi.';
  }

  // ── 2026-10-10: CHƯA CÓ DỮ LIỆU ⇒ "chưa có hồ sơ" + mời khảo sát chat / soi da (thay bản minh hoạ cũ) ──
  // Người dùng yêu cầu: trang kết quả không có dữ liệu thì phải báo chưa có hồ sơ và mời tạo ngay; có dữ liệu
  // (trên thiết bị hoặc hồ sơ CRM khớp mã của thiết bị) mới hiện thông tin hồ sơ + gợi ý sản phẩm.
  var emptyCopy = {
    existsText: {{ settings.skin_result_empty_exists_text | default: 'Tài khoản của bạn đã có hồ sơ chăm sóc da, nhưng thiết bị này chưa có kết quả để hiển thị. Làm lại khảo sát hoặc soi da để xem phác đồ và gợi ý sản phẩm mới nhất.' | json }}
  };
  function swapTag(el, tag) {
    if (!el) return null;
    var n = document.createElement(tag);
    Array.prototype.forEach.call(el.attributes, function (a) { n.setAttribute(a.name, a.value); });
    n.innerHTML = el.innerHTML;
    el.parentNode.replaceChild(n, el);
    return n;
  }
  function showEmptyState() {
    root.querySelectorAll('[data-result-section]').forEach(function (s) { s.hidden = true; });
    var profile = root.querySelector('[data-result-profile]');
    if (profile) { profile.hidden = true; swapTag(profile.querySelector('h1'), 'h2'); }
    var disclaimer = document.querySelector('[data-result-disclaimer]');
    if (disclaimer) disclaimer.hidden = true; // chưa có kết quả thì chưa cần lưu ý về kết quả
    var view = root.querySelector('[data-result-empty-view]');
    if (!view) return;
    swapTag(view.querySelector('[data-result-empty-headline]'), 'h1');
    view.hidden = false;
    var closeBtn = view.querySelector('[data-result-empty-close]');
    if (closeBtn) closeBtn.addEventListener('click', function () { view.querySelector('[data-result-empty-warning]').hidden = true; });
    if (demoFlag) demoFlag.hidden = true;
  }
  if (isDemo) showEmptyState();

  // ── 2026-10-09: badge hoạt chất / thẻ giai đoạn → danh mục tự động trên Sapo (window.PharmaResultCollections).
  // Thứ tự quy tắc có chủ ý: "Kem Chống Nắng Vật Lý Dịu Nhẹ" phải ra chống nắng, "Panthenol (Vitamin B5)" ra
  // phục hồi hàng rào, "Serum Cấp Nước B5" ra cấp ẩm.
  var resultCollections = window.PharmaResultCollections || {};
  var collectionRules = [
    ['sunscreen', /chống nắng|spf|broad-spectrum/i],
    ['bha', /salicylic|bha|azela/i],
    ['niacinamide', /niacinamide|oil-free|dầu nước|kiềm dầu/i],
    ['hydration', /hyaluronic|cấp nước|cấp ẩm|khóa ẩm|khoá ẩm/i],
    ['barrier', /ceramide|centella|rau má|panthenol|phục hồi/i],
    ['brightening', /tranexamic|vitamin c|nám|sáng da|sắc tố/i],
    ['retinoid', /retin|peptide|lão hóa|lão hoá/i],
    ['soothing', /làm dịu|dịu nhẹ|nhạy cảm/i]
  ];
  // Danh mục chứa hoạt chất có thể bị loại theo cờ an toàn (thai kỳ, dị ứng nặng) ⇒ không đưa link.
  var collectionActive = { bha: 'bha', retinoid: 'retinoid' };
  function collectionFor(key) {
    var c = key && resultCollections[key];
    if (!c || !c.url) return null;
    if (collectionActive[key] && excluded.indexOf(collectionActive[key]) !== -1) return null;
    return c;
  }
  function collectionKeyForText(text) {
    for (var i = 0; i < collectionRules.length; i++) {
      if (collectionRules[i][1].test(text || '')) return collectionRules[i][0];
    }
    return null;
  }
  // Giai đoạn 1 = làm dịu, 2 = phục hồi hàng rào, 3 = đặc trị theo vấn đề trọng tâm (soi da) hoặc loại da (khảo sát).
  var stage3BySkin = { oily: 'bha', combination: 'niacinamide', dry: 'hydration', sensitive: 'sunscreen', normal: 'brightening', pigmentation: 'brightening', aging: 'retinoid' };
  var stage3ByConcern = { acne: 'bha', pores: 'niacinamide', pigmentation: 'brightening', wrinkles: 'retinoid', redness: 'sunscreen' };
  function stageCollectionKey(stage) {
    if (stage === 1) return 'soothing';
    if (stage === 2) return 'barrier';
    if (skinScan && skinScan.scores) {
      // Bản lưu cũ có thể thiếu primary_concern ⇒ lấy chỉ số raw_score cao nhất (cùng cách skin-routine-matcher).
      var concern = skinScan.primary_concern || Object.keys(skinScan.scores).sort(function (a, b) {
        return Number(skinScan.scores[b] && skinScan.scores[b].raw_score || 0) - Number(skinScan.scores[a] && skinScan.scores[a].raw_score || 0);
      })[0];
      return stage3ByConcern[concern] || 'barrier';
    }
    return stage3BySkin[skinType] || 'barrier';
  }
  function renderBadge(text, key) {
    var c = collectionFor(key);
    var el = document.createElement(c ? 'a' : 'span');
    el.className = 'pc-kit-badge-gold px-3 py-1.5 text-xs font-semibold' + (c ? ' inline-flex items-center gap-1.5 hover:underline' : '');
    el.textContent = text;
    if (c) {
      el.href = c.url;
      el.title = 'Xem ' + c.count + ' sản phẩm: ' + c.title;
      el.setAttribute('data-result-collection', key);
      var icon = document.createElement('i');
      icon.className = 'fas fa-arrow-right text-[10px]';
      icon.setAttribute('aria-hidden', 'true');
      el.appendChild(icon);
    }
    rec.appendChild(el);
  }

  // Render hoạt chất
  var rec = root.querySelector('[data-result-recommend]');
  rec.innerHTML = '';
  (result.recommend || []).filter(function (r) {
    return !engine || engine.isTextAllowed(r, excluded);
  }).forEach(function (r) {
    renderBadge(r, collectionKeyForText(r));
  });

  var searchLink = root.querySelector('[data-result-search-link]');
  if (searchLink && result.recommend && result.recommend[0]) {
    // 2026-10-09: ưu tiên danh mục tự động của hoạt chất đầu tiên, chưa có thì tìm kiếm như cũ.
    var firstCollection = collectionFor(collectionKeyForText(result.recommend[0]));
    searchLink.href = firstCollection ? firstCollection.url : '/search?query=' + encodeURIComponent(result.recommend[0]);
  }

  // Soi da camera chi tiết nếu có
  if (skinScan && skinScan.scores) {
    isDemo = false;
    root.dataset.demo = 'false';
    root.querySelector('[data-result-title]').textContent = skinScan.skin_type || 'Báo cáo soi da quang học';
    // 2026-10-08: tóm tắt đúng kết quả cơ bản vừa hiển thị ở bước soi da (trạng thái + điểm + lời khuyên).
    var scanSummary = [];
    if (skinScan.overall_status) scanSummary.push('Trạng thái da: ' + skinScan.overall_status + (skinScan.overall_score ? ' (' + skinScan.overall_score + '/100).' : '.'));
    if (skinScan.advice) scanSummary.push(skinScan.advice);
    scanSummary.push('Các chỉ số được tính tại thiết bị từ 3 góc mặt; ảnh khuôn mặt không gửi về máy chủ.');
    root.querySelector('[data-result-summary]').textContent = scanSummary.join(' ');
    if (demoFlag) demoFlag.hidden = true;

    var scoreList = root.querySelector('[data-scan-scores]');
    var names = {
      acne: {{ settings.skin_scan_score_acne | default: 'Mụn' | json }},
      pigmentation: {{ settings.skin_scan_score_pigmentation | default: 'Sắc tố' | json }},
      wrinkles: {{ settings.skin_scan_score_wrinkles | default: 'Nếp nhăn' | json }},
      redness: {{ settings.skin_scan_score_redness | default: 'Độ đỏ' | json }},
      pores: {{ settings.skin_scan_score_pores | default: 'Lỗ chân lông' | json }}
    };

    var radarKeys = ['acne', 'pigmentation', 'wrinkles', 'redness', 'pores'];
    var radarPoints = radarKeys.map(function (key, index) {
      var raw = Number(skinScan.scores[key] && skinScan.scores[key].raw_score) || 0;
      var value = Math.max(0, Math.min(1, raw));
      var angle = (-90 + index * 72) * Math.PI / 180;
      return { key: key, raw: value, x: 180 + Math.cos(angle) * 105 * value, y: 160 + Math.sin(angle) * 105 * value };
    });

    var radarShape = root.querySelector('[data-scan-radar-shape]');
    if (radarShape) {
      radarShape.setAttribute('points', radarPoints.map(function (p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' '));
    }
    var radarValues = root.querySelector('[data-scan-radar-values]');
    if (radarValues) {
      radarValues.innerHTML = '';
      radarPoints.forEach(function (point) {
        var item = document.createElement('li');
        item.textContent = names[point.key] + ': ' + point.raw.toFixed(2);
        radarValues.appendChild(item);
      });
    }
    var radarContainer = root.querySelector('[data-scan-radar]');
    if (radarContainer) radarContainer.hidden = false;

    if (scoreList) {
      scoreList.innerHTML = '';
      // 2026-10-10: thẻ chỉ số theo thiết kế (icon tròn + tên + điểm + mức do skin-scoring-engine tính).
      var scoreIcons = { acne: 'fa-virus', pigmentation: 'fa-wand-magic-sparkles', wrinkles: 'fa-water', redness: 'fa-sun', pores: 'fa-droplet' };
      radarKeys.forEach(function (key) {
        if (!skinScan.scores[key]) return;
        var item = document.createElement('div');
        item.className = 'pc-plan-score';
        item.setAttribute('data-scan-score', key);
        var icon = document.createElement('span');
        icon.className = 'pc-plan-score__icon';
        icon.innerHTML = '<i class="fas ' + scoreIcons[key] + '" aria-hidden="true"></i>';
        var body = document.createElement('div');
        var name = document.createElement('strong');
        name.className = 'pc-plan-score__name';
        name.textContent = names[key] || key;
        var score = document.createElement('span');
        score.className = 'pc-plan-score__value';
        score.textContent = String(skinScan.scores[key].ui_score || '—');
        var level = document.createElement('small');
        level.className = 'pc-plan-score__level';
        level.textContent = skinScan.scores[key].level || '';
        body.appendChild(name);
        body.appendChild(score);
        body.appendChild(level);
        item.appendChild(icon);
        item.appendChild(body);
        scoreList.appendChild(item);
      });
      scoreList.hidden = false;
    }

    if (skinScan.skin_age) {
      var age = root.querySelector('[data-scan-age]');
      if (age) {
        age.textContent = {{ settings.skin_scan_age_label | default: 'Tuổi da tham khảo: ' | json }} + skinScan.skin_age;
        age.hidden = false;
      }
    }

    if (skinScan.regimen && skinScan.regimen.length) {
      rec.innerHTML = '';
      // regimen = 3 câu mô tả giai đoạn theo thứ tự ⇒ badge thứ i mở danh mục của giai đoạn i+1.
      skinScan.regimen.forEach(function (stage, index) {
        renderBadge(stage, stageCollectionKey(index + 1));
      });
    }
  }

  // 2026-10-09: nút mỗi thẻ giai đoạn mở danh mục tự động. Thay link sản phẩm cũ theo recommended_products
  // (skin-routine-matcher.js) — các handle đó (sua-rua-mat-amino-acid, serum-vitamin-c-15…) không có trên
  // Sapo nên link bị chuyển về trang chủ.
  [1, 2, 3].forEach(function (stage) {
    var slot = root.querySelector('[data-scan-stage-products="' + stage + '"]');
    var key = stageCollectionKey(stage);
    var c = collectionFor(key);
    if (!slot || !c) return;
    var link = document.createElement('a');
    link.className = 'pc-kit-btn-secondary px-4 py-2 text-xs inline-flex items-center gap-1.5';
    link.href = c.url;
    link.title = c.title;
    link.setAttribute('data-result-collection', key);
    link.textContent = {{ settings.skin_result_stage_cta_label | default: 'Xem sản phẩm giai đoạn này' | json }} + ' (' + c.count + ')';
    slot.innerHTML = '';
    slot.appendChild(link);
    slot.hidden = false;
  });

  // ── 2026-10-05: KẾT QUẢ KHẢO SÁT THEO CASE (assets/skin-quiz-engine.js.bwt + quiz_results_data.cases) ──
  // Sản phẩm từng bước lấy THẬT từ Sapo qua /search?view=quizjson (không ghi cứng tên/giá); bước có hoạt
  // chất bị loại theo cờ an toàn (thai kỳ, dị ứng nặng) chỉ hiện nhãn "cần chuyên gia chỉ định riêng".
  function renderQuizCase() {
    var alertBox = root.querySelector('[data-quiz-alert]');
    var routineBox = root.querySelector('[data-quiz-routine]');
    if (!quizResult || skinScan || !routineBox || !alertBox) return;

    var stageGrid = root.querySelector('[data-stage-section]');
    if (stageGrid) stageGrid.hidden = true;

    function addNote(text, modifier) {
      if (!text) return;
      var p = document.createElement('p');
      p.className = 'pc-quiz-alert__note' + (modifier ? ' pc-quiz-alert__note--' + modifier : '');
      p.textContent = text;
      alertBox.appendChild(p);
      alertBox.hidden = false;
    }
    function addZalo() {
      var a = document.createElement('a');
      a.className = 'pc-quiz-alert__cta';
      a.href = safety.zaloUrl || '/dat-lich-tu-van';
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = safety.zaloLabel || 'Liên hệ chuyên gia qua Zalo';
      alertBox.appendChild(a);
    }

    if (quizResult.tier === 1) {
      addNote(safety.redFlagText, 'danger');
      addZalo();
      var recWrap = rec && rec.parentElement;
      if (recWrap) recWrap.hidden = true;
      var productsSection = root.querySelector('[data-result-products-section]');
      if (productsSection) productsSection.hidden = true;
      return;
    }

    var flags = quizResult.safety_flags || [];
    if (quizResult.tier === 2) addNote(safety.tier2Note, 'warn');
    if (flags.indexOf('pregnancy') !== -1) addNote(safety.pregnancyNote, 'warn');
    if (flags.indexOf('allergy_severe') !== -1) addNote(safety.allergyNote, 'warn');
    if (!alertBox.hidden) addZalo();

    var caseData = quizCase && engine ? engine.applySafety(quizCase, excluded) : quizCase;
    if (!caseData) return;

    // Ghi chú cách dùng của bước đã bị ẩn (vd Cyspera khi mang thai) cũng ẩn theo.
    var noteBlocked = (caseData.note_actives || []).some(function (a) { return excluded.indexOf(a) !== -1; });
    if (caseData.note && !noteBlocked) {
      var note = document.createElement('p');
      note.className = 'pc-quiz-routine__note';
      note.textContent = caseData.note;
      routineBox.appendChild(note);
    }
    [['routine_am', 'Buổi sáng'], ['routine_pm', 'Buổi tối']].forEach(function (pair) {
      var steps = caseData[pair[0]] || [];
      if (!steps.length) return;
      var col = document.createElement('div');
      col.className = 'pc-quiz-routine__col';
      var h = document.createElement('h4');
      h.className = 'pc-quiz-routine__title';
      h.textContent = pair[1];
      col.appendChild(h);
      var list = document.createElement('ol');
      list.className = 'pc-quiz-routine__list';
      steps.forEach(function (step) {
        var li = document.createElement('li');
        li.className = 'pc-quiz-step' + (step.blocked ? ' pc-quiz-step--blocked' : '');
        li.setAttribute('data-quiz-step', '');
        var name = document.createElement('span');
        name.className = 'pc-quiz-step__name';
        name.textContent = step.step;
        li.appendChild(name);
        var slot = document.createElement('div');
        slot.className = 'pc-quiz-step__product';
        li.appendChild(slot);
        if (step.blocked) {
          slot.textContent = safety.blockedStepLabel || 'Cần chuyên gia chỉ định riêng';
          li.setAttribute('data-quiz-step-blocked', '');
        } else {
          fillStepProduct(step, slot);
        }
        list.appendChild(li);
      });
      col.appendChild(list);
      routineBox.appendChild(col);
    });
    routineBox.hidden = false;
  }

  var quizSearchCache = {};
  function searchProducts(keyword) {
    if (!quizSearchCache[keyword]) {
      quizSearchCache[keyword] = window.fetch('/search?type=product&view=quizjson&query=' + encodeURIComponent(keyword), { credentials: 'same-origin' })
        .then(function (res) { return res.ok ? res.json() : []; })
        .catch(function () { return []; });
    }
    return quizSearchCache[keyword];
  }

  function fillStepProduct(step, slot) {
    var keywords = (step.keywords || []).slice();
    function next() {
      if (!keywords.length) {
        var link = document.createElement('a');
        link.className = 'pc-quiz-step__search';
        link.href = '/search?query=' + encodeURIComponent((step.keywords || [step.step])[0]);
        link.textContent = safety.noProductLabel || 'Tìm sản phẩm phù hợp';
        slot.appendChild(link);
        return;
      }
      var kw = keywords.shift();
      searchProducts(kw).then(function (items) {
        var pick = (items || []).filter(function (p) {
          return p && p.url && (!engine || engine.isProductAllowed(p, excluded));
        })[0];
        if (!pick) { next(); return; }
        var a = document.createElement('a');
        a.className = 'pc-quiz-step__link';
        a.href = pick.url;
        a.setAttribute('data-quiz-step-product', pick.alias || '');
        if (pick.image) {
          var img = document.createElement('img');
          img.src = pick.image;
          img.alt = pick.name || '';
          img.width = 48;
          img.height = 48;
          img.loading = 'lazy';
          a.appendChild(img);
        }
        var text = document.createElement('span');
        text.className = 'pc-quiz-step__text notranslate';
        text.setAttribute('translate', 'no');
        text.textContent = pick.name || '';
        a.appendChild(text);
        if (pick.price) {
          var price = document.createElement('span');
          price.className = 'pc-quiz-step__price';
          price.textContent = pick.price;
          a.appendChild(price);
        }
        slot.appendChild(a);
      });
    }
    next();
  }

  renderQuizCase();

  // ── 2026-10-10: 3 GIAI ĐOẠN PHÁC ĐỒ + DẢI SẢN PHẨM (thiết kế design/ket-qua-da/dinh-huong-phac-do.png) ──
  // Mỗi giai đoạn: số 01–03, tiêu đề (câu giai đoạn của soi da; khảo sát dùng tiêu đề cấu hình), mô tả, dải SP thật của
  // danh mục giai đoạn (bỏ kê toa + hoạt chất bị loại theo cờ an toàn), "Xem tất cả" → danh mục.
  var planCopy = {
    titles: [
      {{ settings.skin_plan_stage_1_title | default: 'Làm dịu: làm sạch dịu nhẹ' | json }},
      {{ settings.skin_plan_stage_2_title | default: 'Phục hồi: củng cố hàng rào da' | json }},
      {{ settings.skin_plan_stage_3_title | default: 'Chăm sóc chuyên sâu: cân nhắc hoạt chất cùng chuyên gia' | json }}
    ],
    descs: [
      {{ settings.skin_plan_stage_1_desc | default: 'Làm sạch nhẹ nhàng, giảm kích ứng, đưa da về trạng thái cân bằng.' | json }},
      {{ settings.skin_plan_stage_2_desc | default: 'Tăng cường hàng rào bảo vệ da, cấp ẩm sâu và hỗ trợ phục hồi da khỏe mạnh.' | json }},
      {{ settings.skin_plan_stage_3_desc | default: 'Các hoạt chất đặc trị giúp cải thiện mụn, sắc tố, lỗ chân lông… nên được tư vấn bởi chuyên gia để phù hợp với tình trạng da của bạn.' | json }}
    ],
    viewAll: {{ settings.skin_plan_view_all_label | default: 'Xem tất cả' | json }},
    addLabel: {{ settings.skin_plan_add_label | default: 'Thêm vào phác đồ' | json }},
    addedLabel: {{ settings.skin_plan_added_label | default: 'Đã thêm vào giỏ' | json }},
    detailLabel: {{ settings.skin_plan_detail_label | default: 'Xem chi tiết' | json }}
  };
  function planTags(p) {
    // Nhãn ngắn từ tag SP (bỏ tag kỹ thuật dạng khoá:giá trị / có "_"), tối đa 2.
    return (p.tags || []).filter(function (t) {
      return t && t.indexOf(':') === -1 && t.indexOf('_') === -1 && t.length <= 24 && !/^(ban-chay|khuyen-mai|san-pham-noi-bat|serum|chuyen-nghiep)$/.test(t);
    }).slice(0, 2).map(function (t) { var s = t.replace(/-/g, ' '); return s.charAt(0).toUpperCase() + s.slice(1); });
  }
  function readWishlist() {
    try { return (window.Cookies && window.Cookies.getJSON('sudes_wishlist_products')) || []; } catch (e) { return []; }
  }
  function toggleWish(handle, btn) {
    if (!window.Cookies) { window.location.href = '/' + handle; return; }
    var list = readWishlist();
    if (list.indexOf(handle) !== -1) {
      if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.removeWishlist) favoriBean.Wishlist.removeWishlist(handle);
      else window.Cookies.set('sudes_wishlist_products', list.filter(function (h) { return h !== handle; }), { expires: 15, sameSite: 'None', secure: true });
      btn.classList.remove('is-active');
      btn.setAttribute('aria-pressed', 'false');
    } else {
      list.unshift(handle);
      window.Cookies.set('sudes_wishlist_products', list.slice(0, 100), { expires: 15, sameSite: 'None', secure: true });
      if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.wishlistProduct) favoriBean.Wishlist.wishlistProduct();
      if (window.theme && theme.alert && theme.alert.new) theme.alert.new('Thêm vào danh sách yêu thích', 'Bạn đã thêm sản phẩm vào danh sách yêu thích.', 3000, 'alert-success');
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
    }
  }
  function addToPlan(p, btn) {
    // Thêm vào giỏ giống luồng thẻ SP của theme (/cart/add.js → ajaxCart.load + toast giỏ hàng).
    btn.disabled = true;
    window.fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'quantity=1&variantId=' + encodeURIComponent(p.variant_id)
    }).then(function (res) { if (!res.ok) throw new Error('cart'); return res.json(); }).then(function (item) {
      if (window.ajaxCart && typeof ajaxCart.load === 'function') ajaxCart.load();
      if (typeof window.AddCartMobile === 'function') window.AddCartMobile(item);
      document.querySelectorAll('.popup-cart-mobile').forEach(function (el) { el.classList.add('active'); });
      btn.querySelector('span').textContent = planCopy.addedLabel;
      btn.classList.add('is-added');
    }).catch(function () { window.location.href = p.url; }).then(function () { btn.disabled = false; });
  }
  function planCard(p, wish) {
    var card = document.createElement('article');
    card.className = 'pc-plan-card';
    card.setAttribute('data-plan-product', p.alias || '');
    var media = document.createElement('a');
    media.className = 'pc-plan-card__media';
    media.href = p.url;
    var img = document.createElement('img');
    img.src = (p.featured_image && p.featured_image.src) || '{% include 'placeholder_img_url' %}';
    img.alt = p.name || '';
    img.width = 240; img.height = 240; img.loading = 'lazy';
    media.appendChild(img);
    card.appendChild(media);
    var heart = document.createElement('button');
    heart.type = 'button';
    heart.className = 'pc-plan-card__wish' + (wish.indexOf(p.alias) !== -1 ? ' is-active' : '');
    heart.setAttribute('aria-label', 'Yêu thích ' + (p.name || ''));
    heart.setAttribute('aria-pressed', String(wish.indexOf(p.alias) !== -1));
    heart.innerHTML = '<i class="far fa-heart" aria-hidden="true"></i><i class="fas fa-heart" aria-hidden="true"></i>';
    heart.addEventListener('click', function () { toggleWish(p.alias, heart); });
    card.appendChild(heart);
    var body = document.createElement('div');
    body.className = 'pc-plan-card__body';
    if (p.vendor) {
      var brand = document.createElement('span');
      brand.className = 'pc-plan-card__brand notranslate';
      brand.setAttribute('translate', 'no');
      brand.textContent = p.vendor;
      body.appendChild(brand);
    }
    var name = document.createElement('a');
    name.className = 'pc-plan-card__name notranslate';
    name.setAttribute('translate', 'no');
    name.href = p.url;
    name.textContent = p.name || '';
    body.appendChild(name);
    var tags = planTags(p);
    if (tags.length) {
      var chips = document.createElement('div');
      chips.className = 'pc-plan-card__chips';
      tags.forEach(function (t) { var c = document.createElement('span'); c.textContent = t; chips.appendChild(c); });
      body.appendChild(chips);
    }
    var price = document.createElement('div');
    price.className = 'pc-plan-card__price';
    price.textContent = p.price ? new Intl.NumberFormat('vi-VN').format(p.price) + '₫' : 'Liên hệ';
    if (p.compare_at_price && p.compare_at_price > p.price) {
      var old = document.createElement('s');
      old.textContent = new Intl.NumberFormat('vi-VN').format(p.compare_at_price) + '₫';
      price.appendChild(old);
    }
    body.appendChild(price);
    var btn;
    if (p.variant_id) {
      btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = '<i class="fas fa-cart-shopping" aria-hidden="true"></i> <span></span>';
      btn.querySelector('span').textContent = planCopy.addLabel;
      btn.addEventListener('click', function () { addToPlan(p, btn); });
    } else {
      btn = document.createElement('a');
      btn.href = p.url;
      btn.textContent = planCopy.detailLabel;
    }
    btn.className = 'pc-plan-card__btn';
    btn.setAttribute('data-plan-add', '');
    body.appendChild(btn);
    card.appendChild(body);
    return card;
  }
  function bindCarousel(row) {
    var track = row.querySelector('.pc-plan-stage__track');
    var dots = row.querySelector('.pc-plan-stage__dots');
    var prev = row.querySelector('[data-plan-prev]');
    var next = row.querySelector('[data-plan-next]');
    function pages() { return Math.max(1, Math.ceil((track.scrollWidth - 4) / track.clientWidth)); }
    function current() { return Math.round(track.scrollLeft / Math.max(1, track.clientWidth)); }
    function sync() {
      var n = pages();
      if (dots.children.length !== n) {
        dots.innerHTML = '';
        for (var i = 0; i < n; i++) dots.appendChild(document.createElement('span'));
      }
      var c = current();
      Array.prototype.forEach.call(dots.children, function (d, i) { d.classList.toggle('is-active', i === c); });
      var many = n > 1;
      prev.hidden = next.hidden = dots.hidden = !many;
      prev.disabled = c <= 0;
      next.disabled = c >= n - 1;
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(sync); }, { passive: true });
    window.addEventListener('resize', sync);
    window.addEventListener('load', sync); // ảnh/phông tải xong có thể đổi bề rộng
    sync();
  }
  var planStagesRendered = 0;
  function renderPlanStages() {
    var wrap = root.querySelector('[data-plan-stages]');
    if (!wrap || quizCase || (quizResult && quizResult.tier === 1)) {
      // Không có dải giai đoạn (khảo sát theo Case dùng routine sáng/tối) ⇒ cột phải trải ngang, 2 hộp đứng cạnh nhau.
      var layout = root.querySelector('.pc-plan__layout');
      if (layout) layout.classList.add('pc-plan__layout--compact');
      return;
    }
    var wish = readWishlist();
    var regimen = (skinScan && skinScan.regimen) || [];
    wrap.hidden = false; // hiện trước khi đo carousel (đang ẩn thì clientWidth = 0 ⇒ không tính được số trang)
    [1, 2, 3].forEach(function (stage) {
      var key = stageCollectionKey(stage);
      var c = collectionFor(key);
      var items = (c && c.products ? c.products : []).filter(function (p) { return !engine || engine.isProductAllowed(p, excluded); });
      var row = document.createElement('section');
      row.className = 'pc-plan-stage pc-plan-stage--' + stage;
      row.setAttribute('data-plan-stage', String(stage));
      var intro = document.createElement('div');
      intro.className = 'pc-plan-stage__intro';
      var num = document.createElement('span');
      num.className = 'pc-plan-stage__num';
      num.textContent = '0' + stage;
      var title = document.createElement('h4');
      title.className = 'pc-plan-stage__title';
      title.textContent = regimen[stage - 1] || planCopy.titles[stage - 1];
      var desc = document.createElement('p');
      desc.className = 'pc-plan-stage__desc';
      desc.textContent = planCopy.descs[stage - 1];
      intro.appendChild(num); intro.appendChild(title); intro.appendChild(desc);
      row.appendChild(intro);
      var shelf = document.createElement('div');
      shelf.className = 'pc-plan-stage__shelf';
      if (c) {
        var all = document.createElement('a');
        all.className = 'pc-plan-stage__all';
        all.href = c.url;
        all.setAttribute('data-plan-view-all', key);
        all.innerHTML = '<span></span> <i class="fas fa-arrow-right" aria-hidden="true"></i>';
        all.querySelector('span').textContent = planCopy.viewAll;
        shelf.appendChild(all);
      }
      if (items.length) {
        shelf.insertAdjacentHTML('beforeend', '<button type="button" class="pc-plan-stage__nav pc-plan-stage__nav--prev" data-plan-prev aria-label="Sản phẩm trước"><i class="fas fa-chevron-left" aria-hidden="true"></i></button>' +
          '<div class="pc-plan-stage__track"></div>' +
          '<button type="button" class="pc-plan-stage__nav pc-plan-stage__nav--next" data-plan-next aria-label="Sản phẩm sau"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>' +
          '<div class="pc-plan-stage__dots" aria-hidden="true"></div>');
        var track = shelf.querySelector('.pc-plan-stage__track');
        items.forEach(function (p) { track.appendChild(planCard(p, wish)); });
      }
      row.appendChild(shelf);
      wrap.appendChild(row);
      if (items.length) { bindCarousel(row); planStagesRendered++; }
    });
  }
  renderPlanStages();

  // ── ĐỒNG BỘ THÔNG TIN KHÁCH HÀNG TỪ GAS HOẶC CONTEXT ────────────────────
  var sessionSourceText = (skinScan && skinScan.scores) ? 'Soi da AI 3 góc' : (!isDemo ? 'Khảo sát dạng chat 17 câu' : '');
  function syncCustomerInfo() {
    var custNameEl = root.querySelector('[data-customer-name]');
    var custContactEl = root.querySelector('[data-customer-contact]');
    var custTierEl = root.querySelector('[data-customer-tier]');
    var consultSourceEl = root.querySelector('[data-consultation-source]');
    var consultDateEl = root.querySelector('[data-consultation-date]');
    var crmStatusBadge = root.querySelector('[data-crm-status-badge]');
    var crmStorageState = root.querySelector('[data-crm-storage-state]');
    var crmSubmissionIdEl = root.querySelector('[data-crm-submission-id]');

    // Kiểm tra qua crm-intake
    if (window.PharmaCrmIntake && typeof window.PharmaCrmIntake.getCustomerInfo === 'function') {
      window.PharmaCrmIntake.getCustomerInfo().then(function (info) {
        renderCustomerState(info);
        updateProfilePrompt(!!info.stored_in_gas, !!info.profile_exists);
        if (isDemo) {
          // Thiết bị chưa có kết quả: hồ sơ CRM đầy đủ (khớp mã của thiết bị) ⇒ dựng lại kết quả; tài khoản đã có
          // hồ sơ nhưng GAS không trả dữ liệu (tra theo tài khoản) ⇒ chỉ đổi lời nhắn.
          if (info.stored_in_gas && info.consultation && hydrateFromCrm(info)) return;
          if (info.profile_exists) root.querySelector('[data-result-empty-text]').textContent = emptyCopy.existsText;
        }
      }).catch(function () {
        renderFallbackCustomerState();
        updateProfilePrompt(false, false);
      });
    } else {
      renderFallbackCustomerState();
      updateProfilePrompt(false, false);
    }

    function renderCustomerState(info) {
      var customer = info.customer || {};
      var displayName = customer.name || (customer.logged_in ? 'Khách Hàng Thành Viên' : 'Khách Hàng Tư Vấn');
      if (custNameEl) custNameEl.textContent = displayName;

      var contactInfo = customer.phone || customer.email || (customer.logged_in ? 'Tài khoản Pharma Cosmetics' : 'Chưa đăng nhập');
      if (custContactEl) custContactEl.textContent = contactInfo;
      if (custTierEl) custTierEl.textContent = customer.logged_in ? 'Thành viên chính thức' : 'Khách vãng lai';

      // 2026-10-08: ưu tiên nguồn của phiên đang xem (soi da / khảo sát chat), CRM chỉ là dự phòng.
      var sourceText = sessionSourceText || (info.source === 'ai_skin_scan_camera' ? 'Soi da AI 3 góc' : (info.source === 'ai_skin_quiz' ? 'Khảo sát dạng chat 17 câu' : 'Bản xem trước mẫu'));
      if (consultSourceEl) consultSourceEl.textContent = sourceText;
      if (consultDateEl) {
        var d = info.saved_at ? new Date(info.saved_at) : new Date();
        consultDateEl.textContent = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
      }

      if (info.stored_in_gas) {
        if (crmStatusBadge) {
          crmStatusBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
          crmStatusBadge.innerHTML = '<i class="fas fa-circle-check text-emerald-600"></i> Đã lưu CRM Google Sheets';
        }
        if (crmStorageState) crmStorageState.textContent = 'Đã đồng bộ';
        if (crmSubmissionIdEl) crmSubmissionIdEl.textContent = 'Mã bản ghi: ' + (info.record_id || 'CRM-' + Date.now());
      } else {
        if (crmStatusBadge) {
          crmStatusBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300';
          crmStatusBadge.innerHTML = '<i class="fas fa-clock-rotate-left text-amber-600"></i> Bản ghi phiên hiện tại';
        }
        if (crmStorageState) crmStorageState.textContent = 'Chưa lưu CRM';
        if (crmSubmissionIdEl) crmSubmissionIdEl.textContent = 'Chưa cấp mã lưu';
      }
    }

    function renderFallbackCustomerState() {
      var ctx = window.PharmaCrmCustomerContext || {};
      if (custNameEl) custNameEl.textContent = ctx.name || 'Khách Hàng Tư Vấn';
      if (custContactEl) custContactEl.textContent = ctx.phone || ctx.email || 'Chưa đăng nhập';
      if (custTierEl) custTierEl.textContent = ctx.logged_in ? 'Thành viên' : 'Khách vãng lai';
      if (consultSourceEl) consultSourceEl.textContent = sessionSourceText || 'Bản xem trước mẫu';
      if (crmStatusBadge) {
        crmStatusBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300';
        crmStatusBadge.innerHTML = '<i class="fas fa-clock-rotate-left text-amber-600"></i> Bản ghi phiên hiện tại';
      }
      if (crmStorageState) crmStorageState.textContent = 'Chưa lưu CRM';
    }
  }

  // 2026-10-10: dựng lại kết quả từ bản ghi CRM (GAS chỉ trả đủ khi khớp submission_id/session_id của thiết bị) rồi
  // tải lại trang. Cờ sessionStorage chặn vòng lặp tải lại nếu bản ghi không đủ dữ liệu.
  function hydrateFromCrm(info) {
    var store = window.PharmaResultStore;
    if (!store) return false;
    try {
      if (sessionStorage.getItem('pc_crm_hydrated')) return false;
      sessionStorage.setItem('pc_crm_hydrated', '1');
    } catch (e) { return false; }
    var rec = info.consultation || {};
    var savedAt = Date.parse(rec.created_at) || Date.now();
    var sc = (rec.scores && typeof rec.scores === 'object') ? rec.scores : {};
    if (info.source === 'ai_skin_scan_camera' && sc.acne) {
      store.set('pc_skin_scan_result', JSON.stringify({
        saved_at: savedAt, scores: sc, skin_type: rec.skin_type, skin_age: rec.skin_age, primary_concern: rec.primary_concern,
        regimen: rec.regimen || [], recommended_products: rec.recommended_products || [], source: 'crm'
      }));
    } else {
      // Khảo sát: scores = { skin_type: 'oily' } (lưu từ trang kết quả) hoặc số điểm theo từng loại da (lưu từ trang chat).
      var key = (typeof sc.skin_type === 'string' && sc.skin_type !== 'cases' && resultsData[sc.skin_type]) ? sc.skin_type : null;
      if (!key) {
        Object.keys(sc).forEach(function (k) {
          if (k !== 'cases' && resultsData[k] && typeof sc[k] === 'number' && (key === null || sc[k] > sc[key])) key = k;
        });
      }
      if (!key) return false;
      store.set('pc_quiz_skin_type', key);
      store.set('pc_quiz_saved_at', String(savedAt));
    }
    if (info.record_id) {
      store.set('pc_crm_intake_record_id', String(info.record_id));
      store.set('pc_crm_saved_at', new Date(savedAt).toISOString());
    }
    window.location.reload();
    return true;
  }

  // ── 2026-10-10: MỜI TẠO HỒ SƠ (sau khi tra GAS) ─────────────────────────
  var isLoggedIn = !!(window.PharmaCrmCustomerContext && window.PharmaCrmCustomerContext.logged_in);
  var profileCopy = {
    text: {{ settings.skin_profile_prompt_text | default: 'Tạo hồ sơ để lưu kết quả này, chuyên gia theo dõi tiến triển và tư vấn 1:1 đúng với làn da của bạn.' | json }},
    existsText: {{ settings.skin_profile_prompt_exists_text | default: 'Tài khoản của bạn đã có hồ sơ chăm sóc da. Lưu thêm kết quả lần này để chuyên gia so sánh tiến triển.' | json }},
    loginText: {{ settings.skin_profile_prompt_login_text | default: 'Đăng nhập hoặc đăng ký tài khoản để tạo hồ sơ — kết quả vẫn được giữ trên thiết bị này để lưu ngay sau khi đăng nhập.' | json }},
    saveLabel: {{ settings.skin_profile_save_label | default: 'Lưu hồ sơ ngay' | json }},
    loginLabel: {{ settings.skin_profile_login_label | default: 'Đăng nhập để lưu hồ sơ' | json }},
    clearConfirm: {{ settings.skin_result_clear_confirm | default: 'Xoá kết quả soi da / khảo sát đang lưu trên thiết bị này?' | json }}
  };
  function requestSave() {
    // Khách vãng lai phải đăng nhập mới tạo hồ sơ (kết quả đã nằm trong PharmaResultStore nên không mất).
    if (!isLoggedIn) {
      if (window.PharmaResultStore) window.PharmaResultStore.goLoginToSave(window.location.pathname);
      else window.location.href = '/account/login';
      return;
    }
    openSaveModal();
  }
  function updateProfilePrompt(storedInGas, profileExists) {
    var box = root.querySelector('[data-profile-prompt]');
    if (!box) return;
    if (isDemo || storedInGas) { box.hidden = true; return; }
    box.querySelector('[data-profile-prompt-text]').textContent = !isLoggedIn ? profileCopy.loginText : (profileExists ? profileCopy.existsText : profileCopy.text);
    box.querySelector('[data-profile-prompt-action]').textContent = isLoggedIn ? profileCopy.saveLabel : profileCopy.loginLabel;
    box.hidden = false;
  }
  var promptAction = root.querySelector('[data-profile-prompt-action]');
  if (promptAction) promptAction.addEventListener('click', requestSave);

  // Xoá kết quả trên thiết bị (máy dùng chung) — chỉ hiện khi đang xem kết quả thật.
  var clearBtn = root.querySelector('[data-result-clear]');
  if (clearBtn && !isDemo) {
    clearBtn.hidden = false;
    clearBtn.addEventListener('click', function () {
      if (!window.confirm(profileCopy.clearConfirm)) return;
      resultStore.clearAll();
      window.location.reload();
    });
  }

  // 2026-10-10: crm-intake.js nạp defer ⇒ lúc script nội tuyến này chạy window.PharmaCrmIntake CHƯA có, nên trước đây
  // trang kết quả không bao giờ tra GAS khi mở (chỉ tra lại sau khi bấm lưu). Chờ DOMContentLoaded (sau script defer).
  if (window.PharmaCrmIntake || document.readyState !== 'loading') syncCustomerInfo();
  else document.addEventListener('DOMContentLoaded', syncCustomerInfo);

  // ── RENDER SECTION 1: SẢN PHẨM SAPO PHÙ HỢP ─────────────────────────────
  function renderMatchedSapoProducts() {
    var grid = root.querySelector('[data-sapo-products-grid]');
    if (!grid) return;
    grid.innerHTML = '';

    var activeSkin = basisSkin().toLowerCase();
    var keywords = [];

    // 2026-10-08: ghi rõ gợi ý dựa trên kết quả nào (soi da AI vừa làm / khảo sát chat / minh hoạ).
    var basisEl = root.querySelector('[data-products-basis]');
    if (basisEl) {
      if (skinScan && skinScan.scores) {
        basisEl.textContent = 'Theo kết quả soi da AI vừa thực hiện — vấn đề trọng tâm: ' + (scanConcernNames[skinScan.primary_concern] || 'chăm sóc nền da');
      } else if (!isDemo) {
        basisEl.textContent = 'Theo kết quả khảo sát dạng chat — ' + ((quizCase && quizCase.title) || (resultsData[skinType] && resultsData[skinType].skin_type) || 'loại da của bạn');
      } else {
        basisEl.textContent = 'Gợi ý minh hoạ — hãy soi da AI hoặc làm khảo sát để nhận sản phẩm theo làn da của bạn';
      }
      basisEl.hidden = false;
    }

    if (activeSkin.includes('combination')) {
      keywords = ['kiem-soat-dau', 'niacinamide', 'duong-am', 'amino-acid', 'chong-nang'];
    } else if (activeSkin.includes('oily') || activeSkin.includes('dau') || activeSkin.includes('mun')) {
      keywords = ['tri-mun', 'kiem-soat-dau', 'bha', 'aha', 'niacinamide', 'amino-acid', 'spf50'];
    } else if (activeSkin.includes('dry') || activeSkin.includes('kho')) {
      keywords = ['duong-am', 'hyaluronic', 'ceramide', 'phuc-hoi', 'amino-acid'];
    } else if (activeSkin.includes('pigment') || activeSkin.includes('nam') || activeSkin.includes('sac-to')) {
      keywords = ['tri-nam', 'tranexamic', 'vitamin-c', 'lam-sang', 'chong-nang'];
    } else if (activeSkin.includes('aging') || activeSkin.includes('lao-hoa') || activeSkin.includes('nhan')) {
      keywords = ['chong-lao-hoa', 'retinol', 'peptide', 'collagen', 'kem-mat'];
    } else if (activeSkin.includes('sensitive') || activeSkin.includes('nhay-cam') || activeSkin.includes('do')) {
      keywords = ['phuc-hoi', 'ceramide', 'centella', 'amino-acid', 'chong-nang'];
    } else {
      keywords = ['ban-chay', 'san-pham-noi-bat', 'duong-am', 'lam-sach-da'];
    }

    // 2026-10-05: bỏ sản phẩm kê toa (loai:ke-toa) và sản phẩm chứa hoạt chất bị loại theo cờ an toàn.
    var allowedProducts = allProducts.filter(function (p) {
      return !engine || engine.isProductAllowed(p, excluded);
    });
    // Lọc sản phẩm phù hợp
    var matched = allowedProducts.filter(function (p) {
      var tags = (p.tags || []).join(' ').toLowerCase();
      var name = (p.name || '').toLowerCase();
      var alias = (p.alias || '').toLowerCase();
      return keywords.some(function (k) {
        return tags.includes(k) || name.includes(k) || alias.includes(k);
      });
    });

    // Soi da: đưa đúng các sản phẩm phác đồ vừa chọn (recommended_products) lên đầu, rồi bổ sung theo từ khoá.
    if (skinScan && skinScan.recommended_products) {
      var routinePicks = [];
      skinScan.recommended_products.forEach(function (rp) {
        var handle = rp && (rp.handle || String(rp.url || '').replace(/^\//, ''));
        var hit = allowedProducts.filter(function (p) { return p.alias === handle; })[0];
        if (hit && routinePicks.indexOf(hit) === -1) routinePicks.push(hit);
      });
      matched = routinePicks.concat(matched.filter(function (p) { return routinePicks.indexOf(p) === -1; }));
    }

    // 2026-10-10: ưu tiên sản phẩm thật trong các danh mục tự động khớp badge hoạt chất / 3 giai đoạn (lần lượt mỗi
    // danh mục 1 SP để đủ nhóm) — trước đây chỉ dò tag trong 50 SP đầu của toàn cửa hàng nên gợi ý dễ lệch.
    var collectionKeys = [];
    root.querySelectorAll('[data-result-recommend] a[data-result-collection]').forEach(function (a) {
      collectionKeys.push(a.getAttribute('data-result-collection'));
    });
    collectionKeys.push(stageCollectionKey(3));
    // Nhóm chính = danh mục của badge + giai đoạn 3 (đặc trị); giai đoạn 1–2 (làm dịu / phục hồi) chỉ để bù chỗ trống.
    var pools = [];
    function addPool(k, filler) {
      var c = collectionFor(k);
      if (c && c.products && c.products.length && pools.every(function (p) { return p.key !== k; })) {
        pools.push({ key: k, url: c.url, filler: filler, items: c.products.filter(function (p) { return !engine || engine.isProductAllowed(p, excluded); }) });
      }
    }
    collectionKeys.forEach(function (k) { addPool(k, false); });
    [2, 1].forEach(function (st) { addPool(stageCollectionKey(st), true); });
    var picked = [];
    [false, true].forEach(function (fillerPass) {
      for (var round = 0; picked.length < 4 && round < 8; round++) {
        pools.forEach(function (pool) {
          if (pool.filler !== fillerPass) return;
          var p = pool.items[round];
          if (p && picked.length < 4 && picked.every(function (x) { return x.alias !== p.alias; })) picked.push(p);
        });
      }
    });
    var allLink = root.querySelector('[data-products-all-link]');
    if (picked.length) {
      matched = picked;
      if (allLink && pools[0]) allLink.href = pools[0].url;
    }

    if (matched.length === 0) matched = allowedProducts.slice(0, 4);
    else if (matched.length > 4) matched = matched.slice(0, 4);

    matched.forEach(function (prod) {
      var card = document.createElement('div');
      card.className = 'group flex flex-col bg-white rounded-xl sm:rounded-2xl border border-gray-200/90 overflow-hidden shadow-xs hover:shadow-md hover:border-emerald-300 transition-all duration-300';

      var imgSrc = (prod.featured_image && prod.featured_image.src) || (prod.images && prod.images[0] && prod.images[0].src) || '{% include 'placeholder_img_url' %}';
      var formattedPrice = prod.price ? new Intl.NumberFormat('vi-VN').format(prod.price) + ' ₫' : 'Liên hệ';
      var comparePrice = prod.compare_at_price && prod.compare_at_price > prod.price ? new Intl.NumberFormat('vi-VN').format(prod.compare_at_price) + ' ₫' : '';

      var tagBadge = (prod.tags && prod.tags[0]) ? prod.tags[0].replace(/-/g, ' ').toUpperCase() : 'CHUẨN Y KHOA';

      card.innerHTML = `
        <div class="relative aspect-square overflow-hidden bg-gray-50 border-b border-gray-100">
          <span class="absolute top-2 left-2 z-10 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-emerald-600/90 text-white tracking-wider backdrop-blur-xs">
            ${tagBadge}
          </span>
          <a href="${prod.url || '/' + prod.alias}" class="block w-full h-full">
            <img src="${imgSrc}" alt="${prod.name}" width="400" height="400" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          </a>
        </div>
        <div class="p-3.5 sm:p-4 flex flex-col flex-1 justify-between gap-3">
          <div>
            <h4 class="font-bold text-xs sm:text-sm text-gray-900 group-hover:text-emerald-700 line-clamp-2 leading-snug notranslate" translate="no">
              <a href="${prod.url || '/' + prod.alias}">${prod.name}</a>
            </h4>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-sm sm:text-base font-extrabold text-emerald-700">${formattedPrice}</span>
              ${comparePrice ? `<span class="text-xs text-gray-400 line-through">${comparePrice}</span>` : ''}
            </div>
          </div>
          <a href="${prod.url || '/' + prod.alias}" class="w-full text-center py-2 px-3 rounded-lg text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 transition-colors shadow-xs">
            Xem Chi Tiết
          </a>
        </div>
      `;
      grid.appendChild(card);
    });
  }

  renderMatchedSapoProducts();
  // Soi da: hàng badge chỉ lặp lại 3 câu giai đoạn (đã là tiêu đề 3 giai đoạn) ⇒ ẩn hàng hiển thị, giữ link trong DOM.
  var activesRow = root.querySelector('.pc-plan__actives');
  if (activesRow && skinScan && skinScan.scores && planStagesRendered) activesRow.hidden = true;
  if (planStagesRendered) {
    var productsSectionEl = root.querySelector('[data-result-products-section]');
    if (productsSectionEl) productsSectionEl.hidden = true;
  }

  // ── RENDER SECTION 2: BÀI VIẾT CHUYÊN GIA TỪ SAPO BLOG ──────────────────
  function renderMatchedSapoArticles() {
    var grid = root.querySelector('[data-sapo-articles-grid]');
    if (!grid) return;
    grid.innerHTML = '';

    var activeSkin = basisSkin().toLowerCase();
    var topicKeywords = [];

    if (activeSkin.includes('oily') || activeSkin.includes('dau') || activeSkin.includes('mun')) {
      topicKeywords = ['mun', 'dau', 'niacinamide', 'cleansing', 'kem nen'];
    } else if (activeSkin.includes('dry') || activeSkin.includes('kho')) {
      topicKeywords = ['hanh kho', 'duong am', 'routine', 'ban dem'];
    } else if (activeSkin.includes('pigment') || activeSkin.includes('nam') || activeSkin.includes('sac-to')) {
      topicKeywords = ['nam', 'vitamin c', 'tham'];
    } else if (activeSkin.includes('aging') || activeSkin.includes('lao-hoa') || activeSkin.includes('nhan')) {
      topicKeywords = ['retinol', 'chong nang', 'lao hoa', 'spf'];
    } else {
      topicKeywords = ['skincare', 'routine', 'phuc hoi', 'lam sach'];
    }

    var matched = allArticles.filter(function (art) {
      var title = (art.title || '').toLowerCase();
      var tags = (art.tags || []).join(' ').toLowerCase();
      var excerpt = (art.excerpt || '').toLowerCase();
      return topicKeywords.some(function (k) {
        return title.includes(k) || tags.includes(k) || excerpt.includes(k);
      });
    });

    if (matched.length === 0) matched = allArticles.slice(0, 3);
    else if (matched.length > 3) matched = matched.slice(0, 3);

    matched.forEach(function (art) {
      var card = document.createElement('article');
      card.className = 'group flex flex-col bg-white rounded-xl sm:rounded-2xl border border-gray-200/90 overflow-hidden shadow-xs hover:shadow-md hover:border-teal-300 transition-all duration-300';

      var imgSrc = (art.image && art.image.src) || (art.featured_image && art.featured_image.src) || '{% include 'placeholder_img_url' %}';
      var publishDate = art.published_on ? new Date(art.published_on).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '2026';
      var author = art.author || 'Chuyên gia Pharma Cosmetics';

      card.innerHTML = `
        <a href="${art.url}" class="block relative aspect-video overflow-hidden bg-gray-50">
          <img src="${imgSrc}" alt="${art.title}" width="675" height="380" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded bg-teal-800/80 text-white backdrop-blur-xs">
            Y Khoa
          </span>
        </a>
        <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between gap-3">
          <div>
            <div class="flex items-center gap-2 text-[11px] text-gray-500 mb-2">
              <i class="far fa-calendar-alt text-teal-600"></i>
              <span>${publishDate}</span>
              <span>•</span>
              <span class="text-teal-800 font-semibold">${author}</span>
            </div>
            <h4 class="font-bold text-sm sm:text-base text-gray-900 group-hover:text-teal-700 line-clamp-2 leading-snug">
              <a href="${art.url}">${art.title}</a>
            </h4>
            <p class="mt-2 text-xs text-gray-600 line-clamp-2 leading-relaxed">
              ${art.excerpt || 'Đọc hướng dẫn lâm sàng chi tiết từ đội ngũ chuyên gia da liễu.'}
            </p>
          </div>
          <a href="${art.url}" class="text-xs font-bold text-teal-700 group-hover:text-teal-800 flex items-center gap-1.5 pt-2 border-t border-gray-100">
            <span>Đọc tiếp cẩm nang</span>
            <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>
      `;
      grid.appendChild(card);
    });
  }

  renderMatchedSapoArticles();

  // ── MODAL LƯU KẾT QUẢ VÀO CRM ───────────────────────────────────────────
  var modal = document.getElementById('aiSkinCrmConsentModal');
  var trigger = root.querySelector('[data-skin-save-result]');
  var quickSaveTrigger = root.querySelector('[data-trigger-crm-save]');
  var accept = document.getElementById('aiSkinCrmConsentAccept');

  function openSaveModal() {
    if (!modal) return;
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    if (accept) accept.focus();
  }

  function closeSaveModal() {
    if (!modal) return;
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    if (trigger) trigger.focus();
  }

  if (trigger) trigger.addEventListener('click', requestSave);
  if (quickSaveTrigger) quickSaveTrigger.addEventListener('click', requestSave);
  // Vừa đăng nhập từ nút "Đăng nhập để lưu hồ sơ" ⇒ mở luôn hộp đồng ý (khách vẫn phải bấm đồng ý).
  if (isLoggedIn && !isDemo && window.PharmaResultStore && window.PharmaResultStore.openSaveRequested()) openSaveModal();

  document.querySelectorAll('[data-crm-consent-close]').forEach(function (button) {
    button.addEventListener('click', closeSaveModal);
  });

  if (accept) {
    accept.addEventListener('click', function () {
      accept.disabled = true;
      var savePayload = skinScan
        ? Object.assign({}, skinScan, { consent: true, consent_at: new Date().toISOString() })
        : {
            skin_type: result.skin_type,
            scores: { skin_type: skinType },
            recommendations: (result.recommend || []).filter(function (r) { return !engine || engine.isTextAllowed(r, excluded); }),
            summary: quizResult ? [quizCase ? quizCase.title : result.skin_type, 'Tier ' + quizResult.tier + ' (' + quizResult.case_id + ')'].concat((quizResult.safety_flags || []).length ? ['Cờ an toàn: ' + quizResult.safety_flags.join(', ')] : []).join(' | ') : result.skin_type,
            tier: quizResult ? quizResult.tier : null,
            case_id: quizResult ? quizResult.case_id : '',
            safety_flags: quizResult ? (quizResult.safety_flags || []) : [],
            consent: true,
            consent_at: new Date().toISOString()
          };

      var savePromise = (skinScan && window.PharmaCrmIntake && window.PharmaCrmIntake.submitSkinAnalysis)
        ? window.PharmaCrmIntake.submitSkinAnalysis(savePayload)
        : ((window.PharmaCrmIntake && window.PharmaCrmIntake.submitAiChat)
            ? window.PharmaCrmIntake.submitAiChat(savePayload)
            : Promise.reject(new Error('crm_client_unavailable')));

      savePromise.then(function (res) {
        var statusEl = document.getElementById('aiSkinCrmConsentStatus');
        if (statusEl) statusEl.textContent = 'Kết quả đã được lưu thành công vào CRM Google Sheets!';
        // 2026-10-10: mã bản ghi do crm-intake.js lưu vào PharmaResultStore (bỏ mã giả 'crm_' + Date.now()).
        syncCustomerInfo();
        setTimeout(closeSaveModal, 1500);
      }).catch(function (err) {
        // 2026-10-05: lưu thất bại thì báo đúng là CHƯA lưu — trước đây báo "Đã lưu…" và ghi record id
        // giả crm_local_* khiến thẻ khách hàng hiện "đã đồng bộ" dù không có dòng nào trên Sheet.
        accept.disabled = false;
        var statusEl = document.getElementById('aiSkinCrmConsentStatus');
        if (statusEl) {
          statusEl.textContent = {{ settings.crm_consent_error_message | default: 'Chưa thể lưu kết quả lúc này. Vui lòng thử lại hoặc liên hệ chuyên gia.' | json }};
        }
      });
    });
  }
})();
</script>
