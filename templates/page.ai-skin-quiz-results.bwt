{%- comment -%}
  page.ai-skin-quiz-results.bwt (T-32) — Trang kết quả đầy đủ cho AI Skin Diagnostic Quiz,
  đối chiếu Pharma_Cosmetics_Figma_Project/ai-results.html. Quiz (page.ai-skin-quiz.bwt) chạy
  hoàn toàn client-side, không có backend lưu phiên làm bài — nên trang này nhận kết quả qua
  localStorage (key 'pc_quiz_skin_type', ghi bởi finish() trong page.ai-skin-quiz.bwt) thay vì
  qua Liquid/query param. Nếu truy cập trực tiếp (chưa làm quiz), hiển thị bản DEMO minh hoạ với
  cảnh báo rõ ràng đây là ví dụ, không phải kết quả thật — không tự nhận là dữ liệu đã đo thật
  (không bịa số đo lâm sàng chính xác kiểu "62/100", "TEWL 35%" như bản Figma tĩnh — sai lệch
  đó có thể gây hiểu nhầm y khoa, xem POLICY.yaml#pii_form_gate + Luật 91/2025/QH15).
{%- endcomment -%}
{{ 'page_ai_skin_quiz.scss.css' | asset_url | stylesheet_tag }}
{% include 'breadcrumb' %}

<section class="py-6 sm:py-10">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">

    <div class="bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm rounded-xl p-4 flex items-start gap-3">
      <i class="fas fa-triangle-exclamation text-amber-500 mt-0.5"></i>
      <div>
        <strong>Lưu ý y khoa:</strong> Kết quả dưới đây là gợi ý sơ bộ dựa trên câu trả lời tự đánh giá của bạn,
        <strong>không phải chẩn đoán y khoa chính thức</strong> và không thay thế việc thăm khám trực tiếp với
        bác sĩ da liễu. Vui lòng đặt lịch tư vấn 1:1 để được bác sĩ soi da và kê phác đồ chính xác.
      </div>
    </div>

    <div id="pcQuizResultsRoot" data-demo="true">
      <!-- Được JS điền động bên dưới (đọc localStorage 'pc_quiz_skin_type') -->
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200">
        <div class="flex items-center gap-3 mb-4">
          <span class="pc-kit-badge-clinical text-xs font-semibold" data-result-demo-flag hidden>Bản xem trước minh hoạ</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-forest-900 font-heading mb-2">
          Hồ Sơ Da Của Bạn: <span data-result-title>—</span>
        </h1>
        <p class="text-sm text-gray-600" data-result-summary>Đang tải kết quả…</p>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 mt-6 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <div>
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">HOẠT CHẤT ĐƯỢC ĐỀ XUẤT</span>
            <h3 class="text-lg font-bold text-forest-900 font-heading">Định Hướng Phác Đồ Tham Khảo</h3>
          </div>
          <span class="pc-kit-badge-clinical text-xs font-semibold">Thẩm định bởi BS.CKII Nguyễn Minh Anh</span>
        </div>
        <div class="flex flex-wrap gap-2" data-result-recommend></div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          <div class="p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200 space-y-2">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">GIAI ĐOẠN 1</span>
            <h4 class="text-sm font-bold text-gray-900">Làm Dịu &amp; Ổn Định</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Ưu tiên hoạt chất dịu nhẹ, ngưng các bước gây kích ứng, phục hồi ngưỡng chịu đựng của da.</p>
          </div>
          <div class="p-5 rounded-2xl bg-teal-50/50 border border-teal-200 space-y-2">
            <span class="text-xs font-bold text-teal-800 uppercase tracking-wider">GIAI ĐOẠN 2</span>
            <h4 class="text-sm font-bold text-gray-900">Phục Hồi Hàng Rào Bảo Vệ Da</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Bổ sung dưỡng ẩm/ceramide theo nhóm hoạt chất đề xuất phía trên, tăng dần theo khả năng dung nạp.</p>
          </div>
          <div class="p-5 rounded-2xl bg-cyan-50/50 border border-cyan-200 space-y-2">
            <span class="text-xs font-bold text-cyan-800 uppercase tracking-wider">GIAI ĐOẠN 3</span>
            <h4 class="text-sm font-bold text-gray-900">Điều Trị Chuyên Sâu Theo Mục Tiêu</h4>
            <p class="text-xs text-gray-600 leading-relaxed">Tên sản phẩm/liều lượng cụ thể sẽ được bác sĩ hoặc dược sĩ chỉ định trực tiếp, phù hợp cơ địa của bạn.</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200 mt-6 space-y-4">
        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider">Bước Tiếp Theo</h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <a class="flex-1 pc-kit-btn-primary py-3.5 text-center justify-center font-bold" data-result-search-link href="/search">
            <i class="fas fa-magnifying-glass"></i> Xem Sản Phẩm Phù Hợp
          </a>
          <a href="/pages/dat-lich-tu-van" class="pc-kit-btn-secondary py-3.5 text-center justify-center">
            <i class="fas fa-calendar-check"></i> Đặt Lịch Bác Sĩ Thăm Khám 1:1
          </a>
        </div>
        <a href="/pages/ai-skin-quiz" class="text-xs font-semibold text-emerald-700 hover:underline inline-block pt-2">&larr; Làm lại khảo sát</a>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  var resultsData = {{ quiz_results | json }};
  var root = document.getElementById('pcQuizResultsRoot');
  if (!root) return;

  var skinType = null;
  var isDemo = true;
  try {
    skinType = localStorage.getItem('pc_quiz_skin_type');
    if (skinType) isDemo = false;
  } catch (e) { /* localStorage bị chặn — dùng bản demo */ }

  if (!skinType || !resultsData[skinType]) {
    // Chưa làm quiz (truy cập trực tiếp) → dùng 1 kết quả minh hoạ, đánh dấu rõ là DEMO.
    skinType = Object.keys(resultsData)[0];
    isDemo = true;
  }

  var result = resultsData[skinType];
  root.querySelector('[data-result-title]').textContent = result.skin_type;
  root.querySelector('[data-result-summary]').textContent = isDemo
    ? 'Đây là ví dụ minh hoạ giao diện kết quả — hãy làm bài khảo sát 17 câu hỏi để nhận gợi ý phù hợp với da của bạn.'
    : 'Dựa trên câu trả lời của bạn ở bài khảo sát 17 câu hỏi.';

  var demoFlag = root.querySelector('[data-result-demo-flag]');
  if (demoFlag) demoFlag.hidden = !isDemo;

  var rec = root.querySelector('[data-result-recommend]');
  (result.recommend || []).forEach(function (r) {
    var span = document.createElement('span');
    span.className = 'pc-kit-badge-gold';
    span.textContent = r;
    rec.appendChild(span);
  });

  var searchLink = root.querySelector('[data-result-search-link]');
  if (searchLink && result.recommend && result.recommend[0]) {
    searchLink.href = '/search?query=' + encodeURIComponent(result.recommend[0]);
  }
})();
</script>
