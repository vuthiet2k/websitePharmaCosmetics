{% layout 'theme' %}
{%- comment -%}
  blog.video.bwt (2026-10-12) — giao diện danh mục bài viết Video (Sapo Admin → Blog "Video" → Giao diện: blog.video).
  2026-10-13: bố cục đổi theo mẫu trang kênh YouTube (khách gửi): đầu kênh (ảnh đại diện, tên blog, @kênh • số video,
  giới thiệu, liên kết, nút Đăng ký/Fanpage) → thanh tab (Trang chủ + chủ đề tag chude: + nguồn khi có cả YouTube lẫn
  Facebook + ô tìm trong trang) → hàng cuộn ngang "mới nhất" (chỉ trang 1, ẩn khi đang lọc) → lưới "Video".
  Không có lượt xem/số người đăng ký vì theme không có dữ liệu thật. Không breadcrumb (theo mẫu).
  Dữ liệu từng bài đọc qua snippets/video_source.bwt (tag youtube:/facebook:/thoiluong:/chude:). Câu chữ/link: field video_*.
{%- endcomment -%}
{%- assign pc_vb_per_page = settings.video_per_page | default: 24 | plus: 0 -%}
{%- if pc_vb_per_page < 1 or pc_vb_per_page > 50 -%}{%- assign pc_vb_per_page = 24 -%}{%- endif -%}
{%- assign pc_vb_row_n = settings.video_row_limit | default: 8 | plus: 0 -%}
{%- comment -%} @kênh lấy từ link kênh YouTube dạng https://www.youtube.com/@ten-kenh. {%- endcomment -%}
{%- assign pc_vb_handle = '' -%}
{%- if settings.video_youtube_url contains '/@' -%}{%- assign pc_vb_handle = settings.video_youtube_url | split: '/@' | last | split: '/' | first | split: '?' | first | prepend: '@' -%}{%- endif -%}
<section class="pc-ytc">
	<div class="container">
		<header class="pc-ytc__head">
			<img class="pc-ytc__avatar" src="{{ 'favicon.png' | asset_url }}" alt="{{ settings.video_channel_name | default: store.name | escape }}" width="160" height="160">
			<div class="pc-ytc__info">
				<h1 class="pc-ytc__name">{{ blog.name | escape }}</h1>
				<p class="pc-ytc__line">
					{%- if pc_vb_handle != '' -%}<span>{{ pc_vb_handle | escape }}</span>{%- endif -%}
					<span>{{ blog.articles_count }} {{ settings.video_count_suffix | default: 'video' | escape }}</span>
				</p>
				{%- if settings.video_intro != blank -%}<p class="pc-ytc__desc">{{ settings.video_intro | escape }}</p>{%- endif -%}
				{%- if settings.video_facebook_url != blank -%}
				<p class="pc-ytc__links">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
					<a href="{{ settings.video_facebook_url }}" target="_blank" rel="noopener">{{ settings.video_facebook_label | default: 'Fanpage Facebook' | escape }}</a>
				</p>
				{%- endif -%}
				{%- if settings.video_youtube_url != blank -%}
				<div class="pc-ytc__actions">
					{%- assign pc_vb_sub_url = settings.video_youtube_url -%}
					{%- unless pc_vb_sub_url contains '?' -%}{%- assign pc_vb_sub_url = pc_vb_sub_url | append: '?sub_confirmation=1' -%}{%- endunless -%}
					<a class="pc-ytc__btn pc-ytc__btn--sub" href="{{ pc_vb_sub_url }}" target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16zM10 21h4"/></svg>
						{{ settings.video_subscribe_label | default: 'Đăng ký kênh' | escape }}
					</a>
					<a class="pc-ytc__btn" href="{{ settings.video_youtube_url }}" target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
						{{ settings.video_youtube_label | default: 'Kênh YouTube' | escape }}
					</a>
				</div>
				{%- endif -%}
			</div>
		</header>

		{% paginate blog.articles by pc_vb_per_page %}
		{%- comment -%} Thu thập chủ đề (tag chude:) và nguồn có trong trang để dựng tab — chỉ hiện tab có dữ liệu thật. {%- endcomment -%}
		{%- assign pc_vb_topics = '' -%}
		{%- assign pc_vb_has_yt = false -%}
		{%- assign pc_vb_has_fb = false -%}
		{%- for pc_vb_item in blog.articles -%}
			{%- assign pc_vs_article = pc_vb_item -%}
			{%- include 'video_source' -%}
			{%- if pc_vs_src == 'youtube' -%}{%- assign pc_vb_has_yt = true -%}{%- endif -%}
			{%- if pc_vs_src == 'facebook' -%}{%- assign pc_vb_has_fb = true -%}{%- endif -%}
			{%- if pc_vs_topic != blank -%}
				{%- assign pc_vb_topics_chk = pc_vb_topics | prepend: '||' | append: '||' -%}
				{%- assign pc_vb_topic_chk = pc_vs_topic | prepend: '||' | append: '||' -%}
				{%- unless pc_vb_topics_chk contains pc_vb_topic_chk -%}
					{%- if pc_vb_topics != '' -%}{%- assign pc_vb_topics = pc_vb_topics | append: '||' -%}{%- endif -%}
					{%- assign pc_vb_topics = pc_vb_topics | append: pc_vs_topic -%}
				{%- endunless -%}
			{%- endif -%}
		{%- endfor -%}
		{%- assign pc_vb_topic_list = pc_vb_topics | split: '||' -%}
		<nav class="pc-ytc__tabs" aria-label="{{ settings.video_filter_label | default: 'Lọc video theo chủ đề' | escape }}" data-pc-vfilter-group>
			<div class="pc-ytc__tablist">
				<button type="button" class="pc-ytc__tab" data-pc-vfilter-btn="all" aria-pressed="true">{{ settings.video_tab_home_label | default: 'Trang chủ' | escape }}</button>
				{%- if pc_vb_topic_list.size > 1 -%}
				{%- for pc_vb_t in pc_vb_topic_list -%}
				<button type="button" class="pc-ytc__tab" data-pc-vfilter-btn="topic-{{ pc_vb_t | handleize }}" aria-pressed="false">{{ pc_vb_t | escape }}</button>
				{%- endfor -%}
				{%- endif -%}
				{%- if pc_vb_has_yt and pc_vb_has_fb -%}
				<button type="button" class="pc-ytc__tab" data-pc-vfilter-btn="src-youtube" aria-pressed="false">{{ settings.video_src_youtube_label | default: 'YouTube' | escape }}</button>
				<button type="button" class="pc-ytc__tab" data-pc-vfilter-btn="src-facebook" aria-pressed="false">{{ settings.video_src_facebook_label | default: 'Facebook' | escape }}</button>
				{%- endif -%}
			</div>
			{%- if blog.articles.size > 1 -%}
			<div class="pc-ytc__search">
				<button type="button" class="pc-ytc__search-btn" aria-label="{{ settings.video_search_label | default: 'Tìm video' | escape }}" data-pc-ytc-search-toggle><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4"/></svg></button>
				<input class="pc-ytc__search-input" type="search" placeholder="{{ settings.video_search_label | default: 'Tìm video' | escape }}" aria-label="{{ settings.video_search_label | default: 'Tìm video' | escape }}" data-pc-ytc-search hidden>
			</div>
			{%- endif -%}
		</nav>

		{%- if blog.articles.size > 0 -%}
			{%- assign pc_vb_page1 = false -%}
			{%- if paginate.current_page == 1 or paginate.current_page == blank -%}{%- assign pc_vb_page1 = true -%}{%- endif -%}
			{%- if pc_vb_page1 and blog.articles.size > 1 -%}
			<section class="pc-ytc__shelf" data-pc-ytc-shelf>
				<h2 class="pc-ytc__title">{{ settings.video_row_title | default: 'Video mới nhất' | escape }}</h2>
				<div class="pc-ytc__rowwrap">
					<div class="pc-ytc__row" data-pc-ytc-row>
						{%- assign pc_vc_layout = 'yt' -%}{%- assign pc_vc_heading = 'h3' -%}
						{%- for pc_vb_item in blog.articles limit: pc_vb_row_n -%}
						<div class="pc-ytc__rowcell">{%- assign pc_vc_article = pc_vb_item -%}{% include 'video_card' %}</div>
						{%- endfor -%}
					</div>
					<button type="button" class="pc-ytc__arrow pc-ytc__arrow--prev" data-dir="-1" aria-label="{{ settings.news_prev_label | default: 'Tin trước' | escape }}" hidden><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg></button>
					<button type="button" class="pc-ytc__arrow pc-ytc__arrow--next" data-dir="1" aria-label="{{ settings.news_next_label | default: 'Tin sau' | escape }}" hidden><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg></button>
				</div>
			</section>
			{%- endif -%}

			<section class="pc-ytc__all">
				<h2 class="pc-ytc__title">{{ settings.video_list_title | default: 'Tất cả video' | escape }}</h2>
				<div class="pc-vgrid pc-ytc__grid" data-pc-vgrid>
					{%- assign pc_vc_layout = 'yt' -%}{%- assign pc_vc_heading = 'h3' -%}
					{%- for pc_vb_item in blog.articles -%}
					<div class="pc-vgrid__cell">{%- assign pc_vc_article = pc_vb_item -%}{% include 'video_card' %}</div>
					{%- endfor -%}
				</div>
				<p class="pc-vblog__empty" data-pc-ytc-none hidden>{{ settings.video_no_match_text | default: 'Không có video phù hợp.' | escape }}</p>
			</section>
			{%- if paginate.pages > 1 -%}
			<div class="pc-vblog__pagi">{% include 'paginate-pages' %}</div>
			{%- endif -%}
		{%- else -%}
			<p class="pc-vblog__empty">{{ settings.video_empty_text | default: 'Chuyên mục đang cập nhật video.' | escape }}</p>
		{%- endif -%}
		{% endpaginate %}
	</div>
</section>
<script>
/* blog.video.bwt: tab lọc (chủ đề/nguồn theo data-pc-vfilter) + ô tìm theo tiêu đề — chỉ trong trang hiện tại; đang lọc thì
   ẩn hàng "mới nhất". Hàng cuộn ngang có nút ‹ › khi tràn. Ngày đăng hiện kiểu "3 tháng trước" (ngày đầy đủ ở title). */
(function () {
	var root = document.querySelector('.pc-ytc');
	if (!root) return;
	var group = root.querySelector('[data-pc-vfilter-group]');
	var grid = root.querySelector('[data-pc-vgrid]');
	var shelf = root.querySelector('[data-pc-ytc-shelf]');
	var none = root.querySelector('[data-pc-ytc-none]');
	var input = root.querySelector('[data-pc-ytc-search]');
	var key = 'all', q = '';
	function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd'); }
	function apply() {
		if (!grid) return;
		var shown = 0;
		grid.querySelectorAll('.pc-vgrid__cell').forEach(function (cell) {
			var card = cell.querySelector('[data-pc-vfilter]');
			var tokens = card ? card.getAttribute('data-pc-vfilter').split(' ') : [];
			var title = cell.querySelector('.pc-vcard__title');
			var ok = (key === 'all' || tokens.indexOf(key) !== -1) && (!q || norm(title && title.textContent).indexOf(q) !== -1);
			cell.hidden = !ok;
			if (ok) shown++;
		});
		if (shelf) shelf.hidden = key !== 'all' || !!q;
		if (none) none.hidden = shown > 0;
	}
	if (group) group.addEventListener('click', function (e) {
		var btn = e.target.closest('[data-pc-vfilter-btn]');
		if (btn) {
			key = btn.getAttribute('data-pc-vfilter-btn');
			group.querySelectorAll('[data-pc-vfilter-btn]').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
			apply();
		}
		if (e.target.closest('[data-pc-ytc-search-toggle]') && input) { input.hidden = false; input.focus(); }
	});
	if (input) input.addEventListener('input', function () { q = norm(input.value.trim()); apply(); });

	var row = root.querySelector('[data-pc-ytc-row]');
	if (row) {
		var arrows = root.querySelectorAll('.pc-ytc__arrow');
		var sync = function () {
			arrows.forEach(function (a) {
				a.hidden = +a.getAttribute('data-dir') < 0 ? row.scrollLeft < 4 : row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
			});
		};
		arrows.forEach(function (a) { a.addEventListener('click', function () { row.scrollBy({ left: +a.getAttribute('data-dir') * row.clientWidth * 0.9, behavior: 'smooth' }); }); });
		row.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
		sync();
	}

	var now = Date.now();
	var units = [[31536e6, 'năm'], [2592e6, 'tháng'], [6048e5, 'tuần'], [864e5, 'ngày'], [36e5, 'giờ'], [6e4, 'phút']];
	root.querySelectorAll('.pc-vcard--yt time[datetime]').forEach(function (t) {
		var d = Date.parse(t.getAttribute('datetime'));
		if (isNaN(d) || d > now) return;
		for (var i = 0; i < units.length; i++) {
			var n = Math.floor((now - d) / units[i][0]);
			if (n >= 1) { t.title = t.textContent; t.textContent = n + ' ' + units[i][1] + ' trước'; return; }
		}
	});
})();
</script>
