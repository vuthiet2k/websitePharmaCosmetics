{% layout 'theme' %}
{%- comment -%}
  blog.video.bwt (2026-10-12) — giao diện danh mục bài viết Video (Sapo Admin → Blog "Video" → Giao diện: blog.video).
  Theo tài liệu docs/Danh sách Link Iframe YouTube - Trang Blogs Bí Quyết (Pharma Cosmetics).md mục 6–7:
  đầu trang (eyebrow + H1 + giới thiệu + nút kênh YouTube/Fanpage) → video nổi bật (bài mới nhất, phát ngay tại chỗ)
  → thanh lọc theo chủ đề (tag chude:) và nguồn (chỉ hiện khi blog có cả YouTube lẫn Facebook) → lưới video 3 cột.
  Dữ liệu từng bài đọc qua snippets/video_source.bwt (tag youtube:/facebook:/thoiluong:/chude:). Câu chữ/link: field video_*.
{%- endcomment -%}
{% include 'breadcrumb' %}
{%- assign pc_vb_per_page = settings.video_per_page | default: 24 | plus: 0 -%}
{%- if pc_vb_per_page < 1 or pc_vb_per_page > 50 -%}{%- assign pc_vb_per_page = 24 -%}{%- endif -%}
<section class="pc-vblog">
	<div class="container">
		<header class="pc-vblog__head">
			{%- if settings.video_eyebrow != blank -%}<span class="pc-vblog__eyebrow">{{ settings.video_eyebrow | escape }}</span>{%- endif -%}
			<h1 class="pc-vblog__title">{{ blog.name | escape }}</h1>
			{%- if settings.video_intro != blank -%}<p class="pc-vblog__intro">{{ settings.video_intro | escape }}</p>{%- endif -%}
			{%- if settings.video_youtube_url != blank or settings.video_facebook_url != blank -%}
			<div class="pc-vblog__channels">
				{%- if settings.video_youtube_url != blank -%}
				<a class="pc-vchannel pc-vchannel--youtube" href="{{ settings.video_youtube_url }}" target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
					{{ settings.video_youtube_label | default: 'Kênh YouTube' | escape }}
				</a>
				{%- endif -%}
				{%- if settings.video_facebook_url != blank -%}
				<a class="pc-vchannel pc-vchannel--facebook" href="{{ settings.video_facebook_url }}" target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M24 12.1C24 5.4 18.6 0 12 0S0 5.4 0 12.1c0 6 4.4 11 10.1 11.9v-8.4h-3v-3.5h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9v2.3h3.3l-.5 3.5h-2.8V24C19.6 23 24 18 24 12.1z"/></svg>
					{{ settings.video_facebook_label | default: 'Fanpage Facebook' | escape }}
				</a>
				{%- endif -%}
			</div>
			{%- endif -%}
		</header>

		{% paginate blog.articles by pc_vb_per_page %}
		{%- if blog.articles.size > 0 -%}
			{%- comment -%} Thu thập chủ đề (tag chude:) và nguồn có trong trang để dựng thanh lọc — chỉ hiện nút có dữ liệu thật. {%- endcomment -%}
			{%- assign pc_vb_topics = '' -%}
			{%- assign pc_vb_has_yt = false -%}
			{%- assign pc_vb_has_fb = false -%}
			{%- for pc_vb_item in blog.articles -%}
				{%- assign pc_vs_article = pc_vb_item -%}
				{%- include 'video_source' -%}
				{%- if pc_vs_src == 'youtube' -%}{%- assign pc_vb_has_yt = true -%}{%- endif -%}
				{%- if pc_vs_src == 'facebook' -%}{%- assign pc_vb_has_fb = true -%}{%- endif -%}
				{%- if pc_vs_topic != blank -%}
					{%- assign pc_vb_topics_chk = pc_vb_topics | prepend: '||' | append: '||' -%}
					{%- assign pc_vb_topic_chk = pc_vs_topic | prepend: '||' | append: '||' -%}
					{%- unless pc_vb_topics_chk contains pc_vb_topic_chk -%}
						{%- if pc_vb_topics != '' -%}{%- assign pc_vb_topics = pc_vb_topics | append: '||' -%}{%- endif -%}
						{%- assign pc_vb_topics = pc_vb_topics | append: pc_vs_topic -%}
					{%- endunless -%}
				{%- endif -%}
			{%- endfor -%}

			{%- comment -%} Video nổi bật = bài mới nhất, chỉ ở trang 1; phát tại chỗ (facade), nút mở trang xem chi tiết. {%- endcomment -%}
			{%- assign pc_vb_featured = false -%}
			{%- if paginate.current_page == 1 or paginate.current_page == blank -%}
				{%- assign pc_vb_featured = blog.articles.first -%}
				{%- assign pc_vs_article = pc_vb_featured -%}
				{%- include 'video_source' -%}
				<article class="pc-vfeat">
					<div class="pc-vfeat__player">
						{%- assign pc_ve_src = pc_vs_src -%}{%- assign pc_ve_id = pc_vs_id -%}{%- assign pc_ve_fb = pc_vs_fb -%}
						{%- assign pc_ve_title = pc_vb_featured.title -%}{%- assign pc_ve_thumb = pc_vs_thumb_big -%}
						{%- assign pc_ve_priority = true -%}{%- assign pc_ve_uid = '' -%}
						{% include 'video_embed' %}
					</div>
					<div class="pc-vfeat__body">
						<div class="pc-vfeat__tags">
							{%- if settings.video_featured_label != blank -%}<span class="pc-vfeat__badge">{{ settings.video_featured_label | escape }}</span>{%- endif -%}
							{%- if pc_vs_topic != blank -%}<span class="pc-vcard__topic">{{ pc_vs_topic | escape }}</span>{%- endif -%}
						</div>
						<h2 class="pc-vfeat__title"><a href="{{ pc_vb_featured.url }}">{{ pc_vb_featured.title | escape }}</a></h2>
						{%- assign pc_vb_sum = pc_vb_featured.summary | default: pc_vb_featured.excerpt | strip_html | strip -%}
						{%- if pc_vb_sum != blank -%}<p class="pc-vfeat__sum">{{ pc_vb_sum | truncatewords: 40 }}</p>{%- endif -%}
						<div class="pc-vfeat__meta">
							<time datetime="{{ pc_vb_featured.published_on | date: 'yyyy-MM-dd' }}">{{ pc_vb_featured.published_on | date: 'dd/MM/yyyy' }}</time>
							{%- if pc_vs_dur != blank -%}<span>{{ settings.video_duration_label | default: 'Thời lượng' | escape }} {{ pc_vs_dur | escape }}</span>{%- endif -%}
						</div>
						<a class="pc-vfeat__cta" href="{{ pc_vb_featured.url }}">{{ settings.video_watch_label | default: 'Xem chi tiết video' | escape }} <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg></a>
					</div>
				</article>
			{%- endif -%}

			<div class="pc-vblog__bar">
				<h2 class="pc-vblog__list-title">{{ settings.video_list_title | default: 'Tất cả video' | escape }} <span>({{ blog.articles_count }})</span></h2>
				{%- assign pc_vb_topic_list = pc_vb_topics | split: '||' -%}
				{%- if pc_vb_topic_list.size > 1 or pc_vb_has_yt and pc_vb_has_fb -%}
				<div class="pc-vfilter" role="group" aria-label="{{ settings.video_filter_label | default: 'Lọc video' | escape }}" data-pc-vfilter-group>
					<button type="button" class="pc-vfilter__btn" data-pc-vfilter-btn="all" aria-pressed="true">{{ settings.video_filter_all_label | default: 'Tất cả' | escape }}</button>
					{%- if pc_vb_topic_list.size > 1 -%}
					{%- for pc_vb_t in pc_vb_topic_list -%}
					<button type="button" class="pc-vfilter__btn" data-pc-vfilter-btn="topic-{{ pc_vb_t | handleize }}" aria-pressed="false">{{ pc_vb_t | escape }}</button>
					{%- endfor -%}
					{%- endif -%}
					{%- if pc_vb_has_yt and pc_vb_has_fb -%}
					<button type="button" class="pc-vfilter__btn" data-pc-vfilter-btn="src-youtube" aria-pressed="false">{{ settings.video_src_youtube_label | default: 'YouTube' | escape }}</button>
					<button type="button" class="pc-vfilter__btn" data-pc-vfilter-btn="src-facebook" aria-pressed="false">{{ settings.video_src_facebook_label | default: 'Facebook' | escape }}</button>
					{%- endif -%}
				</div>
				{%- endif -%}
			</div>

			<div class="pc-vgrid" data-pc-vgrid>
				{%- assign pc_vc_layout = 'grid' -%}{%- assign pc_vc_heading = 'h3' -%}
				{%- for pc_vb_item in blog.articles -%}
				{%- comment -%} Bài nổi bật vẫn có thẻ trong lưới (ẩn ở "Tất cả", hiện khi lọc trúng) để bộ lọc không bỏ sót. {%- endcomment -%}
				<div class="pc-vgrid__cell{% if pc_vb_featured and forloop.first %} pc-vgrid__cell--featured{% endif %}">
					{%- assign pc_vc_article = pc_vb_item -%}
					{% include 'video_card' %}
				</div>
				{%- endfor -%}
			</div>
			{%- if paginate.pages > 1 -%}
			<div class="pc-vblog__pagi">{% include 'paginate-pages' %}</div>
			{%- endif -%}
		{%- else -%}
			<p class="pc-vblog__empty">{{ settings.video_empty_text | default: 'Chuyên mục đang cập nhật video.' | escape }}</p>
		{%- endif -%}
		{% endpaginate %}
	</div>
</section>
<script>
/* Bộ lọc video (blog.video.bwt): ẩn/hiện thẻ theo data-pc-vfilter — chỉ lọc trong trang hiện tại. */
(function () {
	var group = document.querySelector('[data-pc-vfilter-group]');
	var grid = document.querySelector('[data-pc-vgrid]');
	if (!group || !grid) return;
	group.addEventListener('click', function (e) {
		var btn = e.target.closest('[data-pc-vfilter-btn]');
		if (!btn) return;
		var key = btn.getAttribute('data-pc-vfilter-btn');
		group.querySelectorAll('[data-pc-vfilter-btn]').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
		grid.classList.toggle('is-filtered', key !== 'all');
		grid.querySelectorAll('.pc-vgrid__cell').forEach(function (cell) {
			var card = cell.querySelector('[data-pc-vfilter]');
			var tokens = card ? card.getAttribute('data-pc-vfilter').split(' ') : [];
			cell.hidden = key !== 'all' && tokens.indexOf(key) === -1;
		});
	});
})();
</script>
