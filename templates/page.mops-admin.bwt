{% comment %} page.mops-admin.bwt — MOPS Admin dashboard. Layout riêng (mops-admin), Tailwind CDN +
  Material Design 3 tokens — chỉ dùng cho trang nội bộ này. Vue 3 local compile template inert quản lý
  toàn bộ 11 tab (auth/sidebar/tab-switching + Tổng quan/Đơn hàng/Sản phẩm/Khách hàng/Tài chính/
  Kho & NCC/Thông báo/Nhật ký/Nhân viên/Mã giảm giá/Cấu hình) — xem Assets/mops-admin.js.bwt. Tab
  Tài chính chỉ hiện với role có quyền 'reports.finance.view' (xem canViewFinance). {% endcomment %}
{% layout 'mops-admin' %}


<div id="ma-preloader" class="ma-preloader-overlay">
  <div class="ma-loader-mark">
    <img src="{{ 'logoPC.svg' | asset_url }}" alt="MOPS Admin"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
    <div class="ma-loader-mark-fallback">M</div>
  </div>
  <div class="ma-loader-bar"><span></span></div>
  <p class="ma-loader-status">Đang kiểm tra phiên đăng nhập...</p>
  <div class="ma-loader-brand">
    <p class="ma-loader-brand-title">Hệ thống quản trị nội bộ — MOPS Admin</p>
  </div>
</div>


<div id="mops-app" aria-busy="true"></div>

{% comment %} Global component <mops-address-picker> — Vue 3 in-DOM template, dùng chung cho mọi form
     địa chỉ (Manual Order, Customer, Branch, Supplier). Đăng ký component ở
     Assets/mops-admin-address-picker.js.bwt (window.MopsAdminComponents['mops-address-picker'])
     — core mops-admin.js iterate registry rồi app.component() trước app.mount(). Template phải
     có mặt trong DOM lúc component instantiate (Vue 3 tra '#id' khi render đầu tiên). Placeholder
     '[[ ]]' khớp delimiters app cha. 2026-08-12. {% endcomment %}
<template id="mops-address-picker-template">
  <div class="ma-addr-picker" :class="{ 'ma-addr-picker--dense': dense, 'ma-addr-picker--disabled': disabled }">

    <p v-if="!isReady" class="text-label-sm text-amber-700 flex items-center gap-1">
      <span class="material-symbols-outlined text-[14px]">warning</span>
      Bảng danh mục địa chính chưa load — kiểm tra 3 asset mops-address-*.js trong Sapo Admin.
    </p>

    <template v-if="isReady">
      <!-- Nhánh 1: Nút Chuyển đổi Sapo-style -->
      <div class="ma-addr-converter flex justify-end">
        <span class="ma-addr-info"
              title="Tự động phân tích chuỗi địa chỉ đã dán ở ô Số nhà/Đường (hoặc ô Tìm nhanh bên dưới) và quy đổi sang mã đơn vị hành chính 3 cấp mới nhất theo GSO. Bấm để mở danh sách gợi ý dạng radio.">
          <span class="material-symbols-outlined text-[14px]">info</span>
        </span>
        <button type="button" class="ma-addr-converter-btn"
                :disabled="converterBtnDisabled"
                @click="runConverter">
          <span v-if="converterAnalyzing" class="material-symbols-outlined ma-spin text-[16px]">progress_activity</span>
          <span v-else class="material-symbols-outlined text-[16px]">bolt</span>
          <span>[[ converterBtnLabel ]]</span>
        </button>
      </div>

      <!-- Panel candidates dạng radio -->
      <div v-if="converterOpen && converterAttempted && converterCandidates.length" class="ma-addr-cand-panel">
        <div class="ma-addr-cand-panel__header">
          <span class="material-symbols-outlined text-[16px]">location_searching</span>
          <span>Địa chỉ gợi ý theo đơn vị hành chính mới — chọn 1 phương án:</span>
        </div>
        <div class="ma-addr-cand-panel__list">
          <label v-for="(cand, idx) in converterCandidates" :key="cand.ward.c"
                 class="ma-addr-cand-card"
                 :class="{ 'ma-addr-cand-card--active': converterSelectedIndex === idx }">
            <input type="radio" :name="uid + '_cand'" :value="idx" v-model="converterSelectedIndex">
            <span class="ma-addr-cand-card__body">
              <span class="ma-addr-cand-card__title">
                <b>[[ cand.ward.f ]]</b><span class="opacity-80">, <template v-if="cand.district">[[ cand.district.f ]], </template>[[ cand.province.f ]]</span>
              </span>
              <span class="ma-addr-cand-card__badge">Mã GSO: [[ formatGsoCode(cand) ]]</span>
            </span>
          </label>
        </div>
        <div class="ma-addr-cand-panel__actions">
          <button type="button" class="ma-btn-outline" @click="closeConverter">Đóng</button>
          <button type="button" class="ma-btn-primary"
                  :disabled="converterSelectedIndex === null"
                  @click="applyConverterSelection">Áp dụng địa chỉ này</button>
        </div>
      </div>

      <!-- Panel empty (đã bấm nhưng không match) -->
      <div v-else-if="converterOpen && converterAttempted && !converterCandidates.length && !converterAnalyzing"
           class="ma-addr-cand-panel ma-addr-cand-panel--empty">
        <div class="ma-addr-cand-panel__empty">
          <span class="material-symbols-outlined text-[18px]">search_off</span>
          Không tìm thấy mã hành chính phù hợp. Vui lòng chọn Tỉnh/Huyện/Xã thủ công ở 3 ô bên dưới.
        </div>
        <div class="ma-addr-cand-panel__actions">
          <button type="button" class="ma-btn-outline" @click="closeConverter">Đóng</button>
        </div>
      </div>

      <!-- Nhánh 2: Smart Search inline (typeahead auto-suggest khi gõ ≥2 ký tự) -->
      <div class="relative">
        <div class="relative">
          <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-[16px] text-on-surface-variant opacity-70">travel_explore</span>
          <input type="text" v-model="smartQuery"
                 @focus="smartFocused = true"
                 @blur="blurDropdown('smartFocused')"
                 placeholder="Tìm nhanh Tỉnh/Huyện/Xã. VD: dich vong cau giay"
                 class="ma-input" style="padding-left:30px;"
                 :disabled="disabled">
        </div>
        <div v-if="smartFocused && smartQuery.trim().length >= 2"
             class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-64 overflow-y-auto custom-scrollbar">
          <template v-if="smartCandidates.length">
            <button v-for="cand in smartCandidates" :key="cand.ward.c" type="button"
                    @mousedown.prevent @click="pickSmartCandidate(cand)"
                    class="w-full text-left px-3 py-2 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0">
              <span class="font-bold text-on-surface">[[ cand.ward.f ]]</span>
              <span class="text-on-surface-variant"> · <template v-if="cand.district">[[ cand.district.f ]] · </template>[[ cand.province.f ]]</span>
            </button>
          </template>
          <div v-else class="px-3 py-3 text-body-sm text-on-surface-variant text-center opacity-70">
            Không tìm thấy — thử gõ ít token hơn hoặc chọn từng cấp bên dưới.
          </div>
        </div>
      </div>

      <!-- ═══ Sapo 3-layer pattern (2026-08-12) ═══
           L1: Dual mapping data (dp/dd/dw trong wards mới) — đã setup.
           L2: Tab switcher Cũ/Mới — user chọn 1 hệ, không show hết cả 2 tránh rối.
           L3: Nhấn tab Cũ khi hãng chưa hỗ trợ địa chỉ mới. Payload luôn chứa cả 2 layer nên
               tự động ok — chỉ đổi UI hiển thị. -->
      <div class="ma-mo-seg">
        <button type="button" :class="{ 'is-active': activeTab === 'new' }"
                @click="switchAddressTab('new')"
                :disabled="!newMasterReady">
          <span class="material-symbols-outlined">star</span>Địa chỉ mới
          <span class="text-label-sm opacity-70">(2025)</span>
        </button>
        <button type="button" :class="{ 'is-active': activeTab === 'old' }"
                @click="switchAddressTab('old')">
          <span class="material-symbols-outlined">history</span>Địa chỉ cũ
          <span class="text-label-sm opacity-70">(63 tỉnh)</span>
        </button>
      </div>

      <!-- Nhánh 3a: activeTab='new' — 2 combobox typeahead (Tỉnh MỚI + Xã MỚI, không có Huyện). -->
      <div v-if="activeTab === 'new'" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div class="relative">
          <input type="text" v-model="newProvinceQuery"
                 @focus="newProvinceFocused = true"
                 @blur="blurDropdown('newProvinceFocused')"
                 placeholder="Tỉnh/Thành (34 tỉnh mới)" aria-label="Tỉnh/Thành mới" class="ma-input"
                 :disabled="disabled">
          <div v-if="newProvinceFocused" class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-56 overflow-y-auto custom-scrollbar">
            <button v-for="p in newProvinceOptions" :key="p.c" type="button"
                    @mousedown.prevent @click="pickNewProvince(p)"
                    class="w-full text-left px-3 py-1.5 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0"
                    :class="{ 'bg-primary-container/40 font-bold': modelValue && modelValue.newProvinceCode === p.c }">
              [[ p.f ]]
            </button>
            <div v-if="!newProvinceOptions.length" class="px-3 py-2 text-body-sm text-on-surface-variant opacity-70 text-center">Không có tỉnh khớp.</div>
          </div>
        </div>
        <div class="relative">
          <input type="text" v-model="newWardQuery"
                 :disabled="disabled || !(modelValue && modelValue.newProvinceCode)"
                 @focus="newWardFocused = true"
                 @blur="blurDropdown('newWardFocused')"
                 placeholder="Phường/Xã (mới)" aria-label="Phường/Xã mới"
                 class="ma-input" :class="{ 'opacity-60 cursor-not-allowed': !(modelValue && modelValue.newProvinceCode) }">
          <div v-if="newWardFocused && modelValue && modelValue.newProvinceCode" class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-56 overflow-y-auto custom-scrollbar">
            <button v-for="w in newWardOptions" :key="w.c" type="button"
                    @mousedown.prevent @click="pickNewWard(w)"
                    class="w-full text-left px-3 py-1.5 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0"
                    :class="{ 'bg-primary-container/40 font-bold': modelValue && modelValue.newWardCode === w.c }">
              [[ w.f ]]
            </button>
            <div v-if="!newWardOptions.length" class="px-3 py-2 text-body-sm text-on-surface-variant opacity-70 text-center">Không có xã khớp.</div>
          </div>
        </div>
      </div>
      <!-- Preview mã cũ đã resolve ngầm (Sapo L3): user thấy được gì đẩy cho carrier. -->
      <div v-if="oldCodePreview" class="rounded-lg border border-outline-variant bg-surface-container-low px-3 py-2 flex items-start gap-2 text-body-sm">
        <span class="material-symbols-outlined text-[16px] text-on-surface-variant mt-0.5">swap_horiz</span>
        <div class="flex-1 min-w-0">
          <div class="text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">Cấu trúc cũ tương ứng (lưu kèm)</div>
          <div class="text-on-surface truncate">
            <b>[[ oldCodePreview.ward ]]</b> · [[ oldCodePreview.district ]] · [[ oldCodePreview.province ]]
          </div>
        </div>
      </div>

      <!-- Nhánh 3b: activeTab='old' — 3 combobox typeahead cascade -->
      <div v-if="activeTab === 'old'" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <div class="relative">
          <input type="text" v-model="provinceQuery"
                 @focus="provinceFocused = true"
                 @blur="blurDropdown('provinceFocused')"
                 placeholder="Tỉnh/Thành" aria-label="Tỉnh/Thành" class="ma-input"
                 :disabled="disabled">
          <div v-if="provinceFocused" class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-56 overflow-y-auto custom-scrollbar">
            <button v-for="p in provinceOptions" :key="p.c" type="button"
                    @mousedown.prevent @click="pickProvince(p)"
                    class="w-full text-left px-3 py-1.5 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0"
                    :class="{ 'bg-primary-container/40 font-bold': modelValue && modelValue.provinceCode === p.c }">
              [[ p.f ]]
            </button>
            <div v-if="!provinceOptions.length" class="px-3 py-2 text-body-sm text-on-surface-variant opacity-70 text-center">Không có tỉnh khớp.</div>
          </div>
        </div>
        <div class="relative">
          <input type="text" v-model="districtQuery"
                 :disabled="disabled || !(modelValue && modelValue.provinceCode)"
                 @focus="districtFocused = true"
                 @blur="blurDropdown('districtFocused')"
                 placeholder="Quận/Huyện" aria-label="Quận/Huyện"
                 class="ma-input" :class="{ 'opacity-60 cursor-not-allowed': !(modelValue && modelValue.provinceCode) }">
          <div v-if="districtFocused && modelValue && modelValue.provinceCode" class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-56 overflow-y-auto custom-scrollbar">
            <button v-for="d in districtOptions" :key="d.c" type="button"
                    @mousedown.prevent @click="pickDistrict(d)"
                    class="w-full text-left px-3 py-1.5 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0"
                    :class="{ 'bg-primary-container/40 font-bold': modelValue && modelValue.districtCode === d.c }">
              [[ d.f ]]
            </button>
            <div v-if="!districtOptions.length" class="px-3 py-2 text-body-sm text-on-surface-variant opacity-70 text-center">Không có huyện khớp.</div>
          </div>
        </div>
        <div class="relative">
          <input type="text" v-model="wardQuery"
                 :disabled="disabled || !(modelValue && modelValue.districtCode)"
                 @focus="wardFocused = true"
                 @blur="blurDropdown('wardFocused')"
                 placeholder="Phường/Xã" aria-label="Phường/Xã"
                 class="ma-input" :class="{ 'opacity-60 cursor-not-allowed': !(modelValue && modelValue.districtCode) }">
          <div v-if="wardFocused && modelValue && modelValue.districtCode" class="absolute z-30 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-56 overflow-y-auto custom-scrollbar">
            <button v-for="w in wardOptions" :key="w.c" type="button"
                    @mousedown.prevent @click="pickWard(w)"
                    class="w-full text-left px-3 py-1.5 text-body-sm hover:bg-surface-container-low border-b border-outline-variant last:border-b-0"
                    :class="{ 'bg-primary-container/40 font-bold': modelValue && modelValue.wardCode === w.c }">
              [[ w.f ]]
            </button>
            <div v-if="!wardOptions.length" class="px-3 py-2 text-body-sm text-on-surface-variant opacity-70 text-center">Không có xã khớp.</div>
          </div>
        </div>
      </div>

      <p v-if="previewFullAddress" class="text-label-sm text-on-surface-variant opacity-80">
        <span class="material-symbols-outlined text-[13px] align-middle">near_me</span>
        <span class="align-middle">[[ previewFullAddress ]]</span>
      </p>

      <button v-if="hasAnyCode" type="button"
              @click="clearAddress"
              class="text-label-sm text-primary font-bold hover:underline text-left">
        Xoá địa chỉ 3 cấp
      </button>

      <label v-if="showSaveDefault" class="flex items-start gap-2 cursor-pointer text-body-sm text-on-surface-variant">
        <input type="checkbox" :checked="saveDefault" @change="onSaveDefaultToggle" class="w-4 h-4 mt-0.5">
        <span>Lưu địa chỉ đang nhập làm <strong class="text-on-surface">mặc định</strong> cho khách này.</span>
      </label>
    </template>
  </div>
</template>

<template id="mops-app-template">


<div id="ma-boot-splash" v-if="screen === 'booting'" class="min-h-screen w-full flex flex-col items-center justify-center gap-5">
  <div class="ma-loader-mark">
    <img src="{{ 'logoPC.svg' | asset_url }}" alt="MOPS Admin"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
    <div class="ma-loader-mark-fallback">M</div>
  </div>
  <div class="ma-loader-bar"><span></span></div>
  <p class="ma-loader-status">Đang kiểm tra phiên đăng nhập...</p>
</div>


<div id="ma-login-screen" v-if="screen === 'login'" class="min-h-screen w-full flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-8">
    <div class="flex flex-col items-center text-center mb-stack-lg">
      <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container mb-3">
        <span class="material-symbols-outlined">shield_person</span>
      </div>
      <h1 class="text-headline-md font-black text-on-surface">MOPS Admin</h1>
      <p class="text-body-sm text-on-surface-variant mt-1">Hệ thống quản lý đơn hàng nội bộ</p>
    </div>
    <div v-if="loginError" class="mb-4 px-3 py-2 rounded-lg bg-error-container text-on-error-container text-body-sm">[[ loginError ]]</div>
    <div class="space-y-4">
      <div>
        <label class="ma-label">Tên đăng nhập</label>
        <input v-model="loginForm.username" type="text" autocomplete="username" placeholder="staff01"
          class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
      </div>
      <div>
        <label class="ma-label">Mật khẩu</label>
        <div class="relative">
          <input v-model="loginForm.password" @keydown.enter="doLogin" :type="loginShowPassword ? 'text' : 'password'" autocomplete="current-password" placeholder="••••••••"
            class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 pr-11 text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
          <button @click="loginShowPassword = !loginShowPassword" type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-on-surface-variant hover:text-primary rounded-full"
            :aria-label="loginShowPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'"
            :title="loginShowPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'">
            <span class="material-symbols-outlined text-[20px]">[[ loginShowPassword ? 'visibility_off' : 'visibility' ]]</span>
          </button>
        </div>
      </div>
      <label class="flex items-center gap-2 text-body-sm text-on-surface-variant cursor-pointer">
        <input v-model="rememberLogin" type="checkbox" class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary">
        <span>Ghi nhớ đăng nhập trên thiết bị này</span>
      </label>
      <button @click="doLogin" :disabled="loginLoading" type="button"
        class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary py-2.5 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
        [[ loginLoading ? 'Đang đăng nhập…' : 'Đăng nhập' ]]
      </button>
    </div>
  </div>
</div>


<div id="ma-wrap" v-if="screen === 'dashboard'" class="flex flex-col md:flex-row min-h-screen" :class="{ 'is-sidebar-collapsed': sidebarCollapsed }">

  
  {%- comment -%}
    App Launcher (2026-08-21) — full-page responsive grid, Salesforce Lightning pattern. Thay
    Springboard mobile cũ (iOS-swipe, .ma-spring, chỉ md:hidden). Visible mọi kích thước khi
    mobileHome.open. Xem launcherApps / launcherSections / launcherRecent / pushLauncherRecent
    trong mops-admin.js.bwt. CSS .ma-spring* cũ giờ thành dead code (không xoá SCSS để tránh
    grunt/compile step; safe to prune sau này).
  {%- endcomment -%}
  <div v-if="mobileHome.open" class="ma-launcher">
    <header class="ma-launcher__header flex justify-between">
      <div class="ma-launcher__brand">
        {% if settings.mops_admin_logo != blank %}
        <img src="{{ settings.mops_admin_logo | img_url: 'compact' }}" alt="MOPS Admin" width="40" height="40"
          onerror="this.onerror=null;this.src='{{ 'logoPC.svg' | asset_url }}';">
        {% else %}
        <img src="{{ 'logoPC.svg' | asset_url }}" alt="MOPS Admin" width="40" height="40">
        {% endif %}
        <div class="min-w-0">
          <p class="text-label-md font-bold text-on-surface leading-tight truncate">MOPS Admin</p>
          <p class="text-label-sm text-on-surface-variant leading-tight truncate">Chào [[ (staff && (staff.name || staff.username)) || 'bạn' ]]</p>
        </div>
      </div>
      <div class="ma-launcher__searchbar">
        <span class="material-symbols-outlined text-[18px] text-on-surface-variant">search</span>
        <input v-model="mobileHome.query" type="text" placeholder="Tìm ứng dụng… (gõ không dấu OK)" aria-label="Tìm ứng dụng" autocomplete="off">
        <button v-if="mobileHome.query" @click="mobileHome.query = ''" type="button" class="ma-launcher__searchclear" aria-label="Xoá tìm kiếm">
          <span class="material-symbols-outlined text-[16px]">close</span>
        </button>
      </div>
      <div class="ma-launcher__actions">
        <button v-if="activeTab" @click="mobileHome.open = false" type="button" class="ma-launcher__action" title="Quay lại tab đang mở">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          <span class="hidden sm:inline">[[ tabTitles[activeTab] || 'Quay lại' ]]</span>
        </button>
        <button @click="openMyProfile" type="button" class="ma-launcher__avatar" aria-label="Hồ sơ của tôi">[[ staffInitial ]]</button>
      </div>
    </header>

    <div class="ma-launcher__body custom-scrollbar">
      {%- comment -%}
        App Launcher V2 (2026-08-22 — Microsoft Store card style). Card lớn nền pastel theo màu
        app; hover ≥180ms → popover xuống dưới hiện tên, chức năng, sub-menu. Mobile không có
        hover (@media hover: none) → popover ẩn, tap card đi thẳng vào tab.

        `ma-launcher-card` component (in-DOM template ngay dưới) render mỗi card + popover riêng
        thay vì bind 3 lần trong template — tránh trùng lặp giữa 3 lưới (Recent/Search/Sections).
      {%- endcomment -%}
      {%- comment -%}
        Recent section CỐ Ý không dùng popover: staff đã dùng qua các app này rồi, không cần
        surface tên/mô tả/sub-menu lại (2026-08-22 rev). Card vẫn có hover-lift + CTA "Mở" như
        các section khác để giữ đồng nhất visual, chỉ khác ở việc không mount popover.
      {%- endcomment -%}
      <section v-if="launcherRecent.length && !mobileHome.query" class="ma-launcher__section">
        <h3 class="ma-launcher__heading">
          <span class="material-symbols-outlined text-[16px]">history</span>Dùng gần đây
        </h3>
        <div class="ma-launcher__cards">
          <div v-for="app in launcherRecent" :key="'r-' + app.key"
               class="ma-launcher__card"
               :style="{ background: launcherAppMeta(app.key).bg, '--ma-lc-acc': launcherAppMeta(app.key).color, '--ma-lc-soft': launcherAppMeta(app.key).soft }">
            <button type="button" class="ma-launcher__card-body" @click="openMobileApp(app.key)">
              <span class="ma-launcher__card-icon">
                <span class="material-symbols-outlined text-[30px]">[[ app.icon ]]</span>
                <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-badge">[[ mobileAppBadge(app.key) ]]</span>
              </span>
              <span class="ma-launcher__card-name">[[ app.label ]]</span>
              <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-status">[[ mobileAppBadge(app.key) ]] cần xử lý</span>
            </button>
          </div>
        </div>
      </section>

      <template v-if="mobileHome.query">
        <section v-if="launcherApps.length" class="ma-launcher__section">
          <h3 class="ma-launcher__heading">Kết quả tìm kiếm · [[ launcherApps.length ]]</h3>
          <div class="ma-launcher__cards">
            <div v-for="app in launcherApps" :key="'q-' + app.key"
                 class="ma-launcher__card"
                 :style="{ background: launcherAppMeta(app.key).bg, '--ma-lc-acc': launcherAppMeta(app.key).color, '--ma-lc-soft': launcherAppMeta(app.key).soft }"
                 @mouseenter="onLauncherEnter(app.key, $event)" @mouseleave="onLauncherLeave()">
              <button type="button" class="ma-launcher__card-body" @click="openMobileApp(app.key)">
                <span class="ma-launcher__card-icon">
                  <span class="material-symbols-outlined text-[30px]">[[ app.icon ]]</span>
                  <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-badge">[[ mobileAppBadge(app.key) ]]</span>
                </span>
                <span class="ma-launcher__card-name">[[ app.label ]]</span>
                <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-status">[[ mobileAppBadge(app.key) ]] cần xử lý</span>
              </button>
            </div>
          </div>
        </section>
        <div v-else class="ma-launcher__empty">
          <span class="material-symbols-outlined text-[40px] opacity-50">search_off</span>
          <p>Không tìm thấy ứng dụng khớp "<b>[[ mobileHome.query ]]</b>"</p>
        </div>
      </template>

      <template v-else>
        <section v-for="sec in launcherSections" :key="sec.key" class="ma-launcher__section">
          <h3 class="ma-launcher__heading">[[ sec.label ]]</h3>
          <div class="ma-launcher__cards">
            <div v-for="app in sec.apps" :key="sec.key + '-' + app.key"
                 class="ma-launcher__card"
                 :style="{ background: launcherAppMeta(app.key).bg, '--ma-lc-acc': launcherAppMeta(app.key).color, '--ma-lc-soft': launcherAppMeta(app.key).soft }"
                 @mouseenter="onLauncherEnter(app.key, $event)" @mouseleave="onLauncherLeave()">
              <button type="button" class="ma-launcher__card-body" @click="openMobileApp(app.key)">
                <span class="ma-launcher__card-icon">
                  <span class="material-symbols-outlined text-[30px]">[[ app.icon ]]</span>
                  <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-badge">[[ mobileAppBadge(app.key) ]]</span>
                </span>
                <span class="ma-launcher__card-name">[[ app.label ]]</span>
                <span v-if="mobileAppBadge(app.key)" class="ma-launcher__card-status">[[ mobileAppBadge(app.key) ]] cần xử lý</span>
              </button>
            </div>
          </div>
        </section>
      </template>
    </div>

    {%- comment -%}
      Single popover instance — position:fixed, toạ độ viewport tính trong onLauncherEnter
      từ card.getBoundingClientRect(). Placement ưu tiên: phải → trái → dưới → trên (bám
      viewport, không bám .ma-launcher__body). z-index 60 cao hơn card hover (40) và cao
      hơn sidebar (55/60) để không bị đè. Sub-menu block v-if — không có sub thì ẩn hẳn,
      popover thu ngắn theo content (grid-template-rows: auto everywhere, không dùng 1fr).
    {%- endcomment -%}
    <div v-if="launcherHoveredKey && launcherHoveredApp()"
         class="ma-launcher__detail"
         :style="{ top: launcherPopPos.top + 'px', left: launcherPopPos.left + 'px',
                   '--ma-lc-acc': launcherAppMeta(launcherHoveredKey).color,
                   '--ma-lc-soft': launcherAppMeta(launcherHoveredKey).soft }"
         @mouseenter="onLauncherEnter(launcherHoveredKey)" @mouseleave="onLauncherLeave()">
      <div class="ma-launcher__detail-head">
        <span class="ma-launcher__detail-icon">
          <span class="material-symbols-outlined text-[22px]">[[ launcherHoveredApp().icon ]]</span>
        </span>
        <div class="min-w-0">
          <div class="ma-launcher__detail-name">[[ launcherHoveredApp().label ]]</div>
          <div class="ma-launcher__detail-cat">[[ launcherGroupLabel(launcherHoveredApp().group) || 'Ứng dụng MOPS' ]]</div>
        </div>
        <button type="button" class="ma-launcher__detail-cta" @click="openMobileApp(launcherHoveredKey)">
          <span class="material-symbols-outlined text-[14px]">arrow_forward</span>Mở
        </button>
      </div>
      <p class="ma-launcher__detail-desc">[[ launcherAppMeta(launcherHoveredKey).desc ]]</p>
      <div v-if="launcherSubMenus(launcherHoveredKey).length" class="ma-launcher__detail-sub">
        <div class="ma-launcher__detail-subhead">Chức năng con</div>
        <div class="ma-launcher__detail-subgrid">
          <button v-for="s in launcherSubMenus(launcherHoveredKey)" :key="'sub-'+launcherHoveredKey+'-'+s.key" type="button"
                  class="ma-launcher__detail-subitem" @click="openMobileAppSub(launcherHoveredKey, s.key)">
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="flex-1">[[ s.label ]]</span>
          </button>
        </div>
      </div>
      <div class="ma-launcher__detail-meta">
        <span>[[ launcherGroupLabel(launcherHoveredApp().group) || 'MOPS' ]]</span>
        <span v-if="mobileAppBadge(launcherHoveredKey)" class="ma-launcher__detail-meta-badge">[[ mobileAppBadge(launcherHoveredKey) ]] cần xử lý</span>
        <span v-else class="ma-launcher__detail-meta-badge ma-launcher__detail-meta-badge--muted">Sẵn sàng</span>
      </div>
    </div>
  </div>

  <div id="ma-sidebar-overlay" :class="{ 'is-open': sidebarOpenMobile }" @click="sidebarOpenMobile = false" class="fixed inset-0 bg-black/40 z-[55] md:hidden"></div>

  
  <aside id="ma-sidebar" :class="{ 'is-open': sidebarOpenMobile }" class="flex flex-col h-full w-[260px] p-stack-md bg-surface-container border-r border-outline-variant md:fixed left-0 top-0 md:h-screen z-[60]">
    <div class="mb-stack-lg px-2 flex items-center justify-between">
      <div class="min-w-0">
        <h1 class="text-headline-md font-black text-primary truncate">MOPS Admin</h1>
        <p class="text-label-md text-on-surface-variant opacity-70 ma-sidebar-label">V2 Administration</p>
      </div>
      <div class="flex items-center gap-1 flex-shrink-0">
        <button @click="sidebarCollapsed = !sidebarCollapsed" class="hidden md:inline-flex p-1 text-on-surface-variant hover:bg-surface-container-high rounded-lg transition-colors" type="button" :aria-label="sidebarCollapsed ? 'Mở rộng menu' : 'Thu gọn menu'">
          <span class="material-symbols-outlined text-[20px]">menu_open</span>
        </button>
        <button @click="sidebarOpenMobile = false" class="md:hidden p-3 text-on-surface-variant" type="button" aria-label="Đóng menu">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>
    <nav class="flex-1 space-y-1 custom-scrollbar">
      <template v-for="entry in groupedNavTabs" :key="entry.type === 'tab' ? entry.tab.key : entry.group.key">
        <a v-if="entry.type === 'tab'" href="#"
          @click.prevent="setActiveTab(entry.tab.key)"
          class="ma-nav-link flex items-center gap-3 px-3 py-2 rounded-lg transition-all"
          :class="activeTab === entry.tab.key ? 'bg-primary-container text-on-primary-container font-bold translate-x-1' : 'text-on-surface-variant hover:bg-surface-container-high'">
          <span class="material-symbols-outlined">[[ entry.tab.icon ]]</span><span class="font-body-md ma-nav-label">[[ entry.tab.label ]]</span>
        </a>
        <div v-else>
          <button type="button" @click="toggleNavGroup(entry.group.key)"
            class="ma-nav-link w-full flex items-center gap-3 px-3 py-2 rounded-lg transition-all"
            :class="entry.hasActiveChild ? 'text-primary font-bold' : 'text-on-surface-variant hover:bg-surface-container-high'">
            <span class="material-symbols-outlined">[[ entry.group.icon ]]</span>
            <span class="font-body-md ma-nav-label flex-1 text-left">[[ entry.group.label ]]</span>
            <span class="material-symbols-outlined ma-nav-label text-[18px] transition-transform"
              :class="{ 'rotate-180': isNavGroupOpen(entry.group.key) }">expand_more</span>
          </button>
          <div v-show="isNavGroupOpen(entry.group.key)" class="ma-nav-subgroup flex flex-col gap-1 mt-1 mb-1 ml-4 pl-4 border-l border-outline-variant">
            <a v-for="child in entry.children" :key="child.key" href="#"
              @click.prevent="activateNavChild(child)"
              :title="child.label"
              class="ma-nav-link flex min-w-0 items-center gap-3 px-3 py-2 rounded-lg transition-all"
              :class="isNavChildActive(child) ? 'bg-primary-container text-on-primary-container font-bold translate-x-1' : 'text-on-surface-variant hover:bg-surface-container-high'">
              <span class="material-symbols-outlined flex-shrink-0 text-[18px]">[[ child.icon ]]</span><span class="font-body-md ma-nav-label min-w-0 flex-1 truncate">[[ child.label ]]</span>
            </a>
          </div>
        </div>
      </template>
    </nav>

    
    <div class="mt-auto pt-2 border-t border-outline-variant">
      <div class="flex items-center gap-2 px-1 py-2">
        <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold flex-shrink-0 text-body-sm">[[ staffInitial ]]</div>
        <div class="ma-sidebar-label flex-1 min-w-0 leading-tight">
          <p class="text-label-md font-bold truncate">[[ (staff && (staff.name || staff.username)) || '—' ]]</p>
          <p class="text-body-sm opacity-60 truncate">[[ (staff && staff.role || '—').toUpperCase() ]]</p>
        </div>
        <button @click="openMyProfile" type="button" class="ma-sidebar-label p-2 text-on-surface-variant hover:bg-surface-container-high hover:text-primary rounded-full transition-colors flex-shrink-0" aria-label="Hồ sơ của tôi" title="Hồ sơ của tôi">
          <span class="material-symbols-outlined text-[18px]">edit</span>
        </button>
        <button @click="doLogout" type="button" class="ma-sidebar-label p-2 text-on-surface-variant hover:bg-surface-container-high hover:text-error rounded-full transition-colors flex-shrink-0" aria-label="Đăng xuất" title="Đăng xuất">
          <span class="material-symbols-outlined text-[18px]">logout</span>
        </button>
      </div>
    </div>
  </aside>

  
  <main class="flex-1 overflow-hidden md:ml-[260px] flex flex-col min-h-screen">
    <header class="fixed top-0 left-0 md:left-[260px] right-0 z-40 h-[72px] flex items-center justify-between gap-3 py-3 px-margin-mobile md:px-margin-desktop bg-surface-container-lowest shadow-sm border-b border-outline-variant">
      <div class="flex items-center gap-3 min-w-0 flex-shrink-0">
        <button @click="sidebarOpenMobile = true" class="md:hidden p-3 hover:bg-surface-container-low rounded-full transition-colors flex-shrink-0" type="button" aria-label="Mở menu">
          <span class="material-symbols-outlined">menu</span>
        </button>
        
        {%- comment -%}
          Nút "Ứng dụng" — 2026-08-21: hiện ở MỌI kích thước (bỏ md:hidden). Trước đây chỉ mobile
          vì Springboard cũ .ma-spring cũng md:hidden. Sau khi unify App Launcher (goMobileHome
          mở launcher toàn màn hình mọi breakpoint) → nút này cũng phải hiện trên desktop, nếu
          không staff desktop không có cách quay về launcher grid.
        {%- endcomment -%}
        <button @click="openLauncher" class="p-3 hover:bg-surface-container-low rounded-full transition-colors flex-shrink-0" type="button" title="Mở lưới ứng dụng" aria-label="Mở lưới ứng dụng">
          <span class="material-symbols-outlined">apps</span>
        </button>
        <nav class="hidden sm:flex items-center gap-1 leading-none">
          <span class="text-headline-md font-bold text-primary">[[ tabTitle ]]</span>
        </nav>
      </div>

      <div class="flex-1 max-w-md hidden md:block">
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
          <input v-model="globalSearch" @keydown.enter="submitGlobalSearch" type="text" placeholder="Tìm khách hàng theo số điện thoại… (tìm đơn hàng thì dùng ô lọc trong tab Đơn hàng)"
            class="w-full h-9 pl-9 pr-3 bg-surface-container border border-outline-variant rounded-lg text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
        </div>
      </div>

      <div class="flex items-center gap-2 md:gap-3 flex-shrink-0">
        <div class="flex items-center gap-2">
          <!-- Quick-add "Tạo đơn" luôn hiển thị ở header, mọi tab (2026-08-05). Là thao tác dùng
               nhiều nhất — không cần vào tab Đơn hàng trước. openManualOrderForm() tự setActiveTab
               sang 'orders' để form được render đúng workspaceView. -->
          <button @click="openManualOrderForm" type="button" :disabled="!paymentConfigured"
            :title="!paymentConfigured ? 'Cần cấu hình tài khoản ngân hàng nhận tiền trước (tab Cấu hình)' : 'Tạo đơn hàng thủ công (F9 để submit trong form)'"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:opacity-40">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Tạo đơn</span>
          </button>
          <button v-if="activeTab === 'products'" @click="products.showAddForm = true" type="button"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Thêm sản phẩm</span>
          </button>
          <button v-if="activeTab === 'products'" @click="confirmSyncProducts" :disabled="products.syncing" type="button"
            class="flex items-center gap-2 bg-surface-container-lowest text-on-surface border border-outline-variant px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:bg-surface-container-low transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]" :class="{ 'ma-spin': products.syncing }">sync</span><span class="hidden sm:inline">[[ products.syncing ? 'Đang đồng bộ…' : 'Đồng bộ từ SAPO' ]]</span>
          </button>
          <button v-if="activeTab === 'staff'" @click="openAddStaffForm" type="button"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Thêm nhân viên</span>
          </button>
          <button v-if="activeTab === 'branches'" @click="branches.showAddForm = true" type="button"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Thêm chi nhánh</span>
          </button>
          <button v-if="activeTab === 'coupons'" @click="openCouponAddForm()" type="button"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Thêm mã giảm giá</span>
          </button>
          <button v-if="activeTab === 'finance'" @click="finance.showAddForm = true" type="button"
            class="flex items-center gap-2 bg-primary text-on-primary px-3 md:px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Thêm giao dịch</span>
          </button>
        </div>
        <button @click="setActiveTab('notifications')" type="button" class="relative p-3 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-colors" aria-label="Đi tới Thông báo">
          <span class="material-symbols-outlined">notifications</span>
        </button>
      </div>
    </header>

    <div class="flex-1 pt-[72px] p-2 mt-2 pb-margin-mobile md:pb-margin-desktop overflow-auto custom-scrollbar">

      
      <div v-if="!paymentConfigured" class="flex flex-wrap items-center gap-3 mb-stack-lg p-4 rounded-xl border border-error bg-error-container text-on-error-container">
        <span class="material-symbols-outlined flex-shrink-0">warning</span>
        <p class="flex-1 min-w-[220px] text-body-sm font-semibold">Chưa cấu hình tài khoản ngân hàng nhận tiền — mọi đơn hàng mới sẽ không tạo được mã QR thanh toán.</p>
        <button v-if="isOwner" @click="setActiveTab('settings')" type="button"
          class="flex-shrink-0 bg-on-error-container text-error-container px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
          Cấu hình ngay
        </button>
        <span v-else class="flex-shrink-0 text-label-md font-semibold opacity-80">Liên hệ quản trị viên (OWNER) để cấu hình</span>
      </div>

      
      {% include 'mops_admin_tab_overview' %}

      
      {% include 'mops_admin_tab_orders' %}

      {% include 'mops_admin_tab_shipping' %}

      
      {% include 'mops_admin_tab_products' %}

      
      {% include 'mops_admin_tab_customers' %}

      
      {% include 'mops_admin_tab_finance' %}

      
      {% include 'mops_admin_tab_inventory' %}

      
      {% include 'mops_admin_tab_notifications' %}

      
      {% include 'mops_admin_tab_audit' %}

      
      {% include 'mops_admin_tab_staff' %}

      {% include 'mops_admin_tab_master_oms' %}

      {% include 'mops_admin_tab_waybill_detail' %}

      {% include 'mops_admin_tab_ghtk_hub' %}

      {% include 'mops_admin_tab_signing' %}


      {% include 'mops_admin_tab_branches' %}

      
      {% include 'mops_admin_tab_coupons' %}

      {% include 'mops_admin_tab_b2b' %}


      {% include 'mops_admin_tab_settings' %}

    </div>
  </main>

  
  <div v-if="myProfile.open" @click="myProfile.open = false" class="ma-modal-backdrop"></div>
  <div v-if="myProfile.open" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Hồ sơ của tôi</h3>
      <button @click="myProfile.open = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <p class="text-body-sm text-on-surface-variant opacity-70 mb-stack-md">Bỏ trống trường nào không muốn đổi — chỉ trường bạn điền mới được lưu.</p>
    <div class="space-y-stack-md">
      <div>
        <label class="ma-label">Tên hiển thị</label>
        <input type="text" v-model="myProfile.form.name" :placeholder="staff && staff.name" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Telegram Chat ID</label>
        <input type="text" v-model="myProfile.form.telegram" placeholder="vd: 123456789" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Ghi chú</label>
        <input type="text" v-model="myProfile.form.notes" class="ma-input">
      </div>
      <div class="pt-2 border-t border-outline-variant">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Đổi mật khẩu (tuỳ chọn)</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
          <div>
            <label class="ma-label">Mật khẩu hiện tại</label>
            <input type="password" v-model="myProfile.form.currentPassword" placeholder="••••••••" class="ma-input">
          </div>
          <div>
            <label class="ma-label">Mật khẩu mới</label>
            <input type="password" v-model="myProfile.form.newPassword" placeholder="Ít nhất 8 ký tự" class="ma-input">
          </div>
        </div>
      </div>
    </div>
    <div class="flex gap-2 mt-stack-lg">
      <button @click="saveMyProfile" :disabled="myProfile.saving" type="button" class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">[[ myProfile.saving ? 'Đang lưu…' : 'Lưu hồ sơ' ]]</button>
      <button @click="myProfile.open = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>
</div>

  

  
  <div v-if="products.showAddForm" @click="products.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="products.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm sản phẩm mới</h3>
      <button @click="products.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-modal-body">
      <p class="text-body-sm text-on-surface-variant mb-stack-md">Tạo sản phẩm cục bộ trong MOPS — không cần tồn tại trên SAPO. Dùng cho dịch vụ phát sinh hoặc khi chưa cấu hình đồng bộ SAPO.</p>
      <div class="ma-form-grid-2">
      <div class="md:col-span-2">
        <label class="ma-label">Tên sản phẩm *</label>
        <input type="text" v-model="products.newProduct.title" placeholder="Dịch vụ chăm sóc da cơ bản" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Giá bán (VNĐ) *</label>
        <input type="number" min="0" v-model="products.newProduct.price" placeholder="200000" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tiền cọc (VNĐ)</label>
        <input type="number" min="0" v-model="products.newProduct.deposit" placeholder="0" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Giá vốn (VNĐ) <span class="ma-text-hint">(tuỳ chọn — dùng cho báo cáo lãi lỗ)</span></label>
        <input type="number" min="0" v-model="products.newProduct.costPrice" placeholder="0" class="ma-input">
      </div>
      <div>
        <label class="ma-label">SKU <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="products.newProduct.sku" placeholder="SKU-001" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Ảnh đại diện <span class="ma-text-hint">(URL ảnh Sapo/CDN, tuỳ chọn)</span></label>
        <div class="flex flex-wrap items-start gap-3">
          <div v-if="products.newProduct.imagePreview" class="relative flex-shrink-0">
            <img :src="products.newProduct.imagePreview" alt="Xem trước ảnh sản phẩm" class="w-20 h-20 rounded-lg object-cover border border-outline-variant">
            <span v-if="products.newProduct.imagePreparing" class="absolute inset-0 flex items-center justify-center rounded-lg bg-black/40 text-white"><span class="material-symbols-outlined ma-spin">progress_activity</span></span>
          </div>
          <div class="flex-1 min-w-[220px] space-y-2">
            <input type="text" v-model="products.newProduct.image" placeholder="https://..." class="ma-input">
            <label class="inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-outline-variant font-bold text-label-md cursor-pointer hover:bg-surface-container-high">
              <span class="material-symbols-outlined text-[18px]">image</span>Chọn ảnh máy tính
              <input type="file" accept="image/*" @change="onNewProductImageFile" class="hidden">
            </label>
            <p class="text-label-sm text-on-surface-variant">Ảnh phải dưới 5 MB. Ảnh chọn từ máy chỉ xem trước và nén tại trình duyệt; hãy dán URL ảnh đã tải lên Sapo/CDN để lưu vào sản phẩm.</p>
          </div>
        </div>
      </div>
      </div>

      <div class="mt-stack-md pt-stack-md border-t border-outline-variant">
      <label class="ma-label">Thông tin nâng cao <span class="font-normal opacity-60">(tuỳ chọn — khớp đủ các cột trong Products/ProductMappings, xem docs/mops.md §1)</span></label>
      <div class="ma-form-grid-2">
        <div>
          <label class="ma-label-sm">Giá gốc (VNĐ) <span class="font-normal opacity-60">(để hiện badge giảm giá — phải &gt; Giá bán)</span></label>
          <input type="number" min="0" v-model="products.newProduct.compareAtPrice" placeholder="0" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Thương hiệu</label>
          <input type="text" v-model="products.newProduct.vendor" placeholder="MOPS Local" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Loại sản phẩm</label>
          <input type="text" v-model="products.newProduct.productType" placeholder="Dịch vụ / Sản phẩm..." class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Đơn vị tính</label>
          <input type="text" v-model="products.newProduct.unit" placeholder="cái / hộp / chai / kg..." class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Khối lượng (kg) <span class="font-normal opacity-60">(để phân bổ chi phí khi nhập hàng theo trọng lượng)</span></label>
          <input type="number" min="0" step="0.01" v-model="products.newProduct.weight" placeholder="0" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Mã vạch</label>
          <input type="text" v-model="products.newProduct.barcode" placeholder="8936..." class="ma-input">
        </div>
        <div class="md:col-span-2 flex items-center gap-2">
          <input type="checkbox" id="newProductRequiresShipping" v-model="products.newProduct.requiresShipping" class="w-4 h-4">
          <label for="newProductRequiresShipping" class="text-label-sm text-on-surface-variant">Cần vận chuyển vật lý <span class="font-normal opacity-60">(bỏ trống nếu là dịch vụ)</span></label>
        </div>
      </div>
      </div>
    </div>

    <div class="ma-modal-foot">
      <button @click="createLocalProduct" :disabled="products.creating" type="button" class="ma-btn-primary">[[ products.creating ? 'Đang tạo...' : 'Tạo sản phẩm' ]]</button>
      <button @click="products.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="finance.showAddForm" @click="finance.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="finance.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm giao dịch</h3>
      <button @click="finance.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div class="md:col-span-2">
        <label class="ma-label">Loại *</label>
        <div class="flex items-center rounded-lg border border-outline-variant overflow-hidden w-fit">
          <button @click="finance.newTx.type = 'EXPENSE'; onFinanceTypeChange()" type="button" class="px-4 py-2 text-body-sm font-bold transition-all" :class="finance.newTx.type === 'EXPENSE' ? 'bg-red-600 text-white' : 'bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-low'">Khoản chi</button>
          <button @click="finance.newTx.type = 'INCOME'; onFinanceTypeChange()" type="button" class="px-4 py-2 text-body-sm font-bold transition-all" :class="finance.newTx.type === 'INCOME' ? 'bg-emerald-600 text-white' : 'bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-low'">Khoản thu khác</button>
        </div>
      </div>
      <div>
        <label class="ma-label">Danh mục *</label>
        <select v-model="finance.newTx.category" class="ma-input">
          <option value="" disabled>— Chọn danh mục —</option>
          <option v-for="cat in financeCategoriesForType" :key="cat" :value="cat">[[ cat ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Số tiền (VNĐ) *</label>
        <input type="number" min="0" v-model="finance.newTx.amount" placeholder="500000" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tài khoản/Nguồn tiền <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="finance.newTx.account" placeholder="Tiền mặt" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tham chiếu <span class="ma-text-hint">(mã đơn, nhà cung cấp... tuỳ chọn)</span></label>
        <input type="text" v-model="finance.newTx.reference" placeholder="MOPS0042 / Cty ABC" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Ghi chú <span class="ma-text-hint">(nội bộ, tuỳ chọn)</span></label>
        <input type="text" v-model="finance.newTx.note" placeholder="Tiền điện tháng 7..." class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitCashTransaction" :disabled="finance.submitting" type="button" class="ma-btn-primary">[[ finance.submitting ? 'Đang lưu...' : 'Lưu giao dịch' ]]</button>
      <button @click="finance.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="financeCore.accounts.showAddForm" @click="financeCore.accounts.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="financeCore.accounts.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm tài khoản / quỹ</h3>
      <button @click="financeCore.accounts.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tên tài khoản *</label>
        <input type="text" v-model="financeCore.accounts.newAccount.name" placeholder="Quỹ tiền mặt / Vietcombank..." class="ma-input">
      </div>
      <div>
        <label class="ma-label">Loại</label>
        <select v-model="financeCore.accounts.newAccount.type" class="ma-input">
          <option value="CASH">Tiền mặt</option>
          <option value="BANK">Ngân hàng</option>
          <option value="EWALLET">Ví điện tử</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Chi nhánh <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="financeCore.accounts.newAccount.branch" class="ma-input">
          <option value="">— Không gắn chi nhánh —</option>
          <option v-for="b in activeBranches" :key="b.branch_id" :value="b.branch_id">[[ b.name_vi ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Số dư đầu kỳ (VNĐ) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="number" min="0" v-model="financeCore.accounts.newAccount.opening_balance" placeholder="0" class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="createCashAccount" :disabled="financeCore.accounts.submitting" type="button" class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">[[ financeCore.accounts.submitting ? 'Đang lưu…' : 'Tạo tài khoản' ]]</button>
      <button @click="financeCore.accounts.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="financeCore.receipts.showAddForm" @click="financeCore.receipts.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="financeCore.receipts.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Lập Phiếu Thu</h3>
      <button @click="financeCore.receipts.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tài khoản nhận *</label>
        <select v-model="financeCore.receipts.newReceipt.account_id" class="ma-input">
          <option value="" disabled>— Chọn tài khoản —</option>
          <option v-for="a in financeCore.accounts.list" :key="a.account_id" :value="a.account_id">[[ a.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Danh mục *</label>
        <select v-model="financeCore.receipts.newReceipt.category_id" class="ma-input">
          <option value="" disabled>— Chọn danh mục —</option>
          <option v-for="c in financeCore.receipts.categories" :key="c.category_id" :value="c.category_id">[[ c.group ]] — [[ c.name ]]</option>
        </select>
        <button v-if="!financeCore.receipts.showAddCategory" @click="financeCore.receipts.showAddCategory = true" type="button" class="text-label-md text-primary font-bold mt-1 hover:underline">+ Thêm danh mục mới</button>
        <div v-else class="flex flex-wrap items-end gap-2 mt-2 p-2 bg-surface-container-low rounded-lg">
          <input type="text" v-model="financeCore.receipts.newCategory.group" placeholder="Nhóm (vd: Doanh thu)" class="w-[140px] bg-surface-container-lowest border border-outline-variant rounded-lg px-2 py-1.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
          <input type="text" v-model="financeCore.receipts.newCategory.name" placeholder="Tên (vd: Bán dịch vụ)" class="w-[140px] bg-surface-container-lowest border border-outline-variant rounded-lg px-2 py-1.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
          <button @click="createFinanceCategory('INCOME')" :disabled="financeCore.receipts.categorySaving" type="button" class="px-2.5 py-1.5 rounded-lg text-label-md text-white bg-primary hover:opacity-90 transition-all">Lưu</button>
          <button @click="financeCore.receipts.showAddCategory = false" type="button" class="px-2.5 py-1.5 rounded-lg text-label-md border border-outline-variant hover:bg-surface-container-lowest transition-all">Huỷ</button>
        </div>
      </div>
      <div>
        <label class="ma-label">Số tiền (VNĐ) *</label>
        <input type="number" min="0" v-model="financeCore.receipts.newReceipt.amount" placeholder="500000" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Người nộp <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="financeCore.receipts.newReceipt.party_id" placeholder="Nguyễn Văn A" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Diễn giải <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="financeCore.receipts.newReceipt.note" placeholder="Thu tiền mặt tại quầy..." class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitReceipt" :disabled="financeCore.receipts.submitting" type="button" class="ma-btn-primary">[[ financeCore.receipts.submitting ? 'Đang lưu...' : 'Lưu Phiếu Thu (Draft)' ]]</button>
      <button @click="financeCore.receipts.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="financeCore.vouchers.showAddForm" @click="financeCore.vouchers.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="financeCore.vouchers.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Lập Phiếu Chi</h3>
      <button @click="financeCore.vouchers.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tài khoản chi *</label>
        <select v-model="financeCore.vouchers.newVoucher.account_id" class="ma-input">
          <option value="" disabled>— Chọn tài khoản —</option>
          <option v-for="a in financeCore.accounts.list" :key="a.account_id" :value="a.account_id">[[ a.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Danh mục *</label>
        <select v-model="financeCore.vouchers.newVoucher.category_id" class="ma-input">
          <option value="" disabled>— Chọn danh mục —</option>
          <option v-for="c in financeCore.vouchers.categories" :key="c.category_id" :value="c.category_id">[[ c.group ]] — [[ c.name ]]</option>
        </select>
        <button v-if="!financeCore.vouchers.showAddCategory" @click="financeCore.vouchers.showAddCategory = true" type="button" class="text-label-md text-primary font-bold mt-1 hover:underline">+ Thêm danh mục mới</button>
        <div v-else class="flex flex-wrap items-end gap-2 mt-2 p-2 bg-surface-container-low rounded-lg">
          <input type="text" v-model="financeCore.vouchers.newCategory.group" placeholder="Nhóm (vd: Vận hành)" class="w-[140px] bg-surface-container-lowest border border-outline-variant rounded-lg px-2 py-1.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
          <input type="text" v-model="financeCore.vouchers.newCategory.name" placeholder="Tên (vd: Tiền điện)" class="w-[140px] bg-surface-container-lowest border border-outline-variant rounded-lg px-2 py-1.5 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
          <button @click="createFinanceCategory('EXPENSE')" :disabled="financeCore.vouchers.categorySaving" type="button" class="px-2.5 py-1.5 rounded-lg text-label-md text-white bg-primary hover:opacity-90 transition-all">Lưu</button>
          <button @click="financeCore.vouchers.showAddCategory = false" type="button" class="px-2.5 py-1.5 rounded-lg text-label-md border border-outline-variant hover:bg-surface-container-lowest transition-all">Huỷ</button>
        </div>
      </div>
      <div>
        <label class="ma-label">Số tiền (VNĐ) *</label>
        <input type="number" min="0" v-model="financeCore.vouchers.newVoucher.amount" placeholder="500000" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Người nhận <span class="ma-text-hint">(tuỳ chọn — nhập PartyID nhà cung cấp để lọc Bill bên dưới)</span></label>
        <input type="text" v-model="financeCore.vouchers.newVoucher.party_id" placeholder="Nguyễn Văn B / PTY00001" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Trả cho Bill (công nợ NCC) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="financeCore.vouchers.newVoucher.bill_id" :disabled="!!financeCore.vouchers.newVoucher.purchase_order_id" @change="financeCore.vouchers.newVoucher.purchase_order_id = ''" class="ma-input disabled:opacity-50">
          <option value="">— Không liên quan Bill —</option>
          <option v-for="b in openBillsForVoucher" :key="b.bill_id" :value="b.bill_id">[[ supplierName(b.party_id) ]] · [[ b.bill_id ]] — còn nợ [[ formatMoney(b.remaining_amount) ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Cọc trước Phiếu nhập hàng <span class="ma-text-hint">(chưa Post, tuỳ chọn)</span></label>
        <select v-model="financeCore.vouchers.newVoucher.purchase_order_id" :disabled="!!financeCore.vouchers.newVoucher.bill_id" @change="financeCore.vouchers.newVoucher.bill_id = ''" class="ma-input disabled:opacity-50">
          <option value="">— Không liên quan cọc trước —</option>
          <option v-for="po in openDepositPOsForVoucher" :key="po.purchase_order_id" :value="po.purchase_order_id">[[ po.purchase_order_id ]] — [[ supplierName(po.supplier_id) ]] (cọc [[ formatMoney(po.deposit_amount) ]])</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Diễn giải <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="financeCore.vouchers.newVoucher.note" placeholder="Chi tiền điện tháng 7..." class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Chứng từ đính kèm <span class="ma-text-hint">(URL, tuỳ chọn)</span></label>
        <input type="text" v-model="financeCore.vouchers.newVoucher.attachment_url" placeholder="Link Google Drive ảnh hoá đơn..." class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitVoucher" :disabled="financeCore.vouchers.submitting" type="button" class="ma-btn-primary">[[ financeCore.vouchers.submitting ? 'Đang lưu...' : 'Lưu Phiếu Chi (Draft)' ]]</button>
      <button @click="financeCore.vouchers.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="financeCore.transfers.showAddForm" @click="financeCore.transfers.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="financeCore.transfers.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Chuyển quỹ giữa 2 tài khoản</h3>
      <button @click="financeCore.transfers.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Từ tài khoản *</label>
        <select v-model="financeCore.transfers.newTransfer.from_account_id" class="ma-input">
          <option value="" disabled>— Chọn tài khoản —</option>
          <option v-for="a in financeCore.accounts.list" :key="a.account_id" :value="a.account_id">[[ a.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Đến tài khoản *</label>
        <select v-model="financeCore.transfers.newTransfer.to_account_id" class="ma-input">
          <option value="" disabled>— Chọn tài khoản —</option>
          <option v-for="a in financeCore.accounts.list" :key="a.account_id" :value="a.account_id">[[ a.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Số tiền (VNĐ) *</label>
        <input type="number" min="0" v-model="financeCore.transfers.newTransfer.amount" placeholder="1000000" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Ghi chú <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="financeCore.transfers.newTransfer.note" placeholder="Nộp tiền mặt vào ngân hàng..." class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="createTransfer" :disabled="financeCore.transfers.submitting" type="button" class="ma-btn-primary">[[ financeCore.transfers.submitting ? 'Đang lưu...' : 'Lưu Chuyển quỹ (Draft)' ]]</button>
      <button @click="financeCore.transfers.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="financeCore.adjustments.showAddForm" @click="financeCore.adjustments.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="financeCore.adjustments.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Điều chỉnh quỹ</h3>
      <button @click="financeCore.adjustments.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <p class="text-body-sm text-on-surface-variant mb-stack-md">Dùng khi kiểm kê quỹ tiền mặt lệch thực tế. Luôn phải qua Gửi duyệt → Duyệt → Post — không có đường tắt.</p>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tài khoản *</label>
        <select v-model="financeCore.adjustments.newAdjustment.account_id" class="ma-input">
          <option value="" disabled>— Chọn tài khoản —</option>
          <option v-for="a in financeCore.accounts.list" :key="a.account_id" :value="a.account_id">[[ a.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Chiều điều chỉnh *</label>
        <div class="flex items-center rounded-lg border border-outline-variant overflow-hidden">
          <button @click="financeCore.adjustments.newAdjustment.direction = 'DECREASE'" type="button" class="px-4 py-2 text-body-sm font-bold transition-all" :class="financeCore.adjustments.newAdjustment.direction === 'DECREASE' ? 'bg-red-600 text-white' : 'bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-low'">Giảm quỹ</button>
          <button @click="financeCore.adjustments.newAdjustment.direction = 'INCREASE'" type="button" class="px-4 py-2 text-body-sm font-bold transition-all" :class="financeCore.adjustments.newAdjustment.direction === 'INCREASE' ? 'bg-emerald-600 text-white' : 'bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-low'">Tăng quỹ</button>
        </div>
      </div>
      <div>
        <label class="ma-label">Số tiền (VNĐ) *</label>
        <input type="number" min="0" v-model="financeCore.adjustments.newAdjustment.amount" placeholder="200000" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Lý do điều chỉnh * <span class="ma-text-hint">(bắt buộc)</span></label>
        <input type="text" v-model="financeCore.adjustments.newAdjustment.reason" placeholder="Kiểm kê tiền mặt cuối ngày lệch thực tế..." class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="createAdjustment" :disabled="financeCore.adjustments.submitting" type="button" class="ma-btn-primary">[[ financeCore.adjustments.submitting ? 'Đang lưu...' : 'Lưu Điều chỉnh (Draft)' ]]</button>
      <button @click="financeCore.adjustments.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="branches.showAddForm" @click="branches.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="branches.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm chi nhánh</h3>
      <button @click="branches.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div class="md:col-span-2">
        <label class="ma-label">Tên chi nhánh (Tiếng Việt) *</label>
        <input type="text" v-model="branches.newBranch.name_vi" placeholder="Chi nhánh Quận 1" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tên chi nhánh (Tiếng Anh) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.newBranch.name_en" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Điện thoại <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.newBranch.phone" placeholder="0901234567" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Email <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.newBranch.email" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.newBranch.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="branches.newBranch.province" @change="onProvinceChange(branches.newBranch)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="branches.newBranch.ward" :disabled="!branches.newBranch.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(branches.newBranch.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Mã số thuế <span class="ma-text-hint">(tuỳ chọn — trống nếu dùng chung MST công ty)</span></label>
        <input type="text" v-model="branches.newBranch.tax_code" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tài khoản ngân hàng nhận tiền <span class="ma-text-hint">(tuỳ chọn — trống = dùng theo chi nhánh chính)</span></label>
        <select v-model="branches.newBranch.default_bank_account_id" class="ma-input">
          <option value="">Theo chi nhánh chính / mặc định</option>
          <option v-for="a in activeBankAccounts" :key="a.bank_account_id" :value="a.bank_account_id">[[ a.bank_code ]] · [[ a.account_no ]] — [[ a.account_name ]]</option>
        </select>
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitBranch" :disabled="branches.submitting" type="button" class="ma-btn-primary">[[ branches.submitting ? 'Đang lưu...' : 'Lưu chi nhánh' ]]</button>
      <button @click="branches.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="branches.showEditForm" @click="branches.showEditForm = false" class="ma-modal-backdrop"></div>
  <div v-if="branches.showEditForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Sửa chi nhánh</h3>
      <button @click="branches.showEditForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div class="md:col-span-2">
        <label class="ma-label">Tên chi nhánh (Tiếng Việt) *</label>
        <input type="text" v-model="branches.editForm.name_vi" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tên chi nhánh (Tiếng Anh) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.name_en" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Điện thoại <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.phone" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Email <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.email" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="branches.editForm.province" @change="onProvinceChange(branches.editForm)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="branches.editForm.ward" :disabled="!branches.editForm.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(branches.editForm.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Mã số thuế <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.tax_code" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tài khoản ngân hàng nhận tiền <span class="ma-text-hint">(trống = dùng theo chi nhánh chính)</span></label>
        <select v-model="branches.editForm.default_bank_account_id" class="ma-input">
          <option value="">Theo chi nhánh chính / mặc định</option>
          <option v-for="a in activeBankAccounts" :key="a.bank_account_id" :value="a.bank_account_id">[[ a.bank_code ]] · [[ a.account_no ]] — [[ a.account_name ]]</option>
        </select>
      </div>


      <div class="md:col-span-2 pt-3 border-t border-outline-variant">
        <div class="flex items-center gap-2 mb-3">
          <span class="material-symbols-outlined text-primary">warehouse</span>
          <div class="text-label-md font-bold uppercase tracking-wider text-on-surface-variant">Kho lấy hàng (multi-warehouse)</div>
          <span class="ma-badge ma-badge--info" style="padding:1px 6px;font-size:10px;">Tuỳ chọn</span>
        </div>
        <p class="text-body-sm text-on-surface-variant opacity-70 mb-2">Địa chỉ shipper hãng vận chuyển đến lấy hàng cho đơn xuất từ chi nhánh này. Bỏ trống nếu chi nhánh không giữ kho (bán tại quầy hoặc dropship).</p>
      </div>
      <div>
        <label class="ma-label-sm">Người liên hệ tại kho</label>
        <input type="text" v-model="branches.editForm.pick_receiver_name" placeholder="Nguyễn Văn A" class="ma-input">
      </div>
      <div>
        <label class="ma-label-sm">SĐT kho (shipper gọi trước)</label>
        <input type="tel" v-model="branches.editForm.pick_phone" placeholder="0912345678" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label-sm">Số nhà / Đường kho</label>
        <input type="text" v-model="branches.editForm.pick_address" placeholder="217A Phạm Viết Chánh" class="ma-input">
      </div>
      <div>
        <label class="ma-label-sm">Tỉnh/Thành kho</label>
        <select v-model="branches.editForm.pick_province_code" @change="onBranchPickProvinceChange(branches.editForm)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành</option>
          <option v-for="p in branchPickProvinces()" :key="p.c" :value="p.c">[[ p.n ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label-sm">Quận/Huyện kho</label>
        <select v-model="branches.editForm.pick_district_code" :disabled="!branches.editForm.pick_province_code" @change="onBranchPickDistrictChange(branches.editForm)" class="ma-input">
          <option value="" disabled>Chọn quận/huyện</option>
          <option v-for="d in branchPickDistrictsFor(branches.editForm.pick_province_code)" :key="d.c" :value="d.c">[[ d.n ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label-sm">Phường/Xã kho</label>
        <select v-model="branches.editForm.pick_ward_code" :disabled="!branches.editForm.pick_district_code" @change="onBranchPickWardChange(branches.editForm)" class="ma-input">
          <option value="" disabled>Chọn phường/xã</option>
          <option v-for="w in branchPickWardsFor(branches.editForm.pick_district_code)" :key="w.c" :value="w.c">[[ w.n ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label-sm">Ghi chú cho shipper <span class="ma-text-hint">(giờ lấy hàng, cổng vào, v.v.)</span></label>
        <input type="text" v-model="branches.editForm.pick_notes" placeholder="Giờ lấy 8h-17h. Cổng chính. Gọi trước 15 phút." class="ma-input" maxlength="200">
      </div>


      <div class="md:col-span-2 pt-2 mt-2 border-t border-dashed border-outline-variant">
        <div class="text-label-sm font-bold uppercase tracking-wider text-on-surface-variant mb-1">Liên kết hãng vận chuyển</div>
        <p class="text-label-sm text-on-surface-variant opacity-60 mb-2">Điền ID sau khi đăng ký kho ở dashboard từng hãng. Trống = hãng đó chưa hỗ trợ lấy tại kho này (xem <code style="font-family:ui-monospace;background:var(--ma-subtle);padding:1px 4px;border-radius:3px;font-size:11px">docs/backend-multiwarehouse-stub.md §4</code>).</p>
      </div>
      <div>
        <label class="ma-label-sm">GHN Shop ID</label>
        <input type="number" v-model.number="branches.editForm.ghn_shop_id" placeholder="192837" class="ma-input">
      </div>
      <div>
        <label class="ma-label-sm">GHTK Pick Address ID</label>
        <input type="text" v-model="branches.editForm.ghtk_pick_address_id" placeholder="26743_2" class="ma-input">
      </div>
      <div>
        <label class="ma-label-sm">Goship Shop ID <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="branches.editForm.goship_shop_id" placeholder="Để trống = dùng shop mặc định" class="ma-input">
      </div>
      <div>
        <label class="ma-label-sm">VNPost Customer Code</label>
        <input type="text" v-model="branches.editForm.vnpost_customer_code" placeholder="KH000123" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label-sm">ViettelPost Source ID <span class="ma-text-hint">(tuỳ chọn — VTP gửi địa chỉ raw)</span></label>
        <input type="text" v-model="branches.editForm.viettelpost_source_id" placeholder="Để trống nếu chưa cần" class="ma-input">
      </div>


      <div class="md:col-span-2 pt-2 mt-2 border-t border-dashed border-outline-variant">
        <div class="flex items-center gap-2 mb-1">
          <span class="material-symbols-outlined text-[16px]" style="color:#7c3aed">local_shipping</span>
          <div class="text-label-sm font-bold uppercase tracking-wider" style="color:#7c3aed">Goship — Địa chỉ lấy hàng (dynamic origin)</div>
        </div>
        <p class="text-label-sm text-on-surface-variant opacity-70 mb-2">Chọn Tỉnh/Quận/Xã theo bộ mã Goship (khác GSO). Backend sẽ nhúng thẳng address_from vào <code style="font-family:ui-monospace;background:var(--ma-subtle);padding:1px 4px;border-radius:3px;font-size:11px">/rates</code> và <code style="font-family:ui-monospace;background:var(--ma-subtle);padding:1px 4px;border-radius:3px;font-size:11px">/shipments</code> — không cần đăng ký kho trên Goship dashboard. Bỏ trống = fallback SETTINGS.GOSHIP_FROM_* (default account-level).</p>
      </div>
      <div>
        <label class="ma-label-sm">Goship Tỉnh/TP</label>
        <select v-model="branches.editForm.goship_from_city" @change="onBranchGoshipCityChange(branches.editForm)" @focus="loadBranchGoshipCities" class="ma-input">
          <option value="">— Bỏ trống dùng SETTINGS default —</option>
          <option v-for="c in branchGoshipCities()" :key="c.id || c.code" :value="String(c.id || c.code)">[[ c.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label-sm">Goship Quận/Huyện</label>
        <select v-model="branches.editForm.goship_from_district" @change="onBranchGoshipDistrictChange(branches.editForm)" :disabled="!branches.editForm.goship_from_city" class="ma-input disabled:opacity-50">
          <option value="">[[ branches.editForm.goship_from_city ? '— Chọn quận —' : 'Chọn Tỉnh trước' ]]</option>
          <option v-for="d in branchGoshipDistricts(branches.editForm.goship_from_city)" :key="d.id || d.code" :value="String(d.id || d.code)">[[ d.name ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label-sm">Goship Phường/Xã <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="branches.editForm.goship_from_ward" :disabled="!branches.editForm.goship_from_district" class="ma-input disabled:opacity-50">
          <option value="">[[ branches.editForm.goship_from_district ? '— (tuỳ chọn) —' : 'Chọn Quận trước' ]]</option>
          <option v-for="w in branchGoshipWards(branches.editForm.goship_from_district)" :key="w.id || w.code" :value="String(w.id || w.code)">[[ w.name ]]</option>
        </select>
      </div>


      <div class="md:col-span-2 flex items-center gap-2">
        <input type="checkbox" id="editBranchActive" v-model="branches.editForm.active" :disabled="branches.editTarget && branches.editTarget.is_default" class="w-4 h-4">
        <label for="editBranchActive" class="text-label-sm text-on-surface-variant">Đang hoạt động <span v-if="branches.editTarget && branches.editTarget.is_default" class="opacity-60">(chi nhánh Mặc định không thể tắt — chọn chi nhánh khác làm Mặc định trước)</span></label>
      </div>
      <div class="md:col-span-2 flex items-center gap-2">
        <input type="checkbox" id="editBranchDefault" v-model="branches.editForm.is_default" :disabled="branches.editTarget && branches.editTarget.is_default" class="w-4 h-4">
        <label for="editBranchDefault" class="text-label-sm text-on-surface-variant">Đặt làm chi nhánh Mặc định <span class="opacity-60">(tự động bỏ mặc định ở chi nhánh cũ)</span></label>
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="saveBranchEdit" :disabled="branches.editSaving" type="button" class="ma-btn-primary">[[ branches.editSaving ? 'Đang lưu...' : 'Lưu' ]]</button>
      <button @click="branches.showEditForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="bankAccounts.showForm" @click="bankAccounts.showForm = false" class="ma-modal-backdrop"></div>
  <div v-if="bankAccounts.showForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">[[ bankAccounts.editing ? 'Sửa tài khoản ngân hàng' : 'Thêm tài khoản ngân hàng' ]]</h3>
      <button @click="bankAccounts.showForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Mã ngân hàng *</label>
        <input type="text" v-model="bankAccounts.form.bank_code" placeholder="MB, VCB, TCB..." class="ma-input">
        <p class="ma-text-hint mt-1">Mã VietQR (viết hoa): MB, VCB, TCB, ACB, BIDV, VPB...</p>
      </div>
      <div>
        <label class="ma-label">Số tài khoản *</label>
        <input type="text" v-model="bankAccounts.form.account_no" placeholder="0123456789" class="ma-input" inputmode="numeric">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tên chủ tài khoản *</label>
        <input type="text" v-model="bankAccounts.form.account_name" placeholder="CONG TY ... / NGUYEN VAN A" class="ma-input">
      </div>
      <div class="md:col-span-2 flex items-center gap-2">
        <input type="checkbox" id="bankAccDefault" v-model="bankAccounts.form.is_default" class="w-4 h-4">
        <label for="bankAccDefault" class="text-label-sm text-on-surface-variant">Đặt làm tài khoản Mặc định toàn cục <span class="opacity-60">(dùng khi chi nhánh không cấu hình riêng)</span></label>
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitBankAccount" :disabled="bankAccounts.submitting" type="button" class="ma-btn-primary">[[ bankAccounts.submitting ? 'Đang lưu...' : 'Lưu tài khoản' ]]</button>
      <button @click="bankAccounts.showForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="inventory.suppliers.showAddForm" @click="inventory.suppliers.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="inventory.suppliers.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm nhà cung cấp</h3>
      <button @click="inventory.suppliers.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tên *</label>
        <input type="text" v-model="inventory.suppliers.newSupplier.name" placeholder="Công ty TNHH ABC" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Điện thoại <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.suppliers.newSupplier.phone" placeholder="0901234567" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Người liên hệ <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.suppliers.newSupplier.contactPerson" placeholder="Tên sales/đầu mối" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Email <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="email" v-model="inventory.suppliers.newSupplier.email" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Mã số thuế <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.suppliers.newSupplier.taxCode" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.suppliers.newSupplier.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="inventory.suppliers.newSupplier.province" @change="onProvinceChange(inventory.suppliers.newSupplier)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="inventory.suppliers.newSupplier.ward" :disabled="!inventory.suppliers.newSupplier.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(inventory.suppliers.newSupplier.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Ghi chú <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.suppliers.newSupplier.note" class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitSupplier" :disabled="inventory.suppliers.submitting" type="button" class="ma-btn-primary">[[ inventory.suppliers.submitting ? 'Đang lưu...' : 'Lưu nhà cung cấp' ]]</button>
      <button @click="inventory.suppliers.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="inventory.suppliers.showEditForm" @click="inventory.suppliers.showEditForm = false" class="ma-modal-backdrop"></div>
  <div v-if="inventory.suppliers.showEditForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Sửa nhà cung cấp — [[ inventory.suppliers.editTarget && inventory.suppliers.editTarget.name ]]</h3>
      <button @click="inventory.suppliers.showEditForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tên *</label>
        <input type="text" v-model="inventory.suppliers.editForm.name" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Điện thoại</label>
        <input type="text" v-model="inventory.suppliers.editForm.phone" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Người liên hệ</label>
        <input type="text" v-model="inventory.suppliers.editForm.contactPerson" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Email</label>
        <input type="email" v-model="inventory.suppliers.editForm.email" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Mã số thuế</label>
        <input type="text" v-model="inventory.suppliers.editForm.taxCode" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Trạng thái</label>
        <select v-model="inventory.suppliers.editForm.active" class="ma-input">
          <option :value="true">Đang hợp tác</option>
          <option :value="false">Ngừng hợp tác</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường)</label>
        <input type="text" v-model="inventory.suppliers.editForm.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="inventory.suppliers.editForm.province" @change="onProvinceChange(inventory.suppliers.editForm)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="inventory.suppliers.editForm.ward" :disabled="!inventory.suppliers.editForm.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(inventory.suppliers.editForm.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Ghi chú</label>
        <input type="text" v-model="inventory.suppliers.editForm.note" class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="saveSupplierEdit" :disabled="inventory.suppliers.editSaving" type="button" class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">[[ inventory.suppliers.editSaving ? 'Đang lưu…' : 'Lưu' ]]</button>
      <button @click="inventory.suppliers.showEditForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="inventory.suppliers.drawerId" @click="closeSupplierDrawer" class="ma-modal-backdrop"></div>
  <div v-if="inventory.suppliers.drawerId" class="ma-modal-panel ma-modal-panel--detail flex flex-col">
    <div class="ma-modal-head">
      <h3 class="ma-heading">Chi tiết nhà cung cấp</h3>
      <button @click="closeSupplierDrawer" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <div class="ma-modal-body flex-1 overflow-y-auto custom-scrollbar">
      <div v-if="inventory.suppliers.detailLoading" class="ma-loading-center"><span class="material-symbols-outlined text-primary ma-spin text-[32px]">progress_activity</span></div>
      <div v-else-if="!inventory.suppliers.detail" class="text-body-sm text-on-surface-variant py-8 text-center">Không tải được chi tiết nhà cung cấp.</div>
      <template v-else>
        <div class="mb-stack-lg">
          <div class="flex items-center gap-2">
            <h4 class="text-headline-md font-bold text-on-surface truncate">[[ inventory.suppliers.detail.supplier.name ]]</h4>
            <button @click="startEditSupplier(inventory.suppliers.detail.supplier)" type="button" class="p-1 text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors flex-shrink-0" aria-label="Sửa" title="Sửa">
              <span class="material-symbols-outlined text-[16px]">edit</span>
            </button>
          </div>
          <div class="text-body-sm text-on-surface mt-1.5 space-y-0.5">
            <p v-if="inventory.suppliers.detail.supplier.contact_person">Liên hệ: [[ inventory.suppliers.detail.supplier.contact_person ]]</p>
            <p v-if="inventory.suppliers.detail.supplier.phone">SĐT: [[ formatPhone(inventory.suppliers.detail.supplier.phone) ]]</p>
            <p v-if="inventory.suppliers.detail.supplier.email">Email: [[ inventory.suppliers.detail.supplier.email ]]</p>
            <p v-if="inventory.suppliers.detail.supplier.tax_code">MST: [[ inventory.suppliers.detail.supplier.tax_code ]]</p>
            <p v-if="inventory.suppliers.detail.supplier.address || inventory.suppliers.detail.supplier.ward || inventory.suppliers.detail.supplier.province">Địa chỉ: [[ formatAddress(inventory.suppliers.detail.supplier.address, inventory.suppliers.detail.supplier.ward, inventory.suppliers.detail.supplier.province) ]]</p>
          </div>
        </div>

        <div class="grid gap-3 mb-stack-lg" :class="inventory.suppliers.detail.total_outstanding !== undefined ? 'grid-cols-2' : 'grid-cols-1'">
          <div class="bg-surface-bright border border-outline-variant rounded-xl p-3 text-center">
            <div class="text-headline-md font-bold text-primary">[[ formatMoney(inventory.suppliers.detail.total_purchased) ]]</div>
            <div class="text-label-sm text-on-surface-variant uppercase tracking-wider mt-1">Tổng đã nhập hàng</div>
          </div>
          <div v-if="inventory.suppliers.detail.total_outstanding !== undefined" class="bg-surface-bright border border-outline-variant rounded-xl p-3 text-center">
            <div class="text-headline-md font-bold" :class="inventory.suppliers.detail.total_outstanding > 0 ? 'text-error' : 'text-primary'">[[ formatMoney(inventory.suppliers.detail.total_outstanding) ]]</div>
            <div class="text-label-sm text-on-surface-variant uppercase tracking-wider mt-1">Dư nợ hiện tại (mình nợ NCC)</div>
          </div>
        </div>
        <p v-if="inventory.suppliers.detail.total_outstanding === undefined" class="text-body-sm text-on-surface-variant opacity-60 mb-stack-lg">Không có quyền xem công nợ (cần quyền Xem sổ quỹ & báo cáo tài chính).</p>

        <div class="border-t border-outline-variant pt-stack-md">
          <div class="flex items-center justify-between mb-2">
            <h4 class="ma-section-label">Phiếu nhập hàng gần đây</h4>
            <span class="text-label-sm text-on-surface-variant">[[ inventory.suppliers.detail.purchase_order_count ]] phiếu</span>
          </div>
          <div v-if="!(inventory.suppliers.detail.purchase_orders || []).length" class="text-body-sm text-on-surface-variant opacity-60 text-center py-8">Chưa có phiếu nhập hàng nào.</div>
          <div v-else class="overflow-x-auto border border-outline-variant rounded-xl">
            <table class="w-full text-left border-collapse">
              <thead><tr class="ma-thead-row">
                <th class="px-3 py-2 font-label-sm text-on-surface-variant tracking-wider uppercase">Mã phiếu</th>
                <th class="px-3 py-2 font-label-sm text-on-surface-variant tracking-wider uppercase">Ngày</th>
                <th class="px-3 py-2 font-label-sm text-on-surface-variant tracking-wider uppercase text-right">Tổng tiền</th>
                <th class="px-3 py-2 font-label-sm text-on-surface-variant tracking-wider uppercase">Trạng thái</th>
              </tr></thead>
              <tbody class="ma-rows-divide">
                <tr v-for="po in inventory.suppliers.detail.purchase_orders" :key="po.purchase_order_id" class="hover:bg-surface-container-low/50 transition-colors">
                  <td class="px-3 py-2 font-body-sm font-bold text-primary">[[ po.purchase_order_id ]]</td>
                  <td class="px-3 py-2 font-body-sm text-on-surface-variant">[[ formatDate(po.order_date) ]]</td>
                  <td class="px-3 py-2 font-body-sm font-bold text-right">[[ formatMoney(po.total_amount) ]]</td>
                  <td class="px-3 py-2 font-body-sm">[[ po.status ]]</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </template>
    </div>
  </div>

  
  <div v-if="couponsMgmt.showAddForm" @click="couponsMgmt.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="couponsMgmt.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm mã giảm giá</h3>
      <button @click="couponsMgmt.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Mã *</label>
        <input type="text" v-model="couponsMgmt.newCoupon.code" placeholder="LAMQUEN10" class="w-full uppercase bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Tiêu đề <span class="ma-text-hint">(hiển thị cho khách — thu hút)</span></label>
        <input type="text" v-model="couponsMgmt.newCoupon.title" placeholder="Giảm 10% mừng khai trương" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Loại giảm</label>
        <select v-model="couponsMgmt.newCoupon.valueType" class="ma-input">
          <option value="percent">Phần trăm (%)</option>
          <option value="fixed">Số tiền cố định (VNĐ)</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Giá trị *</label>
        <input type="number" min="0" v-model="couponsMgmt.newCoupon.value" placeholder="10" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Đơn tối thiểu (VNĐ) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="number" min="0" v-model="couponsMgmt.newCoupon.minOrderAmount" placeholder="0" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Số lượt dùng tối đa <span class="ma-text-hint">(0 = không giới hạn)</span></label>
        <input type="number" min="0" v-model="couponsMgmt.newCoupon.maxUses" placeholder="0" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Bắt đầu <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="date" v-model="couponsMgmt.newCoupon.startAt" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Hết hạn <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="date" v-model="couponsMgmt.newCoupon.expiresAt" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Mô tả <span class="ma-text-hint">(hiển thị cho khách, tuỳ chọn)</span></label>
        <input type="text" v-model="couponsMgmt.newCoupon.description" placeholder="Áp dụng cho toàn bộ đơn hàng từ 300k..." class="ma-input">
      </div>
    </div>

    
    <div class="mt-4 pt-4 border-t border-outline-variant">
      <label class="ma-label">Phạm vi áp dụng giảm giá</label>
      <p class="text-body-sm text-on-surface-variant mb-3">Để trống tất cả = giảm trên <b>toàn bộ đơn</b>. Chọn loại và/hoặc sản phẩm để chỉ giảm trên phần hàng đó.</p>

      <div v-if="couponsMgmt.productsLoading" class="text-body-sm text-on-surface-variant">Đang tải danh sách sản phẩm…</div>

      <template v-else>
        <div v-if="couponsMgmt.typeOptions.length" class="mb-3">
          <div class="text-body-sm font-medium mb-1">Theo loại sản phẩm</div>
          <div class="flex flex-wrap gap-2">
            <button v-for="t in couponsMgmt.typeOptions" :key="t" type="button"
              @click="toggleCouponScopeType(t)"
              :class="isCouponTypeSelected(t) ? 'bg-primary text-on-primary border-primary' : 'bg-surface-container-lowest text-on-surface border-outline-variant'"
              class="px-3 py-1 rounded-full border text-body-sm transition-all active:scale-95">[[ t ]]</button>
          </div>
        </div>

        <div>
          <div class="text-body-sm font-medium mb-1">Theo sản phẩm cụ thể
            <span v-if="couponsMgmt.newCoupon.scopeProducts.length" class="ma-text-hint">(đã chọn [[ couponsMgmt.newCoupon.scopeProducts.length ]])</span>
          </div>
          <input type="text" v-model="couponsMgmt.productSearch" placeholder="Tìm sản phẩm theo tên hoặc handle…" class="ma-input mb-2">
          <div class="max-h-48 overflow-y-auto border border-outline-variant rounded-lg divide-y divide-outline-variant">
            <label v-for="p in couponProductsFiltered" :key="p.handle" class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-surface-container-lowest">
              <input type="checkbox" :checked="isCouponProductSelected(p.handle)" @change="toggleCouponScopeProduct(p.handle)">
              <span class="text-body-sm">[[ p.title ]] <span v-if="p.product_type" class="ma-text-hint">· [[ p.product_type ]]</span></span>
            </label>
            <div v-if="!couponProductsFiltered.length" class="px-3 py-2 text-body-sm text-on-surface-variant">Không có sản phẩm phù hợp.</div>
          </div>
        </div>
      </template>
    </div>

    <div class="ma-btn-row">
      <button @click="createCoupon" :disabled="couponsMgmt.creating" type="button" class="ma-btn-primary">[[ couponsMgmt.creating ? 'Đang tạo...' : 'Tạo mã' ]]</button>
      <button @click="couponsMgmt.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="staffMgmt.showAddForm" @click="staffMgmt.showAddForm = false" class="ma-modal-backdrop"></div>
  <div v-if="staffMgmt.showAddForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Thêm nhân viên mới</h3>
      <button @click="staffMgmt.showAddForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tên hiển thị *</label>
        <input type="text" v-model="staffMgmt.newStaff.name" placeholder="Nguyễn Văn A" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tên đăng nhập *</label>
        <input type="text" v-model="staffMgmt.newStaff.username" placeholder="nguyenvana" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Mật khẩu *</label>
        <input type="password" v-model="staffMgmt.newStaff.password" placeholder="••••••••" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Vai trò</label>
        <select v-model="staffMgmt.newStaff.role" class="ma-input">
          <option value="staff">Nhân viên</option>
          <option value="accountant">Kế toán</option>
          <option value="manager">Quản lý</option>
          <option value="admin">Quản trị</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Telegram Chat ID <span class="ma-text-hint">(tuỳ chọn — nhận thông báo)</span></label>
        <input type="text" v-model="staffMgmt.newStaff.telegram" placeholder="vd: 123456789" class="w-full max-w-[280px] bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="staffMgmt.newStaff.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="staffMgmt.newStaff.province" @change="onProvinceChange(staffMgmt.newStaff)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="staffMgmt.newStaff.ward" :disabled="!staffMgmt.newStaff.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(staffMgmt.newStaff.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
    </div>

    
    <div v-if="!newStaffRoleIsOwnerLike" class="pt-3 mt-2 border-t border-outline-variant/50">
      <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Quyền riêng <span class="ma-text-hint normal-case tracking-normal">(tuỳ chọn — cộng thêm ngoài Vai trò ở trên)</span></p>
      <div v-for="grp in staffMgmt.permCatalog" :key="grp.group" class="mb-3">
        <p class="text-body-sm font-bold text-on-surface mb-1.5">[[ grp.group ]]</p>
        <div class="flex flex-wrap gap-2">
          <label v-for="p in grp.permissions" :key="p.key"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-md border cursor-pointer transition-all"
            :class="hasPermViaNewStaffRole(p.key) ? 'bg-surface-container-low border-outline-variant opacity-50 cursor-not-allowed' : (staffMgmt.newStaff.permissions.indexOf(p.key) !== -1 ? 'bg-primary-container border-primary text-on-primary-container' : 'bg-surface-container-lowest border-outline-variant hover:bg-surface-container-low')"
            :title="hasPermViaNewStaffRole(p.key) ? 'Đã có sẵn qua Role, không cần cấp riêng' : (isPermLockedForCaller(p.key, staffMgmt.newStaff.permissions) ? 'Chỉ OWNER mới được cấp quyền nhạy cảm này cho người khác' : '')">
            <input type="checkbox" class="hidden"
              :checked="hasPermViaNewStaffRole(p.key) || staffMgmt.newStaff.permissions.indexOf(p.key) !== -1"
              :disabled="hasPermViaNewStaffRole(p.key)"
              @change="toggleNewStaffPerm(p.key)">
            <span class="material-symbols-outlined text-[14px]">[[ (hasPermViaNewStaffRole(p.key) || staffMgmt.newStaff.permissions.indexOf(p.key) !== -1) ? 'check_box' : 'check_box_outline_blank' ]]</span>
            [[ p.label ]]
          </label>
        </div>
      </div>
    </div>

    <div class="ma-btn-row">
      <button @click="createStaff" type="button" class="ma-btn-primary">Tạo nhân viên</button>
      <button @click="staffMgmt.showAddForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="staffMgmt.showResetForm" @click="staffMgmt.showResetForm = false" class="ma-modal-backdrop"></div>
  <div v-if="staffMgmt.showResetForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Đặt lại mật khẩu</h3>
      <button @click="staffMgmt.showResetForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <p class="text-body-sm text-on-surface-variant mb-stack-md">Nhân viên: [[ staffMgmt.resetTarget && staffMgmt.resetTarget.name ]] ([[ staffMgmt.resetTarget && staffMgmt.resetTarget.username ]])</p>
    <div>
      <label class="ma-label">Mật khẩu mới *</label>
      <input type="password" v-model="staffMgmt.resetPassword" placeholder="••••••••" class="ma-input">
    </div>
    <div class="ma-btn-row">
      <button @click="confirmResetPassword" type="button" class="inline-flex items-center gap-2 bg-error text-on-error px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">Đặt lại</button>
      <button @click="staffMgmt.showResetForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="staffMgmt.showEditForm" @click="staffMgmt.showEditForm = false" class="ma-modal-backdrop"></div>
  <div v-if="staffMgmt.showEditForm" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Sửa nhân viên — [[ staffMgmt.editTarget && staffMgmt.editTarget.name ]]</h3>
      <button @click="staffMgmt.showEditForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-form-grid-2">
      <div>
        <label class="ma-label">Tên hiển thị *</label>
        <input type="text" v-model="staffMgmt.editForm.name" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Vai trò</label>
        <select v-model="staffMgmt.editForm.role" class="ma-input">
          <option v-for="opt in editRoleOptions()" :key="opt.value" :value="opt.value">[[ opt.label ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Telegram Chat ID</label>
        <input type="text" v-model="staffMgmt.editForm.telegram" placeholder="vd: 123456789" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Ghi chú</label>
        <input type="text" v-model="staffMgmt.editForm.notes" class="ma-input">
      </div>
      <div class="md:col-span-2">
        <label class="ma-label">Địa chỉ (số nhà/đường) <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="staffMgmt.editForm.address" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/thành phố <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="staffMgmt.editForm.province" @change="onProvinceChange(staffMgmt.editForm)" class="ma-input">
          <option value="" disabled>Chọn tỉnh/thành phố</option>
          <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
        </select>
      </div>
      <div>
        <label class="ma-label">Xã/phường <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <select v-model="staffMgmt.editForm.ward" :disabled="!staffMgmt.editForm.province" class="ma-input">
          <option value="" disabled>Chọn xã/phường</option>
          <option v-for="w in wardsFor(staffMgmt.editForm.province)" :key="w.code" :value="w.name">[[ w.name ]]</option>
        </select>
      </div>
    </div>
    <p class="text-body-sm text-on-surface-variant opacity-70 mt-2">Đổi mật khẩu dùng nút "Reset PW" riêng. Muốn đổi Role của chính bạn — nhờ 1 owner/admin khác.</p>
    <div class="ma-btn-row">
      <button @click="saveEditStaff" :disabled="staffMgmt.editSaving" type="button" class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">[[ staffMgmt.editSaving ? 'Đang lưu…' : 'Lưu thay đổi' ]]</button>
      <button @click="staffMgmt.showEditForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <div v-if="staffMgmt.expandedPermsId" @click="staffMgmt.expandedPermsId = null" class="ma-modal-backdrop"></div>
  <div v-if="staffMgmt.expandedPermsId" class="ma-modal-panel ma-modal-panel--wide">
    <div class="ma-row-header">
      <h3 class="ma-heading">Quyền — [[ staffMgmt.permsTarget && staffMgmt.permsTarget.name ]]</h3>
      <button @click="staffMgmt.expandedPermsId = null" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div v-if="staffMgmt.permsLoading" class="flex items-center justify-center py-8"><span class="material-symbols-outlined text-primary ma-spin text-[28px]">progress_activity</span></div>
    <div v-else class="space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="ma-text-sub">Vai trò (baseline): <strong class="text-on-surface">[[ (staffMgmt.permsTarget && staffMgmt.permsTarget.role || '').toUpperCase() ]]</strong></span>
        <span v-if="staffMgmt.currentPermsIsOwner" class="text-body-sm font-bold text-primary">Toàn quyền hệ thống</span>
        <span v-else-if="!staffMgmt.currentPerms.length" class="text-body-sm text-on-surface-variant opacity-60">Chưa có quyền nào được cấu hình</span>
        <ul v-else class="flex flex-wrap gap-2 mt-1 w-full">
          <li v-for="p in staffMgmt.currentPerms" :key="p" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-md bg-surface-container-lowest border border-outline-variant">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>[[ permLabel(p) ]]
          </li>
        </ul>
      </div>

      <div v-if="!staffMgmt.currentPermsIsOwner" class="pt-3 border-t border-outline-variant/50">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Quyền riêng — cộng thêm cho cá nhân này (union với Role)</p>
        <div v-for="grp in staffMgmt.permCatalog" :key="grp.group" class="mb-3">
          <p class="text-body-sm font-bold text-on-surface mb-1.5">[[ grp.group ]]</p>
          <div class="flex flex-wrap gap-2">
            <label v-for="p in grp.permissions" :key="p.key"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-md border cursor-pointer transition-all"
              :class="hasPermViaRole(p.key) ? 'bg-surface-container-low border-outline-variant opacity-50 cursor-not-allowed' : (staffMgmt.individualPerms.indexOf(p.key) !== -1 ? 'bg-primary-container border-primary text-on-primary-container' : 'bg-surface-container-lowest border-outline-variant hover:bg-surface-container-low')"
              :title="hasPermViaRole(p.key) ? 'Đã có sẵn qua Role, không cần cấp riêng' : (isPermLockedForCaller(p.key) ? 'Chỉ OWNER mới được cấp quyền nhạy cảm này cho người khác' : '')">
              <input type="checkbox" class="hidden"
                :checked="hasPermViaRole(p.key) || staffMgmt.individualPerms.indexOf(p.key) !== -1"
                :disabled="hasPermViaRole(p.key)"
                @change="toggleIndividualPerm(p.key)">
              <span class="material-symbols-outlined text-[14px]">[[ (hasPermViaRole(p.key) || staffMgmt.individualPerms.indexOf(p.key) !== -1) ? 'check_box' : 'check_box_outline_blank' ]]</span>
              [[ p.label ]]
            </label>
          </div>
        </div>
        <button @click="savePermissions(staffMgmt.permsTarget)" :disabled="staffMgmt.permsSaving" type="button"
          class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50 mt-2">
          <span class="material-symbols-outlined text-[18px]" :class="{ 'ma-spin': staffMgmt.permsSaving }">[[ staffMgmt.permsSaving ? 'progress_activity' : 'save' ]]</span>
          Lưu quyền riêng
        </button>
      </div>
    </div>
  </div>

  
  <div v-if="inventory.purchaseOrders.showAddForm" @click="inventory.purchaseOrders.showAddForm = false; inventory.purchaseOrders.editingId = null" class="ma-modal-backdrop"></div>
  <div v-if="inventory.purchaseOrders.showAddForm" class="ma-modal-panel ma-modal-panel--wide">
    <div class="ma-row-header">
      <h3 class="ma-heading">[[ inventory.purchaseOrders.editingId ? 'Sửa phiếu nhập hàng — ' + inventory.purchaseOrders.editingId : 'Lập phiếu nhập hàng' ]]</h3>
      <button @click="inventory.purchaseOrders.showAddForm = false; inventory.purchaseOrders.editingId = null" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md max-w-xl">
      <div class="md:col-span-2">
        <label class="ma-label">Nhà cung cấp *</label>
        <select v-model="inventory.purchaseOrders.newPO.supplier_id" class="ma-input">
          <option value="" disabled>— Chọn nhà cung cấp —</option>
          <option v-for="s in inventory.suppliers.list" :key="s.supplier_id" :value="s.supplier_id">[[ s.name ]]</option>
        </select>
      </div>
    </div>

    <div class="mt-stack-md">
      <label class="ma-label">Dòng sản phẩm *</label>
      <div class="hidden md:grid grid-cols-6 gap-2 mb-1 px-1">
        <span class="col-span-2 text-label-sm text-on-surface-variant">Sản phẩm</span>
        <span class="text-label-sm text-on-surface-variant">Số lượng</span>
        <span class="text-label-sm text-on-surface-variant">[[ inventory.purchaseOrders.newPO.allocation_basis === 'WEIGHT' ? 'Khối lượng (kg)' : '' ]]</span>
        <span class="text-label-sm text-on-surface-variant">Giá nhập (VNĐ)</span>
      </div>
      <div v-for="(it, idx) in inventory.purchaseOrders.newPO.items" :key="idx" class="grid grid-cols-1 md:grid-cols-6 gap-2 mb-2 items-start">
        <div class="md:col-span-2 relative">
          <input type="text" v-model="it.product_name" @input="it.product_id = ''; it.variant_id = ''" placeholder="Gõ tên/mã sản phẩm để tìm, hoặc tự nhập tên mới *"
            class="ma-input">
          <span v-if="it.product_id" class="text-label-sm text-emerald-600 mt-0.5 inline-block">✓ Đã chọn từ danh sách sản phẩm</span>
          <span v-else-if="it.product_name" class="text-label-sm text-amber-600 mt-0.5 inline-block">Sản phẩm mới, chưa có trong Products — giá vốn sẽ không tự tính khi bán qua MOPS</span>
          <div v-if="!it.product_id && poItemSearchResults(it.product_name).length" class="absolute z-10 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-40 overflow-y-auto custom-scrollbar">
            <button v-for="p in poItemSearchResults(it.product_name)" :key="p.variant_id || p.product_id" type="button" @click="pickPOItemProduct(it, p)"
              class="w-full flex items-center justify-between px-3 py-2 text-left text-body-sm hover:bg-surface-container-low transition-colors border-b border-outline-variant last:border-b-0">
              <span>[[ p.title || p.handle ]]<span v-if="p.variant_title" class="ml-1 px-1.5 py-0.5 rounded bg-primary/10 text-primary text-label-sm font-semibold">[[ p.variant_title ]]</span> <span class="text-on-surface-variant opacity-60">([[ p.sku || p.handle ]])</span></span>
              <span class="text-on-surface-variant text-label-sm">[[ p.source ]]</span>
            </button>
          </div>
        </div>
        <input type="number" min="1" v-model="it.qty" placeholder="SL" class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
        <input v-if="inventory.purchaseOrders.newPO.allocation_basis === 'WEIGHT'" type="number" min="0" step="0.01" v-model="it.weight" placeholder="Khối lượng (kg) *"
          class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-body-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
        <div v-else></div>
        <div class="flex gap-2">
          <input type="number" min="0" v-model="it.unit_cost" placeholder="Giá nhập" class="ma-input">
          <button @click="removePOItemRow(idx)" type="button" class="shrink-0 px-2 rounded-lg text-red-600 hover:bg-red-50 transition-all"><span class="material-symbols-outlined text-[18px]">delete</span></button>
        </div>
      </div>
      <button @click="addPOItemRow" type="button" class="inline-flex items-center gap-1 text-label-md font-bold text-primary hover:opacity-80 transition-all">
        <span class="material-symbols-outlined text-[18px]">add</span>Thêm dòng
      </button>
      <p class="text-label-sm text-on-surface-variant mt-1">Chọn từ danh sách gợi ý để gán đúng ProductID (tính giá vốn chuẩn khi bán) — hoặc tự gõ tên nếu là sản phẩm mới chưa có trong SAPO/MOPS.</p>
    </div>

    <div class="mt-stack-md pt-stack-md border-t border-outline-variant">
      <label class="ma-label">Chi phí phụ & Chiết khấu <span class="font-normal opacity-60">(tuỳ chọn — 1 tổng cho cả phiếu, tự phân bổ vào giá vốn từng dòng khi Post)</span></label>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-stack-md max-w-2xl">
        <div>
          <label class="ma-label-sm">Phí vận chuyển</label>
          <input type="number" min="0" v-model="inventory.purchaseOrders.newPO.shipping_cost" placeholder="0" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Phí lưu kho</label>
          <input type="number" min="0" v-model="inventory.purchaseOrders.newPO.storage_cost" placeholder="0" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Thuế VAT</label>
          <input type="number" min="0" v-model="inventory.purchaseOrders.newPO.vat_amount" placeholder="0" class="ma-input">
        </div>
        <div>
          <label class="ma-label-sm">Chiết khấu NCC</label>
          <input type="number" min="0" v-model="inventory.purchaseOrders.newPO.discount_amount" placeholder="0" class="ma-input">
        </div>
      </div>
      <div class="mt-stack-md max-w-xs">
        <label class="ma-label-sm">Cơ sở phân bổ chi phí</label>
        <select v-model="inventory.purchaseOrders.newPO.allocation_basis" class="ma-input">
          <option value="QTY">Theo số lượng</option>
          <option value="WEIGHT">Theo khối lượng (kg) — mỗi dòng cần nhập Khối lượng</option>
        </select>
      </div>
      <p class="text-label-sm text-on-surface-variant mt-1">Bill công nợ NCC (khi Post) = Tổng giá trị nhập + Vận chuyển + Lưu kho + VAT − Chiết khấu.</p>
    </div>

    <div class="mt-stack-md pt-stack-md border-t border-outline-variant">
      <label class="ma-label">Điều khoản thanh toán NCC <span class="font-normal opacity-60">(hộ kinh doanh không phải lúc nào cũng trả đủ ngay)</span></label>
      <div class="flex flex-wrap items-end gap-stack-md">
        <div class="max-w-[220px]">
          <select v-model="inventory.purchaseOrders.newPO.payment_terms" class="ma-input">
            <option value="FULL">Trả đủ sau khi nhận hàng</option>
            <option value="DEPOSIT">Cọc trước — trả phần còn lại sau</option>
          </select>
        </div>
        <div v-if="inventory.purchaseOrders.newPO.payment_terms === 'DEPOSIT'" class="max-w-[160px]">
          <label class="ma-label-sm">Số tiền cọc (VNĐ)</label>
          <input type="number" min="0" v-model="inventory.purchaseOrders.newPO.deposit_amount" placeholder="vd: 500000" class="ma-input">
        </div>
      </div>
      <p v-if="inventory.purchaseOrders.newPO.payment_terms === 'DEPOSIT'" class="text-label-sm text-on-surface-variant mt-1">Tổng giá trị nhập tạm tính từ Dòng sản phẩm: <strong class="text-on-surface">[[ formatMoney(poItemsSubtotal()) ]]</strong> — nhập số tiền cọc cụ thể, không tính theo %. Sau khi Lưu phiếu (Draft), dùng nút "Trả cọc NCC" ở danh sách để lập Phiếu Chi cọc trước — chưa cần chờ hàng về/Post.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md max-w-xl mt-stack-md">
      <div class="md:col-span-2">
        <label class="ma-label">Ghi chú <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="inventory.purchaseOrders.newPO.note" class="ma-input">
      </div>
    </div>
    <div class="ma-btn-row">
      <button @click="submitPurchaseOrder" :disabled="inventory.purchaseOrders.submitting" type="button" class="ma-btn-primary">[[ inventory.purchaseOrders.submitting ? 'Đang lưu...' : (inventory.purchaseOrders.editingId ? 'Lưu thay đổi' : 'Lưu phiếu nhập hàng (Draft)') ]]</button>
      <button @click="inventory.purchaseOrders.showAddForm = false; inventory.purchaseOrders.editingId = null" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>


  <section v-if="activeTab === 'orders' && (workspaceView === 'orders.create' || workspaceView === 'orders.edit')"
    class="ma-mo-page p-2.5">
    <div class="ma-mo-page__head">
      <div class="ma-mo-page__breadcrumb">
        <span class="opacity-60">Vận hành</span>
        <span class="opacity-40 mx-1">/</span>
        <span class="opacity-60 cursor-pointer hover:opacity-90" @click="closeManualOrderForm">Đơn hàng</span>
        <span class="opacity-40 mx-1">/</span>
        <span class="font-bold text-on-surface">[[ workspaceView === 'orders.edit' ? 'Sửa đơn ' + manualOrder.editingOrderId : 'Tạo đơn hàng thủ công' ]]</span>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <button @click="closeManualOrderForm" type="button" class="ma-btn-outline">Thoát</button>
        <button v-if="manualOrder.editingOrderId" type="button" @click="submitManualOrder"
          :disabled="manualOrder.submitting || !manualOrder.cart.length" class="ma-btn-primary">
          <span class="material-symbols-outlined text-[18px]">save</span>[[ manualOrder.submitting ? 'Đang lưu…' : 'Lưu thay đổi' ]] <kbd v-if="!manualOrder.submitting" class="text-label-sm px-2 py-1 bg-white/20 rounded">F9</kbd>
        </button>
        <button v-else type="button" @click="submitManualOrder"
          :disabled="manualOrder.submitting || !manualOrder.cart.length || (manualOrder.paymentMethod !== 'COD' && !paymentConfigured)"
          class="ma-btn-primary">
          <span v-if="!manualOrder.submitting" class="material-symbols-outlined text-[18px]">check</span>[[ manualOrder.submitting ? 'Đang tạo…' : 'Tạo đơn hàng' ]] <kbd v-if="!manualOrder.submitting" class="text-label-sm px-2 py-1 bg-white/20 rounded">F9</kbd>
        </button>
      </div>
    </div>
    <div class="ma-mo-page__body">
      <div v-if="manualOrder.detailLoading" class="mb-stack-md flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-body-sm text-amber-800">
        <span class="material-symbols-outlined ma-spin text-[16px]">progress_activity</span>
        <span>Đang tải chi tiết đơn — form đang hiện dữ liệu tóm tắt, sản phẩm và địa chỉ sẽ tự bổ sung khi xong.</span>
      </div>
      <div v-if="manualOrder.editingOrderId && manualOrder.editLocks.length" class="mb-stack-md px-3 py-2.5 rounded-lg bg-amber-50 border border-amber-300 text-body-sm text-amber-900">
        <p class="font-bold flex items-center gap-1.5 mb-1"><span class="material-symbols-outlined text-[18px]">warning</span>Đơn ở trạng thái nhạy cảm — sửa vẫn được nhưng cần lưu ý:</p>
        <ul class="list-disc pl-5 space-y-0.5">
          <li v-for="(w, wi) in manualOrder.editLocks" :key="wi">[[ w ]]</li>
        </ul>
      </div>

      <div class="ma-mo-shell ma-mo-shell--single">
        <div class="ma-mo-flow custom-scrollbar">

        <!-- ═══ Layout Sapo-style: cột chính ~78% (Khách hàng/Sản phẩm/Giao hàng/Thanh toán) +
             cột phụ ~22% "Thông tin bổ sung" sticky, tái dùng thẻ .ma-card đã có (2026-08-29). ═══ -->
        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,7.6fr)_minmax(0,2.4fr)] gap-3 items-start">
        <div class="flex flex-col gap-3 min-w-0">

          <!-- ═══ KHỐI 1: KHÁCH HÀNG (2026-08-12 col-6/col-6, cập nhật 2026-08-16):
               Cột trái: search với dropdown (Tạo mới inline khi không match) + Ghi chú đơn.
               2 input walk-in Tên/SĐT đã bỏ — mọi khách qua modal "Tạo khách mới" để tránh
               bug đè tên khách cũ (xem mops_01.js upsertCustomer guard).
               Cột phải: card info KH đã chọn (avatar/tên/sđt/nhóm/tổng đơn) hoặc empty state.
               Địa chỉ 3 cấp giữ nguyên 1 cột tràn ở block dưới. ═══ -->
            <div class="ma-card ma-card--overflow-visible">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">person</span>
                <h3 class="text-body-md font-bold text-on-surface">Thông tin khách hàng</h3>
                <span class="ma-mo-block__hint">· <kbd style="padding:1px 5px;border:1px solid var(--ma-bd);border-radius:4px;background:var(--ma-subtle);font-size:10px;font-family:inherit">F4</kbd> để focus</span>
              </div>
              <div class="p-3 flex flex-col gap-3">

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <!-- ─── CỘT TRÁI: search + dropdown (Tạo mới inline) + Ghi chú đơn ─── -->
                <div class="flex flex-col gap-2">
                  <div class="relative">
                    <input type="text" ref="manualOrderCustomerSearch" v-model="manualOrder.customerSearch" @input="onManualOrderCustomerFieldInput"
                      @focus="manualOrder.customerSearchFocused = true" @blur="onManualOrderCustomerBlur"
                      placeholder="Tìm khách theo tên/SĐT" class="ma-input">
                    <div v-if="manualOrder.customerSearchFocused && !manualOrder.selectedCustomer" class="absolute z-20 mt-1 w-full border border-outline-variant rounded-lg overflow-hidden bg-surface-container-lowest shadow-lg max-h-64 overflow-y-auto custom-scrollbar">
                      {%- comment -%}
                        2026-08-30: nút "Thêm mới khách hàng" luôn hiện cố định ngay dưới ô tìm —
                        khớp UI mẫu Sapo (nút này KHÔNG chờ "không tìm thấy" mới xuất hiện như trước
                        2026-08-16). Ẩn khi đang sửa đơn (editingOrderId) vì SĐT là mã định danh
                        khách, không đổi khách giữa chừng khi edit.
                      {%- endcomment -%}
                      <button v-if="!manualOrder.editingOrderId" type="button" @mousedown.prevent
                        @click="openManualOrderQuickCreateCustomer"
                        class="w-full flex items-center gap-2 px-3 py-2 text-left text-body-sm text-primary font-bold hover:bg-surface-container-low transition-colors border-b border-outline-variant">
                        <span class="material-symbols-outlined text-[16px]">add_circle</span>Thêm mới khách hàng
                      </button>
                      <div v-if="customers.loading" class="px-3 py-5 text-center text-body-sm text-on-surface-variant">
                        <span class="material-symbols-outlined ma-spin text-[20px] align-middle text-primary">progress_activity</span>
                        <span class="align-middle ml-1">Đang tải khách hàng…</span>
                      </div>
                      <template v-else>
                        <p v-if="!manualOrder.customerSearch.trim() && manualOrderCustomerResults().length" class="px-3 pt-2 pb-1 text-label-sm text-on-surface-variant opacity-60 uppercase tracking-wider">Khách gần đây</p>
                        <button v-for="c in manualOrderCustomerResults()" :key="c.customer_id" type="button" @mousedown.prevent @click="pickManualOrderCustomer(c)"
                          class="w-full flex items-center justify-between px-3 py-2 text-left text-body-sm hover:bg-surface-container-low transition-colors border-b border-outline-variant last:border-b-0">
                          <span>[[ c.name || '(chưa có tên)' ]] <span class="text-on-surface-variant opacity-60">([[ formatPhone(c.phone) ]])</span></span>
                          <span v-if="c.customer_group === 'SỈ'" class="text-label-sm text-primary font-bold">SỈ</span>
                        </button>
                        <div v-if="manualOrder.customerSearch.trim() && !manualOrderCustomerResults().length" class="px-3 py-4 text-center text-body-sm text-on-surface-variant">Không có khách hàng nào phù hợp.</div>
                        <div v-else-if="!manualOrder.customerSearch.trim() && !manualOrderCustomerResults().length" class="px-3 py-4 text-center text-body-sm text-on-surface-variant opacity-60">Chưa có khách hàng nào.</div>
                      </template>
                    </div>
                  </div>

                  {%- comment -%}
                    2026-08-16: Bỏ 2 input walk-in "Tên KH (vãng lai)" + "SĐT *". Trước đây user gõ
                    trực tiếp → backend upsertCustomer đè lên hồ sơ khách cũ nếu SĐT trùng (bug đã
                    xử lý ở mops_01.js). Giờ mọi khách mới bắt buộc đi qua modal "Tạo khách mới" —
                    một flow duy nhất, không rườm 3 ô. Nút Tạo mới đã đưa lên trong dropdown empty
                    state (bên trên) — không cần nút riêng ở đây nữa.

                    Ghi chú đơn giữ lại vì nó thuộc ORDER (không phải KH) — vẫn ghi chú riêng cho
                    từng đơn kể cả khi tái sử dụng KH cũ.

                    2026-08-23: bổ sung textarea "Ghi chú nội bộ" (internal_note, cột AQ) — dành cho
                    staff/CSKH/kế toán ghi thông tin không muốn khách/shipper thấy. KHÔNG in lên
                    tem A6 và KHÔNG in lên phiếu/hóa đơn đơn hàng. Hiển thị nổi bật với nền vàng
                    + icon 🔒 để tránh nhầm với ô ghi chú của khách phía trên.

                    2026-08-29: 2 textarea note/internal_note dời xuống hàng "Ghi chú đơn hàng"
                    cạnh card "Tổng tiền" (khớp vị trí trong ảnh mẫu Sapo) — xem khối bên dưới
                    Sản phẩm &amp; giỏ hàng.
                  {%- endcomment -%}
                </div>

                <!-- ─── CỘT PHẢI: card info KH đã chọn HOẶC empty state ─── -->
                <div>
                  <div v-if="!manualOrder.selectedCustomer" class="rounded-xl border-2 border-dashed border-outline-variant bg-surface-container-lowest p-4 h-full min-h-[140px] flex flex-col items-center justify-center text-center gap-1.5">
                    <span class="material-symbols-outlined text-[32px] text-on-surface-variant opacity-40">person_search</span>
                    <p class="text-body-sm text-on-surface font-semibold">Chưa chọn khách hàng</p>
                    <p class="text-label-sm text-on-surface-variant opacity-70 max-w-[240px]">Tìm ở ô bên trái, hoặc bấm <b>"Tạo khách mới"</b> để mở modal nhập nhanh.</p>
                  </div>
                  <div v-else class="rounded-xl border border-outline-variant bg-surface-container-lowest p-3 flex flex-col gap-2">
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-body-md">
                          [[ (manualOrder.selectedCustomer.name || '?').charAt(0).toUpperCase() ]]
                        </span>
                        <div class="min-w-0 flex-1">
                          <div class="font-bold text-on-surface truncate">[[ manualOrder.selectedCustomer.name || '(chưa có tên)' ]]</div>
                          <div class="text-label-sm text-on-surface-variant truncate">[[ formatPhone(manualOrder.selectedCustomer.phone) ]]</div>
                        </div>
                      </div>
                      <button v-if="!manualOrder.editingOrderId" type="button"
                        @click="clearManualOrderSelectedCustomer"
                        class="flex-shrink-0 text-label-sm text-on-surface-variant hover:text-error inline-flex items-center gap-1"
                        title="Bỏ chọn khách này">
                        <span class="material-symbols-outlined text-[16px]">close</span><span class="hidden sm:inline">Đổi khách</span>
                      </button>
                    </div>
                    <span v-if="manualOrder.selectedCustomer.customer_group === 'SỈ'" class="text-label-sm text-primary font-bold inline-flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">verified</span>Khách Sỉ — tự động giảm [[ manualOrder.selectedCustomer.default_discount_percent ]]%
                    </span>
                    <span v-else class="text-label-sm text-emerald-600 inline-flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">check_circle</span>Khách quen
                    </span>
                    <div v-if="manualOrder.selectedCustomer.total_orders || manualOrder.selectedCustomer.last_purchase_at"
                         class="grid grid-cols-2 gap-2 text-label-sm text-on-surface-variant pt-1 border-t border-outline-variant/60">
                      <div v-if="manualOrder.selectedCustomer.total_orders"><span class="opacity-60">Đơn đã mua:</span> <b class="text-on-surface">[[ manualOrder.selectedCustomer.total_orders ]]</b></div>
                      <div v-if="manualOrder.selectedCustomer.last_purchase_at"><span class="opacity-60">Mua gần nhất:</span> <b class="text-on-surface">[[ String(manualOrder.selectedCustomer.last_purchase_at).slice(0, 10) ]]</b></div>
                    </div>
                    
              <!-- Địa chỉ khách hàng — inline preview + modal (refactor 2026-08-21). Địa chỉ hiển thị
                   1 dòng ngay dưới thông tin khách + nút "Sửa" (hoặc "Chọn địa chỉ" nếu chưa có).
                   Bấm nút → mở modal (manualOrder.addressPicker): list mode để chọn radio từ sổ địa
                   chỉ khách, add mode dùng <mops-address-picker> để thêm mới + gọi save_customer_address
                   ngầm. Modal DOM đặt cuối form workspace (ngay trước </section>). -->
              <div class="mt-1 pt-2 border-t border-outline-variant" ref="manualOrderAddrPicker" :class="manualOrder.invalidField === 'addr' ? 'ma-addr-picker-invalid' : ''">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="text-label-sm text-on-surface-variant font-bold flex items-center gap-1 flex-shrink-0">
                    <span class="material-symbols-outlined text-[14px]">home_pin</span>Địa chỉ giao hàng
                  </div>
                  <button type="button" @click="openAddressPicker" :disabled="!manualOrder.selectedCustomer || manualOrder.customerAddressLoading"
                    :title="!manualOrder.selectedCustomer ? 'Chọn khách hàng trước' : (manualOrder.customerAddressLoading ? 'Đang tải địa chỉ khách hàng…' : '')"
                    class="text-label-sm text-primary font-bold hover:underline inline-flex items-center gap-1 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:no-underline">
                    <span class="material-symbols-outlined text-[14px]">[[ manualOrderFullShippingAddress ? 'edit' : 'add_location_alt' ]]</span>
                    [[ manualOrderFullShippingAddress ? 'Sửa' : 'Chọn địa chỉ' ]]
                  </button>
                </div>
                <p v-if="manualOrder.customerAddressLoading && !manualOrderFullShippingAddress" ref="manualOrderShipAddress"
                   class="text-body-sm text-on-surface-variant mt-1 inline-flex items-center gap-1.5">
                  <span class="material-symbols-outlined ma-spin text-[16px] text-primary">progress_activity</span>
                  <span>Đang tải địa chỉ khách hàng…</span>
                </p>
                <p v-else-if="manualOrderFullShippingAddress" ref="manualOrderShipAddress"
                   class="text-body-sm text-on-surface mt-1"
                   :class="manualOrder.invalidField === 'shipAddress' ? 'ma-input-error px-2 py-1 rounded-md' : ''">
                  [[ manualOrderFullShippingAddress ]]
                </p>
                <p v-else ref="manualOrderShipAddress" class="text-body-sm text-on-surface-variant italic opacity-70 mt-1">
                  [[ !manualOrder.selectedCustomer ? 'Chưa chọn khách hàng.' : 'Chưa có địa chỉ — bấm "Chọn địa chỉ" ở trên.' ]]
                </p>
              </div>
                  </div>
                </div>
              </div><!-- /grid col-6 -->

              <!-- Ghi chú SĐT khi edit đơn -->
              <p v-if="manualOrder.editingOrderId && manualOrder.selectedCustomer" class="text-label-sm text-on-surface-variant opacity-70 mt-1">SĐT là mã định danh khách — không sửa khi chỉnh đơn.</p>

              </div><!-- /p-3 card body -->
            </div><!-- /ma-card Khách hàng -->


          <!-- ═══ KHỐI 2: SẢN PHẨM & GIỎ HÀNG (2026-08-12 single-column) ═══ -->
          <div class="ma-card ma-card--overflow-visible ma-mo-block--products">
            <div class="ma-card__head">
              <span class="material-symbols-outlined text-[18px] text-on-surface-variant">inventory_2</span>
              <h3 class="text-body-md font-bold text-on-surface">Thông tin sản phẩm</h3>
              <span class="ma-mo-block__hint">· <kbd style="padding:1px 5px;border:1px solid var(--ma-bd);border-radius:4px;background:var(--ma-subtle);font-size:10px;font-family:inherit">F3</kbd> để tìm nhanh</span>
              <div class="ml-auto ma-mo-seg" style="max-width:220px">
                <button type="button" :class="{ 'is-active': manualOrder.orderType === 'product' }" @click="manualOrder.orderType = 'product'">
                  <span class="material-symbols-outlined">inventory_2</span>Sản phẩm
                </button>
                <button type="button" :class="{ 'is-active': manualOrder.orderType === 'booking' }" @click="manualOrder.orderType = 'booking'">
                  <span class="material-symbols-outlined">event</span>Đặt lịch
                </button>
              </div>
            </div>
            <div class="p-3 flex flex-col gap-3">
          <div class="ma-mo-search">
            <div class="ma-mo-search__box">
              <span class="material-symbols-outlined ma-mo-search__icon">search</span>
              <input type="text" ref="manualOrderProductSearch"
                v-model="manualOrder.itemSearch"
                @focus="manualOrder.itemSearchFocused = true"
                @blur="onManualOrderSearchBlur"
                @keydown.esc="manualOrder.itemSearchFocused = false"
                placeholder="Tìm sản phẩm theo tên, SKU, biến thể… (F3)">
              <span class="ma-mo-search__hint"><kbd>F3</kbd></span>
            </div>

            <div v-if="manualOrder.itemSearchFocused" class="ma-mo-drop custom-scrollbar">
              <div v-if="products.loading" class="ma-mo-drop__empty">
                <span class="material-symbols-outlined ma-spin text-[22px] align-middle text-primary">progress_activity</span>
                <span class="align-middle ml-1">Đang tải sản phẩm…</span>
              </div>
              <template v-else-if="manualOrderSearchResults.length">
                <div v-for="p in manualOrderSearchResults" :key="p.variant_id || p.handle"
                  class="ma-mo-drop__row"
                  :class="{ 'is-selected': manualOrderCartMap[p.variant_id || p.handle] }"
                  @mousedown.prevent @click="toggleManualOrderCartItem(p)">
                  <span class="ma-mo-drop__check" aria-hidden="true"><span class="material-symbols-outlined">check</span></span>
                  <img v-if="p.image" :src="p.image" class="ma-mo-drop__thumb" width="32" height="32" :alt="p.title || p.handle">
                  <div v-else class="ma-mo-drop__thumb"></div>
                  <div class="ma-mo-drop__body">
                    <div class="ma-mo-drop__title">
                      <span v-if="p.variant_title" class="ma-mo-drop__variant">[[ p.variant_title ]]</span>[[ p.title || p.handle ]]
                    </div>
                  </div>
                  <span v-if="manualOrderCartMap[p.variant_id || p.handle]" class="ma-mo-drop__qty">×[[ manualOrderCartMap[p.variant_id || p.handle].qty ]]</span>
                  <span class="ma-mo-drop__price">[[ formatMoney(p.price) ]]</span>
                </div>
                <div class="ma-mo-drop__foot">
                  <span>
                    <template v-if="manualOrderSearchTotal > manualOrderSearchResults.length">Hiện [[ manualOrderSearchResults.length ]] / [[ manualOrderSearchTotal ]] SP</template>
                    <template v-else>[[ manualOrderSearchTotal ]] sản phẩm</template>
                  </span>
                  <span v-if="manualOrder.cart.length" class="font-semibold text-primary">Đã chọn [[ manualOrder.cart.length ]] loại</span>
                </div>
              </template>
              <div v-else-if="manualOrder.itemSearch.trim() && !manualOrder.quickAdd.show" class="ma-mo-drop__empty">
                <p>Không tìm thấy sản phẩm khớp "[[ manualOrder.itemSearch.trim() ]]".</p>
                <button type="button" @mousedown.prevent @click="openManualOrderQuickAdd"
                  class="mt-2 inline-flex items-center gap-1.5 text-primary font-bold text-label-md hover:underline">
                  <span class="material-symbols-outlined text-[16px]">add_circle</span>Thêm nhanh vào kho
                </button>
              </div>
              <div v-else class="ma-mo-drop__empty">Gõ để tìm sản phẩm hoặc bấm <kbd>Esc</kbd> để đóng</div>
            </div>
          </div>


          <div v-if="manualOrderCategories.length" class="ma-mo-cats"
            style="display:flex;overflow-x:auto;flex-wrap:nowrap;gap:6px;padding-bottom:4px;scrollbar-width:thin;">
            <button type="button" :class="{ 'is-active': !manualOrder.categoryFilter }"
              style="flex-shrink:0;white-space:nowrap;"
              @click="manualOrder.categoryFilter = ''; focusManualOrderProductSearch()">Tất cả</button>
            <button v-for="cat in manualOrderCategories" :key="cat" type="button"
              :class="{ 'is-active': manualOrder.categoryFilter === cat }"
              style="flex-shrink:0;white-space:nowrap;"
              @click="manualOrder.categoryFilter = cat; focusManualOrderProductSearch()">[[ cat ]]</button>
          </div>


          <div class="ma-mo-cart-wrap">
            <div class="ma-mo-cart-header">
              <span class="ma-mo-cart-header__title">Giỏ hàng</span>
              <span v-if="manualOrder.cart.length" class="ma-mo-cart-header__count">[[ manualOrder.cart.length ]] loại · [[ manualOrder.cart.reduce(function(s,i){return s+Number(i.qty||0);},0) ]] món</span>
            </div>
            <div class="ma-mo-cart-body custom-scrollbar">
              <div v-if="!manualOrder.cart.length" class="ma-mo-cart-body__empty">
                <span class="material-symbols-outlined">shopping_cart</span>
                Chưa có sản phẩm — dùng ô tìm ở trên<br><span class="opacity-70">hoặc bấm <kbd style="padding:1px 5px;border:1px solid var(--ma-bd);border-radius:4px;background:var(--ma-card);font-size:11px">F3</kbd> để focus</span>
              </div>

              <table v-else class="ma-mo-cart-table">
                <thead>
                  <tr>
                    <th class="ma-mo-cart-table__thumb-col"></th>
                    <th class="ma-mo-cart-table__name-col">Sản phẩm</th>
                    <th class="ma-mo-cart-table__qty-col">SL</th>
                    <th class="ma-mo-cart-table__price-col">Đơn giá</th>
                    <th class="ma-mo-cart-table__discount-col" title="Chiết khấu theo dòng — chưa áp vào tổng, chờ backend hỗ trợ (docs/mops.md §16.5)">Chiết khấu</th>
                    <th class="ma-mo-cart-table__total-col">Thành tiền</th>
                    <th class="ma-mo-cart-table__actions-col"></th>
                  </tr>
                </thead>
                <tbody>
                  <tr v-for="item in manualOrder.cart" :key="item.variant_id || item.handle">
                    <td class="ma-mo-cart-table__thumb-col">
                      <img v-if="item.image" :src="item.image" class="ma-mo-cart-item__thumb" width="44" height="44" :alt="item.title">
                      <div v-else class="ma-mo-cart-item__thumb ma-mo-cart-item__thumb--empty"><span class="material-symbols-outlined text-[20px]">image</span></div>
                    </td>
                    <td class="ma-mo-cart-table__name-col">
                      <div class="ma-mo-cart-item__title" :title="item.title">[[ item.title ]]</div>
                      <div v-if="item.sku" class="ma-mo-cart-item__meta">SKU: [[ item.sku ]]</div>
                    </td>
                    <td class="ma-mo-cart-table__qty-col">
                      <input type="number" min="1" step="1"
                        :value="item.qty"
                        @input="item.qty = Math.max(1, parseInt($event.target.value, 10) || 1)"
                        class="ma-mo-cart-table__input" aria-label="Số lượng">
                    </td>
                    <td class="ma-mo-cart-table__price-col">
                      <span class="ma-mo-cart-table__readonly" :title="'Giá lấy từ Products.Price — sửa giá vào tab Sản phẩm (nút bút chì)'">[[ formatMoney(item.price) ]]</span>
                    </td>
                    <td class="ma-mo-cart-table__discount-col">
                      <input type="number" min="0" step="1000"
                        :value="item.line_discount || 0"
                        @input="item.line_discount = Math.max(0, parseInt($event.target.value, 10) || 0)"
                        class="ma-mo-cart-table__input ma-mo-cart-table__input--muted"
                        title="Chiết khấu dòng (VND) — chờ backend hỗ trợ (mops.md §16.5). Chưa tác động Tổng cộng."
                        aria-label="Chiết khấu (chưa áp)">
                    </td>
                    <td class="ma-mo-cart-table__total-col">
                      <span class="ma-mo-cart-item__price">[[ formatMoney(item.price * item.qty) ]]</span>
                    </td>
                    <td class="ma-mo-cart-table__actions-col">
                      <button type="button" @click="openProductEditFromCart(item)" class="ma-mo-cart-table__act-btn" title="Chỉnh sản phẩm này (tab Sản phẩm)" aria-label="Chỉnh sản phẩm">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                      </button>
                      <button type="button" @click="removeFromManualOrderCart(item.variant_id || item.handle)" class="ma-mo-cart-table__act-btn ma-mo-cart-table__act-btn--danger" title="Xoá khỏi đơn" aria-label="Xoá">
                        <span class="material-symbols-outlined text-[18px]">delete</span>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>


          <div v-if="manualOrder.quickAdd.show" class="p-3 border border-outline-variant rounded-lg bg-surface-container-low space-y-2">
            <p class="text-label-md font-bold text-on-surface-variant uppercase tracking-wider">Thêm nhanh sản phẩm</p>
            <input type="text" v-model="manualOrder.quickAdd.title" placeholder="Tên sản phẩm *" class="ma-input">
            <div class="grid grid-cols-2 gap-2">
              <input type="number" min="0" v-model="manualOrder.quickAdd.price" placeholder="Giá bán *" class="ma-input">
              <input type="number" min="0" v-model="manualOrder.quickAdd.inventoryQty" placeholder="Tồn kho" class="ma-input">
            </div>
            <input type="text" v-model="manualOrder.quickAdd.sku" placeholder="SKU (tuỳ chọn)" class="ma-input">
            <div class="grid grid-cols-2 gap-2">
              <input type="text" v-model="manualOrder.quickAdd.productType" list="manualOrderQuickAddCategories" placeholder="Danh mục" class="ma-input">
              <input type="text" v-model="manualOrder.quickAdd.vendor" placeholder="Thương hiệu" class="ma-input">
            </div>
            <datalist id="manualOrderQuickAddCategories">
              <option v-for="cat in manualOrderCategories" :key="cat" :value="cat"></option>
            </datalist>
            <input type="text" v-model="manualOrder.quickAdd.image" placeholder="Ảnh — URL" class="ma-input">
            <div class="flex gap-2">
              <button type="button" @click="submitManualOrderQuickAdd" :disabled="manualOrder.quickAdd.saving" class="ma-btn-primary flex-1 justify-center disabled:opacity-50">[[ manualOrder.quickAdd.saving ? 'Đang lưu...' : 'Lưu nhanh' ]]</button>
              <button type="button" @click="closeManualOrderQuickAdd" class="ma-btn-outline">Huỷ</button>
            </div>
          </div>
            </div><!-- /p-3 card body -->
          </div><!-- /ma-card Sản phẩm (KHỐI 2 close) -->


          <!-- ═══ Ghi chú đơn hàng + Tổng tiền — hàng 2 cột khớp vị trí ảnh mẫu Sapo (2026-08-29).
               note/internal_note dời từ khối Khách hàng xuống đây; Tổng tiền là bản đọc-only của
               manualOrderAmounts (nút Tạo đơn/Lưu vẫn ở CTA đáy trang, không lặp ở đây). ═══ -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="ma-card">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">sticky_note_2</span>
                <h3 class="text-body-md font-bold text-on-surface">Ghi chú đơn hàng</h3>
              </div>
              <div class="p-3 flex flex-col gap-2">
                <label class="ma-label-sm flex items-center gap-1"><span>💬</span> Ghi chú của khách <span class="ma-text-hint">(in trên phiếu giao)</span></label>
                <textarea v-model="manualOrder.note" rows="2" placeholder="Ghi chú đơn (khách nhắn cho shop, sẽ in trên phiếu)" class="ma-input"></textarea>
                <label class="ma-label-sm flex items-center gap-1 mt-2"><span>🔒</span> Ghi chú nội bộ <span class="ma-text-hint">(chỉ staff xem — KHÔNG in)</span></label>
                <textarea v-model="manualOrder.internal_note" rows="2" placeholder="Chỉ staff/kế toán xem. Vd: khách khó tính, hẹn CK 10% đơn sau, chờ CK bổ sung…" class="ma-input" style="background:#fefce8;border-color:#fde68a;"></textarea>
              </div>
            </div>
            <div class="ma-card">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">receipt_long</span>
                <h3 class="text-body-md font-bold text-on-surface">Tổng tiền</h3>
              </div>
              <div class="p-3 flex flex-col gap-2 text-body-sm">
                <div class="flex justify-between"><span class="text-on-surface-variant">Tạm tính</span><span>[[ formatMoney(manualOrderAmounts.subtotal) ]]</span></div>
                <div v-if="manualOrderAmounts.discount > 0" class="flex justify-between">
                  <span class="text-on-surface-variant">[[ (manualOrder.couponPreview && manualOrder.couponPreview.valid) ? 'Mã giảm giá' : 'Chiết khấu' ]]</span>
                  <span class="text-emerald-700">−[[ formatMoney(manualOrderAmounts.discount) ]]</span>
                </div>
                <div v-if="manualOrder.wantsShipping" class="flex justify-between">
                  <span class="text-on-surface-variant">Phí vận chuyển</span>
                  <span>[[ formatMoney(manualOrderAmounts.fee) + (manualOrder.customerShippingFeeManual ? ' · tay' : '') ]]</span>
                </div>
                <div class="flex justify-between items-baseline pt-2 mt-1 border-t border-outline-variant font-bold text-body-md"><span>Khách phải trả</span><span class="text-primary text-body-lg">[[ formatMoney(manualOrderAmounts.total) ]]</span></div>
              </div>
            </div>
          </div>


            <div class="ma-card">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">payments</span>
                <h3 class="text-body-md font-bold text-on-surface">Thanh toán</h3>
              </div>
              <div class="p-3 flex flex-col gap-2">
              <p v-if="paymentEditLock.locked" class="text-label-sm text-amber-700" :title="paymentEditLock.reason">[[ paymentEditLock.reason ]]</p>
              <div class="ma-mo-seg" :class="{ 'opacity-60': paymentEditLock.locked }">
                <button type="button" :class="{ 'is-active': manualOrder.paymentMethod === 'VIETQR' }" :disabled="paymentEditLock.locked"
                  @click="manualOrder.paymentMethod = 'VIETQR'" :title="paymentEditLock.locked ? paymentEditLock.reason : ''">
                  <span class="material-symbols-outlined">qr_code_2</span>VietQR
                </button>
                <button type="button" :class="{ 'is-active': manualOrder.paymentMethod === 'COD' }" :disabled="paymentEditLock.locked"
                  @click="manualOrder.paymentMethod = 'COD'; previewShippingFee()" :title="paymentEditLock.locked ? paymentEditLock.reason : ''">
                  <span class="material-symbols-outlined">local_atm</span>COD
                </button>
                <button v-if="paymentMethodOptionAvailable.CASH" type="button" :class="{ 'is-active': manualOrder.paymentMethod === 'CASH' }" :disabled="paymentEditLock.locked"
                  @click="manualOrder.paymentMethod = 'CASH'; previewShippingFee()" :title="paymentEditLock.locked ? paymentEditLock.reason : ''">
                  <span class="material-symbols-outlined">payments</span>Tiền mặt
                </button>
              </div>
              <div v-if="manualOrder.paymentMethod === 'VIETQR'" class="rounded-lg border border-outline-variant bg-surface-container-low p-2.5 text-body-sm">
                <div v-if="bankAccounts.loading" class="ma-component-skeleton py-1"><span class="ma-component-skeleton__line"></span></div>
                <div v-else-if="bankAccounts.error" class="text-error">[[ bankAccounts.error ]] <button type="button" @click="loadBankAccounts" class="underline">Thử lại</button></div>
                <div v-else-if="manualOrderReceivingBank">
                  <p class="font-bold">[[ manualOrderReceivingBank.bank_code ]] · [[ manualOrderReceivingBank.account_no ]]</p>
                  <p v-if="manualOrderReceivingBank.account_name" class="text-on-surface-variant">[[ manualOrderReceivingBank.account_name ]]</p>
                </div>
                <div v-else class="ma-component-empty py-1"><span class="material-symbols-outlined">account_balance</span><span>Chưa có TK nhận cho chi nhánh này.</span></div>
              </div>
              <p v-if="manualOrder.paymentMethod === 'VIETQR'" class="ma-mo-help">Hệ thống tự sinh mã QR động chứa OrderID sau khi bấm <b>Tạo đơn</b>.</p>
              <p v-else-if="manualOrder.paymentMethod === 'COD'" class="ma-mo-help">COD: <b>đơn vị vận chuyển thu hộ</b> khi giao — không thu tiền ngay khi tạo đơn.</p>
              <p v-else-if="manualOrder.paymentMethod === 'CASH'" class="ma-mo-help">Tiền mặt: chỉ dùng cho <b>bán tại quầy</b> — nhân viên thu tiền trực tiếp khi giao hàng cho khách.</p>


              <!-- 3-Axis Status (2026-08-09): với POS tại quầy (không giao hàng), 1 checkbox chốt cả 3
                   trục — Payment=PAID + Fulfillment=delivered + Status=COMPLETED (giống Sapo/Haravan/KiotViet).
                   Với giao hàng có VIETQR trả trước, chỉ chốt Payment=PAID, kho vẫn phải đóng gói. -->
              <label v-if="!manualOrder.editingOrderId && manualOrder.paymentMethod !== 'COD'"
                class="mt-2 flex items-start gap-2 rounded-lg border border-emerald-200 bg-emerald-50 p-2.5 cursor-pointer hover:bg-emerald-100 transition-colors">
                <input type="checkbox" v-model="manualOrder.confirmPaymentImmediately" class="mt-0.5 w-4 h-4 rounded border-emerald-400 text-emerald-600 focus:ring-emerald-500">
                <span class="text-body-sm text-emerald-900 leading-snug flex-1">
                  <b>[[ !manualOrder.wantsShipping ? 'Thanh toán &amp; Giao ngay tại quầy' : 'Đã nhận tiền — xác nhận thanh toán ngay' ]]</b>
                  <kbd class="ml-1 text-label-sm px-1.5 py-0.5 bg-white border border-emerald-300 rounded">Alt+P</kbd>
                  <span class="block text-label-sm text-emerald-700 opacity-90">
                    [[ !manualOrder.wantsShipping
                       ? 'POS tại quầy · 1 bước: đơn tạo xong sẽ tự chốt "Đã thanh toán → Đã giao → Hoàn tất" + ghi Phiếu Thu — không phải bấm thêm nút nào.'
                       : (manualOrder.paymentMethod === 'CASH' ? 'Tiền mặt đã thu tại quầy — đơn tạo xong sẽ tự chuyển "Đã TT" và ghi Phiếu Thu. Kho vẫn cần đóng gói &amp; tạo vận đơn.' : 'Khách đã chuyển khoản trước — đơn tạo xong sẽ tự chuyển "Đã TT" và ghi Phiếu Thu. Kho vẫn cần đóng gói &amp; tạo vận đơn.') ]]
                  </span>
                </span>
              </label>

              <!-- Shortcut "tạo đơn + mở modal Tạo vận đơn ngay" — 1 click cho luồng giao hàng.
                   Sau create_order success, submitManualOrder tự openShipModal(orders.detail của
                   đơn vừa tạo). 2026-08-08 (COD). 2026-08-20 từng mở rộng sang VIETQR nhưng
                   2026-08-30 thu hồi lại COD-only: (1) Alt+P chỉ thật sự điều khiển checkbox này
                   khi COD (xem key handler), khi VIETQR phím đó lại toggle "Xác nhận thanh toán
                   ngay" ở trên — 2 checkbox cùng ghi Alt+P gây nhầm; (2) VIETQR đơn chưa chắc đã
                   được chuyển khoản, ép staff điền đủ địa chỉ giao hàng ngay lúc tạo đơn chỉ để
                   auto-mở modal là dư — trang chi tiết đơn đã có sẵn nút "Tạo vận đơn" bấm tay bất
                   kỳ lúc nào. Loại CASH — bán tại quầy không giao hàng, không cần vận đơn. -->
              <label v-if="!manualOrder.editingOrderId && manualOrder.wantsShipping && manualOrder.paymentMethod === 'COD'"
                class="mt-2 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-2.5 cursor-pointer hover:bg-amber-100 transition-colors">
                <input type="checkbox" v-model="manualOrder.openShipmentImmediately" class="mt-0.5 w-4 h-4 rounded border-amber-400 text-amber-600 focus:ring-amber-500">
                <span class="text-body-sm text-amber-900 leading-snug flex-1">
                  <b>Mở modal Tạo vận đơn sau khi tạo đơn</b>
                  <kbd class="ml-1 text-label-sm px-1.5 py-0.5 bg-white border border-amber-300 rounded">Alt+P</kbd>
                  <span class="block text-label-sm text-amber-700 opacity-90">
                    COD tiền do vận chuyển thu — đơn tạo xong tự mở modal Tạo vận đơn để bạn chọn ĐVVC (Goship / GHN / GHTK…) rồi đặt.
                    <b class="block mt-1">Cần đủ tên người nhận / SĐT / số nhà / Tỉnh–Huyện–Xã trước khi tạo đơn.</b>
                  </span>
                </span>
              </label>
              </div><!-- /p-3 card body -->
            </div><!-- /ma-card Thanh toán -->


            <!-- Giảm giá — VISUAL LOCK rõ hơn (2026-08-08): trước đây chỉ disabled:opacity-50
                 nhìn không nổi. Giờ: cả block bị lock có background xám + icon lock + hint text
                 dưới nói rõ "Đã dùng X, bỏ để chỉnh Y". -->
            <div class="ma-card">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">sell</span>
                <h3 class="text-body-md font-bold text-on-surface">Giảm giá</h3>
                <span class="ma-mo-block__hint">· chọn 1 trong 2</span>
              </div>
              <div class="p-3 flex flex-col gap-2">
              <div class="flex items-center gap-2 rounded-lg p-1 transition-all"
                :style="Number(manualOrder.discountValue) > 0 ? 'background:rgba(0,0,0,.04);opacity:.55;pointer-events:none;' : ''">
                <span v-if="Number(manualOrder.discountValue) > 0" class="material-symbols-outlined text-[16px] text-on-surface-variant pl-1" title="Đã dùng chiết khấu tay — bỏ chiết khấu để nhập mã">lock</span>
                <input type="text" v-model="manualOrder.couponCode" :disabled="Number(manualOrder.discountValue) > 0" placeholder="Mã giảm giá" class="ma-input flex-1">
                <button type="button" @click="applyManualOrderCoupon" :disabled="manualOrder.couponChecking || Number(manualOrder.discountValue) > 0" class="px-3 py-2 rounded-lg border border-outline-variant text-label-md font-bold hover:bg-surface-container-low whitespace-nowrap">[[ manualOrder.couponChecking ? '...' : 'Áp dụng' ]]</button>
              </div>
              <div v-if="manualOrder.couponPreview" class="text-body-sm" :class="manualOrder.couponPreview.valid ? 'text-emerald-700' : 'text-error'">
                [[ manualOrder.couponPreview.valid ? ('Đã áp dụng — giảm ' + formatMoney(manualOrder.couponPreview.discount_amount)) : manualOrder.couponPreview.error ]]
              </div>
              <div class="flex items-end gap-2 rounded-lg p-1 transition-all"
                :style="!!(manualOrder.couponPreview && manualOrder.couponPreview.valid) ? 'background:rgba(0,0,0,.04);opacity:.55;pointer-events:none;' : ''">
                <span v-if="!!(manualOrder.couponPreview && manualOrder.couponPreview.valid)" class="material-symbols-outlined text-[16px] text-on-surface-variant pb-2 pl-1" title="Đã áp mã — xoá mã để chỉnh chiết khấu">lock</span>
                <select v-model="manualOrder.discountType" :disabled="!!(manualOrder.couponPreview && manualOrder.couponPreview.valid)" class="ma-input" style="max-width:88px">
                  <option value="%">%</option>
                  <option value="VNĐ">VNĐ</option>
                </select>
                <input type="number" min="0" v-model="manualOrder.discountValue" :disabled="!!(manualOrder.couponPreview && manualOrder.couponPreview.valid)" placeholder="Chiết khấu tại quầy" class="ma-input flex-1">
              </div>
              <p v-if="Number(manualOrder.discountValue) > 0 && manualOrder.couponCode" class="text-label-sm text-amber-700">
                <span class="material-symbols-outlined text-[13px] align-middle">info</span>
                Đang chặn ô Mã giảm giá — <button type="button" @click="manualOrder.discountValue = ''; manualOrder.discountReason = ''" class="underline font-bold">xoá chiết khấu tay</button> để nhập mã.
              </p>
              <p v-else-if="manualOrder.couponPreview && manualOrder.couponPreview.valid" class="text-label-sm text-amber-700">
                <span class="material-symbols-outlined text-[13px] align-middle">info</span>
                Đang chặn ô Chiết khấu tay — <button type="button" @click="manualOrder.couponCode = ''; manualOrder.couponPreview = null" class="underline font-bold">bỏ mã</button> để chỉnh chiết khấu.
              </p>
              <input v-if="Number(manualOrder.discountValue) > 0" type="text" v-model="manualOrder.discountReason" placeholder="Ghi chú (Khách Sỉ / Hàng lỗi…)" class="ma-input">
              </div><!-- /p-3 card body -->
            </div><!-- /ma-card Giảm giá -->


            <div v-if="manualOrder.editingOrderId" class="ma-card">
              <div class="ma-card__head">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">edit_note</span>
                <h3 class="text-body-md font-bold text-on-surface">Lý do sửa đơn</h3>
                <span class="ma-mo-block__hint">(tuỳ chọn)</span>
              </div>
              <div class="p-3">
              <input type="text" v-model="manualOrder.editReason" placeholder="Khách đổi sản phẩm / nhầm địa chỉ…" class="ma-input">
              </div>
            </div>

        </div><!-- /cột chính -->

        <!-- ═══ Cột phụ "Thông tin bổ sung" (2026-08-29) — Bán tại (branchId, dời từ Chi nhánh),
             Bán bởi (nhân viên đang đăng nhập, readonly — không có field "đổi người bán" ở BE),
             Hẹn giao (appointmentDate/Time, chỉ hiện khi Loại đơn = Đặt lịch). Ẩn Nguồn/Mã đơn/
             Phát hành hoá đơn điện tử — BE chưa hỗ trợ. ═══ -->
        <aside class="xl:sticky xl:top-0 flex flex-col gap-3 min-w-0">
          <div class="ma-card">
            <div class="ma-card__head">
              <span class="material-symbols-outlined text-[18px] text-on-surface-variant">tune</span>
              <h3 class="text-body-md font-bold text-on-surface">Thông tin bổ sung</h3>
            </div>
            <div class="p-3 flex flex-col gap-3">
              <div>
                <label class="ma-label-sm">Bán tại</label>
                <select v-model="manualOrder.branchId" :disabled="branches.loading || !!branches.error" class="ma-input">
                  <option value="">— Mặc định (chi nhánh chính) —</option>
                  <option v-for="b in activeBranches" :key="b.branch_id" :value="b.branch_id">[[ b.name_vi ]]</option>
                </select>
                <p v-if="branches.loading" class="text-label-sm text-on-surface-variant opacity-70">
                  <span class="material-symbols-outlined ma-spin text-[14px] align-middle text-primary">progress_activity</span>Đang tải…
                </p>
                <p v-else-if="branches.error" class="text-label-sm text-error">[[ branches.error ]] — <button type="button" @click="loadBranches" class="underline">Thử lại</button></p>
              </div>
              <div>
                <label class="ma-label-sm">Bán bởi</label>
                <input type="text" :value="(staff && (staff.name || staff.username)) || '—'" disabled class="ma-input opacity-70">
              </div>
              <div v-if="manualOrder.orderType === 'booking'">
                <label class="ma-label-sm">Hẹn giao <span class="text-error font-bold">*</span></label>
                <div class="grid grid-cols-2 gap-2">
                  <input type="date" v-model="manualOrder.appointmentDate" ref="manualOrderAppointmentDate" @change="manualOrder.invalidField = null"
                    class="ma-input" :class="{ 'ma-input-error': manualOrder.invalidField === 'appointmentDate' }">
                  <input type="time" v-model="manualOrder.appointmentTime" class="ma-input">
                </div>
              </div>
            </div>
          </div>

          <!-- ═══ Đóng gói và giao hàng (2026-08-29, dời vào cột phụ theo yêu cầu) — tái dùng đúng
               tên thẻ Sapo mẫu. Sapo mẫu có 4 nút chọn hãng vận chuyển ngay lúc tạo đơn; MOPS chưa
               có bước này (chọn hãng nằm ở modal "Tạo vận đơn" riêng, mở SAU khi tạo đơn xong — xem
               openShipModal), nên card này giữ đúng ý nghĩa hiện có: toggle Bán tại quầy/Giao hàng +
               phí ship tay + giao cho người khác + tick mở modal vận đơn ngay. ═══ -->
          <div class="ma-card">
            <div class="ma-card__head">
              <span class="material-symbols-outlined text-[18px] text-on-surface-variant">local_shipping</span>
              <h3 class="text-body-md font-bold text-on-surface">Đóng gói và giao hàng</h3>
            </div>
            <div class="p-3 flex flex-col gap-3">
              <div class="ma-mo-seg">
                <button type="button" :class="{ 'is-active': !manualOrder.wantsShipping }"
                  @click="if (manualOrder.wantsShipping) { manualOrder.wantsShipping = false; onWantsShippingToggle(); }">
                  <span class="material-symbols-outlined">storefront</span>Bán tại quầy
                </button>
                <button type="button" :class="{ 'is-active': manualOrder.wantsShipping }"
                  @click="if (!manualOrder.wantsShipping) { manualOrder.wantsShipping = true; onWantsShippingToggle(); }">
                  <span class="material-symbols-outlined">local_shipping</span>Giao hàng
                </button>
              </div>

              <div v-if="manualOrder.wantsShipping" class="grid grid-cols-1 gap-stack-md">
                <div class="grid grid-cols-1 gap-2">
                  <label class="flex items-center gap-2 text-body-sm cursor-pointer"><input type="checkbox" v-model="manualOrder.customerShippingFeeManual" class="w-4 h-4"><span>Chỉnh phí giao thủ công</span></label>
                  <div v-if="manualOrder.customerShippingFeeManual" class="flex items-center gap-2"><input v-model="manualOrder.customerShippingFee" type="number" min="0" step="1000" class="ma-input"><span class="text-body-sm text-on-surface-variant">đ</span></div>
                  <p v-else class="text-body-sm text-on-surface-variant opacity-70">Tự động: miễn phí từ 500.000đ, dưới mức 30.000đ.</p>
                </div>

                <!-- Giao cho người khác (collapse) — mặc định người nhận = khách. -->
                <div>
                  <button type="button" @click="manualOrder.shipToOther = !manualOrder.shipToOther"
                    class="flex items-center gap-1.5 text-label-sm text-primary font-bold hover:opacity-80">
                    <span class="material-symbols-outlined text-[14px]">[[ manualOrder.shipToOther ? 'expand_less' : 'expand_more' ]]</span>
                    [[ manualOrder.shipToOther ? 'Người nhận = Khách hàng' : 'Giao cho người khác?' ]]
                  </button>
                  <div v-if="manualOrder.shipToOther" class="grid grid-cols-1 gap-stack-md mt-2">
                    <input type="text" ref="manualOrderShipReceiverName" v-model="manualOrder.shipReceiverName" :placeholder="'Tên người nhận (mặc định: ' + (manualOrder.customerName || 'Khách hàng') + ')'" class="ma-input" :class="manualOrder.invalidField === 'shipReceiverName' ? 'ma-input-error' : ''">
                    <input type="tel" ref="manualOrderShipPhone" v-model="manualOrder.shipPhone" :placeholder="'SĐT người nhận (mặc định: ' + (manualOrder.phone || '—') + ')'" class="ma-input" :class="manualOrder.invalidField === 'shipPhone' ? 'ma-input-error' : ''">
                    <!-- shipReceiverAddress: override số nhà/đường cho lần giao này, KHÔNG đụng
                         hồ sơ khách. Payload gửi shipReceiverAddress khi có; ngược lại fallback shipAddress.
                         Còn Tỉnh/Huyện/Xã lấy chung theo picker 3 cấp phía trên (đa số trường hợp
                         giao trong cùng địa bàn). Nếu muốn giao sang địa bàn khác — chọn lại 3 cấp. -->
                    <input type="text" v-model="manualOrder.shipReceiverAddress" :placeholder="'Địa chỉ giao khác (mặc định: ' + (manualOrder.shipAddress || '—') + ')'" class="ma-input">
                    <p class="ma-mo-help">Địa chỉ giao riêng biệt cho lần này — <b>không</b> làm thay đổi hồ sơ khách hàng.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </aside>
        </div><!-- /grid cột chính + cột phụ -->

        </div><!-- /ma-mo-flow -->

          <div class="ma-mo-cta">
            <div v-if="manualOrder.error" class="px-3 py-2 rounded-lg bg-error-container text-on-error-container text-body-sm">
              <span class="material-symbols-outlined text-[16px] align-middle mr-1">error</span>[[ manualOrder.error ]]
            </div>
            <!-- Số tiền hiển thị ở card "Tổng tiền" trong cột chính (2026-08-29) — CTA đáy trang chỉ
                 còn hàng nút, mirror đúng thanh Thoát/Tạo đơn hàng ở đầu trang như ảnh mẫu Sapo. -->
            <div class="ma-mo-cta__actions">
              <button @click="closeManualOrderForm" type="button" class="ma-btn-outline">Thoát</button>
              <!-- Cart empty guard (2026-08-08) — trước đây nút "Tạo đơn" vẫn sáng dù cart rỗng,
                   dễ bấm nhầm tạo đơn 0đ. Disable + đổi label để rõ lý do khoá. -->
              <button v-if="manualOrder.editingOrderId" type="button" @click="submitManualOrder"
                :disabled="manualOrder.submitting || !manualOrder.cart.length" class="ma-mo-cta__btn">
                <span class="material-symbols-outlined">save</span>[[ !manualOrder.cart.length ? 'Chưa có sản phẩm' : (manualOrder.submitting ? 'Đang lưu…' : 'Lưu thay đổi') ]] <kbd v-if="!manualOrder.submitting && manualOrder.cart.length">F9</kbd>
              </button>
              <button v-else type="button" @click="submitManualOrder"
                :disabled="manualOrder.submitting || !manualOrder.cart.length || (manualOrder.paymentMethod !== 'COD' && !paymentConfigured)"
                class="ma-mo-cta__btn">
                <span v-if="manualOrder.cart.length && !(manualOrder.paymentMethod !== 'COD' && !paymentConfigured)" class="material-symbols-outlined">check</span>[[ !manualOrder.cart.length ? 'Chưa có sản phẩm — hãy chọn ít nhất 1 SP' : ((manualOrder.paymentMethod !== 'COD' && !paymentConfigured) ? 'Chưa cấu hình tài khoản nhận tiền' : (manualOrder.submitting ? 'Đang tạo…' : 'Tạo đơn hàng')) ]]<kbd v-if="!manualOrder.submitting && manualOrder.cart.length && !(manualOrder.paymentMethod !== 'COD' && !paymentConfigured)">F9</kbd>
              </button>
            </div>
          </div>
      </div>
    </div>

    <!-- ═══ Modal chọn địa chỉ giao hàng (2026-08-21) ═══════════════════════
         List mode: radio-select từ sổ địa chỉ của khách (manualOrder.selectedCustomer.addresses),
         Áp dụng → gọi applyManualOrderCustomerAddress → đóng modal.
         Add mode: dùng <mops-address-picker> component chung + input Tên/SĐT/Số nhà, Lưu → POST
         save_customer_address → refresh customer.addresses → auto-apply + đóng modal. -->
    <div v-if="manualOrder.addressPicker.open" @click="closeAddressPicker" class="ma-modal-backdrop"></div>
    <div v-if="manualOrder.addressPicker.open" class="ma-modal-panel" style="max-width: 640px; max-height: 85vh; overflow-y: auto;">
      <!-- Header — 2 mode -->
      <div class="ma-row-header">
        <div v-if="manualOrder.addressPicker.mode === 'list'" class="flex items-center gap-2 flex-1">
          <span class="material-symbols-outlined text-on-surface-variant">home_pin</span>
          <h3 class="ma-heading">Chọn địa chỉ giao hàng</h3>
        </div>
        <div v-else class="flex items-center gap-2 flex-1">
          <button @click="switchAddressPickerToList" type="button"
            class="inline-flex items-center gap-1 text-on-surface-variant hover:text-primary text-label-md font-bold">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>Quay lại
          </button>
          <h3 class="ma-heading">Thêm địa chỉ mới</h3>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <button v-if="manualOrder.addressPicker.mode === 'list'" @click="switchAddressPickerToAdd" type="button"
            class="inline-flex items-center gap-1 bg-primary text-on-primary px-3 py-1.5 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95">
            <span class="material-symbols-outlined text-[16px]">add</span>Thêm mới
          </button>
          <button @click="closeAddressPicker" type="button" class="ma-icon-btn" aria-label="Đóng">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
      </div>

      <!-- List mode body -->
      <div v-if="manualOrder.addressPicker.mode === 'list'" class="mt-stack-md">
        <div v-if="manualOrder.selectedCustomer && (manualOrder.selectedCustomer.addresses || []).length" class="space-y-2">
          <label v-for="a in manualOrder.selectedCustomer.addresses" :key="a.address_id"
            class="flex items-start gap-3 p-3 rounded-lg border cursor-pointer transition-all"
            :class="manualOrder.addressPicker.pendingSelectId === a.address_id ? 'border-primary bg-primary-container/40' : 'border-outline-variant hover:bg-surface-container-low'">
            <input type="radio" :value="a.address_id" v-model="manualOrder.addressPicker.pendingSelectId"
              class="mt-1 w-4 h-4 accent-primary flex-shrink-0">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span v-if="a.is_default" class="text-label-sm font-bold text-primary uppercase tracking-wider">Mặc định</span>
                <span v-if="a.receiver_name" class="text-body-md font-semibold text-on-surface">[[ a.receiver_name ]]</span>
                <span v-if="a.phone" class="text-label-sm text-on-surface-variant">· [[ a.phone ]]</span>
              </div>
              <div class="text-body-sm text-on-surface mt-1 break-words">
                [[ [a.address, a.ward, a.district, a.province].filter(function(v){return v;}).join(', ') ]]
              </div>
            </div>
          </label>
        </div>
        <div v-else class="text-center py-8 px-4 rounded-lg border border-dashed border-outline-variant bg-surface-container-low">
          <span class="material-symbols-outlined text-[48px] text-on-surface-variant opacity-40">location_off</span>
          <p class="text-body-sm text-on-surface-variant mt-2">Khách này chưa có địa chỉ nào trong sổ.</p>
          <p class="text-label-sm text-on-surface-variant opacity-70 mt-1">Bấm "Thêm mới" ở trên để tạo địa chỉ đầu tiên.</p>
        </div>
      </div>

      <!-- Add mode body — reuse <mops-address-picker> component chung -->
      <div v-else class="mt-stack-md space-y-stack-md">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
          <div>
            <label class="ma-label">Tên người nhận</label>
            <input type="text" v-model="manualOrder.addressPicker.tempReceiverName" class="ma-input"
              :placeholder="manualOrder.customerName || 'Khách hàng'">
          </div>
          <div>
            <label class="ma-label">SĐT</label>
            <input type="tel" v-model="manualOrder.addressPicker.tempPhone" class="ma-input"
              :placeholder="manualOrder.phone || 'SĐT liên hệ'">
          </div>
        </div>
        <div>
          <label class="ma-label">Số nhà / Đường</label>
          <input type="text" v-model="manualOrder.addressPicker.tempStreet" class="ma-input"
            placeholder="Vd: 217A Phạm Viết Chánh">
          <p class="ma-mo-help">Dán trọn bộ địa chỉ (kèm xã/huyện/tỉnh) cũng được — hệ thống tự phân tách.</p>
        </div>
        <mops-address-picker
          v-model="manualOrder.addressPicker.tempAddr"
          mode="new"
          :raw-street="manualOrder.addressPicker.tempStreet"
          @update:rawStreet="manualOrder.addressPicker.tempStreet = $event"
          :show-save-default="false"
          :legacy-address="''"></mops-address-picker>
      </div>

      <!-- Footer -->
      <div v-if="manualOrder.addressPicker.mode === 'list'" class="flex gap-2 mt-stack-lg pt-stack-md border-t border-outline-variant">
        <button @click="confirmAddressPicker" :disabled="!manualOrder.addressPicker.pendingSelectId" type="button"
          class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:opacity-40">
          <span class="material-symbols-outlined text-[18px]">check</span>Áp dụng
        </button>
        <button @click="closeAddressPicker" type="button" class="ma-btn-outline">Huỷ</button>
      </div>
      <div v-else class="flex gap-2 mt-stack-lg pt-stack-md border-t border-outline-variant">
        <button @click="saveNewAddressFromPicker" :disabled="manualOrder.addressPicker.saving" type="button"
          class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">
          <span v-if="!manualOrder.addressPicker.saving" class="material-symbols-outlined text-[18px]">save</span>
          <span v-else class="material-symbols-outlined ma-spin text-[18px]">progress_activity</span>
          [[ manualOrder.addressPicker.saving ? 'Đang lưu…' : 'Lưu địa chỉ' ]]
        </button>
        <button @click="switchAddressPickerToList" type="button" class="ma-btn-outline"
          :disabled="manualOrder.addressPicker.saving">Quay lại danh sách</button>
      </div>
    </div>

  </section>

  <!-- ═══ Modal Tạo khách hàng mới (từ form Manual Order — 2026-08-12) ═══
       Reuse customers.createForm state + saveCustomerCreate method của tab Khách hàng
       (không duplicate logic dupe-check). Sau save success → auto-pick vào form đơn. -->
  <div v-if="manualOrder.showCreateCustomerModal" @click="closeManualOrderQuickCreateCustomer" class="ma-modal-backdrop"></div>
  <div v-if="manualOrder.showCreateCustomerModal" class="ma-modal-panel" style="max-width:520px">
    <div class="ma-row-header">
      <h3 class="ma-heading">
        <span class="material-symbols-outlined text-[18px] align-middle text-emerald-600">person_add</span>
        Tạo khách hàng mới
      </h3>
      <button @click="closeManualOrderQuickCreateCustomer" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <form @submit.prevent="submitManualOrderQuickCreate" class="p-4 flex flex-col gap-3">
      <div class="grid grid-cols-2 gap-3">
        <div>
        <label class="ma-label">Tên khách hàng <span class="text-error">*</span></label>
        <input v-model="customers.createForm.name" type="text" placeholder="Nguyễn Văn A" class="ma-input" autocomplete="name" autofocus>
      </div>
      <div>
          <label class="ma-label">Số điện thoại <span class="text-error">*</span></label>
          <div class="relative">
            <input required v-model="customers.createForm.phone" @input="onCustomerPhoneInput" @blur="onCustomerPhoneBlur"
                  type="tel" inputmode="numeric" placeholder="0912 345 678"
                  class="ma-input pr-9"
                  :class="{ 'ma-input-error': customers.createForm.dupeCheck.status === 'found' }"
                  autocomplete="tel">
            <span v-if="customers.createForm.dupeCheck.status === 'checking'"
                  class="absolute right-2.5 top-1/2 -translate-y-1/2 material-symbols-outlined ma-spin text-[18px] text-primary">progress_activity</span>
            <span v-else-if="customers.createForm.dupeCheck.status === 'notfound'"
                  class="absolute right-2.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-[18px] text-emerald-600" title="SĐT hợp lệ, chưa có trong hệ thống">check_circle</span>
          </div>
          <p v-if="customers.createForm.dupeCheck.status === 'found'" class="text-label-sm text-amber-700 mt-1.5 rounded-md bg-amber-50 border border-amber-200 px-2 py-1.5">
            <span class="material-symbols-outlined text-[14px] align-middle">warning</span>
            SĐT đã có: <b>[[ (customers.createForm.dupeCheck.existingCustomer || {}).name || '(chưa có tên)' ]]</b> —
            <button type="button" @click="pickExistingCustomerFromDupe" class="underline font-bold text-amber-900">chọn khách này</button>
            thay vì tạo trùng.
          </p>
        </div>
      </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="ma-label">Nhóm khách</label>
            <select v-model="customers.createForm.customerGroup" class="ma-input">
              <option value="LẺ">Lẻ (mặc định)</option>
              <option value="SỈ">Sỉ (auto giảm giá)</option>
            </select>
          </div>
          <div :disabled="customers.createForm.customerGroup === 'SỈ'">
            <label class="ma-label">Chiết khấu mặc định (%)</label>
            <input v-model="customers.createForm.defaultDiscountPercent" type="number" min="0" max="100" step="0.5" class="ma-input">
          </div>
        </div>
      <div>
        <label class="ma-label">Ghi chú KH <span class="opacity-60 font-normal">(tuỳ chọn)</span></label>
        <textarea v-model="customers.createForm.notes" placeholder="VD: khách mua đều mỗi tháng" class="ma-input"></textarea>
      </div>
      <!-- Khối Địa chỉ ngay trong modal Tạo KH (2026-08-12) — payload picker + street sẽ được
           merge vào customers.createForm.address* để saveCustomerCreate gọi save_customer_address
           luôn (best-effort). Sau save, mo.addr được prefill trực tiếp vào form đơn. -->
      <div class="pt-2 border-t border-outline-variant">
        <label class="ma-label flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">home_pin</span>
          Địa chỉ mặc định <span class="opacity-60 font-normal"></span>
        </label>
        <input v-model="manualOrder.newCustomerStreet" type="text" placeholder="Số nhà / Đường (vd: 217A Phạm Viết Chánh)" class="ma-input">
        <div class="mt-2">
          <mops-address-picker
            v-model="manualOrder.newCustomerAddr"
            mode="new"
            :raw-street="manualOrder.newCustomerStreet"
            @update:rawStreet="manualOrder.newCustomerStreet = $event"
            :dense="true"></mops-address-picker>
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-outline-variant">
        <button type="button" @click="closeManualOrderQuickCreateCustomer"
                class="ma-btn-outline" :disabled="customers.createSaving">Huỷ</button>
        <button type="submit"
                :disabled="customers.createSaving || customers.createForm.dupeCheck.status === 'found'"
                class="ma-btn-primary inline-flex items-center gap-1.5">
          <span v-if="customers.createSaving" class="material-symbols-outlined ma-spin text-[16px]">progress_activity</span>
          <span v-else class="material-symbols-outlined text-[16px]">save</span>
          [[ customers.createSaving ? 'Đang lưu…' : 'Lưu' ]]
        </button>
      </div>
    </form>
  </div>

  {%- comment -%}
    Modal "Sửa khách hàng" (customers.showEditForm) đã CHUYỂN sang workspaceView='customers.edit'
    (2026-08-22) — form giờ nằm trong snippets/mops_admin_tab_customers.bwt như một section
    riêng, header sticky + body bg-surface-bright đồng bộ với các detail view khác. Khối modal
    dưới đây dead-code, giữ v-if="false" chờ prune ở lượt cleanup kế tiếp.
  {%- endcomment -%}
  <div v-if="false" class="ma-modal-backdrop"></div>
  <div v-if="false" class="ma-modal-panel">
    <div class="ma-row-header">
      <h3 class="ma-heading">Sửa khách hàng — [[ customers.editTarget && customers.editTarget.name || 'Khách lẻ' ]]</h3>
      <button @click="customers.showEditForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-modal-body">
      <div class="space-y-stack-md">
      <div>
        <label class="ma-label">Tên *</label>
        <input type="text" v-model="customers.editForm.name" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Email <span class="ma-text-hint">(tuỳ chọn)</span></label>
        <input type="text" v-model="customers.editForm.email" class="ma-input">
      </div>
      <div class="pt-2 border-t border-outline-variant">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Chính sách giá <span class="font-normal opacity-60">(docs/mops.md §16)</span></p>
        <div class="grid grid-cols-2 gap-stack-md">
          <div>
            <label class="ma-label">Nhóm khách</label>
            <select v-model="customers.editForm.customerGroup" class="ma-input">
              <option value="LẺ">Lẻ</option>
              <option value="SỈ">Sỉ</option>
            </select>
          </div>
          <div v-if="customers.editForm.customerGroup === 'SỈ'">
            <label class="ma-label">% Chiết khấu mặc định</label>
            <input type="number" min="0" max="100" v-model="customers.editForm.defaultDiscountPercent" placeholder="10" class="ma-input">
          </div>
        </div>
        <p class="text-body-sm text-on-surface-variant opacity-70 mt-1.5">Khách Sỉ sẽ tự động áp % này khi thu ngân chọn khách ở form Tạo đơn thủ công — không cần gõ tay mỗi lần.</p>
      </div>

      <div class="pt-2 border-t border-outline-variant">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Cá nhân & Nguồn khách</p>
        <div class="grid grid-cols-2 gap-stack-md">
          <div>
            <label class="ma-label">Ngày sinh</label>
            <input type="date" v-model="customers.editForm.birthday" class="ma-input">
          </div>
          <div>
            <label class="ma-label">Kênh nguồn</label>
            <select v-model="customers.editForm.acquisitionChannel" class="ma-input">
              <option value="">— Chưa rõ —</option>
              <option value="Facebook">Facebook</option>
              <option value="Zalo">Zalo</option>
              <option value="Cửa hàng">Cửa hàng</option>
              <option value="Sapo">Sapo</option>
              <option value="Khác">Khác</option>
            </select>
          </div>
        </div>
      </div>

      <div class="pt-2 border-t border-outline-variant">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">Địa chỉ giao hàng mặc định</p>
        
        <div class="space-y-2">
          <input type="text" v-model="customers.editForm.addressStreet" placeholder="Số nhà / Đường" class="ma-input">
          <div class="grid grid-cols-2 gap-2">
            <select v-model="customers.editForm.addressCity" @change="onProvinceChange(customers.editForm, 'addressCity', 'addressWard')" class="ma-input">
              <option value="" disabled>Chọn tỉnh/thành phố</option>
              <option v-for="p in addressBook.provinces" :key="p.code" :value="p.name">[[ p.name ]]</option>
            </select>
            <select v-model="customers.editForm.addressWard" :disabled="!customers.editForm.addressCity" class="ma-input">
              <option value="" disabled>Chọn xã/phường</option>
              <option v-for="w in wardsFor(customers.editForm.addressCity)" :key="w.code" :value="w.name">[[ w.name ]]</option>
            </select>
          </div>
        </div>
      </div>

      <div class="pt-2 border-t border-outline-variant">
        <p class="text-label-md text-on-surface-variant uppercase tracking-wider mb-2">
          Loyalty <span class="font-normal opacity-60">(hạng thành viên set tay — chưa có công thức tự tính từ điểm)</span>
        </p>
        <div class="grid grid-cols-2 gap-stack-md">
          <div>
            <label class="ma-label">Điểm tích lũy</label>
            <input type="number" min="0" v-model="customers.editForm.loyaltyPoints" class="ma-input">
          </div>
          <div>
            <label class="ma-label">Hạng thành viên</label>
            <select v-model="customers.editForm.membershipTier" class="ma-input">
              <option value="">— Chưa xếp hạng —</option>
              <option value="Silver">Silver</option>
              <option value="Gold">Gold</option>
              <option value="Diamond">Diamond</option>
            </select>
          </div>
        </div>
      </div>
      </div>
    </div>
    <div class="ma-modal-foot">
      <button @click="saveCustomerEdit" :disabled="customers.editSaving" type="button" class="inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-bold text-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50">[[ customers.editSaving ? 'Đang lưu…' : 'Lưu' ]]</button>
      <button @click="customers.showEditForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  <!-- Modal Thêm địa chỉ giao hàng — dùng chung <mops-address-picker mode="new"> với luồng
       Sapo 3-layer (tab Cũ/Mới + chuyển đổi ngầm). 2026-08-12 migrate từ 3 ô text tự do
       cascade → picker chuẩn có mã GSO + adapter cho carrier. -->
  <div v-if="customers.showAddressForm" @click="customers.showAddressForm = false" class="ma-modal-backdrop"></div>
  <div v-if="customers.showAddressForm" class="ma-modal-panel" style="max-width:560px">
    <div class="ma-row-header">
      <h3 class="ma-heading">
        <span class="material-symbols-outlined text-[18px] align-middle">home_pin</span>
        [[ customers.addressForm.mode === 'edit' ? 'Sửa địa chỉ giao hàng' : 'Thêm địa chỉ giao hàng' ]]
      </h3>
      <button @click="customers.showAddressForm = false" type="button" class="ma-icon-btn" aria-label="Đóng">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="ma-modal-body space-y-stack-md">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
        <div>
          <label class="ma-label">Người nhận</label>
          <input v-model="customers.addressForm.receiverName" class="ma-input">
        </div>
        <div>
          <label class="ma-label">SĐT người nhận</label>
          <input v-model="customers.addressForm.phone" type="tel" class="ma-input">
        </div>
      </div>
      <div>
        <label class="ma-label">Số nhà / Đường</label>
        <input v-model="customers.addressForm.address" placeholder="vd: 217A Phạm Viết Chánh" class="ma-input">
      </div>
      <div>
        <label class="ma-label">Tỉnh/Xã (theo địa danh hành chính mới)</label>
        <mops-address-picker
          v-model="customers.addressForm.addr"
          mode="new"
          :raw-street="customers.addressForm.address"
          @update:rawStreet="customers.addressForm.address = $event"
          :dense="true"></mops-address-picker>
      </div>
    </div>
    <div class="ma-modal-foot">
      <button @click="saveCustomerAddress" :disabled="customers.addressSaving" type="button" class="ma-btn-primary">
        [[ customers.addressSaving
             ? 'Đang lưu…'
             : (customers.addressForm.mode === 'edit' ? 'Lưu thay đổi' : 'Lưu & đặt mặc định') ]]
      </button>
      <button @click="customers.showAddressForm = false" type="button" class="ma-btn-outline">Huỷ</button>
    </div>
  </div>

  
  <mops-qr-lightbox :url="qrLightboxUrl" @close="closeQrLightbox"></mops-qr-lightbox>

</template>


<div id="ma-toast" class="fixed bottom-6 right-6 z-[100] hidden px-4 py-3 rounded-lg shadow-lg text-body-sm font-medium max-w-xs"></div>



{%- comment -%}
  2026-08-24: DOM template hoá đơn mo-invoice cũ đã BỎ HẲN. Trước đây printOrderInvoice(data) legacy
  cập nhật các id mo-inv-* rồi window.print() (in trang admin đè lên UI, chỉ khu này hiện qua @media print).
  Nay 3 caller (printOrderDetail / printManualOrderResult / printOrderDetailFromResult) đều thống nhất
  dùng printSingleOrder(orderId) → fetch qua get_orders_batch → _buildOrderPrintHtml (12-block Sapo-style,
  mở window mới). Đồng nhất với luồng bulk print. Không còn cần DOM inline + CSS .mo-inv-*.
{%- endcomment -%}


<div id="ma-confirm-overlay" class="fixed inset-0 bg-black/40 z-[110]" style="display:none"></div>
<div id="ma-confirm-dialog" class="ma-modal-panel ma-modal-panel--confirm" style="display:none">
  <div class="flex items-center gap-3 mb-3">
    <span class="material-symbols-outlined text-error text-[24px]">warning</span>
    <h3 id="ma-confirm-title" class="ma-heading">Xác nhận</h3>
  </div>
  <p id="ma-confirm-message" class="text-body-sm text-on-surface-variant mb-6"></p>
  <div class="flex justify-end gap-3">
    <button id="ma-confirm-cancel" type="button" class="px-4 py-2 rounded-lg text-label-md font-bold text-on-surface-variant hover:bg-surface-container-high transition-colors">Hủy</button>
    <button id="ma-confirm-ok" type="button" class="px-4 py-2 rounded-lg bg-error text-on-error text-label-md font-bold hover:opacity-90 transition-all">Xác nhận</button>
  </div>
</div>

<style>
  /* Role / status chips + audit category pills — cần CSS tĩnh vì màu ghép động qua JS ở bảng khác đã đủ dùng utility trực tiếp */
  .ma-role-chip { display:inline-flex; align-items:center; padding:1px 8px; border-radius:9999px; font-size:11px; font-weight:700; }
  .ma-role-chip--blue   { background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; }
  .ma-role-chip--amber  { background:#fffbeb; color:#b45309; border:1px solid #fde68a; }
  .ma-role-chip--gray   { background:#f3f4f6; color:#4b5563; border:1px solid #e5e7eb; }
  .ma-role-chip--violet { background:#f5f3ff; color:#6d28d9; border:1px solid #ddd6fe; }

  .ma-audit-cat { background:#ffffff; color:#3c4a42; border-color:#bbcabf; }
  .ma-audit-cat.is-active { background:#006c49; color:#ffffff; border-color:#006c49; }

  /* Click-to-enlarge QR VietQR (review 2026-07-16) — ảnh thumbnail nhỏ trong Chi tiết đơn/modal
     Tạo đơn thủ công, phóng to qua lightbox #qrLightboxUrl khi click (xem mops-admin.js). */
  .ma-qr-thumb { cursor: pointer; transition: transform .15s ease, filter .15s ease; }
  .ma-qr-thumb:hover { transform: scale(1.04); filter: brightness(1.05); }
  .ma-qr-thumb:active { transform: scale(0.98); }

  .ma-qr-lightbox-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.7);
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
    animation: ma-qr-fade-in .15s ease;
  }
  .ma-qr-lightbox-img {
    width: min(500px, 100%);
    max-width: 500px;
    aspect-ratio: 1 / 1;
    background: #fff;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,.4);
    cursor: default;
  }
  .ma-qr-lightbox-close {
    position: absolute;
    top: 20px; right: 20px;
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.15);
    border: none; border-radius: 9999px;
    color: #fff; cursor: pointer;
    transition: background .15s ease;
  }
  .ma-qr-lightbox-close:hover { background: rgba(255,255,255,.28); }
  @media (max-width: 480px) {
    .ma-qr-lightbox-img { width: min(90vw, 450px); padding: 12px; }
    .ma-qr-lightbox-close { top: 12px; right: 12px; }
  }
  @keyframes ma-qr-fade-in { from { opacity: 0; } to { opacity: 1; } }

  /* 2026-08-24 CSS .mo-inv-* + @media print cho #mo-invoice ĐÃ BỎ HẲN.
     Trước đây kỹ thuật in trực tiếp trang admin qua window.print() ẩn tất cả trừ #mo-invoice.
     Nay in đơn dùng printSingleOrder(id) → mở window mới với HTML từ _buildOrderPrintHtml
     (12-block Sapo-style, đã có @page + styles riêng bên trong). Đồng nhất với bulk print,
     không còn conflict giữa "print trang admin đè UI" và "print window mới". */
</style>

