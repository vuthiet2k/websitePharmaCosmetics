{%- layout none -%}
{
{%- if search.results.size -%}
{%- for result in search.results limit: 4 -%}
{%- if result.object_type == 'product' -%}
{% assign thumbURL = result.featured_image.src | img_url:'compact' %}
{% if result.variants[0].price > 0 %}
{% assign priceURL = result.variants[0].price | money %}
{% else %}
{% assign priceURL = 'Liên hệ' %}
{% endif %}
"{{result.id}}": {
"name": "{{ result.name | escape}}",
"url": "{{ result.url }}",
"image": "{{ thumbURL }}",
"price": "{{ priceURL}}",
"compare_price": "{% if result.variants[0].compare_at_price != 0 %}{{ result.variants[0].compare_at_price | money }}{%else%}0{%endif%}"
}{% unless forloop.last %},{% endunless %}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
}