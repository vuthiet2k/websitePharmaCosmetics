{% include 'breadcrumb' %}
<section class="signup search-main wrap_background background_white clearfix bg-gray-50 py-8">
	<div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<ul class="search-type flex flex-wrap items-center gap-2 mb-6 text-xs font-medium">
			<li>
				<a {% if search.types contains 'product' %}class="active bg-clinical-700 text-white"{%else%}class="bg-white text-gray-600 border border-gray-200 hover:border-clinical-500"{%endif%} href="/search?query=name:(*{{search.terms | split: '(*' | last | split: '*)'}}*)&type=product" title="Tìm theo sản phẩm" style="padding:8px 16px;border-radius:9999px;display:inline-block;">Sản phẩm</a>
			</li>
			<li>
				<a {% if search.types contains 'article' %}class="active bg-clinical-700 text-white"{%else%}class="bg-white text-gray-600 border border-gray-200 hover:border-clinical-500"{%endif%} href="search?query=(*{{search.terms | split: '(*' | last | split: '*)'}}*)&type=article" title="Tìm theo tin tức" style="padding:8px 16px;border-radius:9999px;display:inline-block;">Tin tức</a>
			</li>
		</ul>
		{% if search.performed and search.terms != blank %}
		{% paginate search.results by 16 %}
		{% if search.results_count == 0 %}
		{% if search.types contains 'product' %}
		<div class="bg-white p-8 sm:p-12 rounded-2xl shadow-sm border border-gray-200 text-center max-w-xl mx-auto">
			<p class="text-red-600 text-sm font-semibold mb-2">Không tìm thấy bất kỳ kết quả nào với từ khóa trên.</p>
			<h1 class="text-lg font-bold text-forest-900 font-heading mb-4">Nhập từ khóa để tìm kiếm</h1>
			<div class="serachpc_searchpage">
				<div class="searchform">
					<form action="/search" method="get" class="input-group search-bar relative" role="search">
						<input type="text" name="query" value="{{ search.terms }}" autocomplete="off" placeholder="Tìm kiếm..." class="input-group-field auto-search w-full pl-12 pr-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-clinical-600 text-sm {%if template contains 'index'%}visible_index{%endif%}">
						<button type="submit" class="btn icon-fallback-text absolute left-1 top-1 bottom-1 px-3 text-gray-400" aria-label="Tìm kiếm">
							<svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="search" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-search fa-w-16" width="16" height="16"><path fill="currentColor" d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z" class=""></path></svg>
						</button>
					</form>
				</div>
			</div>
		</div>
		{%else%}
		<div class="bg-white p-8 sm:p-12 rounded-2xl shadow-sm border border-gray-200 text-center max-w-xl mx-auto">
			<p class="text-red-600 text-sm font-semibold mb-2">Không tìm thấy bất kỳ kết quả nào với từ khóa trên.</p>
			<h1 class="title-head title_search text-lg font-bold text-forest-900 font-heading mb-4"><a href="#" class="title-box">Nhập từ khóa để tìm kiếm</a></h1>
			<div class="serachpc_searchpage">
				<div class="searchform">
					<form action="/search" method="get" class="input-group search-bar relative" role="search">
						<input type="text" name="query" value="{{ search.terms }}" autocomplete="off" placeholder="Nhập tên tin tức..." class="input-group-field auto-search w-full pl-12 pr-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-clinical-600 text-sm">
						<input type="hidden" name="type" value="article">
						<button type="submit" class="btn icon-fallback-text absolute left-1 top-1 bottom-1 px-3 text-gray-400" aria-label="Tìm kiếm">
							<svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="search" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-search fa-w-16" width="16" height="16"><path fill="currentColor" d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z" class=""></path></svg>
						</button>
					</form>
				</div>
			</div>
		</div>
		{%endif%}
		{% else %}
		<div class="category-products">
			<div class="d-none">
				{% if search.types contains 'product' %}
				{%unless search.terms contains 'name:' %}
				<span class="search_content">{{search.terms}}</span>
				<span class="search_count">{{search.results_count}}</span>
				{%endunless%}
				{%endif%}
			</div>
			<div class="products-view-grid">
				<div class="row {% if search.types contains 'product' %}row-fix{%endif%}">
					{% if search.types contains 'article' %}
					<div class="right-content col-12 d-none">
						<h1 class="title-page">
							<span>Có {{ search.results_count }} kết quả tìm kiếm phù hợp</span>
						</h1>
					</div>
					<div class="right-content col-lg-9 col-12">
						<div class="row row-fix">
							{% for article in search.results %}
							{% if article.object_type == 'article' %}
							<div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
								{%include 'blog_item_all'%}
							</div>
							{% endif %}
							{% endfor %}
							<div class="col-md-12 col-sm-12 col-xs-12">
								{% if paginate.pages > 1 %}<div class="text-xs-right text-center pagging-css">{% include 'paginate-pages' %}</div>{% endif %}
							</div>
						</div>
					</div>
					<div class="blog_left_base col-lg-3 col-12">
						{%include 'aside-blog'%}
					</div>
					{%else%}
					{%- comment -%}
					  T-22: bỏ bộ lọc tĩnh giả (checkbox disabled cứng) — dùng lại
					  ĐÚNG component filter thật snippets/aside-filter.bwt (đã chạy trên
					  collection.bwt qua Bizweb.SearchFilter/col.js, vừa mở khoá thêm cho
					  template 'search' trong footer_script.bwt). Layout theo
					  Pharma_Cosmetics_Figma_Project/search-filter.html.
					{%- endcomment -%}
					<div class="grid grid-cols-1 lg:grid-cols-4 gap-8" style="display:grid;">
						<div class="lg:col-span-1">
							<div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
								<h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-4 pb-2 border-b border-gray-100">Bộ Lọc Tìm Kiếm Chuyên Sâu</h3>
								{% include 'aside-filter' %}
							</div>
						</div>
						<div class="lg:col-span-3 space-y-6">
							<div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-4 rounded-xl border border-gray-200 mb-6">
								<div class="flex items-center gap-2">
									<span class="text-sm font-bold text-gray-900">Kết quả tìm kiếm cho &quot;{{ search.terms }}&quot;:</span>
									<span class="pc-kit-badge-clinical text-xs">{{ search.results_count }} sản phẩm</span>
								</div>
								{% include 'collection-sortby' %}
							</div>
							<div class="row row-fix grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" style="display:grid;">
							{% for product in search.results %}
							<div class="item_product_main">
								{%include 'product_grid_office'%}
							</div>
							{% endfor %}
							</div>
						</div>
					</div>
					{%endif%}
				</div>
			</div>
		</div>
		{% if paginate.pages > 1 %}
		<div class="section pagenav clearfix a-center mt-8">
			{% include 'paginate-pages' %}
		</div>
		{% endif %}
		{% endif %}
		{% endpaginate %}
		{% else %}
		<div class="bg-white p-8 sm:p-12 rounded-2xl shadow-sm border border-gray-200 text-center max-w-xl mx-auto">
			<h2 class="title-head title_search text-lg font-bold text-forest-900 font-heading mb-4"><a href="#" class="title-box">Nhập từ khóa để tìm kiếm</a></h2>
			<div class="serachpc_searchpage">
				<div class="searchform">
					<form action="/search" method="get" class="input-group search-bar relative" role="search">
						<input type="text" name="query" value="{{ search.terms }}" autocomplete="off" placeholder="Tìm kiếm..." class="input-group-field auto-search w-full pl-12 pr-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-clinical-600 text-sm {%if template contains 'index'%}visible_index{%endif%}">
						<button type="submit" class="btn icon-fallback-text absolute left-1 top-1 bottom-1 px-3 text-gray-400" aria-label="Tìm kiếm">
							<svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="search" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-search fa-w-16" width="16" height="16"><path fill="currentColor" d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z" class=""></path></svg>
						</button>
					</form>
				</div>
			</div>
		</div>
		{% endif %}
	</div>
</section>
{%if settings.header_search_recent%}
<script>
	$(document).ready(function () {
		var $searchContent = $('.search_content');
		var $searchCount = $('.search_count');
		var searchCountValue = parseInt($searchCount.text());
		var searchContentText = $searchContent.text().trim();

		if (searchCountValue > 0 && searchContentText.length > 1) {

			var searchRecentList = localStorage.getItem('search_recent_list');
			var recentList = searchRecentList ? JSON.parse(searchRecentList) : [];

			if (!recentList.includes(searchContentText)) {
				recentList.push(searchContentText);

				if (recentList.length > 10) {
					recentList.shift();
				}

				localStorage.setItem('search_recent_list', JSON.stringify(recentList));
			}
		}
	});
</script>
{%endif%}
