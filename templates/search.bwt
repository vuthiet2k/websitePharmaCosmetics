{%- comment -%} M-10 (17/11/2026): breadcrumb trang tìm kiếm chỉ hiện từ desktop, mobile không có tác dụng. {%- endcomment -%}
<div class="hidden lg:block">{% include 'breadcrumb' %}</div>
{%- comment -%}
  2026-11-16 (Refactor trang tìm kiếm mobile & desktop theo yêu cầu):
  - Tiêu đề kết quả rõ ràng, thanh thoát.
  - Bộ lọc sản phẩm: Desktop hiển thị cột trái; Mobile ẩn và chuyển thành Offcanvas drawer (trượt từ trái sang)
    kích hoạt bằng nút "Bộ lọc" trên thanh công cụ (.btn-filter-mobile) kèm badge số lượng tiêu chí đang lọc (.count-filter-val).
  - Lưới sản phẩm: 2 cột trên mobile (grid-cols-2 gap-3), 3 cột trên tablet/desktop (md:grid-cols-3 lg:gap-4),
    sử dụng 100% khung thẻ ui_product_card dùng chung.
  - Có phân trang phân trang trang (collection-paginate-pages.bwt / doSearch).
  - Khối tin tức liên quan: chuyển xuống phía dưới danh sách sản phẩm thành 1 khối riêng biệt (không chia tab),
    tự động tải bài viết liên quan qua search API / smartjsonar.
{%- endcomment -%}
{%- assign pc_search_keyword = search.terms | split: '(*' | last | split: '*)' | first -%}
<section class="signup search-main wrap_background background_white clearfix pb-8">
	<div class="container">
		<div class="pb-4 pt-4 lg:pt-6">
			{%- if search.performed and search.terms != blank and search.results_count > 0 -%}
			<h1 class="m-0 text-xl font-bold normal-case text-brand-deep">Kết quả tìm kiếm cho &ldquo;{{ pc_search_keyword | escape }}&rdquo;</h1>
			{%- endif -%}
		</div>

		{% if search.performed and search.terms != blank %}
		{% paginate search.results by settings.collection_number_product | default: 16 %}
		{% if search.results_count == 0 %}
			{% assign empty_type = 'product' %}
			{% include 'search_empty_state' %}
		{% else %}
		<div class="category-products layout-collection">
			<div class="d-none">
				{%unless search.terms contains 'name:' %}
				<span class="search_content">{{search.terms}}</span>
				<span class="search_count">{{search.results_count}}</span>
				{%endunless%}
			</div>

			{%- comment -%} Offcanvas filter drawer (trượt từ trái vào trên Mobile, cố định cột trái trên Desktop) {%- endcomment -%}
			<div class="grid grid-cols-1 gap-6 min-[992px]:grid-cols-4 min-[992px]:items-start">
				{%- include 'sidebar-collection' -%}

				<div class="min-w-0 min-[992px]:col-span-3">
					{%- comment -%} "Đang lọc N tiêu chí" chip bar {%- endcomment -%}
					<div id="afw-active-bar" class="afw-bar mb-4 max-[991px]:!hidden" hidden>
						<div class="afw-bar__head flex items-center justify-between">
							<span class="afw-bar__count text-sm text-ink">Đang lọc <strong class="afw-bar__count-num text-primary">0</strong> tiêu chí</span>
							<button type="button" class="afw-bar__clear text-sm text-sale cursor-pointer border-0 bg-transparent flex items-center gap-1" data-filter-reset>{% include 'ui_icon', name: 'x', size: 16, label: '' %} Bỏ chọn hết</button>
						</div>
						<div class="afw-bar__chips flex flex-wrap gap-2 mt-2" id="afw-active-chips"></div>
					</div>

					<div id="ajax-result">
						{%- comment -%} Hàng công cụ toolbar: Sắp xếp + Nút mở bộ lọc mobile {%- endcomment -%}
						{%- comment -%} M-12 (17/11/2026): mobile bỏ khung + chữ "Sản phẩm (N)" (còn sr-only), chỉ nút lọc + ô sắp xếp; 1 lớp mb-4 (nằm trong collection-sortby). {%- endcomment -%}
						{% include 'collection-sortby', compact: true %}

						{%- comment -%} Lưới sản phẩm: 2 cột trên mobile, 3 cột tablet/desktop {%- endcomment -%}
						<ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 lg:gap-4 xl:grid-cols-3 [html[data-pc-view=list]_&]:grid-cols-1">
							{% for product in search.results %}
							<li class="min-w-0">
								{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}
							</li>
							{% endfor %}
						</ul>

						{% if paginate.pages > 1 %}
						<div class="section pagenav clearfix a-center mt-8">
							{% include 'collection-paginate-pages' %}
						</div>
						{% endif %}
					</div>
				</div>
			</div>

			{%- comment -%}
			  Khối tin tức liên quan: hiển thị ở phía dưới kết quả sản phẩm thành 1 khối riêng biệt
			{%- endcomment -%}
			{%- comment -%} M-13 (17/11/2026): không viền, card nhỏ trượt ngang bằng Swiper (mobile), lưới 4 cột từ lg. Bài do JS nạp từ search API (chỉ có name/url/image,
			  không có object article) ⇒ dựng từ <template> bên dưới; ảnh giả placehold.co / không ảnh thì bỏ khung ảnh. {%- endcomment -%}
			<div class="mt-8" id="pc-search-articles-wrap" hidden>
				<h2 class="m-0 mb-3 text-base font-bold text-brand-deep lg:text-lg">Bài viết &amp; Tin tức liên quan</h2>
				<div class="swiper-container overflow-hidden" data-pc-slider data-gap="12" data-desktop-off>
					<div class="swiper-wrapper lg:grid lg:grid-cols-4 lg:gap-4" id="pc-search-articles-list"></div>
				</div>
				<template id="pc-search-article-tpl">
					<a class="swiper-slide group flex !w-56 flex-col text-ink no-underline lg:!w-auto" data-art-link href="#">
						<span class="relative block aspect-video overflow-hidden rounded-xl bg-brand-tint" data-art-media><img class="block h-full w-full object-cover" data-art-img src="" alt="" width="320" height="180" loading="lazy"></span>
						<span class="m-0 mt-2 line-clamp-2 text-sm font-semibold leading-snug group-hover:text-primary" data-art-title></span>
						<span class="mt-1 inline-flex items-center gap-1 text-xs font-bold text-brand-deep">Đọc tiếp {% include 'ui_icon', name: 'arrow-right', size: 'em' %}</span>
					</a>
				</template>
			</div>
{%- include 'pc_swiper_boot' -%}

		</div>
		{% endif %}
		{% endpaginate %}
		{% else %}
		{%- comment -%} M-33 (18/11/2026): chưa nhập từ khoá — viết lại bằng token (bỏ class màu/bóng ngoài config: gray-*, forest-*, clinical-*, shadow, font-heading; bỏ input-group/icon-fallback-text). Gợi ý như M-31. {%- endcomment -%}
		<h1 class="m-0 pb-3 text-xl font-bold normal-case text-brand-deep">Nhập từ khóa để tìm kiếm</h1>
		<form action="/search" method="get" class="relative mb-4" role="search">
			<input type="search" name="query" value="{{ search.terms | escape }}" autocomplete="off" placeholder="Tìm sản phẩm, thương hiệu..." aria-label="Tìm kiếm" class="appearance-none min-h-[44px] w-full rounded-xl border border-solid border-line bg-surface-card text-base text-ink outline-none focus:border-primary">
			<button type="submit" class="absolute right-1 top-1 inline-flex h-9 cursor-pointer items-center gap-1 rounded-xl border-0 bg-btn px-3 text-sm font-bold text-btn-text transition-colors hover:bg-btn-hover" aria-label="Tìm kiếm">{% include 'ui_icon', name: 'search', size: 20 %}Tìm</button>
		</form>
		{%- assign empty_type = 'none' -%}{%- include 'search_empty_state' -%}
		{% endif %}
	</div>
</section>

<script>
var selectedViewData = "data";

document.addEventListener('DOMContentLoaded', function () {
	/* Tải danh sách bài viết liên quan phía dưới sản phẩm nếu có từ khóa */
	var kw = "{{ pc_search_keyword | escape }}";
	if (kw && kw.trim().length > 1 && typeof getItemSearch2 === 'function') {
		getItemSearch2(kw, 'smartjsonar').then(function (res) {
			if (!res) return;
			var keys = Object.keys(res).filter(function (k) { return k !== 'searchResultCount'; });
			if (keys.length === 0) return;

			var wrap = document.getElementById('pc-search-articles-wrap');
			var list = document.getElementById('pc-search-articles-list');
			if (!wrap || !list) return;

			var tpl = document.getElementById('pc-search-article-tpl');
			keys.forEach(function (k) {
				var item = res[k];
				if (!item || !tpl) return;
				var card = tpl.content.firstElementChild.cloneNode(true);
				card.setAttribute('href', item.url);
				card.querySelector('[data-art-title]').textContent = item.name || '';
				var img = card.querySelector('[data-art-img]');
				if (item.image && item.image.indexOf('placehold.co') < 0) { img.setAttribute('src', item.image); img.setAttribute('alt', item.name || ''); }
				else card.querySelector('[data-art-media]').remove();
				list.appendChild(card);
			});
			if (!list.children.length) return;
			wrap.hidden = false;
			if (typeof window.pcSliderSync === 'function') window.pcSliderSync();
		});
	}

	/* Lưu lịch sử tìm kiếm */
	{% if settings.header_search_recent %}
	var $searchContent = $('.search_content');
	var $searchCount = $('.search_count');
	var searchCountValue = parseInt($searchCount.text());
	var searchContentText = $searchContent.text().trim();

	if (searchCountValue > 0 && searchContentText.length > 1) {
		var searchRecentList = localStorage.getItem('search_recent_list');
		var recentList = searchRecentList ? JSON.parse(searchRecentList) : [];
		if (!recentList.includes(searchContentText)) {
			recentList.push(searchContentText);
			if (recentList.length > 10) {
				recentList.shift();
			}
			localStorage.setItem('search_recent_list', JSON.stringify(recentList));
		}
	}
	{% endif %}
});
</script>
