{% include 'breadcrumb' %}
{%- comment -%}
  2026-11-16 (Refactor trang tìm kiếm mobile & desktop theo yêu cầu):
  - Tiêu đề kết quả rõ ràng, thanh thoát.
  - Bộ lọc sản phẩm: Desktop hiển thị cột trái; Mobile ẩn và chuyển thành Offcanvas drawer (trượt từ trái sang)
    kích hoạt bằng nút "Bộ lọc" trên thanh công cụ (.btn-filter-mobile) kèm badge số lượng tiêu chí đang lọc (.count-filter-val).
  - Lưới sản phẩm: 2 cột trên mobile (grid-cols-2 gap-3), 3 cột trên tablet/desktop (md:grid-cols-3 lg:gap-4),
    sử dụng 100% khung thẻ ui_product_card dùng chung.
  - Có phân trang phân trang trang (collection-paginate-pages.bwt / doSearch).
  - Khối tin tức liên quan: chuyển xuống phía dưới danh sách sản phẩm thành 1 khối riêng biệt (không chia tab),
    tự động tải bài viết liên quan qua search API / smartjsonar.
{%- endcomment -%}
{%- assign pc_search_keyword = search.terms | split: '(*' | last | split: '*)' | first -%}
<section class="signup search-main wrap_background background_white clearfix pb-8">
	<div class="container">
		<div class="pc-search-head mb-6">
			{%- if search.performed and search.terms != blank and search.results_count > 0 -%}
			<h1 class="pc-search-title">Kết quả tìm kiếm cho &ldquo;{{ pc_search_keyword | escape }}&rdquo;</h1>
			{%- endif -%}
		</div>

		{% if search.performed and search.terms != blank %}
		{% paginate search.results by settings.collection_number_product | default: 16 %}
		{% if search.results_count == 0 %}
			{% assign empty_type = 'product' %}
			{% include 'search_empty_state' %}
		{% else %}
		<div class="category-products layout-collection">
			<div class="d-none">
				{%unless search.terms contains 'name:' %}
				<span class="search_content">{{search.terms}}</span>
				<span class="search_count">{{search.results_count}}</span>
				{%endunless%}
			</div>

			{%- comment -%} Offcanvas filter drawer (trượt từ trái vào trên Mobile, cố định cột trái trên Desktop) {%- endcomment -%}
			<div class="grid grid-cols-1 gap-6 min-[992px]:grid-cols-[280px_minmax(0,1fr)] min-[992px]:items-start">
				<aside class="left-content min-w-0 font-sans max-[991px]:fixed max-[991px]:inset-y-0 max-[991px]:left-0 max-[991px]:z-[99999] max-[991px]:w-[86%] max-[991px]:max-w-[360px] max-[991px]:-translate-x-full max-[991px]:overflow-y-auto max-[991px]:bg-white max-[991px]:p-4 max-[991px]:transition-transform max-[991px]:[&.active]:translate-x-0" aria-label="{{ settings.collection_filter_heading | default: 'Bộ lọc tìm kiếm' | escape }}">
					<button type="button" class="close-filters ml-auto flex h-[44px] w-[44px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-ink min-[992px]:hidden" aria-label="Đóng bộ lọc">{% include 'ui_icon', name: 'x', size: 24, label: '' %}</button>
					<div class="pc-search-filterbox section-box-bg min-[992px]:border min-[992px]:border-solid min-[992px]:border-line min-[992px]:bg-white min-[992px]:p-4 min-[992px]:rounded-2xl">
						{%- include 'sidebar-collection' -%}
					</div>
				</aside>

				<div class="min-w-0">
					{%- comment -%} "Đang lọc N tiêu chí" chip bar {%- endcomment -%}
					<div id="afw-active-bar" class="afw-bar mb-4" hidden>
						<div class="afw-bar__head flex items-center justify-between">
							<span class="afw-bar__count text-sm text-ink">Đang lọc <strong class="afw-bar__count-num text-primary">0</strong> tiêu chí</span>
							<button type="button" class="afw-bar__clear text-sm text-sale cursor-pointer border-0 bg-transparent flex items-center gap-1" onclick="clearAllFiltered()">{% include 'ui_icon', name: 'x', size: 16, label: '' %} Bỏ chọn hết</button>
						</div>
						<div class="afw-bar__chips flex flex-wrap gap-2 mt-2" id="afw-active-chips"></div>
					</div>

					<div id="ajax-result">
						{%- comment -%} Hàng công cụ toolbar: Sắp xếp + Nút mở bộ lọc mobile {%- endcomment -%}
						<div class="pc-search-toolbar mb-4">
							{% include 'collection-sortby' %}
						</div>

						{%- comment -%} Lưới sản phẩm: 2 cột trên mobile, 3 cột tablet/desktop {%- endcomment -%}
						<ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 lg:gap-4 xl:grid-cols-3 [html[data-pc-view=list]_&]:grid-cols-1">
							{% for product in search.results %}
							<li class="min-w-0">
								{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}
							</li>
							{% endfor %}
						</ul>

						{% if paginate.pages > 1 %}
						<div class="section pagenav clearfix a-center mt-8">
							{% include 'collection-paginate-pages' %}
						</div>
						{% endif %}
					</div>
				</div>
			</div>

			{%- comment -%}
			  Khối tin tức liên quan: hiển thị ở phía dưới kết quả sản phẩm thành 1 khối riêng biệt
			{%- endcomment -%}
			<div class="pc-search-articles mt-12 pt-8 border-t border-solid border-line" id="pc-search-articles-wrap" style="display:none;">
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-base font-bold text-ink uppercase tracking-wider m-0">Bài viết &amp; Tin tức liên quan</h2>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="pc-search-articles-list"></div>
			</div>

		</div>
		{% endif %}
		{% endpaginate %}
		{% else %}
		<h1 class="visually-hidden">Tìm kiếm</h1>
		<div class="bg-white p-8 sm:p-12 rounded-2xl shadow-sm border border-gray-200 text-center max-w-xl mx-auto">
			<h2 class="title-head title_search text-lg font-bold text-forest-900 font-heading mb-4"><a href="#" class="title-box">Nhập từ khóa để tìm kiếm</a></h2>
			<div class="serachpc_searchpage">
				<div class="searchform">
					<form action="/search" method="get" class="input-group search-bar relative" role="search">
						<input type="text" name="query" value="{{ search.terms }}" autocomplete="off" placeholder="Tìm kiếm..." class="input-group-field auto-search w-full pl-12 pr-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-clinical-600 text-sm {%if template contains 'index'%}visible_index{%endif%}">
						<button type="submit" class="btn icon-fallback-text absolute left-1 top-1 bottom-1 px-3 text-gray-400" aria-label="Tìm kiếm">
							<i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'search', size: 'em' %}</i>
						</button>
					</form>
				</div>
			</div>
		</div>
		{% endif %}
	</div>
</section>

<script>
var selectedViewData = "data";

document.addEventListener('DOMContentLoaded', function () {
	/* Tải danh sách bài viết liên quan phía dưới sản phẩm nếu có từ khóa */
	var kw = "{{ pc_search_keyword | escape }}";
	if (kw && kw.trim().length > 1 && typeof getItemSearch2 === 'function') {
		getItemSearch2(kw, 'smartjsonar').then(function (res) {
			if (!res) return;
			var keys = Object.keys(res).filter(function (k) { return k !== 'searchResultCount'; });
			if (keys.length === 0) return;

			var wrap = document.getElementById('pc-search-articles-wrap');
			var list = document.getElementById('pc-search-articles-list');
			if (!wrap || !list) return;

			var html = '';
			keys.forEach(function (k) {
				var item = res[k];
				if (!item) return;
				var imgHtml = item.image ? '<img src="' + item.image + '" alt="' + (item.name || '') + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">' : '<div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-400 text-xs">Pharma Cosmetics</div>';
				html += [
					'<a href="' + item.url + '" class="group flex flex-col overflow-hidden rounded-xl border border-solid border-line bg-white text-ink no-underline hover:border-primary transition-colors">',
					'  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">' + imgHtml + '</div>',
					'  <div class="p-3 flex flex-col flex-1">',
					'    <h3 class="text-sm font-semibold line-clamp-2 text-ink group-hover:text-primary transition-colors m-0 leading-snug">' + item.name + '</h3>',
					'    <span class="mt-auto pt-2 text-xs text-primary font-medium flex items-center gap-1">Đọc tiếp &rarr;</span>',
					'  </div>',
					'</a>'
				].join('');
			});

			list.innerHTML = html;
			wrap.style.display = '';
		});
	}

	/* Lưu lịch sử tìm kiếm */
	{% if settings.header_search_recent %}
	var $searchContent = $('.search_content');
	var $searchCount = $('.search_count');
	var searchCountValue = parseInt($searchCount.text());
	var searchContentText = $searchContent.text().trim();

	if (searchCountValue > 0 && searchContentText.length > 1) {
		var searchRecentList = localStorage.getItem('search_recent_list');
		var recentList = searchRecentList ? JSON.parse(searchRecentList) : [];
		if (!recentList.includes(searchContentText)) {
			recentList.push(searchContentText);
			if (recentList.length > 10) {
				recentList.shift();
			}
			localStorage.setItem('search_recent_list', JSON.stringify(recentList));
		}
	}
	{% endif %}
});
</script>
