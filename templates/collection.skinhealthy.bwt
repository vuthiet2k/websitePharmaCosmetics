{% comment %} collection.skinhealthy.bwt — Trang danh mục dịch vụ Skin Healthy Beauty.
  22/11/2026 (PO: Skin Health dùng chuẩn chung): viết lại 100% Tailwind theo token; thẻ = ui_product_card, phân trang = ui_pagination,
  chip nhóm dịch vụ = Swiper chung [data-pc-slider]. Bỏ class sh-*, <style>, style="" và sidebar riêng (nhóm dịch vụ gộp vào hàng chip). {% endcomment %}
{% layout 'theme' %}

{% paginate collection.products by 12 %}

{%- assign shbc_chip = 'inline-flex min-h-[44px] items-center justify-center whitespace-nowrap rounded-full border border-solid border-line bg-white px-4 text-sm font-semibold !text-ink no-underline transition-colors hover:border-primary' -%}
{%- assign shbc_chip_on = 'inline-flex min-h-[44px] items-center justify-center whitespace-nowrap rounded-full border border-solid border-primary bg-primary px-4 text-sm font-semibold !text-white no-underline' -%}

<div class="layout-collection">
  {% include 'breadcrumb' %}
  <div class="container pb-10 lg:pb-14">

    {%- comment -%} Đầu trang: nền kem, h1 = tên danh mục (duy nhất của trang) {%- endcomment -%}
    <header class="mb-6 rounded-2xl bg-surface-soft p-5 lg:p-8">
      <p class="m-0 text-xs font-bold tracking-wider text-primary">{{ settings.skinhealthy_brand_name | default: 'Skin Health Beauty' }}</p>
      <h1 class="m-0 mt-1 text-2xl font-bold text-brand-deep lg:text-3xl">
        {%- if collection.name == 'All' or collection.name == blank -%}Tất Cả Dịch Vụ{%- else -%}{{ collection.name }}{%- endif -%}
      </h1>
      {%- if collection.description != blank -%}
        <p class="m-0 mt-2 max-w-3xl text-sm leading-relaxed text-ink-secondary">{{ collection.description | strip_html | truncate: 280 }}</p>
      {%- endif -%}
    </header>

    {%- comment -%} Chip lọc theo nhóm dịch vụ — danh sách ngang mobile dùng Swiper chung {%- endcomment -%}
    <nav class="mb-6" aria-label="Lọc theo nhóm dịch vụ">
      <div class="swiper-container overflow-hidden" data-pc-slider data-gap="8">
        <div class="swiper-wrapper">
          <div class="swiper-slide !w-auto">
            <a href="{{ collection.url }}" class="{% if current_tags == blank and collection.alias != settings.skinhealthy_col_maintenance and collection.alias != settings.skinhealthy_col_targeted and collection.alias != settings.skinhealthy_col_invasive %}{{ shbc_chip_on }}{% else %}{{ shbc_chip }}{% endif %}">Tất cả</a>
          </div>
          {%- assign tab_ll = linklists[settings.skinhealthy_nav_menu] -%}
          {%- if settings.skinhealthy_nav_menu != blank and tab_ll and tab_ll.links.size > 0 -%}
            {%- for link in tab_ll.links -%}
              <div class="swiper-slide !w-auto"><a href="{{ link.url }}" class="{{ shbc_chip }}">{{ link.title }}</a></div>
            {%- endfor -%}
          {%- else -%}
            {%- assign g1 = settings.skinhealthy_col_maintenance | default: 'maintenance-skin-care' -%}
            {%- assign g2 = settings.skinhealthy_col_targeted | default: 'targeted-treatments' -%}
            {%- assign g3 = settings.skinhealthy_col_invasive | default: 'invasive-treatments' -%}
            {%- assign group_col_handles = g1 | append: '|' | append: g2 | append: '|' | append: g3 | split: '|' -%}
            {%- assign group_col_labels = 'Chăm Sóc Duy Trì|Nhắm Mục Tiêu|Xâm Lấn Tối Thiểu' | split: '|' -%}
            {%- for handle in group_col_handles -%}
              {%- assign gc = collections[handle] -%}
              <div class="swiper-slide !w-auto">
                {%- if gc -%}
                  <a href="{{ gc.url }}" class="{% if collection.alias == handle %}{{ shbc_chip_on }}{% else %}{{ shbc_chip }}{% endif %}">{{ gc.name }}</a>
                {%- else -%}
                  <a href="/{{ handle }}" class="{{ shbc_chip }}">{{ group_col_labels[forloop.index0] }}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </nav>

    <p class="m-0 mb-4 text-sm text-ink-secondary">
      {{ collection.products_count }} dịch vụ
      {%- if paginate.pages > 1 %} — Trang {{ paginate.current_page }}/{{ paginate.pages }}{%- endif -%}
    </p>

    {%- if collection.products_count > 0 -%}
      <div class="mb-8 grid grid-cols-2 gap-3 min-[992px]:grid-cols-3 min-[992px]:gap-4">
        {%- for product in collection.products -%}
          {% include 'ui_product_card', product: product, tone: '', eager: false, wish: false %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {% include 'ui_pagination' %}
      {%- endif -%}
    {%- else -%}
      <p class="m-0 rounded-xl border border-solid border-line bg-surface-soft p-4 text-sm text-ink-secondary" role="status">Dịch vụ đang được cập nhật.</p>
    {%- endif -%}

    {%- comment -%} CTA tư vấn (thay khối promo ở sidebar cũ) {%- endcomment -%}
    <section class="mt-10 flex flex-col items-start gap-4 rounded-2xl bg-primary-darkest p-6 text-white lg:flex-row lg:items-center lg:justify-between lg:p-8" aria-label="Tư vấn miễn phí">
      <p class="m-0 text-lg font-bold text-white">Chưa biết da bạn cần gì?</p>
      <a href="/dat-lich-tu-van" class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-btn px-6 text-sm font-semibold !text-btn-text no-underline hover:bg-btn-hover">Tư vấn miễn phí</a>
    </section>

  </div>
</div>

{%- include 'pc_swiper_boot' -%}

{% endpaginate %}
