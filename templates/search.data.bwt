{% layout none %}
{%- comment -%} 2026-10-08: kết quả lọc AJAX của trang danh mục cũng in sao đánh giá thật như lần tải đầu. {%- endcomment -%}
{%- assign pc_card_rating = true -%}
<div class="category-products products-view products-view-grid list_hover_pro">
	<div class="filter-containers">
		{% if search.results.size > 0 %}
		{% paginate search.results by settings.collection_number_product %}
		{%include 'collection-sortby'%}
		{%- comment -%} 14/11/2026: lưới + thẻ sản phẩm 100% class Tailwind (ui_product_card — thẻ duy nhất của theme). {%- endcomment -%}
		<ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-3 lg:gap-4 xl:grid-cols-4 [html[data-pc-view=list]_&]:grid-cols-1">
			{% for product in search.results %}
			<li class="min-w-0">{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: true -%}</li>
			{% endfor %}
		</ul>
		<div>
			{% if paginate.pages > 1 %}
			{% include 'collection-paginate-pages' %}
			{% endif %}
		</div>
		{% endpaginate %}
		{% else %}
		<div class="afw-empty-state">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color:#aaa;">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z" />
			</svg>
			<p class="afw-empty-state__title">Không tìm thấy sản phẩm phù hợp</p>
			<p class="afw-empty-state__hint">Thử bỏ bớt một số bộ lọc để xem thêm kết quả</p>
			<div class="afw-empty-state__actions">
				<a href="javascript:void(0)" onclick="clearAllFiltered()" class="btn btn-outline">Bỏ tất cả bộ lọc</a>
				<a href="/collections/all" class="btn btn-primary">Xem tất cả sản phẩm</a>
			</div>
		</div>
		{% endif %}
	</div>
</div>
