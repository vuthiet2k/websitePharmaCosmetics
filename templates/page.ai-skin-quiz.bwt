{% layout 'theme' %}
{{ 'page_ai_skin_quiz.scss.css' | asset_url | stylesheet_tag }}
{% include 'customer_context_extractor' %}
<script src="{{ 'crm-intake.js' | asset_url }}" defer></script>
{% if settings.ai_skin_scan_enable != false %}
<script>
window.PharmaSkinScanCopy = {
  prompt: {{ settings.ai_skin_scan_prompt | default: 'Hãy căn mặt vào khung và chụp lần lượt đủ ba góc.' | json }},
  facePass: {{ settings.ai_skin_scan_face_pass | default: 'Tư thế đạt yêu cầu. Bạn có thể chụp góc này.' | json }},
  faceAdjust: {{ settings.ai_skin_scan_face_adjust | default: 'Hãy điều chỉnh góc mặt và khoảng cách theo khung hướng dẫn.' | json }},
  noFace: {{ settings.ai_skin_scan_no_face | default: 'Chưa nhận diện được khuôn mặt. Hãy căn mặt vào khung.' | json }},
  cameraFallback: {{ settings.ai_skin_scan_camera_fallback | default: 'Không thể mở camera. Bạn có thể tải đủ ba ảnh từ thiết bị để tiếp tục.' | json }},
  lightDark: {{ settings.ai_skin_scan_light_dark | default: 'Không gian quá tối, vui lòng bổ sung ánh sáng.' | json }},
  lightBright: {{ settings.ai_skin_scan_light_bright | default: 'Ảnh quá sáng, vui lòng tránh ánh sáng gắt hoặc ngược sáng.' | json }},
  lightLowContrast: {{ settings.ai_skin_scan_light_low_contrast | default: 'Ảnh thiếu tương phản, vui lòng tìm nơi có ánh sáng dịu và rõ hơn.' | json }},
  lightUneven: {{ settings.ai_skin_scan_light_uneven | default: 'Ánh sáng chưa đều, vui lòng điều chỉnh trước khi chụp.' | json }},
  photosComplete: {{ settings.ai_skin_scan_photos_complete | default: 'Đã có đủ ba góc. Bạn có thể bắt đầu phân tích tại thiết bị.' | json }},
  analyzing: {{ settings.ai_skin_scan_analyzing | default: 'Đang phân tích tại thiết bị…' | json }},
  analysisComplete: {{ settings.ai_skin_scan_analysis_complete | default: 'Phân tích hoàn tất. Ảnh soi da đã hiển thị bên dưới.' | json }},
  analysisMethodCanvas: {{ settings.ai_skin_scan_method_canvas | default: 'Đây là phép đo ảnh thử nghiệm trên thiết bị, không phải kết quả từ mô hình AI đã thẩm định. Các điểm số và gợi ý chỉ mang tính tham khảo.' | json }},
  analysisMethodOnnx: {{ settings.ai_skin_scan_method_onnx | default: 'Báo cáo có sử dụng model ONNX được cấu hình cho cửa hàng. Kết quả vẫn chỉ mang tính tham khảo, không thay thế đánh giá của Chuyên gia.' | json }},
  quizResultBadge: {{ settings.ai_skin_scan_quiz_result_badge | default: 'Kết quả tham khảo' | json }},
  quizResultSummary: {{ settings.ai_skin_scan_quiz_result_summary | default: 'Gợi ý được tổng hợp tự động từ thông tin bạn cung cấp và danh mục hiện có; chỉ mang tính tham khảo.' | json }},
  quizRecommendationLabel: {{ settings.ai_skin_scan_quiz_recommendation_label | default: 'Hoạt chất và sản phẩm tham khảo:' | json }},
  quizDetailedLinkLabel: {{ settings.ai_skin_scan_quiz_detail_label | default: 'Xem gợi ý chi tiết' | json }},
  quizIntro: {{ settings.ai_skin_scan_quiz_intro | default: 'Trả lời một số câu hỏi về làn da và thói quen chăm sóc để nhận gợi ý tham khảo từ Pharma Cosmetics.' | json }},
  quizMethodInfo: {{ settings.ai_skin_scan_quiz_method_info | default: 'Các gợi ý được tổng hợp tự động từ câu trả lời và danh mục sản phẩm hiện có. Đây không phải kết quả đo bằng thiết bị chuyên dụng hay đánh giá đã được thẩm định lâm sàng.' | json }},
  quizStartLabel: {{ settings.ai_skin_scan_quiz_start_label | default: 'Bắt đầu khảo sát' | json }},
  quizInfoLabel: {{ settings.ai_skin_scan_quiz_info_label | default: 'Cách tạo gợi ý' | json }},
  quizChatStatus: {{ settings.ai_skin_scan_chat_status | default: 'Trợ lý tư vấn • Gợi ý tham khảo' | json }},
  quizTypingStatus: {{ settings.ai_skin_scan_typing_status | default: 'Đang soạn phản hồi…' | json }},
  quizProgressStart: {{ settings.ai_skin_scan_progress_start | default: 'Bắt đầu khảo sát' | json }},
  quizProgressComplete: {{ settings.ai_skin_scan_progress_complete | default: 'Hoàn tất khảo sát' | json }},
  quizRestartConfirm: {{ settings.ai_skin_scan_restart_confirm | default: 'Bạn muốn làm lại khảo sát từ đầu không?' | json }},
  modeUnavailable: {{ settings.ai_skin_scan_mode_unavailable | default: 'Chế độ xử lý qua máy chủ chưa được tích hợp hoặc phê duyệt. Ảnh chưa được xử lý; bạn có thể chuyển sang khảo sát câu hỏi.' | json }},
  uploadTooLarge: {{ settings.ai_skin_scan_upload_too_large | default: 'Ảnh vượt dung lượng 12 MB. Hãy chọn ảnh nhỏ hơn để tránh quá tải thiết bị.' | json }},
  imageDimensionsTooLarge: {{ settings.ai_skin_scan_dimensions_too_large | default: 'Độ phân giải ảnh vượt giới hạn xử lý an toàn trên thiết bị. Hãy giảm kích thước ảnh rồi thử lại.' | json }},
  meshFallback: {{ settings.ai_skin_scan_mesh_fallback | default: 'Đang dùng hướng dẫn căn mặt thủ công vì chưa tải được bộ nhận diện.' | json }},
  uploadHintOk: {{ settings.ai_skin_scan_upload_hint_ok | default: 'Đã tải ảnh — nhấn để đổi ảnh khác' | json }},
  uploadHintChecking: {{ settings.ai_skin_scan_upload_hint_checking | default: 'Đang kiểm tra khuôn mặt…' | json }},
  uploadHintNoFace: {{ settings.ai_skin_scan_upload_hint_no_face | default: 'Không nhận diện được khuôn mặt người' | json }},
  uploadHintTooLarge: {{ settings.ai_skin_scan_upload_hint_too_large | default: 'Ảnh vượt quá dung lượng 12 MB' | json }},
  uploadHintDimensions: {{ settings.ai_skin_scan_upload_hint_dimensions | default: 'Độ phân giải ảnh quá lớn' | json }},
  productLinkLabel: {{ settings.skin_scan_product_link_label | default: 'Xem sản phẩm tham khảo' | json }}
};
window.PharmaSkinScanProductLabels = {
  'sua-rua-mat-amino-acid': {{ settings.skin_scan_product_cleanser_label | default: 'Sữa Rửa Mặt Tạo Bọt Amino Acid Dịu Nhẹ' | json }},
  'kem-phuc-hoi-ceramide-niacinamide': {{ settings.skin_scan_product_repair_label | default: 'Kem Phục Hồi Hàng Rào Da Ceramide + Niacinamide Chuyên Sâu' | json }},
  'serum-aha-10-bha-2': {{ settings.skin_scan_product_aha_label | default: 'Serum Tái Tạo Da AHA 10% / BHA 2% Mịn Màng & Sáng Đều' | json }},
  'kem-chong-nang-mineral-spf50': {{ settings.skin_scan_product_sunscreen_label | default: 'Kem Chống Nắng Mineral SPF50+ PA++++ Không Nhờn' | json }},
  'serum-vitamin-c-15': {{ settings.skin_scan_product_vitamin_c_label | default: 'Serum Vitamin C 15% Làm Sáng & Đều Màu Da' | json }},
  'serum-tranexamic-acid-3': {{ settings.skin_scan_product_tranexamic_label | default: 'Serum Mờ Thâm Tranexamic Acid 3% & Niacinamide Đều Màu Da' | json }},
  'kem-duong-am-hyaluronic-acid': {{ settings.skin_scan_product_hyaluronic_label | default: 'Kem Dưỡng Ẩm Hyaluronic Acid 3 Tầng Căng Mướt Suốt Ngày' | json }},
  'kem-duong-retinol-0-3-peptide': {{ settings.skin_scan_product_retinol_03_label | default: 'Kem Dưỡng Retinol 0.3% + Peptide Chống Lão Hoá' | json }},
  'retinol-advanced-0-5-night-serum': {{ settings.skin_scan_product_retinol_05_label | default: 'Retinol Advanced 0.5% Night Serum Chống Lão Hoá Chuyên Sâu' | json }},
  'toner-niacinamide-5-zinc': {{ settings.skin_scan_product_niacinamide_label | default: 'Toner Niacinamide 5% + Zinc Kiểm Soát Dầu & Thu Nhỏ Lỗ Chân Lông' | json }}
};
</script>
<script src="{{ 'skin-liqa-lighting.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-liqa-mesh.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-deid-roi.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-cv-engine.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-onnx-engine.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-mst-debiasing.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-scoring-engine.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-routine-matcher.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-visual-overlay.js' | asset_url }}" defer></script>
  <script src="{{ 'skin-camera.js' | asset_url }}" defer></script>
{% endif %}

{% if settings.ai_skin_scan_enable != false %}
<nav class="container pc-skin-mode-tabs" aria-label="{{ settings.ai_skin_scan_modes_label | default: 'Chọn cách phân tích da' | escape }}" role="tablist">
  <button type="button" role="tab" aria-selected="true" data-skin-mode="camera">
    <svg class="pc-mode-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
    <span class="d-none d-md-inline">{{ settings.ai_skin_scan_camera_tab | default: 'Phân tích ảnh qua camera' | escape }}</span>
    <span class="d-inline d-md-none">AI camera</span>
  </button>
  <button type="button" role="tab" aria-selected="false" data-skin-mode="quiz">
    <svg class="pc-mode-tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <span class="d-none d-md-inline">{{ settings.ai_skin_scan_quiz_tab | default: 'Khảo sát câu hỏi' | escape }}</span>
    <span class="d-inline d-md-none">AI chat</span>
  </button>
</nav>
{% include 'skin_scan_camera' %}
{% endif %}

<div class="container">
<div class="ai-skin-chat-app" id="aiSkinChatApp">
  <h1 class="sr-only">{{ page.title | default: page_title | escape }}</h1>
  <!-- Chat App Header -->
  <header class="chat-app-header">
    <div class="header-left">
      <div class="doctor-avatar-wrap">
        <div class="doctor-avatar">
          <i class="fas fa-user-doctor" aria-hidden="true"></i>
        </div>
        <span class="online-indicator" title="Đang trực tuyến"></span>
      </div>
      <div class="doctor-info">
        <div class="doctor-name-row">
          <span class="doctor-name">Chuyên gia Pharma AI</span>
           <span class="verified-badge d-none d-md-inline-flex" title="{{ settings.ai_skin_scan_chat_badge | default: 'Gợi ý tự động, chỉ mang tính tham khảo' | escape }}"><i class="fas fa-circle-info" aria-hidden="true"></i> {{ settings.ai_skin_scan_chat_badge | default: 'Gợi ý tham khảo' | escape }}</span>
        </div>
        <div class="doctor-status">
           <span class="typing-status" id="headerStatusText">{{ settings.ai_skin_scan_chat_status | default: 'Trợ lý tư vấn • Gợi ý tham khảo' | escape }}</span>
        </div>
      </div>
    </div>
    <div class="header-right d-none d-md-block">
      <button type="button" class="btn-chat-action" id="btnRestartChat" title="Làm lại từ đầu">
        <i class="fas fa-rotate-right" aria-hidden="true"></i>
        <span class="action-text">Làm lại</span>
      </button>
    </div>
  </header>

  <!-- Diagnostic Progress Indicator -->
  <div class="chat-progress-wrap">
    <div class="progress-info-row">
      <span class="progress-step-label" id="progressStepLabel">{{ settings.ai_skin_scan_progress_start | default: 'Bắt đầu khảo sát' | escape }}</span>
      <span class="progress-percent-label" id="progressPercentLabel">0%</span>
    </div>
    <div class="progress-track">
      <div class="progress-bar-fill" id="progressBarFill"></div>
    </div>
  </div>

  <!-- Chat Message Stream (Auto-scrolls) -->
  <main class="chat-messages-viewport" id="chatMessagesViewport" role="log" aria-live="polite">
    <div class="chat-timeline-divider">
      <span>Hôm nay</span>
    </div>
    <div class="chat-security-banner">
      <i class="fas fa-shield-halved" aria-hidden="true"></i>
      <span>{{ settings.ai_skin_scan_privacy_caption | default: 'Thông tin bạn cung cấp được xử lý theo Chính sách bảo mật của Pharma Cosmetics.' | escape }}</span>
    </div>

    <!-- Message bubbles will be appended dynamically by JavaScript -->
    <div class="messages-flow" id="messagesFlow"></div>

    <!-- Live Typing Indicator -->
    <div class="typing-bubble-wrap" id="typingIndicator" style="display: none;" aria-hidden="true">
      <div class="doctor-avatar-mini">
        <i class="fas fa-user-doctor"></i>
      </div>
      <div class="typing-bubble">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>
    </div>
  </main>

  <!-- Interactive Action Dock (Bottom fixed) -->
  <footer class="chat-action-dock" id="chatActionDock">
    <!-- Quick-reply Options Container -->
    <div class="quick-replies-scroll" id="quickRepliesContainer"></div>

    <!-- Fallback Text Input Bar -->
    <div class="chat-input-bar">
      <input type="text" id="chatTextInput" class="chat-text-input" placeholder="Chọn câu trả lời ở trên hoặc nhập phản hồi..." autocomplete="off">
      <button type="button" class="btn-send-chat" id="btnSendChat" aria-label="Gửi tin nhắn">
        <i class="fas fa-paper-plane" aria-hidden="true"></i>
      </button>
    </div>
  </footer>
</div>
</div>

{% include 'skin_consent_modal' %}

{%- comment -%} 2026-10-05: engine chấm điểm thuần (Tier/Case/cờ an toàn) — nạp đồng bộ trước script quiz. {%- endcomment -%}
<script src="{{ 'skin-quiz-engine.js' | asset_url }}"></script>
<script>
(function() {
  'use strict';
  var copy = window.PharmaSkinScanCopy || {};

  // Bộ câu hỏi khảo sát (snippets/quiz_questions_data.bwt)
  // 2026-10-03: quiz_questions/quiz_results là biến mock (không có trên Sapo) → trước đây trên Sapo
  // chỉ chạy bộ dự phòng 5 câu và trang kết quả luôn ra "Da dầu". Câu hỏi + bảng kết quả dùng chung
  // snippets/quiz_questions_data.bwt và snippets/quiz_results_data.bwt (cùng nguồn với trang kết quả).
  var quizQuestions = {% include 'quiz_questions_data' %};
  var quizResults = {% include 'quiz_results_data' %};
  var safetyCopy = {% include 'quiz_safety_copy' %};
  var quizEngine = window.PharmaSkinQuizEngine || null;


  var currentQuestionIndex = -1;
  var userScores = {};
  var quizAnswers = [];
  var latestCrmResult = null;
  var crmUi = {
    openLabel: {{ settings.crm_consent_open_label | default: 'Lưu kết quả tư vấn' | json }},
    acceptLabel: {{ settings.crm_consent_accept_label | default: 'Đồng ý lưu kết quả' | json }},
    successMessage: {{ settings.crm_consent_success_message | default: 'Kết quả đã được lưu.' | json }},
    safeModeMessage: {{ settings.crm_consent_safe_mode_message | default: 'Tính năng lưu kết quả đang tạm thời chưa được cấu hình. Vui lòng liên hệ chuyên gia nếu cần hỗ trợ.' | json }},
    errorMessage: {{ settings.crm_consent_error_message | default: 'Chưa thể lưu kết quả lúc này. Vui lòng thử lại hoặc liên hệ chuyên gia.' | json }}
  };
  var isTyping = false;

  var messagesFlow = document.getElementById('messagesFlow');
  var chatViewport = document.getElementById('chatMessagesViewport');
  var quickReplies = document.getElementById('quickRepliesContainer');
  var typingIndicator = document.getElementById('typingIndicator');
  var textInput = document.getElementById('chatTextInput');
  var btnSend = document.getElementById('btnSendChat');
  var btnRestart = document.getElementById('btnRestartChat');
  var progressBar = document.getElementById('progressBarFill');
  var progressStepLabel = document.getElementById('progressStepLabel');
  var progressPercentLabel = document.getElementById('progressPercentLabel');
  var headerStatus = document.getElementById('headerStatusText');
  var crmConsentModal = document.getElementById('aiSkinCrmConsentModal');
  var crmConsentStatus = document.getElementById('aiSkinCrmConsentStatus');
  var crmConsentAccept = document.getElementById('aiSkinCrmConsentAccept');
  var crmSubmissionId = '';

  function escapeHtml(value) {
    var el = document.createElement('div');
    el.textContent = String(value || '');
    return el.innerHTML;
  }

  function getCurrentTime() {
    var d = new Date();
    var h = d.getHours().toString().padStart(2, '0');
    var m = d.getMinutes().toString().padStart(2, '0');
    return h + ':' + m;
  }

  function scrollToBottom() {
    setTimeout(function() {
      chatViewport.scrollTo({
        top: chatViewport.scrollHeight,
        behavior: 'smooth'
      });
    }, 50);
  }

  function setTyping(state) {
    isTyping = state;
    typingIndicator.style.display = state ? 'flex' : 'none';
    headerStatus.textContent = state ? (copy.quizTypingStatus || 'Đang soạn phản hồi…') : (copy.quizChatStatus || 'Trợ lý tư vấn • Gợi ý tham khảo');
    if (state) scrollToBottom();
  }

  function addBotMessage(htmlContent, callback) {
    setTyping(true);
    var delay = Math.min(1000, 400 + Math.random() * 300);

    setTimeout(function() {
      setTyping(false);
      var msgRow = document.createElement('div');
      msgRow.className = 'chat-message-row bot-row';
      msgRow.innerHTML = `
        <div class="doctor-avatar-mini" aria-hidden="true">
          <i class="fas fa-user-doctor"></i>
        </div>
        <div class="message-content-wrap">
          <div class="message-bubble bot-bubble">
            ${htmlContent}
          </div>
          <span class="message-timestamp">${getCurrentTime()}</span>
        </div>
      `;
      messagesFlow.appendChild(msgRow);
      scrollToBottom();
      if (callback) callback();
    }, delay);
  }

  function addUserMessage(text) {
    var msgRow = document.createElement('div');
    msgRow.className = 'chat-message-row user-row';
    msgRow.innerHTML = `
      <div class="message-content-wrap">
        <div class="message-bubble user-bubble">
          ${text}
        </div>
        <span class="message-timestamp">${getCurrentTime()} <i class="fas fa-check-double" style="color:#34D399;font-size:10px;"></i></span>
      </div>
    `;
    messagesFlow.appendChild(msgRow);
    scrollToBottom();
  }

  function updateProgress(step, total) {
    var percent = Math.round((step / total) * 100);
    progressBar.style.width = percent + '%';
    progressPercentLabel.textContent = percent + '%';
    if (step === 0) {
      progressStepLabel.textContent = copy.quizProgressStart || 'Bắt đầu khảo sát';
    } else if (step > total) {
      progressStepLabel.textContent = copy.quizProgressComplete || 'Hoàn tất khảo sát';
    } else {
      progressStepLabel.textContent = 'Câu ' + step + '/' + total;
    }
  }

  function renderQuickReplies(options, onSelect) {
    quickReplies.innerHTML = '';
    if (!options || options.length === 0) return;

    options.forEach(function(opt) {
      var chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'quick-reply-chip';
      chip.textContent = opt.text;
      chip.addEventListener('click', function() {
        quickReplies.innerHTML = '';
        addUserMessage(opt.text);
        if (onSelect) onSelect(opt);
      });
      quickReplies.appendChild(chip);
    });
    scrollToBottom();
  }

  function askQuestion(index) {
    if (index >= quizQuestions.length) {
      finishQuiz();
      return;
    }

    currentQuestionIndex = index;
    var q = quizQuestions[index];
    var phaseName = q.phase || ('Giai đoạn ' + (Math.floor(index / 5) + 1));

    updateProgress(index + 1, quizQuestions.length);

    var botHtml = `
      <div class="quiz-phase-badge"><i class="fas fa-stethoscope"></i> ${phaseName}</div>
      <p class="quiz-question-heading"><strong>Câu hỏi ${index + 1}/${quizQuestions.length}:</strong> ${q.question}</p>
    `;

    addBotMessage(botHtml, function() {
      renderQuickReplies(q.options, function(selectedOpt) {
        // 2026-10-05: lưu kèm mã đáp án (code) cho luật xếp Case; câu "scoring": false (Q10 thói quen,
        // Q17 kênh liên hệ, Q15/Q16 cờ an toàn, câu dấu hiệu cấp tính) KHÔNG cộng điểm loại da.
        var st = selectedOpt.skin_type || '';
        quizAnswers.push({ question_id: q.id || index + 1, answer: selectedOpt.text || '', skin_type: st, code: selectedOpt.code || '' });
        if (st && q.scoring !== false) userScores[st] = (userScores[st] || 0) + 1;
        // Tier 1: chọn dấu hiệu cấp tính ⇒ dừng khảo sát ngay, chuyển chuyên gia.
        if (q.role === 'red_flag' && selectedOpt.code && selectedOpt.code !== 'none') {
          finishQuiz();
          return;
        }
        
        // Conversational encouragement every 4 questions
        if (index === 6) {
          addBotMessage("Cảm ơn bạn! Chuyên gia đã nắm được đặc điểm cơ địa nền da. Tiếp theo chúng ta sẽ khám chi tiết về các triệu chứng và thói quen sinh hoạt nhé.", function() {
            askQuestion(index + 1);
          });
        } else if (index === 12) {
          addBotMessage("Tuyệt vời! Chỉ còn vài câu hỏi cuối cùng để chuyên gia hoàn thiện gợi ý hoạt chất phù hợp cho bạn.", function() {
            askQuestion(index + 1);
          });
        } else {
          askQuestion(index + 1);
        }
      });
    });
  }

  function finishQuiz() {
    updateProgress(quizQuestions.length, quizQuestions.length);
    quickReplies.innerHTML = '';

    // 2026-10-05: Tier/Case/cờ an toàn từ assets/skin-quiz-engine.js.bwt; thiếu engine ⇒ giữ cách cũ.
    var evaluation = quizEngine ? quizEngine.evaluate(quizQuestions, quizAnswers) : null;
    var best = 'normal';
    if (evaluation) {
      best = evaluation.top_skin_type;
    } else {
      var maxScore = -1;
      for (var k in userScores) {
        if (userScores[k] > maxScore) { maxScore = userScores[k]; best = k; }
      }
    }
    var isRedFlag = Boolean(evaluation && evaluation.tier === 1);
    var excluded = evaluation ? evaluation.excluded_actives : [];
    var flags = evaluation ? evaluation.safety_flags : [];
    var caseData = (!isRedFlag && evaluation && quizResults.cases) ? quizResults.cases[evaluation.case_id] : null;

    var res = quizResults[best] || quizResults['normal'] || { skin_type: 'Da Khỏe', recommend: [] };
    var recommend = (res.recommend || []).filter(function (r) { return !quizEngine || quizEngine.isTextAllowed(r, excluded); });
    var contactAnswer = quizAnswers.filter(function (a) { return Number(a.question_id) === 17; })[0];
    var resultTitle = isRedFlag ? (safetyCopy.redFlagTitle || '') : (caseData ? caseData.title : res.skin_type);
    var summaryParts = [resultTitle];
    if (evaluation) summaryParts.push('Tier ' + evaluation.tier + ' (' + evaluation.case_id + ')');
    if (flags.length) summaryParts.push('Cờ an toàn: ' + flags.join(', '));
    if (contactAnswer) summaryParts.push('Kênh liên hệ: ' + contactAnswer.answer);

    latestCrmResult = {
      skin_type: isRedFlag ? resultTitle : (res.skin_type || ''),
      scores: userScores,
      recommendations: isRedFlag ? [] : recommend,
      answers: quizAnswers,
      summary: summaryParts.join(' | '),
      tier: evaluation ? evaluation.tier : null,
      case_id: evaluation ? evaluation.case_id : '',
      safety_flags: flags,
      contact_channel: contactAnswer ? contactAnswer.answer : ''
    };

    // 2026-09-24: chỉ giữ loại da trong tab hiện tại để chuyển sang trang kết quả; điểm chi tiết không cần lưu phía trình duyệt.
    // 2026-10-05: kèm Tier/Case/cờ an toàn (không có thông tin cá nhân) cho trang kết quả.
    try {
      sessionStorage.setItem('pc_quiz_skin_type', best);
      // 2026-10-08: mốc thời gian để trang kết quả lấy kết quả MỚI NHẤT giữa khảo sát chat và soi da AI.
      sessionStorage.setItem('pc_quiz_saved_at', String(Date.now()));
      if (evaluation) sessionStorage.setItem('pc_quiz_result', JSON.stringify({
        tier: evaluation.tier, case_id: evaluation.case_id, red_flag: evaluation.red_flag,
        top_skin_type: best, safety_flags: flags, excluded_actives: excluded
      }));
    } catch(e) {}
    try {
      localStorage.removeItem('pc_quiz_skin_type');
      localStorage.removeItem('pc_quiz_scores');
    } catch(e) {}

    var notes = [];
    if (!isRedFlag && evaluation && evaluation.tier === 2 && safetyCopy.tier2Note) notes.push(safetyCopy.tier2Note);
    if (!isRedFlag && flags.indexOf('pregnancy') !== -1 && safetyCopy.pregnancyNote) notes.push(safetyCopy.pregnancyNote);
    if (!isRedFlag && flags.indexOf('allergy_severe') !== -1 && safetyCopy.allergyNote) notes.push(safetyCopy.allergyNote);
    var notesHtml = notes.map(function (n) {
      return `<p class="result-safety-note"><i class="fas fa-shield-halved" aria-hidden="true"></i> ${escapeHtml(n)}</p>`;
    }).join('');

    addBotMessage(isRedFlag ? "⚠️ <strong>Cần lưu ý ngay.</strong>" : "🎉 <strong>Phân tích hoàn tất!</strong> Dựa trên thông tin bạn vừa cung cấp, Chuyên gia Pharma AI đã tổng hợp kết quả tư vấn da cho bạn:", function() {

      var recTags = '';
      recommend.forEach(function(r) {
        recTags += `<span class="res-rec-badge"><i class="fas fa-check"></i> ${escapeHtml(r)}</span>`;
      });

      var resultCardHtml = isRedFlag ? `
        <div class="diagnostic-result-card diagnostic-result-card--alert" data-quiz-red-flag>
          <div class="result-card-header">
            <span class="card-tag">${escapeHtml(copy.quizResultBadge || 'Kết quả tham khảo')}</span>
            <h2 class="result-skin-title">${escapeHtml(resultTitle)}</h2>
            <p class="result-skin-summary">${escapeHtml(safetyCopy.redFlagText || '')}</p>
          </div>
          <div class="result-card-actions">
            <a href="${escapeHtml(safetyCopy.zaloUrl || '/pages/dat-lich-tu-van')}" target="_blank" rel="noopener" class="btn-result-zalo">
              <i class="fas fa-comment-dots"></i>
              <span>${escapeHtml(safetyCopy.zaloLabel || 'Liên hệ chuyên gia qua Zalo')}</span>
            </a>
            <button type="button" class="btn-result-crm" id="btnSaveAiResult">${escapeHtml(crmUi.openLabel)}</button>
          </div>
        </div>
      ` : `
        <div class="diagnostic-result-card" data-quiz-case="${escapeHtml(evaluation ? evaluation.case_id : '')}">
          <div class="result-card-header">
            <span class="card-tag">${escapeHtml(copy.quizResultBadge || 'Kết quả tham khảo')}</span>
            <h2 class="result-skin-title">${escapeHtml(resultTitle)}</h2>
            <p class="result-skin-summary">${escapeHtml(caseData ? res.skin_type : (copy.quizResultSummary || 'Gợi ý được tổng hợp tự động từ thông tin bạn cung cấp và danh mục hiện có; chỉ mang tính tham khảo.'))}</p>
            ${notesHtml}
          </div>

          <div class="result-card-body">
            <h4 class="rec-title"><i class="fas fa-flask"></i> ${escapeHtml(copy.quizRecommendationLabel || 'Hoạt chất và sản phẩm tham khảo:')}</h4>
            <div class="result-recommend-grid">
              ${recTags}
            </div>
          </div>

          <div class="result-card-actions">
            <button type="button" class="btn-result-crm" id="btnSaveAiResult">${escapeHtml(crmUi.openLabel)}</button>
            <a href="/ai-skin-quiz-results" class="btn-result-cta">
              <span>${escapeHtml(copy.quizDetailedLinkLabel || 'Xem gợi ý chi tiết')}</span>
              <i class="fas fa-arrow-right"></i>
            </a>
            <a href="${escapeHtml(safetyCopy.zaloUrl || '/pages/dat-lich-tu-van')}" target="_blank" rel="noopener" class="btn-result-zalo">
              <i class="fas fa-comment-dots"></i>
              <span>Gửi Kết Quả Cho Chuyên Gia 1:1</span>
            </a>
          </div>
        </div>
      `;

      addBotMessage(resultCardHtml, function() {
        // 2026-10-05: Tier 1 không mời xem sản phẩm.
        renderQuickReplies((isRedFlag ? [
          { text: "🔄 Khám lại từ đầu" },
          { text: "🏠 Quay lại trang chủ" }
        ] : [
          { text: "🔄 Khám lại từ đầu" },
          { text: "🛍️ Xem các sản phẩm phù hợp" },
          { text: "🏠 Quay lại trang chủ" }
        ]), function(chosen) {
          if (chosen.text.includes("Khám lại")) {
            startConversation();
          } else if (chosen.text.includes("sản phẩm")) {
            window.location.href = '/collections/all';
          } else {
            window.location.href = '/';
          }
        });
      });
    });
  }

  function startConversation() {
    messagesFlow.innerHTML = '';
    quickReplies.innerHTML = '';
    try { sessionStorage.removeItem('pc_quiz_skin_type'); sessionStorage.removeItem('pc_quiz_result'); } catch (error) {}
    currentQuestionIndex = -1;
    userScores = {};
    quizAnswers = [];
    latestCrmResult = null;
    updateProgress(0, quizQuestions.length);

    addBotMessage("Chào bạn! 👋 Mình là <strong>Chuyên gia Pharma AI</strong> - Trợ lý tư vấn làn da thông minh của Pharma Cosmetics.", function() {
      addBotMessage(escapeHtml(copy.quizIntro || 'Trả lời một số câu hỏi về làn da và thói quen chăm sóc để nhận gợi ý tham khảo từ Pharma Cosmetics.'), function() {
        renderQuickReplies([
          { text: "🚀 " + (copy.quizStartLabel || 'Bắt đầu khảo sát') + " ➔" },
          { text: "💡 " + (copy.quizInfoLabel || 'Cách tạo gợi ý') }
        ], function(choice) {
          if (choice.text.includes(copy.quizInfoLabel || 'Cách tạo gợi ý')) {
            addBotMessage(escapeHtml(copy.quizMethodInfo || 'Các gợi ý được tổng hợp tự động từ câu trả lời và danh mục sản phẩm hiện có. Đây không phải kết quả đo bằng thiết bị chuyên dụng hay đánh giá đã được thẩm định lâm sàng.'), function() {
              renderQuickReplies([{ text: "🚀 " + (copy.quizStartLabel || 'Bắt đầu khảo sát') + " ➔" }], function() {
                askQuestion(0);
              });
            });
          } else {
            askQuestion(0);
          }
        });
      });
    });
  }

  // Handle free text input
  function handleUserInput() {
    var txt = textInput.value.trim();
    if (!txt) return;
    textInput.value = '';
    addUserMessage(txt);

    // Bot friendly guidance response
    addBotMessage("Cảm ơn bạn đã chia sẻ thêm thông tin! Hãy bấm chọn vào các phương án phù hợp nhất ở phía dưới để mình ghi nhận điểm số chính xác nhé.", function() {
      scrollToBottom();
    });
  }

  btnSend.addEventListener('click', handleUserInput);
  textInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') handleUserInput();
  });

  btnRestart.addEventListener('click', function() {
    if (confirm(copy.quizRestartConfirm || 'Bạn muốn làm lại khảo sát từ đầu không?')) {
      startConversation();
    }
  });

  function closeCrmConsent() {
    crmConsentModal.hidden = true;
    crmConsentModal.setAttribute('aria-hidden', 'true');
  }

  function openCrmConsent() {
    if (!latestCrmResult) return;
    crmSubmissionId = (window.PharmaCrmIntake && window.PharmaCrmIntake.createSubmissionId)
      ? window.PharmaCrmIntake.createSubmissionId() : '';
    crmConsentStatus.textContent = '';
    crmConsentAccept.disabled = !(window.PharmaCrmIntake && window.PharmaCrmIntake.isReady && window.PharmaCrmIntake.isReady());
    if (crmConsentAccept.disabled) crmConsentStatus.textContent = crmUi.safeModeMessage;
    crmConsentModal.hidden = false;
    crmConsentModal.setAttribute('aria-hidden', 'false');
  }

  document.addEventListener('click', function(e) {
    if (e.target && e.target.id === 'btnSaveAiResult') {
      openCrmConsent();
    }
    if (e.target && e.target.id === 'aiSkinCrmConsentCancel') {
      closeCrmConsent();
    }
  });

  crmConsentAccept.addEventListener('click', function() {
    if (!latestCrmResult || !window.PharmaCrmIntake) return;
    crmConsentAccept.disabled = true;
    crmConsentStatus.textContent = 'Đang lưu…';

    var payload = {
      submission_id: crmSubmissionId,
      customer_id: (window.PharmaCustomerContext && window.PharmaCustomerContext.customerId) || '',
      skin_type: latestCrmResult.skin_type,
      scores: latestCrmResult.scores,
      recommendations: latestCrmResult.recommendations,
      answers: latestCrmResult.answers,
      summary: latestCrmResult.summary,
      tier: latestCrmResult.tier,
      case_id: latestCrmResult.case_id,
      safety_flags: latestCrmResult.safety_flags,
      contact_channel: latestCrmResult.contact_channel,
      source: 'quiz',
      // 2026-10-05: khách vừa bấm "Đồng ý lưu" — crm-intake.js và GAS đều từ chối request thiếu consent.
      consent: true,
      consent_at: new Date().toISOString()
    };

    // 2026-10-05: client chỉ có submitAiChat (save_ai_chat → tab AI_Chat_Results); gọi .submit() cũ
    // ném TypeError ngay trong click handler nên kết quả quiz chưa bao giờ lên Sheet.
    window.PharmaCrmIntake.submitAiChat(payload).then(function(res) {
      if (res && res.success) {
        crmConsentStatus.textContent = crmUi.successMessage;
        setTimeout(closeCrmConsent, 1200);
      } else {
        crmConsentStatus.textContent = (res && res.message) || crmUi.errorMessage;
        crmConsentAccept.disabled = false;
      }
    }).catch(function(err) {
      crmConsentStatus.textContent = (err && err.message) || crmUi.errorMessage;
      crmConsentAccept.disabled = false;
    });
  });

  startConversation();
})();
</script>
