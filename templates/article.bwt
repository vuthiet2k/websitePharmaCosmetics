{% include 'breadcrumb' %} 
{%if article.content contains "<h2"%}
{% assign mucluc = true %}
{%endif%}
{%- assign duocsi = false -%}
{%- for tag in article.tags -%} 
{%- assign tags = tag -%} 
{%- if tags contains 'duocsi_'-%} 
{%- assign duocsi = true -%} 
{% assign itemduocsi = tags | remove: 'duocsi_' %}
{%- endif -%}
{%- endfor -%}
{%- comment -%}
  REOPEN 2026-09-10 (ADR-007/T-74) — CMP-01 Reading Progress Bar: fixed top, đo % cuộn thực
  qua .article-content-main (JS trong snippets/pc_clinical_components.bwt).
{%- endcomment -%}
<div class="pc-cmp-progress-bar"><div class="pc-cmp-progress-bar__fill"></div></div>
<section class="blogpage">
	<div class="container layout-article" itemscope itemtype="https://schema.org/Article">
		<div class="bg_blog">
			<meta itemprop="mainEntityOfPage" content="{{ article.url }}">
			<meta itemprop="description" content="{{ article.summary | strip_html }}">
			<meta itemprop="author" content="{{ article.author }}">
			<meta itemprop="headline" content="{{ article.title | truncate: 100}}">
			<meta itemprop="image" content="https:{%if article.image.src == null %}{{ 'logo.png' | asset_url }}{%else%}{{ article.image.src }}{%endif%}">
			<meta itemprop="datePublished" content="{{ article.published_on | date: '%Y-%m-%d' }}">
			<meta itemprop="dateModified" content="{{ article.created_on | date: '%Y-%m-%d' }}">
			<div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
				<div itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
					<img class="d-none" src="{{'logo.png'|asset_url}}" alt="{{ store.name }}"/>
					<meta itemprop="url" content="https:{{'logo.png'|asset_url}}">
					<meta itemprop="width" content="400">
					<meta itemprop="height" content="60">
				</div>
				<meta itemprop="name" content="{{store.name}}">
			</div>
			<article class="article-main">
				<div class="row">
					<div class="right-content {%if settings.right_asideblog_enable%}col-lg-9 {%else%} col-lg-12 {%endif%} col-12">
						{%- comment -%}
						  REOPEN 2026-09-10 (ADR-007/T-74) — CMP-02 Sticky TOC: cột phụ 240px, chỉ hiện
						  desktop (>=1200px, class .pc-cmp-sticky-toc tự ẩn <1200px qua CSS), tái dùng
						  ĐÚNG tocbot.init() đã có (không thêm thư viện scrollspy mới) — xem <script>
						  cuối file, target selector .pc-cmp-toc-list.
						{%- endcomment -%}
						<div class="lg:flex lg:items-start lg:gap-8">
						{%if mucluc == true%}
						<aside class="pc-cmp-sticky-toc">
							<div class="pc-cmp-sticky-toc__title">Nội dung bài viết</div>
							<div class="pc-cmp-toc-list toc-list"></div>
						</aside>
						{%endif%}
						<div class="article-details bg-shadow clearfix flex-1 min-w-0">
							<h1 class="article-title">{{ article.title }}</h1>
							<div class="size-content-detail">
								<div class="posts">
									<div class="time-post f">
										{%assign thu = article.published_on | date:'%a' %}
										<svg aria-hidden="true" focusable="false" data-prefix="fal" data-icon="clock" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="svg-inline--fa fa-clock fa-w-16"><path fill="currentColor" d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm216 248c0 118.7-96.1 216-216 216-118.7 0-216-96.1-216-216 0-118.7 96.1-216 216-216 118.7 0 216 96.1 216 216zm-148.9 88.3l-81.2-59c-3.1-2.3-4.9-5.9-4.9-9.7V116c0-6.6 5.4-12 12-12h14c6.6 0 12 5.4 12 12v146.3l70.5 51.3c5.4 3.9 6.5 11.4 2.6 16.8l-8.2 11.3c-3.9 5.3-11.4 6.5-16.8 2.6z" class=""></path></svg>
										{%if thu == 'Mon'%}
										Thứ Hai,
										{%elsif thu == 'Tue'%}
										Thứ Ba,
										{%elsif thu == 'Wed'%}
										Thứ Tư,
										{%elsif thu == 'Thu'%}
										Thứ Năm,
										{%elsif thu == 'Fri'%}
										Thứ Sáu,
										{%elsif thu == 'Sat'%}
										Thứ Bảy,
										{%elsif thu == 'Sun'%}
										Chủ Nhật,
										{%else%}
										Thứ {{ article.published_on | date:'%a' }}
										{%endif%}{{ article.published_on | date:'dd/MM/yyy' }}
									</div>
									<div class="time-post">
										<svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="user" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="svg-inline--fa fa-user fa-w-14"><path fill="currentColor" d="M224 256c70.7 0 128-57.3 128-128S294.7 0 224 0 96 57.3 96 128s57.3 128 128 128zm89.6 32h-16.7c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16h-16.7C60.2 288 0 348.2 0 422.4V464c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48v-41.6c0-74.2-60.2-134.4-134.4-134.4z" class=""></path></svg>
										<span>{{article.author}}</span>
									</div>
								</div>
								{%- comment -%}
								  T-41 author byline block — tìm doctors record trùng article.author (so sánh
								  chuỗi chính xác, KHÔNG ép mọi bài viết về 1 chuyên gia). Nếu khớp: hiện avatar +
								  chức danh + badge + link sang page.chuyen-gia-detail.bwt (chỉ đúng khi khớp
								  flagship doctor alias 'chuyen-gia-thanh-hang' — T-114 2026-09-12, đổi từ alias
								  cũ (gắn tên "Minh Anh") sau khi hợp nhất 2 hồ sơ trùng tên — vì đó là trang
								  duy nhất tồn tại — các chuyên gia khác trong data/doctors.js chưa có trang detail riêng).
								  pc-kit-* class xem snippets/pharma_ui_kit.bwt (tiền tố bắt buộc, tránh trùng
								  .badge-clinical/.nav-link đã có sẵn ở assets/page_blog.scss.bwt).
								{%- endcomment -%}
								{%- assign article_author_doctor = null -%}
								{%- for doc in doctors -%}
								  {%- if doc.name == article.author -%}
								    {%- assign article_author_doctor = doc -%}
								  {%- endif -%}
								{%- endfor -%}
								<div class="pc41-author-byline flex items-center gap-3 py-4 my-2 border-y border-gray-100">
								  {%- if article_author_doctor -%}
								  <img src="{{ article_author_doctor.photo.src }}" alt="{{ article_author_doctor.photo.alt }}" loading="lazy"
								    class="w-12 h-12 rounded-full object-cover border-2 border-emerald-100 flex-shrink-0">
								  <div class="min-w-0">
								    <div class="flex items-center gap-2 flex-wrap">
								      <span class="text-sm font-bold text-forest-900 font-heading">{{ article_author_doctor.name }}</span>
								      {%- if article_author_doctor.alias == 'chuyen-gia-thanh-hang' -%}
								      <span class="pc-kit-badge-clinical text-[10px]">✓ Hội đồng Chuyên môn</span>
								      {%- endif -%}
								    </div>
								    <p class="text-xs text-gray-500">{{ article_author_doctor.title }}</p>
								    {%- if article_author_doctor.alias == 'chuyen-gia-thanh-hang' -%}
								    <a href="/pages/chuyen-gia-detail" class="text-xs font-semibold text-emerald-700 hover:underline">Xem hồ sơ đầy đủ →</a>
								    {%- endif -%}
								  </div>
								  {%- else -%}
								  <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
								    <i class="fas fa-user-md"></i>
								  </div>
								  <div>
								    <span class="text-sm font-bold text-forest-900 font-heading">{{ article.author }}</span>
								    <p class="text-xs text-gray-500">Đội ngũ biên tập Pharma Cosmetics</p>
								  </div>
								  {%- endif -%}
								</div>
								<div class="lc-switch-size">
									<p class="size-text">Kích thước chữ</p>
									<div class="lc-option-box-size">
										<div class="cursor-pointer active">
											<p class="css-osuj7x ">Mặc định </p>
										</div><div class="cursor-pointer">
										<p class="css-osuj7x">Lớn hơn</p>
										</div>
									</div>
								</div>
							</div>

							{%if mucluc == true%}
							<div class="goto-wrapper ftoc-head">
								<a class="title-goto-wrapper" href="javascript:;">
									<span>Nội dung bài viết</span>
									<span class="icon">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list-ul" viewBox="0 0 16 16">
											<path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2m0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
										</svg>
									</span>
								</a>
								<div class="menu-toc hidden"></div>
							</div>
							{%endif%}
							<div class="rte article-content-main">
								{%if article.content.size > 0%}
								{% include 'shortcode' load: article.content %}
								{%else%}
								<div class="alert alert-success alert-dismissible fade show" role="alert">
									Nội dung bài viết đang cập nhật.	
								</div>
								{%endif%}
							</div>
							{%if settings.kiemduyet_user_enable%}
							{%if duocsi%}
							{% assign target_article = articles[itemduocsi] %}
							<div class="box_kiem_duyet">
								<div class="item_store">
									<div class="item_image_store">
										<div class="image">
											<img width="100" height="100" class="lazyload" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" 
												 data-src="{{target_article.image.src | img_url}}" alt="{{target_article.title}}"/>
										</div>
									</div>
									<div class="info_store">
										<div class="box_content_kiemd">
											<p class="name_title">{{target_article.title}}</p>
											<div class="kiem_d_content text_title">
												<svg enable-background="new 0 0 512 512" height="512" viewBox="0 0 512 512" width="512" xmlns="http://www.w3.org/2000/svg"><path clip-rule="evenodd" d="m256 0c-141.2 0-256 114.8-256 256s114.8 256 256 256 256-114.8 256-256-114.8-256-256-256z" fill="#4bae4f" fill-rule="evenodd"/><path d="m206.7 373.1c-32.7-32.7-65.2-65.7-98-98.4-3.6-3.6-3.6-9.6 0-13.2l37.7-37.7c3.6-3.6 9.6-3.6 13.2 0l53.9 53.9 138.6-138.7c3.7-3.6 9.6-3.6 13.3 0l37.8 37.8c3.7 3.7 3.7 9.6 0 13.2l-183.3 183.1c-3.6 3.7-9.5 3.7-13.2 0z" fill="#fff"/></svg> 
												{{settings.kiem_duyet_title}}
											</div>
										</div>
										<div class="content_kiemd">
											<div class="mb-0">{{ target_article.summary }}</div>
											<a class="text-body2" href="{{target_article.url}}" title="Xem thêm thông tin">Xem thêm thông tin <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="#fff" d="M342.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L274.7 256 105.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"></path></svg></a>
										</div>
									</div>
								</div>
							</div>
							{% else %}
							<div class="box_kiem_duyet">
								<div class="item_store">
									<div class="item_image_store">
										<div class="image">
											<img width="100" height="100" class="lazyload" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC"  data-src="{{'img_kiemd_icon.jpg' | asset_url }}" alt="{{settings.kiem_duyet_name}}"/>
										</div>
									</div>
									<div class="info_store">
										<div class="box_content_kiemd">
											<p class="name_title">{{settings.kiem_duyet_name}}</p>
											<div class="kiem_d_content text_title">
												<svg enable-background="new 0 0 512 512" height="512" viewBox="0 0 512 512" width="512" xmlns="http://www.w3.org/2000/svg"><path clip-rule="evenodd" d="m256 0c-141.2 0-256 114.8-256 256s114.8 256 256 256 256-114.8 256-256-114.8-256-256-256z" fill="#4bae4f" fill-rule="evenodd"/><path d="m206.7 373.1c-32.7-32.7-65.2-65.7-98-98.4-3.6-3.6-3.6-9.6 0-13.2l37.7-37.7c3.6-3.6 9.6-3.6 13.2 0l53.9 53.9 138.6-138.7c3.7-3.6 9.6-3.6 13.3 0l37.8 37.8c3.7 3.7 3.7 9.6 0 13.2l-183.3 183.1c-3.6 3.7-9.5 3.7-13.2 0z" fill="#fff"/></svg> 
												{{settings.kiem_duyet_title}}
											</div>
										</div>
										<div class="content_kiemd">
											<div class="mb-0">{{settings.kiem_duyet_content}}</div>
										</div>
									</div>
								</div>
							</div>
							{% endif %}
							{% endif %}
							{% if article.tags.size > 0 and settings.article_tags_enable %}
							{%- assign valid_tags = "" -%}
							{%- for tag in article.tags -%}
							{%- unless tag contains 'duocsi_' or tag contains 'video' -%}
							{%- assign valid_tags = valid_tags | append: tag | append: "||" -%}
							{%- endunless -%}
							{%- endfor -%}

							{%- assign valid_tags_array = valid_tags | split: "||" -%}

							{%- assign final_tags_array = "" -%}
							{%- for tag in valid_tags_array -%}
							{%- if tag != "" -%}
							{%- assign final_tags_array = final_tags_array | append: tag | append: "|" -%}
							{%- endif -%}
							{%- endfor -%}
							{%- assign final_tags_array = final_tags_array | split: "|" -%}
							{%- if final_tags_array.size > 0 and final_tags_array[0] != "" -%}
							<div class="box_cate_pro">
								<span>Thẻ:</span> 
								{%- for tag in final_tags_array -%}
								{% assign current_index = forloop.index0  | plus: 3%}
								<a href="/blogs/all/tagged/(({{ tag | replace: ' ', '%20'}}))" title="{{ tag }}">{{ tag }}{% unless forloop.last or current_index > forloop.length %},{% endunless %}</a>
								{%- endfor -%}
							</div>
							{%- endif -%}
							{%endif%}
							{%if settings.article_social_enable%}
							<div class="social-sharing">
								<ul class="social-media" role="list">
									<li class="title">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share" viewBox="0 0 16 16">
											<path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
										</svg>
										Chia sẻ
									</li>
									<li class="social-media__item social-media__item--facebook">
										<a title="Chia sẻ lên Facebook" href="https://www.facebook.com/sharer.php?u=https://{{store.domain}}{{article.url}}" target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook" >
											<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
												 viewBox="0 0 155.139 155.139" style="enable-background:new 0 0 155.139 155.139;" xml:space="preserve">
												<g>
													<path id="f_1_" style="fill:#010002;" d="M89.584,155.139V84.378h23.742l3.562-27.585H89.584V39.184
																							 c0-7.984,2.208-13.425,13.67-13.425l14.595-0.006V1.08C115.325,0.752,106.661,0,96.577,0C75.52,0,61.104,12.853,61.104,36.452
																							 v20.341H37.29v27.585h23.814v70.761H89.584z"/>
												</g>
											</svg>
										</a>
									</li>
									<li class="social-media__item social-media__item--pinterest">
										<a title="Chia sẻ lên Pinterest" href="https://pinterest.com/pin/create/button/?url=https://{{store.domain}}{{article.url}}&amp;" target="_blank" rel="noopener" aria-label="Pinterest" >
											<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
												 viewBox="0 0 511.977 511.977" style="enable-background:new 0 0 511.977 511.977;" xml:space="preserve">
												<g>
													<g>
														<path d="M262.948,0C122.628,0,48.004,89.92,48.004,187.968c0,45.472,25.408,102.176,66.08,120.16
																 c6.176,2.784,9.536,1.6,10.912-4.128c1.216-4.352,6.56-25.312,9.152-35.2c0.8-3.168,0.384-5.92-2.176-8.896
																 c-13.504-15.616-24.224-44.064-24.224-70.752c0-68.384,54.368-134.784,146.88-134.784c80,0,135.968,51.968,135.968,126.304
																 c0,84-44.448,142.112-102.208,142.112c-31.968,0-55.776-25.088-48.224-56.128c9.12-36.96,27.008-76.704,27.008-103.36
																 c0-23.904-13.504-43.68-41.088-43.68c-32.544,0-58.944,32.224-58.944,75.488c0,27.488,9.728,46.048,9.728,46.048
																 S144.676,371.2,138.692,395.488c-10.112,41.12,1.376,107.712,2.368,113.44c0.608,3.168,4.16,4.16,6.144,1.568
																 c3.168-4.16,42.08-59.68,52.992-99.808c3.968-14.624,20.256-73.92,20.256-73.92c10.72,19.36,41.664,35.584,74.624,35.584
																 c98.048,0,168.896-86.176,168.896-193.12C463.62,76.704,375.876,0,262.948,0z"/>
													</g>
												</g>
											</svg>
										</a>
									</li>
									<li class="social-media__item social-media__item--twitter">
										<a title="Chia sẻ lên Twitter" href="https://twitter.com/share?url=https://{{store.domain}}{{article.url}}" target="_blank" rel="noopener" aria-label="Tweet on Twitter" >
											<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
												 viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve">
												<g>
													<g>
														<path d="M512,97.248c-19.04,8.352-39.328,13.888-60.48,16.576c21.76-12.992,38.368-33.408,46.176-58.016
																 c-20.288,12.096-42.688,20.64-66.56,25.408C411.872,60.704,384.416,48,354.464,48c-58.112,0-104.896,47.168-104.896,104.992
																 c0,8.32,0.704,16.32,2.432,23.936c-87.264-4.256-164.48-46.08-216.352-109.792c-9.056,15.712-14.368,33.696-14.368,53.056
																 c0,36.352,18.72,68.576,46.624,87.232c-16.864-0.32-33.408-5.216-47.424-12.928c0,0.32,0,0.736,0,1.152
																 c0,51.008,36.384,93.376,84.096,103.136c-8.544,2.336-17.856,3.456-27.52,3.456c-6.72,0-13.504-0.384-19.872-1.792
																 c13.6,41.568,52.192,72.128,98.08,73.12c-35.712,27.936-81.056,44.768-130.144,44.768c-8.608,0-16.864-0.384-25.12-1.44
																 C46.496,446.88,101.6,464,161.024,464c193.152,0,298.752-160,298.752-298.688c0-4.64-0.16-9.12-0.384-13.568
																 C480.224,136.96,497.728,118.496,512,97.248z"/>
													</g>
												</g>
											</svg>
										</a>
									</li>
								</ul>
							</div>
							{%endif%}
							{% if blog.comments_enabled %}
							<form method="post" action="{{ article.url }}#article_comments" id="article_comments" accept-charset="UTF-8">
							<div class="form-coment">
								<div class="margin-top-0 w-100">
									<h5 class="title-form-coment">Viết bình luận của bạn</h5>
								</div>
								{% if comment and comment.created_on %}
								<p class="alert alert-success">
									{% if blog.moderated %} 
									Bạn đã đăng bình luận thành công. Chúng tôi sẽ đăng bình luận của bạn sau khi được kiểm duyệt. 
									{% else %} 
									Bạn đã đăng bình luận thành công. Xin cảm ơn! 
									{% endif %}
								</p>
								{% endif %}
								<div class="row">
									<div class="col-md-6 col-12">
										<fieldset class="form-group padding-0">
											<input placeholder="Họ và tên" type="text" class="form-control form-control-lg" value="{{ customer.name }}" id="full-name" name="comment[author]" Required>
										</fieldset>
									</div>
									<div class="col-md-6 col-12">
										<fieldset class="form-group padding-0">	
											<input placeholder="Email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" type="email" class="form-control form-control-lg" value="{{ customer.email }}" name="comment[email]" Required>
										</fieldset>
									</div>
									<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
										<textarea placeholder="Nội dung" class="form-control form-control-lg" id="comment" name="comment[body]" rows="6" Required></textarea>
									</div>
									{%- comment -%}
									  REOPEN 2026-09-10 (ADR-007/T-74) — CMP-08 Clinical Comments: form SĐT bảo mật +
									  self-declare "đã điều trị". LƯU Ý: 2 field này gửi kèm request nhưng hệ thống
									  bình luận Sapo (blog.comments) không có schema tuỳ biến để lưu/hiển thị lại 2
									  field này — KHÔNG hiển thị badge "✓ Đã xác thực" tự động cho từng bình luận vì
									  không có cách xác minh thật (Zero Hallucination). Niềm tin thực tế đến từ kiểm
									  duyệt thủ công của Chuyên gia (blog.moderated, đã có sẵn).
									{%- endcomment -%}
									<div class="col-md-6 col-12">
										<fieldset class="form-group padding-0">
											<input placeholder="Số điện thoại (bảo mật, không hiển thị công khai)" type="tel" pattern="0[0-9]{8,9}" class="form-control form-control-lg" name="comment[phone]">
										</fieldset>
									</div>
									<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
										<label class="d-flex align-items-center gap-2" style="font-size:13px;color:var(--color-text-body,#334155);">
											<input type="checkbox" name="comment[treated]" value="1">
											Tôi đã sử dụng/điều trị theo sản phẩm hoặc phác đồ được nhắc đến trong bài viết
										</label>
									</div>
									<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
										<button type="submit" class="btn btn-primary button_45">Gửi thông tin</button>
									</div>
								</div>
							</div>
							</form>
							{% if article.comments_count > 0 %}
							{% paginate article.comments by 5%} 
							<div class="article-comment-list">
								<h5 class="title-form-coment">Bình luận ({{ article.comments_count }})</h5>
								{% for comment in article.comments %}							
								<div class="article-comment">
									<figure class="article-comment-user-image">
										<img src="https://www.gravatar.com/avatar/{{ comment.email | remove: ' ' | strip_newlines | downcase | md5 }}?s=110&d=identicon" alt="binh-luan" class="block">
									</figure>

									<div class="article-comment-user-comment">
										<p class="user-name-comment"><strong>{{ comment.author }}</strong>
											<a href="#article_comments" class="btn-link pull-xs-right d-none">Trả lời</a></p>
										<span class="article-comment-date-bull">{{ comment.created_on | date:'dd/MM/yyyy' }}</span>
										<p class="cm">{{ comment.content }}</p>

									</div>
								</div> 
								{% endfor %}   
							</div>
							<div class="text-center article_page section paginate_center">
								{% if paginate.pages > 1 %}
								{% include 'paginate-pages' %}
								{% endif %}
							</div>
							{%endpaginate%}
							{% endif %}
							{% endif %}
						</div>
						</div>
						{%if settings.blog_lq_enable%}
						<div class="blog_related">
							<div class="title">{{settings.title_blog_relate}}</div>
							{% assign blog_count_lq = blog.articles.size %}
							{%if settings.limit_blog_relate > 0 and blog_count_lq > 1 %}
							<div class="blog-swiper swiper-container">
								<div class="swiper-wrapper">
									{%- assign checkRelated = page_title | handleize -%}

									{%- assign isCurrentInList = false -%}
									{%- for article in blog.articles limit: settings.limit_blog_relate -%}
									{%- assign linkRelated = article.url | remove: "/" -%}
									{%- if checkRelated == linkRelated -%}
									{%- assign isCurrentInList = true -%}
									{%- break -%}
									{%- endif -%}
									{%- endfor -%}

									{%- assign limit_count = settings.limit_blog_relate | plus: 0 -%}
									{%- if isCurrentInList -%}
									{%- assign limit_count = limit_count | plus: 1 -%}
									{%- endif -%}

									{%- for article in blog.articles limit: limit_count -%}
									{%- assign checkRelated = page_title | handleize -%}
									{%- assign linkRelated = article.url | remove: "/" -%}
									{%- if checkRelated != linkRelated -%}
									<div class="swiper-slide">
										{% include 'blog_item' %}
									</div>
									{%- endif -%}
									{%- endfor -%}
								</div> 
								<div class="swiper-button-prev">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
								<div class="swiper-button-next">
									<svg width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M18.5 29H39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M29 18.5L39.5 29L29 39.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
							</div>
							{%else%}
							<div class="alert alert-success alert-dismissible fade show" role="alert">
								Danh mục bài viết đang cập nhật.	
							</div>	
							{% endif %}
						</div>
						{% endif %}
					</div>
					{%if settings.right_asideblog_enable%}
					<div class="blog_left_base col-lg-3 col-12">
						{%- comment -%}
						  REOPEN 2026-09-10 (ADR-007/T-74) — CMP-05 Sticky Prescription Widget: sản phẩm
						  khuyên dùng theo bài viết, tái dùng collections[settings.product_related_collection]
						  (đã có sẵn ở templates/product.bwt) thay vì tạo setting mới.
						{%- endcomment -%}
						{%- assign pw_col = collections[settings.product_related_collection] -%}
						{%if pw_col.products_count > 0%}
						<div class="pc-cmp-prescription-widget mb-4">
							<div class="pc-cmp-prescription-widget__title">Sản phẩm khuyên dùng theo phác đồ</div>
							{%for product in pw_col.products limit: 3%}
							<a href="{{ product.url }}" class="pc-cmp-prescription-widget__item no-underline">
								<img src="{{ product.featured_image.src | default: 'no-image.jpg' | img_url: '100x100' }}" alt="{{ product.title }}" loading="lazy">
								<div class="min-w-0">
									<div class="pc-cmp-prescription-widget__item-name truncate">{{ product.title }}</div>
									<div class="pc-cmp-prescription-widget__item-price">{{ product.price | money }}</div>
								</div>
							</a>
							{%endfor%}
						</div>
						{%endif%}
						{%include 'aside-blog'%}
					</div>
					{% endif %}
				</div>
			</article>
		</div>
	</div>
	{%if mucluc == true%} 
	<div class="setmenuclick auto hidescroll">
		<span class="tabClick" style="opacity: 0.996141;">
			<img width="150" height="150" src="{{'list-scroll.svg' | asset_url}}" alt="Mục lục">
		</span> 
		<div class="fixMenu hidescroll"> 
			<div class="closeftoc">
				<img width="150" height="150" src="{{'list-scroll.svg' | asset_url}}" alt="Mục lục">Nội dung bài viết<span>x</span>
			</div>
			<div class="bean-toc-bottom"></div>
		</div> 
		<div class="bg"></div> 
	</div>
	{%endif%}
</section>
{%if mucluc == true%}
<script>

	var $heading2 = $('.article-content-main h2');
	$heading2.attr("id", function() {
		return $(this)
			.text() // get the h1 text
			.trim() // remove spaces from start and the end
			.toLowerCase() // optional
			.replace(/\s/g, '_'); // convert all spaces to underscores
	});
	var $heading3 = $('.article-content-main h3');
	$heading3.attr("id", function() {
		return $(this)
			.text() // get the h1 text
			.trim() // remove spaces from start and the end
			.toLowerCase() // optional
			.replace(/\s/g, '_'); // convert all spaces to underscores
	});

	$('.title-goto-wrapper').click(function() {
		$(this).find('.fa').toggleClass('fa-angle-up'); 
		$(this).find('.fa').toggleClass('fa-angle-down'); 
		$('.menu-toc').toggleClass('hidden');
	});
	$(document).ready(function (){
		$('.setmenuclick.auto .tabClick').click(function() {
			$(this).addClass('hidescroll'); 
			$('.fixMenu').removeClass('hidescroll');
		});
		$('.fixMenu .closeftoc span').click( function(event) {
			event.stopPropagation();
			$('.setmenuclick.auto .tabClick').removeClass('hidescroll');
			$('.fixMenu').addClass('hidescroll');
		});
		$(document).click( function(event){
			if ( !$(event.target).closest('.setmenuclick.auto').length ) {
				$('.setmenuclick.auto .tabClick').removeClass('hidescroll');
				$('.setmenuclick.auto .fixMenu').addClass('hidescroll');
			}
		});

		$(window).scroll(function() {
			var khoan_cach_all = $('.product-content').height();
			if ($(this).scrollTop() > 500 && $(this).scrollTop() < khoan_cach_all ){  
				$('.setmenuclick').removeClass('hidescroll');
			}
			else{
				$('.setmenuclick').addClass('hidescroll');
			}
		});
	});
</script>
{{ 'https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.4.2/tocbot.min.js' | script_tag }}
<script>
	$(document).ready(function ($) {
		tocbot.init({
			tocSelector: '.menu-toc',
			contentSelector: '.article-content-main',
			headingSelector: 'h2,h3',
		});
		tocbot.init({
			tocSelector: '.bean-toc-bottom',
			contentSelector: '.article-content-main',
			headingSelector: 'h2,h3'
		});
		{%- comment -%} REOPEN 2026-09-10 (ADR-007/T-74) — CMP-02: TOC sticky desktop, dùng chung tocbot đã load ở trên {%- endcomment -%}
		tocbot.init({
			tocSelector: '.pc-cmp-toc-list',
			contentSelector: '.article-content-main',
			headingSelector: 'h2,h3',
			scrollSmooth: true
		});
	});
</script>
{%endif%}
<script>
	var swiperwish = new Swiper('.blog-swiper', {
		slidesPerView: 1,
		loop: false,
		grabCursor: true,
		spaceBetween: 20,
		roundLengths: true,
		slideToClickedSlide: false,
		navigation: {
			nextEl: '.blog-swiper .swiper-button-next',
			prevEl: '.blog-swiper .swiper-button-prev',
		},
		autoplay: false,
		breakpoints: {
			200: {
				slidesPerView: 1,
				spaceBetween: 15
			},
			768: {
				slidesPerView: 2,
				spaceBetween: 20
			},
			992: {
				slidesPerView: 2,
				spaceBetween: 20
			},
			1024: {
				slidesPerView: 3,
				spaceBetween: 20
			},
			1200: {
				slidesPerView: 3,
				spaceBetween: 20
			},
			1500: {
				slidesPerView: 3,
				spaceBetween: 20
			}
		}
	});
	$(document).ready(function () {
		$('.lc-option-box-size .cursor-pointer').click(function () {
			$('.lc-option-box-size .cursor-pointer').removeClass('active');
			$(this).addClass('active');
			const selectedText = $(this).text().trim();
			if (selectedText === 'Lớn hơn') {
				$('.article-content-main').addClass('font-large');
			} else {
				$('.article-content-main').removeClass('font-large');
			}
		});
	});
</script>
