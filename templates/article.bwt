{% layout 'theme' %}
{% include 'breadcrumb' %}

{%- comment -%} Xử lý thứ ngày giờ VN {%- endcomment -%}
{%- assign pc_art_wd = article.published_on | date: '%a' -%}
{%- case pc_art_wd -%}
{%- when 'Mon' -%}{%- assign pc_art_wd = 'Thứ Hai, ' -%}
{%- when 'Tue' -%}{%- assign pc_art_wd = 'Thứ Ba, ' -%}
{%- when 'Wed' -%}{%- assign pc_art_wd = 'Thứ Tư, ' -%}
{%- when 'Thu' -%}{%- assign pc_art_wd = 'Thứ Năm, ' -%}
{%- when 'Fri' -%}{%- assign pc_art_wd = 'Thứ Sáu, ' -%}
{%- when 'Sat' -%}{%- assign pc_art_wd = 'Thứ Bảy, ' -%}
{%- when 'Sun' -%}{%- assign pc_art_wd = 'Chủ Nhật, ' -%}
{%- else -%}{%- assign pc_art_wd = '' -%}
{%- endcase -%}

{%- comment -%} Hạ h1 trong thân bài xuống h2 để đảm bảo duy nhất 1 h1 {%- endcomment -%}
{%- assign pc_art_c = article.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' -%}

<div class="bg-white py-6 lg:py-10 font-sans text-ink">
  <div class="container">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start w-full">

      <!-- 1. LEFT TOOLBAR (Desktop only: 10 nút chức năng chuẩn) -->
      <aside class="hidden lg:!flex flex-col gap-2.5 sticky top-24 w-11 select-none shrink-0" aria-label="Thanh công cụ bài viết">
        <!-- 1. + Zoom in -->
        <button type="button" id="btn-zoom-in" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Tăng cỡ chữ" aria-label="Tăng cỡ chữ">
          <span class="text-base font-bold leading-none select-none" aria-hidden="true">+</span>
        </button>
        <!-- 2. Aa Reset -->
        <button type="button" id="btn-zoom-reset" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-xs font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Cỡ chữ mặc định" aria-label="Cỡ chữ mặc định">
          Aa
        </button>
        <!-- 3. - Zoom out -->
        <button type="button" id="btn-zoom-out" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-sm font-semibold hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Giảm cỡ chữ" aria-label="Giảm cỡ chữ">
          <span class="text-base font-bold leading-none select-none" aria-hidden="true">−</span>
        </button>
        <!-- 4. Heart / Like -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-red-500 transition-colors cursor-pointer" title="Thích bài viết" aria-label="Thích bài viết" data-article-like>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'heart', size: 14 %}</i>
        </button>
        <!-- 5. Eye / Views -->
        <div class="relative w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center select-none" title="Lượt xem" aria-label="Lượt xem">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'eye', size: 14 %}</i>
          <span class="absolute -top-1 -right-1 bg-sky-600 text-white text-[9px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center">0</span>
        </div>
        <!-- 6. Bookmark / Save -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Lưu bài viết" aria-label="Lưu bài viết" data-article-save>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'bookmark', size: 14 %}</i>
        </button>
        <!-- 7. Share -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Chia sẻ bài viết" aria-label="Chia sẻ bài viết" data-article-share>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'share', size: 14 %}</i>
        </button>
        <!-- 8. Comment bubble -->
        <a href="#article_comments_section" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-primary transition-colors no-underline cursor-pointer" title="Bình luận" aria-label="Bình luận">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 14 %}</i>
        </a>
        <!-- 9. Copy Link -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Sao chép liên kết" aria-label="Sao chép liên kết" data-article-copy>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'link', size: 14 %}</i>
        </button>
        <!-- 10. Print -->
        <button type="button" onclick="window.print()" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-primary hover:text-primary transition-colors cursor-pointer" title="In bài viết" aria-label="In bài viết">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'file-text', size: 14 %}</i>
        </button>
      </aside>

      <!-- 2. MAIN ARTICLE COLUMN (Nội dung bài viết + Form Bình luận) -->
      <main class="w-full min-w-0 flex-1">
        <!-- Tiêu đề bài viết (Màu xanh đậm theo thiết kế) -->
        <h1 class="m-0 text-xl sm:text-2xl lg:text-[28px] font-bold font-heading text-brand-deep leading-snug tracking-tight">
          {{ article.title }}
        </h1>

        <!-- Dòng Tác giả & Thời gian xuất bản với icon bút viết -->
        <div class="mt-4 mb-6 flex items-center gap-3 text-xs text-ink-muted">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 shrink-0">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'square-pen', size: 16 %}</i>
          </span>
          <div class="flex flex-col">
            <strong class="text-xs font-bold text-slate-800">{{ article.author | default: 'Đội ngũ biên tập Pharma Cosmetics' }}</strong>
            <time class="text-[11px] text-slate-500" datetime="{{ article.published_on | date: '%Y-%m-%dT%H:%M:%S' }}">
              {{ pc_art_wd }}{{ article.published_on | date: 'dd/MM/yyyy HH:mm' }} (GMT +7)
            </time>
          </div>
        </div>

        <!-- Tóm tắt bài viết / Đoạn dẫn (in đậm) -->
        {%- if article.summary != blank -%}
        <div class="mb-5 text-sm sm:text-base font-bold leading-relaxed text-slate-800">
          {{ article.summary | strip_html }}
        </div>
        {%- endif -%}

        <!-- Thân bài viết -->
        <div class="article-content-body text-sm sm:text-base leading-relaxed text-slate-700 space-y-4" id="article-body">
          {%- if article.content.size > 0 -%}
            {% include 'shortcode' load: pc_art_c %}
          {%- else -%}
            <p>Nội dung bài viết đang được cập nhật.</p>
          {%- endif -%}
        </div>

        <!-- Nguồn bài viết -->
        <div class="mt-8 flex items-center gap-1.5 text-xs text-ink-muted">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'link', size: 14 %}</i>
          <span>Nguồn: <strong>{{ settings.store_name | default: store.name | default: 'Pharma Cosmetics' }}</strong></span>
        </div>

        <!-- Từ khoá tags -->
        {%- if article.tags.size > 0 -%}
        {%- capture pc_tags_rendered -%}
          {%- assign tag_count = 0 -%}
          {%- for raw_tag in article.tags -%}
            {%- assign trimmed_tag = raw_tag | strip -%}
            {%- unless trimmed_tag contains ':' or trimmed_tag contains 'duocsi_' or trimmed_tag contains 'video' or trimmed_tag contains 'noibat' -%}
              {%- comment -%} Kiểm tra nếu 1 tag bị nhập dính nhiều hashtag dạng #Tag1 #Tag2 {%- endcomment -%}
              {%- if trimmed_tag contains '#' and trimmed_tag contains ' ' -%}
                {%- assign sub_tags = trimmed_tag | split: ' ' -%}
                {%- for st in sub_tags -%}
                  {%- assign clean_st = st | replace: '#', '' | strip -%}
                  {%- if clean_st != blank and tag_count < 5 -%}
                    {%- assign tag_count = tag_count | plus: 1 -%}
                    <a class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700 hover:bg-primary hover:text-white transition-colors no-underline" href="/search?query=tags:(({{ clean_st | replace: ' ', '%20' }}))&type=article">#{{ clean_st }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign clean_tag = trimmed_tag | replace: '#', '' | strip -%}
                {%- if clean_tag != blank and tag_count < 5 -%}
                  {%- assign tag_count = tag_count | plus: 1 -%}
                  <a class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700 hover:bg-primary hover:text-white transition-colors no-underline" href="/search?query=tags:(({{ clean_tag | replace: ' ', '%20' }}))&type=article">#{{ clean_tag }}</a>
                {%- endif -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign pc_tags_trimmed = pc_tags_rendered | strip -%}
        {%- if pc_tags_trimmed != blank -%}
        <div class="mt-4 flex items-center gap-3 rounded-lg border border-line-soft bg-surface-soft p-3">
          <div class="flex items-center gap-1 text-xs font-bold text-brand-deep shrink-0">
            <span class="font-bold">#</span>
            <span>Từ khoá:</span>
          </div>
          <div class="flex flex-wrap gap-2 text-xs">
            {{ pc_tags_rendered }}
          </div>
        </div>
        {%- endif -%}
        {%- endif -%}

        <!-- Thanh tác vụ ngang Mobile (ẩn trên desktop, căn góc phải) -->
        <div class="my-6 flex lg:hidden items-center justify-end gap-2.5 rounded-xl border border-line-soft bg-white p-2.5 shadow-sm">
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Chia sẻ" aria-label="Chia sẻ bài viết" data-article-share>
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'share', size: 16 %}</i>
          </button>
          <a href="#article_comments_section" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-colors no-underline cursor-pointer" title="Bình luận" aria-label="Bình luận bài viết">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 16 %}</i>
          </a>
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-colors cursor-pointer" title="Sao chép liên kết" aria-label="Sao chép liên kết" data-article-copy>
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'link', size: 16 %}</i>
          </button>
          <button type="button" onclick="window.print()" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-colors cursor-pointer" title="In bài viết" aria-label="In bài viết">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'file-text', size: 16 %}</i>
          </button>
        </div>

        <!-- KHỐI BÌNH LUẬN & HỎI ĐÁP CHUẨN THIẾT KẾ (LUÔN HIỂN THỊ) -->
        <div class="mt-10 rounded-xl border border-line-soft bg-white p-5 sm:p-6" id="article_comments_section">
          <div class="mb-4">
            <h3 class="m-0 text-sm sm:text-base font-bold uppercase tracking-wider text-slate-800">
              HỎI ĐÁP &amp; BÌNH LUẬN VỀ BÀI VIẾT
            </h3>
            <p class="m-0 mt-1 text-xs text-slate-500">
              Đặt câu hỏi hoặc chia sẻ cảm nhận của bạn để chuyên gia và cộng đồng cùng thảo luận.
            </p>
          </div>

          <form method="post" action="{{ article.url }}#article_comments" id="article_comments" accept-charset="UTF-8">
            <div class="space-y-3.5">
              <!-- Trường Nội dung bình luận -->
              <div>
                <label for="comment-body" class="block mb-1.5 text-xs font-semibold text-slate-700">
                  Nội dung câu hỏi hoặc bình luận của bạn <span class="text-rose-500">*</span>
                </label>
                <textarea id="comment-body" name="comment[body]" rows="3" placeholder="Bạn có thắc mắc về tình trạng da, cách dùng hoạt chất hay nội dung bài viết? Đặt câu hỏi để đội ngũ Dược sĩ / Chuyên gia phản hồi..." class="w-full rounded-lg border border-slate-300 bg-white p-3 text-sm text-slate-800 placeholder-slate-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all resize-y min-h-[88px]" required></textarea>
              </div>

              <!-- Cụm trường Họ tên & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="comment-extra-fields">
                <div>
                  <label for="comment-author" class="block mb-1 text-xs font-semibold text-slate-700">
                    Họ và tên <span class="text-rose-500">*</span>
                  </label>
                  <input id="comment-author" placeholder="Ví dụ: Nguyễn Văn A" type="text" autocomplete="name" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-colors" value="{{ customer.name }}" name="comment[author]" required>
                </div>
                <div>
                  <label for="comment-email" class="block mb-1 text-xs font-semibold text-slate-700">
                    Email (được bảo mật) <span class="text-rose-500">*</span>
                  </label>
                  <input id="comment-email" placeholder="Ví dụ: email@domain.com" type="email" autocomplete="email" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-colors" value="{{ customer.email }}" name="comment[email]" required>
                </div>
              </div>

              <!-- Dòng ghi chú kiểm duyệt & Nút Gửi màu thương hiệu #3CB371 -->
              <div class="pt-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <p class="m-0 text-xs text-slate-500 italic">
                  Bình luận sẽ được kiểm duyệt trước khi hiển thị nhằm đảm bảo thông tin chuyên môn chính xác và văn minh.
                </p>
                <button type="submit" class="inline-flex min-h-[40px] items-center justify-center gap-2 rounded-lg bg-btn px-6 text-xs font-bold text-white transition-colors hover:bg-btn-hover cursor-pointer border-0 shrink-0">
                  <span>Gửi bình luận</span>
                  <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'paper-plane', size: 14 %}</i>
                </button>
              </div>
            </div>
          </form>

          <!-- Bộ đếm bình luận -->
          <div class="mt-6 border-b border-line-soft pb-2">
            <span class="text-xs font-bold text-slate-700">Tất cả ({{ article.comments_count | default: 0 }})</span>
          </div>

          <!-- Danh sách bình luận hoặc thông báo trống -->
          {% if article.comments_count > 0 %}
            <div class="mt-4 space-y-4">
              {% for comment in article.comments %}
              <div class="flex gap-3 text-xs border-b border-line-soft pb-3">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold shrink-0">
                  {{ comment.author | upcase | slice: 0, 1 }}
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <strong class="font-bold text-slate-800">{{ comment.author }}</strong>
                    <span class="text-[10px] text-slate-400">{{ comment.created_on | date: 'dd/MM/yyyy' }}</span>
                  </div>
                  <p class="mt-1 text-slate-600 leading-relaxed">{{ comment.content }}</p>
                </div>
              </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="py-8 text-center text-xs text-ink-muted">
              Chưa có bình luận nào. Hãy là người đầu tiên bình luận!
            </p>
          {% endif %}
        </div>
      </main>

      <!-- 3. SIDEBAR CỘT DỌC (Desktop col-4 / w-[360px] bên cạnh bài viết; Mobile tự động rớt xuống dưới) -->
      <aside class="w-full lg:w-[360px] lg:shrink-0 flex flex-col gap-6 lg:sticky lg:top-24 self-start" aria-label="Thông tin liên quan và chủ đề">
        
        <!-- KHỐI CHỦ ĐỀ (ẨN HOÀN TOÀN NẾU RỖNG) -->
        {%- capture pc_topics_html -%}
          {%- assign pc_topic_handles = 'tin-tuc-va-kien-thuc,bi-quyet,video,truoc-va-sau,hoat-chat,chuyen-gia' | split: ',' -%}
          {%- for th in pc_topic_handles -%}
            {%- assign tb = blogs[th] -%}
            {%- if tb and tb.title != blank and tb.articles_count > 0 -%}
            <a href="{{ tb.url }}" class="rounded bg-brand-deep px-2.5 py-1 text-xs font-semibold text-white no-underline transition-colors hover:bg-primary">
              {{ tb.title }}
            </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign pc_topics_trimmed = pc_topics_html | strip -%}
        {%- if pc_topics_trimmed != blank -%}
        <div class="rounded-xl border border-line-soft bg-white p-5 shadow-sm">
          <h3 class="m-0 mb-4 border-b border-line-soft pb-2 text-xs font-bold uppercase tracking-wider text-slate-800">
            CHỦ ĐỀ
          </h3>
          <div class="flex flex-wrap gap-2">
            {{ pc_topics_html }}
          </div>
        </div>
        {%- endif -%}

        <!-- KHỐI TIN LIÊN QUAN -->
        <div class="rounded-xl border border-solid border-line-soft bg-white p-5 shadow-sm">
          <div class="flex items-center justify-between border-0 border-b border-solid border-line-soft pb-3 mb-4">
            <h3 class="m-0 text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-deep flex items-center gap-2">
              <i class="text-primary leading-none" aria-hidden="true">{% include 'ui_icon', name: 'newspaper', size: 16 %}</i>
              <span>TIN LIÊN QUAN</span>
            </h3>
            <a href="{{ blog.url }}" class="text-xs font-semibold text-primary hover:underline no-underline flex items-center gap-0.5">
              <span>Xem tất cả</span>
              <i class="leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 12 %}</i>
            </a>
          </div>

          <div class="space-y-3.5">
            {%- assign cur_url = article.url -%}
            {%- assign rel_shown = 0 -%}
            {%- for rel_a in blog.articles -%}
              {%- if rel_a.url != cur_url and rel_shown < 4 -%}
              {%- assign rel_shown = rel_shown | plus: 1 -%}
              <article class="flex gap-3 items-center border-0 border-b border-solid border-line-soft pb-3 last:border-b-0 last:pb-0">
                {%- if rel_a.image.src != blank -%}
                <a href="{{ rel_a.url }}" class="shrink-0 w-20 h-16 rounded-lg overflow-hidden bg-slate-100 block border border-solid border-line-soft">
                  <img src="{{ rel_a.image.src | img_url: 'medium' }}" alt="{{ rel_a.title | escape }}" width="80" height="64" loading="lazy" class="w-full h-full object-cover transition-transform hover:scale-105 duration-300">
                </a>
                {%- endif -%}
                <div class="flex-1 min-w-0">
                  <h4 class="m-0 text-xs sm:text-sm font-bold leading-snug">
                    <a href="{{ rel_a.url }}" class="text-slate-800 hover:text-primary transition-colors no-underline line-clamp-2" title="{{ rel_a.title | escape }}">
                      {{ rel_a.title }}
                    </a>
                  </h4>
                  <div class="mt-1 flex items-center gap-2 text-[11px] text-slate-400">
                    <time datetime="{{ rel_a.published_on | date: '%Y-%m-%dT%H:%M:%S' }}">
                      {{ rel_a.published_on | date: 'dd/MM/yyyy' }}
                    </time>
                    <span>•</span>
                    <span class="text-slate-500 font-medium truncate">{{ rel_a.author | default: 'Pharma Cosmetics' }}</span>
                  </div>
                </div>
              </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- KHỐI SẢN PHẨM LIÊN QUAN -->
        <div class="rounded-xl border border-solid border-line-soft bg-white p-5 shadow-sm">
          <div class="flex items-center justify-between border-0 border-b border-solid border-line-soft pb-3 mb-4">
            <h3 class="m-0 text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-deep flex items-center gap-2">
              <i class="text-primary leading-none" aria-hidden="true">{% include 'ui_icon', name: 'shopping-bag', size: 16 %}</i>
              <span>SẢN PHẨM LIÊN QUAN</span>
            </h3>
            {%- assign _p_col = collections[settings.product_related_collection] | default: collections['all'] -%}
            {%- if _p_col and _p_col.url -%}
            <a href="{{ _p_col.url }}" class="text-xs font-semibold text-primary hover:underline no-underline flex items-center gap-0.5">
              <span>Xem tất cả</span>
              <i class="leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 12 %}</i>
            </a>
            {%- endif -%}
          </div>

          <div class="space-y-3">
            {%- assign rel_prod_col = collections[settings.product_related_collection] -%}
            {%- if rel_prod_col == blank or rel_prod_col.products_count == 0 -%}
              {%- assign rel_prod_col = collections['all'] -%}
            {%- endif -%}
            {%- assign p_shown = 0 -%}
            {%- for p in rel_prod_col.products -%}
              {%- if p_shown < 4 -%}
              {%- assign p_shown = p_shown | plus: 1 -%}
              <div class="flex items-center gap-3 rounded-xl border border-solid border-line-soft p-2 sm:p-2.5 hover:border-primary transition-colors bg-white">
                <a href="{{ p.url }}" class="shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-slate-50 block border border-solid border-line-soft">
                  <img src="{{ p.featured_image | img_url: 'compact' }}" alt="{{ p.title | escape }}" width="64" height="64" loading="lazy" class="w-full h-full object-contain p-1">
                </a>
                <div class="flex-1 min-w-0">
                  {%- if p.vendor != blank -%}
                  <span class="text-[10px] uppercase font-bold text-primary block truncate">{{ p.vendor }}</span>
                  {%- endif -%}
                  <h4 class="m-0 text-xs sm:text-sm font-semibold leading-snug">
                    <a href="{{ p.url }}" class="text-slate-800 hover:text-primary transition-colors no-underline line-clamp-1" title="{{ p.title | escape }}">
                      {{ p.title }}
                    </a>
                  </h4>
                  <div class="mt-1 flex items-center gap-2">
                    <span class="text-xs sm:text-sm font-bold text-primary">{{ p.price | money }}</span>
                    {%- if p.compare_at_price > p.price -%}
                    <span class="text-[11px] text-slate-400 line-through">{{ p.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <a href="{{ p.url }}" class="shrink-0 rounded-lg bg-btn px-3 py-1.5 text-xs font-bold text-white no-underline hover:bg-btn-hover transition-colors" aria-label="Xem sản phẩm {{ p.title | escape }}">
                  Xem
                </a>
              </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

      </aside>

    </div>
  </div>
</div>

<script>
  (function(){
    var body = document.getElementById('article-body');
    if (!body) return;
    var sizes = [14, 16, 18, 20];
    var currentIdx = 1; // 16px default
    function updateSize() {
      body.style.fontSize = sizes[currentIdx] + 'px';
      body.style.lineHeight = '1.75';
    }
    var btnIn = document.getElementById('btn-zoom-in');
    var btnOut = document.getElementById('btn-zoom-out');
    var btnReset = document.getElementById('btn-zoom-reset');
    if (btnIn) btnIn.addEventListener('click', function(){ if (currentIdx < sizes.length - 1) { currentIdx++; updateSize(); } });
    if (btnOut) btnOut.addEventListener('click', function(){ if (currentIdx > 0) { currentIdx--; updateSize(); } });
    if (btnReset) btnReset.addEventListener('click', function(){ currentIdx = 1; updateSize(); });

    // Copy link
    document.querySelectorAll('[data-article-copy]').forEach(function(btn){
      btn.addEventListener('click', function(){
        if (navigator.clipboard) {
          navigator.clipboard.writeText(location.href).then(function(){
            alert('Đã sao chép liên kết bài viết!');
          });
        }
      });
    });

    // 1. Chức năng Chia sẻ bài viết (Web Share API + Fallback)
    document.querySelectorAll('[data-article-share]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var shareData = {
          title: document.title,
          text: document.querySelector('h1') ? document.querySelector('h1').innerText.trim() : document.title,
          url: window.location.href
        };
        if (navigator.share) {
          navigator.share(shareData).catch(function(err){
            if (err.name !== 'AbortError') {
              console.warn('Share error:', err);
            }
          });
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href).then(function(){
            alert('Đã sao chép liên kết bài viết để chia sẻ!');
          });
        } else {
          // Fallback mở chia sẻ Facebook
          var fbUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.href);
          window.open(fbUrl, '_blank', 'noopener,noreferrer,width=600,height=400');
        }
      });
    });

    // 2. Tự động điền (Autofill) & Lưu thông tin bình luận (localStorage)
    var authorInput = document.getElementById('comment-author');
    var emailInput = document.getElementById('comment-email');
    var commentForm = document.getElementById('article_comments');

    try {
      if (authorInput && !authorInput.value) {
        var savedAuthor = localStorage.getItem('pc_comment_author');
        if (savedAuthor) authorInput.value = savedAuthor;
      }
      if (emailInput && !emailInput.value) {
        var savedEmail = localStorage.getItem('pc_comment_email');
        if (savedEmail) emailInput.value = savedEmail;
      }
    } catch(e) {
      console.warn('localStorage access failed:', e);
    }

    if (commentForm) {
      commentForm.addEventListener('submit', function(){
        try {
          if (authorInput && authorInput.value) {
            localStorage.setItem('pc_comment_author', authorInput.value.trim());
          }
          if (emailInput && emailInput.value) {
            localStorage.setItem('pc_comment_email', emailInput.value.trim());
          }
        } catch(e) {
          console.warn('localStorage save failed:', e);
        }
      });
    }

    // 3. Tương tác Thích & Lưu bài viết (Like & Bookmark toggle)
    document.querySelectorAll('[data-article-like]').forEach(function(btn){
      btn.addEventListener('click', function(){
        btn.classList.toggle('text-red-500');
        btn.classList.toggle('border-red-500');
      });
    });
    document.querySelectorAll('[data-article-save]').forEach(function(btn){
      btn.addEventListener('click', function(){
        btn.classList.toggle('text-primary');
        btn.classList.toggle('border-primary');
      });
    });
  })();
</script>
