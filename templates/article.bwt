{% layout 'theme' %}
{% include 'breadcrumb' %}

{%- comment -%} Xử lý thứ ngày giờ VN {%- endcomment -%}
{%- assign pc_art_wd = article.published_on | date: '%a' -%}
{%- case pc_art_wd -%}
{%- when 'Mon' -%}{%- assign pc_art_wd = 'Thứ Hai, ' -%}
{%- when 'Tue' -%}{%- assign pc_art_wd = 'Thứ Ba, ' -%}
{%- when 'Wed' -%}{%- assign pc_art_wd = 'Thứ Tư, ' -%}
{%- when 'Thu' -%}{%- assign pc_art_wd = 'Thứ Năm, ' -%}
{%- when 'Fri' -%}{%- assign pc_art_wd = 'Thứ Sáu, ' -%}
{%- when 'Sat' -%}{%- assign pc_art_wd = 'Thứ Bảy, ' -%}
{%- when 'Sun' -%}{%- assign pc_art_wd = 'Chủ Nhật, ' -%}
{%- else -%}{%- assign pc_art_wd = '' -%}
{%- endcase -%}

{%- comment -%} Hạ h1 trong thân bài xuống h2 để đảm bảo duy nhất 1 h1 {%- endcomment -%}
{%- assign pc_art_c = article.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' -%}

<div class="bg-white py-6 lg:py-10 font-sans text-ink">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[44px_minmax(0,1fr)_300px] gap-8 xl:gap-12 items-start justify-center">

      <!-- 1. LEFT TOOLBAR (Desktop only: 10 nút chức năng chuẩn báo chí) -->
      <aside class="hidden lg:!flex flex-col gap-2.5 sticky top-24 w-11 select-none lg:col-start-1" aria-label="Thanh công cụ bài viết">
        <!-- 1. + Zoom in -->
        <button type="button" id="btn-zoom-in" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-sm font-semibold hover:border-brand-deep hover:text-brand-deep transition-colors" title="Tăng cỡ chữ" aria-label="Tăng cỡ chữ">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'plus', size: 14 %}</i>
        </button>
        <!-- 2. Aa Reset -->
        <button type="button" id="btn-zoom-reset" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-xs font-semibold hover:border-brand-deep hover:text-brand-deep transition-colors" title="Cỡ chữ mặc định" aria-label="Cỡ chữ mặc định">
          Aa
        </button>
        <!-- 3. - Zoom out -->
        <button type="button" id="btn-zoom-out" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center text-sm font-semibold hover:border-brand-deep hover:text-brand-deep transition-colors" title="Giảm cỡ chữ" aria-label="Giảm cỡ chữ">
          <span class="text-base font-bold leading-none select-none" aria-hidden="true">−</span>
        </button>
        <!-- 4. Heart -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-red-500 transition-colors" title="Thích bài viết" aria-label="Thích bài viết" data-article-like>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'heart', size: 14 %}</i>
        </button>
        <!-- 5. Eye / Views -->
        <div class="relative w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center" title="Lượt xem">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'eye', size: 14 %}</i>
          <span class="absolute -top-1 -right-1 bg-sky-600 text-white text-[9px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center">0</span>
        </div>
        <!-- 6. Bookmark -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-brand-deep transition-colors" title="Lưu bài viết" aria-label="Lưu bài viết" data-article-save>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'bookmark', size: 14 %}</i>
        </button>
        <!-- 7. Share -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-brand-deep transition-colors" title="Chia sẻ bài viết" aria-label="Chia sẻ bài viết" data-article-share>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'share', size: 14 %}</i>
        </button>
        <!-- 8. Comment bubble -->
        <a href="#article_comments_section" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-brand-deep transition-colors no-underline" title="Bình luận" aria-label="Bình luận">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 14 %}</i>
        </a>
        <!-- 9. Copy Link -->
        <button type="button" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-brand-deep transition-colors" title="Sao chép liên kết" aria-label="Sao chép liên kết" data-article-copy>
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'link', size: 14 %}</i>
        </button>
        <!-- 10. Print -->
        <button type="button" onclick="window.print()" class="w-9 h-9 rounded-full border border-slate-300 bg-white text-slate-700 flex items-center justify-center hover:border-brand-deep hover:text-brand-deep transition-colors" title="In bài viết" aria-label="In bài viết">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'file-text', size: 14 %}</i>
        </button>
      </aside>

      <!-- 2. CENTER CONTENT COLUMN (Nội dung bài viết + Form Bình luận) -->
      <main class="w-full min-w-0 lg:col-start-2">
        <!-- Tiêu đề bài viết (Màu xanh đậm theo thiết kế) -->
        <h1 class="m-0 text-xl sm:text-2xl lg:text-[28px] font-bold font-heading text-brand-deep leading-snug tracking-tight">
          {{ article.title }}
        </h1>

        <!-- Dòng Tác giả & Thời gian xuất bản với icon bút viết -->
        <div class="mt-4 mb-6 flex items-center gap-3 text-xs text-ink-muted">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 shrink-0">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'square-pen', size: 16 %}</i>
          </span>
          <div class="flex flex-col">
            <strong class="text-xs font-bold text-slate-800">{{ article.author | default: 'Đội ngũ biên tập Pharma Cosmetics' }}</strong>
            <time class="text-[11px] text-slate-500" datetime="{{ article.published_on | date: '%Y-%m-%dT%H:%M:%S' }}">
              {{ pc_art_wd }}{{ article.published_on | date: 'dd/MM/yyyy HH:mm' }} (GMT +7)
            </time>
          </div>
        </div>

        <!-- Tóm tắt bài viết / Đoạn dẫn (in đậm) -->
        {%- if article.summary != blank -%}
        <div class="mb-5 text-sm sm:text-base font-bold leading-relaxed text-slate-800">
          {{ article.summary | strip_html }}
        </div>
        {%- endif -%}

        <!-- Thân bài viết -->
        <div class="article-content-body text-sm sm:text-base leading-relaxed text-slate-700 space-y-4" id="article-body">
          {%- if article.content.size > 0 -%}
            {% include 'shortcode' load: pc_art_c %}
          {%- else -%}
            <p>Nội dung bài viết đang được cập nhật.</p>
          {%- endif -%}
        </div>

        <!-- Nguồn bài viết -->
        <div class="mt-8 flex items-center gap-1.5 text-xs text-ink-muted">
          <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'link', size: 14 %}</i>
          <span>Nguồn: <strong>{{ settings.store_name | default: store.name | default: 'Pharma Cosmetics' }}</strong></span>
        </div>

        <!-- Từ khoá tags -->
        {%- if article.tags.size > 0 -%}
        <div class="mt-4 flex items-start gap-3 rounded-lg border border-line-soft bg-surface-soft p-3">
          <div class="flex items-center gap-1 text-xs font-bold text-brand-deep shrink-0 mt-0.5">
            <span class="font-bold">#</span>
            <span>Từ khoá:</span>
          </div>
          <div class="flex flex-wrap gap-2 text-xs">
            {%- for tag in article.tags -%}
              {%- unless tag contains ':' or tag contains 'duocsi_' or tag contains 'video' -%}
              <a class="text-primary hover:underline" href="/blogs/all/tagged/(({{ tag | replace: ' ', '%20' }}))">{{ tag }}</a>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        <!-- Thanh tác vụ ngang Mobile (ẩn trên desktop) -->
        <div class="my-6 flex lg:hidden items-center justify-around rounded-xl border border-line-soft bg-white p-2 shadow-sm">
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600" title="Lưu bài viết" data-article-save>
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'bookmark', size: 16 %}</i>
          </button>
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600" title="Thích" data-article-like>
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'heart', size: 16 %}</i>
          </button>
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600" title="Chia sẻ" data-article-share>
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'share', size: 16 %}</i>
          </button>
          <a href="#article_comments_section" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 no-underline" title="Bình luận">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 16 %}</i>
          </a>
          <div class="relative flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600" title="Lượt xem">
            <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'eye', size: 16 %}</i>
            <span class="absolute -top-1 -right-1 bg-sky-600 text-white text-[9px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center">0</span>
          </div>
        </div>

        <!-- KHỐI BÌNH LUẬN CHUẨN THIẾT KẾ (LUÔN HIỂN THỊ) -->
        <div class="mt-10 rounded-xl border border-line-soft bg-white p-5 sm:p-6" id="article_comments_section">
          <h3 class="m-0 mb-4 text-sm sm:text-base font-bold uppercase tracking-wider text-slate-800">
            BÌNH LUẬN
          </h3>

          <form method="post" action="{{ article.url }}#article_comments" id="article_comments" accept-charset="UTF-8">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 focus-within:border-primary focus-within:bg-white transition-colors">
              <textarea placeholder="Nhập ý kiến của bạn..." class="w-full border-0 bg-transparent p-0 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-0 resize-none min-h-[60px]" id="comment-body" name="comment[body]" required></textarea>
              
              <!-- Cụm trường Họ tên & Email -->
              <div class="mt-3 pt-3 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-3" id="comment-extra-fields">
                <input placeholder="Họ và tên *" type="text" class="rounded border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 focus:border-primary focus:outline-none" value="{{ customer.name }}" name="comment[author]" required>
                <input placeholder="Email (được bảo mật) *" type="email" class="rounded border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 focus:border-primary focus:outline-none" value="{{ customer.email }}" name="comment[email]" required>
              </div>

              <!-- Nút Gửi màu thương hiệu #3CB371 -->
              <div class="mt-3 flex justify-end">
                <button type="submit" class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-btn px-5 text-xs font-bold text-white transition-colors hover:bg-btn-hover cursor-pointer border-0">
                  <span>Gửi</span>
                  <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'paper-plane', size: 14 %}</i>
                </button>
              </div>
            </div>
          </form>

          <!-- Bộ đếm bình luận -->
          <div class="mt-6 border-b border-line-soft pb-2">
            <span class="text-xs font-bold text-slate-700">Tất cả ({{ article.comments_count | default: 0 }})</span>
          </div>

          <!-- Danh sách bình luận hoặc thông báo trống -->
          {% if article.comments_count > 0 %}
            <div class="mt-4 space-y-4">
              {% for comment in article.comments %}
              <div class="flex gap-3 text-xs border-b border-line-soft pb-3">
                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold shrink-0">
                  {{ comment.author | upcase | slice: 0, 1 }}
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <strong class="font-bold text-slate-800">{{ comment.author }}</strong>
                    <span class="text-[10px] text-slate-400">{{ comment.created_on | date: 'dd/MM/yyyy' }}</span>
                  </div>
                  <p class="mt-1 text-slate-600 leading-relaxed">{{ comment.content }}</p>
                </div>
              </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="py-8 text-center text-xs text-ink-muted">
              Chưa có bình luận nào. Hãy là người đầu tiên bình luận!
            </p>
          {% endif %}
        </div>
      </main>

      <!-- 3. RIGHT SIDEBAR ("CHỦ ĐỀ" & "TIN LIÊN QUAN") -->
      <aside class="w-full space-y-8 lg:col-start-3" aria-label="Chủ đề và tin liên quan">
        <!-- Khối CHỦ ĐỀ -->
        <div class="rounded-xl border border-line-soft bg-white p-5">
          <h3 class="m-0 mb-4 border-b border-line-soft pb-2 text-xs font-bold uppercase tracking-wider text-slate-800">
            CHỦ ĐỀ
          </h3>
          <div class="flex flex-wrap gap-2">
            {%- assign pc_topic_handles = 'tin-tuc-va-kien-thuc,bi-quyet,video,truoc-va-sau,hoat-chat,chuyen-gia' | split: ',' -%}
            {%- for th in pc_topic_handles -%}
              {%- assign tb = blogs[th] -%}
              {%- if tb and tb.title != blank -%}
              <a href="{{ tb.url }}" class="rounded bg-brand-deep px-2.5 py-1 text-xs font-semibold text-white no-underline transition-colors hover:bg-primary">
                {{ tb.title }}
              </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- Khối TIN LIÊN QUAN -->
        <div class="rounded-xl border border-line-soft bg-white p-5">
          <h3 class="m-0 mb-4 border-b border-line-soft pb-2 text-xs font-bold uppercase tracking-wider text-slate-800">
            TIN LIÊN QUAN
          </h3>
          <div class="space-y-4">
            {%- assign cur_url = article.url -%}
            {%- assign rel_shown = 0 -%}
            {%- for rel_a in blog.articles -%}
              {%- if rel_a.url != cur_url and rel_shown < 5 -%}
              {%- assign rel_shown = rel_shown | plus: 1 -%}
              <article class="space-y-1.5 border-b border-line-soft pb-3 last:border-b-0 last:pb-0">
                <h4 class="m-0 text-xs font-bold leading-snug">
                  <a href="{{ rel_a.url }}" class="text-slate-800 hover:text-primary transition-colors no-underline line-clamp-2">
                    {{ rel_a.title }}
                  </a>
                </h4>
                <div class="flex items-center gap-2 text-[11px] text-slate-400">
                  <time datetime="{{ rel_a.published_on | date: '%Y-%m-%dT%H:%M:%S' }}">
                    {{ rel_a.published_on | date: 'HH:mm dd/MM/yyyy' }}
                  </time>
                </div>
                <div>
                  <span class="inline-block rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-600">
                    {{ rel_a.author | default: 'Pharma Cosmetics' }}
                  </span>
                </div>
              </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </aside>

    </div>
  </div>
</div>

<script>
  (function(){
    var body = document.getElementById('article-body');
    if (!body) return;
    var sizes = [14, 16, 18, 20];
    var currentIdx = 1; // 16px default
    function updateSize() {
      body.style.fontSize = sizes[currentIdx] + 'px';
      body.style.lineHeight = '1.75';
    }
    var btnIn = document.getElementById('btn-zoom-in');
    var btnOut = document.getElementById('btn-zoom-out');
    var btnReset = document.getElementById('btn-zoom-reset');
    if (btnIn) btnIn.addEventListener('click', function(){ if (currentIdx < sizes.length - 1) { currentIdx++; updateSize(); } });
    if (btnOut) btnOut.addEventListener('click', function(){ if (currentIdx > 0) { currentIdx--; updateSize(); } });
    if (btnReset) btnReset.addEventListener('click', function(){ currentIdx = 1; updateSize(); });

    // Copy link
    document.querySelectorAll('[data-article-copy]').forEach(function(btn){
      btn.addEventListener('click', function(){
        if (navigator.clipboard) {
          navigator.clipboard.writeText(location.href).then(function(){
            alert('Đã sao chép liên kết bài viết!');
          });
        }
      });
    });
  })();
</script>
