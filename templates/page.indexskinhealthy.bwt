{% layout 'theme' %}
{%- comment -%}
  19/09/2026: trang Skin Health Beauty dùng layout chung theme.bwt.
  CSS nội dung, reveal và giỏ dịch vụ được nạp có điều kiện qua skinhealthy_content_*.
  Header, footer, menu, tìm kiếm dùng chung Pharma Cosmetics.
{%- endcomment -%}

{%- comment -%} — Đường dẫn chung, dùng lại nhiều nơi (booking / dịch vụ) — {%- endcomment -%}
{%- assign sh_book_page = pages[settings.skinhealthy_booking_page] -%}
{%- assign sh_book_url = sh_book_page.url | default: pages['dat-lich-tu-van'].url | default: '/dat-lich-tu-van' -%}
{%- assign sh_services_page = pages[settings.skinhealthy_services_page] -%}
{%- assign sh_services_url = sh_services_page.url | default: settings.skinhealthy_services_url | default: '/dich-vu-skin-healthy-beauty' -%}

<style>
  /* ── sh2-* : section KHÔNG có CSS sẵn (before/after, journey, story, philosophy, team, FAQ) ── */
  .sh2-eyebrow {
    display: block; font-family: var(--sh-sans); font-size: var(--fs-3xs); font-weight: 500;
    letter-spacing: .2em; text-transform: uppercase; color: var(--sh-gold); margin-bottom: 16px;
  }
  .sh2-title { font-family: var(--sh-serif); font-weight: 300; color: var(--sh-ink); letter-spacing: .02em; }
  .sh2-body  { font-family: var(--sh-sans); color: var(--sh-ink-60); line-height: 1.75; }
  .sh2-quote {
    font-family: var(--sh-serif); font-style: italic; color: var(--sh-ink);
    border-left: 2px solid var(--sh-gold); padding-left: 20px; line-height: 1.6;
  }

  /* Before/After comparison slider */
  .sh2-ba-slider { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--sh-ivory-dark); cursor: ew-resize; user-select: none; }
  .sh2-ba-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .sh2-ba-slider__after { clip-path: inset(0 0 0 var(--sh2-ba-pos, 50%)); }
  .sh2-ba-slider__handle {
    position: absolute; top: 0; bottom: 0; left: var(--sh2-ba-pos, 50%); width: 2px; background: #fff;
    transform: translateX(-1px); pointer-events: none;
  }
  .sh2-ba-slider__handle::after {
    content: '\f337'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 36px; height: 36px; border-radius: 50%; background: #fff; color: var(--sh-ink);
    display: flex; align-items: center; justify-content: center; font-size: var(--fs-body); box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  .sh2-ba-slider__label { position: absolute; top: 10px; z-index: 2; font-family: var(--sh-sans); font-size: var(--fs-3xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fff; background: rgba(19,36,31,.55); padding: 4px 10px; }
  .sh2-ba-slider__label--before { left: 10px; }
  .sh2-ba-slider__label--after  { right: 10px; }

  /* Journey steps */
  .sh2-journey-step__num {
    font-family: var(--sh-serif); font-size: var(--fs-xl); font-weight: 300; color: var(--sh-gold);
  }
  .sh2-journey-step__dur {
    display: inline-flex; align-items: center; gap: 4px; font-family: var(--sh-sans); font-size: var(--fs-3xs);
    color: var(--sh-ink-60); background: var(--sh-ivory-dark); padding: 3px 10px; margin-top: 8px;
  }

  /* Clinic tour tabs */
  .sh2-tour-tab { text-align: left; background: transparent; border: none; cursor: pointer; padding: 18px 0; border-bottom: 1px solid var(--sh-line); width: 100%; }
  .sh2-tour-tab.is-active { border-bottom-color: var(--sh-gold); }
  .sh2-tour-tab.is-active .sh2-tour-tab__title { color: var(--sh-gold); }
  .sh2-tour-tab__title { font-family: var(--sh-serif); font-size: var(--fs-md); color: var(--sh-ink); transition: color 200ms; }

  /* FAQ accordion */
  .sh2-faq-item { border-bottom: 1px solid var(--sh-line); }
  .sh2-faq-q { width: 100%; text-align: left; background: transparent; border: none; cursor: pointer; padding: 22px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-family: var(--sh-serif); font-size: var(--fs-md); color: var(--sh-ink); }
  .sh2-faq-q__icon { flex-shrink: 0; transition: transform 250ms var(--sh-ease); color: var(--sh-ink-60); }
  .sh2-faq-item.is-open .sh2-faq-q__icon { transform: rotate(45deg); }
  .sh2-faq-a { max-height: 0; overflow: hidden; transition: max-height 300ms var(--sh-ease); }
  .sh2-faq-item.is-open .sh2-faq-a { max-height: 480px; }
  .sh2-faq-a__inner { padding-bottom: 22px; font-family: var(--sh-sans); font-size: var(--fs-sm); line-height: 1.7; color: var(--sh-ink-60); }

  @media (max-width: 767px) {
    .sh2-ba-slider { aspect-ratio: 4/5; }
  }

  /* ── Virtual Clinic Tour (2026-10-18, theo ảnh mẫu VR360): ảnh phòng phủ toàn ngang, chữ + nút đè lên, dải ảnh nhỏ dưới phải. Không bo góc. ── */
  .sh-vt { position: relative; overflow: hidden; height: min(82vh, 760px); min-height: 520px; background: var(--sh-ink); color: #fff; }
  .sh-vt__stage, .sh-vt__shade { position: absolute; inset: 0; }
  .sh-vt__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 700ms var(--sh-ease); }
  .sh-vt__bg.is-active { opacity: 1; }
  .sh-vt__shade { background: linear-gradient(180deg, rgba(10,20,17,.62) 0%, rgba(10,20,17,.12) 34%, rgba(10,20,17,.12) 58%, rgba(10,20,17,.72) 100%); pointer-events: none; }
  .sh-vt__top, .sh-vt__bottom { position: absolute; left: 0; right: 0; z-index: 2; margin: 0 auto; display: flex; gap: 24px; }
  .sh-vt__top { top: 56px; align-items: flex-start; justify-content: space-between; }
  .sh-vt__bottom { bottom: 40px; align-items: flex-end; justify-content: space-between; }
  .sh-vt__head { max-width: 560px; }
  .sh-vt__eyebrow { color: rgba(255,255,255,.78); margin-bottom: 12px; }
  .sh-vt__title { margin: 0; font-family: var(--sh-serif); font-weight: 600; font-size: var(--fs-3xl); line-height: 1.1; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.35); }
  .sh-vt__desc:empty { display: none; }
  .sh-vt__desc { margin: 14px 0 0; font-family: var(--sh-sans); font-size: var(--fs-base); line-height: 1.65; color: rgba(255,255,255,.88); text-shadow: 0 1px 6px rgba(0,0,0,.35); }
  .sh-vt__full { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 1px solid rgba(255,255,255,.55); border-radius: 0; background: rgba(10,20,17,.35); color: #fff; cursor: pointer; font-size: var(--fs-md); transition: background-color 200ms, border-color 200ms; }
  .sh-vt__full:hover, .sh-vt__full:focus-visible { background: rgba(255,255,255,.18); border-color: #fff; }
  .sh-vt__links { display: flex; flex-direction: column; gap: 10px; }
  .sh-vt__link { display: inline-flex; align-items: center; gap: 8px; padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,.45); font-family: var(--sh-sans); font-size: var(--fs-sm); font-weight: 500; letter-spacing: .02em; color: #fff; text-decoration: none; align-self: flex-start; }
  .sh-vt__link:hover, .sh-vt__link:focus-visible { color: #fff; border-bottom-color: #fff; }
  .sh-vt__picker { display: flex; flex-direction: column; gap: 14px; width: min(478px, 100%); flex: none; }
  .sh-vt__nav { display: flex; align-items: center; justify-content: flex-end; gap: 12px; }
  .sh-vt__arrow { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 1px solid rgba(255,255,255,.6); border-radius: 0; background: rgba(10,20,17,.35); color: #fff; cursor: pointer; font-size: var(--fs-sm); transition: background-color 200ms, border-color 200ms, color 200ms; }
  .sh-vt__arrow:hover, .sh-vt__arrow:focus-visible { background: #fff; border-color: #fff; color: var(--sh-ink); }
  .sh-vt__count { min-width: 44px; text-align: center; font-family: var(--sh-sans); font-size: var(--fs-xs); font-weight: 600; letter-spacing: .08em; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.4); }
  .sh-vt__thumbs { width: 100%; margin: 0; overflow: hidden; }
  .sh-vt__slide { width: 150px; height: auto; }
  .sh-vt__thumb { display: flex; flex-direction: column; gap: 8px; width: 100%; padding: 0; border: 0; background: none; color: #fff; cursor: pointer; text-align: left; }
  .sh-vt__thumb-img { display: block; aspect-ratio: 3 / 2; overflow: hidden; border: 2px solid transparent; transition: border-color 200ms; }
  .sh-vt__thumb-img img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: .82; transition: opacity 200ms, transform 400ms var(--sh-ease); }
  .sh-vt__thumb:hover .sh-vt__thumb-img img, .sh-vt__thumb.is-active .sh-vt__thumb-img img { opacity: 1; }
  .sh-vt__thumb:hover .sh-vt__thumb-img img { transform: scale(1.04); }
  .sh-vt__thumb.is-active .sh-vt__thumb-img { border-color: #fff; }
  .sh-vt__thumb:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .sh-vt__thumb-name { font-family: var(--sh-sans); font-size: var(--fs-xs); font-weight: 600; line-height: 1.35; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.4); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 991px) {
    .sh-vt__bottom { flex-direction: column; align-items: stretch; gap: 20px; }
    .sh-vt__picker { width: 100%; }
    .sh-vt__nav { justify-content: flex-start; }
    .sh-vt__slide { width: 132px; }
  }
  @media (max-width: 767px) {
    .sh-vt { height: auto; min-height: 640px; }
    .sh-vt__top { top: 32px; }
    .sh-vt__shade { background: linear-gradient(180deg, rgba(10,20,17,.78) 0%, rgba(10,20,17,.35) 38%, rgba(10,20,17,.18) 55%, rgba(10,20,17,.78) 100%); }
    .sh-vt__title { font-size: var(--fs-2xl); }
    .sh-vt__desc { font-size: var(--fs-sm); }
    .sh-vt__bottom { bottom: 24px; }
    .sh-vt__slide { width: 112px; }
  }
  @media (prefers-reduced-motion: reduce) { .sh-vt__bg, .sh-vt__thumb-img img { transition: none; } }
</style>

{%- comment -%}
  ═══ 01. HERO ═══ 2026-10-18 (người dùng: "chỉnh hero như trang chủ — ảnh, hiệu ứng, text và button chuyển tranh; khi mới vào
  header cũng trong suốt"; KHÔNG đổi UI phần khác): khung + hiệu ứng Hero trang chủ (snippets/section_hero.bwt + home-portal.css +
  home-hero.js), NỘI DUNG = cấu hình riêng Skin Health Beauty (Theme Settings › Skin Healthy › Hero: ảnh nền · eyebrow · tiêu đề H1 ·
  phụ đề · nút CTA). Không lấy slide Hero trang chủ (người dùng: "hero của skin health là khác").
  Bọc .pc-home-v3 .pc-portal chỉ quanh Hero ⇒ CSS trang chủ không lan ra phần khác của trang.
{%- endcomment -%}
{%- assign sh_hero_cta_url = settings.skinhealthy_hero_cta_url | default: sh_services_url -%}
{%- assign hero_lead_image = settings.skinhealthy_hero_img -%}
{%- assign hero_lead_text = settings.skinhealthy_hero_title | default: 'Khoa Học Vì Làn Da' -%}
{%- assign hero_lead_btn = settings.skinhealthy_hero_cta_text | default: 'Khám phá ngay' -%}
{%- assign hero_lead_url = sh_hero_cta_url -%}
{%- assign hero_lead_eyebrow = settings.skinhealthy_hero_eyebrow | default: 'Skin Health Beauty' -%}
{%- assign hero_lead_sub = settings.skinhealthy_hero_sub -%}
{%- assign hero_lead_label = hero_lead_eyebrow -%}
{{ 'home-portal.css' | asset_url | stylesheet_tag }}
<script defer src="{{ 'home-hero.js' | asset_url }}"></script>
<style>
  /* 2026-10-18: header trong suốt đè lên Hero khi mới vào — cùng quy tắc trang chủ (assets/home-portal.css "HEADER TRONG SUỐT"),
     điều kiện = trang có Hero Skin Health Beauty đứng đầu. Rê chuột/focus header hoặc cuộn trang ⇒ header về nền gốc. */
  body:has(.pc-shb-hero #section_hero) header.header{position:absolute;top:auto;left:0;right:0}
  @media (max-width:991px){body:not(.pc-mh-sticky):has(.pc-shb-hero #section_hero) header.header .main-header{position:relative;z-index:100}}
  body:has(.pc-shb-hero #section_hero) header.header .main-header,body:has(.pc-shb-hero #section_hero) header.header .pc-topbar,body:has(.pc-shb-hero #section_hero) header.header .box-hearder{transition:background-color .3s ease,box-shadow .3s ease}
  body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled){background:transparent!important;box-shadow:none!important}
  body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) .pc-topbar{background:transparent!important;box-shadow:inset 0 -1px 0 rgba(255,255,255,.18)}
  body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) .box-hearder{background:transparent!important;box-shadow:none!important;border-color:transparent!important}
  body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) .header-logo .pc-logo-master-img{filter:brightness(0) invert(1)}
  body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) .header-right :is(a,button,.box-icon,i){color:#fff!important}
  @media (min-width:992px){
    body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) .header-menu{background:transparent!important;box-shadow:none!important}
    body:has(.pc-shb-hero #section_hero) header.header:not(:hover):not(:focus-within):not(.hSticky) .main-header:not(.is-scrolled) #nav > .nav-item > .nav-link{color:#fff!important}
  }
  /* 2026-10-18: eyebrow + phụ đề Hero (cấu hình Skin Health Beauty) — cùng kiểu chữ trắng "chìm" của tiêu đề Hero trang chủ. */
  .pc-shb-hero .pc-portal .portal-hero__eyebrow{margin:0 0 14px;color:rgba(255,255,255,.82);font:500 var(--fs-xs)/1.4 var(--f-brand);letter-spacing:.24em;text-transform:uppercase;text-shadow:0 1px 3px rgba(0,30,20,.28),0 0 18px rgba(0,30,20,.32)}
  .pc-shb-hero .pc-portal .portal-hero__sub{max-width:560px;margin:16px auto 0;color:rgba(255,255,255,.82);font:400 var(--fs-base)/1.65 var(--f-body);text-shadow:0 1px 3px rgba(0,30,20,.28),0 0 18px rgba(0,30,20,.32)}
  @media (max-width:767px){.pc-shb-hero .pc-portal .portal-hero__eyebrow{font-size:var(--fs-2xs);letter-spacing:.18em}.pc-shb-hero .pc-portal .portal-hero__sub{font-size:var(--fs-sm)}}
  /* 2026-10-18: 2 khối "Mua sắm theo…" dạng swiper — chỉ thêm nút trước/sau vuông cạnh tiêu đề, giữ nguyên thẻ ảnh + chữ dưới. */
  .sh-swiper-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}
  .sh-swiper-nav{display:flex;gap:8px;flex:none}
  .sh-swiper-btn{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid var(--sh-line);border-radius:0;background:transparent;color:var(--sh-ink);cursor:pointer;font-size:var(--fs-sm);transition:border-color .2s ease,background-color .2s ease,color .2s ease}
  .sh-swiper-btn:hover,.sh-swiper-btn:focus-visible{border-color:var(--sh-ink);background:var(--sh-ink);color:var(--sh-white)}
  .sh-swiper-btn.swiper-button-disabled{opacity:.35;cursor:default;pointer-events:none}
  .sh-swiper-btn.swiper-button-lock{display:none}
  .sh-cat-swiper{overflow:hidden}
  .sh-cat-swiper .swiper-slide{height:auto}
</style>
<div class="pc-home-v3 pc-shb-hero"><div class="pc-portal" id="portal-main"><div id="section_hero" class="portal-section">{% include 'section_hero' %}</div></div></div>

{%- comment -%} ═══ 02. MUA SẮM THEO NHU CẦU DA ═══ 2026-10-18: cùng kiểu thẻ "Mua sắm theo danh mục" (ảnh + chữ bên dưới), swiper chỉ có nút trước/sau. {%- endcomment -%}
<section class="sh-concerns sh-reveal">
  <div class="container sh-container">
    <div class="sh-concerns__header sh-swiper-head">
      <div>
        <span class="sh2-eyebrow">Nhu Cầu Của Bạn</span>
        <h2 class="sh2-title" style="font-size:var(--fs-h3);">Mua Sắm Theo Nhu Cầu Da</h2>
      </div>
      <div class="sh-swiper-nav">
        <button type="button" class="sh-swiper-btn" data-sh-prev="concern" aria-label="Trước"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button type="button" class="sh-swiper-btn" data-sh-next="concern" aria-label="Sau"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
      </div>
    </div>
    {%- assign sh_concern_ll = linklists[settings.skinhealthy_concern_menu] -%}
    <div class="sh-cat-swiper swiper-container" data-sh-swiper="concern">
      <div class="swiper-wrapper">
      {%- if settings.skinhealthy_concern_menu != blank and sh_concern_ll and sh_concern_ll.links.size > 0 -%}
        {%- for link in sh_concern_ll.links limit: 12 -%}
        <div class="swiper-slide">
          <a href="{{ link.url }}" class="sh-cat-card">
            <div class="sh-cat-card__img-wrap">
              {%- if link.object and link.object.image -%}
              <img src="{{ link.object.image.src | img_url: 'grande' }}" alt="{{ link.title }}" width="600" height="600" loading="lazy">
              {%- else -%}
              <div class="sh-cat-card__img-placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
              {%- endif -%}
            </div>
            <div>
              <span class="sh-cat-card__name">{{ link.title }}</span>
              {%- if link.object and link.object.all_products_count > 0 -%}<span class="sh-cat-card__count">{{ link.object.all_products_count }} sản phẩm</span>{%- endif -%}
            </div>
          </a>
        </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback: nhu cầu da phổ biến, khớp danh mục thật đã dùng ở data/navigation.js {%- endcomment -%}
        {%- assign sh_concern_fallback = 'Điều trị mụn|/tri-mun,Điều trị nám|/tri-nam,Chống lão hoá|/chong-lao-hoa,Phục hồi hàng rào|/duong-am' | split: ',' -%}
        {%- for item in sh_concern_fallback -%}
          {%- assign parts = item | split: '|' -%}
          <div class="swiper-slide">
            <a href="{{ parts[1] }}" class="sh-cat-card">
              <div class="sh-cat-card__img-wrap">
                <div class="sh-cat-card__img-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              </div>
              <span class="sh-cat-card__name">{{ parts[0] }}</span>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ═══ 03. MUA SẮM THEO DANH MỤC ═══ 2026-10-18: swiper, chỉ nút trước/sau. {%- endcomment -%}
<section class="sh-categories sh-reveal">
  <div class="container sh-container">
    <div class="sh-concerns__header sh-swiper-head">
      <div>
        <span class="sh2-eyebrow">Danh Mục</span>
        <h2 class="sh2-title" style="font-size:var(--fs-h3);">Mua Sắm Theo Danh Mục</h2>
      </div>
      <div class="sh-swiper-nav">
        <button type="button" class="sh-swiper-btn" data-sh-prev="cat" aria-label="Trước"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button type="button" class="sh-swiper-btn" data-sh-next="cat" aria-label="Sau"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
      </div>
    </div>
    {%- assign sh_cat_ll = linklists[settings.skinhealthy_cat_menu] -%}
    <div class="sh-cat-swiper swiper-container" data-sh-swiper="cat">
      <div class="swiper-wrapper">
      {%- if settings.skinhealthy_cat_menu != blank and sh_cat_ll and sh_cat_ll.links.size > 0 -%}
        {%- for link in sh_cat_ll.links limit: 12 -%}
        <div class="swiper-slide">
          <a href="{{ link.url }}" class="sh-cat-card">
            <div class="sh-cat-card__img-wrap">
              {%- if link.object and link.object.image -%}
              <img src="{{ link.object.image.src | img_url: 'grande' }}" alt="{{ link.title }}" width="600" height="600" loading="lazy">
              {%- else -%}
              <div class="sh-cat-card__img-placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
              {%- endif -%}
            </div>
            <div>
              <span class="sh-cat-card__name">{{ link.title }}</span>
              {%- if link.object and link.object.all_products_count > 0 -%}<span class="sh-cat-card__count">{{ link.object.all_products_count }} sản phẩm</span>{%- endif -%}
            </div>
          </a>
        </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign sh_cat_fallback = 'Chăm Sóc Duy Trì|/collections/maintenance-skin-care,Điều Trị Nhắm Mục Tiêu|/collections/targeted-treatments,Xâm Lấn Tối Thiểu|/collections/invasive-treatments,Chăm Sóc Tại Nhà|/collections/all' | split: ',' -%}
        {%- for item in sh_cat_fallback -%}
          {%- assign parts = item | split: '|' -%}
          <div class="swiper-slide">
            <a href="{{ parts[1] }}" class="sh-cat-card">
              <div class="sh-cat-card__img-wrap">
                <div class="sh-cat-card__img-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              </div>
              <span class="sh-cat-card__name">{{ parts[0] }}</span>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
  /* 2026-10-18: swiper 2 khối "Mua sắm theo…" — 2 thẻ/màn mobile, 3 tablet, 4 desktop (bằng số cột lưới cũ); chỉ nút trước/sau. */
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper !== 'function') return;
    document.querySelectorAll('[data-sh-swiper]').forEach(function (el) {
      var key = el.getAttribute('data-sh-swiper');
      new Swiper(el, {
        slidesPerView: 2, spaceBetween: 16, watchOverflow: true, speed: 500,
        navigation: { prevEl: '[data-sh-prev="' + key + '"]', nextEl: '[data-sh-next="' + key + '"]' },
        breakpoints: { 768: { slidesPerView: 3, spaceBetween: 24 }, 992: { slidesPerView: 4, spaceBetween: 24 } },
        a11y: { enabled: false },
      });
    });
  });
</script>

{%- comment -%} ═══ 04. EDITORIAL BANNER + VIRTUAL CLINIC TOUR (Swiper fade + lightbox, dùng .sh-edit-swiper/.sh-clinic-lb từ layout) ═══ {%- endcomment -%}
{%- assign sh_edit_imgs = '' | split: '' -%}
{%- if settings.skinhealthy_edit_img != blank -%}{%- assign sh_edit_imgs = sh_edit_imgs | push: settings.skinhealthy_edit_img -%}{%- endif -%}
{%- if settings.skinhealthy_edit_img_2 != blank -%}{%- assign sh_edit_imgs = sh_edit_imgs | push: settings.skinhealthy_edit_img_2 -%}{%- endif -%}
{%- if settings.skinhealthy_edit_img_3 != blank -%}{%- assign sh_edit_imgs = sh_edit_imgs | push: settings.skinhealthy_edit_img_3 -%}{%- endif -%}
{%- if settings.skinhealthy_edit_img_4 != blank -%}{%- assign sh_edit_imgs = sh_edit_imgs | push: settings.skinhealthy_edit_img_4 -%}{%- endif -%}
{%- if settings.skinhealthy_edit_img_5 != blank -%}{%- assign sh_edit_imgs = sh_edit_imgs | push: settings.skinhealthy_edit_img_5 -%}{%- endif -%}
{%- assign sh_edit_cta_url = settings.skinhealthy_edit_cta_url | default: sh_book_url -%}
<section class="sh-editorial sh-reveal">
  {%- if sh_edit_imgs.size > 0 -%}
  <div class="sh-edit-swiper swiper">
    <div class="swiper-wrapper">
      {%- for img in sh_edit_imgs -%}
      <div class="swiper-slide">
        <img src="{{ img | img_url: '2048x2048' }}" alt="Không gian phòng khám Skin Health Beauty" width="1440" height="960" loading="lazy">
      </div>
      {%- endfor -%}
    </div>
    {%- if sh_edit_imgs.size > 1 -%}
    <div class="sh-edit-swiper__dots"></div>
    {%- endif -%}
    <button type="button" class="sh-edit-swiper__zoom" id="sh-clinic-zoom-btn" aria-label="Phóng to xem không gian phòng khám">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
    </button>
  </div>
  <div class="sh-editorial__overlay"></div>
  {%- endif -%}
  <div class="container sh-container">
    <div class="sh-editorial__content">
      <span class="sh-editorial__eyebrow">{{ settings.skinhealthy_edit_eyebrow | default: 'Phương pháp khoa học' }}</span>
      <h2 class="sh-editorial__title">{{ settings.skinhealthy_edit_title | default: 'Chẩn đoán da<br><em>cá nhân hóa</em>' }}</h2>
      <p class="sh-editorial__desc">{{ settings.skinhealthy_edit_desc | default: 'Mỗi làn da là duy nhất. Chúng tôi xây dựng routine chính xác dựa trên trạng thái da thực tế của bạn — không phải xu hướng.' }}</p>
      <a href="{{ sh_edit_cta_url }}" class="sh-editorial__cta">
        <span>{{ settings.skinhealthy_edit_cta_text | default: 'Đặt lịch tư vấn' }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

{%- comment -%}
  Virtual Clinic Tour — 2026-10-18 (người dùng gửi ảnh mẫu kiểu "VR360 Virtual Tour"; giữ nguyên chữ + cấu hình đang có):
  ảnh phòng đang chọn phủ toàn ngang · góc trên trái: eyebrow + tiêu đề + mô tả phòng đang chọn · góc trên phải: nút phóng to
  (mở lightbox sẵn có) · dưới phải: dải ảnh nhỏ, bấm để đổi ảnh nền · dưới trái: link video + Thư viện hoạt chất. Không bo góc.
  Không có ảnh ⇒ bố cục chữ cũ. Cập nhật cùng ngày (người dùng: "có nhiều ảnh nên cho swiper và auto next"): dải ảnh nhỏ = swiper
  gồm MỌI ảnh Editorial (skinhealthy_edit_img 1–5), tự chuyển sang ảnh kế mỗi 5 giây (dừng khi rê chuột/focus). Ảnh 1–3 mang tên +
  mô tả 3 phòng (skinhealthy_clinic_*); ảnh 4–5 chưa có chữ trong cấu hình ⇒ không ghi tên, ẩn mô tả (không tự bịa chữ).
{%- endcomment -%}
{%- capture sh_vt_titles -%}{{ settings.skinhealthy_clinic_diag_title | default: 'Phòng Chẩn Đoán 1:1' }}|~|{{ settings.skinhealthy_clinic_lab_title | default: 'Lab Pha Chế Hoạt Chất' }}|~|{{ settings.skinhealthy_clinic_therapy_title | default: 'Phòng Trị Liệu Riêng Tư' }}{%- endcapture -%}
{%- capture sh_vt_descs -%}{{ settings.skinhealthy_clinic_diag_desc | default: 'Không gian tư vấn độc quyền — chỉ bạn và chuyên gia. Thiết bị phân tích da công nghệ cao, kết quả chính xác đến từng lớp biểu bì.' }}|~|{{ settings.skinhealthy_clinic_lab_desc | default: 'Phòng pha chế hoạt chất đạt chuẩn vô khuẩn y tế — nơi mỗi đơn điều trị được chuẩn bị riêng với nồng độ chính xác đến từng milligram.' }}|~|{{ settings.skinhealthy_clinic_therapy_desc | default: 'Không gian trị liệu khép kín — ánh sáng thiết kế riêng cho từng liệu pháp, âm thanh cách âm hoàn toàn, thiết bị điều trị thế hệ mới.' }}{%- endcapture -%}
{%- assign sh_vt_titles = sh_vt_titles | split: '|~|' -%}
{%- assign sh_vt_descs = sh_vt_descs | split: '|~|' -%}
{%- if sh_edit_imgs.size > 0 -%}
<section class="sh-vt sh-reveal" data-vt aria-label="Virtual Clinic Tour">
  <div class="sh-vt__stage">
    {%- for sh_vt_img in sh_edit_imgs -%}
    {%- assign sh_vt_t = sh_vt_titles[forloop.index0] | default: 'Không gian phòng khám Skin Health Beauty' -%}
    <img class="sh-vt__bg{% if forloop.first %} is-active{% endif %}" data-vt-bg="{{ forloop.index0 }}" src="{{ sh_vt_img | img_url: '2048x2048' }}" alt="{{ sh_vt_t | strip_html | escape }}" width="1920" height="900" loading="lazy">
    {%- endfor -%}
  </div>
  <div class="sh-vt__shade" aria-hidden="true"></div>
  <div class="sh-vt__top container sh-container">
    <div class="sh-vt__head">
      <span class="sh2-eyebrow sh-vt__eyebrow">Trải Nghiệm Không Gian</span>
      <h2 class="sh-vt__title">Virtual Clinic Tour</h2>
      <p class="sh-vt__desc" data-vt-desc aria-live="polite">{{ sh_vt_descs[0] }}</p>
    </div>
    <button type="button" class="sh-vt__full" data-vt-full aria-label="Phóng to xem không gian phòng khám"><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
  </div>
  <div class="sh-vt__bottom container sh-container">
    <div class="sh-vt__links">
      {%- if settings.skinhealthy_clinic_video_id != blank -%}
      <a href="https://www.youtube.com/watch?v={{ settings.skinhealthy_clinic_video_id }}" target="_blank" rel="noopener" class="sh-vt__link"><i class="fa-solid fa-play" aria-hidden="true"></i><span>{{ settings.skinhealthy_clinic_video_label | default: 'Xem video giới thiệu không gian trị liệu' }}</span></a>
      {%- endif -%}
      <a href="{{ settings.skinhealthy_ing_url | default: '/tra-cuu-hoat-chat' }}" class="sh-vt__link"><span>Truy cập Thư viện Hoạt chất Lâm sàng</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="sh-vt__picker">
    {%- comment -%} 2026-10-18 (người dùng: "thêm icon next và pre — không ai biết mà bấm cảnh"): nút ‹ › + số đếm trên dải ảnh nhỏ. {%- endcomment -%}
    {%- if sh_edit_imgs.size > 1 -%}
    <div class="sh-vt__nav">
      <button type="button" class="sh-vt__arrow" data-vt-prev aria-label="Cảnh trước"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
      <span class="sh-vt__count" data-vt-count aria-live="polite">1 / {{ sh_edit_imgs.size }}</span>
      <button type="button" class="sh-vt__arrow" data-vt-next aria-label="Cảnh sau"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </div>
    {%- endif -%}
    <div class="sh-vt__thumbs swiper-container" data-vt-swiper>
      <div class="swiper-wrapper" role="tablist" aria-label="Virtual Clinic Tour">
      {%- for sh_vt_img in sh_edit_imgs -%}
      {%- assign sh_vt_t = sh_vt_titles[forloop.index0] -%}
      <div class="swiper-slide sh-vt__slide">
        <button type="button" class="sh-vt__thumb{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ sh_vt_t | default: 'Không gian phòng khám' | strip_html | escape }} {{ forloop.index }}/{{ sh_edit_imgs.size }}" data-vt-room="{{ forloop.index0 }}" data-vt-text="{{ sh_vt_descs[forloop.index0] | escape }}">
          <span class="sh-vt__thumb-img"><img src="{{ sh_vt_img | img_url: 'medium' }}" alt="" width="240" height="160" loading="lazy"></span>
          {%- if sh_vt_t != blank -%}<span class="sh-vt__thumb-name">{{ sh_vt_t }}</span>{%- endif -%}
        </button>
      </div>
      {%- endfor -%}
      </div>
    </div>
    </div>
  </div>
</section>
{%- else -%}
{%- comment -%} Chưa có ảnh Editorial: bố cục chữ cũ (3 tab). {%- endcomment -%}
<section class="sh-reveal" style="padding:72px 0;background:var(--sh-white);border-top:1px solid var(--sh-line);">
  <div class="container sh-container" style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;">
    <div>
      <span class="sh2-eyebrow">Trải Nghiệm Không Gian</span>
      <h2 class="sh2-title" style="font-size:var(--fs-2xl);margin-bottom:20px;">Virtual Clinic Tour</h2>
      {%- if settings.skinhealthy_clinic_video_id != blank -%}
      <a href="https://www.youtube.com/watch?v={{ settings.skinhealthy_clinic_video_id }}" target="_blank" rel="noopener" class="sh-editorial__cta" style="color:var(--sh-ink);border-bottom-color:var(--sh-ink-30);margin-bottom:8px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <span>{{ settings.skinhealthy_clinic_video_label | default: 'Xem video giới thiệu không gian trị liệu' }}</span>
      </a>
      {%- endif -%}
    </div>
    <div>
      <div id="sh-tour-tabs">
        <button type="button" class="sh2-tour-tab is-active" data-tour-tab="0" data-lb-index="0">
          <span class="sh2-tour-tab__title">{{ settings.skinhealthy_clinic_diag_title | default: 'Phòng Chẩn Đoán 1:1' }}</span>
          <p class="sh2-body" style="font-size:var(--fs-xs);margin-top:8px;">{{ settings.skinhealthy_clinic_diag_desc | default: 'Không gian tư vấn độc quyền — chỉ bạn và chuyên gia. Thiết bị phân tích da công nghệ cao, kết quả chính xác đến từng lớp biểu bì.' }}</p>
        </button>
        <button type="button" class="sh2-tour-tab" data-tour-tab="1" data-lb-index="1">
          <span class="sh2-tour-tab__title">{{ settings.skinhealthy_clinic_lab_title | default: 'Lab Pha Chế Hoạt Chất' }}</span>
          <p class="sh2-body" style="font-size:var(--fs-xs);margin-top:8px;">{{ settings.skinhealthy_clinic_lab_desc | default: 'Phòng pha chế hoạt chất đạt chuẩn vô khuẩn y tế — nơi mỗi đơn điều trị được chuẩn bị riêng với nồng độ chính xác đến từng milligram.' }}</p>
        </button>
        <button type="button" class="sh2-tour-tab" data-tour-tab="2" data-lb-index="2">
          <span class="sh2-tour-tab__title">{{ settings.skinhealthy_clinic_therapy_title | default: 'Phòng Trị Liệu Riêng Tư' }}</span>
          <p class="sh2-body" style="font-size:var(--fs-xs);margin-top:8px;">{{ settings.skinhealthy_clinic_therapy_desc | default: 'Không gian trị liệu khép kín — ánh sáng thiết kế riêng cho từng liệu pháp, âm thanh cách âm hoàn toàn, thiết bị điều trị thế hệ mới.' }}</p>
        </button>
      </div>
      <a href="{{ settings.skinhealthy_ing_url | default: '/tra-cuu-hoat-chat' }}" class="sh-editorial__cta" style="color:var(--sh-ink);border-bottom-color:var(--sh-ink-30);margin-top:24px;">
        <span>Truy cập Thư viện Hoạt chất Lâm sàng</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} Clinic lightbox — 1 instance dùng chung cho zoom icon + 3 tab tour {%- endcomment -%}
{%- if sh_edit_imgs.size > 0 -%}
<div class="sh-clinic-lb" id="sh-clinic-lb" aria-hidden="true">
  <div class="sh-clinic-lb__back" id="sh-clinic-lb-back"></div>
  <div class="sh-clinic-lb__stage">
    <button type="button" class="sh-clinic-lb__close" id="sh-clinic-lb-close" aria-label="Đóng">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    {%- if sh_edit_imgs.size > 1 -%}
    <button type="button" class="sh-clinic-lb__prev" id="sh-clinic-lb-prev" aria-label="Ảnh trước"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
    <button type="button" class="sh-clinic-lb__next" id="sh-clinic-lb-next" aria-label="Ảnh sau"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
    {%- endif -%}
    <img class="sh-clinic-lb__img" id="sh-clinic-lb-img" src="" alt="Không gian phòng khám Skin Health Beauty">
    <div class="sh-clinic-lb__counter" id="sh-clinic-lb-counter"></div>
  </div>
</div>
{%- endif -%}

{%- comment -%} ═══ 05. LIỆU TRÌNH ═══ {%- endcomment -%}
{%- assign sh_programs_url = settings.skinhealthy_programs_url | default: sh_book_url -%}
<section class="sh-programs sh-reveal">
  <div class="container sh-container">
    <div class="sh-programs__hd">
      <span class="sh2-eyebrow">Lộ Trình Điều Trị</span>
      <h2 class="sh2-title" style="font-size:var(--fs-h3);">Liệu Trình</h2>
      <p class="sh-programs__intro">Mỗi liệu trình được thiết kế theo mục tiêu điều trị cụ thể, từ chăm sóc duy trì đến can thiệp chuyên sâu.</p>
    </div>
    {%- assign sh_prog_ll = linklists[settings.skinhealthy_programs_menu] -%}
    <ol class="sh-programs__list">
      {%- if settings.skinhealthy_programs_menu != blank and sh_prog_ll and sh_prog_ll.links.size > 0 -%}
        {%- for link in sh_prog_ll.links -%}
        <li class="sh-program-item">
          <a href="{{ link.url }}" class="sh-program-item__link">
            <span class="sh-program-item__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="sh-program-item__name">{{ link.title }}</span>
            <svg class="sh-program-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign sh_prog_fallback = 'Chăm Sóc Duy Trì Hàng Tháng,Phục Hồi Hàng Rào Bảo Vệ Da,Điều Trị Nám & Tăng Sắc Tố,Trẻ Hóa & Chống Lão Hóa,Kiểm Soát Mụn Chuyên Sâu' | split: ',' -%}
        {%- for name in sh_prog_fallback -%}
        <li class="sh-program-item">
          <a href="{{ sh_services_url }}" class="sh-program-item__link">
            <span class="sh-program-item__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="sh-program-item__name">{{ name }}</span>
            <svg class="sh-program-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>
    <div class="sh-programs__cta">
      <a href="{{ sh_programs_url }}" class="sh-programs__cta-btn">
        <span>Xem tất cả liệu trình</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="{{ sh_book_url }}" class="sh-programs__cta-btn sh-programs__cta-btn--outline">Đặt lịch tư vấn</a>
    </div>
  </div>
</section>

{%- comment -%} ═══ 06. LIÊN KẾT PHARMA COSMETICS (IV-B) ═══ {%- endcomment -%}
<section class="sh-reveal" style="padding:64px 0;background:var(--sh-ink);">
  <div class="container sh-container" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;">
    <div style="max-width:640px;">
      <span class="sh2-eyebrow">{{ settings.skinhealthy_pharma_eyebrow | default: 'Một sản phẩm của Pharma Cosmetics' }}</span>
      <p style="font-family:var(--sh-sans);font-size:var(--fs-sm);line-height:1.7;color:rgba(247,244,239,.75);">
        {{ settings.skinhealthy_pharma_desc | default: 'Pharma Cosmetics là nền tảng dược mỹ phẩm toàn cầu, cung cấp giải pháp dựa trên khoa học và dữ liệu để đồng hành cùng quá trình trị liệu tại spa.' }}
      </p>
    </div>
    <a href="/" class="sh-editorial__cta">
      <span>Khám phá Pharma Cosmetics</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

{%- comment -%} ═══ 07. ẢNH TRƯỚC & SAU THEO NHÓM GIẢI PHÁP (IV-C, 6 nhóm) ═══ {%- endcomment -%}
{%- assign sh_ba_names = 'Phục Hồi Hàng Rào Bảo Vệ,Điều Trị Nám & Sắc Tố,Kiểm Soát Mụn,Chống Lão Hóa,Se Khít Lỗ Chân Lông,Cấp Ẩm Chuyên Sâu' | split: ',' -%}
{%- assign sh_ba_any = false -%}
{%- for n in (1..6) -%}
  {%- capture bk -%}skinhealthy_cat_{{ n }}_before{%- endcapture -%}
  {%- capture ak -%}skinhealthy_cat_{{ n }}_after{%- endcapture -%}
  {%- capture antk -%}skinhealthy_cat_{{ n }}_annotation{%- endcapture -%}
  {%- if settings[bk] != blank or settings[ak] != blank or settings[antk] != blank -%}
    {%- assign sh_ba_any = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if sh_ba_any -%}
<section class="sh-reveal" style="padding:80px 0;background:var(--sh-ivory);">
  <div class="container sh-container">
    <div class="sh-concerns__header" style="text-align:center;max-width:640px;margin-left:auto;margin-right:auto;">
      <span class="sh2-eyebrow">Kết Quả Thực Tế</span>
      <h2 class="sh2-title" style="font-size:var(--fs-h3);">Trước & Sau Theo Từng Giải Pháp</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
      {%- for n in (1..6) -%}
        {%- capture bk -%}skinhealthy_cat_{{ n }}_before{%- endcapture -%}
        {%- capture ak -%}skinhealthy_cat_{{ n }}_after{%- endcapture -%}
        {%- capture antk -%}skinhealthy_cat_{{ n }}_annotation{%- endcapture -%}
        {%- assign sh_ba_before = settings[bk] -%}
        {%- assign sh_ba_after = settings[ak] -%}
        {%- assign sh_ba_annotation = settings[antk] -%}
        {%- assign sh_ba_name = sh_ba_names[forloop.index0] -%}
        {%- if sh_ba_before != blank or sh_ba_after != blank or sh_ba_annotation != blank -%}
        <div>
          {%- if sh_ba_before != blank and sh_ba_after != blank -%}
          <div class="sh2-ba-slider" data-ba-slider>
            <img class="sh2-ba-slider__before" src="{{ sh_ba_before | img_url: 'grande' }}" alt="{{ sh_ba_name }} — trước điều trị">
            <img class="sh2-ba-slider__after"  src="{{ sh_ba_after  | img_url: 'grande' }}" alt="{{ sh_ba_name }} — sau điều trị">
            <div class="sh2-ba-slider__handle"></div>
            <span class="sh2-ba-slider__label sh2-ba-slider__label--before">Trước</span>
            <span class="sh2-ba-slider__label sh2-ba-slider__label--after">Sau</span>
          </div>
          {%- endif -%}
          <h3 class="sh2-title" style="font-size:var(--fs-md);margin-top:16px;">{{ sh_ba_name }}</h3>
          {%- if sh_ba_annotation != blank -%}
          <p class="sh2-body" style="font-size:var(--fs-xs);margin-top:6px;">{{ sh_ba_annotation }}</p>
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ═══ 08. HÀNH TRÌNH 6 BƯỚC (IV-D) ═══ {%- endcomment -%}
{%- comment -%} Tên bước lấy từ nhãn field ảnh trong settings_schema.json (không có setting text riêng cho tiêu đề bước) {%- endcomment -%}
{%- assign sh_journey_titles = 'Khảo Sát Lâm Sàng,Số Hóa Hồ Sơ,Thiết Kế Phác Đồ,Trị Liệu 1:1,Kê Đơn Hoạt Chất,Tối Ưu Kết Quả' | split: ',' -%}
{%- assign sh_journey_durs_default = '30–45 phút,15–20 phút,20–30 phút,60–120 phút,10–15 phút,Định kỳ theo phác đồ' | split: ',' -%}
<section class="sh-reveal" style="padding:80px 0;background:var(--sh-white);border-top:1px solid var(--sh-line);">
  <div class="container sh-container">
    <div class="sh-concerns__header">
      <span class="sh2-eyebrow">Quy Trình</span>
      <h2 class="sh2-title" style="font-size:var(--fs-h3);">Hành Trình Điều Trị 6 Bước</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:40px;">
      {%- for n in (1..6) -%}
        {%- capture ik -%}skinhealthy_journey_img_{{ n }}{%- endcapture -%}
        {%- capture dk -%}skinhealthy_journey_dur_{{ n }}{%- endcapture -%}
        {%- assign sh_j_img = settings[ik] -%}
        {%- assign sh_j_dur = settings[dk] | default: sh_journey_durs_default[forloop.index0] -%}
        <div>
          {%- if sh_j_img != blank -%}
          <div style="aspect-ratio:4/3;overflow:hidden;background:var(--sh-ivory-dark);margin-bottom:16px;">
            <img src="{{ sh_j_img | img_url: 'grande' }}" alt="{{ sh_journey_titles[forloop.index0] }}" width="600" height="600" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          </div>
          {%- endif -%}
          <span class="sh2-journey-step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="sh2-title" style="font-size:var(--fs-md);margin-top:8px;">{{ sh_journey_titles[forloop.index0] }}</h3>
          <span class="sh2-journey-step__dur">⏱ {{ sh_j_dur }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} ═══ 09. CÂU CHUYỆN QUYẾT ĐỊNH (IV-E) ═══ 2026-10-18 (người dùng: "bỏ mục này" — khối hiện tiêu đề trống): chỉ hiện khi
  Theme Settings có ít nhất 1 câu chuyện (tiêu đề hoặc nội dung); chưa có ⇒ không render cả khối. {%- endcomment -%}
{%- if settings.skinhealthy_story_1_title != blank or settings.skinhealthy_story_1_body != blank or settings.skinhealthy_story_2_title != blank or settings.skinhealthy_story_2_body != blank -%}
<section class="sh-reveal" style="padding:80px 0;background:var(--sh-ivory);">
  <div class="container sh-container" style="max-width:860px;">
    <div class="sh-concerns__header">
      <span class="sh2-eyebrow">Ca Điều Trị Thật</span>
      <h2 class="sh2-title" style="font-size:var(--fs-h3);">Câu Chuyện Quyết Định</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:48px;">
      {%- if settings.skinhealthy_story_1_title != blank or settings.skinhealthy_story_1_body != blank -%}
      <div>
        <h3 class="sh2-title" style="font-size:var(--fs-lg);margin-bottom:12px;">{{ settings.skinhealthy_story_1_title | default: 'Khi phác đồ ban đầu không còn phù hợp' }}</h3>
        <p class="sh2-body" style="margin-bottom:16px;">{{ settings.skinhealthy_story_1_body | default: 'Một khách hàng bắt đầu với liệu trình phục hồi hàng rào bảo vệ da tiêu chuẩn, nhưng sau 2 buổi da xuất hiện phản ứng kích ứng nhẹ. Thay vì tiếp tục theo kế hoạch cũ, chuyên gia đã đổi hoạt chất và giảm tần suất trị liệu để da có thời gian thích nghi trước khi quay lại lộ trình chính.' }}</p>
        <p class="sh2-quote">{{ settings.skinhealthy_story_1_quote | default: 'Sản phẩm sử dụng không cố định, điều chỉnh theo tình trạng thực tế.' }}</p>
      </div>
      {%- endif -%}
      {%- if settings.skinhealthy_story_2_title != blank or settings.skinhealthy_story_2_body != blank -%}
      <div>
        <h3 class="sh2-title" style="font-size:var(--fs-lg);margin-bottom:12px;">{{ settings.skinhealthy_story_2_title | default: 'Kết quả chậm hơn dự kiến, và tại sao điều đó ổn' }}</h3>
        <p class="sh2-body" style="margin-bottom:16px;">{{ settings.skinhealthy_story_2_body | default: 'Một ca tăng sắc tố sau viêm cần thời gian dài hơn ước tính ban đầu vì cơ địa da đáp ứng chậm với hoạt chất điều hòa melanin. Thay vì tăng nồng độ để đẩy nhanh tiến độ, đội ngũ chọn giữ nguyên nồng độ an toàn và kéo dài thời gian theo dõi.' }}</p>
        <p class="sh2-quote">{{ settings.skinhealthy_story_2_quote | default: 'Kết quả bền vững quan trọng hơn tốc độ.' }}</p>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ═══ 10. KHỐI KẾT — CAM KẾT GIÁ TRỊ (IV-F) ═══ {%- endcomment -%}
<section class="sh-reveal" style="padding:56px 0;background:var(--sh-ink);text-align:center;">
  <div class="container sh-container">
    <p style="font-family:var(--sh-serif);font-size:var(--fs-h4);font-weight:300;color:var(--sh-ivory);letter-spacing:.02em;">
      {{ settings.skinhealthy_commitment_tagline | default: 'Hiểu đúng làn da - Lựa chọn đúng giải pháp - Đồng hành đến kết quả' }}
    </p>
  </div>
</section>

{%- comment -%} ═══ 11. TRIẾT LÝ ĐIỀU TRỊ (IV-G) ═══ {%- endcomment -%}
<section class="sh-reveal" style="padding:88px 0;background:var(--sh-white);">
  <div class="container sh-container" style="display:grid;grid-template-columns:{% if settings.skinhealthy_philosophy_img != blank %}5fr 7fr{% else %}1fr{% endif %};gap:64px;align-items:center;">
    {%- if settings.skinhealthy_philosophy_img != blank -%}
    <div style="aspect-ratio:4/5;overflow:hidden;background:var(--sh-ivory-dark);">
      <img src="{{ settings.skinhealthy_philosophy_img | img_url: '1024x1024' }}" alt="{{ settings.skinhealthy_philosophy_title | default: 'Triết lý điều trị' }}" width="800" height="600" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
    </div>
    {%- endif -%}
    <div style="max-width:560px;">
      <span class="sh2-eyebrow">{{ settings.skinhealthy_philosophy_eyebrow | default: 'Triết lý điều trị' }}</span>
      <h2 class="sh2-title" style="font-size:var(--fs-2xl);margin-bottom:24px;">{{ settings.skinhealthy_philosophy_title | default: 'Da khỏe không phải chỉ là da đẹp' }}</h2>
      <p class="sh2-body" style="margin-bottom:16px;">{{ settings.skinhealthy_philosophy_body1 | default: 'Tại Skin Health Beauty, chúng tôi tiếp cận da theo cách một chuyên gia da liễu tiếp cận bệnh nhân — không phải như một beauty consultant tiếp cận khách hàng.' }}</p>
      <p class="sh2-body" style="margin-bottom:28px;">{{ settings.skinhealthy_philosophy_body2 | default: 'Mỗi liệu trình bắt đầu bằng phân tích chuyên sâu: loại da, chỉ số ẩm và TEWL, hàng rào lipid, lịch sử điều trị và yếu tố lối sống. Từ đó, chúng tôi thiết kế phác đồ cá nhân hóa — không có công thức chung cho mọi người.' }}</p>
      <p class="sh2-quote">{{ settings.skinhealthy_philosophy_quote | default: 'Làn da khỏe mạnh ở cấp độ tế bào là nền tảng của mọi vẻ đẹp. Chúng tôi không che giấu khuyết điểm — chúng tôi chữa lành từ bên trong.' }}</p>
      <p style="font-family:var(--sh-sans);font-size:var(--fs-2xs);color:var(--sh-ink-60);margin-top:12px;">— {{ settings.skinhealthy_philosophy_cite | default: 'Đội ngũ chuyên gia, Skin Health Beauty' }}</p>
    </div>
  </div>
</section>

{%- comment -%} ═══ 12. CHUYÊN GIA PHỤ TRÁCH (IV-H) — mặc định TẮT theo settings.skinhealthy_team_enable ═══ {%- endcomment -%}
{%- if settings.skinhealthy_team_enable -%}
<section class="sh-reveal" style="padding:80px 0;background:var(--sh-ivory);">
  <div class="container sh-container" style="display:flex;flex-wrap:wrap;gap:40px;align-items:center;max-width:760px;margin:0 auto;">
    {%- if settings.skinhealthy_team_1_img != blank -%}
    <div style="width:180px;height:180px;flex-shrink:0;overflow:hidden;background:var(--sh-ivory-dark);">
      <img src="{{ settings.skinhealthy_team_1_img | img_url: 'large' }}" alt="{{ settings.skinhealthy_team_1_name | default: 'Chuyên gia phụ trách' }}" width="400" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
    </div>
    {%- endif -%}
    <div style="flex:1;min-width:260px;">
      <span class="sh2-eyebrow">Chuyên Gia Phụ Trách</span>
      <h3 class="sh2-title" style="font-size:var(--fs-xl);">{{ settings.skinhealthy_team_1_name | default: 'ThS. Nguyễn Thị An' }}</h3>
      <p style="font-family:var(--sh-sans);font-size:var(--fs-xs);color:var(--sh-ink-60);margin-top:4px;">{{ settings.skinhealthy_team_1_title | default: 'Chuyên gia Da liễu · Trị liệu Lâm sàng' }}</p>
      <p style="font-family:var(--sh-sans);font-size:var(--fs-2xs);color:var(--sh-ink-60);margin-top:8px;">{{ settings.skinhealthy_team_1_credential | default: '15 năm kinh nghiệm lâm sàng' }}</p>
      {%- if settings.skinhealthy_team_1_tags != blank -%}
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;">
        {%- assign sh_team_tags = settings.skinhealthy_team_1_tags | split: ',' -%}
        {%- for tag in sh_team_tags -%}
        <span style="font-family:var(--sh-sans);font-size:var(--fs-3xs);padding:4px 12px;background:var(--sh-ivory-dark);color:var(--sh-ink-60);">{{ tag | strip }}</span>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if settings.skinhealthy_team_1_quote != blank -%}
      <p class="sh2-quote" style="margin-top:20px;font-size:var(--fs-body);">{{ settings.skinhealthy_team_1_quote }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ═══ 13. CÂU HỎI THƯỜNG GẶP (IV-I) + FAQPage schema ═══ {%- endcomment -%}
{%- assign sh_faqs = '' | split: '' -%}
{%- for n in (1..6) -%}
  {%- capture qk -%}skinhealthy_faq_{{ n }}_q{%- endcapture -%}
  {%- capture ak2 -%}skinhealthy_faq_{{ n }}_a{%- endcapture -%}
  {%- assign sh_faqs = sh_faqs | push: settings[qk] -%}
{%- endfor -%}
<section class="sh-reveal" style="padding:80px 0;background:var(--sh-white);border-top:1px solid var(--sh-line);">
  <div class="container sh-container" style="max-width:760px;">
    <div class="sh-concerns__header" style="text-align:center;">
      <span class="sh2-eyebrow">Giải Đáp</span>
      <h2 class="sh2-title" style="font-size:var(--fs-h3);">Câu Hỏi Thường Gặp</h2>
    </div>
    <div id="sh-faq-list">
      {%- assign sh_faq_defaults_q = 'Điều trị tại Skin Health Beauty có đau không?,Tôi cần bao nhiêu buổi để thấy kết quả?,Da nhạy cảm có điều trị được không?,Chi phí điều trị tại Skin Health Beauty như thế nào?,Sau mỗi buổi điều trị tôi cần lưu ý gì?,Tôi có thể kết hợp điều trị tại spa với sản phẩm tự dùng ở nhà không?' | split: ',' -%}
      {%- assign sh_faq_defaults_a = 'Tùy theo cấp độ liệu trình. Chăm sóc duy trì hoàn toàn không gây khó chịu. Điều trị nhắm mục tiêu có thể có cảm giác nhẹ như châm chích khi tẩy tế bào chết. Điều trị chuyên sâu sử dụng kem tê bề mặt trước khi thực hiện — hầu hết khách hàng mô tả là nhẹ và có thể chịu được tốt.@@@Phụ thuộc vào mức độ vấn đề ban đầu và loại liệu trình. Hầu hết khách hàng thấy cải thiện rõ sau 3–4 buổi. Lộ trình đầy đủ cho kết quả tối ưu thường từ 6–12 buổi, kết hợp với chăm sóc tại nhà theo hướng dẫn.@@@Có. Chúng tôi có phác đồ riêng cho da nhạy cảm với bước kiểm tra phản ứng (patch test) bắt buộc trước khi bắt đầu bất kỳ liệu trình nào.@@@Chi phí dao động tùy theo liệu trình và số buổi. Tư vấn ban đầu hoàn toàn miễn phí.@@@Chúng tôi cung cấp hướng dẫn chăm sóc sau điều trị bằng văn bản cho từng liệu trình cụ thể.@@@Hoàn toàn có thể và được khuyến khích. Đội ngũ Skin Health Beauty làm việc cùng hệ thống tư vấn sản phẩm của Pharma Cosmetics để thiết kế homecare routine bổ trợ.' | split: '@@@' -%}
      {%- for n in (1..6) -%}
        {%- capture qk -%}skinhealthy_faq_{{ n }}_q{%- endcapture -%}
        {%- capture ak2 -%}skinhealthy_faq_{{ n }}_a{%- endcapture -%}
        {%- assign sh_faq_q = settings[qk] | default: sh_faq_defaults_q[forloop.index0] -%}
        {%- assign sh_faq_a = settings[ak2] | default: sh_faq_defaults_a[forloop.index0] -%}
        <div class="sh2-faq-item{% if forloop.first %} is-open{% endif %}" data-faq-item>
          <button type="button" class="sh2-faq-q" data-faq-toggle>
            <span>{{ sh_faq_q }}</span>
            <span class="sh2-faq-q__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="sh2-faq-a"><div class="sh2-faq-a__inner">{{ sh_faq_a }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for n in (1..6) -%}
      {%- capture qk -%}skinhealthy_faq_{{ n }}_q{%- endcapture -%}
      {%- capture ak2 -%}skinhealthy_faq_{{ n }}_a{%- endcapture -%}
      {%- assign sh_faq_q = settings[qk] | default: sh_faq_defaults_q[forloop.index0] -%}
      {%- assign sh_faq_a = settings[ak2] | default: sh_faq_defaults_a[forloop.index0] -%}
      {
        "@type": "Question",
        "name": {{ sh_faq_q | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ sh_faq_a | json }} }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{%- comment -%} ═══ SCRIPT: Editorial Swiper + Clinic lightbox + Before/After drag + FAQ accordion ═══ {%- endcomment -%}
<script>
document.addEventListener('DOMContentLoaded', function () {

  {%- if sh_edit_imgs.size > 0 -%}
  var shEditSwiperEl = document.querySelector('.sh-edit-swiper');
  var shEditSwiper = null;
  if (shEditSwiperEl && typeof Swiper !== 'undefined') {
    shEditSwiper = new Swiper(shEditSwiperEl, {
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: {% if sh_edit_imgs.size > 1 %}true{% else %}false{% endif %},
      autoplay: { delay: 4500, disableOnInteraction: false },
      pagination: shEditSwiperEl.querySelector('.sh-edit-swiper__dots') ? { el: '.sh-edit-swiper__dots', clickable: true } : false
    });
  }

  /* ── Clinic lightbox ── */
  var shImgs = {{ sh_edit_imgs | json }};
  var lb = document.getElementById('sh-clinic-lb');
  var lbImg = document.getElementById('sh-clinic-lb-img');
  var lbCounter = document.getElementById('sh-clinic-lb-counter');
  var lbIndex = 0;
  /* 2026-10-18: đưa lightbox ra thẳng <body> — nằm trong khung nội dung thì header/bottom-nav (lớp chồng cao hơn) nổi đè lên. */
  if (lb && lb.parentNode !== document.body) document.body.appendChild(lb);

  function shOpenLightbox(idx) {
    if (!lb || !shImgs.length) return;
    lbIndex = ((idx % shImgs.length) + shImgs.length) % shImgs.length;
    lbImg.src = shImgs[lbIndex];
    if (lbCounter) { lbCounter.textContent = (lbIndex + 1) + ' / ' + shImgs.length; }
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function shCloseLightbox() {
    if (!lb) return;
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  /* ── Virtual Clinic Tour: dải ảnh nhỏ = swiper; bấm ảnh nhỏ hoặc tự chuyển (5s, dừng khi rê chuột/focus) ⇒ đổi ảnh nền +
     mô tả; nút phóng to ⇒ lightbox đúng ảnh đang chọn ── */
  var vt = document.querySelector('[data-vt]');
  if (vt) {
    var vtDesc = vt.querySelector('[data-vt-desc]');
    var vtThumbs = [].slice.call(vt.querySelectorAll('[data-vt-room]'));
    var vtBgs = [].slice.call(vt.querySelectorAll('[data-vt-bg]'));
    var vtIndex = 0, vtTimer = null, vtPaused = false;
    var vtCount = vt.querySelector('[data-vt-count]');
    var vtReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var vtSwiperEl = vt.querySelector('[data-vt-swiper]');
    var vtSwiper = (vtSwiperEl && typeof Swiper === 'function') ? new Swiper(vtSwiperEl, {
      slidesPerView: 'auto', spaceBetween: 14, watchOverflow: true, speed: 500, a11y: { enabled: false },
    }) : null;
    function vtShow(i) {
      vtIndex = (i + vtThumbs.length) % vtThumbs.length;
      vtThumbs.forEach(function (b, k) { var on = k === vtIndex; b.classList.toggle('is-active', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
      vtBgs.forEach(function (im, k) { im.classList.toggle('is-active', k === vtIndex); });
      if (vtDesc) vtDesc.textContent = vtThumbs[vtIndex].getAttribute('data-vt-text') || '';
      if (vtSwiper) vtSwiper.slideTo(Math.max(0, vtIndex - 1));
      if (vtCount) vtCount.textContent = (vtIndex + 1) + ' / ' + vtThumbs.length;
    }
    function vtPlay() {
      clearInterval(vtTimer);
      if (vtReduce || vtPaused || vtThumbs.length < 2) return;
      vtTimer = setInterval(function () { vtShow(vtIndex + 1); }, 5000);
    }
    vtThumbs.forEach(function (btn, k) { btn.addEventListener('click', function () { vtShow(k); vtPlay(); }); });
    var vtPrev = vt.querySelector('[data-vt-prev]'), vtNext = vt.querySelector('[data-vt-next]');
    if (vtPrev) vtPrev.addEventListener('click', function () { vtShow(vtIndex - 1); vtPlay(); });
    if (vtNext) vtNext.addEventListener('click', function () { vtShow(vtIndex + 1); vtPlay(); });
    vt.addEventListener('mouseenter', function () { vtPaused = true; clearInterval(vtTimer); });
    vt.addEventListener('mouseleave', function () { vtPaused = false; vtPlay(); });
    vt.addEventListener('focusin', function () { vtPaused = true; clearInterval(vtTimer); });
    vt.addEventListener('focusout', function () { if (!vt.contains(document.activeElement)) { vtPaused = false; vtPlay(); } });
    vtPlay();
    var vtFull = vt.querySelector('[data-vt-full]');
    if (vtFull) vtFull.addEventListener('click', function () { shOpenLightbox(vtIndex); });
  }

  var zoomBtn = document.getElementById('sh-clinic-zoom-btn');
  if (zoomBtn) { zoomBtn.addEventListener('click', function () { shOpenLightbox(shEditSwiper ? shEditSwiper.activeIndex : 0); }); }

  document.querySelectorAll('[data-lb-index]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      shOpenLightbox(parseInt(btn.getAttribute('data-lb-index'), 10) || 0);
      document.querySelectorAll('#sh-tour-tabs [data-tour-tab]').forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });

  var lbClose = document.getElementById('sh-clinic-lb-close');
  var lbBack  = document.getElementById('sh-clinic-lb-back');
  var lbPrev  = document.getElementById('sh-clinic-lb-prev');
  var lbNext  = document.getElementById('sh-clinic-lb-next');
  if (lbClose) lbClose.addEventListener('click', shCloseLightbox);
  if (lbBack)  lbBack.addEventListener('click', shCloseLightbox);
  if (lbPrev)  lbPrev.addEventListener('click', function () { shOpenLightbox(lbIndex - 1); });
  if (lbNext)  lbNext.addEventListener('click', function () { shOpenLightbox(lbIndex + 1); });
  document.addEventListener('keydown', function (e) {
    if (!lb || !lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') shCloseLightbox();
    if (e.key === 'ArrowLeft') shOpenLightbox(lbIndex - 1);
    if (e.key === 'ArrowRight') shOpenLightbox(lbIndex + 1);
  });
  {%- endif -%}

  /* ── Before/After drag slider ── */
  document.querySelectorAll('[data-ba-slider]').forEach(function (el) {
    function setPos(clientX) {
      var rect = el.getBoundingClientRect();
      var pct = ((clientX - rect.left) / rect.width) * 100;
      pct = Math.max(0, Math.min(100, pct));
      el.style.setProperty('--sh2-ba-pos', pct + '%');
    }
    var dragging = false;
    el.addEventListener('pointerdown', function (e) { dragging = true; setPos(e.clientX); });
    window.addEventListener('pointermove', function (e) { if (dragging) setPos(e.clientX); });
    window.addEventListener('pointerup', function () { dragging = false; });
    el.addEventListener('touchstart', function (e) { if (e.touches[0]) setPos(e.touches[0].clientX); }, { passive: true });
    el.addEventListener('touchmove',  function (e) { if (e.touches[0]) setPos(e.touches[0].clientX); }, { passive: true });
  });

  /* ── FAQ accordion ── */
  document.querySelectorAll('[data-faq-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('[data-faq-item]');
      if (!item) return;
      var wasOpen = item.classList.contains('is-open');
      item.parentElement.querySelectorAll('[data-faq-item]').forEach(function (i) { i.classList.remove('is-open'); });
      if (!wasOpen) item.classList.add('is-open');
    });
  });

});
</script>
