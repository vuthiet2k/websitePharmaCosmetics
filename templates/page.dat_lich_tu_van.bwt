{% include 'customer_context_extractor' %}
<script src="{{ 'crm-intake.js' | asset_url }}" defer></script>

{%- assign booking_phone = settings.dat_lich_hotline | default: settings.store_phone -%}
<div class="mops-page mops-booking-page">
  <input type="hidden" id="mops-page-source" value="{{ page.alias | escape }}">

  <div class="container">
    <div class="row align-items-start mops-booking-grid">

      
      <div class="col-12 col-lg-5 mops-booking-col-left">

        <div class="mops-page-content">{{ page.content }}</div>

        
        {%- comment -%}
          26/11/2026 (chủ dự án duyệt «ok dùng form của sapo»): bỏ MOPS/GAS khỏi trang đặt lịch — trước đây khách vào thẳng trang
          (không gắn dịch vụ) bấm gửi là gặp khung đỏ «Chưa cấu hình dịch vụ tư vấn miễn phí» vì ô free_consultation_svc_handle
          trống, nên KHÔNG đặt được lịch. Nay thẻ dịch vụ chỉ để hiển thị: mặc định «Tư vấn da cùng Chuyên gia» (miễn phí);
          có ?handle= thì JS đọc tên sản phẩm Sapo (/products/<handle>.json) và ghi kèm vào ô ẩn contact[Dich_vu] của form.
        {%- endcomment -%}
        <div class="mt-4 rounded-2xl border border-line bg-white p-5">
          <span id="dl-svc-badge" class="inline-flex items-center gap-1 rounded-full bg-primary-tint px-3 py-1 text-xs font-bold text-primary-deep">Miễn phí</span>
          <h1 class="mt-2 text-xl font-bold text-ink lg:text-2xl">{{ page.title | default: 'Đặt lịch tư vấn miễn phí' }}</h1>
          <p class="mt-1 text-sm text-ink-secondary">Dịch vụ: <strong id="dl-svc-name" class="text-ink">Tư vấn da cùng Chuyên gia</strong></p>
          <p id="dl-svc-desc" class="mt-1 text-sm text-ink-muted">Chuyên gia phân tích tình trạng da và tư vấn liệu trình phù hợp với bạn — hoàn toàn miễn phí.</p>
        </div>

        {%- if settings.btn_3_action -%}
        <div class="mops-booking-tabs">
          {%- if settings.btnaction_1 -%}
          <button type="button" class="mops-booking-tab js-mops-tab" data-panel="mops-panel-1">
            {{ settings.btnaction_1_title }}
          </button>
          {%- endif -%}
          {%- if settings.btnaction_2 -%}
          <button type="button" class="mops-booking-tab mops-booking-tab--active js-mops-tab" data-panel="mops-panel-2">
            {{ settings.btnaction_2_title }}
          </button>
          {%- endif -%}
          {%- if settings.btnaction_3 -%}
          <button type="button" class="mops-booking-tab js-mops-tab" data-panel="mops-panel-3">
            {{ settings.btnaction_3_title }}
          </button>
          {%- endif -%}
        </div>
        {%- endif -%}

      </div>

      
      <div class="col-12 col-lg-7 mops-booking-col-right">
        <div class="mops-booking-right-box">

          
          <div class="mops-tab-panel" id="mops-panel-1" style="display:none">
            <div class="mops-contact-panel">
              {%- if settings.btnaction_1_title != blank -%}
              <h2 class="mops-contact-panel__title">{{ settings.btnaction_1_title }}</h2>
              {%- endif -%}
              <p class="mops-contact-panel__desc">Đội ngũ chuyên gia sẵn sàng tư vấn miễn phí cho bạn</p>
              <div class="mops-contact-panel__actions">
                {%- if booking_phone != blank -%}
                <a href="tel:{{ booking_phone | remove: ' ' | remove: '.' | remove: '-' }}" class="mops-contact-btn mops-contact-btn--call">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.95 9.1 19.79 19.79 0 011 0.5A2 2 0 012.96.09h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L7.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0121.9 14.9l.02 2.02z"/></svg>
                  Gọi {{ booking_phone }}
                </a>
                {%- endif -%}
                {%- if settings.contact_zalo != blank -%}
                <a href="https://zalo.me/{{ settings.contact_zalo | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener" class="mops-contact-btn mops-contact-btn--zalo">
                  <svg width="18" height="18" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M24 4C13 4 4 13 4 24c0 4.6 1.5 8.8 4 12.2L4 44l8.1-4c3.2 2.1 7 3.3 11.1 3.3 11 0 20-9 20-20S35 4 24 4z"/></svg>
                  Nhắn Zalo
                </a>
                {%- endif -%}
              </div>
            </div>
          </div>

          
          <div class="mops-tab-panel" id="mops-panel-2">

            {%- if settings.title_dat_lich_form != blank or settings.content_dat_lich_form != blank -%}
            <div class="mops-booking-intro">
              {%- if settings.title_dat_lich_form != blank -%}
              <h2 class="mops-booking-intro__title">{{ settings.title_dat_lich_form }}</h2>
              {%- endif -%}
              {%- if settings.content_dat_lich_form != blank -%}
              <div class="mops-booking-intro__desc">{{ settings.content_dat_lich_form }}</div>
              {%- endif -%}
            </div>
            {%- endif -%}

            {%- comment -%}
              26/11/2026 (chủ dự án duyệt): form đặt lịch = form liên hệ gốc Sapo (thẻ form 'contact' → /contact, Sapo gửi email về
              hộp thư cửa hàng — cùng cách với snippets/page_about.bwt, snippets/popup_tragop.bwt). Không còn gọi MOPS/GAS (list_services,
              create_booking, report_payment, popup QR cọc). Ô Email bắt buộc vì form liên hệ Sapo dùng contact[email].
              Ô tự đặt (contact[Chi_nhanh], [Ngay_den], [Khung_gio], [Dich_vu], [Nguon]) hiện nguyên tên + giá trị trong email.
              pii_form_gate (POLICY.yaml#frontend_theme): mục đích thu thập rõ ràng + checkbox đồng ý + link Chính sách bảo mật.
              CRM Intake (crm-gas, độc lập MOPS) vẫn chạy song song khi bấm gửi — xem script cuối trang.
            {%- endcomment -%}
            {% form 'contact' %}
            <div id="dl-booking-form" class="space-y-4">
              {%- if form.posted_successfully -%}
              <div class="flex items-start gap-2 rounded-xl border border-primary bg-primary-tint px-4 py-3 text-sm text-primary-deep" role="status">
                <span class="mt-0.5 shrink-0">{% include 'ui_icon', name: 'circle-check' %}</span>
                <p><strong>Đặt lịch thành công!</strong> Pharma Cosmetics đã nhận yêu cầu và sẽ gọi lại để xác nhận lịch hẹn trong thời gian sớm nhất.</p>
              </div>
              {%- endif -%}
              {%- if form.errors.size > 0 -%}
              <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                {%- for field in form.errors -%}<p>{{ form.errors.messages[field] }}</p>{%- endfor -%}
              </div>
              {%- endif -%}

              <input type="hidden" name="contact[Nguon]" value="Trang Đặt lịch tư vấn">
              <input type="hidden" name="contact[Dich_vu]" id="dl-svc-field" value="Tư vấn da cùng Chuyên gia (miễn phí)">

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="dl-name" class="mb-1 block text-sm font-semibold text-ink">Họ và tên <span class="text-red-600">*</span></label>
                  <input id="dl-name" name="contact[name]" type="text" required autocomplete="name" placeholder="Nguyễn Văn A"
                    value="{% if customer %}{{ customer.first_name }} {{ customer.last_name }}{% endif %}"
                    class="min-h-[44px] w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary">
                </div>
                <div>
                  <label for="dl-phone" class="mb-1 block text-sm font-semibold text-ink">Số điện thoại <span class="text-red-600">*</span></label>
                  <input id="dl-phone" name="contact[phone]" type="tel" required inputmode="numeric" autocomplete="tel" placeholder="09xx xxx xxx"
                    pattern="0[0-9]{8,9}" title="Số điện thoại 9–10 số, bắt đầu bằng 0"
                    value="{{ crm_customer_phone | default: '' | escape }}"
                    class="min-h-[44px] w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary">
                </div>
                <div>
                  <label for="dl-email" class="mb-1 block text-sm font-semibold text-ink">Email <span class="text-red-600">*</span></label>
                  <input id="dl-email" name="contact[email]" type="email" required autocomplete="email" placeholder="ban@email.com"
                    value="{% if customer %}{{ customer.email }}{% endif %}"
                    class="min-h-[44px] w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary">
                </div>
                <div>
                  <label for="dl-branch" class="mb-1 block text-sm font-semibold text-ink">Chi nhánh <span class="text-red-600">*</span></label>
                  {%- assign branches = settings.list_room_booking | split: ';' -%}
                  <select id="dl-branch" name="contact[Chi_nhanh]" required {% if settings.list_room_booking == blank %}disabled{% endif %}
                    class="min-h-[44px] w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary">
                    {%- if settings.list_room_booking == blank -%}
                    <option value="" disabled selected>— Vui lòng cấu hình danh sách chi nhánh —</option>
                    {%- else -%}
                    {%- for branch in branches -%}
                    {%- assign b = branch | strip -%}
                    {%- if b != blank -%}
                    <option value="{{ b | escape }}">{{ b }}</option>
                    {%- endif -%}
                    {%- endfor -%}
                    {%- endif -%}
                  </select>
                </div>
                <div>
                  <label for="dl-date" class="mb-1 block text-sm font-semibold text-ink">Ngày đến <span class="text-red-600">*</span></label>
                  <input id="dl-date" name="contact[Ngay_den]" type="date" required
                    class="min-h-[44px] w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary">
                </div>
                <fieldset class="m-0 min-w-0 border-0 p-0">
                  <legend class="mb-1 block p-0 text-sm font-semibold text-ink">Thời gian <span class="text-red-600">*</span></legend>
                  <div class="grid grid-cols-3 gap-2">
                    {%- assign dl_slots = 'Sáng,Chiều,Tối' | split: ',' -%}
                    {%- for dl_slot in dl_slots -%}
                    {%- comment -%} CSS cũ ép label = display:block ⇒ phần flex đặt ở span bên trong. {%- endcomment -%}
                    <label class="m-0 cursor-pointer rounded-lg bg-white text-sm font-semibold text-ink ring-1 ring-inset ring-line-control has-[:checked]:bg-primary-tint has-[:checked]:ring-2 has-[:checked]:ring-primary has-[:checked]:text-primary-deep">
                      <span class="flex min-h-[44px] items-center justify-center gap-2 px-2">
                        <input type="radio" name="contact[Khung_gio]" value="{{ dl_slot }}" class="m-0 accent-primary" {% if forloop.first %}checked{% endif %}>
                        {{ dl_slot }}
                      </span>
                    </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              </div>

              <div>
                <label for="dl-note" class="mb-1 block text-sm font-semibold text-ink">Ghi chú thêm</label>
                <textarea id="dl-note" name="contact[body]" rows="3" placeholder="Tình trạng da, mong muốn chăm sóc, yêu cầu đặc biệt..."
                  class="w-full rounded-lg border border-line-control bg-white px-3 py-2.5 text-base text-ink focus:border-primary focus:ring-primary"></textarea>
              </div>

              <p class="text-xs text-ink-muted">
                Thông tin bạn cung cấp (họ tên, số điện thoại, email, tình trạng da) chỉ dùng để xác nhận lịch hẹn và tư vấn liệu trình
                phù hợp — không chia sẻ cho bên thứ ba.
              </p>
              {%- comment -%} pc-checkbox-native: CSS cũ ẩn mọi checkbox (opacity 0) — class này trả lại ô tick gốc (như page_about.bwt). {%- endcomment -%}
              <div class="flex min-h-[44px] items-start gap-3">
                <input id="dl-consent" type="checkbox" required class="pc-checkbox-native mt-0.5 size-5 shrink-0 accent-primary">
                <label for="dl-consent" class="m-0 cursor-pointer text-sm font-normal text-ink-secondary">Tôi đồng ý với <a href="/chinh-sach-bao-mat" target="_blank" rel="noopener" class="text-primary underline">Chính sách bảo mật</a> và cho phép Pharma Cosmetics xử lý dữ liệu cá nhân của tôi cho mục đích đặt lịch tư vấn. <span class="text-red-600">*</span></label>
              </div>

              <button type="submit" id="dl-submit" class="flex min-h-[48px] w-full items-center justify-center gap-2 rounded-xl bg-btn px-6 text-base font-bold text-btn-text transition-colors hover:bg-btn-hover disabled:opacity-60">
                {% include 'ui_icon', name: 'calendar-check' %}
                <span>Đặt lịch tư vấn miễn phí</span>
              </button>

              {%- comment -%} Phương án (c) 26/11/2026: lối phụ — hỏi nhanh Chat AI (mở khung chat nổi snippets/ai_chat.bwt nếu đang bật,
                không thì đi tới trang chat), hoặc gọi / nhắn Zalo trực tiếp. {%- endcomment -%}
              {%- assign dl_ai_page = settings.ai_chat_page_url | default: '/pages/chat-ai' | strip -%}
              <div class="rounded-xl border border-line bg-surface-soft p-4">
                <p class="mb-3 text-sm font-medium text-ink-secondary">Hoặc hỏi nhanh / liên hệ trực tiếp:</p>
                <div class="flex flex-wrap gap-2">
                  {%- if settings.ai_chat_enable and dl_ai_page != blank -%}
                  <a href="{{ dl_ai_page | escape }}" data-ai-chat-open class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-white px-4 ring-1 ring-inset ring-primary text-sm font-bold text-primary no-underline hover:bg-primary-tint">
                    {% include 'ui_icon', name: 'wand-sparkles' %} Hỏi nhanh Chat AI
                  </a>
                  {%- endif -%}
                  {%- if booking_phone != blank -%}
                  <a href="tel:{{ booking_phone | remove: ' ' | remove: '.' | remove: '-' }}" class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-btn px-4 text-sm font-bold text-btn-text no-underline hover:bg-btn-hover">
                    {% include 'ui_icon', name: 'phone' %} Gọi {{ booking_phone }}
                  </a>
                  {%- endif -%}
                  {%- if settings.contact_zalo != blank -%}
                  <a href="https://zalo.me/{{ settings.contact_zalo | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-white px-4 ring-1 ring-inset ring-line-control text-sm font-bold text-ink no-underline hover:bg-surface-soft">
                    {% include 'ui_icon', name: 'message-circle' %} Nhắn Zalo
                  </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {% endform %}

          </div>

          {%- comment -%} 26/11/2026 (chủ dự án: «bỏ ngay mục tiếp thị liên kết»): tắt ô btnaction_3 ⇒ bỏ cả tab lẫn panel khỏi trang. {%- endcomment -%}
          {%- if settings.btnaction_3 -%}
          <div class="mops-tab-panel" id="mops-panel-3" style="display:none">
            <div class="mops-affiliate-panel">
              {%- if settings.btnaction_3_title != blank -%}
              <h2 class="mops-affiliate-panel__title">{{ settings.btnaction_3_title }}</h2>
              {%- endif -%}
              <p class="mops-affiliate-panel__desc">Tham gia chương trình đối tác và nhận hoa hồng hấp dẫn từ mỗi khách hàng giới thiệu thành công.</p>
              {%- if settings.btnaction_3_url != blank -%}
              <a href="{{ settings.btnaction_3_url }}" class="mops-affiliate-btn">
                Tìm hiểu &amp; Đăng ký ngay
              </a>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}

        </div>
      </div>

    </div>

    {%- assign maps_embed = settings.contactr_contact_maps -%}
    <div class="mops-booking-map">
      {%- if maps_embed != blank -%}
        <iframe
          src="{{ maps_embed }}"
          width="100%" height="100%"
          style="border:0;" allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Bản đồ {{ store.name }}">
        </iframe>
      {%- else -%}
        <div class="mops-booking-map__placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{{ settings.store_address | default: 'Hà Nội, Việt Nam' }}</span>
          <span class="mops-booking-map__hint">Cấu hình bản đồ: Tùy chỉnh → Liên hệ &amp; Hỗ trợ</span>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{%- comment -%}
  2026-10-03: FAQ trang Đặt lịch tư vấn đọc từ Blog Sapo (settings.booking_faq_blog_handle) thay biến mock
  `faqs.booking` (chỉ có ở preview-mock.js). Mỗi câu hỏi = 1 bài viết: tiêu đề = câu hỏi,
  nội dung = câu trả lời. Blog trống → ẩn section.
{%- endcomment -%}
{%- assign pc_faq_booking_handle = settings.booking_faq_blog_handle | default: 'cau-hoi-dat-lich' -%}
{%- assign pc_faq_booking_blog = blogs[pc_faq_booking_handle] -%}
{%- if pc_faq_booking_blog.articles.size > 0 -%}
<section class="pc-booking-faq-section">
  <div class="container">
    <h2 class="pc-section-title pc-booking-faq-title">Câu Hỏi Thường Gặp</h2>
    <div class="pc-booking-faq-list">
      {% for pc_faq in pc_faq_booking_blog.articles %}
      <details class="pc-faq-item">
        <summary class="pc-faq-q">{{ pc_faq.title }}</summary>
        <div class="pc-faq-a">{{ pc_faq.content }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif -%}

<script>
(function() {
  /* 26/11/2026: script trang đặt lịch sau khi bỏ MOPS/GAS — chỉ còn: ngày mặc định, tên dịch vụ hiển thị, CRM Intake song song, tab. */
  var root = document.getElementById('dl-booking-form');
  var form = root ? root.closest('form') : null;

  /* Ngày đến: không chọn ngày đã qua, mặc định hôm nay */
  var dateEl = document.getElementById('dl-date');
  if (dateEl) {
    var t = new Date();
    var today = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
    dateEl.min = today;
    if (!dateEl.value) dateEl.value = today;
  }

  /* SĐT: bỏ khoảng trắng / dấu chấm khách gõ để khớp pattern */
  var phoneEl = document.getElementById('dl-phone');
  if (phoneEl) phoneEl.addEventListener('input', function() {
    var v = phoneEl.value.replace(/[^0-9]/g, '');
    if (v !== phoneEl.value) phoneEl.value = v;
  });

  /* Tên dịch vụ (chỉ hiển thị + ghi vào email): ?handle=<SP Sapo> hoặc ?svc= còn trong giỏ dịch vụ cũ (sh_svc_cart) */
  var nameEl  = document.getElementById('dl-svc-name');
  var descEl  = document.getElementById('dl-svc-desc');
  var badgeEl = document.getElementById('dl-svc-badge');
  var fieldEl = document.getElementById('dl-svc-field');
  function setService(name, desc) {
    if (!name) return;
    if (nameEl)  nameEl.textContent  = name;
    if (descEl)  descEl.textContent  = desc || 'Chuyên gia sẽ gọi lại để xác nhận lịch hẹn và chi phí (nếu có).';
    if (badgeEl) badgeEl.textContent = 'Đặt lịch';
    if (fieldEl) fieldEl.value = name;
  }
  var params = new URLSearchParams(window.location.search);
  var handle = params.get('handle') || '';
  var svcIds = params.getAll('svc').filter(Boolean);
  if (handle) {
    fetch('/products/' + encodeURIComponent(handle) + '.json')
      .then(function(r) { if (!r.ok) throw new Error('not_found'); return r.json(); })
      .then(function(d) {
        var p = d && d.product;
        if (!p || !p.name) return;
        var tmp = document.createElement('div');
        tmp.innerHTML = p.summary || '';
        setService(p.name, (tmp.textContent || '').trim());
      })
      .catch(function() { /* không tìm thấy ⇒ giữ «Tư vấn da cùng Chuyên gia» */ });
  } else if (svcIds.length) {
    try {
      var cart = JSON.parse(localStorage.getItem('sh_svc_cart') || '[]');
      var names = svcIds.map(function(id) {
        var c = cart.find(function(x) { return String(x.svc_id) === String(id); });
        return c && c.title;
      }).filter(Boolean);
      if (names.length) setService(names.join(', '));
    } catch (e) {}
  }

  /* Gửi form: CRM Intake (crm-gas, độc lập MOPS, theo consent của chính form) chạy trước tối đa 2,5 giây rồi mới gửi
     form Sapo — CRM lỗi / safe-mode / chậm đều không chặn khách đặt lịch. Trình duyệt đã kiểm các ô required trước khi tới đây. */
  if (form) {
    form.addEventListener('submit', function(e) {
      if (form.getAttribute('data-sending') === '1') return;
      var crm = window.PharmaCrmIntake;
      if (!crm || !crm.isReady || !crm.isReady()) return;
      e.preventDefault();
      form.setAttribute('data-sending', '1');
      var btn = document.getElementById('dl-submit');
      if (btn) btn.disabled = true;
      function val(id) { var el = document.getElementById(id); return el ? String(el.value || '').trim() : ''; }
      var slot = form.querySelector('input[name="contact[Khung_gio]"]:checked');
      var note = [val('dl-note'), fieldEl ? 'Dịch vụ: ' + fieldEl.value : ''].filter(Boolean).join(' | ');
      var sent = false;
      function go() { if (sent) return; sent = true; HTMLFormElement.prototype.submit.call(form); }
      var p;
      try {
        p = crm.submitContactLead({
          consent: true,
          consent_at: new Date().toISOString(),
          source: 'clinic_booking',
          contact: {
            name: val('dl-name'),
            phone: val('dl-phone'),
            email: val('dl-email'),
            message: note,
            branch: val('dl-branch'),
            appointment_date: val('dl-date'),
            time_slot: slot ? slot.value : ''
          }
        });
      } catch (err) { p = Promise.resolve(); }
      Promise.resolve(p).then(go, go);
      setTimeout(go, 2500);
    });
  }

  /* Tab (chỉ hiện khi bật «btn_3_action» trong cấu hình) */
  var tabBtns   = document.querySelectorAll('.js-mops-tab');
  var tabPanels = document.querySelectorAll('.mops-tab-panel');
  tabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target = this.getAttribute('data-panel');
      tabBtns.forEach(function(b) { b.classList.toggle('mops-booking-tab--active', b === btn); });
      tabPanels.forEach(function(p) { p.style.display = (p.id === target) ? '' : 'none'; });
    });
  });
})();
</script>
