{% paginate collection.products by settings.collection_number_product %}
{%- comment -%} 2026-10-17: danh mục liệu trình (settings.lt_collection) dùng lưới thẻ liệu trình mới — trước đây alias ghi cứng
  'dieu-tri-chuyen-nghiep' + snippets/product_grid_lieu_trinh (tiêu đề nhóm rỗng, không h1, tràn ngang mobile). {%- endcomment -%}
{%- comment -%} 04/11/2026: lt_collection nhận nhiều handle cách nhau dấu phẩy (vd "dieu-tri-chuyen-nghiep,dich-vu" — menu Dịch vụ). {%- endcomment -%}
{%- assign pc_lt_cols = settings.lt_collection | default: 'dieu-tri-chuyen-nghiep' | remove: ' ' | split: ',' -%}
{%if pc_lt_cols contains collection.alias %}
<div class="layout-collection">
	{% include 'breadcrumb' %}
	{% include 'collection_lieu_trinh' %}
</div>
{%else%}
<div class="layout-collection">
	{% include 'breadcrumb' %}  
	<div class="container">
		{%- comment -%}
			2026-10-10 (thiết kế design/danh-muc/danh-muc-san-pham.png): banner (h1 = tên danh mục) → dải voucher riêng →
			cột lọc | cột sản phẩm (bộ lọc nhanh → số SP + sắp xếp → lưới thẻ ui_product_card → phân trang).
		{%- endcomment -%}
		{%- include 'collection_hero' -%}
		{%- include 'collection_vouchers' -%}
		{%- comment -%} 14/11/2026: khung 2 cột + ngăn bộ lọc mobile viết bằng class Tailwind (UI-0). Móc JS (không CSS): layout-collection,
		  left-content (+ .active do col.js bật ⇒ ngăn trượt vào), close-filters, #ajax-result, #afw-active-bar. {%- endcomment -%}
		<div class="grid grid-cols-1 gap-6 min-[992px]:grid-cols-[280px_minmax(0,1fr)] min-[992px]:items-start">
			{%if settings.aside_category_enable_bot%}
			<div class="col-list-cate min-w-0 min-[992px]:col-span-2">
				{%include 'menu-col-cate'%}
			</div>
			{%endif%}
			<aside class="left-content min-w-0 font-sans max-[991px]:fixed max-[991px]:inset-y-0 max-[991px]:left-0 max-[991px]:z-[99999] max-[991px]:w-[86%] max-[991px]:max-w-[360px] max-[991px]:-translate-x-full max-[991px]:overflow-y-auto max-[991px]:bg-white max-[991px]:p-4 max-[991px]:transition-transform max-[991px]:[&.active]:translate-x-0" aria-label="{{ settings.collection_filter_heading | default: 'Bộ lọc sản phẩm' | escape }}">
				<button type="button" class="close-filters ml-auto flex h-[44px] w-[44px] cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-ink min-[992px]:hidden" aria-label="Đóng bộ lọc">{% include 'ui_icon', name: 'x', size: 24, label: '' %}</button>
				{%- comment -%} section-box-bg / col-list-cate: lớp bọc CŨ giữ tạm cho ruột bộ lọc + menu danh mục (aside-filter, aside-cate, menu-col-cate chưa chuyển Tailwind). {%- endcomment -%}
			<div class="section-box-bg min-[992px]:border min-[992px]:border-solid min-[992px]:border-line min-[992px]:bg-white min-[992px]:p-4 min-[992px]:rounded-2xl">
					{%- include 'sidebar-collection' -%}
					{%- comment -%} 2026-10-08: câu trang trí cuối cột lọc (Admin › Trang danh mục › Câu trang trí cuối cột lọc). {%- endcomment -%}
					{%- if settings.collection_sidebar_quote != blank -%}
					<p class="m-0 mt-6 border-0 border-t border-solid border-line pt-4 text-center text-sm italic text-ink-secondary" aria-hidden="true">{{ settings.collection_sidebar_quote }}</p>
					{%- endif -%}
				</div>
			</aside>
			<div class="min-w-0">
				{%- comment -%} F02: ô danh mục con — trước bộ lọc / sắp xếp. 2026-10-10: h1 nằm ở banner; mã giảm giá ở dải voucher. {%- endcomment -%}
				{%- include 'collection_subnav' -%}
				{%- include 'collection_quick_filters' -%}
		
				{%- comment -%} "Đang lọc N tiêu chí" — col.js bật / tắt bằng thuộc tính hidden và dựng chip (.afw-chip). {%- endcomment -%}
				<div id="afw-active-bar" class="afw-bar" hidden>
					<div class="afw-bar__head">
						<span class="afw-bar__count">Đang lọc <strong class="afw-bar__count-num">0</strong> tiêu chí</span>
						<button type="button" class="afw-bar__clear" onclick="clearAllFiltered()">{% include 'ui_icon', name: 'x', size: 20, label: '' %} Bỏ chọn hết</button>
					</div>
					<div class="afw-bar__chips" id="afw-active-chips"></div>
				</div>
		
				<div id="ajax-result">
					{% if collection.products.size > 0 %}
					{%include 'collection-sortby'%}
					{%include 'products-grid-item'%}
					{% else %}
					<p class="m-0 border border-solid border-line bg-surface-soft p-4 text-sm text-ink-secondary rounded-xl" role="status">Sản phẩm đang được cập nhật.</p>
					{% endif %}
				</div>
		
				{%- comment -%} Mô tả danh mục (object collection.description / trang des_all_page) — dài quá 700 ký tự ⇒ thu gọn, nút «Xem thêm»
				  bật bằng ô chọn ẩn + :has (không cần JS). {%- endcomment -%}
				{%- if page_title == "Tất cả sản phẩm" -%}{%- assign pc_col_desc = pages[settings.des_all_page].content -%}
				{%- else -%}{%- assign pc_col_desc = collection.description | split: '<h5>' | first -%}{%- endif -%}
				{%- if pc_col_desc != blank -%}
				<div class="group mt-8 font-sans">
					{%- if pc_col_desc.size > 700 -%}
					<div class="max-h-[240px] overflow-hidden text-sm leading-relaxed text-ink group-has-[:checked]:max-h-none">{{ pc_col_desc }}</div>
					<label class="mt-3 inline-flex min-h-[44px] cursor-pointer items-center gap-1 text-sm font-semibold text-primary underline underline-offset-4">
						<input type="checkbox" class="sr-only">
						<span class="group-has-[:checked]:hidden">Xem thêm</span>
						<span class="[display:none] group-has-[:checked]:[display:inline]">Thu gọn</span>
					</label>
					{%- else -%}
					<div class="text-sm leading-relaxed text-ink">{{ pc_col_desc }}</div>
					{%- endif -%}
				</div>
				{%- endif -%}
			</div>
		</div>
	</div>

	{%- comment -%} ─── Bottom of collection: Best seller + CTA tư vấn + SP đã xem ─── {%- endcomment -%}
	{%- if collection.products.size > 0 -%}
		{%- include 'section_collection_bestseller' -%}
		{%- include 'section_collection_cta' -%}
		{%- include 'section_product_viewed' -%}
	{%- endif -%}
</div>
<script>
	/* Set --header-h CSS variable dựa trên chiều cao thực tế của header */
	(function () {
		function setHeaderH() {
			var h = document.querySelector('.main-header, header.header, #header');
			if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
		}
		setHeaderH();
		window.addEventListener('resize', setHeaderH);
	})();

	var colName = "{%if page_title == 'All'%}Tất cả sản phẩm{%else%}{{ page_title }}{%endif%}";
	{% if collection.id > 0 %}
	var colId = {{collection.id}};
	{%else%}
	var colId = 0;
	{%endif%}
	var selectedViewData = "{% if template contains '.list' %}data_list{% else %}data{% endif %}";
	/* 2026-10-10: tim yêu thích trên thẻ ui_product_card — dùng chung cookie danh sách yêu thích của theme
	   (sudes_wishlist_products, snippets/favorite_js.bwt); bắt sự kiện ở document để chạy cả với kết quả lọc AJAX. */
	(function () {
		var KEY = 'sudes_wishlist_products';
		function list() { try { return (window.Cookies && Cookies.getJSON(KEY)) || []; } catch (e) { return []; } }
		function paint(root) {
			var l = list();
			(root || document).querySelectorAll('[data-pc-wish]').forEach(function (b) {
				var on = l.indexOf(b.getAttribute('data-pc-wish')) !== -1;
				b.classList.toggle('is-active', on);
				b.setAttribute('aria-pressed', String(on));
				/* L03b2 (30/10/2026): tim rỗng / tim đặc là 2 icon ui_icon — đổi bằng thuộc tính hidden (thay quy tắc CSS ẩn/hiện icon Font Awesome cũ). */
				b.querySelectorAll('[data-pc-wish-off]').forEach(function (i) { i.hidden = on; });
				b.querySelectorAll('[data-pc-wish-on]').forEach(function (i) { i.hidden = !on; });
			});
		}
		document.addEventListener('click', function (e) {
			var b = e.target.closest && e.target.closest('[data-pc-wish]');
			if (!b || !window.Cookies) return;
			e.preventDefault();
			var h = b.getAttribute('data-pc-wish');
			var l = list();
			if (l.indexOf(h) !== -1) {
				if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.removeWishlist) favoriBean.Wishlist.removeWishlist(h);
				else Cookies.set(KEY, l.filter(function (x) { return x !== h; }), { expires: 15, sameSite: 'None', secure: true });
			} else {
				l.unshift(h);
				Cookies.set(KEY, l.slice(0, 100), { expires: 15, sameSite: 'None', secure: true });
				if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.wishlistProduct) favoriBean.Wishlist.wishlistProduct();
				if (window.theme && theme.alert && theme.alert.new) theme.alert.new('Thêm vào danh sách yêu thích', 'Bạn đã thêm sản phẩm vào danh sách yêu thích.', 3000, 'alert-success');
			}
			paint();
		});
		paint();
		var ajax = document.getElementById('ajax-result');
		if (ajax && window.MutationObserver) new MutationObserver(function () { paint(ajax); }).observe(ajax, { childList: true, subtree: true });
	})();
</script>
<div class="ab-most-view-product-module ab-hide"></div>
{% endif %}
{% endpaginate %}