{% paginate collection.products by settings.collection_number_product %}
{%if collection.alias == 'dieu-tri-chuyen-nghiep' %}
<div class="layout-collection">
	{% include 'breadcrumb' %}  
	<div class="container">
		{%include 'product_grid_lieu_trinh'%}
	</div>		
</div>
{%else%}
<div class="layout-collection">
	{% include 'breadcrumb' %}  
	<div class="container">
		{%- comment -%}
			2026-10-10 (thiết kế design/danh-muc/danh-muc-san-pham.png): banner (h1 = tên danh mục) → dải voucher riêng →
			cột lọc | cột sản phẩm (bộ lọc nhanh → số SP + sắp xếp → lưới thẻ mới product_card_collection → phân trang).
		{%- endcomment -%}
		{%- include 'collection_hero' -%}
		{%- include 'collection_vouchers' -%}
		<div class="row">
			{%if settings.aside_category_enable_bot%}
			<div class="col-12">
				<div class="col-list-cate">
					{%include 'menu-col-cate'%}
				</div>
			</div>
			{%endif%}
			<aside class="dqdt-sidebar left-content  col-lg-3 col-12">
				<div class="close-filters d-lg-none d-xl-none" title="Đóng bộ lọc">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
						<path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
					</svg>
				</div>
				<div class="section-box-bg">
					{%- include 'sidebar-collection' -%}
				{%- comment -%} 2026-10-08: câu trang trí cuối cột lọc theo thiết kế (Admin › Trang danh mục › Câu trang trí cuối cột lọc). {%- endcomment -%}
				{%- if settings.collection_sidebar_quote != blank -%}
				<div class="pc-col-aside-quote" aria-hidden="true">
					<svg class="pc-col-aside-quote__leaf" width="120" height="120" viewBox="0 0 180 200" fill="none" focusable="false"><path d="M20 196C52 150 78 104 98 30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M98 30c-26 2-42 22-36 46 24-4 38-22 36-46Z" fill="currentColor" opacity=".55"/><path d="M86 66c-30-6-52 8-56 34 26 6 48-8 56-34Z" fill="currentColor" opacity=".45"/><path d="M74 104c28-16 54-10 66 14-26 12-52 6-66-14Z" fill="currentColor" opacity=".4"/><path d="M58 136c-28-4-48 12-50 36 26 2 44-12 50-36Z" fill="currentColor" opacity=".35"/></svg>
					<p>{{ settings.collection_sidebar_quote }} <span>&#9825;</span></p>
				</div>
				{%- endif -%}
				</div>
			</aside>
			<div class="block-collection col-lg-9 col-12">
				<div class="pc-col-main">
				{%- comment -%}
					F02 (phase home-shopping-ux): ô danh mục con — trước bộ lọc/sort. 2026-10-10: h1 đã chuyển vào banner,
					thẻ giới thiệu + mã giảm giá cũ thay bằng dải voucher dưới banner (collection_vouchers).
				{%- endcomment -%}
				{%- include 'collection_subnav' -%}
				{%- include 'collection_quick_filters' -%}

				{%- comment -%} ─── "Bạn chọn" — Active filter bar (desktop + mobile) ─── {%- endcomment -%}
				<div id="afw-active-bar" class="afw-bar" hidden>
					<div class="afw-bar__head">
						<span class="afw-bar__count">Đang lọc <strong class="afw-bar__count-num">0</strong> tiêu chí</span>
						<button type="button" class="afw-bar__clear" onclick="clearAllFiltered()">
							<svg width="11" height="11" viewBox="0 0 365.696 365.696" aria-hidden="true"><path d="m243.1875 182.859375 113.132812-113.132813c12.5-12.5 12.5-32.765624 0-45.246093l-15.082031-15.082031c-12.503906-12.503907-32.769531-12.503907-45.25 0l-113.128906 113.128906-113.132813-113.152344c-12.5-12.5-32.765624-12.5-45.246093 0l-15.105469 15.082031c-12.5 12.503907-12.5 32.769531 0 45.25l113.152344 113.152344-113.128906 113.128906c-12.503907 12.503907-12.503907 32.769531 0 45.25l15.082031 15.082031c12.5 12.5 32.765625 12.5 45.246093 0l113.132813-113.132812 113.128906 113.132812c12.503907 12.5 32.769531 12.5 45.25 0l15.082031-15.082031c12.5-12.503906 12.5-32.769531 0-45.25zm0 0" fill="currentColor"/></svg>
							Bỏ chọn hết
						</button>
					</div>
					<div class="afw-bar__chips" id="afw-active-chips"></div>
				</div>

				<div id="ajax-result">
				<div class="category-products products-view products-view-grid list_hover_pro">
					<div class="filter-containers">
						{% if collection.products.size > 0 %}
						{%include 'collection-sortby'%}
						{%endif%}
					</div>
					{% if collection.products.size > 0 %}
					{%include 'products-grid-item'%}
					{% else %}
					<div class="alert alert-warning alert-dismissible margin-top-15 margin-bottom-20 section" role="alert">
						Sản phẩm đang được cập nhật.
					</div>
					{% endif %}
				</div>
				</div>
				</div>
				<div class="col-box-content">
					{%if page_title =="Tất cả sản phẩm"%}
					<div class="descrip_coll {% if pages[settings.des_all_page].content.size > 700  %}content_coll{% endif %} add_apper">
						{{ pages[settings.des_all_page].content }}
						{% if pages[settings.des_all_page].content.size > 700  %}
						<div class="bg_cl"></div>
						{% endif %}
					</div>
					{% if pages[settings.des_all_page].content.size > 700  %}
					<div class="view_mores">
						<a class="one">Xem thêm <img width="90" height="90" src="{{'sortdown.png' | asset_url}}" alt="{{store.name}}"></a>
						<a class="two active">Thu gọn <img width="90" height="90" src="{{'sortdown.png' | asset_url}}" alt="{{store.name}}"></a>
					</div>
					{% endif %}
					{%else%}
					{%if collection.description.size > 0%}
					{% assign mycontent = collection.description | split:'<h5>' %}
					<div class="descrip_coll {% if mycontent[0].size > 700  %}content_coll{% endif %} add_apper">
						{{mycontent[0]}}
						{% if mycontent[0].size > 700  %}
						<div class="bg_cl"></div>
						{% endif %}
					</div>
					{% if mycontent[0].size > 700   %}
					<div class="view_mores">
						<a class="one">Xem thêm <img width="90" height="90" src="{{'sortdown.png' | asset_url}}" alt="{{store.name}}"></a>
						<a class="two active">Thu gọn <img width="90" height="90" src="{{'sortdown.png' | asset_url}}" alt="{{store.name}}"></a>
					</div>
					{% endif %}
					{% endif %}
					{% endif %}
				</div>
			</div>

		</div>
	</div>

	{%- comment -%} ─── Bottom of collection: Best seller + CTA tư vấn + SP đã xem ─── {%- endcomment -%}
	{%- if collection.products.size > 0 -%}
		{%- include 'section_collection_bestseller' -%}
		{%- include 'section_collection_cta' -%}
		{%- include 'section_product_viewed' -%}
	{%- endif -%}
</div>
<script>
	/* Set --header-h CSS variable dựa trên chiều cao thực tế của header */
	(function () {
		function setHeaderH() {
			var h = document.querySelector('.main-header, header.header, #header');
			if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
		}
		setHeaderH();
		window.addEventListener('resize', setHeaderH);
	})();

	var colName = "{%if page_title == 'All'%}Tất cả sản phẩm{%else%}{{ page_title }}{%endif%}";
	{% if collection.id > 0 %}
	var colId = {{collection.id}};
	{%else%}
	var colId = 0;
	{%endif%}
	var selectedViewData = "{% if template contains '.list' %}data_list{% else %}data{% endif %}";
	/* 2026-10-10: tim yêu thích trên thẻ product_card_collection — dùng chung cookie danh sách yêu thích của theme
	   (sudes_wishlist_products, snippets/favorite_js.bwt); bắt sự kiện ở document để chạy cả với kết quả lọc AJAX. */
	(function () {
		var KEY = 'sudes_wishlist_products';
		function list() { try { return (window.Cookies && Cookies.getJSON(KEY)) || []; } catch (e) { return []; } }
		function paint(root) {
			var l = list();
			(root || document).querySelectorAll('[data-pc-wish]').forEach(function (b) {
				var on = l.indexOf(b.getAttribute('data-pc-wish')) !== -1;
				b.classList.toggle('is-active', on);
				b.setAttribute('aria-pressed', String(on));
			});
		}
		document.addEventListener('click', function (e) {
			var b = e.target.closest && e.target.closest('[data-pc-wish]');
			if (!b || !window.Cookies) return;
			e.preventDefault();
			var h = b.getAttribute('data-pc-wish');
			var l = list();
			if (l.indexOf(h) !== -1) {
				if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.removeWishlist) favoriBean.Wishlist.removeWishlist(h);
				else Cookies.set(KEY, l.filter(function (x) { return x !== h; }), { expires: 15, sameSite: 'None', secure: true });
			} else {
				l.unshift(h);
				Cookies.set(KEY, l.slice(0, 100), { expires: 15, sameSite: 'None', secure: true });
				if (window.favoriBean && favoriBean.Wishlist && favoriBean.Wishlist.wishlistProduct) favoriBean.Wishlist.wishlistProduct();
				if (window.theme && theme.alert && theme.alert.new) theme.alert.new('Thêm vào danh sách yêu thích', 'Bạn đã thêm sản phẩm vào danh sách yêu thích.', 3000, 'alert-success');
			}
			paint();
		});
		paint();
		var ajax = document.getElementById('ajax-result');
		if (ajax && window.MutationObserver) new MutationObserver(function () { paint(ajax); }).observe(ajax, { childList: true, subtree: true });
	})();
	$('.view_mores a.one').click(function() {
		$(this).addClass('active');
		$('.view_mores a.two').removeClass('active');
		$('.content_coll').addClass('active');
		$('.bg_cl').addClass('active');
	});
	$('.view_mores a.two').click(function() {
		$(this).addClass('active');
		$('.view_mores a.one').removeClass('active');
		$('.content_coll').removeClass('active');
		$('.bg_cl').removeClass('active');
	});
</script>
<div class="ab-most-view-product-module ab-hide"></div>
{% endif %}
{% endpaginate %}