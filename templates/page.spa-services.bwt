{% include 'breadcrumb' %}

<main class="bg-white py-10 font-sans text-ink">
	<div class="container">
		<div class="text-center max-w-3xl mx-auto mb-12">
			<span class="text-xs font-bold text-primary uppercase tracking-widest">
				{%- comment -%} L03b23 (03/11/2026): gỡ Font Awesome — icon SVG ui_icon size em; hộp w-4 + mr-0.5 = chỗ glyph
				  fa-hospital cũ chiếm (đo 342 / 404,7px nhãn) để nhãn không hẹp lại 4px. {%- endcomment -%}
				<i class="inline-flex justify-center w-4 mr-0.5 leading-none" aria-hidden="true">{% include 'ui_icon', name: 'hospital', size: 'em' %}</i> PHÒNG TRỊ LIỆU CHUYÊN SÂU SKIN HEALTH BEAUTY
			</span>
			<h1 class="text-3xl sm:text-4xl font-extrabold text-brand-deep font-heading mt-2">
				Dịch Vụ Trị Liệu Da Chuyên Sâu Chuẩn Y Khoa
			</h1>
			<p class="text-xs sm:text-sm text-ink-secondary mt-2">
				Kết hợp hoàn hảo giữa công nghệ máy móc chuẩn CE Châu Âu và phác đồ dược mỹ phẩm cá nhân hóa bởi Hội đồng Chuyên gia Da liễu.
			</p>
		</div>

		{%- comment -%}
		  REOPEN 2026-09-10 (ADR-007/T-91) — thay 3 thẻ liệu trình minh hoạ cũ bằng "6 Giải Pháp
		  Skin Health Beauty" (SOL-SKH-01..06, data/solutions.js — trích nguyên văn từ sheet
		  6_Giai_Phap_Skin_Health_Beauty trong xlsx Clinic mới). CTA thống nhất "tư vấn-only"
		  (đặt lịch phân tích da) theo ADR-007/T-92 — KHÔNG áp dụng cho catalogue Sapo product cũ
		  (page.skinhealthy-service-detail.bwt vẫn giữ add-to-cart, quyết định người dùng 2026-09-10).
		{%- endcomment -%}
		{%- assign spa_cta_url = settings.spa_services_cta_url | default: '/dat-lich-tu-van' -%}

		{%- comment -%}
		  2026-10-03: core_philosophy/solutions là biến mock (không có trên Sapo → trang trống). Thông
		  điệp đọc settings.spa_philosophy_quote/_signature; 6 giải pháp đọc blog
		  settings.spa_solution_blog_handle: tiêu đề = tên, summary = mô tả, tag en:<tên EN>,
		  phuhop:<đối tượng> (lặp được), tagline:<câu chốt>. Trống → ẩn.
		{%- endcomment -%}
		{%- if settings.spa_philosophy_quote != blank -%}
		<div class="pc-cmp-expert-callout text-center mb-10 mx-auto max-w-3xl">
			"{{ settings.spa_philosophy_quote }}"
			{%- if settings.spa_philosophy_signature != blank -%}<span class="pc-cmp-expert-callout__signature">{{ settings.spa_philosophy_signature }}</span>{%- endif -%}
		</div>
		{%- endif -%}
		{%- assign pc_sol_blog_handle = settings.spa_solution_blog_handle | default: 'giai-phap-skin-health' -%}
		{%- assign pc_sol_blog = blogs[pc_sol_blog_handle] -%}

		{%- if pc_sol_blog.articles.size > 0 -%}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
			{%- for sol in pc_sol_blog.articles -%}
			{%- assign pc_sol_en = '' -%}
			{%- assign pc_sol_tagline = '' -%}
			{%- assign pc_sol_fit = '' -%}
			{%- for pc_sol_tag in sol.tags -%}
				{%- if pc_sol_tag contains ':' -%}
					{%- assign pc_sol_raw_key = pc_sol_tag | split: ':' | first -%}
					{%- assign pc_sol_key = pc_sol_raw_key | strip | downcase -%}
					{%- assign pc_sol_val = pc_sol_tag | remove_first: pc_sol_raw_key | remove_first: ':' | strip -%}
					{%- case pc_sol_key -%}
						{%- when 'en' -%}{%- assign pc_sol_en = pc_sol_val -%}
						{%- when 'tagline' -%}{%- assign pc_sol_tagline = pc_sol_val -%}
						{%- when 'phuhop' -%}{%- if pc_sol_fit != blank -%}{%- assign pc_sol_fit = pc_sol_fit | append: ', ' -%}{%- endif -%}{%- assign pc_sol_fit = pc_sol_fit | append: pc_sol_val -%}
					{%- endcase -%}
				{%- endif -%}
			{%- endfor -%}
			<div class="bg-surface-soft rounded-2xl p-6 border border-line-soft space-y-3 hover:shadow-lg transition flex flex-col">
				{%- if pc_sol_en != blank -%}<span class="inline-flex items-center self-start rounded-full bg-brand-tint px-2.5 py-1 text-[11px] font-semibold text-brand-deep">{{ pc_sol_en }}</span>{%- endif -%}
				<h3 class="text-lg font-bold text-brand-deep font-heading">{{ sol.title }}</h3>
				<p class="text-xs text-ink-muted leading-relaxed flex-1">{{ sol.summary | default: sol.content | strip_html }}</p>
				{%- if pc_sol_fit != blank -%}
				<div class="text-[11px] text-ink-muted">
					<strong>Phù hợp với:</strong> {{ pc_sol_fit }}
				</div>
				{%- endif -%}
				{%- if pc_sol_tagline != blank -%}<p class="text-[11px] italic text-primary">{{ pc_sol_tagline }}</p>{%- endif -%}
				<a href="{{ spa_cta_url }}" class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full bg-btn px-4 text-xs font-bold text-btn-text no-underline transition-colors hover:bg-btn-hover mt-2">Đặt Lịch Phân Tích Da</a>
			</div>
			{%- endfor -%}
		</div>
		{%- endif -%}

		<div class="bg-brand-deep text-white rounded-3xl p-8 sm:p-10 text-center">
			<h2 class="text-xl sm:text-2xl font-bold font-heading mb-2">Chưa Chắc Liệu Trình Nào Phù Hợp?</h2>
			<p class="text-sm text-brand-tint mb-5">Đặt lịch soi da vi điểm AI miễn phí — Chuyên gia Da liễu sẽ tư vấn liệu trình phù hợp nhất với tình trạng da của bạn.</p>
			<a href="{{ spa_cta_url }}" class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-white px-6 text-sm font-bold text-brand-deep no-underline transition-colors hover:bg-brand-tint">
				Đặt Lịch Soi Da Miễn Phí <i class="inline-block leading-none text-xs ml-1" aria-hidden="true">{% include 'ui_icon', name: 'arrow-right', size: 'em' %}</i>{%- comment -%} L03b23: text-xs (12px) ≈ hộp glyph fa-arrow-right cũ (0,875em × 13px = 11,4px) để nút không rộng thêm. {%- endcomment -%}
			</a>
		</div>
	</div>
</main>
