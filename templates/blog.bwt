{%- comment -%}
  blog.bwt — TRANG 1 DANH MỤC BÀI VIẾT (/blogs/<handle> trên preview, /<alias> trên Sapo).
  2026-10-14: URL Sapo không có tiền tố /blogs/ — nếu một danh mục bài viết có alias trùng settings.news_hub_url
  thì trang danh mục đó nạp giao diện cổng tin tổng (page_tin_tuc_hub) thay vì danh sách 1 danh mục.
  Thực tế Sapo (đối soát 2026-10-17): /tin-tuc là Trang nội dung; danh mục "Tin tức" có handle tin-tuc-va-kien-thuc
  ⇒ nhánh này hiện không kích hoạt, giữ làm phòng hờ.
{%- endcomment -%}
{%- assign pc_nh_url_norm = settings.news_hub_url | default: '/tin-tuc' | strip -%}
{%- if blog.url == pc_nh_url_norm -%}
{% include 'page_tin_tuc_hub' %}
{%- else -%}
{% include 'breadcrumb' %}
{%- assign pc_nb_list = settings.news_hub_blogs | split: ',' -%}
{%- assign pc_nb_vblog = settings.video_blog_handle | default: 'video' -%}
{%- assign pc_card_ex_blog = blogs[settings.expert_blog_handle] -%}
{%- comment -%} Cột phải chỉ hiện khi aside-blog thật sự có nội dung (các khối con đều có công tắc riêng, tắt hết thì ẩn cột). {%- endcomment -%}
{%- assign pc_nb_aside = '' -%}
{%- if settings.right_asideblog_enable -%}{%- capture pc_nb_aside -%}{% include 'aside-blog' %}{%- endcapture -%}{%- endif -%}
{%- assign pc_nb_aside_txt = pc_nb_aside | strip_html | strip -%}
{%- assign pc_nb_per = settings.blogs_number_perpage | default: 12 | plus: 0 -%}
{%- if pc_nb_per < 1 or pc_nb_per > 50 -%}{%- assign pc_nb_per = 12 -%}{%- endif -%}
<section class="pc-nblog">
	<div class="container">
		<header class="pc-vblog__head">
			{%- if settings.news_blog_eyebrow != blank -%}<span class="pc-vblog__eyebrow">{{ settings.news_blog_eyebrow | escape }}</span>{%- endif -%}
			<h1 class="pc-vblog__title">{{ blog.name | escape }}</h1>
			{%- assign pc_nb_desc = blog.description | strip_html | strip -%}
			{%- if pc_nb_desc != blank -%}<p class="pc-vblog__intro">{{ pc_nb_desc }}</p>{%- endif -%}
		</header>

		<nav class="pc-vfilter pc-nblog__cats" aria-label="{{ settings.news_cats_title | default: 'Chuyên mục' | escape }}">
			{%- if settings.news_hub_url != blank -%}
			<a class="pc-vfilter__btn" href="{{ settings.news_hub_url }}">{{ settings.news_all_label | default: 'Tất cả' | escape }}</a>
			{%- endif -%}
			{%- for pc_nb_h in pc_nb_list -%}
			{%- assign pc_nb_hs = pc_nb_h | strip -%}
			{%- assign pc_nb_b = blogs[pc_nb_hs] -%}
			{%- if pc_nb_b.articles.size > 0 or pc_nb_b.url == blog.url -%}
			<a class="pc-vfilter__btn" href="{{ pc_nb_b.url }}"{% if pc_nb_b.url == blog.url %} aria-current="page"{% endif %}>{{ pc_nb_b.name | default: pc_nb_b.title | escape }}</a>
			{%- endif -%}
			{%- endfor -%}
			{%- if blogs[pc_nb_vblog].articles.size > 0 -%}
			<a class="pc-vfilter__btn" href="{{ blogs[pc_nb_vblog].url }}">{{ blogs[pc_nb_vblog].name | default: blogs[pc_nb_vblog].title | escape }}</a>
			{%- endif -%}
		</nav>

		<div class="pc-nblog__layout{% if pc_nb_aside_txt != blank %} has-aside{% endif %}">
			<div class="pc-nblog__main">
				{% paginate blog.articles by pc_nb_per %}
				{%- if blog.articles.size > 0 -%}
					<div class="pc-ngrid">
						{%- for article in blog.articles -%}
						{%- assign pc_card_i = forloop.index0 -%}
						{%- assign pc_card_first = forloop.first -%}
						{% include 'pc_article_card' %}
						{%- endfor -%}
					</div>
					{%- if paginate.pages > 1 -%}
					<div class="pc-vblog__pagi">{% include 'paginate-pages' %}</div>
					{%- endif -%}
				{%- else -%}
					<p class="pc-vblog__empty">{{ settings.news_empty_text | default: 'Chuyên mục đang cập nhật bài viết.' | escape }}</p>
				{%- endif -%}
				{% endpaginate %}

				{%- comment -%} Khối Video tư vấn (2026-10-12): 4 bài mới nhất của blog Video, blog trống ⇒ ẩn. {%- endcomment -%}
				{%- assign pc_nb_vcount = settings.video_hub_count | default: 4 | plus: 0 -%}
				{%- if blogs[pc_nb_vblog].articles.size > 0 and pc_nb_vcount > 0 -%}
				<section class="pc-nsec pc-vhub">
					<div class="pc-nsec__head">
						<h2 class="pc-nsec__title">{{ settings.video_hub_title | default: 'Video tư vấn' | escape }}</h2>
						<a class="pc-nsec__more" href="{{ blogs[pc_nb_vblog].url }}">{{ settings.video_hub_more_label | default: 'Xem tất cả video' | escape }}</a>
					</div>
					<div class="pc-nvideo">
						{%- assign pc_vc_layout = 'grid' -%}{%- assign pc_vc_heading = 'h3' -%}
						{%- for pc_hub_item in blogs[pc_nb_vblog].articles limit: pc_nb_vcount -%}
						{%- assign pc_vc_article = pc_hub_item -%}{% include 'video_card' %}
						{%- endfor -%}
					</div>
				</section>
				{%- endif -%}

				{% include 'news_cta' %}
			</div>
			{%- if pc_nb_aside_txt != blank -%}
			<aside class="pc-nblog__aside">{{ pc_nb_aside }}</aside>
			{%- endif -%}
		</div>
	</div>
</section>
{%- endif -%}
