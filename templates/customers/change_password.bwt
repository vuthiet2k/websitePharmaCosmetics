{% include 'breadcrumb' %}
<section class="page_account pc-hub page_change_password">
	<div class="container">
		<a href="/account" class="pc-hub-back">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
			Tài khoản
		</a>

		<div class="pc-acc-pass">
			<div class="pc-acc-pass__head">
				<span class="pc-acc-pass__icon">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
				</span>
				<h1 class="pc-hub-block__title">Đổi mật khẩu</h1>
			</div>

			{% form 'change_customer_password' %}
			{% if form.errors.size > 0 %}
				{% for field in form.errors %}
				<p class="pc-acc-pass__msg pc-acc-pass__msg--error">{{ form.errors.messages[field] }}</p>
				{% endfor %}
			{% elsif form.posted_successfully %}
				<p class="pc-acc-pass__msg pc-acc-pass__msg--ok">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
					Đổi mật khẩu thành công.
				</p>
			{% else %}
				<p class="pc-acc-pass__hint">Để đảm bảo bảo mật, vui lòng đặt mật khẩu mới với ít nhất 8 ký tự.</p>
			{% endif %}

			<div class="pc-acc-pass__form">
				<fieldset class="pc-acc-field">
					<label for="OldPass">Mật khẩu cũ <span class="error">*</span></label>
					<input type="password" name="OldPassword" id="OldPass" required class="form-control" autocomplete="current-password">
				</fieldset>
				<fieldset class="pc-acc-field">
					<label for="changePass">Mật khẩu mới <span class="error">*</span></label>
					<input type="password" name="Password" id="changePass" required minlength="8" class="form-control" autocomplete="new-password">
				</fieldset>
				<fieldset class="pc-acc-field">
					<label for="confirmPass">Xác nhận mật khẩu mới <span class="error">*</span></label>
					<input type="password" name="ConfirmPassword" id="confirmPass" required minlength="8" class="form-control" autocomplete="new-password">
				</fieldset>
				<button class="pc-acc-pass__btn" type="submit">Đặt lại mật khẩu</button>
			</div>
			{% endform %}
		</div>
	</div>
</section>
