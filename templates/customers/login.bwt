{% comment %} templates/customers/login.bwt — T-112 (2026-09-12): tách khỏi layout chung, dùng
  layouts/auth.bwt (split-screen). Form/field/social_login.* GIỮ NGUYÊN không đổi (Sapo native
  form 'customer_login' — đổi tên field có thể vỡ xử lý phía backend Sapo), chỉ đổi khung bọc +
  thêm nút ẩn/hiện mật khẩu (JS thuần, không đổi hành vi submit). {% endcomment %}
{% layout 'auth' %}

<div class="pc-auth-card">
	<div class="pc-auth-card__head">
		<h1 class="pc-auth-card__title">Chào mừng trở lại</h1>
		<p class="pc-auth-card__sub">Đăng nhập để tiếp tục theo dõi đơn hàng &amp; ưu đãi thành viên</p>
	</div>

	<div id="login" class="pc-auth-card__body">
		{% form 'customer_login' %}
		{% if form.errors %}
		<div class="pc-auth-alert pc-auth-alert--error">
			{% for field in form.errors %}
			<p>{{ form.errors.messages[field] }}</p>
			{% endfor %}
		</div>
		{% endif %}

		<div class="pc-auth-field">
			<label for="customer_email" class="pc-auth-label">Email</label>
			<input type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" class="pc-auth-input" value="" name="email" id="customer_email" placeholder="ban@email.com" required>
		</div>
		<div class="pc-auth-field pc-auth-field--password">
			<label for="customer_password" class="pc-auth-label">Mật khẩu</label>
			<div class="pc-auth-password-wrap">
				<input type="password" class="pc-auth-input" value="" name="password" id="customer_password" placeholder="Mật khẩu" required>
				<button type="button" class="pc-auth-password-toggle" aria-label="Hiện/ẩn mật khẩu" onclick="pcAuthTogglePassword('customer_password', this)">
					<i class="fa-regular fa-eye"></i>
				</button>
			</div>
		</div>

		<div class="pc-auth-row-between">
			<span class="pc-auth-link" onclick="showRecoverPasswordForm()" role="button" tabindex="0">Quên mật khẩu?</span>
			<a href="/account/register" class="pc-auth-link">Chưa có tài khoản? Đăng ký</a>
		</div>

		<button type="submit" value="Đăng nhập" class="pc-auth-btn-primary">Đăng nhập</button>
		{% endform %}
	</div>

	{% if form.posted_successfully %}
	<div class="pc-auth-alert pc-auth-alert--success">
		<p>Chúng tôi đã gửi 1 email đến bạn. Vui lòng kiểm tra để đặt lại mật khẩu.</p>
	</div>
	{% endif %}

	<div id="recover-password" class="pc-auth-card__body pc-auth-recover" style="display:none;">
		<p class="pc-auth-recover__hint">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
		{% form 'recover_customer_password' %}
		{% if form.errors %}
		<div class="pc-auth-alert pc-auth-alert--error">
			{% for field in form.errors %}
			<p>{{ form.errors.messages[field] }}</p>
			{% endfor %}
		</div>
		{% endif %}
		<div class="pc-auth-field">
			<label for="recover-email" class="pc-auth-label">Email</label>
			<input type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$" class="pc-auth-input" value="" name="Email" id="recover-email" placeholder="ban@email.com" required>
		</div>
		<button type="submit" value="Lấy lại mật khẩu" class="pc-auth-btn-primary">Lấy lại mật khẩu</button>
		<button type="button" class="pc-auth-link pc-auth-back-to-login" onclick="hideRecoverPasswordForm()">← Quay lại đăng nhập</button>
		{% endform %}
	</div>

	<div class="pc-auth-social">
		<div class="pc-auth-social__divider"><span>hoặc đăng nhập qua</span></div>
		{{ social_login.script }}
		<div class="pc-auth-social__buttons">
			{{ social_login.facebook_button }}
			{{ social_login.google_button }}
		</div>
	</div>
</div>

<script>
	if (window.location.hash === '#recover') {
		document.getElementById('recover-password').style.display = 'block';
		document.getElementById('login').style.display = 'none';
	}
	function showRecoverPasswordForm() {
		document.getElementById('recover-password').style.display = 'block';
		document.getElementById('login').style.display = 'none';
	}
	function hideRecoverPasswordForm() {
		document.getElementById('recover-password').style.display = 'none';
		document.getElementById('login').style.display = 'block';
	}
	function pcAuthTogglePassword(fieldId, btn) {
		var input = document.getElementById(fieldId);
		if (!input) return;
		var icon = btn.querySelector('i');
		if (input.type === 'password') {
			input.type = 'text';
			icon.classList.remove('fa-eye');
			icon.classList.add('fa-eye-slash');
		} else {
			input.type = 'password';
			icon.classList.remove('fa-eye-slash');
			icon.classList.add('fa-eye');
		}
	}
</script>
