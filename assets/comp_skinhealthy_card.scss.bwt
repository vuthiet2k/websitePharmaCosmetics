{% comment %} comp_skinhealthy_card.scss.bwt — Service card component {% endcomment %}

/* ═══════════════════════════════════════════════════════════════
   SERVICE CARD — .svc-card
═══════════════════════════════════════════════════════════════ */
.svc-card {
  display: flex;
  flex-direction: column;
  background: var(--sh-white);
  border: 1px solid var(--sh-line);
  box-shadow: 0 2px 8px rgba(26,26,24,.06);
  overflow: hidden;
  transition: box-shadow 300ms var(--sh-ease), transform 300ms var(--sh-ease);
}
.svc-card:hover {
  box-shadow: 0 8px 32px rgba(26,26,24,.12);
  transform: translateY(-3px);
}

/* Image */
.svc-card__img-wrap {
  position: relative;
  display: block;
  aspect-ratio: 4/3;
  overflow: hidden;
  background: var(--sh-ivory-dark);
  flex-shrink: 0;
  text-decoration: none;
}
.svc-card__img-wrap--empty,
.svc-card__img-wrap.svc-card__img-wrap--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}
.svc-card__img-wrap--empty::after {
  content: '';
  width: 48px;
  height: 48px;
  background: var(--sh-line);
  border-radius: 50%;
}
.svc-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms var(--sh-ease);
}
.svc-card:hover .svc-card__img { transform: scale(1.04); }

/* Badges */
.svc-card__group-badge {
  /* Neutral chip — không dùng màu theo từng loại nhóm dịch vụ (tránh tùy tiện),
     dùng ivory translucent + border navy nhạt để giữ sang trọng trên mọi ảnh nền. */
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 4px 10px;
  background: rgba(247, 244, 239, 0.92);
  color: var(--sh-ink);
  border: 1px solid var(--sh-line);
  font-family: var(--sh-sans);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.svc-card__sale-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  padding: 4px 8px;
  background: #E35D5D;
  color: #fff;
  font-family: var(--sh-sans);
  font-size: 0.6875rem;
  font-weight: 700;
}

/* Body */
.svc-card__body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 20px;
  flex: 1;
}
.svc-card__brand {
  font-family: var(--sh-sans);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--sh-gold);
}
.svc-card__name {
  font-family: var(--sh-serif);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.4;
  color: var(--sh-ink);
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.svc-card__name:hover { color: var(--sh-gold); }

/* Price */
.svc-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: auto;
  padding-top: 8px;
}
.svc-card__price {
  font-family: var(--sh-sans);
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--sh-ink);
}
.svc-card__price--contact {
  font-family: var(--sh-serif);
  font-size: 1rem;
  font-weight: 400;
  font-style: italic;
  color: var(--sh-ink-60);
}
.svc-card__compare {
  font-size: 0.8125rem;
  color: var(--sh-ink-30);
  text-decoration: line-through;
}

/* Actions */
.svc-card__actions {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.svc-card__atc-form { flex: 1; display: flex; }

.svc-card__detail-btn,
.svc-card__book-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 12px;
  font-family: var(--sh-sans);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: .1em;
  text-transform: uppercase;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background 200ms, color 200ms;
  text-align: center;
}
.svc-card__detail-btn {
  background: transparent;
  border: 1px solid var(--sh-line);
  color: var(--sh-ink);
}
.svc-card__detail-btn:hover {
  border-color: var(--sh-ink);
  color: var(--sh-ink);
}
.svc-card__book-btn {
  background: var(--sh-ink);
  color: var(--sh-ivory);
  width: 100%;
}
.svc-card__book-btn:hover { background: var(--sh-gold); }
.svc-card__book-btn--soldout {
  background: var(--sh-line);
  color: var(--sh-ink-30);
  cursor: not-allowed;
}
