// col.js.bwt — Collection page JS
// Requires: Bizweb.SearchFilter (search_filter.js), jQuery

/* ── Helpers ── */
function _replaceParam(url, name, value) {
	var pattern = new RegExp('(' + name + '=).*?(&|$)');
	var newUrl = url.replace(pattern, '$1' + encodeURIComponent(value) + '$2');
	if (newUrl === url) {
		newUrl += (url.indexOf('?') > 0 ? '&' : '?') + name + '=' + encodeURIComponent(value);
	}
	return newUrl;
}
function _getParam(name) {
	var m = new RegExp('[?&]' + name + '=([^&#]*)').exec(window.location.href);
	return m ? decodeURIComponent(m[1]) : '';
}
function _formatPrice(val) {
	return parseInt(val, 10).toLocaleString('vi-VN') + 'đ';
}

/* ── Chuẩn Sapo (20/11/2026, đối chiếu support.sapo.vn "Hướng dẫn sử dụng chức năng tìm kiếm" + theme demo spa-1.mysapo.net) ──
   · Sắp xếp: ô chọn giữ giá trị price-asc… (ghi ?sortby= trên URL để F5 giữ), khi gọi /search đổi sang chuỗi Sapo price_min:asc / name:asc / created_on:desc.
   · Lọc giá: nằm TRONG q như mọi tiêu chí — nhóm "Khoảng giá", trường price_min, giá trị (>X AND <Y) (Sapo chỉ tài liệu hoá > <).
     Trước đây gửi &price_min=&price_max= rời ⇒ Sapo bỏ qua, lọc giá không có tác dụng. */
var SAPO_SORT = { 'price-asc': 'price_min:asc', 'price-desc': 'price_min:desc', 'alpha-asc': 'name:asc', 'alpha-desc': 'name:desc', 'created-desc': 'created_on:desc', 'created-asc': 'created_on:asc' };
function _sapoSort(val) { return SAPO_SORT[val] || ''; }
var PRICE_CAP = 5000000; /* bằng max của thanh trượt (aside-filter.bwt) — kéo hết ⇒ không giới hạn trên */
function _priceExpr(min, max) {
	var parts = [];
	if (min > 0) parts.push('>' + (min - 1));
	if (max < PRICE_CAP) parts.push('<' + (max + 1));
	return parts.length ? '(' + parts.join(' AND ') + ')' : '';
}
/* Đọc lại khoảng giá từ q (nhận cả dạng cũ >= <= lẫn chuẩn > <) ⇒ [min, max] */
function _parsePrice(str) {
	var m = /price_min:\(([^()]*)\)/i.exec(str || '');
	if (!m) return null;
	var min = 0, max = PRICE_CAP;
	m[1].split(/\s+AND\s+/i).forEach(function (p) {
		var c = /^(>=|<=|>|<)\s*(-?\d+)$/.exec(p.trim());
		if (!c) return;
		var n = parseInt(c[2], 10);
		if (c[1] === '>') min = n + 1; else if (c[1] === '>=') min = n; else if (c[1] === '<') max = n - 1; else max = n;
	});
	return [Math.max(0, min), Math.min(PRICE_CAP, max)];
}

/* ── sortby() — đổi thứ tự bằng AJAX như theme chuẩn Sapo (không tải lại trang) ── */
function sortby(val) {
	var params = new URLSearchParams(window.location.search);
	if (val && val !== 'default') params.set('sortby', val); else params.delete('sortby');
	var qs = params.toString();
	history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
	doSearch(1);
}

/* ── CollectionFilter — URL-based active filter bar ─────────────────────────
   Reads directly from window.location.search so the bar is always in sync
   with the actual URL, whether the page was loaded fresh or updated via AJAX.
   ─────────────────────────────────────────────────────────────────────────── */
var CollectionFilter = (function () {

	var LABELS = {
		'product_type.filter_key': 'Loại sản phẩm',
		'vendor': 'Thương hiệu',
		'tags': 'Tình trạng da',
		'price_min': 'Khoảng giá'
	};

	function _decode(s) { try { return decodeURIComponent(s); } catch (e) { return s; } }

	/* Split "A AND B AND C" at top-level AND only (ignores AND inside parens) */
	function _splitAnd(str) {
		var clauses = [], depth = 0, cur = '';
		for (var i = 0; i < str.length; i++) {
			var ch = str[i];
			if (ch === '(') { depth++; cur += ch; }
			else if (ch === ')') { depth--; cur += ch; }
			else if (depth === 0 && str.substr(i, 5).toUpperCase() === ' AND ') {
				clauses.push(cur.trim()); cur = ''; i += 4;
			} else { cur += ch; }
		}
		if (cur.trim()) clauses.push(cur.trim());
		return clauses;
	}

	/* 20/11/2026: nhãn chip = tên nhóm chứa ô tick (data-group, vd "Thành phần hoạt tính" / "Vấn đề về da") — trước dùng cố định "Tình trạng da" cho MỌI tag. */
	function _groupLabel(field, val, fallback) {
		var els = document.querySelectorAll('.filter-checkbox-input[data-field], .filter-pill-btn[data-field]');
		for (var i = 0; i < els.length; i++) {
			if (els[i].getAttribute('data-field') === field && String(els[i].getAttribute('data-text')) === val) return els[i].getAttribute('data-group') || fallback;
		}
		return fallback;
	}

	/* Parse q= → [{field, value, display, label}] */
	function parseQ(q) {
		if (!q) return [];
		var filters = [];

		_splitAnd(_decode(q)).forEach(function (clause) {
			clause = clause.trim();
			if (/^collections:\d/i.test(clause)) return; // implicit from URL path — skip

			/* price_min:(>X AND <Y) — chuẩn Sapo (đọc cả dạng cũ >= <=) */
			var pm = /^price_min:\(/i.test(clause) ? _parsePrice(clause) : null;
			if (pm) {
				filters.push({
					field: 'price_min',
					value: pm[0] + '__' + pm[1],
					display: _formatPrice(pm[0]) + ' – ' + (pm[1] >= PRICE_CAP ? _formatPrice(PRICE_CAP) + '+' : _formatPrice(pm[1])),
					label: LABELS['price_min']
				});
				return;
			}

			/* field:(content) */
			var fm = /^([\w.]+):\((.+)\)$/.exec(clause);
			if (!fm) return;
			var field = fm[1], inner = fm[2], lbl = LABELS[field] || field;

			/* Multi-value with quotes: ("A") OR ("B") */
			var qvs = inner.match(/"([^"]+)"/g);
			if (qvs) {
				qvs.forEach(function (v) {
					var val = v.replace(/"/g, '');
					filters.push({ field: field, value: val, display: val, label: _groupLabel(field, val, lbl) });
				});
			} else {
				/* Single unquoted: vendor:(Kozilar) or tags:(Da khô) */
				var val = inner.trim();
				filters.push({ field: field, value: val, display: val, label: _groupLabel(field, val, lbl) });
			}
		});

		return filters;
	}

	/* Return new q= string with one filter entry removed */
	function _rebuildQ(q, removeField, removeValue) {
		var newClauses = [];

		_splitAnd(_decode(q)).forEach(function (clause) {
			/* Always keep the collections: constraint if present */
			if (/^collections:\d/i.test(clause)) { newClauses.push(clause); return; }

			/* Drop the entire price_min clause */
			if (removeField === 'price_min' && /^price_min:/i.test(clause)) return;

			var fm = /^([\w.]+):\((.+)\)$/.exec(clause);
			if (!fm || fm[1] !== removeField) { newClauses.push(clause); return; }

			var inner = fm[2];
			var qvs = inner.match(/"([^"]+)"/g);
			if (qvs) {
				var remaining = qvs
					.map(function (v) { return v.replace(/"/g, ''); })
					.filter(function (v) { return v !== removeValue; });
				if (!remaining.length) return; // drop clause
				if (remaining.length === 1) {
					newClauses.push(removeField + ':(("' + remaining[0] + '"))');
				} else {
					newClauses.push(removeField + ':(' +
						remaining.map(function (v) { return '("' + v + '")'; }).join(' OR ') + ')');
				}
			} else {
				if (inner.trim() !== removeValue) newClauses.push(clause); // else drop
			}
		});

		return newClauses.join(' AND ');
	}

	/* Navigate to URL with one filter removed */
	function removeFilter(field, value) {
		var params = new URLSearchParams(window.location.search);
		var newQ = _rebuildQ(params.get('q') || '', field, value);
		/* Strip bare collections: constraint that may be left alone after removal */
		var displayQ = newQ
			.replace(/^collections:\d+\s*AND\s*/i, '')
			.replace(/\s*AND\s*collections:\d+/gi, '')
			.trim();
		if (displayQ) params.set('q', displayQ); else params.delete('q');
		params.delete('page');
		var qs = params.toString();
		window.location.href = window.location.pathname + (qs ? '?' + qs : '');
	}

	/* Render the active-bar chips from current URL */
	function renderBar() {
		var params = new URLSearchParams(window.location.search);
		var filters = parseQ(params.get('q') || '');

		var $bar   = $('#afw-active-bar');
		var $chips = $('#afw-active-chips');
		if (!$bar.length || !$chips.length) return;

		if (!filters.length) { $bar.attr('hidden', 'hidden'); $chips.empty(); if (typeof countFilterItem === 'function') countFilterItem(); return; }

		/* Group by label, preserving insertion order */
		var groups = {}, order = [];
		filters.forEach(function (f) {
			if (!groups[f.label]) { groups[f.label] = []; order.push(f.label); }
			groups[f.label].push(f);
		});

		$chips.empty();
		order.forEach(function (lbl) {
			var $g = $('<div class="afw-chip-group"></div>');
			$g.append($('<span class="afw-chip-group__label"></span>').text(lbl + ':'));
			groups[lbl].forEach(function (f) {
				var $chip = $('<span class="afw-chip"><span class="afw-chip__label"></span><button type="button" class="afw-chip__x" aria-label="Bỏ filter">×</button></span>');
				$chip.find('.afw-chip__label').text(f.display);
				/* Capture field + value in closure so each × button removes the right filter */
				(function (field, val) {
					$chip.find('.afw-chip__x').on('click', function () {
						CollectionFilter.removeFilter(field, val);
					});
				})(f.field, f.value);
				$g.append($chip);
			});
			$chips.append($g);
		});

		$bar.removeAttr('hidden');
		$('.afw-bar__count-num').text(filters.length);
		/* 18/11/2026: badge số tiêu chí ở nút lọc mobile (thanh Đang lọc bị ẩn ở mobile) phải cập nhật ngay sau khi dựng chip, kể cả lúc nạp trang. */
		if (typeof countFilterItem === 'function') countFilterItem();
	}

	return { parseQ: parseQ, renderBar: renderBar, removeFilter: removeFilter };
})();

/* F03 (phase home-shopping-ux, 2026-09-20): doSearch() không có bảo vệ chống request chồng —
   gõ nhanh/bấm nhiều filter liên tiếp bắn nhiều $.get() song song, và nếu request CŨ trả về SAU
   request MỚI (mạng chậm/không đều), .done() của nó vẫn chạy và ghi đè kết quả mới bằng kết quả cũ
   không còn đúng bộ lọc hiện tại. Thêm token tăng dần, chỉ áp dụng response của request mới nhất.
   Đồng thời .fail() cũ chỉ gỡ is-loading rồi im lặng — không có thông báo lỗi/thử lại, người dùng
   không biết filter có chạy hay không. */
var _doSearchToken = 0;

/* ── doSearch() — AJAX load results into #ajax-result ── */
function doSearch(page) {
	var view = (typeof selectedViewData !== 'undefined') ? selectedViewData : 'data';
	var settings = { page: page || 1, view: view };
	var sortVal = _sapoSort(_getParam('sortby'));
	if (sortVal) settings.sortby = sortVal;

	/* Khoảng giá ⇒ 1 tiêu chí price_min trong q (chuẩn Sapo), thay cho tham số rời &price_min/&price_max cũ. */
	var elMin = document.getElementById('afw-price-min');
	var elMax = document.getElementById('afw-price-max');
	filter.deleteGroup('Khoảng giá');
	if (elMin && elMax) {
		var priceVal = _priceExpr(parseInt(elMin.value, 10) || 0, parseInt(elMax.value, 10) || PRICE_CAP);
		if (priceVal) filter.addValue('Khoảng giá', 'price_min', priceVal, 'OR');
	}

	var url = filter.buildSearchUrl(settings);

	/* Pre-build the display q= for the address bar (chỉ tiêu chí lọc — không kèm ràng buộc danh mục, không kèm từ khoá trang tìm kiếm) */
	var rawQ = (function () {
		var m = /[?&]q=([^&]*)/.exec(url);
		return m ? decodeURIComponent(m[1]) : '';
	})();
	var displayQ = rawQ
		.replace(/^collections:\d+\s*AND\s*/i, '')
		.replace(/\s*AND\s*collections:\d+/gi, '')
		.trim();

	/* Trang /search: giữ từ khoá gốc (search.terms ở .search_content) — ghép "từ khoá AND tiêu chí lọc" (Sapo nối AND mặc định).
	   18/11 chỉ ghép khi chưa lọc ⇒ chọn 1 tiêu chí là mất từ khoá, ra kết quả của cả cửa hàng. */
	if (location.pathname.indexOf('/search') === 0) {
		var kwEl = document.querySelector('.search_content');
		var kw = kwEl ? kwEl.textContent.trim() : '';
		if (kw) url = url.replace(/([?&]q=)[^&]*/, '$1' + encodeURIComponent(rawQ ? kw + ' AND ' + rawQ : kw));
	}

	var $wrap = $('#ajax-result');
	$wrap.addClass('is-loading').find('.afw-error').remove();

	var myToken = ++_doSearchToken;

	$.get(url, function (html) {
		if (myToken !== _doSearchToken) return; /* có request mới hơn đã gửi sau — bỏ kết quả cũ này */
		$wrap.html(html).removeClass('is-loading');

		/* Keep address bar in sync so page reload / back-button preserves filter state */
		var newParams = new URLSearchParams(window.location.search);
		if (displayQ) newParams.set('q', displayQ); else newParams.delete('q');
		if (page > 1) newParams.set('page', String(page)); else newParams.delete('page');
		var qs = newParams.toString();
		history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));

		CollectionFilter.renderBar();
		if (typeof countFilterItem === 'function') countFilterItem();
		if (page > 1) {
			$('html, body').animate({ scrollTop: $wrap.offset().top - 100 }, 300);
		}
	}).fail(function () {
		if (myToken !== _doSearchToken) return;
		$wrap.removeClass('is-loading');
		$('<div class="afw-error">Không tải được kết quả lọc. <button type="button" class="afw-error__retry">Thử lại</button></div>')
			.find('.afw-error__retry').on('click', function () { doSearch(page); }).end()
			.prependTo($wrap);
	});
}

/* ── clearAllFiltered — navigate to collection URL without any filter ── */
function clearAllFiltered() {
	var params = new URLSearchParams(window.location.search);
	params.delete('q');
	params.delete('page');
	var qs = params.toString();
	window.location.href = window.location.pathname + (qs ? '?' + qs : '');
}

/* ── Main ── */
$(function () {

	/* ── Restore filter UI state from URL on page load ── */
	(function () {
		var qVal = new URLSearchParams(location.search).get('q') || '';

		if (qVal) {
			/* Restore checkboxes */
			$('.filter-checkbox-input').each(function () {
				var $cb   = $(this);
				var field = $cb.data('field');
				var text  = String($cb.data('text') || '');
				var fEsc  = field.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
				var tEsc  = text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
				if (!new RegExp(fEsc + ':[^)]*' + tEsc + '[^)]*\\)', 'i').test(qVal)) return;
				$cb.prop('checked', true);
				var $item = $cb.closest('.sapo-filter-item');
				if ($item.length) $item.addClass('is-active');
				filter.addValue($cb.data('group'), field, $cb.val(), $cb.data('operator') || 'OR');
			});

			/* Restore pills */
			$('.filter-pill-btn').each(function () {
				var $btn  = $(this);
				var field = $btn.data('field');
				var text  = String($btn.data('text') || '');
				var fEsc  = field.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
				var tEsc  = text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
				if (!new RegExp(fEsc + ':[^)]*' + tEsc + '[^)]*\\)', 'i').test(qVal)) return;
				$btn.addClass('active');
				filter.addValue($btn.data('group'), field, $btn.data('value'), $btn.data('operator') || 'OR');
			});

			/* Restore price slider from price_min:(>X AND <Y) — đọc cả dạng cũ >= <= */
			var pm = _parsePrice(qVal);
			if (pm) {
				var elMin = document.getElementById('afw-price-min');
				var elMax = document.getElementById('afw-price-max');
				if (elMin) { elMin.value = pm[0]; elMin.dispatchEvent(new Event('input')); }
				if (elMax) { elMax.value = pm[1]; elMax.dispatchEvent(new Event('input')); }
			}
		}

		/* Always render bar from URL — handles all filter types including price */
		CollectionFilter.renderBar();

		/* 20/11/2026: URL đang có tiêu chí lọc / sắp xếp (F5, nút Back, link chia sẻ) ⇒ trang render sẵn từ server là danh sách GỐC
		   (Sapo không áp q/sortby của theme vào collection.products) ⇒ tải lại kết quả đúng tiêu chí bằng AJAX như theme chuẩn. */
		if (qVal || _sapoSort(_getParam('sortby'))) doSearch(parseInt(_getParam('page'), 10) || 1);
	})();

	/* M-24 (PO chốt 17/11/2026): trong ngăn kéo mobile (< 992px) tick CHƯA lọc — chỉ lọc khi bấm nút "Tìm kiếm" ([data-filter-apply]); desktop lọc ngay như cũ. */
	function deferSearch() { return window.matchMedia('(max-width: 991px)').matches; }

	/* Checkbox filter */
	$(document).on('change', '.filter-checkbox-input', function () {
		var $cb = $(this);
		var group = $cb.data('group');
		var field = $cb.data('field');
		var value = $cb.val();
		var op    = $cb.data('operator') || 'OR';
		var $item = $cb.closest('.sapo-filter-item');
		if ($item.length) $item.toggleClass('is-active', $cb.is(':checked'));
		if ($cb.is(':checked')) filter.addValue(group, field, value, op);
		else filter.deleteValue(group, field, value, op);
		if (!deferSearch()) doSearch(1);
	});

	/* Pill button filter */
	$(document).on('click', '.filter-pill-btn', function () {
		var $btn  = $(this);
		var group = $btn.data('group');
		var field = $btn.data('field');
		var value = $btn.data('value');
		var op    = $btn.data('operator') || 'OR';
		$btn.toggleClass('active');
		if ($btn.hasClass('active')) filter.addValue(group, field, value, op);
		else filter.deleteValue(group, field, value, op);
		if (!deferSearch()) doSearch(1);
	});

	/* Price range — search on change event (fired by range slider on mouseup/touchend) */
	$(document).on('change', '.filter-range-input', function () {
		if (!deferSearch()) doSearch(1);
	});

	/* Mobile filter panel toggle */
	$(document).on('click', '.btn-filter-mobile', function () {
		if (!$('.filter-overlay').length) {
			/* 14/11/2026: lớp phủ + khoá cuộn bằng class Tailwind (assets/pc-ui.css) — không còn CSS .filter-overlay / body.filter-open */
			$('<div class="filter-overlay fixed inset-0 z-[99998] bg-slate-900/50 [display:none] [&.active]:[display:block]"></div>').appendTo('body');
		}
		$('.layout-collection .left-content').toggleClass('active');
		$('body').toggleClass('filter-open overflow-hidden');
		$('.filter-overlay').toggleClass('active');
	});
	$(document).on('click', '.btn-close-filter, .close-filters, .filter-overlay', function () {
		$('.layout-collection .left-content').removeClass('active');
		$('body').removeClass('filter-open overflow-hidden');
		$('.filter-overlay').removeClass('active');
	});
	/* F03 (phase home-shopping-ux, 2026-09-20): sheet bộ lọc mobile đã khoá cuộn nền
	   (body.filter-open) nhưng chưa đóng được bằng Escape — thêm cho đồng bộ với hành vi drawer
	   menu mobile (đã sửa ở header.bwt). */
	$(document).on('keydown', function (e) {
		if (e.key === 'Escape' && $('.layout-collection .left-content').hasClass('active')) {
			$('.layout-collection .left-content').removeClass('active');
			$('body').removeClass('filter-open overflow-hidden');
			$('.filter-overlay').removeClass('active');
			$('.btn-filter-mobile').trigger('focus');
		}
	});

	/* Filter group collapse/expand (B4) — M-24: ẩn/hiện phần thân nhóm bằng class Tailwind hidden, aria-expanded theo trạng thái */
	$(document).on('click', '.filter-group-toggle', function () {
		var $head = $(this).closest('h3');
		var $body = $head.siblings();
		var open = $body.first().hasClass('hidden');
		$body.toggleClass('hidden', !open);
		/* 20/11/2026: mũi tên xoay theo aria-expanded bằng class Tailwind trên nút (aside-filter.bwt) — trước đây JS xoay ngược (đóng ⇒ mũi tên lên). */
		$(this).attr('aria-expanded', open ? 'true' : 'false');
	});

	$(document).on('click', '[data-filter-apply]', function () {
		$('.layout-collection .left-content').removeClass('active');
		$('body').removeClass('filter-open overflow-hidden');
		$('.filter-overlay').removeClass('active');
		doSearch(1);
	});

	/* "Thiết lập lại" / "Xóa tất cả" / "Bỏ chọn hết" (M-24: thay onclick trong markup bằng móc [data-filter-reset]) */
	$(document).on('click', '[data-filter-reset]', function () {
		clearAllFiltered();
	});

});
