.pc-cg-hero {
  padding: 56px 0 32px;
  text-align: center;
  background: var(--mainColorLight);
}
.pc-cg-hero .pc-section-title {
  margin: 16px 0 12px;
  font-size: var(--fs-2xl);
  color: var(--textBody);
}
.pc-cg-hero-desc {
  max-width: 640px;
  margin: 0 auto;
  color: var(--textSub);
  line-height: 1.6;
}

.pc-cg-grid-section {
  padding: 48px 0 64px;
}
.pc-cg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 991px) {
  .pc-cg-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 599px) {
  .pc-cg-grid { grid-template-columns: 1fr; }
}

/* T-109 (2026-09-11) — BUG THẬT phát hiện khi chuẩn bị demo data: trang này dùng chung tên class
   .pc-testi-avatar/.pc-testi-avatar-initials/.pc-testi-avatar--img với snippets/section_testimonials.bwt
   nhưng KHÔNG include file đó (chủ đích, tránh dependency chéo giòn — xem comment đầu
   snippets/section_expert_team.bwt) và cũng KHÔNG tự định nghĩa lại các rule nền tảng của các
   class này ở đây — nên toàn bộ 12 avatar (6 bác sĩ + 6 khách hàng) hiện chữ viết tắt fallback
   ("NG", "TH"...) LUÔN hiện song song với ảnh thật, dù ảnh đã tải thành công (đúng ra fallback
   chỉ nên hiện khi ảnh lỗi/không có). Thêm bản sao rule nền tảng (bo tròn, flex canh giữa,
   overflow ẩn để ảnh phủ kín fallback + ẩn hẳn fallback khi có class --img) — tự chứa trong đúng
   file CSS riêng của trang này, không tạo lại dependency chéo. */
.pc-testi-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--mainColorDark);
  color: #fff;
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.pc-testi-avatar--img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.pc-testi-avatar--img .pc-testi-avatar-initials { display: none; }

.pc-cg-card { height: 100%; }
.pc-cg-avatar-row {
  display: flex;
  align-items: center;
  gap: 14px;
}
.pc-cg-avatar {
  width: 64px;
  height: 64px;
  font-size: var(--fs-base);
}
.pc-cg-name { margin: 0 0 2px; font-size: var(--fs-base); }
.pc-cg-role {
  font-size: var(--fs-xs);
  color: var(--textSub);
}
.pc-cg-specialty { margin-top: 4px; }
.pc-cg-bio {
  margin-top: 4px;
  font-size: var(--fs-sm);
}
.pc-cg-meta-row {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-xs);
  color: var(--textSub);
  padding-top: 12px;
  border-top: 1px solid var(--lineColor);
}
.pc-cg-quote {
  margin: 4px 0 0;
  padding: 12px 14px;
  background: var(--bg-subtle, #F8F9FA);
  border-left: 3px solid var(--mainColor);
  border-radius: 8px;
  font-size: var(--fs-sm);
  font-style: italic;
  color: var(--textBody);
}

.pc-cg-testi-section {
  padding: 48px 0 64px;
  background: var(--bg-subtle, #F8F9FA);
}
.pc-cg-testi-title { text-align: center; margin-bottom: 32px; }
.pc-cg-testi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 991px) { .pc-cg-testi-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 599px) { .pc-cg-testi-grid { grid-template-columns: 1fr; } }
.pc-cg-testi-quote {
  font-style: italic;
  min-height: 80px;
}
.pc-cg-testi-result {
  font-size: var(--fs-xs);
  color: var(--textSub);
}

.pc-cg-cta {
  text-align: center;
  padding: 56px 0;
  background: var(--subColor);
  color: #fff;
}
.pc-cg-cta .pc-section-title { color: #fff; margin-bottom: 8px; }
.pc-cg-cta p { opacity: 0.9; margin-bottom: 20px; }
.pc-cg-cta-btn {
  display: inline-block;
  padding: 14px 32px;
  background: var(--mainColor);
  color: #fff;
  border-radius: 50px;
  font-weight: 700;
  text-decoration: none;
  transition: transform .2s ease;
}
.pc-cg-cta-btn:hover { transform: translateY(-2px); color: #fff; }
