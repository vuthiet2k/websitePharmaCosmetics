/* comp_most_view.scss.bwt (2026-10-06) — khối app AppBulk "Sản phẩm xem nhiều nhất" (.ab-most-view-product-module),
   có ở trang chủ (snippets/home_portal.bwt), danh mục (templates/collection.bwt) và sản phẩm (templates/product.bwt).
   Trước đây chép 2 bản trong page_home + page_collection, trang sản phẩm không có ⇒ gom về 1 file nạp ở cả 3 trang.
   Markup do app chèn bằng JS, không sửa được HTML — chỉ restyle. */

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   App block: Most Viewed Products (.ab-most-view-product-module)
   Restyle to match section_featured_products — cannot modify HTML
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

/* 2026-10-06 (theme 1168609): khối nằm trong .pc-portal — reset `.pc-home-v3 .pc-portal * {margin:0;padding:0}`
   (home-portal.css, cùng độ ưu tiên, nạp sau) xoá padding nút/khung ⇒ nút còn 14px, thẻ dính mép. Bọc cả khối
   trong `body` để mọi rule hơn reset 1 bậc (0,x,1), không thêm cờ important. */
body {
  /* Section wrapper */
  .ab-most-view-product-module .most-view-module {
    background-color: var(--bg-subtle) !important;
    /* 2026-10-13 (người dùng: "không lệch so với các section khác"): cùng nhịp dọc section trang chủ
       (home-portal.css `.pc-portal section{padding:78px 0}`, ≤680px 54px). */
    padding: 78px 0 68px; /* đáy 68 + 10px đệm dưới của hàng thẻ (app) = 78 */
    @media (max-width: 680px) { padding: 54px 0 44px; }
    overflow: hidden;
  }

  /* Container — áp cho heading + body vì không có .container div. Có .most-view-module trong selector để hơn
     rule app `.ab-most-view-product-module .most-view-module .most-view-module-body {padding:10px 0}` (0,3,0)
     — thiếu nó thì lề 16px không bao giờ ăn, thẻ/tiêu đề dính mép màn hình (1168609). */
  .ab-most-view-product-module .most-view-module .most-view-module-heading,
  .ab-most-view-product-module .most-view-module .most-view-module-body {
    /* 2026-10-13: cùng khung .wrap của các section khác (max-width + lề theo token container, storefront-v3.css). */
    max-width: var(--pc-container-max, 1280px);
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: var(--pc-container-gutter, 32px);
    padding-right: var(--pc-container-gutter, 32px);
  }

  /* Header: title trái — pager phải
     DOM order: pager trước, title sau → dùng order + position để override app CSS */
  .ab-most-view-product-module .most-view-module-heading {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0;
    margin-bottom: 18px !important;
    position: relative;
  }
  .ab-most-view-product-module .most-view-module .most-view-module-title {
    order: 1;
    flex: 1;
    color: var(--mainColorDark) !important;
    font-size: var(--fs-xl) !important;
    font-weight: 700 !important;
    font-style: normal !important;
    font-family: var(--font-heading, var(--font-primary));
    text-align: left !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
    position: static !important;
  }
  /* 2026-10-13 (người dùng): bỏ đường kẻ dưới tiêu đề (app: border-bottom #cacaca); 2 nút ‹ › chuyển xuống 2 bên hàng sản phẩm,
     giữa chiều cao thẻ (thân khối lệch tâm khối ~37px vì tiêu đề ở trên), nút tròn trắng không viền (app: box-shadow inset). */
  .ab-most-view-product-module .most-view-module .most-view-module-heading {
    border-bottom: 0 !important;
    position: static !important; /* nút bám theo cả khối .most-view-module, không theo tiêu đề */
    padding-top: 0 !important;    /* app: padding 10px 0 — bỏ để tiêu đề → thẻ = 40px như .section-head */
    padding-bottom: 0 !important;
    margin-bottom: 30px !important; /* + 10px đệm trên của hàng thẻ (app, chừa bóng thẻ khi hover) = 40px */
  }
  .ab-most-view-product-module .most-view-module .most-view-module-body {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  .ab-most-view-product-module .most-view-module {
    position: relative;
  }
  .ab-most-view-product-module .most-view-module .most-view-module-heading .most-view-module-pager {
    position: absolute !important;
    z-index: 3;
    top: calc(50% + 37px);
    left: 50%;
    width: calc(min(var(--pc-container-max, 1280px), 100%) - 2 * var(--pc-container-gutter, 32px));
    transform: translate(-50%, -50%);
    display: flex !important;
    justify-content: space-between;
    padding: 0 !important;
    float: none !important;
    pointer-events: none;
  }
  .ab-most-view-product-module .most-view-module .most-view-btn-pager {
    pointer-events: auto;
    width: 40px;
    height: 40px;
    border: 0 !important;
    border-radius: 50% !important;
    background: #fff !important;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .14) !important;
    color: var(--mainColorDark) !important;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin: 0 !important;
    padding: 0 !important;
    transition: color .2s, background .2s, opacity .2s;
    &:hover, &:focus-visible {
      background: var(--mainColor) !important;
      color: #fff !important;
    }
    &.swiper-button-disabled {
      opacity: .35;
      cursor: default;
    }
  }
  /* Desktop: nút nằm đè nửa ra ngoài mép thẻ; màn nhỏ (khối tràn sát mép, overflow:hidden) giữ nút trong khung. */
  @media (min-width: 1340px) {
    .ab-most-view-product-module .most-view-module .most-view-btn-pager-prev { transform: translateX(-50%); }
    .ab-most-view-product-module .most-view-module .most-view-btn-pager-next { transform: translateX(50%); }
  }

  /* Product card */
  .ab-most-view-product-module .most-view-product-element {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--lineColor, #e8e8e8);
    display: flex !important;
    flex-direction: column;
    height: auto !important;
    transition: box-shadow .2s, transform .2s;
    &:hover {
      box-shadow: 0 8px 24px rgba(0,0,0,.1);
      transform: translateY(-2px);
    }
  }

  /* Image */
  /* Selector đủ dài để hơn rule app (0,5,0) `.ab-most-view-product-module .most-view-module
     .most-view-module-products-slide .most-view-product-element .most-view-product-img {height:260–330px}` —
     height cố định làm aspect-ratio bị bỏ qua, lộ dải nền xám dưới ảnh. */
  .ab-most-view-product-module .most-view-module .most-view-module-products-slide .most-view-product-element .most-view-product-img {
    aspect-ratio: 1 / 1;
    height: auto;
    padding: 0;
    overflow: hidden;
    background: #fff;
    flex-shrink: 0;
  }
  .ab-most-view-product-module .most-view-product-img img {
    width: 100%;
    height: 100%;
    /* ảnh sản phẩm nền trắng: contain để không cắt mất hộp/tuýp sản phẩm. */
    object-fit: contain;
    display: block;
    transition: transform .35s ease;
  }
  .ab-most-view-product-module .most-view-product-element:hover .most-view-product-img img {
    transform: scale(1.04);
  }

  /* Content area */
  .ab-most-view-product-module .most-view-product-element > a {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }
  .ab-most-view-product-module .most-view-product-content {
    padding: 12px 12px 0 !important;
    min-height: unset !important;
    height: auto !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ab-most-view-product-module .most-view-product-name {
    max-height: unset !important;
    flex: 1;
  }
  .ab-most-view-product-module .most-view-product-name p {
    font-family: var(--font-primary);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--textColor, #333);
    line-height: 1.45;
    text-align: left;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Price */
  .ab-most-view-product-module .most-view-product-price {
    padding: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ab-most-view-product-module .most-view-product-price .money {
    color: var(--mainColor) !important;
    font-size: var(--fs-base);
    font-weight: 700;
  }
  .ab-most-view-product-module .most-view-product-oldprice {
    color: #999 !important;
    font-size: var(--fs-xs, 12px);
    font-weight: 400;
    text-decoration: line-through;
  }

  /* Action button */
  .ab-most-view-product-module .most-view-product-action {
    padding: 0 12px 12px;
  }
  .ab-most-view-product-module .most-view-product-to-cart {
    margin: 0;
  }
  .ab-most-view-product-module .most-view-btn-cart {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    /* vendor_appbulk.css đặt line-height: 12px cho .most-view-btn ⇒ chữ tràn khỏi nền. */
    line-height: 1.3;
    padding: 9px 12px;
    background: var(--mainColorDark) !important;
    color: #fff !important;
    border: none;
    border-radius: 8px;
    font-family: var(--font-primary);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-align: center;
    text-decoration: none !important;
    cursor: pointer;
    transition: background .2s, transform .2s;
    &:hover {
      background: var(--mainColor) !important;
      transform: translateY(-1px);
    }
  }

}
