								@media (min-width: 1200px) {
									&:before {
										content: attr(title);
										position: absolute;
										bottom: calc(100% + 8px);
										left: 50%;
										padding: 3px 7px;
										background: #666;
										color: #fff;
										border-radius: 5px;
										font-size: var(--fs-base);
										white-space: nowrap;
										display: inline-block;
										transform: translate(-50% ,0%);
									}
									&:after {
										display: block;
										position: absolute;
										border: 10px solid transparent;
										border-top-color: #666;
										content: "";
										left: 50%;
										bottom: calc(100% + -7px);
										z-index: -1;
										transform: translate(-50%, 0%);
									}
								}
							}
						}
					}
				}
			}


			.boz-form{
				.flex-quantity {
					display: flex;
					flex-wrap: wrap;
					gap: 20px;
					.custom-btn-number {
						display: flex;
						align-items: center;
						> span {
							margin-right: 8px;
							font-weight: 600;
						}
						.input_number_product {
							display: inline-flex;
							vertical-align: top;
							white-space: nowrap;
							input#qtym{
								width: 60px;
								border-radius: 0;
								border-right: none;
								border-left: none;
								padding: 0px;
								margin: 0px;
								text-align: center;
								height:35px;
								min-height: 35px;
							}
							.btn_num {
								padding: 0 5px;
								min-width: 35px;
								min-height: unset;
								height: 35px;
								border: 1px solid #ddd;
								background: #f3f3f3;
								box-shadow: none;
								&:hover {
									background: var(--mainColor);
									color: #fff;
								}
							}
							.num_1 {
								border-radius: 0;
								border-top-left-radius: 8px;
								border-bottom-left-radius: 8px;
							}
							.num_2 {
								border-radius: 0;
								border-top-right-radius: 8px;
								border-bottom-right-radius: 8px;
							}
						}
					}
					.buynow span:first-child{
						position: static;
						padding-left: 0;
						font-weight: 400;
						margin-bottom: 0;
					}

					.buynow span:first-child:before{
						content: none;
							}
					.buynow {
						text-decoration: none;
						display: -webkit-box;
						display: -ms-flexbox;
						display: flex;
						flex-flow: row;
						gap: 8px;
						-webkit-box-pack: start;
						-ms-flex-pack: start;
						justify-content: flex-start;
						-webkit-box-align: center;
						-ms-flex-align: center;
						align-items: center;
						height: 55px !important;
						line-height: 1.2 !important;
						padding-left: 20px;
						background: var(--mainColor);
						color: #fff;
						font-size: var(--fs-base);
						text-transform: uppercase;
						border: 1px solid var(--mainColor);
						border-radius: 10px;
						font-weight: bold;
						width: 100%;
