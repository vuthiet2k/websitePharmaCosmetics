							&.{{title}}{
								label{
									background-color:{{color1}};
									min-width: 30px;
									height: 30px;
								}
							}
							{%endif%}
							{%endfor%}
							label{
								border-radius: 50%;
							}
							input:checked+label{
								border: 2px solid #f1f1f1;
								box-shadow: 0 2px 5px rgba(0,0,0,0.5);

							}
