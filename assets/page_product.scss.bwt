@mixin controlswiper(){
	.swiper-pagination-bullets{
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 4px;
		.swiper-pagination-bullet{
			box-shadow: none;
			outline: 0;
			width: 10px;
			height: 10px;
			border: 1px solid #ddd;
			border-radius: 50%;
			background: rgba(255, 255, 255 ,0.2);
			padding: 0;
			font-size: 0;
			opacity: 1;
			&.swiper-pagination-bullet-active{
				transition: all .2s;
				background: var(--mainColor);
			}
		}
	}
	.swiper-button-next{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		right: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(32px , -50%);
		-ms-transform: translate(32px, -50%);
		transform: translate(32px, -50%);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%);
		transform: translateY(-50%);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	.swiper-button-prev{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		left: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(-32px, -50%) rotate(180deg);
		-ms-transform: translate(-32px, -50%) rotate(180deg);
		transform: translate(-32px, -50%) rotate(180deg);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%) rotate(180deg);
		transform: translateY(-50%) rotate(180deg);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	@media(max-width: 767px) {
		.swiper-button-next,.swiper-button-prev{
			width: 25px;
			height: 25px;
			line-height: 25px;
			&:after {
				font-size: var(--fs-sm);
			}
		}
	}
	.swiper-button-lock {
		display: none !important;
	}
	.swiper-button-disabled{
		opacity: 0.35;
	}
}
.layout-product{
	padding-bottom: 20px;
	.selector-wrapper {
		display: none !important;
	}
}
@media (min-width: 1199px) {
	.sticky_left {
		position: sticky !important;
		top: 60px;
	}

}
@media (min-width: 1024px) {
	.box_info_right {
		position: sticky !important;
		top: 60px;
	}

}
@media(min-width: 992px) and (max-width: 1199px) {
	.sticky_left {
		margin-top: 15px
	}

}
.details-product {
	.product-images {
		position: relative;
		.sticky {
			@media (min-width: 992px) {
				position: sticky !important;
				top: 60px;
			}
			.product-image-block {
				margin-bottom: 20px;
			}
		}

	}
	.details-pro {
		.title-product {
			font-size: 1.5625rem;
			margin: 0px 0px 5px;
			line-height: 1.4;
			font-weight: 700;
		}
		.a-sku {
			color: var(--mainColor);
		}
		.product-top {
			display: flex;
			.sku-product {
				font-size: var(--fs-md);
				display: flex;
				margin-right: 15px;
				span:last-child {
					margin-right: 0px;
				}
			}
			.product-review {
				display: flex;
				cursor: pointer;
				align-items: center;
				.sapo-product-reviews-badge {
					margin-right: 5px;
				}
			}
		}
		.form-product {
			margin-bottom: 20px;
		}
		.inventory_quantity {
			font-size: var(--fs-md);
			border-bottom: 1px solid #DDE1EF;
			padding-bottom: 12px;
			margin-bottom: 12px;
			.a-stock {
				color: var(--mainColor);
			}
			.a-vendor{
				color: var(--mainColor);
			}
			@media (max-width: 480px) {
				.line {
					display: block;
					width: 100%;
					height: 0px;
					visibility: hidden;
				}
			}
		}
		.form-inline{
			margin-bottom: 20px;
			.price-box{
				padding-bottom: 10px;
				.special-price {
					font-size: 1.4375rem;
					font-weight: bold;
					color: var(--price);
				}
				.old-price {
					color: #acacac;
					font-size: var(--fs-lg);
					margin-left: 4px;
				}
				.sale-off {
					color: #fff;
					position: relative;
					bottom: 1px;
					background: #B11111;
					padding: 2px 4px;
					border-radius: 5px;
					font-size: var(--fs-sm);
					min-width: 20px;
					margin-left: 15px;
					&:after {
						border-right: 6px solid #B11111;
						border-bottom: 6px solid transparent;
						border-top: 6px solid transparent;
						content: "";
						position: absolute;
						top: 50%;
						left: -4px;
						transform: translate(0%, -50%);
					}
				}
			}

			.select-swatch {
				margin-bottom: 20px;
				.swatch{
					font-size: var(--fs-md);
					.header{
						margin-bottom: 8px;
						font-size: var(--fs-lg);
						color: #444B52;
						display: flex;
						align-items: center;
						justify-content: space-between;
						.value-roperties {
							font-weight: 600;
							color: var(--mainColor);
							margin-left: 5px;
						}
						a{
							color: var(--mainColor);
							text-decoration: underline;
							&:hover{
								color: var(--subColor);
							}
						}

					}
					.swatch-element {
						display: inline-block;
						margin: 0px 8px 8px 0;
						input{
							display: none;
						}
						label{
							min-width: 30px;
							height: 30px;
							display: inline-flex;
							align-items: center;
							justify-content: center;
							border: 1px solid #ddd;
							cursor: pointer;
							white-space: nowrap;
							padding: 0 5px;
							position: relative;
							margin-bottom: 0;
							text-align: center;
							border-radius: 8px;
							line-height: 28px;
							.crossed-out{
								display: none;
							}

						}
						input:checked+label {
							background: var(--mainColor);
							border-color: #ddd;
							color: #fff;
						}
						.tooltip{
							display: none;
						}
						&.soldout {
							position: relative;
							label{
								position: relative;
							}
						}
						&.color{
							position: relative;
							{%for i in (1..20)%}
							{% capture label%}color_{{i}}{%endcapture%}                            
							{% assign title = settings[label]| downcase | handle%}
							{% capture color%}color_{{i}}_c{%endcapture%}			
							{% assign color1 = settings[color] %}
							{%if title != null and title != '' %}
							&.{{title}}{
								label{
									background-color:{{color1}};
									min-width: 30px;
									height: 30px;
								}
							}
							{%endif%}
							{%endfor%}
							label{
								border-radius: 50%;
							}
							input:checked+label{
								border: 2px solid #f1f1f1;
								box-shadow: 0 2px 5px rgba(0,0,0,0.5);

							}
							&:hover {
								@media (min-width: 1200px) {
									&:before {
										content: attr(title);
										position: absolute;
										bottom: calc(100% + 8px);
										left: 50%;
										padding: 3px 7px;
										background: #666;
										color: #fff;
										border-radius: 5px;
										font-size: var(--fs-base);
										white-space: nowrap;
										display: inline-block;
										transform: translate(-50% ,0%);
									}
									&:after {
										display: block;
										position: absolute;
										border: 10px solid transparent;
										border-top-color: #666;
										content: "";
										left: 50%;
										bottom: calc(100% + -7px);
										z-index: -1;
										transform: translate(-50%, 0%);
									}
								}
							}
						}
					}
				}
			}


			.boz-form{
				.flex-quantity {
					display: flex;
					flex-wrap: wrap;
					gap: 20px;
					.custom-btn-number {
						display: flex;
						align-items: center;
						> span {
							margin-right: 8px;
							font-weight: 600;
						}
						.input_number_product {
							display: inline-flex;
							vertical-align: top;
							white-space: nowrap;
							input#qtym{
								width: 60px;
								border-radius: 0;
								border-right: none;
								border-left: none;
								padding: 0px;
								margin: 0px;
								text-align: center;
								height:35px;
								min-height: 35px;
							}
							.btn_num {
								padding: 0 5px;
								min-width: 35px;
								min-height: unset;
								height: 35px;
								border: 1px solid #ddd;
								background: #f3f3f3;
								box-shadow: none;
								&:hover {
									background: var(--mainColor);
									color: #fff;
								}
							}
							.num_1 {
								border-radius: 0;
								border-top-left-radius: 8px;
								border-bottom-left-radius: 8px;
							}
							.num_2 {
								border-radius: 0;
								border-top-right-radius: 8px;
								border-bottom-right-radius: 8px;
							}
						}
					}
					.buynow span:first-child{
						position: static;
						padding-left: 0;
						font-weight: 400;
						margin-bottom: 0;
					}

					.buynow span:first-child:before{
						content: none;
							}
					.buynow {
						text-decoration: none;
						display: -webkit-box;
						display: -ms-flexbox;
						display: flex;
						flex-flow: row;
						gap: 8px;
						-webkit-box-pack: start;
						-ms-flex-pack: start;
						justify-content: flex-start;
						-webkit-box-align: center;
						-ms-flex-align: center;
						align-items: center;
						height: 55px !important;
						line-height: 1.2 !important;
						padding-left: 20px;
						background: var(--mainColor);
						color: #fff;
						font-size: var(--fs-base);
						text-transform: uppercase;
						border: 1px solid var(--mainColor);
						border-radius: 10px;
						font-weight: bold;
						width: 100%;
						margin-bottom: 10px;
						i { font-size: 1em; }
						@media(min-width: 992px) and (max-width: 1199px) {
							font-size: var(--fs-base);
						}
						@media(min-width: 767px) and (max-width:992px) {
							width: calc(50% - 5px);
							margin-right: 10px;
							margin-bottom: 0px;
						}
						&:hover {
							background: var(--mainColor) !important;
							opacity: 0.8;
							color: #fff !important;
						}
					}
					.buynow span{
						text-transform: initial;
						font-weight: 400;
					}
					.button_actions {
						display: block;
						width: 100%;
						@media(min-width: 767px) and (max-width:992px) {
							.box_btn_acc {
								display: flex;
								flex-wrap: wrap;
								width: 100%;
								justify-content: space-between;
								align-items: center;
							}
						}
						.btn{
							background: var(--mainColor);
							color: #fff;
							padding: 0px 20px;
							font-size: var(--fs-base);
							text-transform: uppercase;
							border: 1px solid var(--mainColor);
							height: 55px;
							border-radius: 10px;
							width: 100%;
							display: flex;
							align-items: center;
							justify-content: flex-start;
							gap: 8px;
							i { font-size: 1em; }
							@media(min-width: 992px) and (max-width: 1199px) {
								font-size: var(--fs-base);
							}
							@media(max-width: 322px) {
								padding: 0px 10px;
							}
							&.btn[disabled]{
								opacity: 0.6;
								background-color: #727272 !important;
								border: 1px solid #727272;
							}
						}
						.btn_add_cart, .btn-installment {
							border: 1px solid var(--subColor);
							background-color: var(--subColor);
							color: #fff;
							font-weight: bold;
							width: 100%;
							@media(min-width: 767px) and (max-width:992px) {
								width: calc(50% - 5px);
							}
							&:hover {
								opacity: 0.8;
							}
						}
						.btn-installment {
							margin-left: 10px;
							line-height: initial !important;
							text-decoration: none;
							display: -webkit-box;
							display: -ms-flexbox;
							display: flex;
							flex-flow: column;
							-webkit-box-pack: center;
							-ms-flex-pack: center;
							justify-content: center;
							-webkit-box-align: center;
							-ms-flex-align: center;
							align-items: center;
							height: 55px !important;
							line-height: 16px !important;
							background-color: #0074bf;
							color: #fff;
							border: 1px solid #0074bf;
							span {
								text-transform: initial !important;
								font-weight: 400;
							}
						}
						#buyButton {
							margin: 0;
						}
					}
				}
			}
		}

		.form-inline-1{
			margin-bottom: 20px;
			.price-box{
				padding-bottom: 10px;
				.special-price {
					font-size: 1.4375rem;
					font-weight: bold;
					color: var(--price);
				}
				.old-price {
					color: #acacac;
