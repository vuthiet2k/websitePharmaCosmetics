							font-size: var(--fs-base);
						}
						@media(min-width: 767px) and (max-width:992px) {
							width: calc(50% - 5px);
							margin-right: 10px;
							margin-bottom: 0px;
						}
						&:hover {
							background: var(--mainColor) !important;
							opacity: 0.8;
							color: #fff !important;
						}
					}
					.buynow span{
						text-transform: initial;
						font-weight: 400;
					}
					.button_actions {
						display: block;
						width: 100%;
						@media(min-width: 767px) and (max-width:992px) {
							.box_btn_acc {
								display: flex;
								flex-wrap: wrap;
								width: 100%;
								justify-content: space-between;
								align-items: center;
							}
						}
						.btn{
							background: var(--mainColor);
							color: #fff;
							padding: 0px 20px;
							font-size: var(--fs-base);
							text-transform: uppercase;
							border: 1px solid var(--mainColor);
							height: 55px;
							border-radius: 10px;
							width: 100%;
							display: flex;
							align-items: center;
							justify-content: flex-start;
							gap: 8px;
							i { font-size: 1em; }
							@media(min-width: 992px) and (max-width: 1199px) {
								font-size: var(--fs-base);
							}
							@media(max-width: 322px) {
								padding: 0px 10px;
							}
							&.btn[disabled]{
								opacity: 0.6;
								background-color: #727272 !important;
								border: 1px solid #727272;
							}
						}
						.btn_add_cart, .btn-installment {
							border: 1px solid var(--subColor);
							background-color: var(--subColor);
							color: #fff;
							font-weight: bold;
							width: 100%;
							@media(min-width: 767px) and (max-width:992px) {
								width: calc(50% - 5px);
							}
							&:hover {
								opacity: 0.8;
							}
						}
						.btn-installment {
							margin-left: 10px;
							line-height: initial !important;
							text-decoration: none;
							display: -webkit-box;
							display: -ms-flexbox;
							display: flex;
							flex-flow: column;
							-webkit-box-pack: center;
							-ms-flex-pack: center;
							justify-content: center;
							-webkit-box-align: center;
							-ms-flex-align: center;
							align-items: center;
							height: 55px !important;
							line-height: 16px !important;
							background-color: #0074bf;
							color: #fff;
							border: 1px solid #0074bf;
							span {
								text-transform: initial !important;
								font-weight: 400;
							}
						}
						#buyButton {
							margin: 0;
						}
					}
				}
			}
		}


		.bottom-product {
			display: grid;
			align-items: center;
			gap: 15px;
			width: 100%;
			margin-top: 15px;
			margin-bottom: 15px;
			grid-template-columns: repeat(1, 1fr);
			.social-media {
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: var(--fs-md);
				li {
					&.title {
						svg {
							width: 20px;
							height: 20px;
							margin-right: 4px;
							position: relative;
							bottom: 1px;
						}
					}
					a {
						width: 24px;
						height: 24px;
						border-radius: 6px;
						background: var(--mainColor);
						display: flex;
						justify-content: center;
						align-items: center;
						svg {
							width: 16px;
							height: 16px;
							path {
								fill: #fff !important;
							}
						}
						&:hover {
							background: var(--subColor);
						}
					}
				}
			}
			.product-wish {
				a {
					display: flex;
					align-items: center;
					font-size: var(--fs-md);
					img {
						width: 24px;
						height: 24px;
						margin-right: 8px;
						position: relative;
						bottom: 1px;
					}
				}
			}
			.line {
				width: 1px;
				height: 20px;
				margin: 0 4px;
				background: #ddd;
			}
		}
	}
	@media (max-width: 991px) {
		.details-pro{
			.form-inline{
				.boz-form{ 
					.flex-quantity {
						.button_actions {
							.btn{
								padding: 8px 10px;
								&:first-child {
									margin-right: 10px;
								}
								&.btn-buyNow{
									font-size: var(--fs-md);
									@media (max-width: 321px) {
										font-size: var(--fs-sm);
									}
									span.txt-main {
										font-size: var(--fs-lg);
										@media (max-width: 321px) {
											font-size: var(--fs-md);
										}
									}
								}
								&.btn_add_cart {
									padding: 8px 13px;
									&[disabled="disabled"] {
										height: 50px;
										span.txt-main {
											font-size: var(--fs-lg);
											display: block;
										}
									}
								}
							}

							@media (max-width: 767px) {
								width: 100%;
								.btn {
									width: 100%;
								}
							}
						}
					}
				}
			}
		}

		.details-pro{
			.form-inline-1{
				.boz-form{ 
					.flex-quantity {
						.button_actions {
							.btn{
								padding: 8px 10px;
								&:first-child {
									margin-right: 10px;
								}
								&.btn-buyNow{
									font-size: var(--fs-md);
									@media (max-width: 321px) {
										font-size: var(--fs-sm);
									}
									span.txt-main {
										font-size: var(--fs-lg);
										@media (max-width: 321px) {
											font-size: var(--fs-md);
										}
									}
								}
								&.btn_add_cart {
									padding: 8px 13px;
									&[disabled="disabled"] {
										height: 50px;
										span.txt-main {
											font-size: var(--fs-lg);
											display: block;
										}
									}
								}
							}

							@media (max-width: 767px) {
								width: 100%;
								.btn {
									width: 100%;
								}
							}
						}
					}
				}
			}
		}
	}
}
.block-flashsale {
	display: flex;
	align-items: center;
	justify-content:space-between;
	padding: 5px;
	width: 100%;
	background-color: #ad0000;
	border-radius: 5px;
	margin-top: 15px;
	margin-bottom: 30px;
	color: #fff;
	.heading-flash {
		display: flex;
		align-items: center;
		font-weight: 600;
		font-size: var(--fs-base);
		svg {
			width: 26px;
			height: 26px;
			margin-right: 3px;
			position: relative;
			bottom: 2px;
		}
	}
	.count-down {
		flex-grow: 0;
		display: flex;
		align-items: center;
		min-height: 36px;
		.timer-view{
			display: inline-block;
			text-align: left;
			.block-timer {
				height: auto;
				width: 36px;
				background: #000;
				border-radius: 5px;
				display: inline-block;
				padding: 5px 0px 5px;
				margin-right: 5px;
				text-align: center;
				&:last-child {
					margin-right: 0px;
				}
				p {
					display: block;
					font-weight: 500;
					color: #fff;
					font-size: var(--fs-base);
					margin: 0;
					line-height: 1.2;
				}
				span {
					display: block;
					color: #fff;
					font-size: var(--fs-xs);
					line-height: 1.3;
				}
			}
		}
	}
}
.product-summary {
	margin-bottom: 20px;
	font-size: var(--fs-md);
	p {
		margin-bottom: 0px;
	}
	img{
		display: none;
	}
	a {
		color: blue;
		text-decoration: underline;
		&:hover {
			color: var(--subColor);
		}
	}
	.rte {
		ul {
			list-style: initial; 
			padding-left: 25px;
			margin-bottom: 10px;
		}
	}
}
.product-review-details {
	.product-tab{

		.box_review {
			display: block;
			.alert {
				padding: 0px;
			}
		}
		.tabs-title {
			padding: 0;
			margin: 0;
			list-style: none;
			display: flex;
			border-bottom: 1px solid #dee2e6;
			margin-bottom: 15px;
		}
		.tab-link{
			cursor: pointer;
			padding: 5px 0px;
			margin-right: 30px;
			h3{
				color: #333;
				padding: 0;
				margin: 0;
				font-size: var(--fs-xl);
				font-weight: bold;
				@media(max-width: 767px) {
					font-size: var(--fs-lg);
				}
			}
			&.active{
				border-bottom:1px solid;
				color: var(--mainColor);
				h3{
					color: var(--mainColor);
				}
			}
		}
		.tab-float {
			.tab-content{
				opacity: 0;
				visibility: hidden;
				height: 0;
				overflow: hidden;
				&.active{ 
					opacity: 1;
					visibility: visible;
					height: auto;
				}
			}
			.rte {
				position: relative;
				.ba-text-fpt {
					transition: 0.5s all;
					h2, h3 {
						transition: 0.5s all;
					}
					&.font-large {
						font-size: var(--fs-xl);
						h2 {
							font-size: var(--fs-3xl);
						}
						h3 {
							font-size: 1.21875rem;
						}
					}
					&.has-height{
						height:800px;
						overflow: hidden;
						transition: 0.5s all;
					}
				}
				&.expanded{
					.ba-text-fpt{
						height: auto;
						margin-bottom: 30px;
						transition: 0.5s all;
					}
					.less-text {
						display: block;
					}
					.more-text {
						display: none;
					}
					.show-more{
						&::before{
							display:none;
						}
					}
				}
				.show-more{
					position: relative;
					.btn--view-more {
						position: relative;
						bottom: 0px;
						left: 50%;
						transform: translate(-50%, 0);
						width: auto;
						margin-top: 0px;
						border-radius: 10px;
						svg {
							width: 12px;
							height: 12px;
						}
						&.active{
							bottom: 0;
						}
					}
					&::before {
						height: 55px;
						margin-top: -45px;
						content: "";
						display: block;
						background: transparent;
						background: -moz-linear-gradient(top,rgba(255,255,255,0) 0,rgba(255,255,255,.91) 50%,#fff 55%);
						background: -webkit-gradient(left top,left bottom,color-stop(0,rgba(255,255,255,0)),color-stop(50%,rgba(255,255,255,.91)),color-stop(55%,#fff));
						background: -webkit-linear-gradient(top,rgba(255,255,255,0) 0,rgba(255,255,255,.91) 50%,#fff 55%);
						background: -o-linear-gradient(top,rgba(255,255,255,0) 0,rgba(255,255,255,.91) 50%,#fff 55%);
						background: -ms-linear-gradient(top,rgba(255,255,255,0) 0,rgba(255,255,255,.91) 50%,#fff 55%);
						background: linear-gradient(to bottom,rgba(255,255,255,0) 0,rgba(255,255,255,.91) 50%,#fff 55%);
					}
				}
				.less-text {
					display: none;
				}
				img{
					max-width: 100% !important;
					height: auto !important;
				}
				ul { 
					list-style: initial; 
					padding-left: 25px;
					margin-bottom: 15px;
				} 
				a {
					color: blue;
					text-decoration: underline;
					&:hover {
						color: var(--subColor);
					}
				}
			} 
		}

	}
	@media (max-width: 767px){
		margin-bottom: 25px;
		.product-tab  {
			margin-top: 0px;
			.tabs-title{
				display: block;
				width: 100%;
				max-width: unset;
				height: auto;
				white-space: nowrap;
				overflow-x: scroll;
			}
		}
		.title-product{
			margin-top: 15px;
			line-height: 24px;
		}
	}
}
.product-sidebar {
	@media (min-width: 992px) {
		.sticky-box {
			position: sticky;
			top: 60px;
			z-index: 1;
		}
	}
	.specifications{
		.title{
			color: var(--textColor);
			margin: 0;
			font-size: var(--fs-xl);
			font-weight: 600;
			padding: 6px 0px;
			border-bottom: 1px solid #dee2e6;
			margin-bottom: 15px;
			line-height: 1.4;
		}
		.box_content_spe {
			max-height: 300px;
			overflow: hidden;
		}
		table{
			border-collapse: collapse;
			width: 100%;
			margin-bottom: 5px;
			text-align: left !important;
			tr:nth-child(odd){
				background-color: #F7F7F7;
			}
			td {
				border: 0px !important;
				padding: 6px 10px;
				font-size: var(--fs-md);
				text-align: left !important;
				p {
					margin-bottom: 0px;
				}
				&:first-child {
					width: 126px;
				}
				@media (max-width: 991px) {
					text-align: left;
					&:first-child {
						width: 145px;
					}
				}
			}
			&+p{
				display:none;
			}
		}
		.specifications-button-show {
			margin-top: 20px;
			text-align: center;
			position: relative;
			&::before {
				height: 50px;
				margin-top: -50px;
				content: "";
				display: block;
				background: transparent;
				background: -moz-linear-gradient(top, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.6) 50%, #fff 55%);
				background: -webkit-gradient(left top, left bottom, color-stop(0, rgba(255, 255, 255, 0.2)), color-stop(50%, rgba(255, 255, 255, 0.6)), color-stop(55%, #fff));
				background: -webkit-linear-gradient(top, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.6) 50%, #fff 55%);
				background: -o-linear-gradient(top, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.6) 50%, #fff 55%);
				background: -ms-linear-gradient(top, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.6) 50%, #fff 55%);
				background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.6) 50%, #fff 55%);
				transition: 0s all;
			}
			.specifications-button{
				margin: 0 auto;
				padding: 0px 20px;
				height: 40px;
				line-height: 40px;
				border-radius: 10px;
				color: #fff;
				position: relative;
				display: inline-block;
				background-color: var(--mainColor);
				width: auto;
				border:none !important;
				outline:none !important;
				box-shadow:none !important;
				display: flex;
				align-items: center;
				font-size: var(--fs-md);
				svg {
					margin-left: 5px;
					width:12px;
					height: 12px;
				}
				&:hover, &:focus{
					border:none;
					outline:none;
					box-shadow:none;
					background-color: var(--subColor);
				}
			}
		}
		@media(max-width: 767px) {
			.title{
				font-size: var(--fs-xl);
			}
		}
	}

}

#specificationsModal {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.modal-specificationsModal-product {
		position: absolute;
		width:650px;
		top: 50px;
		height: auto;
		margin: 0 auto;
		left: 0;
		right: 0;
		padding: 20px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 10px;
		@media(max-width: 767px) {
			width: 100%;
			height: 100%;
			top: 0;
			padding: 10px;
			overflow: hidden;
			border-radius: 0px;
		}
		.specifications-close{
			position: absolute;
			right: 8px;
			top: 8px;
			color: #000000;
			width: 23px;
			height: 23px;
			display: flex;
			justify-content: center;
			align-items: center;
			svg {
				width: 23px;
				height: 23px;
				transition: transform 0.3s;
			}
			&:hover{
				svg {
					transform: rotate(90deg);
				}
			}

		}
	}
	.modalsize-overlay {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}
	.title-popup {
		font-size: var(--fs-xl);
		font-weight: 600;
		margin-bottom: 10px;
	}
	.modal-body{
		padding: 0px;
		max-height: 600px;
		overflow-y: auto;
		&::-webkit-scrollbar-track {
			border-radius: 3px;
			background-color:#f7f8fa
		}
		&::-webkit-scrollbar {
			width: 6px;
		}
		&::-webkit-scrollbar-thumb {
			border-radius:3px;
			background-color: #e0e0e0;
		}
		table{
			border-collapse: collapse;
			width: 100%;
			tr:nth-child(odd){
				background-color: #F7F7F7;
			}
			td {
				border: 1px solid #dee2e6;
				padding: 6px 10px;
				text-align: left;
				p {
					margin-bottom: 0px;
				}
				&:first-child {
					width: 126px;
				}
			}
		}
		@media (max-width: 767px) {
			max-height: calc(100% - 50px);
			font-size: var(--fs-md);
		}
	}
}
.product-swipers {
	padding: 30px 0;
	@media (max-width: 767px) {
		padding: 25px 0;
		padding-top: 0px;
	}
	.section-title {
		text-align: center;
		position: relative;
		margin-bottom: 25px;
		&.a-left {
			text-align: left;
		}
		&.txt-uppercese {
			text-transform: uppercase;
		}
		h2 {
			display: inline-block;
			font-weight: 500;
			font-size: 1.875rem;
			margin-bottom: 0px;
			color: var(--mainColor);
			@media (max-width: 1025px) {
				font-size: var(--fs-3xl);
			}
			@media (max-width: 767px) {
				font-size: var(--fs-2xl);
			}
			a {
				color: var(--mainColor);
				&:hover, &:focus{
					color: var(--subColor);
				}
			}
			span {
				font-weight: bold;
				display: inline-block;
				position: relative;
				padding-bottom: 5px;
				&:before {
					content: "";
					position: absolute;
					height: 5px;
					border-radius: 5px;
					width: 100%;
					background-color: var(--subColor);
					left: 0px;
					bottom: 0px;
				}
			}
		}
	}
	.swiper_product_related {
		padding: 5px;
		@include controlswiper();
	}
}
.badge_product {
	display: block;
	margin-bottom: 5px; 
	span {
		background-color: var(--bgBodySub);
		color:var(--mainColor);
		padding: 3px 10px;
		font-size: var(--fs-md);
		font-weight: 600;
		display: inline-block;
		border-radius: 20px;
	}
}
.section-recenview-product {
	padding: 60px 0px 0px;
	.section-title {
		text-align: center;
		position: relative;
		margin-bottom: 25px;
		&.a-left {
			text-align: left;
		}
		&.txt-uppercese {
			text-transform: uppercase;
		}
		h2 {
			display: inline-block;
			font-weight: 500;
			font-size: 1.875rem;
			margin-bottom: 0px;
			color: var(--mainColor);
			@media (max-width: 1025px) {
				font-size: var(--fs-3xl);
			}
			@media (max-width: 767px) {
				font-size: var(--fs-2xl);
			}
			a {
				color: var(--mainColor);
				&:hover, &:focus{
					color: var(--subColor);
				}
			}
			span {
				font-weight: bold;
				display: inline-block;
				position: relative;
				padding-bottom: 5px;
				&:before {
					content: "";
					position: absolute;
					height: 5px;
					border-radius: 5px;
					width: 100%;
					background-color: var(--subColor);
					left: 0px;
					bottom: 0px;
				}
			}
		}
	}
	.recent-viewed {
		padding: 5px;
		@include controlswiper();
		.item_product_main {
			max-width: 270px;
		}
	}
}
.gallery-top  {
	position: relative;
	display: block;
	margin-bottom: 15px !important;
	.swiper-slide{
		padding-bottom: 100%;
		display: block;
		height: 0;
		aspect-ratio: 1;
		img{
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			max-width: 100%;
			max-height: 100%;
			width: auto !important;
			height: auto !important;
			position: absolute;
			border-radius: 10px;
		}
	}
	.play-video{
		display: inline-flex;
		align-items: center;
		position: absolute;
		z-index: 9;
		bottom: 15px;
		left: 10px;
		padding: 5px 10px;
		box-shadow: 0 0px 2px 0 red, 0 0px 3px 0px red;
		background: #fff;
		border-radius: 8px;
		span{
			font-size: var(--fs-base);
			font-weight: 600;
			display: inline-block;
			margin-right: 5px;
		}
		img{
			height: 28px;
			width: 28px;
		}
	}
}
.gallery-thumbs{
	margin-top: 10px;
	padding: 2px;
	.swiper-slide {
		border: 1px solid #ebebeb;
		cursor: pointer;
		background: #fff;
		overflow: hidden;
		height: auto !important;
		border-radius: 10px;
		.p-100{
			padding-bottom: 100%;
			height: 0;
			position: relative;
			aspect-ratio: 1;
			border-radius: 10px;
			img{
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				max-width: 100%;
				max-height: 100%;
				width: auto !important;
				height: auto !important;
				position: absolute;
				border-radius: 10px;
			}
		}
		&.swiper-slide-thumb-active{
			border-color: var(--mainColor);
			overflow: hidden;
		}
		&:hover{
			border-color: var(--mainColor);
		}
	}
	.swiper-button-next {
		right: 5px;
		overflow: hidden;
	}
	.swiper-button-prev {
		left: 5px;
		overflow: hidden;
	}
	.swiper-button-next {
		width: 24px;
		height: 24px;
		background: transparent;
		margin: 0px;
		top: 50%;
		transform: translate(0, -50%)  !important;
		border-radius: 5px;
		&:after{
			width: 24px;
			height: 24px;
			font-size: 0.625rem;
			font-weight: bold;
			background: var(--bgBodySub);
			padding: 8px 5px;
			color: var(--mainColor);
			box-shadow: 0 1px 2px 2px rgba(0, 0, 0, 0.04);
			display: flex;
			justify-content: center;
			align-items: center;
		}
		&:hover{
			&:after{
				background: var(--mainColor);
				color: #fff;
			}
		}
		&.swiper-button-disabled {
			display: none;
		}
	}

	.swiper-button-prev{
		width: 24px;
		height: 24px;
		background: transparent;
		margin: 0px;
		top: 50%;
		transform: translate(0, -50%) !important;
		border-radius: 5px;
		&:after{
			width: 24px;
			height: 24px;
			font-size: 0.625rem;
			font-weight: bold;
			background: var(--bgBodySub);
			padding: 8px 5px;
			color: var(--mainColor);
			box-shadow: 0 1px 2px 2px rgba(0, 0, 0, 0.04);
			display: flex;
			justify-content: center;
			align-items: center;
		}
		&:hover{
			&:after{
				background: var(--mainColor);
				color: #fff;
			}
		}
		&.swiper-button-disabled {
			display: none;
		}
	}
}
.thump-check{
	line-height: 0;
	position: relative;
	.check-bar{
		display: inline-block;
		width: 100%;
		height: 8px;
		background: #f5f5f5;
		border-radius: 5px;

	}
	.check-bar1{
		position: absolute;
		height: 8px;
		top: 0px;
		border-radius: 5px;
		background-color: var(--mainColor);
		-webkit-animation: progress_bar_fill 2s linear infinite;
		animation: progress_bar_fill 2s linear infinite;
		background-image: linear-gradient(45deg,rgba(255,255,255,.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,transparent 75%,transparent);
		background-size: 40px 40px;
		transition: width .6s ease;
	}
	.dot{
		width: 15px;
		height: 15px;
		background: #ddd;
		border-radius: 50%;
		position: absolute;
		top: -3px;
		.gift-item {
			position: absolute;
			top: 50%;
			width: 32px;
			height: 32px;
			display: block;
			transform: translate(-50%, -50%);
			z-index: 1;
			border-radius: 50%;
			border: 2px solid var(--mainColor);
			background: #fff;
			background-image: url({{'icon_gift.png' | asset_url}});
			background-repeat: no-repeat;
			background-position: center;
			background-size: 16px;
			transition: all 0.3s ease;
			&.selected {
				background-image: url({{'checked.png' | asset_url}});
				background-size: 12px;
			}
			&:after {
				content: attr(data-entry);
				height: 25%;
				position: absolute;
				font-size: var(--fs-sm);
				font-weight: bold;
				color: var(--mainColor);
				top: -16px;
				padding: 0;
				left: 50%;
				transform: translateX(-50%);
				width: 50px;
				text-align: center;
			}
		}
		&.active{
			background: var(--mainColor);
		}
	}
}
.m_white_bg_module {
	background: #fff;
	padding: 1rem;
	margin: auto !important;
	border-radius: 10px;
}
.popup_discount {
	top: 0 !important;
	left: 0;
	visibility: hidden;
	z-index: 0;
	opacity: 0;
	transition: all 0.5s;
	pointer-events: none;
	height: 100%;
	width: 100% ;
	position: fixed;
	-webkit-box-align: center;
	-ms-flex-align: center;
	align-items: center;
	-webkit-box-pack: center;
	-ms-flex-pack: center;
	justify-content: center;
	display: -webkit-box;
	display: -ms-flexbox;
	display: flex;
	&.open {
		z-index: 12;
		background: rgba(0, 0, 0, .5);
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
	}
	.b_video {
		width: 800px;
		max-width: calc(100% - 10px);
		.embed-responsive {
			position: relative;
			display: block;
			width: 100%;
			padding: 0;
			overflow: hidden;
		}
		.title_popup {
			padding: 10px;
			font-size: var(--fs-md);
			font-weight: 600;
			h5 {
				font-weight: 600;
				font-size: var(--fs-md);
				margin-bottom: 10px;
			}
		}
		.embed-responsive-16by9::before {
			padding-top: 56.25%;
		}
		.embed-responsive::before {
			display: block;
			content: "";
		}
		.embed-responsive iframe {
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 100%;
			border: 0;
		}
	}
	.max-100 {
		position: relative;
		max-width: 100%}
	.close_discount {
		border-radius: 50%;
		width: 30px;
		height: 30px;
		border: 2px solid #000;
		z-index: 2;
		@media (min-width: 768px) {
			right: -6px;
			top: -12px;
			transition: all 0.3s;
			position: absolute;
		}

		img {
			max-width: 16px;
			filter: brightness(0);
		}
		@media (min-width: 768px) {
			&:hover {
				transform: scale(1.1) rotate(360deg);
			}
		}
	}
}
@keyframes progress_bar_fill{
	0% {
		background-position: 0 0;
	}
	100% {
		background-position: 40px 0;
	}
}


.box_com_bo_buy {
	min-height: 120px;
	padding: 10px;
	width: 100%;
	border: 1px solid #dee2e6;
	border-left-width: 3px;
	border-radius: 10px;
	border-left-color: var(--mainColor);
	cursor: pointer;
	display: block;
	position: relative;
	margin-bottom: 15px;
	h3 {
		color: #000;
		font-size: var(--fs-lg);
		font-weight: 600;
	}
	.item_img_com {
		margin-right: .5rem;
		display: none;
		width: 70px;
		height: 70px;
		border-radius: 5px;
		background: #f6f6f6;
		padding: 5px;
		&:nth-child(1){
			display: flex;
			justify-content: center;
			align-items:center;
		}
		&:nth-child(2){
			display: flex;
			justify-content: center;
			align-items:center;
		}
		img {
			width: auto;
		}
	}
	.item_span_com {
		width: 35px;
		height: 70px;
		margin-right: .5rem;
		border-radius: 5px;
		background: #f6f6f6;
		color: var(--textColor);
		font-weight: 600;
		display: flex;
		font-size: var(--fs-md);
		justify-content: center;
		align-items: center;
	}
	.item_span_see {
		margin-left: .5rem;
		color: var(--textColor);
		font-size: 0.625rem;
		font-weight: 600;
		text-decoration: underline;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	&:hover {
		.item_span_see {
			color: var(--mainColor);
		}
	}
}
.combo_pro{
	position: relative;
	display: block;
	margin-bottom: 30px;
	background: var(--bgBodySub);
	border-radius: 10px;
	padding: 15px;
	.title-popup {
		font-weight: 600;
		margin-bottom: 15px;
		display: block;
		h3 {
			display: inline-block;
			font-weight: 600;
			font-size: 1.625rem;
			margin-bottom: 0px;
			span {
				color: var(--subColor);
			}
			@media (max-width: 767px) {
				font-size: var(--fs-2xl);
			}
		}
	}
	.product-bundled-section #bundled-form {
		width: 100%;
		display: flex;
		flex-flow: row;
		margin: 0;
	}

	@media (max-width: 767px) {
		.product-bundled-section #bundled-form {
			flex-flow:column
		}
	}
	.product-bundled-section .bundled-products {
		display: grid;
		gap: 20px;
		padding-inline: 16px;
		grid-auto-flow: column;
		grid-template-rows: repeat(1, 1fr);
		overflow-x: auto;
		scroll-behavior: smooth;
		padding: 0;
		@media (max-width: 767px) {
			gap: 15px;
		}
	}
	.product-bundled-section .bundled-products .bundled-product {
		max-width: 100%;
		border: 1px solid #e9e9e9;
		margin-bottom: 15px;
		padding: 10px;
		max-width: 235px;
		position: relative;
		min-width: 235px;
		text-align: center;
		border-radius: 10px;
		background-color: #fff;
	}

	.product-bundled-section .bundled-products .bundled-product .bundled-checkbox {
		position: absolute;
		top: 10px;
		left: 10px;
		border-color: #838383;
		z-index: 2;
		margin: 0;
		width: auto;
		height: auto;
		opacity: 1;
		width: 16px;
		height: 16px;
	}

	@media (max-width: 767px) {
		.product-bundled-section .bundled-products .bundled-product .bundled-checkbox {
			height:25px;
			width: 25px
		}
	}

	.product-bundled-section .bundled-products .bundled-product .bundled-checkbox:focus {
		outline: none;
		box-shadow: none
	}

	.product-bundled-section .bundled-products .bundled-product .bundled-checkbox:checked,.product-bundled-section .bundled-products .bundled-product .bundled-checkbox:hover {
		background-color: red;
		border-color: red
	}


	.product-bundled-section .bundled-products .bundled-product .box_content_pro {
		width: 100%;
		text-align: left;
		.price {
			color: var(--price);
			font-weight: 600;
			display: block;
			margin-bottom: 5px;
		}
	}
	.product-bundled-section .bundled-products .bundled-product .thumb-product {
		overflow: hidden;
		width: 100%;
		display: flex;
		-o-justify-content: center;
		-moz-justify-content: center;
		-webkit-justify-content: center;
		-os-justify-content: center;
		-o-display: flex;
		-moz-display: flex;
		-webkit-display: flex;
		-os-display: flex;
		align-items: center;
		position: relative;
		height: auto !important;
		padding-bottom: 100%;
	}
	.product-bundled-section .bundled-products .bundled-product .thumb-product img {
		width: auto;
		max-height: 100%;
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		margin: auto;
		object-fit: contain;
	}

	.product-bundled-section .bundled-products .bundled-product .view-product {
		color: #000;
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		word-break: break-word;
		-webkit-line-clamp: 2;
		font-size: var(--fs-lg);
		font-weight: 500;
		margin-bottom: 5px;
		line-height: 24px;
		height: 48px
	}

	.product-bundled-section .bundled-products .bundled-product .view-product:hover {
		color: var(--mainColor);
	}

	.product-bundled-section .bundled-products .bundled-product .bundled-variants {
		font-size: var(--fs-sm)
	}

	.product-bundled-section .bundled-products .bundled-product .bundled-variants:focus {
		outline: none;
		box-shadow: none
	}

	.product-bundled-section .bundled-right {
		flex-flow: column;
		align-items: center;
		justify-content: center;
		display: flex;
		position: relative;
		font-size: var(--fs-sm);
		margin-left: auto;
		width: 260px;
	}

	@media (max-width: 991px) {
		.product-bundled-section .bundled-right {
			min-width:200px
		}
	}


	@media (max-width: 767px) {
		.product-bundled-section .bundled-right {
			width:100%;
			padding-left: 0;
			padding-top: 15px;
			font-size: var(--fs-sm) /* TODO confirm — rounded from 15px */;
			border-top: 1px solid #f3f5f7;
			margin-top: 15px
		}

	}

	.product-bundled-section .bundled-right #bundled-price {
		color: var(--mainColor);
		font-weight: 600;
		font-size: var(--fs-md) /* TODO confirm — rounded from 17px */
	}

	.product-bundled-section .bundled-right button {
		margin-top: 10px;
		border: 1px solid var(--mainColor);
		background-color: var(--mainColor);
		color: #fff;
		padding: 5px 15px;
		border-radius: 10px;
	}

	@media (max-width: 767px) {
		.product-bundled-section .bundled-right button {
			width:100%
		}
	}

	.product-bundled-section .bundled-right button:hover {
		background-color: var(--subColor);
		border: 1px solid var(--subColor);
	}

	.swatchitem{
		font-size: var(--fs-sm);
		margin-bottom: 5px;
		.header{
			margin-bottom: 5px;
			font-weight: 500;
			color: #000;
			text-align: left;
			line-height: 1.2;
		}
		.swatch-element {
			display: inline-block;
			margin: 0px 5px 5px 0;
			position: relative;
			height: 26px;
			input{
				position: absolute;
				top: -3px;
				right: 0px;
				z-index: 2;
				width: 100%;
				height: 100%;
				opacity: 0;
				cursor: pointer;
				height: 26px;
			}
			label{
				min-width: 36px;
				height: 26px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				color: var(--textColor);
				background-color: #fff;
				border: 1px solid #ddd;
				cursor: pointer;
				white-space: nowrap;
				padding: 0 5px;
				position: relative;
				margin-bottom: 0;
				text-align: center;

				&:hover {
					background-color: var(--mainColor);
				}
				.crossed-out{
					display: none;
				}
			}

			input:checked+label {
				background: var(--mainColor);
				border-color: var(--mainColor);
				color: #fff;
			}

			&.color{
				{%for i in (1..20)%}
				{% capture label%}color_{{i}}{%endcapture%}                            
				{% assign title = settings[label]| downcase | handle%}
				{% capture color%}color_{{i}}_c{%endcapture%}			
				{% assign color1 = settings[color] %}
				{%if title != null and title != '' %}
				&.{{title}}{
					label{
						background-color:{{color1}};
						min-width: 26px;
						height: 26px;
					}
				}
				{%endif%}
				{%endfor%}
				label{
					border-radius: 50%;
					min-width: 26px;
				}
				input:checked+label{
					border: 2px  solid #00ff4e;

				}

			}
		}
	}

}
#successModal {
	width: 400px;
	margin-left: auto;
	margin-right: auto;
	position: fixed;
	height: 140px;
	top: 50% !important;
	left: 50%;
	transform: translate(-50%, -50%)
}

@media (max-width: 767px) {
	#successModal {
		width:100%;
		bottom: 0;
		top: auto !important;
		left: 0;
		right: 0;
		transform: translateY(100%);
		background-color: #fff;
		transition: all 0.5s cubic-bezier(0.47, 1.64, 0.41, 0.8);
		visibility: hidden;
		opacity: 0;
		display: block !important
	}

	#successModal.active {
		visibility: visible;
		opacity: 1;
		transform: translateY(0)
	}
}

#successModal .modal-content {
	padding: 10px;
	border-radius: 0;
	background-color: #fff;
	border: 2px solid var(--mainColor);
	text-align: center;
	height: 100%;
	align-items: center;
	justify-content: center;
	border-radius: 15px;
}

@media (max-width: 767px) {
	#successModal .modal-content {
		border:none
	}
}

#successModal .modal-content .close {
	font-size: var(--fs-lg);
	position: absolute;
	top: 0;
	right: 10px;
	color: #000
}

#successModal .modal-content .close:hover {
	color: var(--mainColor);
	cursor: pointer
}

#successModal .modal-content #successMessage {
	margin-bottom: 0;
	font-weight: 600
}

#successModal .modal-content .btn {
	width: 100%;
	padding: 0px 20px;
	background-color: var(--mainColor);
	border-color: var(--mainColor);
	color: #fff;
	margin-top: 15px;
	border-radius: 10px;
	max-width: 145px;
}

#successModal .modal-content .btn:hover {
	background-color: var(--subColor)
}
.section_same_price {
	padding: 30px 0 0px;
	.section-title {
		text-align: center;
		position: relative;
		margin-bottom: 25px;
		&.a-left {
			text-align: left;
		}
		&.txt-uppercese {
			text-transform: uppercase;
		}
		h2 {
			display: inline-block;
			font-weight: 500;
			font-size: 1.875rem;
			margin-bottom: 0px;
			color: var(--mainColor);
			@media (max-width: 1025px) {
				font-size: var(--fs-3xl);
			}
			@media (max-width: 767px) {
				font-size: var(--fs-2xl);
			}
			a {
				color: var(--mainColor);
				&:hover, &:focus{
					color: var(--subColor);
				}
			}
			span {
				font-weight: bold;
				display: inline-block;
				position: relative;
				padding-bottom: 5px;
				&:before {
					content: "";
					position: absolute;
					height: 5px;
					border-radius: 5px;
					width: 100%;
					background-color: var(--subColor);
					left: 0px;
					bottom: 0px;
				}
			}
		}
	}
	.product-same-swiper {
		padding: 5px;
		@include controlswiper();
	}

}
.show-more-same{
	text-align: center;
	display: block;
}
{% if settings.product_promo_enable %}
.khuyen-mai{
	padding: 18px 15px 15px 15px;
	margin-bottom: 15px;
	border: 2px dashed #c90000;
	margin-top: 25px;
	position: relative;
	border-radius: 7px;
	.product-promotion__heading {
		margin-bottom: 8px;
		font-size: var(--fs-sm);
		font-weight: 600;
		padding: 5px 10px;
		color: #c90000;
		background: #fff;
		position: absolute;
		top: -18px;
		display: flex;
		align-items: center;
		gap: 5px;
		line-height: 10px; 
		img {
			max-width: 22px;
		}
	}
	.content {
		ul{
			li{
				margin-bottom: 10px;
				.nb_dis {
					display: inline-block;
					font-size: var(--fs-xs) /* TODO confirm — rounded from 11px */;
					float: left;
					height: 20px;
					line-height: 20px;
					text-align: center;
					width: 20px;
					img {
						max-width: 20px;
					}
				}
				.content_dis {
					padding-left: 25px;
					display: block;
					line-height: 20px;
				}
				&:last-child {
					margin-bottom: 5px;
				}
			}
		}
	}
}
{% endif %}
{%if settings.product_store_enable%}
.btn-hethong{
	margin: auto;
	font-weight: 500;
	color: var(--mainColor);
	line-height: 1;
	display: block;
	margin-bottom: 15px;
	margin-top: 15px;
	svg{
		width: 22px;
		height: 22px;
		vertical-align: -5px;
	}
	&:hover{
		color: var(--subColor);
	}
}

#modal-store-product {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.modal-store-product {
		position: absolute;
		width:650px;
		top: 5%;
		height: auto;
		margin: 0 auto;
		left: 0;
		right: 0;
		padding: 10px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 5px;
		@media(max-width: 767px) {
			width:90%;
		}
		.modalstore-close{
			position: absolute;
			right: 10px;
			top: 5px;
			color: #616161;
			svg {
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
			}
			&:hover{
				svg {
					transform: rotate(90deg);
				}
			}

		}
	}
	.modalstore-overlay {
		position: fixed;
		top: 0px !important;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}
	.option-chos{
		.option-title{
			font-weight: bold;
			margin-bottom: 5px;
		}
		.group-option{
			display: -ms-flexbox;
			display: flex;
			-ms-flex-wrap: wrap;
			flex-wrap: wrap;
			margin-right: -5px;
			margin-left: -5px;
			margin-bottom: 10px;
			.group{
				position: relative;
				width: 100%;
				padding-right: 5px;
				padding-left: 5px;
				-ms-flex: 0 0 50%;
				flex: 0 0 50%;
				max-width: 50%;
				select{
					width: 100%;
					padding: 5px;
					border: 1px solid #ccc;
					border-radius: 5px;
				}
			}
		}
		.info-store{
			border: 1px solid #ccc;
			border-radius: 5px;
			padding: 7px 10px 0;
			max-height: 450px;
			overflow-y: auto;
			.store-list{
				margin-bottom: 7px;
				padding-right: 100px;
				position: relative;
				.store-name {
					display: block;
					&.name-ch{
						color: var(--mainColor);
					}
				}
				.store-phone{
					position: absolute;
					top: 5px;
					right: 0;
					a{
						border: 1px solid #ccc;
						padding: 5px 10px;
						font-size: var(--fs-xs);
						border-radius: 5px;
					}
				}
			}
		}
	}
}
{% endif %}
#modal-tragop-product {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	display: flex;
	align-items: center;
	.chosee_size{
		background-color: var(--mainColor);
		color: #fff;
		padding: 10px;
		margin-top: -10px;
		margin-left: -10px;
		margin-right: -10px;
		border-radius: 10px 10px 0px 0px;
		margin-bottom: 10px;
	}
	.img_popup {
		position: relative;
		overflow: hidden;
		width: 100%;
		display: flex;
		-o-justify-content: center;
		-moz-justify-content: center;
		-webkit-justify-content: center;
		-os-justify-content: center;
		-o-display: flex;
		-moz-display: flex;
		-webkit-display: flex;
		-os-display: flex;
		align-items: center;
		position: relative;
		height: auto !important;
		padding-bottom: 100%;
		img {
			width: auto !important;
			max-height: 100%;
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0;
			right: 0;
			margin: auto;
			will-change: opacify;
			transform: scale(1);
			transition: all 0.5s ease;
			transition: opacity 0.5s ease, -webkit-transform 2s cubic-bezier(0, 0, 0.44, 1.18);
			transition: opacity 0.5s ease, transform 2s cubic-bezier(0, 0, 0.44, 1.18);
			transition: opacity 0.5s ease, transform 2s cubic-bezier(0, 0, 0.44, 1.18), -webkit-transform 2s cubic-bezier(0, 0, 0.44, 1.18);
		}
	}
	.modal-tragop-product {
		position: absolute;
		width:650px;
		height: auto;
		margin: auto;
		left: 0;
		right: 0;
		padding: 10px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 10px;
		@media(max-width: 767px) {
			width:90%;
		}
		.form-group {
			padding-bottom: 0px;
			select {
				background-image: url('{{ "ico-select2.png" | asset_url }}');
					}
		}

		.info_name {
			margin-bottom: 5px;
			margin-top: 10px;
			font-size: var(--fs-md); 
			text-align: center;
			font-weight: 600;
			p{
				margin-bottom: 0px;
			}
		}
		.modaltragop-close{
			position: absolute;
			right: 10px;
			top: 8px;
			color: #fff;
			svg {
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
			}
			&:hover{
				svg {
					transform: rotate(90deg);
				}
			}

		}
	}
	.group_contact  {
		input, textarea{
			border: 1px solid #e1e1e1;
			width: 100%;
			margin-bottom: 15px;
			outline: none;
			border-radius: 10px;
			min-height: 40px;
		}
		input{
			padding:5px 20px;
		}
		textarea{
			padding: 10px 20px;
		}
		.btn-lienhe {
			background: var(--mainColor);
			color: #fff;
			border: initial;
			padding: 0 25px;
			height: 40px;
			line-height: 40px;
			font-size: var(--fs-lg);
			border-radius: 10px;
			display: flex;
			align-items: center;
			width: 100%;
			svg {
				width: 18px;
				height: 18px;
				margin-left: 3px;
			}
			&:hover{
				background: var(--subColor);
			}
		}
	}
	.modaltragop-overlay {
		position: fixed;
		top: 0 !important;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}
	.help-block {
		display: block;
	}
	.pricus{
		color: var(--price);
	}
	.box_btn_tragop {
		display: block;
		gap: 15px;
		button {
			width: 100%;
		}
		.btn-warning {
			margin-bottom: 10px;
		}
		#sapo_button-register {
			background: var(--mainColor);
			&:hover{
				background: var(--subColor);
			}
		}
	}
}
{%if settings.product_policy_enable%}
.product-policises-wrapper{
	position: relative;
	margin-bottom: 15px;
	.product-policises {
		font-size: var(--fs-sm);
		flex-direction: column;
		background-color: #fff;
		flex-flow: row wrap;
		display: flex;
		row-gap: 14px;
		.item_poli {
			display: -ms-flexbox;
			display: flex;
			-ms-flex-align: start;
			align-items: flex-start;
			flex: 0 0 50%;
			max-width: 50%;
			align-items: center;
			@media(max-width: 768px) {
				flex: 0 0 100%;
				max-width: 100%;
			}
			> div:not(.content_poli){
				width: 32px;
				height: 32px;
				margin-right: 10px;
			}
		}
	}
}
{% endif %}
{%if settings.product_coupon_enable%}
.product-coupon__wrapper {
	position: relative;
	display: block;
	margin-bottom: 15px;
	.d-block.mb-2 {
		margin-bottom: 7px;
	}
}
.product-coupons {
	cursor: pointer;
	overflow-x: scroll;
	display: flex;
	align-items: center;
}
.product-coupons::-webkit-scrollbar {
	display: none;
}
.coupon_item.lite {
	border-radius: 0;
	display: inline-block;
	filter: none;
	min-height: 0;
	overflow: hidden;
	padding: 0!important;
	margin-right: 7px;
}
.coupon_item.lite:before {
	content: normal;
}
.coupon_item.lite .coupon_content {
	background-color: var(--mainColor);
	color: #fff;
	padding: 7px 12px;
	position: relative;
	font-weight: bold;
	line-height: 1;
	text-align:center;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 5px;
}
@media(max-width: 767px) {
	.coupon_item.lite .coupon_content {
		padding: 7px 10px;
		font-size: var(--fs-sm) /* rounded from 13px */;
	}
}
@media(max-width: 415px) {
	.coupon_item.lite .coupon_content {
		padding: 5px 8px;
		font-size: var(--fs-xs);
	}
}
@media(max-width: 350px) {
	.coupon_item.lite .coupon_content {
		font-size: var(--fs-xs) /* TODO confirm — rounded from 10px */;
	}
}
.coupon_item.lite .coupon_content:before, .coupon_item.lite .coupon_content:after {
	content: '';
	position: absolute;
	border-radius: 999px;
	width: 10px;
	height: 10px;
	background: #fff;
	border: 1px solid var(--mainColor);
	top: 50%;
	transform: translateY(-50%);
}
.coupon_item.lite .coupon_content:before {
	left: -5px;
}
.coupon_item.lite .coupon_content:after {
	right: -5px;	
}
.product-coupons svg {
	width: 12px;
	height: 18px;
	color: var(--mainColor);
}
#modal-coupon-product{
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.chosee_size {
		font-weight: 600;
		font-size: var(--fs-base);
		text-transform: uppercase;
		p {
			margin-bottom: 10px;
		}
	}
	.modal-coupon-product {
		position: absolute;
		width:650px;
		top: 10%;
		height: auto;
		margin: 0 auto;
		left: 0;
		right: 0;
		padding: 10px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 10px;
		@media(max-width: 767px) {
			width:96%;
			padding: 5px 5px 15px;
		}
		.modalcoupon-close{
			position: absolute;
			right: 10px;
			top: 10px;
			color: #616161;
			svg {
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
			}
			&:hover{
				svg {
					transform: rotate(90deg);
				}
			}

		}
		.box-cpou-dk {
			margin-bottom: 15px;
			&.last-cpou {
				margin-bottom: 0px;
			}
		}
		.item_list_coupon {
			background: var(--bgBodySub);
			display: flex;
			align-items: center;
			border: 1px dashed var(--mainColor);
			border-radius: 5px;
			position: relative;
			.money_coupon__img {
				position: absolute;
				top: 0;
				left: 0;
				width: 110px;
				height: 100%;
				object-fit: cover;
				border-top-left-radius: 5px;
				border-bottom-left-radius: 5px;
				@media(max-width: 767px) {
					width: 60px;
				}
			}
			.money_coupon {
				background: var(--mainColor);
				vertical-align: middle;
				width: 110px;
				padding: 0 8px;
				border-right: 1px dashed #fff;
				border-top-left-radius: 5px;
				border-bottom-left-radius: 5px;
				height: 85px;
				display: flex;
				justify-content: center;
				align-items: center;
				font-size: var(--fs-2xl) /* TODO confirm — rounded from 30px */;
				font-weight: bold;
				color: #fff;
				@media(max-width: 767px) {
					width: 60px;
					height: 80px;
					font-size: var(--fs-sm);
				}
				&::before, &::after {
					display: block;
					content: " ";
					width: 16px;
					height: 16px;
					background: #fff;
					position: absolute;
					left: 101px;
					top: -8px;
					border-radius: 50%;
					border-width: 1px;
					border-style: dashed;
					border-color: transparent var(--mainColor) var(--mainColor) transparent;
					transform: rotate(45deg);
					@media(max-width: 767px) {
						left: 51px;
					}
				}
				&::after {
					top: auto;
					bottom: -8px;
					transform: rotate(225deg);
				}
			}
			.content_coupon {
				padding-left: 10px;
				padding-right: 10px;
				width: calc(100% - 110px);
				@media(min-width: 768px) {
					display: flex;
					justify-content: space-between;
					align-items: center;
				}
				@media(max-width: 767px) {
					width: calc(100% - 60px);
					.noidung_coupon{
						font-size: var(--fs-xs);
					}
				}
				.zip_coupon {
					@media(max-width: 767px) {
						font-size: var(--fs-xs);
						line-height: 1.3;
					}
					b{
						color: var(--subColor);
					}
				}

				.boz-right {
					@media(max-width: 767px) {
						display: flex;
						justify-content: space-between;
						align-items: flex-end;
					}
					.dis_copy {
						background-color: var(--mainColor);
						color: #fff;
						border: none;
						padding: 0px 15px;
						cursor: pointer;
						outline: none !important;
						box-shadow: none;
						border-radius: 5px;
						line-height: 24px;
						height: 32px;
						font-weight: 600;
						font-size: var(--fs-sm);
						@media(max-width: 767px) {
							height: 24px;
							font-size: var(--fs-xs);
							line-height:18px;
						}
						@media(max-width:321px) {
							height: 20px;
							font-size: var(--fs-xs) /* TODO confirm — rounded from 10px */;
							line-height:16px;
						}
						&:hover {
							background-color: var(--subColor);
						}
					}
					.dk_btn {
						text-align: center;
						margin-top: 5px;
						text-decoration: underline;
						color: #2E72D2;
						cursor: pointer;
						@media(max-width: 767px) {
							font-size: var(--fs-xs);
						}
						&:hover {
							color:var(--subColor);
						}
					}
				}
			}
		}
		.contet_dk {
			background-color: #fff4db;
			padding: 5px;
			color: #000;
			border-radius: 5px;
			line-height: 18px;
			display:none;
		}
	}
	.modalcoupon-overlay {
		position: fixed;
		top: 0px !important;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}
	.chosee_size {
		font-weight: 600;
		font-size: var(--fs-base);
		text-transform: uppercase;
	}
}
{% endif %}
.popup-video {
	position: fixed;
	z-index: 99999;
	top: 0 !important;
	left: 0;
	right: 0;
	text-align: center;
	bottom: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(0,0,0,0.89);
	display: none;
}

.popup-video.active {
	display: flex
}

.popup-video .close-popup-video {
	background: #fff;
	color: #000;
	position: absolute;
	right: 10px;
	top: 10px;
	padding: 5px 10px;
	border-radius: 5px;
	cursor: pointer
}

.popup-video .close-popup-video:hover {
	opacity: 0.8
}

.popup-video iframe {
	height: calc(100vh - 200px);
	width: 1100px
}

@media (max-width: 1100px) {
	.popup-video iframe {
		width:700px
	}
}

@media (max-width: 767px) {
	.popup-video .body-popup {
		padding:0 5px;
		width: 100%
	}

	.popup-video .body-popup iframe {
		width: 100%;
		height: 300px
	}
}
.store-folow{
	color: #000;
	margin-bottom: 10px;
	padding-bottom: 15px;
	border-bottom: 1px dashed var(--mainColor);
	.title{
		-ms-flex: 0 0 100%;
		flex: 0 0 100%;
		max-width: 100%;
		position: relative;
		width: 100%;
		font-weight: 700;
		margin-top: 5px;
		b{
			color: var(--mainColor);
			display: block;
			font-size: var(--fs-2xl) /* TODO confirm — rounded from 26px */;
			margin-bottom: 5px;
		}
		span{
			padding: 2px 5px;
			display: inline-flex;
			align-items: center;
			font-size: var(--fs-xs);
			border: 2px solid var(--subColor);
			border-radius: 10px;
			color: var(--subColor);
			margin-bottom: 10px;
			svg{
				border: 2px solid;
				border-radius: 50%;
				margin-right: 5px;
				width: 16px;
				height: 16px;
			}
			path{
				fill:var(--subColor) ;
			}
		}
	}
	.item_store{
		display:flex;
		.item_image_store {
			width:72px;
			height: 70px;
			margin-right: 10px;
			min-width:72px;
		}
		.image{
			padding-bottom: 100%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			width: 100%;
			margin: auto;
			background: #fff;
			border-radius: 5px;
			border: 1px solid #DDE1EF !important;
			img {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				-o-object-fit: contain;
				object-fit: contain;
				padding: 3px;
			}
		}
		.info_store {
			width: 100%;
			.name_title {
				margin-bottom: 0px;
				font-size: var(--fs-xl);
				font-weight: 600;
				line-height: 1.2;
				@media(min-width: 992px) and (max-width: 1199px) {
					font-size: var(--fs-lg);
				}
			}
			.text {
				margin-bottom: 0px;
				line-height: 1.2;
				font-size: var(--fs-sm);
			}
		}
	}
	.button-group{
		display: flex;
		justify-content: center;
		align-items: center;
		@media(min-width: 992px) and (max-width: 1199px) {
			flex-wrap: wrap;
		}
		a{
			font-size: var(--fs-sm);
			padding: 3px;
			display: flex;
			align-items: center;
			border-radius: 5px;
			font-weight: 500;
			width: 100%;
			justify-content: center;
			svg{
				margin-right: 5px;
				width: 20px;
				height: 20px;
			}
			&:nth-child(1){
				color: #fff;
				background-color: var(--mainColor);
				margin-right: 7px;
				@media(min-width: 992px) and (max-width: 1199px) {
					margin-right: 0px;
					margin-bottom: 5px;
				}
				&:hover{
					opacity:0.8
				}
			}
			&:nth-child(2){
				color: #fff;
				background-color: var(--subColor);
				&:hover{
					opacity:0.8
				}
			}
		}
	}

}
.product-favorite {
	display: block;
	margin: 30px 0;
	@media (max-width: 992px) {
		margin-bottom: 2px;
	}
	@media (max-width: 767px) {
		margin: 25px 0;
	}
	@media (min-width: 768px) and (max-width: 992px) {
		.col-md-4:last-child {
			display: none !important;
		}
	}
	.section-title {
		text-align: center;
		position: relative;
		margin-bottom: 25px;
		&.a-left {
			text-align: left;
		}
		&.txt-uppercese {
			text-transform: uppercase;
		}
		h2 {
			display: inline-block;
			font-weight: 500;
			font-size: 1.875rem;
			margin-bottom: 0px;
			color: var(--mainColor);
			@media (max-width: 1025px) {
				font-size: var(--fs-3xl);
			}
			@media (max-width: 767px) {
				font-size: var(--fs-2xl);
			}
			a {
				color: var(--mainColor);
				&:hover, &:focus{
					color: var(--subColor);
				}
			}
			span {
				font-weight: bold;
				display: inline-block;
				position: relative;
				padding-bottom: 5px;
				&:before {
					content: "";
					position: absolute;
					height: 5px;
					border-radius: 5px;
					width: 100%;
					background-color: var(--subColor);
					left: 0px;
					bottom: 0px;
				}
			}
		}
	}
}
.box_kiem_duyet{
	color: #000;
	background-color: var(--bgBodySub);
	padding: 15px;
	border-radius: 10px;
	margin: 30px 0px;
	border: 1px solid #ddd;
	@media(max-width: 767px) {
		margin: 25px 0px;
		.name_title {
			margin-bottom: 5px !important;
		}
	}
	.box_content_kiemd {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
		@media(max-width: 767px) {
			display: block;

		}
	}
	.title{
		-ms-flex: 0 0 100%;
		flex: 0 0 100%;
		max-width: 100%;
		position: relative;
		width: 100%;
		font-weight: 700;
		margin-top: 5px;
		b{
			color: var(--mainColor);
			display: block;
			font-size: var(--fs-2xl) /* TODO confirm — rounded from 26px */;
			margin-bottom: 5px;
		}
		span{
			padding: 2px 5px;
			display: inline-flex;
			align-items: center;
			font-size: var(--fs-xs);
			border: 2px solid var(--subColor);
			border-radius: 10px;
			color: var(--subColor);
			margin-bottom: 10px;
			svg{
				border: 2px solid;
				border-radius: 50%;
				margin-right: 5px;
				width: 16px;
				height: 16px;
			}
			path{
				fill:var(--subColor) ;
			}
		}
	}
	.item_store{
		display:flex;
		.item_image_store {
			width:72px;
			height: 70px;
			margin-right: 10px;
			min-width:72px;
		}
		.image{
			padding-bottom: 100%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			width: 100%;
			margin: auto;
			background: #fff;
			border-radius: 5px;
			border: 1px solid #DDE1EF !important;
			img {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				-o-object-fit: contain;
				object-fit: contain;
				padding: 3px;
			}
		}

		.info_store {
			width: 100%;
			.name_title, .text_title {
				margin-bottom: 0px;
				font-size: var(--fs-xl);
				font-weight: 600;
				line-height: 1.2;
				@media(max-width: 767px) {
					font-size: var(--fs-md);
				}
			}
			.text_title { 
				color: var(--mainColor);
			}
			.kiem_d_content {
				display: flex;
				align-items: center;
				svg {
					width: 16px;
					height: 16px;
					margin-right: 5px;
				}
			}
		}
	}
	.content_kiemd {
		p {
			margin-bottom: 0px;
		}
		.text-body2 {
			color: var(--mainColor);
			display: inline-flex;
			align-items: center;
			font-weight: 500;
			svg {
				width: 12px;
				height: 12px;
				margin-left: 2px;
				margin-top: 1px;
				path {
					fill: var(--mainColor);
				}
			}
			&:hover, &:focus {
				color: var(--subColor);
				svg {
					path {
						fill: var(--subColor);
					}
				}
			}
		}
	}

}
.box_cate_tag {
	display: block;
	margin-bottom: 30px;
	@media(max-width: 992px) {
		margin-bottom: 10px;
	}
}
.box_cate_pro {
	border-bottom: 1px dotted #ddd;
	border-top: 1px dotted #ddd;
	display: block;
	padding: 15px 0;

	&:nth-child(2) {
		border-top: none;
	}

	a {
		color: var(--mainColor);
		font-weight: 600;
		font-size: var(--fs-md);
		&:hover, &:focus {
			color: var(--subColor);
		}
	}
}
.size-content-detail {
	margin-bottom: 8px;
	padding-bottom: 8px;
	border-bottom: 1px solid #e4e8ed;
	p {
		margin-bottom: 0px;
	}
	.txt_pro_name {
		font-size: var(--fs-xl);
		font-weight: 600;
		line-height: 1.4;
	}
	.lc-switch-size {
		display: -webkit-box;
		display: -webkit-flex;
		display: -ms-flexbox;
		display: flex;
		-webkit-align-items: center;
		-webkit-box-align: center;
		-ms-flex-align: center;
		align-items: center;
		-webkit-box-pack: justify;
		-webkit-justify-content: space-between;
		justify-content: space-between;
		gap: 10px;
		margin-top: 8px;

		.lc-option-box-size {
			display: -webkit-box;
			display: -webkit-flex;
			display: -ms-flexbox;
			display: flex;
			border: 1px solid #e4e8ed;
			border-radius: 1000px;
			padding: 2px !important;
			list-style: none !important;
			margin-bottom: 0px !important;
			.cursor-pointer {
				padding: 4px 8px;
				display: -webkit-box;
				display: -webkit-flex;
				display: -ms-flexbox;
				display: flex;
				-webkit-box-pack: center;
				-ms-flex-pack: center;
				-webkit-justify-content: center;
				justify-content: center;
				color: #4a4f63;
				cursor: pointer;
				&.active {
					background-color: var(--mainColor);
					color: #fff;
					border-radius: 40px;
				}
			}
			p {
				margin-bottom: 0px;
			}
		}
	}
	@media screen and (min-width: 769px){
		display: -webkit-box;
		display: -webkit-flex;
		display: -ms-flexbox;
		display: flex;
		-webkit-box-pack: justify;
		-webkit-justify-content: space-between;
		justify-content: space-between;
		align-items: center;
		.lc-switch-size {
			margin-top: 0;
			-webkit-flex-basis: 280px;
			-ms-flex-preferred-size: 280px;
			flex-basis: 280px;
			-webkit-box-pack: end;
			-ms-flex-pack: end;
			-webkit-justify-content: flex-end;
			justify-content: flex-end;
			margin-left: auto;
			min-width: 280px;
		}
	}
}
@media screen and (max-width: 576px){
	.block-flashsale .heading-flash {
		font-size: var(--fs-xs) /* TODO confirm — rounded from 9px */;
	}
}

/* ── Buy Now button — 2-line layout (icon + setting spans) ── */
.buynow {
	i { flex-shrink: 0; }
	.buynow-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1px;
		span { display: block; }
		span:first-child {
			font-size: var(--fs-base);
			font-weight: 700;
			line-height: 1.2;
			text-transform: uppercase;
		}
		span + span {
			font-size: var(--fs-xs) !important;
			font-weight: 400;
			text-transform: none;
			opacity: 0.88;
			letter-spacing: 0;
		}
	}
}

/* Most Viewed Products app block is rendered on product pages too.
   Its tailored styles previously existed only in page_collection.scss.bwt,
   so the product page fell back to the app's basic vendor stylesheet. */
.ab-most-view-product-module {
	.most-view-module {
		background-color: var(--bg-subtle) !important;
		padding: 48px;
		overflow: hidden;
	}

	.most-view-module-heading,
	.most-view-module-body {
		max-width: 1200px;
		margin-left: auto !important;
		margin-right: auto !important;
		padding-left: 16px;
		padding-right: 16px;
	}

	.most-view-module-heading {
		display: flex !important;
		align-items: center !important;
		justify-content: space-between !important;
		gap: 0;
		margin-bottom: 32px !important;
		position: relative;
	}

	.most-view-module .most-view-module-title {
		order: 1;
		flex: 1;
		color: var(--mainColorDark) !important;
		font-size: var(--fs-xl) !important;
		font-weight: 700 !important;
		font-style: normal !important;
		font-family: var(--font-heading, var(--font-primary));
		text-align: left !important;
		text-transform: uppercase !important;
		margin: 0 !important;
		padding: 0 !important;
		float: none !important;
		position: static !important;
	}

	.most-view-module-pager {
		order: 2;
		display: flex !important;
		gap: 8px;
		flex-shrink: 0;
		float: none !important;
		position: static !important;
	}

	.most-view-btn-pager {
		width: 36px;
		height: 36px;
		background: transparent !important;
		border: none !important;
		border-radius: 4px !important;
		color: var(--mainColorDark) !important;
		font-size: var(--fs-base);
		font-weight: 700;
		display: inline-flex !important;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		margin: 0 !important;
		padding: 0;
		transition: color .2s, background .2s;
		float: none !important;
		position: static !important;
		&:hover {
			background: var(--mainColorLight, #eaf7ee) !important;
			color: var(--mainColorDark) !important;
		}
	}

	.most-view-product-element {
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--lineColor, #e8e8e8);
		display: flex !important;
		flex-direction: column;
		height: auto !important;
		transition: box-shadow .2s, transform .2s;
		&:hover {
			box-shadow: 0 8px 24px rgba(0, 0, 0, .1);
			transform: translateY(-2px);
		}
	}

	.most-view-product-img {
		overflow: hidden;
		background: #f5f5f5;
		flex-shrink: 0;
		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform .35s ease;
		}
	}
	.most-view-product-element:hover .most-view-product-img img { transform: scale(1.04); }

	.most-view-product-element > a {
		display: flex;
		flex-direction: column;
		flex: 1;
		text-decoration: none;
		color: inherit;
	}
	.most-view-product-content {
		padding: 12px 12px 0 !important;
		min-height: unset !important;
		height: auto !important;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.most-view-product-name {
		max-height: unset !important;
		flex: 1;
		p {
			font-family: var(--font-primary);
			font-size: var(--fs-sm);
			font-weight: 700;
			color: var(--textColor, #333);
			line-height: 1.45;
			text-align: left;
			margin: 0;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}
	.most-view-product-price {
		padding: 0 0 8px;
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		.money {
			color: var(--mainColor) !important;
			font-size: var(--fs-base);
			font-weight: 700;
		}
	}
	.most-view-product-oldprice {
		color: #999 !important;
		font-size: var(--fs-xs, 12px);
		font-weight: 400;
		text-decoration: line-through;
	}
	.most-view-product-action { padding: 0 12px 12px; }
	.most-view-product-to-cart { margin: 0; }
	.most-view-btn-cart {
		display: block !important;
		width: 100%;
		padding: 9px 12px;
		background: var(--mainColorDark) !important;
		color: #fff !important;
		border: none;
		border-radius: 8px;
		font-family: var(--font-primary);
		font-size: var(--fs-sm);
		font-weight: 600;
		text-align: center;
		text-decoration: none !important;
		cursor: pointer;
		transition: background .2s, transform .2s;
		&:hover {
			background: var(--mainColor) !important;
			transform: translateY(-1px);
		}
	}
}

@media (max-width: 767px) {
	.ab-most-view-product-module {
		.most-view-module { padding: 1rem; }
		.most-view-module-heading {
			margin-bottom: 20px;
			flex-direction: column;
			align-items: flex-start;
		}
		.most-view-module-pager { order: 3; }
	}
}

/* Sapo Product Recommend app — loaded by snippets/product-recommend.bwt. */
.product-recommend-module-box {
	display: block !important;
	max-width: 1200px;
	margin: 48px auto !important;
	background: white !important;
	border-radius: 12px;
	overflow: hidden;
}

.product-recommend-module-title {
	margin: 0 0 24px;
	color: var(--mainColorDark) !important;
	font-family: var(--font-heading, var(--font-primary));
	font-size: var(--fs-xl) !important;
	font-weight: 700 !important;
	font-style: normal !important;
	line-height: 1.3;
	text-align: left !important;
	text-transform: uppercase;
}

#owl-product-recommend {
	width: 100%;
	margin: 0;
	padding: 0;
	position: relative;
	&.owl-carousel { display: block !important; }
	.owl-wrapper {
		display: flex !important;
    	gap: 10px;
	}
	.owl-item {
		float: none;
		box-sizing: border-box;
	}
	.item {
		margin: 0 !important;
		padding: 0 !important;
		background: #f5f5f5;
		overflow: hidden;
		aspect-ratio: 1;
		img {
			display: block;
			width: 100% !important;
			height: 100%;
			margin: 0 !important;
			object-fit: cover;
			transition: transform .35s ease;
		}
	}
}

.padding-item {
	height: 100%;
	padding: 0 8px;
}

a.product-recommend-link {
	display: flex;
	flex-direction: column;
	height: 100%;
	background: #fff;
	border: 1px solid var(--lineColor, #e8e8e8);
	border-radius: 12px;
	overflow: hidden;
	color: inherit;
	text-decoration: none !important;
	transition: box-shadow .2s, transform .2s;
	&:hover {
		box-shadow: 0 8px 24px rgba(0, 0, 0, .1);
		transform: translateY(-2px);
		#owl-product-recommend .item img { transform: scale(1.04); }
	}
}

.product-recommend-name {
	min-height: 60px;
	padding: 12px 12px 4px;
	color: var(--textColor, #333) !important;
	font-family: var(--font-primary);
	font-size: var(--fs-sm);
	font-weight: 700;
	line-height: 1.45;
	text-align: left;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.product-recommend-price {
	padding: 0 12px 14px;
	color: var(--mainColor) !important;
	font-family: var(--font-primary);
	font-size: var(--fs-base);
	font-weight: 700;
	line-height: 1.4;
	text-align: left;
}

#owl-product-recommend .owl-controls {
	margin-top: 20px;
	text-align: center;
}
#owl-product-recommend .owl-pagination {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
}
#owl-product-recommend .owl-page {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0;
	cursor: pointer;
	span {
		display: block;
		width: 8px;
		height: 8px;
		margin: 0;
		background: var(--lineColor, #dfe6e9);
		border-radius: 50%;
		transition: background .2s, transform .2s;
	}
	&.active span {
		background: var(--mainColor);
		transform: scale(1.2);
	}
}

@media (max-width: 767px) {
	.product-recommend-module-box {
		margin: 32px 0;
		padding: 24px 12px;
		border-radius: 0;
	}
	.product-recommend-module-title {
		margin-bottom: 20px;
		font-size: var(--fs-lg) !important;
	}
	.padding-item { padding: 0 5px; }
	#owl-product-recommend .owl-wrapper-outer {
		margin: 0 -5px;
		padding-left: 5px;
		padding-right: 5px;
	}
	.product-recommend-name {
		min-height: 56px;
		padding: 10px 10px 3px;
		font-size: var(--fs-xs);
	}
	.product-recommend-price {
		padding: 0 10px 12px;
		font-size: var(--fs-sm);
	}
	#owl-product-recommend .item img { height: 180px !important; }
	.padding-item { height: auto !important; }
	.product-recommend-name { min-height: unset !important; }
	.product-recommend-price { padding: 0 10px 8px; }
}

.pc-pdp-faq-section {
  padding: 48px 0 64px;
  max-width: 760px;
  margin: 0 auto;
}
.pc-pdp-faq-section .pc-booking-faq-title { text-align: center; margin-bottom: 24px; }
.pc-pdp-faq-section .pc-booking-faq-list { display: flex; flex-direction: column; gap: 12px; }
.pc-pdp-faq-section .pc-faq-item {
  background: #fff;
  border: 1px solid var(--lineColor);
  border-radius: 12px;
  padding: 16px 20px;
}
.pc-pdp-faq-section .pc-faq-q {
  cursor: pointer;
  font-weight: 600;
  color: var(--textBody);
  list-style: none;
}
.pc-pdp-faq-section .pc-faq-q::-webkit-details-marker { display: none; }
.pc-pdp-faq-section .pc-faq-q::before { content: '+ '; color: var(--mainColorDark); font-weight: 700; }
.pc-pdp-faq-section .pc-faq-item[open] .pc-faq-q::before { content: '– '; }
.pc-pdp-faq-section .pc-faq-a {
  margin-top: 10px;
  color: var(--textSub);
  font-size: var(--fs-sm);
  line-height: 1.6;
}

.pc-pdp-ingredients-section { padding: 48px 0; background: var(--bg-subtle, #F8F9FA); }
.pc-pdp-ingredients-title { text-align: center; margin-bottom: 32px; text-transform: uppercase; }
.pc-pdp-ingredients-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 991px) { .pc-pdp-ingredients-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 599px) { .pc-pdp-ingredients-grid { grid-template-columns: 1fr; } }
.pc-pdp-ing-card {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  border: 1px solid var(--lineColor);
}
.pc-pdp-ing-icon { font-size: 22px; }
.pc-pdp-ing-card h3 { margin: 10px 0 6px; font-size: var(--fs-sm); color: var(--textBody); }
.pc-pdp-ing-card p { margin: 0; font-size: var(--fs-xs); color: var(--textSub); line-height: 1.5; }

.pc-pdp-expert-section { padding: 40px 0; }
.pc-pdp-expert-card {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  background: var(--mainColorLight);
  border-radius: 20px;
  padding: 28px;
}
@media (max-width: 599px) { .pc-pdp-expert-card { flex-direction: column; align-items: center; text-align: center; } }
.pc-pdp-expert-avatar { width: 64px; height: 64px; font-size: var(--fs-base); flex-shrink: 0; }
.pc-pdp-expert-label {
  display: block;
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--mainColorDark);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 8px;
}
.pc-pdp-expert-quote { margin: 0 0 16px; font-style: italic; color: var(--textBody); line-height: 1.6; }

.pc-pdp-reviews-section { padding: 48px 0; }
.pc-pdp-reviews-title { text-align: center; margin-bottom: 32px; text-transform: uppercase; }
.pc-pdp-reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
@media (max-width: 767px) { .pc-pdp-reviews-grid { grid-template-columns: 1fr; } }
.pc-pdp-review-quote { margin-top: 12px; }

/* ── T-128 (2026-09-12): widget sao đánh giá + khối thông tin fallback ────────
   Xem lý do ở templates/product.bwt (.pc-stars) và snippets/tab_product.bwt
   (.pc-pdp-spec). Màu sao dùng --color-gold-dark (#B8860B) thay vì vàng tươi
   #FFC107: trên nền trắng #B8860B đạt tương phản ~4.6:1 (WCAG AA), vàng tươi
   chỉ ~1.9:1 — đúng nhóm lỗi tương phản báo cáo audit đã nêu. */
.pc-stars {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  margin-right: 6px;
  i { font-size: 14px; line-height: 1; }
  .pc-stars__on { color: var(--color-gold-dark, #B8860B); }
  .pc-stars__off { color: #C7CDD4; }
  .pc-stars__score {
    margin-left: 4px;
    font-weight: 700;
    color: var(--color-text-main, #13241F);
  }
}

.pc-pdp-desc-fallback p {
  margin-bottom: 16px;
  font-size: var(--fs-md);
  line-height: 1.7;
  color: var(--color-text-body, #334155);
}

.pc-pdp-spec {
  border: 1px solid var(--color-border-clinical, #E2E8F0);
  border-radius: 12px;
  padding: 16px 20px;
  background: var(--color-bg-page, #F8FAF7);
  .pc-pdp-spec__title {
    margin: 0 0 12px;
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--color-text-main, #13241F);
  }
  .pc-pdp-spec__list {
    list-style: none;
    margin: 0;
    padding: 0;
    li {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 8px 0;
      border-bottom: 1px dashed var(--color-border-clinical, #E2E8F0);
      font-size: var(--fs-base);
      &:last-child { border-bottom: 0; }
      span { color: var(--color-text-muted, #64748B); }
      b { color: var(--color-text-main, #13241F); font-weight: 600; text-align: right; }
    }
  }
  .pc-pdp-spec__note {
    margin: 12px 0 0;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--color-text-body, #334155);
    a {
      display: inline-block;
      margin-top: 4px;
      font-weight: 600;
      color: var(--mainColorDark, #1F5A3B);
      &:hover { text-decoration: underline; }
    }
  }
}
