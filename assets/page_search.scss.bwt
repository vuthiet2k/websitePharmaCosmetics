.margin-bottom-20{
	margin-bottom: 20px;
}
.title_search {
	font-size: var(--fs-lg);
	text-transform: uppercase;
	font-weight: bold;
	margin: 15px 0;
}
/*SEARCH PAGE*/
.search-main {
	.item-border {
		.item_product_main {
			border: 0;
		}
	}
}
.serachpc_searchpage {
	form{
		width: 260px;
		margin:6px 0 0 0;
		padding:0;
		position:relative;
		input {
			min-width: 260px;
			height: 40px !important;
			min-height: unset;
			line-height: 40px;
			border: solid 1px #ebebeb;
			border-radius: 3px !important;
			padding: 0 40px 0 15px;
			background: #fff;
			color: #959595;
			font-size: var(--fs-sm) /* rounded from 13px */;
		}
		button {
			width: 40px;
			height: 100%;
			box-shadow: none;
			border: none;
			background: transparent;
			border-radius: 50%;
			position: absolute;
			top: -2px;
			right: 5px;
			outline: none;
			svg{
				width: 17px;
				height: 17px;
			}
		}
	}
}

.category-products .row {
	padding-bottom: 1px;
}
.search-main .products-view-grid{
	float: initial;
}
.col-xs-15,.col-sm-15,.col-md-15,.col-lg-15 {
	position: relative;
	min-height: 1px;
	padding-right: 10px;
	padding-left: 10px;
	@media(max-width: 480px){
		padding-left: 7px;
		padding-right: 7px;
	}
}
.col-xs-15 {
	-ms-flex: 0 0 73%;
	flex: 0 0 73%;
	max-width: 73%;
}
@media (min-width: 768px) {
	.col-sm-15 {
		-ms-flex: 0 0 33.333333%;
		flex: 0 0 33.333333%;
		max-width: 33.333333%;
	}
}
@media (min-width: 992px) {
	.col-md-15 {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
}
@media (min-width: 1200px) {
	.col-lg-15 {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
}
.side-right-stick {
	position: sticky;
	top: 60px;
}
.search-type{
	margin-bottom: 20px;
	li{
		display: inline-block;
		margin-right: 5px;
		&:last-child {
			margin-right: 0px;
		}
		a{
			display: inline-block;
			padding: 5px 15px;
			font-size: var(--fs-base);
			border: 1px solid var(--mainColor);
			border-radius: 40px;
			color: var(--mainColor);
			position: relative;
			overflow: hidden;
			&.active, &:hover{
				color: #fff;
				background: var(--subColor);
				border: 1px solid var(--subColor);
			}
			&.active{
				pointer-events: none;
			}
		}
	}
}
.aside-content-blog{
	border: 1px solid #dee2e6;
	border-radius: 10px;
	padding: 15px;
	margin-bottom: 30px;
	@media(max-width: 767px) {
		margin-bottom: 25px;
	}
	.title-head{
		color: var(--textColor);
		margin: 0;
		font-size: var(--fs-xl);
		font-weight: 600;
		padding: 0px 0px 8px;
		border-bottom: .5px dashed #ebe0e0;
		margin-bottom: 10px;
		line-height: 1.4;
	}
	.nav-category{
		ul{
			padding: 0;
			margin: 0;
			list-style: none;
			.nav-item{
				.nav-link {
					display: block;
					padding: 3px 0;
					&.pr-5{
						padding-right: 30px;
					}
				}
				&.active{
					> .nav-link{
						color: var(--mainColor);
					}
				}
			}
			.menu_down {
				padding-left: 10px !important;
			}
			.down_icon{
				width: 30px;
				height: 30px;
				top: 2px;
				right: 0;
				transition: 0.5s all;
				cursor: pointer;
				position: absolute;
				display: flex;
				justify-content: center;
				align-items: center;
				&::before, &::after{
					position: absolute;
					content: '';
					top: 50%;
					left: 50%;
					-webkit-transform: translate(-50%, -50%) rotate(-90deg);
					transform: translate(-50%, -50%) rotate(-90deg);
					background-color: currentColor;
					-webkit-transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
					transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
					transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
					transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
				}
				&::before {
					width: 11px;
					height: 1px;
					opacity: 1;
				}
				&::after {
					width:1px;
					height: 11px;
				}
				&.cls_mn{
					>a {
						color: var(--mainColor);
					}
					&::after {
						-webkit-transform: translate(-50%, -50%) rotate(90deg);
						transform: translate(-50%, -50%) rotate(90deg);
					}
					&::before {
						opacity: 0;
					}
				}
			}
		}
	}
}
.blog_noibat{
	border: 1px solid #dee2e6;
	border-radius: 15px;
	padding: 15px;
	h2{
		color: var(--textColor);
		margin: 0;
		font-size: var(--fs-xl);
		font-weight: 600;
		padding: 0px 0px 8px;
		border-bottom: .5px dashed #ebe0e0;
		margin-bottom: 15px;
		line-height: 1.4;
		a {
			color: var(--textColor);
			position: relative;
			&:hover {
				color: var(--subColor);
			}
		}
	}
	.blog_content {
		.item {
			display: flex;
			flex-wrap: wrap;
			margin-bottom: 10px;
			border-bottom: 1px dashed #F2F2F2;
			padding-bottom: 5px;
			.post-thumb {
				width: 100px;
				margin-right: 10px;
				a {
					display: block;
					width: 100%;
					aspect-ratio: 600/380;
					overflow: hidden;
					border-radius: 4px;
					position: relative;
					img.loaded {
						width: auto !important;
						max-height: 100%;
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						margin: auto;
					}
				}
			}
			.contentright {
				width: calc(100% - 110px);
				h3{
					font-size: var(--fs-sm);
					margin: 0;
					margin-bottom: 0px;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					overflow: hidden;
					&:hover {
						color: var(--subColor);
						a {
							color: var(--subColor);
						}
					}
				}
			}
			.time-post {
				margin-bottom: 0px;
				span {
					font-size: var(--fs-sm) /* rounded from 13px */;
					font-style: italic;
				}
			}
			&:last-child{
				border: initial;
				margin: 0;
				padding: 0;
			}
		}
	}
}

.item-blog-all {
	display: block;
	position: relative;
	margin-bottom: 20px;
	.update_date {
		display: flex;
		margin-bottom: 7px;
		font-size: var(--fs-xs);
		color: #838383;
		justify-content: space-between;
		.user_name {
			b {
				color: var(--mainColor);
				font-weight: 500;
			}
		}

	}
	.image-blog{
		padding-bottom: 63.5%;
		overflow: hidden;
		height: auto;
		display: block;
		position: relative;
		border-radius: 10px;
		background-color: #f8f8f8;
		.user_date {
			position: absolute;
			top: 0px;
			left: 0px;
			background-color: var(--mainColor);
			padding: 5px;
			border-radius: 10px 0px 10px 0px;
			color:#fff;
			font-size: var(--fs-sm);
			font-weight: 600;
		}
		img {
			width: auto !important;
			max-height: 100%;
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0;
			right: 0;
			margin: auto;
			transition: .3s ease-in-out all;
			will-change: opacify;
		}
	}
	.blog_content {
		position: relative;
		width: 100%;
		background-color: #fff;
		padding-top: 15px;
		h3 {
			margin-bottom: 7px;
			line-height: 22px;
			a {
				color:var(--textColor);
				font-size: var(--fs-base);
				line-height: 22px;
				font-weight: 600;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				height: 44px;
				&:hover {
					color:var(--subColor);
				}
			}
		}
		.blog_description {
			color: var(--textColor);
			line-height: 20px;
			margin-bottom: 10px;
			word-break: break-word;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			text-overflow: ellipsis;
			overflow: hidden;
			height: 40px;
		}
		.read_more {
			font-weight: 600;
		}
	}
	&:hover{
		.image-blog img {
			transform: scale(1.1);
		}
	}
}
@media (max-width: 767px) {
	.item_article:not(.first-item) .item-blog-all {
		background-color: #fff;
		border-radius:10px;
		padding: 5px;
		.image-blog {
			width: 100px;
			margin-right: 10px;
			padding: 0px;
			padding-bottom: 63.33px;
			display: inline-block;
			border-radius: 10px;
		}
		.blog_content {
			width: calc(100% - 115px);
			padding: 0px;
			display: inline-block;
			h3{
				margin-bottom: 0px;
				a {
					font-size: var(--fs-sm);
					line-height: 20px;
					height: 40px;
				}
			}
			.update_date .user_date{
				font-size: var(--fs-sm) /* rounded from 13px */;
				margin-bottom: 0px;
			}
		}
		.blog_description {
			display: none;
		}
	}
}
/* ══ T-133 (2026-09-12): trạng thái "không có kết quả" giữ chân khách ══════════
   Lý do thiết kế + thứ tự ưu tiên nội dung: xem snippets/search_empty_state.bwt.
   Nguyên tắc màu: KHÔNG dùng đỏ báo lỗi (không có kết quả không phải lỗi của
   khách); mọi cặp màu chữ/nền dưới đây đều >= 4.5:1 theo WCAG AA. */
.pc-search-empty {
  max-width: 1160px;
  margin: 0 auto;

  &__head {
    background: #fff;
    border: 1px solid var(--color-border-clinical, #E2E8F0);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    @media (max-width: 575px) { padding: 24px 16px; }
  }

  &__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-mint-subtle, #E8F8EE);
    color: var(--mainColorDark, #1F5A3B);
    font-size: 24px;
  }

  &__title {
    margin: 0 0 8px;
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-main, #13241F);
  }

  &__sub {
    margin: 0 auto 20px;
    max-width: 620px;
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--color-text-body, #334155);
    b { color: var(--color-text-main, #13241F); font-weight: 600; }
  }

  &__form {
    display: flex;
    gap: 8px;
    max-width: 520px;
    margin: 0 auto;
    @media (max-width: 479px) { flex-direction: column; }
  }

  &__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 46px;
    padding: 0 16px;
    font-size: var(--fs-md);
    border: 1px solid var(--color-border-clinical, #E2E8F0);
    border-radius: 10px;
    outline: none;
    &:focus { border-color: var(--mainColor, #3CB371); box-shadow: 0 0 0 3px rgba(60, 179, 113, 0.18); }
  }

  &__submit {
    flex: 0 0 auto;
    height: 46px;
    padding: 0 24px;
    border: none;
    border-radius: 10px;
    background: var(--mainColor, #3CB371);
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-md);
    cursor: pointer;
    transition: background 0.2s;
    &:hover { background: var(--mainColorDark, #1F5A3B); }
  }

  &__block {
    margin-top: 32px;
  }

  &__block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  &__block-title {
    margin: 0 0 14px;
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-text-main, #13241F);
  }

  /* min-height 44px: ngưỡng vùng chạm tối thiểu trên thiết bị cảm ứng — đo thật
     bằng Playwright ở 390px thấy 2 phần tử của khối này dưới ngưỡng (chip 38px,
     link "Xem tất cả" 21px) nên nâng lên đúng 44px. */
  &__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--mainColorDark, #1F5A3B);
    &:hover { text-decoration: underline; }
  }

  &__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 6px 18px;
      border-radius: 9999px;
      background: #fff;
      border: 1px solid var(--color-border-clinical, #E2E8F0);
      color: var(--color-text-body, #334155);
      font-size: var(--fs-base);
      transition: all 0.18s;
      &:hover {
        background: var(--color-mint-subtle, #E8F8EE);
        border-color: var(--mainColor, #3CB371);
        color: var(--mainColorDark, #1F5A3B);
      }
    }
  }

  &__concerns {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    @media (max-width: 991px) { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 575px) { grid-template-columns: repeat(2, 1fr); }
    a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 96px;
      padding: 14px 10px;
      text-align: center;
      background: #fff;
      border: 1px solid var(--color-border-clinical, #E2E8F0);
      border-radius: 12px;
      color: var(--color-text-main, #13241F);
      font-size: var(--fs-base);
      font-weight: 600;
      line-height: 1.4;
      transition: all 0.18s;
      i {
        font-size: 20px;
        color: var(--mainColor, #3CB371);
      }
      &:hover {
        border-color: var(--mainColor, #3CB371);
        box-shadow: 0 6px 18px rgba(31, 90, 59, 0.1);
        transform: translateY(-2px);
      }
    }
  }

  &__cta {
    margin-top: 36px;
    padding: 28px 24px;
    border-radius: 16px;
    background: var(--bgHeader, #1F5A3B);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    h2 {
      margin: 0 0 6px;
      font-size: var(--fs-lg);
      font-weight: 700;
      color: #fff;
    }
    p {
      margin: 0;
      font-size: var(--fs-md);
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.9);
    }
  }

  &__cta-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  &__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: var(--fs-md);
    transition: all 0.2s;
    &--primary {
      background: #fff;
      color: var(--mainColorDark, #1F5A3B);
      &:hover { background: var(--color-mint-light, #D7F3E3); color: var(--mainColorDark, #1F5A3B); }
    }
    &--ghost {
      background: transparent;
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.55);
      &:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
    }
  }
}
