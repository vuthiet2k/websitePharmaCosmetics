/* page_search.scss.bwt — 14/11/2026: đã biên dịch phẳng + gỡ quy tắc chết bằng scripts/purge-dead-css.mjs (UI-0.4).
   File CŨ đang được thay dần bằng class Tailwind — KHÔNG thêm quy tắc mới vào đây. */
.margin-bottom-20 {
  margin-bottom: 20px;
}

.title_search {
  font-size: var(--fs-lg);
  text-transform: uppercase;
  font-weight: bold;
  margin: 15px 0;
}

/*SEARCH PAGE*/

.serachpc_searchpage form {
  width: 260px;
  margin: 6px 0 0 0;
  padding: 0;
  position: relative;
}
.serachpc_searchpage form input {
  min-width: 260px;
  height: 40px !important;
  min-height: unset;
  line-height: 40px;
  border: solid 1px #ebebeb;
  border-radius: 3px !important;
  padding: 0 40px 0 15px;
  background: #fff;
  color: #64748B; /* L02 25/10/2026: cũ #959595 3:1 */
  font-size: var(--fs-sm);
}
.serachpc_searchpage form button {
  width: 40px;
  height: 100%;
  box-shadow: none;
  border: none;
  background: transparent;
  border-radius: 50%;
  position: absolute;
  top: -2px;
  right: 5px;
  outline: none;
}
.serachpc_searchpage form button svg {
  width: 17px;
  height: 17px;
}

.category-products .row {
  padding-bottom: 1px;
}

.search-main .products-view-grid {
  float: initial;
}
.side-right-stick {
  position: sticky;
  top: 60px;
}

.search-type {
  margin-bottom: 20px;
}
.search-type li {
  display: inline-block;
  margin-right: 5px;
}
.search-type li:last-child {
  margin-right: 0px;
}
.search-type li a {
  display: inline-block;
  padding: 5px 15px;
  font-size: var(--fs-base);
  border: 1px solid var(--mainColor);
  border-radius: 40px;
  color: var(--mainColor);
  position: relative;
  overflow: hidden;
}
.search-type li a.active, .search-type li a:hover {
  color: #fff;
  background: var(--subColor);
  border: 1px solid var(--subColor);
}
.search-type li a.active {
  pointer-events: none;
}

.aside-content-blog {
  border: 1px solid #dee2e6;
  border-radius: 10px;
  padding: 15px;
  margin-bottom: 30px;
}
@media (max-width: 767px) {
  .aside-content-blog {
    margin-bottom: 25px;
  }
}
.aside-content-blog .title-head {
  color: var(--textColor);
  margin: 0;
  font-size: var(--fs-xl);
  font-weight: 600;
  padding: 0px 0px 8px;
  border-bottom: 0.5px dashed #ebe0e0;
  margin-bottom: 10px;
  line-height: 1.4;
}
.aside-content-blog .nav-category ul {
  padding: 0;
  margin: 0;
  list-style: none;
}
.aside-content-blog .nav-category ul .nav-item .nav-link {
  display: block;
  padding: 3px 0;
}
.aside-content-blog .nav-category ul .nav-item .nav-link.pr-5 {
  padding-right: 30px;
}
.aside-content-blog .nav-category ul .nav-item.active > .nav-link {
  color: var(--mainColor);
}
.aside-content-blog .nav-category ul .menu_down {
  padding-left: 10px !important;
}
.aside-content-blog .nav-category ul .down_icon {
  width: 30px;
  height: 30px;
  top: 2px;
  right: 0;
  transition: 0.5s all;
  cursor: pointer;
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
}
.aside-content-blog .nav-category ul .down_icon::before, .aside-content-blog .nav-category ul .down_icon::after {
  position: absolute;
  content: "";
  top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%) rotate(-90deg);
  transform: translate(-50%, -50%) rotate(-90deg);
  background-color: currentColor;
  -webkit-transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
  transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
  transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
  transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
}
.aside-content-blog .nav-category ul .down_icon::before {
  width: 11px;
  height: 1px;
  opacity: 1;
}
.aside-content-blog .nav-category ul .down_icon::after {
  width: 1px;
  height: 11px;
}
.aside-content-blog .nav-category ul .down_icon.cls_mn > a {
  color: var(--mainColor);
}
.aside-content-blog .nav-category ul .down_icon.cls_mn::after {
  -webkit-transform: translate(-50%, -50%) rotate(90deg);
  transform: translate(-50%, -50%) rotate(90deg);
}
.aside-content-blog .nav-category ul .down_icon.cls_mn::before {
  opacity: 0;
}

.blog_noibat {
  border: 1px solid #dee2e6;
  border-radius: 15px;
  padding: 15px;
}
.blog_noibat h2 {
  color: var(--textColor);
  margin: 0;
  font-size: var(--fs-xl);
  font-weight: 600;
  padding: 0px 0px 8px;
  border-bottom: 0.5px dashed #ebe0e0;
  margin-bottom: 15px;
  line-height: 1.4;
}
.blog_noibat h2 a {
  color: var(--textColor);
  position: relative;
}
.blog_noibat h2 a:hover {
  color: var(--subColor);
}
.blog_noibat .blog_content .item {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10px;
  border-bottom: 1px dashed #F2F2F2;
  padding-bottom: 5px;
}
.blog_noibat .blog_content .item .post-thumb {
  width: 100px;
  margin-right: 10px;
}
.blog_noibat .blog_content .item .post-thumb a {
  display: block;
  width: 100%;
  aspect-ratio: 600/380;
  overflow: hidden;
  border-radius: 4px;
  position: relative;
}
.blog_noibat .blog_content .item .post-thumb a img.loaded {
  width: auto !important;
  max-height: 100%;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto;
}
.blog_noibat .blog_content .item .contentright {
  width: calc(100% - 110px);
}
.blog_noibat .blog_content .item .contentright h3 {
  font-size: var(--fs-sm);
  margin: 0;
  margin-bottom: 0px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blog_noibat .blog_content .item .contentright h3:hover {
  color: var(--subColor);
}
.blog_noibat .blog_content .item .contentright h3:hover a {
  color: var(--subColor);
}
.blog_noibat .blog_content .item .time-post {
  margin-bottom: 0px;
}
.blog_noibat .blog_content .item .time-post span {
  font-size: var(--fs-sm);
  font-style: italic;
}
.blog_noibat .blog_content .item:last-child {
  border: initial;
  margin: 0;
  padding: 0;
}

.item-blog-all {
  display: block;
  position: relative;
  margin-bottom: 20px;
}
.item-blog-all .update_date {
  display: flex;
  margin-bottom: 7px;
  font-size: var(--fs-xs);
  color: #838383;
  justify-content: space-between;
}
.item-blog-all .update_date .user_name b {
  color: var(--mainColor);
  font-weight: 500;
}
.item-blog-all .image-blog {
  padding-bottom: 63.5%;
  overflow: hidden;
  height: auto;
  display: block;
  position: relative;
  border-radius: 10px;
  background-color: #f8f8f8;
}
.item-blog-all .image-blog .user_date {
  position: absolute;
  top: 0px;
  left: 0px;
  background-color: var(--mainColor);
  padding: 5px;
  border-radius: 10px 0px 10px 0px;
  color: #fff;
  font-size: var(--fs-sm);
  font-weight: 600;
}
.item-blog-all .image-blog img {
  width: auto !important;
  max-height: 100%;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto;
  transition: 0.3s ease-in-out all;
  will-change: opacify;
}
.item-blog-all .blog_content {
  position: relative;
  width: 100%;
  background-color: #fff;
  padding-top: 15px;
}
.item-blog-all .blog_content h3 {
  margin-bottom: 7px;
  line-height: 22px;
}
.item-blog-all .blog_content h3 a {
  color: var(--textColor);
  font-size: var(--fs-base);
  line-height: 22px;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 44px;
}
.item-blog-all .blog_content h3 a:hover {
  color: var(--subColor);
}
.item-blog-all .blog_content .blog_description {
  color: var(--textColor);
  line-height: 20px;
  margin-bottom: 10px;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  overflow: hidden;
  height: 40px;
}
.item-blog-all .blog_content .read_more {
  font-weight: 600;
}
.item-blog-all:hover .image-blog img {
  transform: scale(1.1);
}
/* ══ T-133 (2026-09-12): trạng thái "không có kết quả" giữ chân khách ══════════
   Lý do thiết kế + thứ tự ưu tiên nội dung: xem snippets/search_empty_state.bwt.
   Nguyên tắc màu: KHÔNG dùng đỏ báo lỗi (không có kết quả không phải lỗi của
   khách); mọi cặp màu chữ/nền dưới đây đều >= 4.5:1 theo WCAG AA. */
.pc-search-empty {
  max-width: 1160px;
  margin: 0 auto;
}
.pc-search-empty__head {
  background: #fff;
  border: 1px solid var(--color-border-clinical, #E2E8F0);
  border-radius: 16px;
  padding: 32px 24px;
  text-align: center;
}
@media (max-width: 575px) {
  .pc-search-empty__head {
    padding: 24px 16px;
  }
}
.pc-search-empty__icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 14px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-mint-subtle, #E8F8EE);
  color: var(--mainColorDark, #1F5A3B);
  font-size: var(--fs-xl);
}
.pc-search-empty__title {
  margin: 0 0 8px;
  font-size: var(--fs-xl);
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-text-main, #13241F);
}
.pc-search-empty__sub {
  margin: 0 auto 20px;
  max-width: 620px;
  font-size: var(--fs-md);
  line-height: 1.7;
  color: var(--color-text-body, #334155);
}
.pc-search-empty__sub b {
  color: var(--color-text-main, #13241F);
  font-weight: 600;
}
.pc-search-empty__form {
  display: flex;
  gap: 8px;
  max-width: 520px;
  margin: 0 auto;
}
@media (max-width: 479px) {
  .pc-search-empty__form {
    flex-direction: column;
  }
}
.pc-search-empty__input {
  flex: 1 1 auto;
  min-width: 0;
  height: 46px;
  padding: 0 16px;
  font-size: var(--fs-md);
  border: 1px solid var(--color-border-clinical, #E2E8F0);
  border-radius: 10px;
  outline: none;
}
.pc-search-empty__input:focus {
  border-color: var(--mainColor, #3CB371);
  box-shadow: 0 0 0 3px rgba(60, 179, 113, 0.18);
}
.pc-search-empty__submit {
  flex: 0 0 auto;
  height: 46px;
  padding: 0 24px;
  border: none;
  border-radius: 10px;
  background: var(--mainColor, #3CB371);
  color: #fff;
  font-weight: 600;
  font-size: var(--fs-md);
  cursor: pointer;
  transition: background 0.2s;
}
.pc-search-empty__submit:hover {
  background: var(--mainColorDark, #1F5A3B);
}
.pc-search-empty__block {
  margin-top: 32px;
}
.pc-search-empty__block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.pc-search-empty__block-title {
  margin: 0 0 14px;
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--color-text-main, #13241F);
}
.pc-search-empty {
  /* min-height 44px: ngưỡng vùng chạm tối thiểu trên thiết bị cảm ứng — đo thật
     bằng Playwright ở 390px thấy 2 phần tử của khối này dưới ngưỡng (chip 38px,
     link "Xem tất cả" 21px) nên nâng lên đúng 44px. */
}
.pc-search-empty__more {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--mainColorDark, #1F5A3B);
}
.pc-search-empty__more:hover {
  text-decoration: underline;
}
.pc-search-empty__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.pc-search-empty__chips a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 6px 18px;
  border-radius: 9999px;
  background: #fff;
  border: 1px solid var(--color-border-clinical, #E2E8F0);
  color: var(--color-text-body, #334155);
  font-size: var(--fs-base);
  transition: all 0.18s;
}
.pc-search-empty__chips a:hover {
  background: var(--color-mint-subtle, #E8F8EE);
  border-color: var(--mainColor, #3CB371);
  color: var(--mainColorDark, #1F5A3B);
}
.pc-search-empty__concerns {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}
@media (max-width: 991px) {
  .pc-search-empty__concerns {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 575px) {
  .pc-search-empty__concerns {
    grid-template-columns: repeat(2, 1fr);
  }
}
.pc-search-empty__concerns a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 96px;
  padding: 14px 10px;
  text-align: center;
  background: #fff;
  border: 1px solid var(--color-border-clinical, #E2E8F0);
  border-radius: 12px;
  color: var(--color-text-main, #13241F);
  font-size: var(--fs-base);
  font-weight: 600;
  line-height: 1.4;
  transition: all 0.18s;
}
.pc-search-empty__concerns a i {
  font-size: var(--fs-h4);
  color: var(--mainColor, #3CB371);
}
.pc-search-empty__concerns a:hover {
  border-color: var(--mainColor, #3CB371);
  box-shadow: 0 6px 18px rgba(31, 90, 59, 0.1);
  transform: translateY(-2px);
}
.pc-search-empty__cta {
  margin-top: 36px;
  padding: 28px 24px;
  border-radius: 16px;
  background: var(--bgHeader, #1F5A3B);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}
.pc-search-empty__cta h2 {
  margin: 0 0 6px;
  font-size: var(--fs-lg);
  font-weight: 700;
  color: #fff;
}
.pc-search-empty__cta p {
  margin: 0;
  font-size: var(--fs-md);
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}
.pc-search-empty__cta-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.pc-search-empty__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 22px;
  border-radius: 10px;
  font-weight: 600;
  font-size: var(--fs-md);
  transition: all 0.2s;
}
.pc-search-empty__btn--primary {
  background: #fff;
  color: var(--mainColorDark, #1F5A3B);
}
.pc-search-empty__btn--primary:hover {
  background: var(--color-mint-light, #D7F3E3);
  color: var(--mainColorDark, #1F5A3B);
}
.pc-search-empty__btn--ghost {
  background: transparent;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.55);
}
.pc-search-empty__btn--ghost:hover {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

/* 2026-10-03 (review trang tìm kiếm): hàng đầu trang = tiêu đề kết quả + tab Sản phẩm/Tin tức */
.pc-search-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 24px;
  margin-bottom: 24px;
}
.pc-search-head .search-type {
  margin-bottom: 0;
}

.pc-search-title {
  margin: 0;
  font-family: var(--font-heading, inherit);
  font-size: var(--fs-xl, 1.5rem);
  font-weight: 700;
  line-height: 1.3;
  color: var(--mainColorDark, #1f4d3a);
}

/* Thanh sắp xếp trong cột kết quả: dạng card, bỏ gạch chân mặc định của .sort-cate bên collection */
.pc-search-toolbar {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 12px 16px;
  margin-bottom: 24px;
}
.pc-search-toolbar .sort-cate {
  padding-bottom: 0;
  border-bottom: 0;
}

/* .row (margin âm 15px) bọc thẳng grid không qua .col → cột lọc/kết quả lệch trái so với tiêu đề */
.search-main .products-view-grid > .row-fix {
  margin-left: 0;
  margin-right: 0;
}

/* 2026-10-16: mobile không padding lồng nhau (.clinerules/02) — hộp bộ lọc thành dải phẳng. */
@media (max-width: 767px) {
  .pc-search-filterbox.bg-white {
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }
}
