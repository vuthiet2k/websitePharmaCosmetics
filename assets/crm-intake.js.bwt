/* CRM Intake 2026-09-25: client độc lập cho Sheet/GAS CRM; tuyệt đối không gọi MOPS. */
(function (window) {
  'use strict';

  var config = window.PharmaCrmIntakeConfig || {};
  var context = window.PharmaCrmCustomerContext || {};
  var sessionId = (function () {
    try {
      var key = 'pc_crm_intake_session_id';
      var stored = window.sessionStorage.getItem(key);
      if (stored) return stored;
      var created = 'crm_session_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
      window.sessionStorage.setItem(key, created);
      return created;
    } catch (error) {
      return 'crm_session_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
    }
  })();

  function ready() {
    return config.enabled === true && /^https:\/\/script\.google\.com\//i.test(String(config.endpoint || ''));
  }

  function submissionId() {
    if (window.crypto && typeof window.crypto.randomUUID === 'function') return 'crm_' + window.crypto.randomUUID();
    return 'crm_' + Date.now() + '_' + Math.random().toString(36).slice(2, 12);
  }

  function send(action, data) {
    if (!ready()) return Promise.reject(new Error('crm_safe_mode'));
    if (data.consent !== true || !data.consent_at) return Promise.reject(new Error('consent_required'));
    if (/data:image\/(?:jpeg|png|webp);base64,/i.test(JSON.stringify(data))) return Promise.reject(new Error('image_payload_forbidden'));
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    var timeoutMs = Math.max(1000, Math.min(30000, Number(config.timeout_ms) || 10000));
    var timer = controller ? window.setTimeout(function () { controller.abort(); }, timeoutMs) : null;
    var payload = Object.assign({
      action: action,
      submission_id: data.submission_id || submissionId(),
      session_id: sessionId,
      customer: context,
      page_url: window.location.href,
      website: ''
    }, data);

    return window.fetch(config.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
      signal: controller ? controller.signal : undefined
    }).then(function (response) {
      if (timer) window.clearTimeout(timer);
      if (!response.ok) throw new Error('crm_http_' + response.status);
      return response.json();
    }).then(function (result) {
      if (!result || result.success !== true) throw new Error((result && result.error) || 'crm_rejected');
      var recId = result.record_id || payload.submission_id;
      if (recId) {
        try {
          window.sessionStorage.setItem('pc_crm_intake_record_id', String(recId));
          window.sessionStorage.setItem('pc_crm_saved_at', new Date().toISOString());
        } catch (error) {}
      }
      return result;
    }).catch(function (error) {
      if (timer) window.clearTimeout(timer);
      throw error;
    });
  }

  function getCustomerInfo(query) {
    query = query || {};
    var savedRecId = null;
    var savedTime = null;
    try {
      savedRecId = window.sessionStorage.getItem('pc_crm_intake_record_id');
      savedTime = window.sessionStorage.getItem('pc_crm_saved_at');
    } catch (e) {}

    // Nếu endpoint GAS được bật và khả dụng, thực hiện query đến GAS
    if (ready()) {
      var queryPayload = Object.assign({
        action: 'get_customer_info',
        session_id: sessionId,
        submission_id: savedRecId || '',
        customer_id: context.id || '',
        phone: context.phone || '',
        email: context.email || ''
      }, query);

      return window.fetch(config.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(queryPayload)
      }).then(function (res) { return res.json(); }).then(function (res) {
        if (res && res.success && res.found) {
          return {
            success: true,
            stored_in_gas: true,
            source: res.source,
            record_id: res.record.submission_id,
            saved_at: res.record.created_at,
            customer: {
              id: res.record.customer_id || context.id || '',
              name: res.record.customer_name || context.name || 'Khách Hàng',
              phone: res.record.customer_phone || context.phone || '',
              email: res.record.customer_email || context.email || ''
            },
            consultation: res.record
          };
        }
        return buildLocalCustomerFallback(savedRecId, savedTime);
      }).catch(function () {
        return buildLocalCustomerFallback(savedRecId, savedTime);
      });
    }

    // Local / Safe mode fallback
    return Promise.resolve(buildLocalCustomerFallback(savedRecId, savedTime));
  }

  function buildLocalCustomerFallback(savedRecId, savedTime) {
    var skinScan = null;
    var skinType = null;
    try {
      skinScan = JSON.parse(window.sessionStorage.getItem('pc_skin_scan_result') || 'null');
      skinType = window.sessionStorage.getItem('pc_quiz_skin_type');
    } catch (e) {}

    var isStored = Boolean(savedRecId);
    var source = skinScan ? 'ai_skin_scan_camera' : (skinType ? 'ai_skin_quiz' : 'client_session');

    return {
      success: true,
      stored_in_gas: isStored,
      record_id: savedRecId || null,
      saved_at: savedTime || (isStored ? new Date().toISOString() : null),
      source: source,
      customer: {
        id: context.id || '',
        name: context.name || (context.logged_in ? 'Khách Hàng Thành Viên' : 'Khách Hàng Tư Vấn'),
        phone: context.phone || '',
        email: context.email || '',
        logged_in: Boolean(context.logged_in)
      },
      consultation: skinScan || (skinType ? { skin_type: skinType } : null)
    };
  }

  window.PharmaCrmIntake = {
    isReady: ready,
    createSubmissionId: submissionId,
    submitAiChat: function (data) { return send('save_ai_chat', data); },
    submitSkinAnalysis: function (data) {
      return send('save_skin_analysis', {
        submission_id: data.submission_id || submissionId(),
        consent: data.consent === true,
        consent_at: data.consent_at || new Date().toISOString(),
        source: 'ai_skin_scan_camera',
        analysis_result: {
          scores: data.scores,
          skin_type: data.skin_type || 'Báo cáo soi da camera',
          skin_age: data.skin_age,
          primary_concern: data.primary_concern,
          regimen: data.regimen,
          recommended_products: data.recommended_products || []
        }
      });
    },
    submitContactLead: function (data) { return send('submit_contact', data); },
    getCustomerInfo: getCustomerInfo,
    checkCustomerSaved: function () {
      try {
        return Boolean(window.sessionStorage.getItem('pc_crm_intake_record_id'));
      } catch (e) {
        return false;
      }
    }
  };
})(window);
