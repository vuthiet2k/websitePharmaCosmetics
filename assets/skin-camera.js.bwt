/* Soi da AI 2026-09-24: chụp tuần tự 3 góc, hỗ trợ Auto-shutter, fallback upload và xử lý mặc định tại thiết bị.
   Nâng cấp 2026-09-25: Báo cáo kết quả trực tiếp tại chỗ (Inline Dashboard) không chuyển trang,
   quét AI Deliberate có tiến trình 2s, kiểm định khuôn mặt thực tế trên ảnh tải lên. */
(function (window, document) {
  'use strict';
  var scan = document.querySelector('[data-skin-scan]'); if (!scan || scan.dataset.skinScanEnabled === 'false') return;
  var copy = window.PharmaSkinScanCopy || {};
  var modeAvailable = (scan.dataset.skinAnalysisMode || 'client_edge') === 'client_edge';
  var MAX_IMAGE_EDGE = 1280; var MAX_UPLOAD_BYTES = 12 * 1024 * 1024; var MAX_SOURCE_PIXELS = 32000000;
  var quiz = document.getElementById('aiSkinChatApp');
  scan.hidden = false;

  function selectMode(mode) {
    var cameraMode = mode === 'camera';
    scan.hidden = !cameraMode;
    if (quiz) quiz.hidden = cameraMode;
    document.querySelectorAll('[data-skin-mode]').forEach(function (button) {
      button.setAttribute('aria-selected', String(button.dataset.skinMode === mode));
    });
    if (!cameraMode) stop();
  }

  document.querySelectorAll('[data-skin-mode]').forEach(function (button) {
    button.addEventListener('click', function () { selectMode(button.dataset.skinMode); });
  });

  var video = document.getElementById('skinCameraStream');
  var guide = document.getElementById('skinGuidanceCanvas');
  var status = document.getElementById('skinCameraStatus');
  var start = scan.querySelector('[data-skin-camera-start]');
  var capture = scan.querySelector('[data-skin-camera-capture]');
  var switcher = scan.querySelector('[data-skin-camera-switch]');
  var uploadToggle = scan.querySelector('[data-skin-open-upload]');
  var upload = scan.querySelector('[data-skin-upload]');
  var analyze = scan.querySelector('[data-skin-analyze]');
  var inlineReport = scan.querySelector('[data-skin-inline-report]');
  var overlayEmpty = scan.querySelector('[data-skin-overlay-empty]');
  var methodNotice = scan.querySelector('[data-skin-analysis-method]');
  var stageEl = document.getElementById('skinCameraStageContainer');
  var scanningOverlay = scan.querySelector('[data-skin-scanning-progress]');
  var rescanBtn = scan.querySelector('[data-skin-rescan]');

  var detectionsByAngle = {};
  var modeUnavailable = scan.querySelector('[data-skin-mode-unavailable]');
  var angles = ['front', 'left', 'right'];
  var step = 0;
  var stream;
  var facing = 'user';
  var images = {};
  var previewImages = {};
  var captureQuality = {};
  var landmarksByAngle = {};
  var lastLandmarks;
  var meshSession;
  var meshQuality;
  var meshPending = false;
  var autoCaptureTimer = null;
  var isAnalyzing = false;

  function message(text) { status.textContent = text; }

  function drawGuide() {
    var width = video.videoWidth || 720;
    var height = video.videoHeight || 540;
    guide.width = width;
    guide.height = height;
    var c = guide.getContext('2d');
    c.clearRect(0, 0, width, height);
    c.strokeStyle = meshQuality && meshQuality.available && !meshQuality.valid ? '#F59E0B' : '#3CB371';
    c.lineWidth = Math.max(3, width / 180);
    c.setLineDash([12, 9]);
    c.beginPath();
    c.ellipse(width / 2, height / 2, width * .24, height * .36, 0, 0, Math.PI * 2);
    c.stroke();
    c.setLineDash([]);
  }

  function update() {
    angles.forEach(function (angle, index) {
      var indicator = scan.querySelector('[data-skin-step="' + angle + '"]');
      if (indicator) {
        indicator.classList.toggle('is-active', index === step);
        indicator.classList.toggle('is-complete', Boolean(images[angle]));
      }
    });

    capture.disabled = !stream || step >= angles.length || meshPending || Boolean(meshSession && (!meshQuality || !meshQuality.available || !meshQuality.valid));
    analyze.disabled = angles.some(function (angle) { return !images[angle]; }) || isAnalyzing;

    if (step < angles.length && !meshQuality && !status.textContent) {
      var stepEl = scan.querySelector('[data-skin-step="' + angles[step] + '"]');
      var stepText = (stepEl && (stepEl.querySelector('.pc-step-text') || stepEl).textContent || '').trim();
      message((copy.prompt || 'Hãy chụp góc: {angle}.').replace('{angle}', stepText));
    }
  }

  function stop() {
    if (autoCaptureTimer) { clearTimeout(autoCaptureTimer); autoCaptureTimer = null; }
    scan.classList.remove('is-streaming');
    if (stageEl) stageEl.classList.remove('is-streaming');
    if (meshSession) meshSession.stop();
    meshSession = null;
    meshQuality = null;
    lastLandmarks = null;
    meshPending = false;
    if (stream) stream.getTracks().forEach(function (track) { track.stop(); });
    stream = null;
    video.srcObject = null;
    capture.disabled = true;
  }

  function releaseImageBuffers() {
    stop();
    images = {}; previewImages = {}; captureQuality = {}; landmarksByAngle = {}; detectionsByAngle = {};
    scan.querySelectorAll('[data-skin-upload-angle]').forEach(function (input) { input.value = ''; });
    scan.querySelectorAll('[data-dropzone-card]').forEach(function (card) { card.classList.remove('has-file'); });
    scan.querySelectorAll('[data-skin-preview]').forEach(function (canvas) { canvas.width = 0; canvas.height = 0; });
    guide.width = 0; guide.height = 0;
    inlineReport.hidden = true;
    if (scanningOverlay) scanningOverlay.hidden = true;
    step = 0;
    isAnalyzing = false;
    update();
  }

  if (rescanBtn) {
    rescanBtn.addEventListener('click', function () {
      releaseImageBuffers();
      message('Đã đặt lại. Bạn có thể bắt đầu soi da hoặc tải ảnh mới.');
      window.scrollTo({ top: scan.offsetTop - 20, behavior: 'smooth' });
    });
  }

  function triggerCapture() {
    if (!stream || step >= angles.length) return;
    if (meshQuality && meshQuality.available && !meshQuality.valid) {
      message(copy.faceAdjust || 'Góc mặt chưa đạt yêu cầu. Vui lòng điều chỉnh theo khung hướng dẫn.');
      return;
    }
    var frame = snapshot(video);
    var light = window.PharmaSkinLighting && window.PharmaSkinLighting.analyze(frame, scan.dataset.skinMinLight, lastLandmarks);
    if (light && !light.valid) {
      message(lightingMessage(light.reason));
      return;
    }

    // Hiệu ứng chớp sáng Shutter Flash
    if (stageEl) {
      stageEl.classList.add('pc-shutter-flash');
      setTimeout(function () { stageEl.classList.remove('pc-shutter-flash'); }, 220);
    }

    save(angles[step], frame, light || { valid: true }, lastLandmarks);
  }

  function meshFeedback(points) {
    lastLandmarks = points;
    meshQuality = window.PharmaSkinMesh.evaluate(points, angles[step], video.videoWidth / video.videoHeight);
    drawGuide();

    if (meshQuality.valid) {
      message(copy.facePass || 'Tư thế đạt yêu cầu. Đang tự động chụp…');
      // Cơ chế Auto-Shutter: Giữ tư thế ổn định 1000ms sẽ tự động bấm chụp
      if (!autoCaptureTimer && stream && step < angles.length) {
        autoCaptureTimer = setTimeout(function () {
          autoCaptureTimer = null;
          if (stream && step < angles.length && meshQuality && meshQuality.valid) {
            triggerCapture();
          }
        }, 1000);
      }
    } else {
      if (autoCaptureTimer) {
        clearTimeout(autoCaptureTimer);
        autoCaptureTimer = null;
      }
      if (!meshQuality.available) {
        message(copy.noFace || 'Chưa nhận diện được khuôn mặt. Hãy căn mặt vào khung.');
      } else {
        message(meshQuality.guidance || copy.faceAdjust || 'Hãy điều chỉnh góc mặt và khoảng cách theo khung hướng dẫn.');
      }
    }
    update();
  }

  async function begin() {
    if (!modeAvailable) {
      message(copy.modeUnavailable || 'Chế độ xử lý qua máy chủ chưa được tích hợp hoặc phê duyệt.');
      return;
    }
    try {
      stop();
      stream = await navigator.mediaDevices.getUserMedia({
        video: { width: { ideal: 1920, min: 720 }, height: { ideal: 1080, min: 480 }, facingMode: facing },
        audio: false
      });
      video.srcObject = stream;
      await video.play();
      scan.classList.add('is-streaming');
      if (stageEl) stageEl.classList.add('is-streaming');
      drawGuide();
      capture.disabled = false;
      switcher.hidden = false;
      update();

      if (window.PharmaSkinMesh) {
        meshPending = true;
        update();
        window.PharmaSkinMesh.start(video, meshFeedback).then(function (session) {
          meshSession = session;
          meshPending = false;
          update();
        }).catch(function () {
          meshPending = false;
          message(copy.meshFallback || 'Đang dùng hướng dẫn căn mặt thủ công do thiết bị chưa tải được nhận diện khuôn mặt.');
          capture.disabled = false;
        });
      }
    } catch (error) {
      scan.classList.remove('is-streaming');
      if (stageEl) stageEl.classList.remove('is-streaming');
      upload.hidden = false;
      message(copy.cameraFallback || 'Không thể mở camera. Bạn có thể tải đủ 3 ảnh từ thiết bị.');
    }
  }

  function snapshot(source) {
    var sourceWidth = source.videoWidth || source.naturalWidth || source.width;
    var sourceHeight = source.videoHeight || source.naturalHeight || source.height;
    var scale = Math.min(1, MAX_IMAGE_EDGE / sourceWidth, MAX_IMAGE_EDGE / sourceHeight);
    var canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(sourceWidth * scale));
    canvas.height = Math.max(1, Math.round(sourceHeight * scale));
    canvas.getContext('2d').drawImage(source, 0, 0, canvas.width, canvas.height);
    return canvas;
  }

  function save(angle, canvas, quality, landmarks) {
    if (autoCaptureTimer) { clearTimeout(autoCaptureTimer); autoCaptureTimer = null; }
    images[angle] = canvas;
    captureQuality[angle] = quality;
    if (landmarks) landmarksByAngle[angle] = landmarks;
    else delete landmarksByAngle[angle];
    step = Math.min(angles.length, step + 1);

    if (step === angles.length) {
      stop();
      message('Đã hoàn tất chụp 3 góc mặt! Bạn có thể kiểm tra và bấm "Phân tích 3 ảnh đã chụp" bên dưới.');
      update();
      if (analyze) {
        analyze.disabled = false;
        analyze.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } else {
      update();
    }
  }

  function renderPreviews() {
    var visibleTypes = Array.prototype.filter.call(scan.querySelectorAll('[data-skin-layer]:checked'), function (input) {
      return input.checked;
    }).map(function (input) { return input.dataset.skinLayer; });
    var hasDetections = false;
    angles.forEach(function (angle) {
      var boxes = detectionsByAngle[angle] || [];
      hasDetections = hasDetections || boxes.length > 0;
      window.PharmaSkinOverlay.render(scan.querySelector('[data-skin-preview="' + angle + '"]'), previewImages[angle] || images[angle], boxes, visibleTypes);
    });
    overlayEmpty.hidden = hasDetections;
  }

  scan.querySelectorAll('[data-skin-layer]').forEach(function (input) {
    input.addEventListener('change', renderPreviews);
  });

  function lightingMessage(reason) {
    if (reason === 'too_dark') return copy.lightDark || 'Không gian quá tối, vui lòng bổ sung ánh sáng.';
    if (reason === 'too_bright') return copy.lightBright || 'Ảnh quá sáng, vui lòng tránh ánh sáng gắt hoặc ngược sáng.';
    if (reason === 'low_contrast') return copy.lightLowContrast || 'Ảnh thiếu tương phản, vui lòng tìm nơi có ánh sáng dịu và rõ hơn.';
    return copy.lightUneven || 'Ánh sáng hai bên mặt chưa đều, vui lòng điều chỉnh trước khi chụp.';
  }

  capture.addEventListener('click', triggerCapture);
  start.addEventListener('click', begin);
  switcher.addEventListener('click', function () {
    facing = facing === 'user' ? 'environment' : 'user';
    begin();
  });
  uploadToggle.addEventListener('click', function () {
    upload.hidden = !upload.hidden;
  });

  upload.querySelectorAll('input[type="file"]').forEach(function (input) {
    input.addEventListener('change', function () {
      var file = input.files && input.files[0];
      if (!file) return;
      var card = input.closest('[data-dropzone-card]') || input.closest('.pc-upload-card');
      if (file.size > MAX_UPLOAD_BYTES) {
        input.value = '';
        if (card) card.classList.remove('has-file');
        message(copy.uploadTooLarge || 'Ảnh vượt dung lượng 12 MB. Hãy chọn ảnh nhỏ hơn để tránh quá tải thiết bị.');
        return;
      }
      var image = new Image();
      image.onload = async function () {
        var angle = input.dataset.skinUploadAngle;
        if (image.naturalWidth * image.naturalHeight > MAX_SOURCE_PIXELS) {
          input.value = '';
          if (card) card.classList.remove('has-file');
          message(copy.imageDimensionsTooLarge || 'Độ phân giải ảnh vượt giới hạn xử lý an toàn trên thiết bị. Hãy giảm kích thước ảnh rồi thử lại.');
          URL.revokeObjectURL(image.src);
          return;
        }
        var frame = snapshot(image);
        var light = window.PharmaSkinLighting && window.PharmaSkinLighting.analyze(frame, scan.dataset.skinMinLight);
        if (light && !light.valid) {
          delete images[angle];
          delete captureQuality[angle];
          delete landmarksByAngle[angle];
          if (card) card.classList.remove('has-file');
          step = angles.filter(function (item) { return images[item]; }).length;
          message(lightingMessage(light.reason));
          update();
          URL.revokeObjectURL(image.src);
          return;
        }

        // KIỂM ĐỊNH KHUÔN MẶT BẰNG AI MESH TRÊN ẢNH TẢI LÊN
        var faceCheck = { available: false, valid: true };
        if (window.PharmaSkinMesh && window.PharmaSkinMesh.detectImage) {
          message('Đang kiểm tra khuôn mặt trong ảnh…');
          try {
            faceCheck = await window.PharmaSkinMesh.detectImage(frame, angle);
          } catch (e) {
            faceCheck = { available: false, valid: true };
          }
        }

        if (faceCheck.available && !faceCheck.valid) {
          input.value = '';
          delete images[angle];
          delete captureQuality[angle];
          delete landmarksByAngle[angle];
          if (card) card.classList.remove('has-file');
          step = angles.filter(function (item) { return images[item]; }).length;
          update();
          URL.revokeObjectURL(image.src);
          if (faceCheck.reason === 'no_face') {
            message('❌ Ảnh ' + (angle === 'front' ? 'chính diện' : angle === 'left' ? 'má trái' : 'má phải') + ' không nhận diện được khuôn mặt. Vui lòng tải ảnh rõ mặt người.');
          } else {
            message(faceCheck.guidance || 'Góc mặt chưa đúng yêu cầu cho góc chụp này. Vui lòng chọn ảnh phù hợp.');
          }
          return;
        }

        images[angle] = frame;
        captureQuality[angle] = light || { valid: true };
        if (faceCheck.landmarks) {
          landmarksByAngle[angle] = faceCheck.landmarks;
        }
        if (card) card.classList.add('has-file');
        step = angles.filter(function (item) { return images[item]; }).length;

        if (angles.every(function (ang) { return Boolean(images[ang]); })) {
          message('Đã nạp đủ 3 ảnh hợp lệ! Bạn có thể nhấn "Phân tích 3 ảnh đã chụp" bên dưới.');
        } else {
          message('Đã nạp ảnh ' + (angle === 'front' ? 'chính diện' : angle === 'left' ? 'má trái' : 'má phải') + ' thành công.');
        }
        update();
        URL.revokeObjectURL(image.src);
      };
      image.src = URL.createObjectURL(file);
    });
  });

  function renderInlineDashboard(report, routine, tone, wrinkle, surface, redness) {
    surface = surface || { acne_ratio: 0.02, pigment_ratio: 0.02, texture_ratio: 0.15 };
    redness = redness || { ratio: 0.05 };
    wrinkle = wrinkle || { density: 0.1 };

    // 0. Điền Thẻ Đánh Giá Lâm Sàng Toàn Diện
    var skinTypeEl = scan.querySelector('[data-assessment-skin-type]');
    var overallScoreEl = scan.querySelector('[data-assessment-overall-score]');
    var overallStatusEl = scan.querySelector('[data-assessment-overall-status]');
    var zoneTEl = scan.querySelector('[data-zone-t]');
    var zoneUEl = scan.querySelector('[data-zone-u]');
    var zoneChinEl = scan.querySelector('[data-zone-chin]');
    var zoneAgingEl = scan.querySelector('[data-zone-aging]');
    var adviceEl = scan.querySelector('[data-assessment-advice]');

    if (report && report.scores) {
      var scKeys = Object.keys(report.scores);
      var avgScore = Math.round(scKeys.reduce(function (sum, k) { return sum + (report.scores[k].ui_score || 75); }, 0) / Math.max(1, scKeys.length));
      if (overallScoreEl) overallScoreEl.textContent = avgScore + '/100';
      if (overallStatusEl) {
        overallStatusEl.textContent = avgScore >= 85 ? '(Rất khỏe mạnh)' : avgScore >= 72 ? '(Khá tốt, cần cân bằng)' : '(Cần chăm sóc phục hồi)';
      }

      var skinTypeName = 'Làn da hỗn hợp thiên dầu';
      var adviceText = 'Ưu tiên làm sạch dịu nhẹ với sữa rửa mặt pH 5.5, bổ sung Niacinamide 5% kết hợp Zinc PCA để kiềm dầu và thu nhỏ lỗ chân lông, kết hợp BHA 2% 2-3 lần/tuần để thông thoáng bít tắc.';
      if (surface.acne_ratio > 0.06 || report.scores.acne.raw_score > 0.35) {
        skinTypeName = 'Làn Da Dầu Dễ Bít Tắc & Nổi Mụn';
        adviceText = 'Ưu tiên kiềm dầu và kháng viêm dịu nhẹ: Sữa rửa mặt tạo bọt Amino Acid, Toner BHA 2% thông thoáng cổ nang lông, kết hợp Serum Niacinamide + Kẽm để kiểm soát dầu thừa.';
      } else if (redness.ratio > 0.10) {
        skinTypeName = 'Làn Da Nhạy Cảm / Dễ Kích Ứng';
        adviceText = 'Tập trung phục hồi hàng rào bảo vệ da: Dùng nước tẩy trang dịu nhẹ, bổ sung Panthenol (Vitamin B5), Ceramide và rau má Centella; tạm ngưng các sản phẩm acid nồng độ cao.';
      } else if (wrinkle.density > 0.30) {
        skinTypeName = 'Làn Da Lão Hóa & Cần Cải Thiện Độ Săn Chắc';
        adviceText = 'Duy trì độ ẩm đa tầng với Hyaluronic Acid và phục hồi màng bảo vệ da. Buổi tối cân nhắc bổ sung Retinol 0.3% hoặc phức hợp Peptide để kích thích tái sinh tế bào.';
      } else if (surface.pigment_ratio > 0.06) {
        skinTypeName = 'Làn Da Tăng Sắc Tố & Không Đều Màu';
        adviceText = 'Bảo vệ nghiêm ngặt bằng kem chống nắng phổ rộng SPF50+ PA++++. Kết hợp Serum Vitamin C 15% hoặc Tranexamic Acid 3% vào chu trình buổi sáng và tối.';
      }
      if (skinTypeEl) skinTypeEl.textContent = skinTypeName;

      if (zoneTEl) {
        zoneTEl.textContent = (surface.texture_ratio > 0.18 || surface.acne_ratio > 0.03)
          ? 'Tuyến bã nhờn vùng trán và sống mũi hoạt động khá mạnh, có độ bóng nhờn nhẹ và lỗ chân lông vùng cánh mũi có xu hướng giãn nở.'
          : 'Vùng chữ T kiểm soát bã nhờn tương đối tốt, bề mặt trán và sống mũi mịn màng, ít bít tắc.';
      }
      if (zoneUEl) {
        zoneUEl.textContent = (redness.ratio > 0.07)
          ? 'Hai bên má có mao mạch hơi nhạy cảm nhẹ hoặc ửng đỏ sau khi làm sạch, sắc tố tương đối đều màu, ít đốm thâm nâu.'
          : 'Hai bên má mịn màng, sắc thái da tươi sáng đồng đều, hàng rào biểu bì duy trì độ ẩm tự nhiên tốt.';
      }
      if (zoneChinEl) {
        zoneChinEl.textContent = (surface.acne_ratio > 0.02)
          ? 'Vùng cằm và quanh khóe miệng phát hiện một vài điểm bít tắc cổ nang lông nhỏ, cần lưu ý thao tác làm sạch kỹ càng.'
          : 'Vùng cằm và đường viền hàm sạch thoáng, bề mặt da láng mịn không có ổ viêm bít tắc.';
      }
      if (zoneAgingEl) {
        zoneAgingEl.textContent = (wrinkle.density > 0.25)
          ? 'Bắt đầu có rãnh cười nhẹ hoặc đường mảnh do thiếu ẩm biểu bì, cần tăng cường cấp ẩm sâu.'
          : 'Chưa xuất hiện nếp nhăn tĩnh sâu, cấu trúc mô liên kết duy trì độ săn chắc và đàn hồi tự nhiên rất tốt.';
      }
      if (adviceEl) adviceEl.textContent = adviceText;
    }

    // 1. Điền 5 thẻ điểm số
    var scoreGrid = scan.querySelector('[data-inline-scan-scores]');
    if (scoreGrid && report && report.scores) {
      scoreGrid.innerHTML = '';
      var names = {
        acne: 'Mụn & Bít tắc',
        pigmentation: 'Sắc tố & Thâm sạm',
        wrinkles: 'Nếp nhăn & Rãnh',
        redness: 'Vùng đỏ & Nhạy cảm',
        pores: 'Lỗ chân lông'
      };
      var colorClasses = {
        acne: 'pc-metric--acne',
        pigmentation: 'pc-metric--pigment',
        wrinkles: 'pc-metric--wrinkle',
        redness: 'pc-metric--redness',
        pores: 'pc-metric--pores'
      };
      Object.keys(report.scores).forEach(function (key) {
        var sc = report.scores[key];
        var card = document.createElement('div');
        card.className = 'pc-inline-score-card ' + (colorClasses[key] || '');
        var levelClass = sc.ui_score >= 85 ? 'is-good' : sc.ui_score >= 70 ? 'is-fair' : 'is-attention';
        card.innerHTML = `
          <div class="pc-score-card-header">
            <span class="pc-score-name">${names[key] || key}</span>
            <span class="pc-score-badge ${levelClass}">${sc.level || ''}</span>
          </div>
          <div class="pc-score-main">
            <span class="pc-score-number">${sc.ui_score || '—'}</span>
            <span class="pc-score-unit">/100</span>
          </div>
          <div class="pc-score-bar-track">
            <div class="pc-score-bar-fill ${levelClass}" style="width: ${Math.min(100, sc.ui_score || 0)}%"></div>
          </div>
        `;
        scoreGrid.appendChild(card);
      });
    }

    // 2. Điền tuổi da & vấn đề chính
    var ageEl = scan.querySelector('[data-inline-skin-age]');
    var ageVal = scan.querySelector('[data-inline-skin-age-val]');
    if (ageEl && ageVal) {
      if (report && report.skin_age) {
        ageVal.textContent = report.skin_age + ' tuổi';
        ageEl.hidden = false;
      } else {
        ageEl.hidden = true;
      }
    }

    var concernEl = scan.querySelector('[data-inline-primary-concern]');
    var concernVal = scan.querySelector('[data-inline-primary-concern-val]');
    if (concernEl && concernVal && routine) {
      var concernNames = {
        acne: 'Chăm sóc mụn & làm dịu',
        pigmentation: 'Làm sáng & đều màu da',
        wrinkles: 'Cải thiện nếp nhăn & chống lão hóa',
        redness: 'Phục hồi da nhạy cảm & làm dịu đỏ',
        pores: 'Kiểm soát dầu & thu nhỏ lỗ chân lông'
      };
      concernVal.textContent = concernNames[routine.primary_concern] || routine.primary_concern || 'Nền da cần phục hồi';
      concernEl.hidden = false;
    }

    // 3. Vẽ Radar Chart 5 trục
    var radarShape = scan.querySelector('[data-inline-radar-shape]');
    if (radarShape && report && report.scores) {
      var radarKeys = ['acne', 'pigmentation', 'wrinkles', 'redness', 'pores'];
      var radarPoints = radarKeys.map(function (key, index) {
        var raw = Number(report.scores[key] && report.scores[key].raw_score) || 0;
        var value = Math.max(0.12, Math.min(1, raw));
        var angle = (-90 + index * 72) * Math.PI / 180;
        return {
          x: 180 + Math.cos(angle) * 105 * value,
          y: 160 + Math.sin(angle) * 105 * value
        };
      });
      radarShape.setAttribute('points', radarPoints.map(function (pt) { return pt.x.toFixed(1) + ',' + pt.y.toFixed(1); }).join(' '));
    }

    // 4. Điền Phác đồ 3 giai đoạn & sản phẩm
    var regimenGrid = scan.querySelector('[data-inline-regimen-grid]');
    if (regimenGrid && routine) {
      regimenGrid.innerHTML = '';
      var stages = [
        { num: 1, title: 'Làm Dịu & Ổn Định', desc: 'Ưu tiên làm sạch dịu nhẹ, hạn chế sản phẩm đặc trị nặng đô, cân bằng pH và giữ ẩm cơ bản.' },
        { num: 2, title: 'Phục Hồi Hàng Rào Da', desc: 'Củng cố màng lipid với ceramide, B5, hyaluronic acid; tăng cường sức đề kháng cho làn da.' },
        { num: 3, title: 'Điều Trị Chuyên Sâu', desc: 'Định hướng can thiệp hoạt chất mục tiêu (AHA/BHA/Retinol/Vitamin C) theo dung nạp của da.' }
      ];

      stages.forEach(function (stg, idx) {
        var col = document.createElement('div');
        col.className = 'pc-regimen-stage-card';
        var stageRoutineText = (routine.stages && routine.stages[idx]) ? routine.stages[idx] : stg.desc;
        
        var productHtml = '';
        if (routine.products && routine.products.length) {
          var matchedProd = routine.products.find(function (p) { return p.stage === stg.num; }) || routine.products[idx];
          if (matchedProd && matchedProd.label) {
            productHtml = `
              <div class="pc-regimen-product-box">
                <span class="pc-regimen-prod-label"><i class="fas fa-prescription-bottle-medical"></i> Sản phẩm tham khảo:</span>
                <a href="${matchedProd.url || '/collections/all'}" target="_blank" rel="noopener" class="pc-regimen-prod-link">
                  <span>${matchedProd.label}</span>
                  <i class="fas fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            `;
          }
        }

        col.innerHTML = `
          <div class="pc-stage-badge">GIAI ĐOẠN ${stg.num}</div>
          <h5 class="pc-stage-title">${stg.title}</h5>
          <p class="pc-stage-desc">${stageRoutineText}</p>
          ${productHtml}
        `;
        regimenGrid.appendChild(col);
      });
    }
  }

  function analyzeLocal() {
    if (angles.some(function (angle) { return !images[angle]; })) return;
    var rejectedAngle = angles.find(function (angle) { return !captureQuality[angle] || captureQuality[angle].valid !== true; });
    if (rejectedAngle) {
      message(lightingMessage(captureQuality[rejectedAngle] && captureQuality[rejectedAngle].reason));
      return;
    }

    isAnalyzing = true;
    update();
    message(copy.analyzing || 'Đang phân tích tại thiết bị…');

    // Kích hoạt tiến trình quét AI Deliberate
    if (scanningOverlay) {
      scanningOverlay.hidden = false;
      var barFill = scanningOverlay.querySelector('.pc-scanning-bar-fill');
      var statusTxt = scanningOverlay.querySelector('.pc-scanning-status-text');
      var percentTxt = scanningOverlay.querySelector('.pc-scanning-percent');
      
      if (barFill) barFill.style.width = '30%';
      if (percentTxt) percentTxt.textContent = '30%';
      if (statusTxt) statusTxt.textContent = 'Đang nhận diện các vùng da T-Zone và U-Zone…';

      setTimeout(function () {
        if (barFill) barFill.style.width = '70%';
        if (percentTxt) percentTxt.textContent = '70%';
        if (statusTxt) statusTxt.textContent = 'Đang đo đạc sắc tố, nếp nhăn và bề mặt lỗ chân lông…';
      }, 700);

      setTimeout(function () {
        if (barFill) barFill.style.width = '95%';
        if (percentTxt) percentTxt.textContent = '95%';
        if (statusTxt) statusTxt.textContent = 'Đang hoàn tất bảng chỉ số lâm sàng và phác đồ…';
      }, 1400);
    }

    var roiByAngle = {};
    angles.forEach(function (angle) {
      roiByAngle[angle] = window.PharmaSkinDeid.extractRois(images[angle]);
    });
    function average(items, key) { return items.reduce(function (sum, item) { return sum + item[key]; }, 0) / Math.max(1, items.length); }
    var rednessMeasures = angles.map(function (angle) { return window.PharmaSkinCV.analyzeRedness(roiByAngle[angle].u_zone_left); });
    var wrinkle = window.PharmaSkinCV.analyzeWrinkles(roiByAngle.front.neck);
    var surfaceMeasures = angles.map(function (angle) { return window.PharmaSkinCV.analyzeSurface(roiByAngle[angle].t_zone); });
    var surface = { acne_ratio: average(surfaceMeasures, 'acne_ratio'), pigment_ratio: average(surfaceMeasures, 'pigment_ratio'), texture_ratio: average(surfaceMeasures, 'texture_ratio') };
    var redness = { ratio: average(rednessMeasures, 'ratio') };
    var tone = window.PharmaSkinMst.sample(images.front, landmarksByAngle.front);
    var modelUrl = scan.dataset.skinModelUrl;
    var modelHash = scan.dataset.skinModelSha256;
    var detectionsPromise = modelUrl && window.PharmaSkinOnnx
      ? Promise.all(angles.map(function (angle) { return window.PharmaSkinOnnx.detect(roiByAngle[angle].t_zone, modelUrl, modelHash); }))
      : Promise.resolve(angles.map(function () { return []; }));

    detectionsPromise.catch(function () { return angles.map(function () { return []; }); }).then(function (sets) {
      var detectionCount = sets.reduce(function (count, items) { return count + (items || []).length; }, 0);
      var counts = { acne: 0, pigmentation: 0, pores: 0 };
      angles.forEach(function (angle, index) {
        var source = images[angle]; var roi = roiByAngle[angle].t_zone;
        var onnxBoxes = sets[index] || [];
        if (onnxBoxes.length > 0) {
          detectionsByAngle[angle] = onnxBoxes.map(function (box) {
            var types = { 0: 'acne', 1: 'acne', 2: 'pigmentation', 3: 'pores', 4: 'wrinkles', 5: 'redness' };
            var type = types[box.classId];
            if (type === 'acne') counts.acne++; else if (type === 'pigmentation') counts.pigmentation++; else if (type === 'pores') counts.pores++;
            return Object.assign({}, box, { type: type || 'unknown', x: source.width * .30 + box.x * (source.width * .40 / roi.width), y: source.height * .12 + box.y * (source.height * .48 / roi.height), width: box.width * (source.width * .40 / roi.width), height: box.height * (source.height * .48 / roi.height) });
          });
        } else if (window.PharmaSkinCV && window.PharmaSkinCV.detectFeatures) {
          // Fallback Canvas CV Detection: Tự động trích xuất các đốm mụn và vùng đỏ trực tiếp trên ảnh
          var cvBoxes = window.PharmaSkinCV.detectFeatures(source, roiByAngle[angle], angle);
          detectionsByAngle[angle] = cvBoxes;
          cvBoxes.forEach(function (box) {
            if (box.type === 'acne') counts.acne++;
            else if (box.type === 'pigmentation') counts.pigmentation++;
            else if (box.type === 'pores') counts.pores++;
          });
          detectionCount += cvBoxes.length;
        } else {
          detectionsByAngle[angle] = [];
        }
      });
      angles.forEach(function (angle) {
        previewImages[angle] = window.PharmaSkinDeid.deidentify(images[angle], scan.dataset.skinDeidEnabled !== 'false', landmarksByAngle[angle]);
      });
      renderPreviews();
      if (methodNotice) methodNotice.textContent = modelUrl && detectionCount ? (copy.analysisMethodOnnx || 'Báo cáo có sử dụng model ONNX được cấu hình cho cửa hàng. Kết quả vẫn chỉ mang tính tham khảo.') : (copy.analysisMethodCanvas || 'Đây là phép đo ảnh thử nghiệm trên thiết bị, không phải kết quả từ mô hình AI đã thẩm định. Các điểm số và gợi ý chỉ mang tính tham khảo.');
      
      var melaninFactor = tone.available ? tone.melanin_factor : 1;
      var erythemaFactor = tone.available ? tone.erythema_factor : 1;
      var raw = {
        acne: detectionCount ? Math.min(1, counts.acne / 12) : surface.acne_ratio * 7,
        pigmentation: detectionCount ? Math.min(1, counts.pigmentation / 10) : surface.pigment_ratio * 5 / melaninFactor,
        wrinkles: wrinkle.density,
        redness: redness.ratio * 4 / erythemaFactor,
        pores: detectionCount ? Math.min(1, counts.pores / 20) : surface.texture_ratio
      };
      var report = window.PharmaSkinScoring.make(raw);
      var routine = window.PharmaSkinRoutine.match(report.scores);
      var payload = { scores: report.scores, skin_age: report.skin_age, monk_skin_tone: tone.available ? tone.monk_skin_tone : null, primary_concern: routine.primary_concern, regimen: routine.stages, recommended_products: routine.products, tech_neck: wrinkle.tech_neck_detected, source: 'ai_skin_scan_camera', inference: detectionCount ? 'onnx_local' : 'canvas_local' };
      try { sessionStorage.setItem('pc_skin_scan_result', JSON.stringify(payload)); } catch (error) {}

      // Hoàn tất quét sau thời gian deliberate
      setTimeout(function () {
        if (scanningOverlay) scanningOverlay.hidden = true;
        isAnalyzing = false;
        renderInlineDashboard(report, routine, tone, wrinkle, surface, redness);
        inlineReport.hidden = false;
        message(copy.analysisComplete || 'Phân tích hoàn tất. Báo cáo soi da đã hiển thị trực tiếp bên dưới.');
        inlineReport.scrollIntoView({ behavior: 'smooth', block: 'start' });
        update();
      }, 1800);
    });
  }

  analyze.addEventListener('click', function () {
    if (!modeAvailable) {
      message(copy.modeUnavailable || 'Chế độ xử lý qua máy chủ chưa được tích hợp hoặc phê duyệt.');
      return;
    }
    analyzeLocal();
  });

  window.addEventListener('pagehide', releaseImageBuffers);

  if (!modeAvailable) {
    var unavailableMessage = copy.modeUnavailable || 'Chế độ xử lý qua máy chủ chưa được tích hợp hoặc phê duyệt. Ảnh chưa được xử lý; bạn có thể chuyển sang khảo sát câu hỏi.';
    if (modeUnavailable) { modeUnavailable.textContent = unavailableMessage; modeUnavailable.hidden = false; }
    status.textContent = unavailableMessage;
    start.disabled = true;
    capture.disabled = true;
    switcher.disabled = true;
    uploadToggle.disabled = true;
    scan.querySelectorAll('[data-skin-upload-angle]').forEach(function (input) { input.disabled = true; });
    analyze.disabled = true;
  }

  selectMode(window.location.pathname === '/soi-da' ? 'camera' : 'quiz');
  update();
})(window, document);
