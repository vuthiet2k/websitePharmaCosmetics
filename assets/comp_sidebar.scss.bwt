.aside-item{
	margin-right:0px;
	position:relative;
	float: left;
	width: 100%;
	&:last-child {
		margin-right:0px;
	}
	.aside-title{
		position: relative;
		border-radius:0px;
		padding: 0 0;

		h2 {
			width: 100%;
			font-size: var(--fs-base) !important;
			margin: 0;
			text-transform: none;
			font-weight: 700;
			display: inline-block;
			padding: 0px;
			position: relative;
			text-transform: uppercase;
		}
	}
	.aside-content {
		padding: 0px 0px 0;
		border-top:none;
		border-radius: 0px;
		ul {
			padding-left:0px;
		}
	}
	.aside-content {
		width:100%;
		z-index:99;
		position:relative;
	}
	&.active {
		.aside-content {
			display:block;
		}
	}
}
.aside-item{
	@media (max-width:1199px) {
		width:220px;
	}
	
	.nav>li>a:focus{
		background: none;
	}
}
.aside-item{

	.list-tags{
		span.tag-item {
			line-height: 30px;
			border: 1px solid #ebebeb;
			height: 30px;
			display: inline-block;
			padding: 0 10px;
			margin-bottom: 20px;
			margin-right: 5px;
			color: #898989;
			border-radius: 0px;
			&:hover{
				color: #fff;
				a{
					color: #fff;
				}
				background: var(--subColor);
				border-color: var(--subColor);
			}
		}
	}
}
.title_filter {
	font-size: var(--fs-xl);
	font-weight:600;
	display:block;
	margin-bottom:40px;
	line-height: 34px;
	@media (max-width: 991px) {
		margin-bottom:10px;
	}
}
.aside-filter{
	background: transparent;
	margin-bottom: 20px;
	.aside-item {
		margin-bottom: 20px;
		.field-search{
			margin-bottom: 10px;
			position: relative;
		}
		&:last-child{
			margin-bottom: 0;
			border: none;
			.aside-content{
				margin-bottom: 0;
			}
		}
		.form-group .form-control{
			min-height: 40px;
			height: 40px;
		}
		.input-group-btn{
			position: static;
		}
		.input-group-btn button{
			position:absolute;
			right: 0;
			top: 0;
			height: 40px;
			width: 40px;
			padding: 0;
			text-align: center;
			line-height: 40px;
			background: var(--mainColor);
			color: #fff;
			border-bottom-right-radius: 3px;
			border-top-right-radius: 3px
		}
	}
	.filter-container {
		margin-bottom: 0px; 
	}
	.aside-item .aside-title:after{
		display: none;
	}

}
.ui-widget.ui-widget-content{
	height: 4px;
	background: #ebebeb;
}
.ui-slider-range.ui-corner-all.ui-widget-header {
	background: var(--subColor)!important;
}
.ui-slider-horizontal .ui-slider-handle {
	height: 18px!important;
	width: 18px!important;
	border-radius: 50%!important;
	top: -7px!important;
	border: none!important;
	background: var(--subColor)!important;
	border:solid 2px #ebebeb!important;
}
.ui-widget.ui-widget-content {
	border: none!important;
	margin-bottom: 10px;
	width: calc(100% - 14px);
	margin-left: 7px;
}
#start{
	width: 45%;
	float: left;
	margin-right:2.5%;
	input{
		font-size: var(--fs-sm);
		font-weight:400;
		text-align: left;
		border-radius: 3px;
		border: 0px solid #e1e1e1;
		box-shadow: none;
		background:transparent;
	}
}
#stop{
	width: 45%;
	float: right;
	margin-left: 2.5%;
	text-align: right;
	position: relative;
	input{
		font-size: var(--fs-sm);
		font-weight:400;
		text-align: right;
		border-radius: 3px;
		border: 0px solid #e1e1e1;
		box-shadow: none;
		background:transparent;
	}

}
a#filter-value {
	height: 30px;
	line-height: 30px;
	font-weight: 400;
	width: 100px;
	margin-top: 15px;
}