}

/* =============================================================================
   ORDER PAGES — /account/orders + /account/orders/{id}
   Refactor: thay table → card, thêm visual timeline 5-step, status badges,
   reorder button, empty state đẹp. Dùng tokens --dur-*, --ease-* từ :root H
   ============================================================================= */

/* ─── Order Status Badge (shared giữa orders + order detail) ─── */
.pc-order-status-badge {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	padding: 4px 12px;
	border-radius: 100px;
	font-family: var(--font-secondary);
	font-size: var(--fs-xs);
	font-weight: 600;
	letter-spacing: 0.02em;
	white-space: nowrap;
	line-height: 1.4;

	&::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}

	&--delivered  { background: #E6F7EE; color: #0F8B4C; }
	&--delivering { background: #FFF4E0; color: #C27A00; }
	&--processing { background: #E8F1FF; color: #1565C0; }
	&--paid       { background: #E6F7EE; color: #0F8B4C; }
	&--pending    { background: #FFF4E0; color: #C27A00; }
	&--returned   { background: #F0E8FF; color: #6E3FBF; }
	&--cancelled  { background: #FCE9E9; color: #C0392B; }
}

/* ═══════════════════════════════════════════════════════════════
   ORDERS LIST PAGE — /account/orders
   ═══════════════════════════════════════════════════════════════ */
.page_orders .pc-orders-wrap {
	padding: 24px;
	@media (max-width: 767px) { padding: 16px; }
}

.pc-orders-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin-bottom: 24px;
	flex-wrap: wrap;

	.title-head { margin: 0 !important; }

	&__count {
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		color: var(--textSub);
		padding: 4px 12px;
		background: var(--bg-subtle, #F8F9FA);
		border-radius: 100px;
	}
}

.pc-orders-list {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.pc-order-card {
	display: block;
	background: #fff;
	border: 1px solid var(--lineColor, #DFE6E9);
	border-radius: 12px;
	padding: 20px;
	text-decoration: none;
	color: inherit;
	transition: border-color var(--dur-base, 300ms) var(--ease-out, ease),
	            box-shadow var(--dur-base, 300ms) var(--ease-out, ease),
	            transform var(--dur-base, 300ms) var(--ease-out, ease);

	&:hover {
		border-color: var(--mainColor);
		box-shadow: 0 8px 24px rgba(60, 179, 113, 0.12);
		transform: translateY(-2px);
		color: inherit;
		text-decoration: none;
	}

	&__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-bottom: 14px;
		margin-bottom: 14px;
		border-bottom: 1px dashed var(--lineColor);
		flex-wrap: wrap;
	}

	&__id-label {
		display: block;
		font-family: var(--font-secondary);
		font-size: var(--fs-xs);
		color: var(--textSub);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	&__id-value {
		display: block;
		font-family: var(--font-primary);
		font-size: var(--fs-md);
		font-weight: 700;
		color: var(--mainColorDark);
		margin-top: 2px;
	}

	&__body {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-bottom: 16px;
	}

	&__meta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		color: var(--textBody);

		svg { color: var(--textSub); flex-shrink: 0; }
	}

	&__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 12px;
		border-top: 1px dashed var(--lineColor);
		flex-wrap: wrap;
	}

	&__cta {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-primary);
		font-size: var(--fs-sm);
		font-weight: 600;
		color: var(--mainColorDark);
		transition: gap var(--dur-fast, 150ms) var(--ease-out, ease);
	}

	&:hover &__cta { gap: 8px; }

	&__reorder {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: transparent;
		border: 1px solid var(--lineColor);
		color: var(--textBody);
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		font-weight: 600;
		padding: 6px 14px;
		border-radius: 100px;
		cursor: pointer;
		transition: background var(--dur-fast, 150ms) var(--ease-out, ease),
		            color var(--dur-fast, 150ms) var(--ease-out, ease),
		            border-color var(--dur-fast, 150ms) var(--ease-out, ease);

		&:hover {
			background: var(--mainColorDark);
			border-color: var(--mainColorDark);
			color: #fff;
		}
	}

	@media (max-width: 480px) {
		padding: 16px;
		&__body { gap: 6px 16px; }
	}
}

/* ─── Empty State (chưa có đơn nào) ─── */
.pc-orders-empty {
	text-align: center;
	padding: 60px 24px;

	&__icon {
		display: block;
		margin: 0 auto 20px;
	}

	&__title {
		font-family: var(--font-primary);
		font-size: var(--fs-lg);
		font-weight: 700;
		color: var(--textBody);
		margin: 0 0 8px;
	}

	&__desc {
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		color: var(--textSub);
		max-width: 420px;
		margin: 0 auto 28px;
		line-height: 1.6;
	}

	&__actions {
		display: flex;
		gap: 12px;
		justify-content: center;
		flex-wrap: wrap;

		.pc-btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 10px 22px;
			border-radius: 100px;
			font-family: var(--font-primary);
			font-size: var(--fs-sm);
			font-weight: 600;
			text-decoration: none;
			transition: background var(--dur-fast, 150ms) var(--ease-out, ease),
			            transform var(--dur-fast, 150ms) var(--ease-out, ease);
		}
		.pc-btn-primary {
			background: var(--mainColorDark);
			color: #fff;
			&:hover { background: var(--mainColor); transform: translateY(-2px); }
		}
		.pc-btn-secondary {
			background: transparent;
			color: var(--mainColorDark);
			border: 1.5px solid var(--mainColorDark);
			&:hover { background: var(--mainColorDark); color: #fff; }
		}
	}

	@media (max-width: 480px) {
		padding: 40px 16px;
		&__actions .pc-btn { width: 100%; justify-content: center; }
	}
}

/* ═══════════════════════════════════════════════════════════════
   ORDER DETAIL PAGE — /account/orders/{id}
   ═══════════════════════════════════════════════════════════════ */
.pc-order-detail {
	.bg-shadow {
		padding: 24px;
		@media (max-width: 767px) { padding: 16px; }
	}

	&__back {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		color: var(--textSub);
		text-decoration: none;
		margin-bottom: 16px;
		transition: color var(--dur-fast, 150ms) var(--ease-out, ease),
		            gap var(--dur-fast, 150ms) var(--ease-out, ease);

		&:hover {
			color: var(--mainColorDark);
			gap: 8px;
		}
	}

	&__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 28px;
		flex-wrap: wrap;

		.title-head {
			margin: 0 0 4px !important;
			font-size: var(--fs-xl);
			color: var(--mainColorDark);
		}

		.note { font-size: var(--fs-sm); color: var(--textSub); }
	}

	&__info {
		margin-top: 24px;

		.box-address {
			padding: 16px;
			background: var(--bg-subtle, #F8F9FA);
			border-radius: 8px;
			height: 100%;

			.title-head {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: var(--fs-sm);
				font-weight: 700;
				color: var(--textBody);
				text-transform: uppercase;
				letter-spacing: 0.04em;
				margin: 0 0 10px !important;

				svg { color: var(--mainColorDark); }
			}

			.box-des {
				font-family: var(--font-secondary);
				font-size: var(--fs-sm);
				color: var(--textBody);

				p { margin: 0 0 4px; line-height: 1.5; }
			}
		}
	}

	&__actions {
		display: flex;
		gap: 12px;
		margin-top: 24px;
		flex-wrap: wrap;

		.pc-btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 10px 22px;
			border-radius: 100px;
			font-family: var(--font-primary);
			font-size: var(--fs-sm);
			font-weight: 600;
			border: none;
			cursor: pointer;
			text-decoration: none;
			transition: background var(--dur-fast, 150ms) var(--ease-out, ease),
			            transform var(--dur-fast, 150ms) var(--ease-out, ease);
		}
		.pc-btn-primary {
			background: var(--mainColorDark);
			color: #fff;
			&:hover { background: var(--mainColor); transform: translateY(-2px); }
			&:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
		}
		.pc-btn-secondary {
			background: transparent;
			color: var(--mainColorDark);
			border: 1.5px solid var(--mainColorDark);
			&:hover { background: var(--mainColorDark); color: #fff; }
		}

		@media (max-width: 480px) {
			.pc-btn { flex: 1; justify-content: center; }
		}
	}
}

/* ─── Timeline 5-step ─── */
.pc-order-timeline {
	position: relative;
	margin: 8px 0 24px;
	padding: 24px 20px 16px;
	background: var(--bg-subtle, #F8F9FA);
	border-radius: 12px;

	&__track {
		position: absolute;
		top: 38px;
		left: 40px;
		right: 40px;
		height: 4px;
		background: var(--lineColor);
		border-radius: 2px;
		z-index: 0;
	}

	&__fill {
		height: 100%;
		background: var(--mainColorDark);
		border-radius: 2px;
		transition: width var(--dur-slow, 500ms) var(--ease-out, ease);
	}

	&__steps {
		position: relative;
		z-index: 1;
		list-style: none;
		display: flex;
		justify-content: space-between;
		padding: 0;
		margin: 0;
	}

	&__step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		flex: 1;
		min-width: 0;
	}

	&__dot {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #fff;
		border: 2px solid var(--lineColor);
		color: var(--textSub);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-primary);
		font-size: var(--fs-sm);
		font-weight: 700;
		transition: background var(--dur-base, 300ms) var(--ease-out, ease),
		            border-color var(--dur-base, 300ms) var(--ease-out, ease),
		            color var(--dur-base, 300ms) var(--ease-out, ease),
		            transform var(--dur-base, 300ms) var(--ease-bounce, ease);
	}

	&__label {
		font-family: var(--font-secondary);
		font-size: var(--fs-xs);
		color: var(--textSub);
		text-align: center;
		font-weight: 600;
		line-height: 1.3;
	}

	&__step.is-done &__dot {
		background: var(--mainColorDark);
		border-color: var(--mainColorDark);
		color: #fff;
	}

	&__step.is-done &__label {
		color: var(--textBody);
	}

	&__step.is-current &__dot {
		transform: scale(1.15);
		box-shadow: 0 0 0 4px rgba(60, 179, 113, 0.2);
	}

	&__step.is-current &__label {
		color: var(--mainColorDark);
		font-weight: 700;
	}

	/* Cancelled state */
	&--cancelled {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		background: #FCE9E9;
		color: #C0392B;
		padding: 16px 20px;

		svg { flex-shrink: 0; margin-top: 2px; }

		strong {
			font-family: var(--font-primary);
			font-size: var(--fs-base);
			color: #C0392B;
		}

		.note { color: #8E2820; }
	}

	/* Returning / returned state */
	&--returning {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		background: #F0E8FF;
		color: #6E3FBF;
		padding: 16px 20px;

		svg { flex-shrink: 0; margin-top: 2px; }

		strong {
			font-family: var(--font-primary);
			font-size: var(--fs-base);
			color: #6E3FBF;
		}
	}

	@media (max-width: 600px) {
		padding: 20px 12px 12px;

		&__track { left: 32px; right: 32px; top: 34px; }
		&__dot { width: 28px; height: 28px; font-size: var(--fs-xs); }
		&__label { font-size: var(--fs-xs);  /* TODO confirm — rounded from 10px */ }
	}
}

/* ─── ETA banner ─── */
.pc-order-eta {
	display: flex;
	align-items: center;
	gap: 10px;
	padding: 12px 16px;
	background: var(--mainColorLight, #eaf7ee);
	border-left: 3px solid var(--mainColorDark);
	border-radius: 6px;
	margin-bottom: 24px;
	font-family: var(--font-secondary);
	font-size: var(--fs-sm);
	color: var(--textBody);

	svg { color: var(--mainColorDark); flex-shrink: 0; }
	strong { color: var(--mainColorDark); }
}

/* =============================================================================
   ACCOUNT PAGE V2 — /account = TRUNG TÂM KHÁCH HÀNG
   Feed 1 cột, full-width tới 1200px, các section phẳng ngăn bằng border-bottom
   (ecommerce list-feel, KHÔNG card/shadow kiểu SaaS dashboard). Namespace pc-hub-*.
   ============================================================================= */
.page_account.pc-hub {
	padding: 0 0px 30px;
	background: #fff;
}
/* .pc-hub__feed removed — dùng .container chuẩn */

/* Các section phẳng: ngăn nhau bằng đường kẻ, không card island */
.pc-hub__id,
.pc-hub-block,
.pc-hub-link {
	padding: 20px 0;
	border-bottom: 1px solid var(--lineColor, #DFE6E9);
}
.pc-hub .container > *:last-child { border-bottom: none; }
@media (max-width: 767px) {
	.pc-hub__id, .pc-hub-block, .pc-hub-link { padding: 16px 0; }
}

.pc-hub__flash {
	background: var(--mainColorLight, #eaf7ee);
	color: var(--mainColorDark, #267348);
	font-size: var(--fs-sm);
	padding: 12px 16px;
	border-radius: 8px;
	margin-top: 16px;
}

/* ─── 1. Identity (Tôi là ai?) — cao ~80-120px ─── */
.pc-hub__hello { font-size: var(--fs-sm); color: var(--textSub, #636E72); margin: 0; }
.pc-hub__name {
	font-family: var(--font-primary);
	font-size: var(--fs-xl);
	font-weight: 700;
	color: var(--textBody, #2D3436);
	margin: 4px 0;
	display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.pc-hub__vip {
	font-size: var(--fs-xs);
	font-weight: 700;
	color: #775F2D;
	background: #FCDC9D;
	padding: 3px 10px;
	border-radius: 99px;
	letter-spacing: .3px;
}
.pc-hub__meta { font-size: var(--fs-sm); color: var(--textSub, #636E72); margin: 0; }
.pc-hub__meta-sep { opacity: .5; }

/* ─── 2. Active order — NGOẠI LỆ giữ highlight nhẹ (CTA chính), nhưng phẳng (no shadow) ─── */
.pc-hub-track {
	display: flex; align-items: center; gap: 14px;
	text-decoration: none; color: inherit;
	margin: 16px 0;
	padding: 14px 16px;
	border-radius: 10px;
	border-left: 3px solid var(--mainColor, #3cb371);
	background: linear-gradient(135deg, var(--mainColorLight, #eaf7ee) 0%, #fff 70%);
	transition: box-shadow var(--dur-base, .3s) var(--ease-out, ease);
}
.pc-hub-track:hover { box-shadow: 0 4px 14px rgba(60,179,113,.15); }
.pc-hub-track__icon {
	width: 44px; height: 44px; flex-shrink: 0;
	display: flex; align-items: center; justify-content: center;
	background: var(--mainColor, #3cb371); color: #fff; border-radius: 10px;
}
.pc-hub-track__body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
.pc-hub-track__label { font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-base); color: var(--textBody, #2D3436); }
.pc-hub-track__sub { font-size: var(--fs-sm); color: var(--textSub, #636E72); }
.pc-hub-track__cta {
	display: inline-flex; align-items: center; gap: 2px;
	font-weight: 600; font-size: var(--fs-sm); color: var(--mainColorDark, #267348);
	white-space: nowrap; flex-shrink: 0;
}
/* Dòng "+N đơn khác đang xử lý" khi vượt active_limit */
.pc-hub-track-more {
	display: flex; align-items: center; justify-content: space-between; gap: 8px;
	margin: -4px 0 16px; padding: 10px 16px;
	font-size: var(--fs-sm); font-weight: 600; color: var(--textSub, #636E72);
	text-decoration: none; border: 1px dashed var(--lineColor, #DFE6E9); border-radius: 8px;
	transition: border-color var(--dur-fast,.15s) var(--ease-out,ease), color var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-track-more:hover { border-color: var(--mainColor, #3cb371); color: var(--mainColorDark, #267348); }
.pc-hub-track-more__cta { display: inline-flex; align-items: center; gap: 2px; color: var(--mainColorDark, #267348); white-space: nowrap; }

/* ─── Block head ─── */
.pc-hub-block__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.pc-hub-block__title { font-family: var(--font-primary); font-size: var(--fs-md); font-weight: 700; color: var(--textBody, #2D3436); margin: 0; }
.pc-hub-block__action {
	display: inline-flex; align-items: center; gap: 2px;
	font-size: var(--fs-sm); font-weight: 600; color: var(--mainColorDark, #267348);
	text-decoration: none; white-space: nowrap;
	transition: color var(--dur-fast, .15s) var(--ease-out, ease);
}
.pc-hub-block__action:hover { color: var(--mainColor, #3cb371); }
.pc-hub-block__hint { font-size: var(--fs-sm); color: var(--textSub, #636E72); margin: -8px 0 16px; line-height: 1.6; }
.pc-hub-block__hint a { color: var(--mainColorDark, #267348); font-weight: 600; text-decoration: none; }
.pc-hub-block__hint a:hover { text-decoration: underline; }

/* ─── 3. Đơn hàng — icon-list (Shopee-style), không phải thống kê ─── */
.pc-hub-orderstat { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.pc-hub-orderstat__item {
	display: flex; flex-direction: column; align-items: center; gap: 8px;
	padding: 12px 4px; border-radius: 8px;
	text-decoration: none; transition: background var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-orderstat__item:hover { background: var(--bg-subtle, #F8F9FA); }
.pc-hub-orderstat__icon { position: relative; display: flex; color: var(--mainColorDark, #267348); }
.pc-hub-orderstat__badge {
	position: absolute; top: -6px; right: -10px;
	min-width: 18px; height: 18px; padding: 0 5px;
	display: flex; align-items: center; justify-content: center;
	background: var(--accentColor, #E35D5D); color: #fff;
	font-size: var(--fs-xs); font-weight: 700; line-height: 1;
	border-radius: 9px;
}
.pc-hub-orderstat__label { font-size: var(--fs-sm); color: var(--textBody, #2D3436); text-align: center; }

/* ─── Empty state ─── */
.pc-hub-empty { text-align: center; padding: 16px 0; }
.pc-hub-empty p { font-size: var(--fs-sm); color: var(--textSub, #636E72); margin: 0 0 12px; }
.pc-hub-empty__cta {
	display: inline-block; padding: 10px 24px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	color: #fff; background: var(--mainColor, #3cb371); border-radius: 8px; text-decoration: none;
}
.pc-hub-empty__cta:hover { background: var(--mainColorDark, #267348); }

/* ─── 4. Address ─── */
.pc-hub-addr__name { font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-base); color: var(--textBody, #2D3436); display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.pc-hub-addr__badge { font-size: var(--fs-xs); font-weight: 600; color: var(--mainColorDark, #267348); background: var(--mainColorLight, #eaf7ee); padding: 2px 8px; border-radius: 4px; }
.pc-hub-addr__line { font-size: var(--fs-sm); color: var(--textBody, #2D3436); line-height: 1.6; margin: 0 0 4px; }
.pc-hub-addr__phone { font-size: var(--fs-sm); color: var(--textSub, #636E72); margin: 0; }

/* ─── 5. Wishlist link (row phẳng) ─── */
.pc-hub-link { display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit; }
.pc-hub-link:hover .pc-hub-link__label { color: var(--mainColorDark, #267348); }
.pc-hub-link:hover .pc-hub-link__chev { transform: translateX(3px); }
.pc-hub-link__icon { width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--mainColorLight, #eaf7ee); color: var(--mainColorDark, #267348); border-radius: 10px; }
.pc-hub-link__label { flex: 1; font-family: var(--font-primary); font-weight: 600; font-size: var(--fs-base); color: var(--textBody, #2D3436); transition: color var(--dur-fast,.15s) var(--ease-out,ease); }
.pc-hub-link__count { color: var(--textSub, #636E72); font-weight: 400; }
.pc-hub-link__chev { color: var(--textSub, #636E72); flex-shrink: 0; transition: transform var(--dur-fast,.15s) var(--ease-out,ease); }

/* ─── 6. Reorder (tiện ích bổ sung) — product tiles giữ viền nhẹ (đúng UX ecommerce) ─── */
.pc-hub-reorder { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.pc-hub-reorder__card {
	display: flex; flex-direction: column; gap: 8px;
	border: 1px solid var(--lineColor, #DFE6E9);
	border-radius: 10px;
	padding: 10px;
	transition: border-color var(--dur-fast,.15s) var(--ease-out,ease), box-shadow var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-reorder__card:hover { border-color: var(--mainColor, #3cb371); box-shadow: 0 4px 12px rgba(0,0,0,.06); }
.pc-hub-reorder__thumb { display: block; border-radius: 8px; overflow: hidden; background: #f5f5f5; aspect-ratio: 1; }
.pc-hub-reorder__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pc-hub-reorder__name {
	font-size: var(--fs-sm); font-weight: 500; color: var(--textBody, #2D3436);
	text-decoration: none; line-height: 1.4; min-height: 2.8em;
}
.pc-hub-reorder__name:hover { color: var(--mainColorDark, #267348); }
.pc-hub-reorder__price { font-family: var(--font-primary); font-weight: 700; font-size: var(--fs-base); color: var(--price-color, var(--mainColorDark, #267348)); }
.pc-hub-reorder__btn {
	display: inline-flex; align-items: center; justify-content: center; gap: 6px;
	width: 100%;
	padding: 8px 10px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	color: #fff; background: var(--mainColor, #3cb371);
	border: none; border-radius: 8px; cursor: pointer;
	transition: background var(--dur-fast,.15s) var(--ease-out,ease), transform var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-reorder__btn:hover { background: var(--mainColorDark, #267348); }
.pc-hub-reorder__btn:active { transform: scale(.98); }
.pc-hub-reorder__btn.is-loading { opacity: .7; cursor: default; }
.pc-hub-reorder__btn.is-done { background: var(--mainColorDark, #267348); cursor: default; }
/* Nút "Xem thêm" — chỉ hiện trên mobile (desktop hiện đủ 8) */
.pc-hub-reorder__more {
	display: none;
	width: 100%; margin-top: 12px; padding: 10px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	color: var(--mainColorDark, #267348); background: none;
	border: 1px solid var(--lineColor, #DFE6E9); border-radius: 8px; cursor: pointer;
	transition: background var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-reorder__more:hover { background: var(--bg-subtle, #F8F9FA); }

/* ─── 7. Profile (cuối) ─── */
.pc-hub-profile__rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.pc-hub-profile__row { display: flex; gap: 12px; font-size: var(--fs-sm); }
.pc-hub-profile__k { width: 96px; flex-shrink: 0; color: var(--textSub, #636E72); }
.pc-hub-profile__v { color: var(--textBody, #2D3436); font-weight: 500; }
.pc-hub-profile__actions { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--lineColor, #DFE6E9); padding-top: 16px; }
.pc-hub-profile__link { display: block; font-size: var(--fs-sm); font-weight: 600; color: var(--mainColorDark, #267348); text-decoration: none; padding: 6px 0; }
.pc-hub-profile__link:hover { text-decoration: underline; }
.pc-hub-profile__link--danger { color: #C0392B; }

/* ─── Responsive ─── */
@media (max-width: 767px) {
	.pc-hub-reorder { grid-template-columns: repeat(2, 1fr); gap: 10px; }
	.pc-hub-reorder__card--extra { display: none; }
	.pc-hub-reorder.is-expanded .pc-hub-reorder__card--extra { display: flex; }
	.pc-hub-reorder__more { display: inline-flex; align-items: center; justify-content: center; }
	.pc-hub-track { flex-wrap: wrap; }
	.pc-hub-track__cta { width: 100%; justify-content: flex-end; }
}

/* =============================================================================
   SUB-PAGES V2 (orders / order / addresses) — dùng .container chuẩn
   ============================================================================= */

/* Back link "← Tài khoản" (orders/addresses; order.bwt dùng .pc-order-detail__back) */
.pc-hub-back {
	display: inline-flex; align-items: center; gap: 4px;
	font-size: var(--fs-sm); font-weight: 600; color: var(--textSub, #636E72);
	text-decoration: none;
	transition: color var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-back:hover { color: var(--mainColorDark, #267348); }

/* orders / order: bỏ phụ thuộc .bg-shadow, ngồi phẳng trong feed */
.pc-hub .pc-orders-wrap,
.pc-hub.pc-order-detail { padding: 0; background: none; box-shadow: none; }

/* ─── Addresses page V2 ─── */
.pc-acc-addr-wrap__head {
	display: flex; align-items: center; justify-content: space-between;
	gap: 12px; flex-wrap: wrap; margin: 8px 0 20px;
}
.pc-acc-addr-add {
	display: inline-flex; align-items: center; gap: 6px;
	padding: 10px 18px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	color: #fff; background: var(--mainColor, #3cb371);
	border: none; border-radius: 8px; cursor: pointer;
	transition: background var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-acc-addr-add:hover { background: var(--mainColorDark, #267348); }

/* Mỗi địa chỉ = thẻ phẳng (giữ markup .customer_address / .address_info để JS chạy) */
.pc-hub .total_address { display: flex; flex-direction: column; gap: 12px; margin: 0; }
.pc-hub .customer_address { width: 100%; padding: 0; }
.pc-hub .customer_address .address_info {
	display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
	border: 1px solid var(--lineColor, #DFE6E9) !important;
	border-radius: 12px;
	padding: 16px 18px !important;
	margin: 0 !important;
}
.pc-hub .customer_address .address-group { flex: 1; min-width: 0; }
.pc-hub .customer_address .address p { font-size: var(--fs-sm); color: var(--textBody, #2D3436); line-height: 1.6; margin: 0 0 4px; }
.pc-hub .customer_address .address-default {
	display: inline-flex; align-items: center; gap: 4px; margin-left: 8px;
	font-size: var(--fs-xs); font-weight: 600; color: var(--mainColorDark, #267348);
}
.pc-hub .customer_address .btn-address .btn-row { display: flex; gap: 8px; margin: 0; }

@media (max-width: 767px) {
	.pc-acc-addr-wrap__head { margin-bottom: 16px; }
	.pc-hub .customer_address .address_info { flex-direction: column; }
}

/* ─── Đổi mật khẩu (change_password) V2 ─── */
.pc-acc-pass {
	max-width: 520px;
	margin: 8px 0 0;
	border: 1px solid var(--lineColor, #DFE6E9);
	border-radius: 12px;
	padding: 24px;
}
.pc-acc-pass__head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.pc-acc-pass__icon {
	width: 36px; height: 36px; flex-shrink: 0;
	display: flex; align-items: center; justify-content: center;
	background: var(--mainColorLight, #eaf7ee); color: var(--mainColorDark, #267348);
	border-radius: 10px;
}
.pc-acc-pass__head .pc-hub-block__title { margin: 0; }
.pc-acc-pass__hint { font-size: var(--fs-sm); color: var(--textSub, #636E72); line-height: 1.6; margin: 0 0 16px; }
.pc-acc-pass__msg {
	display: flex; align-items: center; gap: 6px;
	font-size: var(--fs-sm); font-weight: 600;
	padding: 10px 14px; border-radius: 8px; margin: 0 0 16px;
}
.pc-acc-pass__msg--ok    { color: var(--mainColorDark, #267348); background: var(--mainColorLight, #eaf7ee); }
.pc-acc-pass__msg--error { color: #C0392B; background: #FDEDEC; }

.pc-acc-pass__form { display: flex; flex-direction: column; gap: 16px; }
.pc-acc-field { display: flex; flex-direction: column; gap: 6px; border: 0; padding: 0; margin: 0; }
.pc-acc-field label { font-size: var(--fs-sm); font-weight: 600; color: var(--textBody, #2D3436); }
.pc-acc-field label .error { color: #C0392B; }
.pc-acc-field .form-control {
	width: 100%; height: 44px; padding: 0 14px;
	font-size: var(--fs-base); color: var(--textBody, #2D3436);
	background: #fff; border: 1px solid var(--lineColor, #DFE6E9); border-radius: 8px;
	transition: border-color var(--dur-fast,.15s) var(--ease-out,ease), box-shadow var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-acc-field .form-control:focus {
	outline: none; border-color: var(--mainColor, #3cb371);
	box-shadow: 0 0 0 3px rgba(60,179,113,.15);
}
.pc-acc-pass__btn {
	align-self: flex-start; margin-top: 4px;
	padding: 11px 28px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	color: #fff; background: var(--mainColor, #3cb371);
	border: none; border-radius: 8px; cursor: pointer;
	transition: background var(--dur-fast,.15s) var(--ease-out,ease), transform var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-acc-pass__btn:hover { background: var(--mainColorDark, #267348); }
.pc-acc-pass__btn:active { transform: scale(.98); }

@media (max-width: 480px) {
	.pc-acc-pass { padding: 18px; }
	.pc-acc-pass__btn { width: 100%; text-align: center; }
}

/* =============================================================================
   ACCOUNT V2.1 — lưới 4 trạng thái · nhóm nav Tài khoản · welcome (empty-state)
   ============================================================================= */

/* Lưới đơn hàng 4 ô (mobile 2×2) */
.pc-hub-orderstat--4 { grid-template-columns: repeat(4, 1fr); }
.pc-hub-orderstat__badge--neg { background: var(--textSub, #636E72); }
@media (max-width: 480px) {
	.pc-hub-orderstat--4 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}

/* Nhóm "Tài khoản" — các dòng link list (tái dùng .pc-hub-link) */
.pc-hub-nav .pc-hub-link { padding: 14px 0; }
.pc-hub-nav .pc-hub-link:first-child { padding-top: 4px; }
.pc-hub-nav .pc-hub-link:last-child { border-bottom: none; padding-bottom: 0; }
.pc-hub-link--danger .pc-hub-link__icon { background: #FDEDEC; color: #C0392B; }
.pc-hub-link--danger:hover .pc-hub-link__label { color: #C0392B; }

/* Welcome block (trạng thái A — khách chưa có đơn) */
.pc-hub-welcome {
	text-align: center;
	padding: 40px 24px;
	background: var(--bg-subtle, #F8F9FA);
	border: 1px solid var(--lineColor, #DFE6E9);
	border-radius: 12px;
	margin: 8px 0;
}
.pc-hub-welcome__icon { display: block; margin: 0 auto 16px; }
.pc-hub-welcome__title { font-family: var(--font-primary); font-size: var(--fs-lg); font-weight: 700; color: var(--textBody, #2D3436); margin: 0 0 8px; }
.pc-hub-welcome__desc { font-size: var(--fs-sm); color: var(--textSub, #636E72); line-height: 1.6; max-width: 440px; margin: 0 auto 20px; }
.pc-hub-welcome__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.pc-hub-welcome__btn {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 11px 24px;
	font-family: var(--font-primary); font-size: var(--fs-sm); font-weight: 600;
	border-radius: 8px; text-decoration: none;
	transition: background var(--dur-fast,.15s) var(--ease-out,ease), border-color var(--dur-fast,.15s) var(--ease-out,ease);
}
.pc-hub-welcome__btn--primary { background: var(--mainColor, #3cb371); color: #fff; }
.pc-hub-welcome__btn--primary:hover { background: var(--mainColorDark, #267348); }
.pc-hub-welcome__btn--ghost { background: #fff; color: var(--mainColorDark, #267348); border: 1px solid var(--lineColor, #DFE6E9); }
.pc-hub-welcome__btn--ghost:hover { border-color: var(--mainColor, #3cb371); }
@media (max-width: 480px) {
	.pc-hub-welcome { padding: 28px 16px; }
	.pc-hub-welcome__btn { width: 100%; }
}

/* ══════════════════════════════════════════════════════════════════════════
   2026-09-18: form card đăng nhập/đăng ký (templates/customers/login.bwt,
   register.bwt), render trong layout chung (layouts/theme.bwt). Trước đây có
   1 shell split-screen riêng (layouts/auth.bwt, .pc-auth-body/-topbar/-shell/
   -panel-xxx/-formzone, KHÔNG có header/footer) — đã xoá cùng layout đó, xem
   .clinerules/02-du-an-pharma-cosmetics.md mục 7. Bố cục 2 cột (.pc-auth-shell
   > .pc-auth-row > .pc-auth-form-col + .pc-auth-visual-col) quay lại SAU đó
   theo mockup thật design/auth/login.html + register.html + auth.css (thêm có
   chủ đích ở commit b6019d2) — khác layout auth.bwt bịa, vẫn nằm trong
   layouts/theme.bwt bình thường. Dùng var(--color-brand-*)/var(--font-display)
   từ pharma_ui_kit.bwt + header_style.bwt (T-70/71, real token, không hardcode
   hex mới trừ trắng/trong suốt thuần tuý). Tiền tố pc-auth-* (không trùng
   .btn-primary/.nav-link site-wide — xem cảnh báo đầu file pharma_ui_kit.bwt).
   ══════════════════════════════════════════════════════════════════════════ */
.pc-auth-shell {
	background: #fff;
	border-radius: 24px;
	box-shadow: 0 24px 60px -18px rgba(15,35,24,0.18), 0 0 0 1px rgba(15,35,24,0.05);
	padding: 24px;
	margin: 24px 0 40px;
}
.pc-auth-row { align-items: stretch; }
.pc-auth-form-col { padding: 20px; display: flex; flex-direction: column; justify-content: center; }
@media (max-width: 991px) {
	.pc-auth-shell { padding: 16px; border-radius: 18px; }
	.pc-auth-form-col { padding: 8px; }
	.pc-auth-visual-col { order: -1; margin-bottom: 20px; }
}

.pc-auth-visual {
	position: relative;
	width: 100%;
	height: 100%;
	min-height: 480px;
	border-radius: 18px;
	overflow: hidden;
	background: linear-gradient(160deg, var(--color-brand-dark, #166B55) 0%, var(--color-brand-deep, #0F2318) 100%);
	display: flex;
	align-items: flex-end;
}
@media (max-width: 991px) { .pc-auth-visual { min-height: 180px; max-height: 220px; } }
.pc-auth-visual__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.pc-auth-visual__overlay {
	position: relative;
	z-index: 1;
	width: 100%;
	padding: 32px 28px 26px;
	background: linear-gradient(180deg, transparent 0%, rgba(15,35,24,0.82) 55%, rgba(15,35,24,0.95) 100%);
	color: #fff;
}
.pc-auth-visual__headline {
	font-family: var(--font-display, 'Montserrat', sans-serif);
	font-size: 1.375rem;
	font-weight: 700;
	line-height: 1.3;
	margin: 0 0 8px;
}
.pc-auth-visual__tagline { font-size: 0.8125rem; color: rgba(255,255,255,0.78); line-height: 1.55; margin: 0; }

.pc-auth-card { width: 100%; max-width: 480px; }
.pc-auth-card__head { margin-bottom: 22px; }
.pc-auth-card__title {
	font-family: var(--font-display, 'Montserrat', sans-serif);
	font-size: 1.75rem;
	font-weight: 700;
	color: var(--color-text-main, #13241F);
	margin: 0 0 8px;
}
.pc-auth-card__sub { font-size: var(--fs-sm, 0.875rem); color: var(--color-text-muted, #64748B); margin: 0; }
.pc-auth-card__body { display: flex; flex-direction: column; gap: 16px; }

.pc-auth-field-row { display: flex; gap: 12px; }
.pc-auth-field-row .pc-auth-field { flex: 1 1 0; min-width: 0; }
@media (max-width: 380px) { .pc-auth-field-row { flex-direction: column; gap: 16px; } }

.pc-auth-field { display: flex; flex-direction: column; gap: 6px; }
.pc-auth-label { font-size: 0.8125rem; font-weight: 600; color: var(--color-text-body, #334155); }
.pc-auth-input {
	width: 100%;
	min-height: 46px;
	padding: 10px 14px;
	font-size: var(--fs-base, 1rem);
	border: 1px solid var(--color-border-clinical, #E2E8F0);
	border-radius: 10px;
	background: #fff;
	color: var(--color-text-main, #13241F);
	transition: border-color 150ms ease, box-shadow 150ms ease;
	box-sizing: border-box;
}
.pc-auth-input:focus {
	outline: none;
	border-color: var(--color-brand-primary, #3CB371);
	box-shadow: 0 0 0 3px rgba(60,179,113,0.16);
}
.pc-auth-password-wrap { position: relative; }
.pc-auth-password-wrap .pc-auth-input { padding-right: 44px; }
.pc-auth-password-toggle {
	position: absolute;
	right: 4px;
	top: 50%;
	transform: translateY(-50%);
	width: 38px;
	height: 38px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	background: transparent;
	border: none;
	color: var(--color-text-muted, #64748B);
	cursor: pointer;
	border-radius: 8px;
}
.pc-auth-password-toggle:hover { color: var(--color-brand-primary, #3CB371); background: var(--color-mint-subtle, #E8F8EE); }

.pc-auth-row-between { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
.pc-auth-link {
	font-size: 0.8125rem;
	font-weight: 600;
	color: var(--color-brand-dark, #166B55);
	text-decoration: none;
	cursor: pointer;
	min-height: 44px;
	display: inline-flex;
	align-items: center;
}
.pc-auth-link:hover { color: var(--color-brand-primary, #3CB371); text-decoration: underline; }
.pc-auth-back-to-login { background: none; border: none; padding: 0; text-align: left; }

.pc-auth-btn-primary {
	width: 100%;
	min-height: 48px;
	border: none;
	border-radius: 10px;
	background: var(--color-brand-primary, #3CB371);
	color: #fff;
	font-size: var(--fs-md, 1.125rem);
	font-weight: 700;
	cursor: pointer;
	transition: background 150ms ease, transform 100ms ease;
}
.pc-auth-btn-primary:hover { background: var(--color-brand-green, #267348); }
.pc-auth-btn-primary:active { transform: translateY(1px); }

.pc-auth-alert { border-radius: 10px; padding: 12px 14px; font-size: 0.8125rem; }
.pc-auth-alert p { margin: 0 0 4px; }
.pc-auth-alert p:last-child { margin-bottom: 0; }
.pc-auth-alert--error { background: #FDECEC; color: #B42318; border: 1px solid #F7C4C4; }
.pc-auth-alert--success { background: var(--color-mint-subtle, #E8F8EE); color: var(--color-brand-dark, #166B55); border: 1px solid var(--color-mint-light, #D7F3E3); margin-top: 16px; }

.pc-auth-recover { margin-top: 4px; }
.pc-auth-recover__hint { font-size: 0.8125rem; color: var(--color-text-muted, #64748B); margin: 0 0 4px; }

.pc-auth-checkbox {
	display: flex;
	align-items: flex-start;
	gap: 10px;
	font-size: 0.8125rem;
	color: var(--color-text-body, #334155);
	line-height: 1.5;
	cursor: pointer;
}
.pc-auth-checkbox input { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--color-brand-primary, #3CB371); }
.pc-auth-checkbox a { color: var(--color-brand-dark, #166B55); font-weight: 600; }

.pc-auth-social { margin-top: 20px; }
.pc-auth-social__divider { position: relative; text-align: center; margin: 0 0 16px; }
.pc-auth-social__divider::before {
	content: '';
	position: absolute;
	left: 0; right: 0; top: 50%;
	border-top: 1px solid var(--color-border-clinical, #E2E8F0);
}
.pc-auth-social__divider span {
	position: relative;
	background: var(--color-bg-page, #F8FAF7);
	padding: 0 12px;
	font-size: 0.75rem;
	color: var(--color-text-muted, #64748B);
}
.pc-auth-social__buttons { display: flex; flex-direction: column; gap: 10px; }
.pc-auth-social__buttons > * { width: 100%; min-height: 44px; }
