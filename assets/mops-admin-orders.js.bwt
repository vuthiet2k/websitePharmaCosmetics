{% comment %} mops-admin-orders.js.bwt — Mixin domain "Đơn hàng" (tab Orders + modal Tạo đơn thủ
  công + in hoá đơn + QR lightbox) cho MOPS Admin. Tách khỏi Assets/mops-admin.js.bwt (2026-07-16,
  theo mẫu mops-admin-audit.js.bwt). Script TOP-LEVEL — đẩy mixin vào window.MopsAdminMixins
  TRƯỚC khi Assets/mops-admin.js.bwt đọc mảng này. Gọi helper dùng chung qua window.MopsAdminCore.
  Load TRƯỚC Assets/mops-admin.js.bwt.
  Cross-domain (Vue mixins share chung 1 instance nên gọi qua this.* bình thường):
  - openManualOrderForm()/submitManualOrderQuickAdd() đọc/ghi this.products.all + gọi
    this.loadProducts() (domain Sản phẩm — chưa tách, vẫn ở core).
  - openManualOrderForm()/submitManualOrder() gọi this.loadCustomers()/this.customers.all
    (domain Khách hàng — mixin riêng) và this.ensureBranchesLoaded()/this.branches.*
    (domain Chi nhánh — mixin riêng).
  - viewCustomerFromOrder() gọi this.openCustomerDrawer() (domain Khách hàng).
  - ensureProvincesLoaded()/loadWardsForProvince()/onProvinceChange()/wardsFor()/preloadWardsFor()
    (helper Tỉnh/Xã dùng chung mọi form địa chỉ) và statusMeta() (badge trạng thái chung, cũng
    dùng ở tab Thông báo) — KHÔNG chuyển theo, vẫn ở core dù nằm sát các hàm Đơn hàng trong file gốc. {% endcomment %}
(function() {
  'use strict';

  // Chuyển số → chữ tiếng Việt cho hoá đơn. 2026-08-24 dùng bởi _buildOrderPrintHtml (unified print).
  function numberToVietnameseWords(amount) {
    var number = Math.round(Math.abs(Number(amount) || 0));
    var digits = ['không','một','hai','ba','bốn','năm','sáu','bảy','tám','chín'];
    var groupUnits = ['', ' nghìn', ' triệu', ' tỷ'];

    function readGroup(n) { // 0-999
      var hundred = Math.floor(n / 100), ten = Math.floor((n % 100) / 10), unit = n % 10;
      var s = '';
      if (hundred > 0) {
        s += digits[hundred] + ' trăm';
        if (ten === 0 && unit > 0) s += ' lẻ';
      }
      if (ten > 1) {
        s += (s ? ' ' : '') + digits[ten] + ' mươi';
        if (unit === 1) s += ' mốt'; else if (unit === 5) s += ' lăm'; else if (unit > 0) s += ' ' + digits[unit];
      } else if (ten === 1) {
        s += (s ? ' ' : '') + 'mười';
        if (unit === 1) s += ' một'; else if (unit === 5) s += ' lăm'; else if (unit > 0) s += ' ' + digits[unit];
      } else if (ten === 0 && unit > 0) {
        s += (s ? ' ' : '') + digits[unit];
      }
      return s;
    }

    if (number === 0) return 'Không đồng';

    var groups = [];
    while (number > 0) { groups.unshift(number % 1000); number = Math.floor(number / 1000); }

    var parts = [];
    for (var i = 0; i < groups.length; i++) {
      if (groups[i] === 0) continue;
      parts.push(readGroup(groups[i]) + groupUnits[groups.length - 1 - i]);
    }

    var result = parts.join(' ').replace(/\s+/g, ' ').trim() + ' đồng chẵn';
    return result.charAt(0).toUpperCase() + result.slice(1);
  }

  window.MopsAdminRegisteredDomains = window.MopsAdminRegisteredDomains || [];
  window.MopsAdminRegisteredDomains.push('orders');

  // Component registry dùng chung: asset domain chạy trước core, core sẽ đăng ký toàn bộ
  // component vào app trước app.mount(). QR lightbox là component đầu tiên được tách khỏi
  // in-DOM root template để cô lập lifecycle/modal state khỏi dashboard khổng lồ.
  window.MopsAdminComponents = window.MopsAdminComponents || {};
  window.MopsAdminComponents['mops-qr-lightbox'] = {
    props: {
      url: { type: String, default: '' }
    },
    emits: ['close'],
    methods: {
      close: function() { this.$emit('close'); },
      onKeydown: function(event) {
        if (event.key === 'Escape') this.close();
      }
    },
    mounted: function() {
      document.addEventListener('keydown', this.onKeydown);
    },
    beforeUnmount: function() {
      document.removeEventListener('keydown', this.onKeydown);
    },
    template: '<div v-if="url" @click="close" class="ma-qr-lightbox-overlay"><button @click.stop="close" type="button" class="ma-qr-lightbox-close" aria-label="Đóng"><span class="material-symbols-outlined">close</span></button><img :src="url" @click.stop class="ma-qr-lightbox-img" alt="QR chuyển khoản (phóng to)"></div>'
  };

  window.MopsAdminMixins = window.MopsAdminMixins || [];
  window.MopsAdminMixins.push({
    data: function() {
      return {
        orders: { status: '', fulfillment: '', paymentMethod: '', branchId: '', from: '', to: '', orderId: '', loading: false, error: '', list: [], fulfillmentCounts: {}, expandedId: null, detail: null, detailLoading: false, pulling: false, actionBusy: '', editLoading: false, exporting: false,
          // 2026-08-23 bulk print đơn hàng (Mục 3 plan OMS): checkbox multi-select + floating action bar.
          // selectedIds: mảng order_id đã tích. printPaperSize: A5 mặc định (staff đổi được A4/K80).
          // printing: đang gọi get_orders_batch → disable nút để tránh double-click. STRICT BOUNDARY:
          // list view CHỈ in đơn hàng (phiếu/hóa đơn), KHÔNG in tem vận đơn — cái đó ở tab_shipping.
          selectedIds: [], printPaperSize: 'A5', printing: false,
          // Modal "Bộ lọc đơn hàng" — gom 4 select + 2 date + preset chips + Xoá bộ lọc vào 1 chỗ,
          // trigger là icon-button (có badge count) bên cạnh nút Xuất file. Trước đây layout inline
          // toolbar chiếm nhiều chiều dọc + wrap loạn ở màn trung. Modal giải quyết cả 2.
          filterModalOpen: false,
          // Pagination — server trả `total` để FE biết page count. `page` 0-based; `pageSize`
          // đồng bộ với params.limit; `hasMore` chỉ để render trạng thái nút Next (dù đã có total,
          // giữ để đọc code rõ hơn). Đổi filter → reset page = 0. Đổi pageSize/page → load lại.
          page: 0, pageSize: 100, total: 0, hasMore: false,
          // Client Store cấp detail: chỉ sống trong phiên app để không persist PII lên disk.
          // `{ data, loadedAt }`; data vẫn được refresh nền để không thành nguồn sự thật lâu dài.
          detailStore: {} },
        // Lightbox phóng to ảnh QR VietQR — dùng chung cho QR ở chi tiết đơn và QR vừa tạo ở modal
        // Tạo đơn thủ công. null = đang đóng, string = url ảnh đang phóng to.
        qrLightboxUrl: null,
        // Modal "Tạo vận đơn" carrier-agnostic (thay nút "Tạo vận đơn GHN" hardcode). Chọn đối tác từ
        // registry ShippingCarriers (đã kết nối) + option "Tự giao / hãng khác" (SELF, không gọi API).
        // order = snapshot orders.detail lúc mở. serviceTypeId/requiredNote chỉ dùng cho hãng có API (GHN).
        // Goship là AGGREGATOR → thêm rates/rateId: chọn hãng thật ngay trong modal (bảng so sánh phí/ETA).
        shipModal: {
          show: false, order: null, carriers: [], loading: false,
          carrier: '', serviceTypeId: '2', requiredNote: 'CHOXEMHANGKHONGTHU',
          // V6.1 2026-08-04: 3 trường giao hàng chuẩn Sapo/GHN — cod tự điền từ đơn (số tiền còn
          // thiếu), staff sửa được; delivery_note cho tài xế; requiredNote select 3 mức.
          // Default (2026-08-05): CHOXEMHANGKHONGTHU — chuẩn CSKH ngành mỹ phẩm/dược mỹ phẩm
          // (cho xem để khách yên tâm nhưng không cho thử tránh nhiễm chéo/mất niêm phong).
          codAmount: 0, deliveryNote: '',
          // V6.2 2026-08-05 multi-warehouse: pickBranchId (default = order.branch_id, cho phép
          // override qua dropdown). Backend resolve pick address + adapter IDs từ Branches sheet
          // (docs/backend-multiwarehouse-stub.md §2.4).
          pickBranchId: '',
          // showBranchPicker (2026-08-05): mặc định false → chỉ hiện địa chỉ kho auto-resolved từ
          // chi nhánh của đơn, không show dropdown chọn (gây rối). User bấm "Đổi kho khác" mới mở.
          showBranchPicker: false,
          // packedConfirmed default = true (2026-08-05): staff mở modal đã có ý định tạo vận đơn,
          // tick sẵn để giảm 1 click; vẫn cho untick nếu chưa đóng thực tế.
          packedConfirmed: true, fee: null, feeLoading: false, feeError: '',
          selfCarrierName: 'Tự giao', manualTracking: '', manualFee: '', submitting: '',
          rates: [], rateId: '', rateSort: 'fee', rateCarrier: '',
          packageWeight: '', packageDims: '',
          ghtkPickAddresses: [], ghtkPickAddressesLoading: false, ghtkPickAddressId: '',
          ghtkPickName: '', ghtkPickTel: '', ghtkPickAddress: '', ghtkPickProvince: '', ghtkPickDistrict: '', ghtkPickWard: '',
          ghtkProvinces: [], ghtkDistricts: [], ghtkLocationLoading: false, ghtkPickSource: 'auto',
          // Inline address editor (V6 Fulfillment refactor 2026-08-04) — cho phép sửa
          // Người nhận/SĐT/Tỉnh-Quận-Xã/Số nhà NGAY trong modal Tạo vận đơn, KHÔNG đóng
          // modal & mất packageWeight/packageDims/carrier/rate đã nhập. Sau khi lưu,
          // auto trigger previewShipFee/reload rates. Master data từ window.MopsAddressMaster
          // (assets/mops-address-*.js.bwt).
          addrEdit: {
            open: false, saving: false, error: '',
            receiverName: '', phone: '', address: '',
            // 2026-08-16: refactor từ 3 select cascade legacy → <mops-address-picker>.
            // provinceCode/*Name giữ backward-compat cho code path cũ chưa refactor; luồng save đọc
            // từ addr.provinceName/wardName + adapters.ghn (giống form Sửa/Thêm địa chỉ khách).
            provinceCode: '', provinceName: '',
            districtCode: '', districtName: '',
            wardCode: '', wardName: '',
            addr: null
          }
        },
        manualOrder: {
          showForm: false, itemSearch: '', cart: [],
          itemSearchFocused: false, categoryFilter: '',
          quickAdd: { show: false, title: '', price: '', inventoryQty: '', sku: '', productType: '', vendor: '', image: '', saving: false },
          orderType: 'product', branchId: '', appointmentDate: '', appointmentTime: '',
          customerName: '', phone: '', note: '', internal_note: '',
          customerSearch: '', customerSearchFocused: false, selectedCustomer: null,
          // customerAddressLoading: true trong lúc gọi get_customer sau khi chọn khách để đầy đủ
          // profile (customers.all là list rút gọn, KHÔNG có addresses[] — xem comment ở
          // pickManualOrderCustomer). Trước khi có flag này, template hiện "Chưa có địa chỉ" ngay
          // sau click → nhân viên tưởng khách chưa có sổ địa chỉ và bấm "Chọn địa chỉ" thừa.
          customerAddressLoading: false,
          // invalidField: tên field đang bị nhắc do bỏ trống lúc bấm Tạo đơn ('phone' /
          // 'appointmentDate' / 'discountReason') — nguồn DUY NHẤT cho viền đỏ + gợi ý dưới
          // field, dùng chung cho mọi field bắt buộc thay vì 1 boolean riêng từng field.
          discountType: '%', discountValue: '', discountReason: '', invalidField: null,
          couponCode: '', couponChecking: false, couponPreview: null,
          // shipToOther=true → đang hiện form sửa tay người nhận (địa chỉ khác khách hàng);
          // false → dùng nguyên thông tin khách hàng đã chọn, tự điền qua syncManualOrderShipping().
          // wantsShipping mặc định true theo hướng POS V3 (2026-08-04): telesale/online là luồng
          // chính, hiện form giao hàng ngay để giảm 1 click. Bán tại quầy vẫn 1 click sang toggle.
          wantsShipping: true, shipToOther: false, shipReceiverName: '', shipPhone: '', shipAddress: '',
          selectedAddressId: '', saveCustomerAddress: false,
          // shipReceiverAddress: khi shipToOther=true, cho phép nhân viên override
          // toàn bộ địa chỉ giao (số nhà/đường) độc lập với shipAddress của khách.
          // Empty string = fall back về shipAddress (mặc định).
          shipReceiverAddress: '',
          // Địa chỉ GIAO dùng picker GHN 3 cấp (mã hành chính GHN — nguồn sự thật khi tạo vận đơn).
          // Lưu cả MÃ (id/code gửi lên GHN) + TÊN (hiển thị + lưu ShippingAddresses). shipProvince/shipWard
          // (tên 2 cấp cũ) không còn dùng cho đơn giao GHN.
          shipProvinceId: '', shipProvinceName: '', shipDistrictId: '', shipDistrictName: '', shipWardCode: '', shipWardName: '',
          // Địa chỉ theo MopsAddressMaster (docs/master-data): 3 mã hành chính chuẩn GSO
          // (63 tỉnh + 696 huyện + 10051 xã). Đây là nguồn sự thật MỚI cho payload
          // province_code/district_code/ward_code — độc lập với shipProvinceId (GHN adapter).
          // Nếu master.ghn có giá trị → suy ra shipProvinceId khi cần dựng vận đơn GHN.
          addrProvinceCode: '', addrProvinceName: '',
          addrDistrictCode: '', addrDistrictName: '',
          addrWardCode: '', addrWardName: '',
          // Typeahead smart-search state cho 3 combobox mới. addrSmartQuery = ô "Tìm nhanh"
          // gộp chuỗi ("Dịch Vọng Cầu Giấy" → tự chọn cả 3). *Focused = flag mở dropdown.
          addrSmartQuery: '', addrSmartFocused: false,
          addrProvinceQuery: '', addrProvinceFocused: false,
          addrDistrictQuery: '', addrDistrictFocused: false,
          addrWardQuery: '', addrWardFocused: false,
          provinceSearch: '', districtSearch: '', wardSearch: '', customerShippingFee: '', customerShippingFeeManual: false,
          ghnProvinces: [], ghnDistricts: [], ghnWards: [], ghnLoading: false, addressMasterSource: '', publicAddressData: [], shippingFee: null, shippingFeeLoading: false,
          // Phương thức thanh toán: VIETQR (trả trước QR) | COD (thu hộ khi giao — server đặt CODAmount = tổng đơn).
          paymentMethod: 'VIETQR',
          // Chế độ SỬA đơn (2026-07-19): editingOrderId != null → form dùng lại cho sửa đơn đã tạo.
          // editReason bắt buộc (audit); editLocks = cảnh báo trạng thái nhạy cảm hiện đầu form.
          editingOrderId: null, editReason: '', editLocks: [],
          // origPaymentMethod: ghi lại method LÚC MỞ form Sửa đơn để phát hiện thay đổi (chỉ gửi
          // payment_method lên backend khi đã đổi thật — tránh no-op ghi lại cùng giá trị) + để computed
          // paymentEditLock so sánh trạng thái CASH/PAID ban đầu.
          origPaymentMethod: '', origPaymentStatus: '',
          // 2026-08-21 — Modal chọn địa chỉ giao hàng. Thay khối inline address picker + dropdown
          // sổ địa chỉ bằng 1 dòng preview + nút "Sửa" mở modal (list mode: chọn radio từ sổ; add
          // mode: dùng <mops-address-picker> để thêm mới, gọi save_customer_address ngầm).
          addressPicker: {
            open: false, mode: 'list', saving: false, pendingSelectId: '',
            tempAddr: { provinceCode: '', provinceName: '', districtCode: '', districtName: '', wardCode: '', wardName: '', fullShippingAddress: '', adapters: {} },
            tempStreet: '', tempReceiverName: '', tempPhone: ''
          },
          submitting: false, error: '', result: null
        }
      };
    },
    // Watch: đăng ký/gỡ hotkey F2/F4/F9 khi modal Tạo đơn mở/đóng (V3 POS-flow 2026-08-04).
    // Không dùng global keydown suốt phiên vì F2 là "Rename" mặc định của Chrome — phải cẩn
    // thận scope. Handler được lazy-init 1 lần rồi tái dùng để add/remove cùng reference.
    watch: {
      'manualOrder.showForm': function(open) {
        if (open) {
          if (!this._maHotkey) this._maHotkey = this._makeManualOrderHotkeyHandler();
          window.addEventListener('keydown', this._maHotkey);
        } else if (this._maHotkey) {
          window.removeEventListener('keydown', this._maHotkey);
        }
      }
    },
    computed: {
      // 2026-08-23 — Bulk print đơn hàng (Mục 3 plan OMS). Computed để master checkbox biết trạng thái
      // đầy đủ/lưng chừng/rỗng theo orders.list trang hiện tại. Trả:
      //   'all'   → tất cả row trang hiện tại đã tick (checkbox tick + tick đầy)
      //   'some'  → 1 phần đã tick (indeterminate — CSS đánh dấu qua :indeterminate không auto-set được ở
      //             checkbox HTML, template :checked=false + custom class thể hiện trạng thái này)
      //   'none'  → chưa tick nào
      // Dùng để render đúng nút master checkbox và floating action bar (chỉ hiện khi 'all'/'some').
      // 2026-08-30 — merge activity_logs (mốc nghiệp vụ) + shipment_timeline (webhook ĐVVC, get_order
      // đã trả sẵn field này nhưng orders.detail chưa render ở đâu) thành 1 timeline duy nhất cho card
      // "Lịch sử đơn", sort mới nhất trước. Dedupe theo (label, thời điểm lệch < 60s) — cùng pattern
      // đã dùng ở page.order-lookup.bwt renderTimeline(). FE-only, không gọi thêm request/đụng BE.
      orderDetailTimeline: function() {
        var self = this;
        var d = this.orders.detail || {};
        function toDate(when) {
          if (when instanceof Date) return when;
          if (typeof when === 'string' && when) { var p = new Date(when); return isNaN(p.getTime()) ? null : p; }
          return null;
        }
        var events = [];
        (d.activity_logs || []).forEach(function(a) {
          if (!a.label) return;
          var when = toDate(a.created_at);
          events.push({ key: 'log_' + a.log_id, t: when ? when.getTime() : 0, when: when,
            label: a.label, sub: 'Người thao tác: ' + (a.user || 'Hệ thống') });
        });
        (d.shipment_timeline || []).forEach(function(h) {
          var text = h.status_text || self.fulfillmentLabel(h.fulfillment_status) || h.status_raw;
          if (!text) return;
          var when = toDate(h.created_at) || (h.update_time ? new Date(h.update_time * 1000) : null);
          var t = when ? when.getTime() : 0;
          var dup = events.some(function(e) { return e.label === text && Math.abs(e.t - t) < 60000; });
          if (dup) return;
          var subParts = [];
          if (h.carrier_label || h.carrier_code) subParts.push(h.carrier_label || h.carrier_code);
          if (h.note) subParts.push(h.note);
          events.push({ key: 'ship_' + h.history_id, t: t, when: when, label: text, sub: subParts.join(' · ') });
        });
        events.sort(function(a, b) { return b.t - a.t; });
        return events;
      },
      ordersSelectionState: function() {
        var visible = (this.orders.list || []).map(function(o) { return String(o.order_id); }).filter(Boolean);
        if (!visible.length) return 'none';
        var sel = this.orders.selectedIds || [];
        var checked = visible.filter(function(id) { return sel.indexOf(id) !== -1; }).length;
        if (checked === 0) return 'none';
        if (checked === visible.length) return 'all';
        return 'some';
      },
      // Khoá đổi phương thức thanh toán khi Sửa đơn (2026-07-28). Nguồn sự thật là backend updateOrder:
      // chỉ cho VIETQR ↔ COD khi order chưa THU TIỀN, cấm mọi giao dịch dính CASH (CASH luôn PAID). Đây
      // là gương UI của guard đó — bấm được nút thì backend cũng nhận. Trả { locked, reason } để template
      // vừa disable radio vừa hiện tooltip đúng lý do (tránh câm lặng như bản trước).
      paymentEditLock: function() {
        var mo = this.manualOrder;
        if (!mo.editingOrderId) return { locked: false, reason: '' };
        var st = String(mo.origPaymentStatus || '').toUpperCase();
        if (['PAID', 'REFUNDED', 'CANCELLED', 'EXPIRED'].indexOf(st) !== -1)
          return { locked: true, reason: 'Đơn đã ' + st + ' — không đổi được phương thức thanh toán. Nếu cần, xử lý ở tab Tài chính (hoàn tiền/tạo đơn mới).' };
        if (String(mo.origPaymentMethod || '').toUpperCase() === 'CASH')
          return { locked: true, reason: 'Đơn TIỀN MẶT đã có Phiếu Thu tự động — cần Voucher đảo tay ở tab Tài chính trước khi đổi phương thức.' };
        return { locked: false, reason: '' };
      },
      // CASH KHÔNG được chọn trong luồng Sửa đơn: đổi sang CASH nghĩa là auto-tạo Phiếu Thu tại quầy —
      // không phải hành vi mong đợi của "Sửa đơn". Muốn thu tiền mặt: xác nhận PAID + tạo Phiếu Thu tay
      // ở tab Tài chính. Chỉ hiện CASH nếu order ĐANG là CASH (chỉ đọc).
      paymentMethodOptionAvailable: function() {
        var mo = this.manualOrder;
        var isEdit = !!mo.editingOrderId;
        var origCash = String(mo.origPaymentMethod || '').toUpperCase() === 'CASH';
        return {
          VIETQR: true,
          COD:    true,
          CASH:   !isEdit || origCash // create form: hiện CASH; edit: chỉ hiện khi đơn gốc là CASH
        };
      },
      /* ── Tạo đơn thủ công: catalog SP có thể bán (V2 2026-08-04: GIỮ item trong giỏ) ── */
      /* Đổi hành vi (V2): catalog persistent bên trái modal cần thấy CẢ sản phẩm đã trong giỏ
         với trạng thái "đã chọn" (checkbox+badge) — không thể ẩn như dropdown cũ. Việc dedup theo
         variant_id trước đây để tránh click trùng đã được thay bằng toggleManualOrderCartItem()
         (add/remove theo trạng thái). Sort: cart items lên đầu (ưu tiên cho user thấy giỏ hiện tại)
         khi không có query, còn lại sort theo updated_at. */
      manualOrderMatchedProducts: function() {
        var q = (this.manualOrder.itemSearch || '').trim().toLowerCase();
        var cat = this.manualOrder.categoryFilter;
        var cartKeys = {};
        this.manualOrder.cart.forEach(function(i) { cartKeys[i.variant_id || i.handle] = true; });
        var base = this.products.all.filter(function(p) {
          if (p.status !== 'active') return false;
          if (p.in_mops && !p.mops_enabled) return false;
          if (cat && p.product_type !== cat) return false;
          return true;
        });
        if (q) {
          base = base.filter(function(p) {
            return String(p.title || '').toLowerCase().indexOf(q) !== -1
              || String(p.handle || '').toLowerCase().indexOf(q) !== -1
              || String(p.variant_title || '').toLowerCase().indexOf(q) !== -1
              || String(p.sku || '').toLowerCase().indexOf(q) !== -1;
          });
        }
        return base.slice().sort(function(a, b) {
          var aIn = !!cartKeys[a.variant_id || a.handle];
          var bIn = !!cartKeys[b.variant_id || b.handle];
          if (aIn !== bIn) return aIn ? -1 : 1;
          return String(b.updated_at).localeCompare(String(a.updated_at));
        });
      },
      /* Map variant_id/handle → cart item; để card catalog check "đã chọn?" + hiện qty trong O(1)
         thay vì scan giỏ mỗi lần render (cart có thể >20 dòng). */
      manualOrderCartMap: function() {
        var map = {};
        this.manualOrder.cart.forEach(function(i) { map[i.variant_id || i.handle] = i; });
        return map;
      },
      /* Cắt để không render cả nghìn dòng, nhưng đủ rộng để thu ngân cuộn chọn được — mức cũ
         (8 khi gõ / 10 gợi ý) quá ít, nhân viên tưởng kho thiếu hàng (review 2026-07-26). */
      manualOrderSearchResults: function() {
        var q = (this.manualOrder.itemSearch || '').trim();
        return this.manualOrderMatchedProducts.slice(0, q ? 50 : 30);
      },
      manualOrderSearchTotal: function() {
        return this.manualOrderMatchedProducts.length;
      },
      manualOrderCategories: function() {
        var seen = {}, cats = [];
        this.products.all.forEach(function(p) {
          var t = (p.product_type || '').trim();
          if (t && p.status === 'active' && !seen[t]) { seen[t] = true; cats.push(t); }
        });
        return cats.sort();
      },
      manualOrderNoResults: function() {
        return !!(this.manualOrder.itemSearch || '').trim() && !this.manualOrderSearchResults.length;
      },
      // Backend _resolveBankAccount() chọn theo chi nhánh, sau đó chi nhánh chính,
      // cuối cùng mới dùng tài khoản mặc định toàn hệ thống. UI chỉ phản ánh đúng
      // kết quả đó; gửi bank_account_id từ form sẽ tạo một dropdown không có hiệu lực.
      manualOrderReceivingBank: function() {
        var accounts = this.activeBankAccounts || [];
        var branchId = this.manualOrder.branchId;
        var branch = (this.branches.all || []).filter(function(b) { return b.branch_id === branchId; })[0];
        var accountId = branch && branch.default_bank_account_id;
        if (!accountId) {
          var mainBranch = (this.branches.all || []).filter(function(b) { return b.active && b.is_default; })[0];
          accountId = mainBranch && mainBranch.default_bank_account_id;
        }
        var account = accounts.filter(function(a) { return a.bank_account_id === accountId; })[0];
        if (account) return account;
        account = accounts.filter(function(a) { return a.is_default; })[0] || accounts[0];
        if (account) return account;
        // Tương thích store cũ: backend còn fallback Settings khi BankAccounts rỗng.
        if (this.settings && this.settings.bankCode && this.settings.accountNo) {
          return {
            bank_account_id: '', bank_code: this.settings.bankCode,
            account_no: this.settings.accountNo, account_name: this.settings.accountName || ''
          };
        }
        return null;
      },
      manualOrderAmounts: function() {
        var mo = this.manualOrder;
        var subtotal = mo.cart.reduce(function(sum, i) { return sum + (i.price * i.qty); }, 0);
        var preview  = mo.couponPreview;
        var discount = (preview && preview.valid) ? preview.discount_amount : 0;
        if (!discount && Number(mo.discountValue) > 0) {
          discount = mo.discountType === '%' ? Math.round(subtotal * Number(mo.discountValue) / 100) : Number(mo.discountValue);
          discount = Math.min(discount, subtotal);
        }
        var fee = 0;
        if (mo.wantsShipping) {
          var base = subtotal - discount;
          fee = mo.customerShippingFeeManual
            ? Math.max(0, Number(mo.customerShippingFee) || 0)
            : (base >= 500000 ? 0 : 30000);
        }
        return { subtotal: subtotal, discount: discount, fee: fee, total: subtotal - discount + fee };
      },
      // ── Address Master (MopsAddressMaster) cho form Tạo/Sửa đơn thủ công ──
      // 3 combobox smart-search dưới đây thay 3 dropdown ghn* cũ. Nguồn dữ liệu: window.MopsAddressMaster
      // (63/696/10051 rows) — load qua page.mops-admin.bwt. Suy ra street/ward/district/province từ tên
      // (mopsAddressResolveByNames) khi khách hàng đã có địa chỉ text ở Sheets.
      manualOrderAddrMasterReady: function() {
        var m = window.MopsAddressMaster;
        return !!(m && m.provinces && m.districts && m.wards);
      },
      // Lọc tỉnh theo query typeahead. Match trên tên không dấu (name + fullName).
      manualOrderAddrProvinceOptions: function() {
        var m = window.MopsAddressMaster; if (!m) return [];
        var q = this._addrNoAccent(this.manualOrder.addrProvinceQuery);
        var list = m.provinces || [];
        if (!q) return list.slice(0, 30);
        var self = this;
        return list.filter(function(p) {
          return self._addrNoAccent(p.n).indexOf(q) !== -1 || self._addrNoAccent(p.f).indexOf(q) !== -1;
        }).slice(0, 30);
      },
      manualOrderAddrDistrictOptions: function() {
        var m = window.MopsAddressMaster; if (!m) return [];
        var pc = this.manualOrder.addrProvinceCode;
        if (!pc) return [];
        var q = this._addrNoAccent(this.manualOrder.addrDistrictQuery);
        var list = (m.districts || []).filter(function(d) { return d.p === pc; });
        if (!q) return list.slice(0, 50);
        var self = this;
        return list.filter(function(d) {
          return self._addrNoAccent(d.n).indexOf(q) !== -1 || self._addrNoAccent(d.f).indexOf(q) !== -1;
        }).slice(0, 50);
      },
      manualOrderAddrWardOptions: function() {
        var m = window.MopsAddressMaster; if (!m) return [];
        var dc = this.manualOrder.addrDistrictCode;
        if (!dc) return [];
        var q = this._addrNoAccent(this.manualOrder.addrWardQuery);
        var list = (m.wards || []).filter(function(w) { return w.p === dc; });
        if (!q) return list.slice(0, 80);
        var self = this;
        return list.filter(function(w) {
          return self._addrNoAccent(w.n).indexOf(q) !== -1 || self._addrNoAccent(w.f).indexOf(q) !== -1;
        }).slice(0, 80);
      },
      // Smart-search gộp chuỗi ("Dịch Vọng Cầu Giấy" → chọn ward=Dịch Vọng, district=Cầu Giấy, province=HN).
      // Duyệt qua wards + join full-path để chấm điểm theo số token khớp. Trả tối đa 8 candidate.
      manualOrderAddrSmartCandidates: function() {
        var m = window.MopsAddressMaster; if (!m) return [];
        var raw = String(this.manualOrder.addrSmartQuery || '').trim();
        if (raw.length < 2) return [];
        var q = this._addrNoAccent(raw);
        var tokens = q.split(/\s+/).filter(function(t) { return t.length >= 2; });
        if (!tokens.length) return [];
        var self = this;
        var pById = {}, dById = {};
        (m.provinces || []).forEach(function(p) { pById[p.c] = p; });
        (m.districts || []).forEach(function(d) { dById[d.c] = d; });
        var scored = [];
        var wards = m.wards || [];
        for (var i = 0; i < wards.length; i++) {
          var w = wards[i];
          var d = dById[w.p]; if (!d) continue;
          var p = pById[d.p]; if (!p) continue;
          var hay = self._addrNoAccent(w.n + ' ' + w.f + ' ' + d.n + ' ' + d.f + ' ' + p.n + ' ' + p.f);
          var score = 0;
          for (var ti = 0; ti < tokens.length; ti++) {
            if (hay.indexOf(tokens[ti]) !== -1) score++;
          }
          if (score < Math.min(2, tokens.length)) continue;
          scored.push({ score: score, ward: w, district: d, province: p });
        }
        scored.sort(function(a, b) { return b.score - a.score; });
        return scored.slice(0, 8);
      },
      // Chuỗi địa chỉ đầy đủ để hiển thị + gửi payload full_shipping_address. Tương thích ngược
      // module vận chuyển/Sapo cũ vốn nhận string "số nhà, xã, huyện, tỉnh". 2026-08-12 refactor:
      // đọc từ mo.addr.* (payload từ <mops-address-picker>). Fallback mo.shipXxxName cho row cũ
      // (edit đơn cũ chưa có mo.addr populate) và mo.shipReceiverAddress khi shipToOther=true.
      manualOrderFullShippingAddress: function() {
        var mo = this.manualOrder;
        var a  = mo.addr || {};
        var street = ((mo.shipToOther && mo.shipReceiverAddress) || mo.shipAddress || '').trim();
        var parts = [
          street,
          a.wardName || mo.shipWardName || '',
          a.districtName || mo.shipDistrictName || '',
          a.provinceName || mo.shipProvinceName || ''
        ];
        return parts.map(function(s) { return String(s || '').trim(); }).filter(Boolean).join(', ');
      },
      /* ── Đơn hàng: server-filtered (loadOrders) ── */
      ordersEmptyMessage: function() {
        // Lỗi tải lại không được xoá danh sách cũ khỏi UI; chỉ hiển thị empty
        // khi thực sự không còn dữ liệu để giữ màn hình đơn hàng ổn định.
        if (this.orders.error && !this.orders.list.length) return this.orders.error;
        if (!this.orders.list.length) return 'Không có đơn hàng phù hợp với bộ lọc.';
        return '';
      },
      // Số bộ lọc đang bật — hiện badge trên nút "Bộ lọc" mobile để user biết còn lọc dù sheet đóng.
      ordersFilterCount: function() {
        var o = this.orders;
        return (o.orderId ? 1 : 0) + (o.status ? 1 : 0) + (o.paymentMethod ? 1 : 0) + (o.branchId ? 1 : 0) + (o.from ? 1 : 0) + (o.to ? 1 : 0);
      },
      // Pagination render helpers — số trang tổng, dải index đang hiển thị, và trang hiện tại (1-based).
      // Dùng ceil để cover phần dư; total=0 → pageCount=0 (không hiện thanh nav).
      ordersPageCount: function() {
        var o = this.orders;
        if (!o.total || !o.pageSize) return 0;
        return Math.ceil(o.total / o.pageSize);
      },
      ordersPageRange: function() {
        var o = this.orders;
        if (!o.total) return { from: 0, to: 0 };
        var from = o.page * o.pageSize + 1;
        var to   = Math.min((o.page + 1) * o.pageSize, o.total);
        return { from: from, to: to };
      },
      /* ── Board pipeline xử lý đơn (phase vận chuyển 2026-07-17) — chip đếm theo FulfillmentStatus ── */
      fulfillmentBoard: function() {
        var order  = ['pending_approval','pending_payment','pending_packing','ready_to_pick','delivering','redelivery','delivered','delivery_cancelled','returned','cancelled'];
        var counts = this.orders.fulfillmentCounts || {};
        var self   = this;
        return order.map(function(s) {
          return { slug: s, label: self.fulfillmentLabel(s), count: counts[s] || 0, active: self.orders.fulfillment === s };
        });
      },
      // ── V6 2026-08-04 Address Master cascade (Fulfillment inline editor) ──
      // Lookup local qua window.MopsAddressMaster (load từ 3 assets mops-address-*.js.bwt
      // ở layouts/mops-admin.bwt). Trả [] khi master data chưa load — dropdown rỗng, user
      // thấy ngay là thiếu asset thay vì crash. Thay thế loadGhnProvinces/Districts/Wards
      // cascade qua GAS (RTT ~500ms mỗi cấp → tổng ~1.5s so với 0ms local).
      shipAddrProvinces: function() {
        return (window.MopsAddressMaster && window.MopsAddressMaster.provinces) || [];
      },
      shipAddrDistrictsForProvince: function() {
        var pc = this.shipModal.addrEdit.provinceCode;
        if (!pc) return [];
        return ((window.MopsAddressMaster && window.MopsAddressMaster.districts) || []).filter(function(d) { return d.p === pc; });
      },
      shipAddrWardsForDistrict: function() {
        var dc = this.shipModal.addrEdit.districtCode;
        if (!dc) return [];
        return ((window.MopsAddressMaster && window.MopsAddressMaster.wards) || []).filter(function(w) { return w.p === dc; });
      },
      shipAddrMasterAvailable: function() {
        var m = window.MopsAddressMaster;
        return !!(m && m.provinces && m.districts && m.wards);
      },
      // V6.2 2026-08-05 multi-warehouse: danh sách kho khả dụng cho dropdown shipModal.
      // Chỉ include branch active + có pick_address điền tối thiểu (receiver_name + phone +
      // address_code). Đơn từ branch_id không active/không có pick sẽ dropdown blank prompt
      // user chọn 1 kho khác — không tự fallback default để tránh giao nhầm địa chỉ.
      shipPickBranchOptions: function() {
        var branches = (this.branches && this.branches.all) || [];
        return branches.filter(function(b) {
          return b.active && b.pick_receiver_name && b.pick_phone && b.pick_address && b.pick_ward_code;
        }).map(function(b) {
          return {
            branch_id: b.branch_id, name: b.name_vi, is_default: !!b.is_default,
            pick_address: b.pick_address, pick_ward: b.pick_ward || '',
            pick_district: b.pick_district || '', pick_province: b.pick_province || '',
            address_line: [b.pick_address, b.pick_ward, b.pick_district, b.pick_province].filter(Boolean).join(', '),
            capable_ghn: !!Number(b.ghn_shop_id), capable_ghtk: !!b.ghtk_pick_address_id,
            capable_goship: true, capable_viettelpost: true, capable_vnpost: !!b.vnpost_customer_code
          };
        });
      },
      shipPickBranchCurrent: function() {
        var self = this;
        var opts = this.shipPickBranchOptions;
        return opts.filter(function(o) { return o.branch_id === self.shipModal.pickBranchId; })[0] || null;
      },
      shipPickBranchCapableForCarrier: function() {
        // Trả về true/false cho carrier đang chọn ứng với kho đang chọn — dùng để show warning
        // inline trên row carrier nếu kho chưa liên kết hãng đó (Sapo POS reference §II.3).
        var cur = this.shipPickBranchCurrent; var carrier = String(this.shipModal.carrier || '').toUpperCase();
        if (!cur || !carrier) return true;
        if (carrier === 'GHN') return cur.capable_ghn;
        if (carrier === 'GHTK') return cur.capable_ghtk;
        if (carrier === 'GOSHIP') return cur.capable_goship;
        if (carrier === 'VIETTELPOST' || carrier === 'VTP') return cur.capable_viettelpost;
        if (carrier === 'VNPOST') return cur.capable_vnpost;
        return true;   // SELF/MANUAL không cần adapter map
      },
      // orderDetailPaymentMethod (V6.5 fix 2026-08-05): TRUST payment_method field, KHÔNG fallback
      // theo cod_amount. Bug user báo: đơn VIETQR PAID hiển thị "COD (thu hộ)" vì đơn cũ có
      // cod_amount > 0 tồn dư (backend cũ auto-set) + payment_method chưa migrate. Fallback theo
      // cod_amount sai — MOPS thị trường VN dùng VIETQR nhiều hơn, default 'VIETQR' an toàn hơn.
      // Backend đã có col payment_method (mops.md §16 review 2026-07-28) — đơn tạo qua V6+ luôn
      // set. Đơn cũ pre-V4 backfill script sẽ chạy sau (out of scope FE session này).
      orderDetailPaymentMethod: function() {
        var d = this.orders.detail || {};
        return String(d.payment_method || 'VIETQR').toUpperCase();
      },
      // 2026-08-22 — orderDetailAmounts: TÍNH LẠI từ items + discount/ship, không
      // tin thẳng orders.detail.total_amount. Bug ghi lại:
      //   (1) MOPS0022 hiện 132.315.667.200.000₫ vì dữ liệu Sheet cột E rác từ lần ghi cũ
      //       → giải bằng subtotal = Σ lineTotal.
      //   (2) discount_amount = 0 dù đơn Sỉ có order_discount_type='%'/value=10 và
      //       pay_amount = 1.557.000 (subtotal 1.730.000 − 10%) → backend không ghi
      //       discount_amount tương ứng cho case Sỉ. Suy ngược từ pay_amount khi có
      //       signal chiết khấu (order_discount_value/order_discount_type/discount_code).
      // Từ nay UI luôn dùng FE-computed — số học Number() thuần, không phụ thuộc backend.
      orderDetailAmounts: function() {
        var d = this.orders.detail || {};
        var items = Array.isArray(d.items) ? d.items : [];
        var subtotal = items.reduce(function(sum, it) {
          var line = Number(it.lineTotal);
          if (isFinite(line) && line > 0) return sum + line;
          var price = Number(it.price) || 0;
          var qty   = Number(it.qty) || 1;
          return sum + price * qty;
        }, 0);
        var shipping = Number(d.customer_shipping_fee) || 0;
        var deposit  = Number(d.deposit_amount) || 0;
        var pay = Number(d.pay_amount);
        if (!isFinite(pay) || pay < 0) pay = 0;
        var discount = Number(d.discount_amount) || 0;
        // Suy ngược discount: có signal + backend trả 0 + đơn thường (không cọc) → dùng
        // pay = subtotal − discount + shipping ⇒ discount = subtotal + shipping − pay.
        var hasDiscountSignal = (Number(d.order_discount_value) || 0) > 0
          || String(d.order_discount_type || '').length > 0
          || String(d.discount_code || '').length > 0
          || (Number(d.discount_percent) || 0) > 0;
        if (discount === 0 && hasDiscountSignal && subtotal > 0 && pay > 0 && deposit === 0) {
          var derived = subtotal + shipping - pay;
          if (derived > 0 && derived < subtotal) discount = derived;
        }
        var total = Math.max(0, subtotal - discount + shipping);
        if (pay <= 0) pay = total;
        return { subtotal: subtotal, discount: discount, shipping: shipping, total: total, pay: pay };
      }
    },
    methods: {
      /* ── Đơn hàng ── */
      // 2026-08-22: nút × trong ô search Đơn hàng — clear ô + reload danh sách. Cần vì
       // viewOrderFromCustomer set orders.orderId = <mã đơn> để list mở đúng 1 dòng, khi
       // staff quay lại list ô search vẫn còn text → không có cách clear nhanh nếu chỉ xoá
       // text (loadOrders trigger theo @keydown.enter, xoá bằng chuột/select-all-delete
       // không fire).
      clearOrdersSearch: function() {
        this.orders.orderId = '';
        this.loadOrders();
      },
      loadOrders: function(opts) {
        // opts.keepPage=true khi navigate paginate (Next/Prev). Đổi filter/pageSize → không truyền,
        // page tự reset về 0. Đây là hợp đồng ngầm: mọi call trong app hiện tại KHÔNG truyền opts →
        // reset trang là hành vi cũ (safe default). Chỉ nextOrdersPage/prevOrdersPage/goToOrdersPage
        // mới truyền keepPage=true.
        if (!(opts && opts.keepPage)) this.orders.page = 0;
        var self = this;
        var core = window.MopsAdminCore;
        this.orders.loading = true;
        this.orders.error = '';
        if (typeof this.ensureBranchesLoaded === 'function') this.ensureBranchesLoaded();
        var params = {
          action: 'list_transactions',
          limit: this.orders.pageSize,
          offset: this.orders.page * this.orders.pageSize
        };
        if (this.orders.status)      params.status             = this.orders.status;
        if (this.orders.fulfillment) params.fulfillment_status = this.orders.fulfillment;
        if (this.orders.paymentMethod) params.payment_method = this.orders.paymentMethod;
        if (this.orders.branchId)    params.branch_id      = this.orders.branchId;
        if (this.orders.from)        params.from               = this.orders.from;
        if (this.orders.to)          params.to                 = this.orders.to;
        if (this.orders.orderId)     params.order_id           = this.orders.orderId.trim();
        // return promise — cần cho viewOrderFromCustomer() (Drawer khách hàng) tự mở rộng đúng
        // đơn vừa lọc ngay sau khi danh sách tải xong, thay vì chỉ lọc rồi để staff tự bấm lại.
        return core.gasGet(params)
          .then(function(d) {
            self.orders.loading = false;
            if (!d || !d.success) { self.orders.error = 'Không tải được danh sách đơn hàng.'; return; }
            // Backend đã sort DESC theo created_at trước khi paginate — không cần sort lại ở FE.
            self.orders.list = d.transactions || [];
            self.orders.total = Number(d.total) || 0;
            self.orders.hasMore = !!d.has_more;
            self.orders.fulfillmentCounts = d.fulfillment_counts || {};
            if (self.orders.expandedId && !self.orders.list.some(function(order) { return order && order.order_id === self.orders.expandedId; })) {
              self.orders.expandedId = null;
              self.orders.detail = null;
              self.orders.detailLoading = false;
              if (self.workspaceView === 'orders.detail') self.workspaceView = 'orders.list';
            }
            if (!self.orders.list.length) self.orders.error = 'Không có đơn hàng nào phù hợp bộ lọc.';
          })
          .catch(function() { self.orders.loading = false; self.orders.error = 'Lỗi kết nối. Kiểm tra GAS_URL.'; });
      },
      // Pagination navigation. `keepPage: true` báo loadOrders KHÔNG reset page — chỉ đổi page + reload.
      nextOrdersPage: function() {
        if (!this.orders.hasMore || this.orders.loading) return;
        this.orders.page += 1;
        this.loadOrders({ keepPage: true });
      },
      prevOrdersPage: function() {
        if (this.orders.page <= 0 || this.orders.loading) return;
        this.orders.page -= 1;
        this.loadOrders({ keepPage: true });
      },
      goToOrdersPage: function(pageIdx) {
        var p = Math.max(0, parseInt(pageIdx, 10) || 0);
        if (p === this.orders.page || this.orders.loading) return;
        this.orders.page = p;
        this.loadOrders({ keepPage: true });
      },
      changeOrdersPageSize: function(size) {
        var s = parseInt(size, 10);
        if (!s || s === this.orders.pageSize) return;
        this.orders.pageSize = s;
        this.orders.page = 0;
        this.loadOrders({ keepPage: true }); // keepPage vì loadOrders sẽ reset qua param nếu không keep,
                                             // ta muốn giữ page=0 vừa set (không cần reset thêm).
      },
      /* ══ XUẤT CSV ═══════════════════════════════════════════════════════════════════════════
         Gọi export_orders (không limit) với ĐÚNG bộ lọc đang hiện trên UI (từ/đến/thanh toán/xử
         lý đơn/mã đơn) — để nhân viên thấy gì thì tải về thế. Backend đã join Customers + Branches.
         Pattern y hệt exportCustomersCsv: BOM UTF-8, esc() giữ số 0 đầu SĐT bằng prefix tab. */
      exportOrdersCsv: function() {
        var self = this, core = window.MopsAdminCore;
        if (this.orders.exporting) return;
        var params = { action: 'export_orders' };
        if (this.orders.status)      params.status             = this.orders.status;
        if (this.orders.fulfillment) params.fulfillment_status = this.orders.fulfillment;
        if (this.orders.paymentMethod) params.payment_method = this.orders.paymentMethod;
        if (this.orders.branchId)    params.branch_id      = this.orders.branchId;
        if (this.orders.from)        params.from               = this.orders.from;
        if (this.orders.to)          params.to                 = this.orders.to;
        if (this.orders.orderId)     params.order_id           = this.orders.orderId.trim();
        this.orders.exporting = true;
        core.gasPost(params)
          .then(function(d) {
            self.orders.exporting = false;
            if (!d || !d.success) { core.showToast('Không xuất được: ' + ((d && d.error) || ''), 'error'); return; }
            var list = d.orders || [];
            if (!list.length) { core.showToast('Không có đơn hàng nào khớp bộ lọc để xuất.', 'info'); return; }
            var statusLabel = function(s) {
              return ({ PENDING:'Chờ thanh toán', PAYMENT_REPORTED:'Đã báo chuyển', PAID:'Đã thanh toán',
                CANCELLED:'Đã huỷ', EXPIRED:'Hết hạn', REFUNDED:'Đã hoàn tiền' })[s] || s || '';
            };
            var cols = [
              ['order_id', 'Mã đơn'], ['customer_name', 'Khách hàng'], ['customer_phone', 'SĐT'],
              ['product_summary', 'Sản phẩm'], ['total_quantity', 'Số lượng SP'],
              ['total_amount', 'Tổng tiền'], ['deposit_amount', 'Tiền cọc'],
              ['payment_status_label', 'Thanh toán'], ['fulfillment_status_label', 'Xử lý đơn'],
              ['created_at', 'Ngày tạo'], ['branch_name', 'Chi nhánh'],
              ['carrier', 'Đơn vị vận chuyển'], ['tracking_code', 'Mã vận đơn']
            ];
            function esc(v) {
              var s = (v == null ? '' : String(v));
              // Mã đơn/SĐT bắt đầu bằng 0: prefix tab để Excel giữ nguyên số 0 đầu (không đọc thành số).
              if (/^0\d+$/.test(s)) s = '\t' + s;
              return /[",\n\t]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
            }
            var lines = [cols.map(function(c) { return esc(c[1]); }).join(',')];
            list.forEach(function(r) {
              // Enrich label local để không phụ thuộc backend gửi thêm field label.
              r.payment_status_label     = statusLabel(r.payment_status);
              r.fulfillment_status_label = self.fulfillmentLabel(r.fulfillment_status);
              lines.push(cols.map(function(c) { return esc(r[c[0]]); }).join(','));
            });
            // '\uFEFF' = BOM UTF-8 (escape — KHÔNG dán ký tự BOM thật vào source, tránh nhiễm &#xFEFF; ra HTML).
            var blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'don-hang-mops-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(function() { URL.revokeObjectURL(a.href); }, 1000);
            core.showToast('Đã xuất ' + list.length + ' đơn hàng.', 'success');
          })
          .catch(function() { self.orders.exporting = false; core.showToast('Lỗi kết nối khi xuất.', 'error'); });
      },
      /* ═══════════════ IN ĐƠN HÀNG HÀNG LOẠT — Mục 3 plan OMS (2026-08-23) ═══════════════
       * STRICT BOUNDARY: chỉ ở tab_orders, chỉ in NỘI DUNG đơn (SP + qty + giá + tổng + QR VietQR).
       * KHÔNG gọi get_shipment_label, KHÔNG render tem A6 100×150mm — cái đó ở tab_shipping/Mục 4.
       * Backend: get_orders_batch (mops_02.js) fetch 1 lần cho N đơn, graceful với lỗi từng phần.
       * ───────────────────────────────────────────────────────────────────────────────── */
      isOrderSelected: function(orderId) {
        return this.orders.selectedIds.indexOf(String(orderId)) !== -1;
      },
      toggleOrderSelected: function(orderId, event) {
        // Chặn propagation để click checkbox không mở row detail (click row có handler toggleOrderDetail).
        if (event && typeof event.stopPropagation === 'function') event.stopPropagation();
        var id = String(orderId);
        var idx = this.orders.selectedIds.indexOf(id);
        if (idx === -1) this.orders.selectedIds.push(id);
        else this.orders.selectedIds.splice(idx, 1);
      },
      toggleAllOrdersSelected: function(event) {
        // Chỉ tick những row visible (orders.list hiện tại) — nếu staff phân trang phải tick lại trang mới.
        var visibleIds = (this.orders.list || []).map(function(o) { return String(o.order_id); }).filter(Boolean);
        var allSelected = visibleIds.length > 0 && visibleIds.every(function(id) { return this.orders.selectedIds.indexOf(id) !== -1; }, this);
        if (allSelected) {
          // Bỏ chọn: giữ nguyên selection ngoài trang này (nếu có), chỉ bỏ những ID trong trang hiện tại.
          this.orders.selectedIds = this.orders.selectedIds.filter(function(id) { return visibleIds.indexOf(id) === -1; });
        } else {
          // Tích thêm những ID chưa có (giữ selection cũ để tổ hợp qua phân trang).
          var merged = this.orders.selectedIds.slice();
          visibleIds.forEach(function(id) { if (merged.indexOf(id) === -1) merged.push(id); });
          this.orders.selectedIds = merged;
        }
      },
      clearOrdersSelection: function() { this.orders.selectedIds = []; },
      // In N đơn — 1 window duy nhất chứa N sheet nối tiếp với page-break. Fetch qua get_orders_batch
      // để giảm N request thành 1 (loop bên backend tận dụng TextFinder fast-path).
      bulkPrintOrders: function() {
        var self = this, core = window.MopsAdminCore;
        var ids = this.orders.selectedIds.slice();
        if (!ids.length) { core.showToast('Chưa chọn đơn nào để in.', 'error'); return; }
        if (this.orders.printing) return;
        this.orders.printing = true;
        core.gasPost({ action: 'get_orders_batch', order_ids: ids })
          .then(function(d) {
            self.orders.printing = false;
            if (!d || !d.success) { core.showToast('Lỗi tải chi tiết đơn.', 'error'); return; }
            var orders = Array.isArray(d.orders) ? d.orders : [];
            var errors = Array.isArray(d.errors) ? d.errors : [];
            if (!orders.length) {
              core.showToast('Không lấy được đơn nào — kiểm tra kết nối rồi thử lại.', 'error');
              return;
            }
            self._openOrderPrintWindow(orders, self.orders.printPaperSize || 'A5');
            if (errors.length) {
              var ids = errors.map(function(e) { return e.order_id; }).join(', ');
              core.showToast('Đã in ' + orders.length + ' đơn. ' + errors.length + ' đơn lỗi: ' + ids, 'warning');
            } else {
              core.showToast('Đã gửi lệnh in ' + orders.length + ' đơn hàng.', 'success');
            }
          })
          .catch(function() {
            self.orders.printing = false;
            core.showToast('Lỗi kết nối khi tải đơn để in.', 'error');
          });
      },
      // In 1 đơn từ detail modal — dùng lại luồng bulk với mảng 1 phần tử.
      printSingleOrder: function(orderId, paperSize) {
        var self = this, core = window.MopsAdminCore;
        if (!orderId) return;
        var size = paperSize || this.orders.printPaperSize || 'A5';
        core.gasPost({ action: 'get_orders_batch', order_ids: [orderId] })
          .then(function(d) {
            if (!d || !d.success || !Array.isArray(d.orders) || !d.orders.length) {
              core.showToast('Không tải được đơn để in.', 'error'); return;
            }
            self._openOrderPrintWindow(d.orders, size);
          })
          .catch(function() { core.showToast('Lỗi kết nối khi tải đơn để in.', 'error'); });
      },
      _openOrderPrintWindow: function(orders, paperSize) {
        var html = this._buildOrderPrintHtml(orders, paperSize);
        var w = window.open('', '_blank', 'width=720,height=900');
        if (!w) { window.MopsAdminCore.showToast('Trình duyệt chặn popup — cho phép popup rồi thử lại.', 'error'); return; }
        w.document.open();
        w.document.write(html);
        w.document.close();
        // Chờ layout + font + QR image load rồi print. 500ms đủ với A5/A4 (K80 dài hơn chút vẫn OK).
        setTimeout(function() { try { w.focus(); w.print(); } catch (e) {} }, 500);
      },
      // Render N sheet đơn hàng liên tiếp — 1 window duy nhất, mỗi sheet page-break.
      // Bố cục: header shop + mã đơn · KH info · bảng items (☐ đã nhặt + SKU + tên + qty + đơn giá + thành tiền)
      // · tổng tiền · QR VietQR (nếu chưa PAID) · customer_note nếu có · footer. KHÔNG in internal_note.
      // 2026-08-27 — Hoá đơn bán hàng theo chuẩn Sapo POS. Bỏ khối Chữ ký + Vận chuyển/Giao hàng
      // (không cần cho in tại quầy). Full 9 khối:
      //  1) Header shop (tên/địa chỉ/SĐT/email)  2) Title HOÁ ĐƠN BÁN HÀNG + mã đơn + barcode
      //  3) Meta (ngày lập/nhân viên/chi nhánh/PT thanh toán/trạng thái)
      //  4) Khách hàng (họ tên/SĐT/mã KH)
      //  5) Lịch hẹn (nếu order_type booking/deposit)
      //  6) Bảng items (STT/SKU/tên/SL/đơn giá/CK/thành tiền)
      //  7) Tổng thanh toán (tạm tính · giảm giá + coupon/lý do · phí giao · TỔNG · bằng chữ · đã cọc/đã trả/còn lại)
      //  8) Thanh toán chuyển khoản + QR VietQR (chỉ khi chưa PAID)
      //  9) Ghi chú KH · Ghi chú giao hàng (KHÔNG in internal_note) + Footer
      _buildOrderPrintHtml: function(orders, paperSize) {
        var esc = function(s) {
          return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        };
        // 2026-08-24 đổi 'đ' → ' ₫' (U+20AB) khớp chuẩn Sapo POS.
        var fmtVND = function(n) { return (Number(n) || 0).toLocaleString('vi-VN') + ' ₫'; };
        // Parse an toàn Number từ field GAS có thể trả string format VN ("1.220.000") / US ("1,220,000") / số.
        var toNum = function(v) {
          if (typeof v === 'number' && isFinite(v)) return v;
          var s = String(v == null ? '' : v).replace(/[^\d.-]/g, '').replace(/\.(?=\d{3}(\D|$))/g, '');
          var n = parseFloat(s);
          return isFinite(n) ? n : 0;
        };
        var pageSize;
        var isK80 = false;
        if (paperSize === 'A4') pageSize = 'A4';
        else if (paperSize === 'K80') { pageSize = '80mm 297mm'; isK80 = true; }
        else pageSize = 'A5';

        // Settings shop — resolve qua Liquid khi Sapo compile theme (.bwt). Fallback nhiều tầng để không
        // in blank nếu setting chưa gõ. shop.name / shop.phone_number là object global của Sapo.
        var storeName    = {{ settings.store_name    | default: shop.name          | default: 'PHARMA COSMETICS' | json }};
        var storeAddress = {{ settings.store_address | default: ''                                              | json }};
        var storePhone   = {{ settings.store_phone   | default: shop.phone_number  | default: ''                | json }};
        var storeEmail   = {{ settings.store_email   | default: ''                                              | json }};

        // Map trạng thái đơn → nhãn tiếng Việt in đậm ở header.
        var statusLabel = { PENDING: 'Chờ thanh toán', PAYMENT_REPORTED: 'Chờ đối chiếu',
          PAID: 'Đã thanh toán', REFUNDED: 'Đã hoàn tiền', CANCELLED: 'Đã huỷ', EXPIRED: 'Hết hạn' };
        var payMethodLabel = { VIETQR: 'Chuyển khoản (VietQR)', COD: 'Thu hộ khi giao (COD)',
          CASH: 'Tiền mặt tại quầy' };

        // Ngày giờ đầy đủ dd/mm/yyyy HH:MM. Field created_at có thể là ISO string hoặc chuỗi khác — best-effort.
        var fmtDT = function(raw) {
          if (!raw) return '';
          var d = new Date(raw);
          if (isNaN(d.getTime())) return String(raw).substring(0, 16);
          var pad = function(n) { return (n < 10 ? '0' : '') + n; };
          return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() +
                 ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        };

        var sheets = orders.map(function(o) {
          var items = Array.isArray(o.items) ? o.items : [];

          // Compute sub_total từ items (KHÔNG tin o.total_amount — fix bug tổng nghìn tỷ).
          var subTotal = 0;
          var itemsRows = items.map(function(it, i) {
            var qty = toNum(it.qty || it.quantity || 0);
            var price = toNum(it.price || 0);
            var lineFromField = toNum(it.line_total);
            var lineDiscount = toNum(it.discount_value || it.line_discount || 0);
            var line = (lineFromField > 0 ? lineFromField : Math.max(0, qty * price - lineDiscount)) || 0;
            subTotal += line;
            var displayName = esc(it.name || it.title || it.handle || '?');
            if (it.variant_title) displayName += ' <span class="var">(' + esc(it.variant_title) + ')</span>';
            return '<tr>' +
              '<td class="c-idx">' + (i + 1) + '</td>' +
              (isK80 ? '' : '<td class="c-sku">' + esc(it.sku || '') + '</td>') +
              '<td class="c-name">' + displayName + '</td>' +
              '<td class="c-qty">' + qty + '</td>' +
              '<td class="c-price">' + fmtVND(price) + '</td>' +
              (isK80 ? '' : '<td class="c-disc">' + (lineDiscount > 0 ? '-' + fmtVND(lineDiscount) : '') + '</td>') +
              '<td class="c-total">' + fmtVND(line) + '</td>' +
            '</tr>';
          }).join('');

          var shipFee = toNum(o.customer_shipping_fee);
          var discount = toNum(o.discount_amount);
          var deposit = toNum(o.deposit_amount);
          var payAmountBE = toNum(o.pay_amount);
          var totalBE = toNum(o.total_amount);
          // 2026-08-24 fix bug TỔNG ≠ QR (1.730k vs 1.557k):
          // Trước đây recompute finalTotal = subTotal - discount + shipFee. Nhưng nếu BE trả
          // discount_amount = 0 (không phải NULL, mà thực tế backend chưa fill field này khi
          // discount áp qua chiết khấu quầy / cột khác) → finalTotal = subTotal (SAI, chưa trừ discount).
          // QR VietQR lấy pay_amount (BE canonical, đã trừ đúng) → chênh 173k.
          //
          // Chiến lược mới (Sapo-style): TIN backend là canonical.
          //   - TỔNG CỘNG = o.total_amount (BE) — số Sapo chốt, khớp QR.
          //   - Sanity guard bug nghìn tỷ: nếu total_amount phi lý (>10 tỷ hoặc >100× subTotal) → fallback recompute.
          //   - Nếu subTotal > TỔNG + shipFee mà o.discount_amount = 0 → tự INFER discount để in đủ dòng.
          var SANITY_MAX = 1e10; // 10 tỷ VNĐ — đơn hàng thực tế không vượt.
          var invalidNum = function(n) { return !isFinite(n) || n < 0 || n > SANITY_MAX; };
          var finalTotal;
          if (!invalidNum(totalBE) && totalBE > 0 && (subTotal === 0 || totalBE <= subTotal * 3)) {
            finalTotal = totalBE; // Trust backend (chấp nhận variance discount + shipping ≤ 3× subTotal).
          } else {
            finalTotal = Math.max(0, subTotal - discount + shipFee); // Fallback recompute chống bug BE.
          }
          // Auto-infer discount nếu BE chưa trả field (subTotal > finalTotal - shipFee = discount thực).
          if (discount === 0 && subTotal > 0 && (finalTotal - shipFee) < subTotal) {
            discount = Math.max(0, Math.round(subTotal - (finalTotal - shipFee)));
          }
          // Số phải thu QR = pay_amount BE (đã trừ deposit). Fallback = finalTotal - deposit.
          var payAmount = (!invalidNum(payAmountBE) && payAmountBE > 0)
            ? payAmountBE
            : Math.max(0, finalTotal - deposit);

          var isPaid = String(o.status || o.payment_status || '').toUpperCase() === 'PAID';
          var rawStatus = String(o.status || o.payment_status || 'PENDING').toUpperCase();
          var isBooking = o.order_type === 'booking' || o.order_type === 'deposit';
          var paymentMethod = String(o.payment_method || 'VIETQR').toUpperCase();

          // 2026-08-24 breakdown Sapo-style: "Giảm giá X%" (dòng chính) + lý do CK (dòng phụ italic).
          // Percent lấy từ o.discount_percent, fallback compute từ (discount / subTotal). Sanity 0.1-100%.
          var discountPercent = toNum(o.discount_percent);
          if (!discountPercent && discount > 0 && subTotal > 0) {
            var pctCalc = Math.round((discount / subTotal) * 1000) / 10; // 1 decimal
            if (pctCalc >= 0.1 && pctCalc <= 100) discountPercent = pctCalc;
          }
          var discountLabel = 'Giảm giá';
          if (discountPercent > 0) discountLabel += ' ' + discountPercent + '%';
          if (o.discount_code) discountLabel = 'Mã ' + o.discount_code + (discountPercent > 0 ? ' (' + discountPercent + '%)' : '');
          // Dòng phụ ghi lý do (VD "Áp giá Khách Sỉ theo hồ sơ") — chỉ hiện khi có o.order_discount_reason.
          var discountReason = String(o.order_discount_reason || '').trim();

          // Bằng chữ (Sapo standard). numberToVietnameseWords định nghĩa ở top file (line 20).
          var totalInWords = typeof numberToVietnameseWords === 'function'
            ? numberToVietnameseWords(finalTotal) : '';

          // QR VietQR — chỉ hiện khi chưa PAID và có url. Backend get_orders_batch loop getOrder trả qr_url.
          var qrBlock = (!isPaid && o.qr_url) ? (
            '<div class="pay-block">' +
              '<div class="pay-title">Thông tin thanh toán chuyển khoản</div>' +
              '<div class="pay-grid">' +
                '<div class="pay-qr"><img src="' + esc(o.qr_url) + '" alt="QR VietQR"></div>' +
                '<div class="pay-info">' +
                  '<div>Số tiền: <b>' + fmtVND(payAmount) + '</b></div>' +
                  '<div>Nội dung CK: <b>MOPS ' + esc(o.order_id) + '</b></div>' +
                  (o.transaction_ref ? '<div>Mã giao dịch: <span class="mono">' + esc(o.transaction_ref) + '</span></div>' : '') +
                  '<div class="pay-hint">Quét QR bằng app ngân hàng — nội dung tự điền. Đơn hàng sẽ được xác nhận sau khi bên bán đối chiếu.</div>' +
                '</div>' +
              '</div>' +
            '</div>'
          ) : '';

          // Ghi chú khối — customer_note + delivery_note (không internal_note).
          var deliveryNote = String(o.driver_note || o.delivery_note || '').trim();
          var notesBlock = (o.customer_note || deliveryNote) ? (
            '<div class="notes-block">' +
              (o.customer_note ? '<div class="note-line"><b>Ghi chú của khách:</b> ' + esc(o.customer_note) + '</div>' : '') +
              (deliveryNote ? '<div class="note-line"><b>Chỉ dẫn giao hàng:</b> ' + esc(deliveryNote) + '</div>' : '') +
            '</div>'
          ) : '';

          // Lịch hẹn (booking / deposit)
          var apptBlock = (isBooking && o.appointment_date) ? (
            '<div class="appt-block">' +
              '<b>Lịch hẹn:</b> ' + esc(o.appointment_date) +
              (o.appointment_time ? ' · ' + esc(o.appointment_time) : '') +
            '</div>'
          ) : '';

          return '' +
          '<div class="sheet ' + (isK80 ? 'sheet--k80' : 'sheet--a5') + '">' +

            // 1) Header shop
            '<div class="shop-hd">' +
              '<div class="shop-name">' + esc(storeName) + '</div>' +
              (storeAddress ? '<div class="shop-line">' + esc(storeAddress) + '</div>' : '') +
              '<div class="shop-line">' +
                (storePhone ? 'ĐT: ' + esc(storePhone) : '') +
                (storeEmail ? (storePhone ? ' · ' : '') + 'Email: ' + esc(storeEmail) : '') +
              '</div>' +
            '</div>' +

            // 2) Title + mã đơn
            '<div class="doc-title">HOÁ ĐƠN BÁN HÀNG</div>' +
            '<div class="doc-oid">Số: <b>' + esc(o.order_id) + '</b>' +
              (o.sapo_order_id ? ' · SAPO: <span class="mono">' + esc(o.sapo_order_id) + '</span>' : '') +
            '</div>' +

            // 3) Meta grid
            '<div class="meta-grid">' +
              '<div><span class="mk">Ngày lập:</span> ' + esc(fmtDT(o.created_at)) + '</div>' +
              (o.created_by ? '<div><span class="mk">Nhân viên:</span> ' + esc(o.created_by) + '</div>' : '') +
              (o.store ? '<div><span class="mk">Chi nhánh:</span> ' + esc(o.store) + '</div>' : '') +
              '<div><span class="mk">Thanh toán:</span> ' + esc(payMethodLabel[paymentMethod] || paymentMethod) + '</div>' +
              '<div><span class="mk">Trạng thái:</span> <b class="stt stt--' + rawStatus.toLowerCase() + '">' + esc(statusLabel[rawStatus] || rawStatus) + '</b></div>' +
            '</div>' +

            // 4) Khách hàng
            '<div class="party-grid">' +
              '<div class="party">' +
                '<div class="party-title">Khách hàng</div>' +
                '<div><b>' + esc(o.customer_name || '—') + '</b>' +
                  (o.customer_id ? ' <span class="cid">(' + esc(o.customer_id) + ')</span>' : '') +
                '</div>' +
                (o.customer_phone ? '<div>SĐT: <span class="mono">' + esc(o.customer_phone) + '</span></div>' : '') +
              '</div>' +
            '</div>' +

            // 5) Lịch hẹn
            apptBlock +

            // 6) Bảng items
            '<table class="items">' +
              '<thead><tr>' +
                '<th class="c-idx">STT</th>' +
                (isK80 ? '' : '<th class="c-sku">Mã SKU</th>') +
                '<th class="c-name">Sản phẩm</th>' +
                '<th class="c-qty">SL</th>' +
                '<th class="c-price">Đơn giá</th>' +
                (isK80 ? '' : '<th class="c-disc">Giảm</th>') +
                '<th class="c-total">Thành tiền</th>' +
              '</tr></thead>' +
              '<tbody>' + itemsRows + '</tbody>' +
            '</table>' +

            // 7) Tổng thanh toán
            '<div class="totals">' +
              '<div class="tot-row"><span>Tạm tính</span><b>' + fmtVND(subTotal) + '</b></div>' +
              (discount > 0 ? (
                '<div class="tot-row tot-neg"><span>' + esc(discountLabel) + '</span><b>-' + fmtVND(discount) + '</b></div>' +
                (discountReason ? '<div class="tot-reason">' + esc(discountReason) + '</div>' : '')
              ) : '') +
              (shipFee > 0 ? '<div class="tot-row"><span>Phí vận chuyển</span><b>' + fmtVND(shipFee) + '</b></div>' : '') +
              '<div class="tot-row tot-final"><span>TỔNG CỘNG</span><b>' + fmtVND(finalTotal) + '</b>' +
                (isPaid ? ' <span class="paid-badge">ĐÃ THANH TOÁN</span>' : '') +
              '</div>' +
              (totalInWords ? '<div class="tot-words"><i>Bằng chữ: ' + esc(totalInWords) + '</i></div>' : '') +
              (deposit > 0 ? '<div class="tot-row tot-sub"><span>Đã đặt cọc</span><b>' + fmtVND(deposit) + '</b></div>' : '') +
              (deposit > 0 && !isPaid ? '<div class="tot-row tot-owe"><span>Còn phải trả</span><b>' + fmtVND(payAmount) + '</b></div>' : '') +
            '</div>' +

            // 8) QR VietQR (chưa PAID)
            qrBlock +

            // 9) Ghi chú
            notesBlock +

            '<div class="ft">Cảm ơn quý khách! · Hotline: ' + esc(storePhone || '') +
              (storeEmail ? ' · ' + esc(storeEmail) : '') + '</div>' +

          '</div>';
        }).join('');

        return [
          '<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8">',
          '<title>Hoá đơn · ' + orders.length + ' đơn</title>',
          '<style>',
          '@page { size: ' + pageSize + '; margin: ' + (isK80 ? '3mm' : '8mm') + '; }',
          'html, body { margin: 0; padding: 0; font-family: Montserrat, sans-serif; color: #111; font-size: ' + (isK80 ? '9pt' : '10pt') + '; line-height: 1.4; }',
          '.sheet { page-break-after: always; padding: 0; }',
          '.sheet:last-child { page-break-after: auto; }',
          // Shop header
          '.shop-hd { text-align: center; border-bottom: 2px solid #111; padding-bottom: 2mm; margin-bottom: 2mm; }',
          '.shop-name { font-size: ' + (isK80 ? '13pt' : '15pt') + '; font-weight: 900; letter-spacing: 0.5px; }',
          '.shop-line { font-size: ' + (isK80 ? '8pt' : '9pt') + '; color: #444; margin-top: 0.5mm; }',
          // Title
          '.doc-title { text-align: center; font-size: ' + (isK80 ? '11pt' : '13pt') + '; font-weight: 800; letter-spacing: 1.5px; margin: 2mm 0 0.5mm; text-transform: uppercase; }',
          '.doc-oid { text-align: center; font-size: 10pt; margin-bottom: 2.5mm; }',
          '.mono { font-family: Montserrat, sans-serif; font-weight: 600; }',
          // Meta grid
          '.meta-grid { display: grid; grid-template-columns: ' + (isK80 ? '1fr' : 'repeat(2, 1fr)') + '; gap: 0.5mm 4mm; font-size: 9pt; padding: 1.5mm 0; border-top: 1px dashed #999; border-bottom: 1px dashed #999; margin-bottom: 2mm; }',
          '.mk { color: #666; }',
          '.stt { font-weight: 700; }',
          '.stt--paid { color: #059669; }',
          '.stt--pending, .stt--payment_reported { color: #d97706; }',
          '.stt--cancelled, .stt--refunded, .stt--expired { color: #dc2626; }',
          // Party grid
          '.party-grid { display: grid; grid-template-columns: 1fr; gap: 2mm; font-size: 9.5pt; margin-bottom: 2mm; }',
          '.party-title { font-size: 8pt; text-transform: uppercase; color: #666; letter-spacing: 0.5px; margin-bottom: 0.5mm; font-weight: 700; }',
          '.party .cid { color: #999; font-size: 8.5pt; }',
          // Appointment
          '.appt-block { font-size: 9.5pt; padding: 1mm 2mm; background: #EFF6FF; border-left: 3px solid #2563EB; margin-bottom: 2mm; }',
          // Items table
          'table.items { width: 100%; border-collapse: collapse; margin: 2mm 0 3mm; font-size: 9pt; }',
          'table.items th, table.items td { border-bottom: 1px solid #ccc; padding: 1.5mm 2mm; text-align: left; }',
          'table.items th { background: #f5f5f5; font-weight: 700; text-transform: uppercase; font-size: 8pt; letter-spacing: 0.3px; border-bottom: 2px solid #111; }',
          'table.items .var { color: #666; font-size: 8pt; font-style: italic; }',
          '.c-idx { width: 8mm; text-align: right; color: #666; }',
          '.c-sku { width: 22mm; font-family: monospace; font-size: 8pt; color: #444; }',
          '.c-name { min-width: ' + (isK80 ? '30mm' : '55mm') + '; }',
          '.c-qty { width: 12mm; text-align: right; font-weight: 700; }',
          '.c-price { width: 22mm; text-align: right; }',
          '.c-disc { width: 20mm; text-align: right; color: #dc2626; font-size: 8.5pt; }',
          '.c-total { width: 24mm; text-align: right; font-weight: 700; }',
          // Totals
          '.totals { margin: 2mm 0 3mm; }',
          '.tot-row { display: flex; justify-content: space-between; padding: 0.8mm 0; font-size: 10pt; }',
          '.tot-row span { color: #444; }',
          '.tot-neg b { color: #dc2626; }',
          '.tot-reason { font-size: 8.5pt; color: #6b7280; font-style: italic; margin-top: -0.5mm; margin-bottom: 1mm; padding-left: 2mm; }',
          '.tot-sub { color: #666; font-size: 9.5pt; }',
          '.tot-final { border-top: 2px solid #111; margin-top: 1mm; padding-top: 2mm; font-size: 12pt; }',
          '.tot-final span { font-weight: 700; color: #111; }',
          '.tot-final b { font-size: 13pt; }',
          '.tot-owe b { color: #dc2626; }',
          '.tot-words { text-align: right; font-size: 9pt; color: #555; margin-top: 1mm; }',
          '.paid-badge { display: inline-block; background: #059669; color: #fff; padding: 0.5mm 2.5mm; border-radius: 1mm; font-size: 9pt; font-weight: 700; margin-left: 3mm; letter-spacing: 0.5px; }',
          // Payment block (QR)
          '.pay-block { border: 1px solid #111; padding: 2mm 3mm; margin: 2.5mm 0; }',
          '.pay-title { font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1.5mm; border-bottom: 1px solid #ccc; padding-bottom: 1mm; }',
          '.pay-grid { display: grid; grid-template-columns: ' + (isK80 ? '1fr' : '40mm 1fr') + '; gap: 2.5mm; align-items: center; }',
          '.pay-qr { text-align: center; }',
          '.pay-qr img { width: ' + (isK80 ? '35mm' : '38mm') + '; height: ' + (isK80 ? '35mm' : '38mm') + '; border: 1px solid #ccc; }',
          '.pay-info { font-size: 9.5pt; }',
          '.pay-info > div { margin: 0.5mm 0; }',
          '.pay-hint { color: #666; font-size: 8.5pt; margin-top: 1.5mm; line-height: 1.35; }',
          // Notes
          '.notes-block { margin: 2mm 0; padding: 1.5mm 2.5mm; background: #FFFBEB; border-left: 3px solid #f59e0b; font-size: 9pt; }',
          '.notes-block .note-line { margin: 0.5mm 0; }',
          // Footer
          '.ft { margin-top: 3mm; text-align: center; font-size: 8pt; color: #777; border-top: 1px dashed #999; padding-top: 1.5mm; }',
          '@media print { .no-print { display: none; } }',
          '</style></head><body>',
          sheets,
          '</body></html>'
        ].join('');
      },
      toggleOrderDetail: function(orderId, forceOpen) {
        var self = this;
        var core = window.MopsAdminCore;
        if (this.orders.expandedId === orderId && !forceOpen) { this.closeOrderDetail(); return; }
        // Snapshot từ list render ngay vào detail view. GAS get_order chỉ enrich những vùng
        // chưa có (items, timeline, payment, shipping...), không được tạo màn hình trắng.
        var snapshot = (this.orders.list || []).filter(function(order) {
          return order && order.order_id === orderId;
        })[0];
        var snapshotData = snapshot || { order_id: orderId };
        var cached = this.orders.detailStore[orderId];
        var cachedDetail = cached && cached.data;
        if (this.workspaceView !== 'orders.detail' && typeof this.openWorkspaceView === 'function') {
          this.openWorkspaceView('orders.detail', { orderId: orderId });
        } else {
          this.workspaceView = 'orders.detail';
        }
        this.orders.expandedId = orderId;
        this._updateUrlParam('action', 'view');
        this._updateUrlParam('order_id', orderId);
        // Merge đúng thứ tự Constitution: row Snapshot -> Client Store. Không lấy cache là
        // nguồn duy nhất vì row list vừa thấy có thể phản ánh trạng thái mới hơn.
        this.orders.detail = Object.assign({}, snapshotData, cachedDetail || {});
        if (this.orders.detail.total_amount == null) this.orders.detail.total_amount = snapshotData.amount;
        if (!this.orders.detail.payment_status) this.orders.detail.payment_status = snapshotData.status;
        this.orders.detail.__snapshot = !cachedDetail;
        if (!snapshot) {
          this.orders.detail.order_id = orderId;
          this.orders.detail.__snapshot = !cachedDetail;
        }
        this.orders.detailLoading = true;
        core.gasGet({ action: 'get_order', order_id: orderId })
          .then(function(d) {
            if (self.orders.expandedId !== orderId) return;
            self.orders.detailLoading = false;
            if (d && d.success && d.order_id) {
              self.orders.detailStore[orderId] = { data: d, loadedAt: Date.now() };
              self.orders.detail = d;
            }
          })
          .catch(function() {
            // Giữ snapshot/list trên màn hình khi get_order lỗi; không reset detail/workspace,
            // vì lỗi dữ liệu phụ trợ không được phép biến tab Đơn hàng thành màn hình trắng.
            if (self.orders.expandedId === orderId) {
              self.orders.detailLoading = false;
              self.orders.error = 'Không tải thêm được chi tiết đơn; đang hiển thị dữ liệu đã có.';
            }
          });
      },
      /* ── Fulfillment pipeline (phase vận chuyển 2026-07-17) ── */
      closeOrderDetail: function() {
        this.orders.expandedId = null;
        this.orders.detail = null;
        this.orders.detailLoading = false;
        if (typeof this.restoreWorkspaceView === 'function') this.restoreWorkspaceView('orders.list');
        else this.workspaceView = 'orders.list';
        this._updateUrlParam('action', '');
        this._updateUrlParam('order_id', '');
      },
      applyOrderSavedFilter: function(key) {
        var o = this.orders;
        o.status = ''; o.fulfillment = ''; o.paymentMethod = ''; o.from = ''; o.to = '';
        if (key === 'pending') o.status = 'PENDING';
        if (key === 'cod') o.paymentMethod = 'COD';
        if (key === 'overdue') { o.from = new Date(Date.now() - 4 * 86400000).toISOString().slice(0, 10); o.to = new Date(Date.now() - 86400000).toISOString().slice(0, 10); }
        this.loadOrders();
      },
      // Xoá toàn bộ filter đang active (thay chuỗi inline dài ở snippet). Reset đủ 7 field để đồng bộ
      // với ordersFilterCount — nếu chừa lại branchId, badge count vẫn còn > 0 sau khi bấm "Xoá".
      clearOrderFilters: function() {
        var o = this.orders;
        o.status = ''; o.fulfillment = ''; o.paymentMethod = ''; o.branchId = '';
        o.from = ''; o.to = ''; o.orderId = '';
        this.loadOrders();
      },
      fulfillmentLabel: function(slug) {
        // 'pending_payment' đổi 'Chờ thanh toán' → 'Chờ khách chuyển khoản' (2026-08-08) để không
        // trùng nghĩa với badge Payment Status 'Chờ xác nhận' và làm rõ đây CHỈ áp cho đơn VIETQR
        // (đơn COD/CASH bỏ qua bước này, vào thẳng pending_packing).
        return ({ pending_approval:'Chờ duyệt', pending_payment:'Chờ khách chuyển khoản', pending_packing:'Chờ đóng gói',
          ready_to_pick:'Chờ lấy hàng', delivering:'Đang giao hàng', redelivery:'Chờ giao lại', delivered:'Đã giao',
          delivery_cancelled:'Hủy giao - chờ nhận', returned:'Đã hoàn trả', cancelled:'Đã hủy' })[slug] || slug || '—';
      },
      // Trả về CHUỖI class semantic .ma-badge + variant (2026-07-28). Đổi từ Tailwind combo raw sang
      // ma-badge system — 1 nguồn sự thật ở Layouts/mops-admin.bwt CSS. Template chỉ cần
      // :class="fulfillmentBadgeClass(...)" là ăn theo hệ badge chung toàn app.
      fulfillmentBadgeClass: function(slug) {
        var success = ['delivered'];
        var danger  = ['cancelled','returned'];
        var warning = ['pending_approval','pending_payment','redelivery','delivery_cancelled'];
        // pending_packing/ready_to_pick/delivering → info (đang xử lý)
        if (success.indexOf(slug) !== -1) return 'ma-badge ma-badge--success';
        if (danger.indexOf(slug)  !== -1) return 'ma-badge ma-badge--danger';
        if (warning.indexOf(slug) !== -1) return 'ma-badge ma-badge--warning';
        return 'ma-badge ma-badge--info';
      },
      // Badge cho trạng thái ĐƠN HÀNG tổng (Orders.PaymentStatus). Dùng ở Orders list + Overview
      // gần đây. Tách khỏi fulfillmentBadgeClass vì semantic khác (đây là trạng thái thu tiền +
      // vòng đời đơn, không phải trạng thái giao hàng).
      orderStatusBadgeClass: function(status) {
        var s = String(status || '').toUpperCase();
        if (s === 'PAID' || s === 'COMPLETED') return 'ma-badge ma-badge--success';
        if (s === 'CANCELLED' || s === 'EXPIRED') return 'ma-badge ma-badge--danger';
        if (s === 'REFUNDED') return 'ma-badge ma-badge--accent';
        if (s === 'PAYMENT_REPORTED') return 'ma-badge ma-badge--warning';
        if (s === 'PROCESSING') return 'ma-badge ma-badge--info';
        return 'ma-badge ma-badge--neutral'; // PENDING / unknown
      },
      // Badge cho phương thức thanh toán (Payments.Method). Không phải status — là loại. Neutral
      // để không tranh chỗ visual với status badge kế bên; tint theo loại giúp scan nhanh.
      paymentMethodBadgeClass: function(method) {
        var m = String(method || '').toUpperCase();
        if (m === 'VIETQR') return 'ma-badge ma-badge--info';       // VIETQR = trả trước, tint xanh
        if (m === 'COD')    return 'ma-badge ma-badge--warning';    // COD = thu hộ, tint vàng (chờ đối soát)
        if (m === 'CASH')   return 'ma-badge ma-badge--success';    // CASH = đã thu tiền mặt tại quầy
        return 'ma-badge ma-badge--neutral';
      },
      setFulfillmentFilter: function(slug) {
        this.orders.fulfillment = (this.orders.fulfillment === slug) ? '' : slug;
        this.loadOrders();
      },
      // Nút chuyển trạng thái theo đơn (order = detail object). Carrier-agnostic: "Tạo vận đơn" mở
      // modal chọn đối tác (GHN/tự giao/…) thay vì hardcode GHN. Nút refresh/huỷ vận đơn TỰ ĐỘNG chỉ
      // hiện cho đơn giao qua hãng có API (hiện: GHN) — đơn "tự giao" chỉ có nút chuyển bước thủ công.
      fulfillmentActions: function(order) {
        var cur = (order && order.fulfillment_status) || '';
        var hasTracking = !!(order && order.tracking_code);
        // Hãng có tracking tự động (API) — thêm hãng mới thì bổ sung vào danh sách này. Hãng thủ công
        // (Tự giao / Shopee Express) không có nút refresh/cancel API, chỉ chuyển bước tay.
        // Goship ghi Carrier dạng 'GOSHIP · <hãng thật>' → cắt phần trước ' · ' trước khi so mã (giống
        // _shipNormCarrier ở backend), nếu không đơn Goship sẽ mất nút Cập nhật/Huỷ vận đơn.
        var carrierCode = String((order && order.carrier) || '').split('·')[0].trim().toUpperCase();
        var apiCarrier = ['GOSHIP', 'GHN', 'AHAMOVE', 'GHTK', 'VIETTELPOST'].indexOf(carrierCode) !== -1;
        var acts = [];
        if (cur === 'pending_approval') {
          acts.push({ type: 'approve', label: 'Duyệt đơn', icon: 'task_alt' });
        } else if (cur === 'pending_packing') {
          // 1 nút duy nhất — đóng gói + chọn đối tác + xem phí gộp trong modal (đúng quy trình sàn TMĐT).
          acts.push({ type: 'create_ship', label: 'Tạo vận đơn', icon: 'local_shipping' });
        } else if (cur === 'ready_to_pick') {
          if (apiCarrier) acts.push({ type: 'refresh', label: 'Cập nhật trạng thái giao', icon: 'sync' });
          // Chỉ hiển thị khi (a) hãng có API + (b) đã có tracking + (c) đang ở 'ready_to_pick'.
          // Sang 'delivering' trở lên → không đẩy nút này (ĐVVC đã nhận hàng, huỷ mã bên hãng không
          // rollback được nữa). Tên nút phải là "Huỷ đóng gói" — không phải "Huỷ vận đơn" — để nhân
          // viên không nhầm với "Huỷ đơn" (huỷ hẳn đơn bán hàng, nghiệp vụ khác).
          if (apiCarrier && hasTracking) acts.push({ type: 'cancel_ship', label: 'Huỷ đóng gói', icon: 'undo', tone: 'warning' });
          acts.push({ type: 'advance', to: 'delivering', label: 'Đã lấy hàng → Đang giao', icon: 'arrow_forward', minor: true });
        } else if (cur === 'delivering') {
          if (apiCarrier) acts.push({ type: 'refresh', label: 'Cập nhật trạng thái giao', icon: 'sync' });
          acts.push({ type: 'advance', to: 'delivered', label: 'Đã giao thành công', icon: 'check_circle', minor: true });
          acts.push({ type: 'advance', to: 'redelivery', label: 'Giao hụt → Chờ giao lại', icon: 'replay', minor: true });
        } else if (cur === 'redelivery') {
          if (apiCarrier) acts.push({ type: 'refresh', label: 'Cập nhật trạng thái giao', icon: 'sync' });
          acts.push({ type: 'advance', to: 'delivering', label: 'Giao lại → Đang giao', icon: 'local_shipping', minor: true });
          acts.push({ type: 'advance', to: 'delivery_cancelled', label: 'Chuyển hoàn hàng', icon: 'assignment_return', minor: true });
        } else if (cur === 'delivery_cancelled') {
          acts.push({ type: 'advance', to: 'returned', label: 'Đã nhận hàng hoàn', icon: 'assignment_return' });
        }
        return acts;
      },
      doFulfillmentAction: function(orderId, act) {
        var self = this;
        var core = window.MopsAdminCore;
        // "Tạo vận đơn" mở modal chọn đối tác (không gọi API ngay, không confirm() — thao tác nằm trong modal).
        if (act.type === 'create_ship') { this.openShipModal(this.orders.detail); return; }
        if (this.orders.actionBusy) return; // chặn double-click khi đang gọi API
        // "Huỷ đóng gói" là action ngược chiều state machine + có tác động API bên ngoài (thu hồi mã
        // vận đơn ở ĐVVC) → phải confirm bằng showConfirm() có tiêu đề/mô tả rõ ràng, không dùng
        // browser confirm() cụt như các action còn lại. Các action khác giữ confirm() cũ để không đổi
        // hành vi chỗ khác.
        var confirmPromise;
        if (act.type === 'cancel_ship') {
          var carrierName = String((self.orders.detail && self.orders.detail.carrier) || 'ĐVVC').split('·')[0].trim();
          var trackingCode = (self.orders.detail && self.orders.detail.tracking_code) || '';
          confirmPromise = core.showConfirm(
            'Huỷ đóng gói · thu hồi mã vận đơn?',
            'Đơn ' + orderId + ' sẽ gửi yêu cầu huỷ mã ' + (trackingCode ? trackingCode + ' ' : '') +
            'sang ' + carrierName + ' và mở khoá lại địa chỉ / SĐT khách / danh sách sản phẩm để chỉnh sửa. ' +
            'Đây KHÔNG phải "Huỷ đơn" — đơn bán vẫn còn, chỉ thu hồi lần đẩy vận đơn này.'
          );
        } else {
          confirmPromise = Promise.resolve(confirm('Xác nhận: ' + act.label + ' cho đơn ' + orderId + '?'));
        }
        confirmPromise.then(function(ok) {
          if (!ok) return;
          self.orders.actionBusy = act.type + (act.to || ''); // nút tương ứng hiện spinner + khoá
          var body;
          if (act.type === 'approve')          body = { action: 'approve_order', order_id: orderId };
          else if (act.type === 'cancel_ship') body = { action: 'cancel_shipment', order_id: orderId };
          else if (act.type === 'refresh')     body = { action: 'refresh_tracking', order_id: orderId };
          else                                 body = { action: 'update_fulfillment_status', order_id: orderId, fulfillment_status: act.to };
          core.gasPost(body)
            .then(function(d) {
              self.orders.actionBusy = '';
              if (d && d.success) {
                var msg = 'Đã cập nhật đơn ' + orderId;
                if (act.type === 'refresh') msg = 'Trạng thái giao: ' + self.fulfillmentLabel(d.fulfillment_status || (self.orders.detail && self.orders.detail.fulfillment_status));
                else if (act.type === 'cancel_ship') msg = 'Đã huỷ đóng gói · đơn ' + orderId + ' mở lại để chỉnh sửa';
                core.showToast(msg, 'success');
                // Patch state ngay từ response write. cancel_ship trả thêm nhiều field (package_*,
                // service_id, cod_amount) vì unpack xoá cả gói dữ liệu vận đơn — patch đủ để card
                // "Vận chuyển" clear ngay không cần đợi get_order round-trip.
                var nextFul = d.fulfillment_status || (act.type === 'advance' ? act.to : '');
                var patch = {};
                if (nextFul) patch.fulfillment_status = nextFul;
                if (d.tracking_code != null) patch.tracking_code = d.tracking_code;
                if (d.carrier != null) patch.carrier = d.carrier;
                if (d.shipping_fee != null) patch.shipping_fee = d.shipping_fee;
                if (act.type === 'cancel_ship') {
                  patch.package_weight = d.package_weight != null ? d.package_weight : 0;
                  patch.package_dims = d.package_dims != null ? d.package_dims : '';
                  patch.service_id = d.service_id != null ? d.service_id : '';
                  patch.cod_amount = d.cod_amount != null ? d.cod_amount : 0;
                }
                if (Object.keys(patch).length) {
                  patch.__optimistic = true;
                  if (self.orders.detail && self.orders.detail.order_id === orderId) {
                    self.orders.detail = Object.assign({}, self.orders.detail, patch);
                    self.orders.detailStore[orderId] = { data: self.orders.detail, loadedAt: Date.now(), optimistic: true };
                  }
                  self.orders.list = (self.orders.list || []).map(function(row) {
                    return row && row.order_id === orderId ? Object.assign({}, row, patch) : row;
                  });
                }
                // cancel_ship: kéo lại get_order để activity_logs có dòng "Huỷ đóng gói · thu hồi mã
                // …" mới sinh — patch tối giản không đủ (activity_logs cần fetch từ server).
                if (act.type === 'cancel_ship') {
                  core.gasGet({ action: 'get_order', order_id: orderId })
                    .then(function(fresh) {
                      if (self.orders.expandedId !== orderId) return;
                      if (fresh && fresh.success && fresh.order_id) {
                        self.orders.detailStore[orderId] = { data: fresh, loadedAt: Date.now() };
                        self.orders.detail = fresh;
                      }
                    })
                    .catch(function() { /* silent — patch đã cập nhật đủ state critical */ });
                }
                setTimeout(function() { self.loadOrders(); }, 800);
              } else {
                core.showToast('Lỗi: ' + (d && d.error || 'Không thực hiện được'), 'error');
              }
            })
            .catch(function() { self.orders.actionBusy = ''; core.showToast('Lỗi kết nối khi thao tác vận chuyển.', 'error'); });
        });
      },
      /* ── Modal Tạo vận đơn (carrier-agnostic) ──────────────────────────────────────────────
         Luồng chuẩn sàn TMĐT: đóng gói (checkbox xác nhận) → chọn đối tác → xem phí → tạo vận đơn.
         GHN (hãng có API): gọi create_shipment → nhận tracking + phí. Tự giao/hãng khác (SELF): ghi
         tay carrier + mã vận đơn (nếu có), không gọi API. Backend dispatcher shipmentCreate định tuyến. */
      openShipModal: function(order) {
        if (!order) return;
        // V6.3 2026-08-05: auto-resolve pickBranchId theo thứ tự ưu tiên (không phụ thuộc user chọn):
        //   1) order.branch_id nếu chi nhánh đó nằm trong shipPickBranchOptions (active + có pick_address)
        //   2) chi nhánh is_default trong shipPickBranchOptions
        //   3) option đầu tiên (chi nhánh khả dụng bất kỳ)
        //   4) rỗng — dropdown sẽ tự bung do !shipPickBranchCurrent (edge case: chưa cấu hình chi nhánh nào)
        var pickOpts = this.shipPickBranchOptions;
        var resolvedPickId = '';
        if (order.branch_id && pickOpts.filter(function(o) { return o.branch_id === order.branch_id; })[0]) {
          resolvedPickId = order.branch_id;
        } else {
          var def = pickOpts.filter(function(o) { return o.is_default; })[0];
          if (def) resolvedPickId = def.branch_id;
          else if (pickOpts.length) resolvedPickId = pickOpts[0].branch_id;
        }
        this.shipModal = {
          show: true, order: order, carriers: [], loading: true, detailLoading: false,
          carrier: '', serviceTypeId: '2', requiredNote: 'CHOXEMHANGKHONGTHU',
          // V6.1 2026-08-04: 3 trường giao hàng chuẩn Sapo/GHN — cod tự điền từ đơn (số tiền còn
          // thiếu), staff sửa được; delivery_note cho tài xế; requiredNote select 3 mức.
          codAmount: 0, deliveryNote: '',
          packedConfirmed: true, fee: null, feeLoading: false, feeError: '',
          selfCarrierName: 'Tự giao', manualTracking: '', manualFee: '', submitting: '',
          // Goship (aggregator): `rates` là danh sách chào giá nhiều hãng, `rateId` là hãng nhân viên chọn.
          // Bảng này chính là giá trị của Goship — không có nó thì aggregator chỉ như 1 hãng bịt mắt.
          rates: [], rateId: '', rateSort: 'fee', rateCarrier: '', // rateCarrier = '' → hiện tất cả hãng
          // Bước ĐÓNG GÓI: số cân/kích thước THỰC. Rỗng → hệ thống suy từ khối lượng sản phẩm (như trước).
          // Nhập vào thì mọi hãng đều tính cước theo số này → hết cảnh phí chào lệch phí hãng thu.
          // Cân thực/kích thước đã lưu luôn được ưu tiên. Nếu chưa có, dùng tổng trọng lượng sản phẩm
          // và quy chuẩn kích thước đã cấu hình để nhân viên thấy chính xác dữ liệu hệ thống đang dùng.
          packageWeight: (order.package_weight || order.package_weight_suggested || '') || '',
          packageDims: order.package_dims || order.package_dims_suggested || '',
          // V6.4 2026-08-05: default = TỔNG BILL (không phải "còn thiếu"). Lý do: shipper cần biết
          // tổng tiền phải thu để đối soát; đơn VietQR đã trả trước vẫn thường yêu cầu shipper
          // XÁC MINH lại tiền — nếu KH đã trả, staff manual chỉnh COD về 0. Đơn COD sẵn có > 0 dùng
          // luôn. Cách này khớp Sapo POS reference (bill amount, staff quyết định COD thực).
          codAmount: Number(order.cod_amount) || Number(order.total_amount) || 0,
          // 2026-08-23: fallback prefill từ setting mops_shipping_note_default (Group 19) khi đơn chưa có
          // driver_note/delivery_note. Setting này là mẫu chuẩn shop (VD "CHO XEM HÀNG - KHÔNG CHO THỬ;
          // ĐỒNG KIỂM"), staff sửa được per-đơn trong shipModal. Liquid resolve tại thời điểm render theme.
          deliveryNote: order.driver_note || order.delivery_note || {{ settings.mops_shipping_note_default | default: '' | json }},
          // V6.3 pickBranchId auto-resolved ở trên (order.branch_id → default → first option).
          pickBranchId: resolvedPickId,
          // Ẩn dropdown chọn kho mặc định (2026-08-05) — user chỉ thấy địa chỉ auto-resolved từ
          // chi nhánh của đơn. Bấm "Đổi kho khác" mới mở dropdown (edge case, không phải luồng chính).
          showBranchPicker: false,
          ghtkPickAddresses: [], ghtkPickAddressesLoading: false, ghtkPickAddressId: '',
          ghtkPickName: '', ghtkPickTel: '', ghtkPickAddress: '', ghtkPickProvince: '', ghtkPickDistrict: '', ghtkPickWard: '',
          ghtkProvinces: [], ghtkDistricts: [], ghtkLocationLoading: false, ghtkPickSource: 'auto',
          // V6 2026-08-04: inline address editor state — reset về closed khi mở modal mới.
          addrEdit: {
            open: false, saving: false, error: '',
            receiverName: '', phone: '', address: '',
            provinceCode: '', provinceName: '',
            districtCode: '', districtName: '',
            wardCode: '', wardName: ''
          }
        };
        this.loadShipCarriers();
      },
      closeShipModal: function() { this.shipModal.show = false; },
      // Row action "Tạo vận đơn" bấm từ danh sách. Mở modal NGAY LẬP TỨC với data đang có ở row
      // (customer_name/phone/address/amount/total_quantity/order_id) + `shipModal.detailLoading=true`
      // để banner "đang tải chi tiết" hiện đầu modal. get_order fetch song song; xong → merge lên
      // shipModal.order qua mergeShipModalDetail(). Người dùng thấy khung modal ngay, không phải
      // đợi round-trip GAS (~1-3s) mới có phản hồi. Nếu detailStore đã cache → merge sync, không banner.
      openShipModalFromRow: function(tx) {
        if (!tx || tx.__pending) return;
        var self = this;
        var core = window.MopsAdminCore;
        var rowLike = Object.assign({}, tx, {
          total_amount: tx.amount || tx.total_amount || 0
        });
        self.openShipModal(rowLike);
        var cached = self.orders.detailStore[tx.order_id];
        if (cached && cached.data) {
          self.shipModal.detailLoading = false;
          self.mergeShipModalDetail(cached.data);
          return;
        }
        self.shipModal.detailLoading = true;
        core.gasGet({ action: 'get_order', order_id: tx.order_id })
          .then(function(d) {
            if (!self.shipModal.show || String(self.shipModal.order && self.shipModal.order.order_id || '') !== String(tx.order_id)) return;
            if (d && d.success && d.order_id) {
              self.orders.detailStore[tx.order_id] = { data: d, loadedAt: Date.now() };
              self.mergeShipModalDetail(d);
            } else {
              self.shipModal.detailLoading = false;
              core.showToast && core.showToast('Không tải thêm được chi tiết đơn — modal đang dùng dữ liệu hiển thị.', 'warning');
            }
          })
          .catch(function() {
            if (self.shipModal.show) self.shipModal.detailLoading = false;
            core.showToast && core.showToast('Không tải thêm được chi tiết đơn — modal đang dùng dữ liệu hiển thị.', 'warning');
          });
      },
      // Merge full get_order payload vào shipModal.order đang mở. Chỉ set các trường form nếu user
      // chưa động vào (packageWeight/deliveryNote/codAmount) — tránh ghi đè input đang gõ dở khi
      // detail về muộn.
      mergeShipModalDetail: function(fullOrder) {
        if (!this.shipModal.show || !fullOrder) return;
        var current = this.shipModal.order || {};
        if (String(current.order_id || '') !== String(fullOrder.order_id || '')) return;
        this.shipModal.order = Object.assign({}, current, fullOrder);
        if (!this.shipModal.packageWeight) {
          this.shipModal.packageWeight = fullOrder.package_weight || fullOrder.package_weight_suggested || '';
        }
        if (!this.shipModal.packageDims) {
          this.shipModal.packageDims = fullOrder.package_dims || fullOrder.package_dims_suggested || '';
        }
        if (!this.shipModal.deliveryNote) {
          this.shipModal.deliveryNote = fullOrder.driver_note || fullOrder.delivery_note || '';
        }
        // codAmount: chỉ cập nhật nếu row optimistic đã set = 0 (không có amount) hoặc user chưa sửa
        // (dấu hiệu: bằng row.amount). Không so bằng bằng nhau vì floats → so tuyệt đối.
        if (!this.shipModal.codAmount) {
          this.shipModal.codAmount = Number(fullOrder.cod_amount) || Number(fullOrder.total_amount) || 0;
        }
        this.shipModal.detailLoading = false;
      },
      // Đơn có đủ mã địa chỉ của hãng (GHN: district_id + ward_code) mới tạo/tính phí vận đơn API được.
      shipOrderGhnCapable: function() {
        var a = this.shipModal.order && this.shipModal.order.shipping_address;
        return !!(a && a.district_id && a.ward_code);
      },
      // Ahamove geocode theo CHUỖI địa chỉ (không cần mã Quận/Xã) → chỉ cần đơn có địa chỉ giao.
      shipOrderAhamoveCapable: function() {
        var a = this.shipModal.order && this.shipModal.order.shipping_address;
        return !!(a && (a.address || a.district || a.province));
      },
      // GHTK/VTP dùng TÊN tỉnh/quận (VTP tự dò ra ID) → cần đơn có tên Tỉnh + Quận.
      shipOrderNameAddrCapable: function() {
        var a = this.shipModal.order && this.shipModal.order.shipping_address;
        return !!(a && a.province && a.district);
      },
      // Mã hãng có adapter API (khác hãng thủ công SELF/SPX).
      shipCarrierApiCode: function(code) { return ['GOSHIP', 'GHN', 'AHAMOVE', 'GHTK', 'VIETTELPOST'].indexOf(code) !== -1; },
      // Điều kiện địa chỉ theo từng hãng API. Hãng chưa có adapter → false (tạm khoá).
      shipCarrierCapable: function(code) {
        if (code === 'GOSHIP')  return this.shipOrderNameAddrCapable(); // Goship tự dò TÊN Tỉnh/Quận → mã riêng
        if (code === 'GHN')     return this.shipOrderGhnCapable();
        if (code === 'AHAMOVE') return this.shipOrderAhamoveCapable();
        if (code === 'GHTK' || code === 'VIETTELPOST') return this.shipOrderNameAddrCapable();
        return false;
      },
      // Hãng đi luồng THỦ CONG (nhập mã vận đơn tay): SELF hoặc hãng Category='MANUAL' (vd SPX Shopee Express).
      shipModalIsManual: function() {
        if (this.shipModal.carrier === 'SELF') return true;
        var c = (this.shipModal.carriers || []).filter(function(x) { return x.carrier_code === this.shipModal.carrier; }.bind(this))[0];
        return !!(c && c.category === 'MANUAL');
      },
      shipModalIsApi: function() {
        return !!(this.shipModal.carrier && !this.shipModalIsManual());
      },
      // Vô hiệu 1 lựa chọn đối tác: SELF + hãng thủ công (MANUAL/SPX) luôn chọn được; hãng API cần đã cấu
      // hình + đơn đủ địa chỉ; hãng chưa có adapter tạm khoá (chọn được khi bổ sung adapter backend).
      shipCarrierDisabled: function(c) {
        if (!c || c.carrier_code === 'SELF' || c.category === 'MANUAL') return false;
        if (!c.has_config) return true;
        if (this.shipCarrierApiCode(c.carrier_code)) return !this.shipCarrierCapable(c.carrier_code);
        return true;
      },
      loadShipCarriers: function() {
        var self = this, core = window.MopsAdminCore;
        // SELF chỉ tồn tại ở tầng FE — nó là 1 phương án UI ("Tự giao / hãng khác"), không phải hãng thật
        // trong registry ShippingCarriers. Không seed SELF vào backend để mọi hàm iterate carriers
        // (listCarriers/_shipDefaultCarrier/reconciliation…) khỏi phải handle case đặc biệt cho non-carrier.
        var selfOpt = { carrier_code: 'SELF', name: 'Tự giao / hãng khác', category: 'SELF', connected: true, has_config: true };
        core.gasGet({ action: 'list_carriers' })
          .then(function(d) {
            self.shipModal.loading = false;
            // Đối tác đã đủ credential phải xuất hiện ngay để tạo vận đơn, kể cả toggle registry cũ
            // chưa được bật. Toggle chỉ là trạng thái kết nối/hiển thị; không được làm mất GHTK vừa cấu hình.
            var list = (d && d.success && d.carriers) ? d.carriers.filter(function(c) { return c.connected || c.has_config; }) : [];
            list.push(selfOpt);
            self.shipModal.carriers = list;
            // Mặc định thông minh — KHÔNG âm thầm chọn SELF khi lý do là "đơn thiếu địa chỉ" (2026-07-28):
            //  · Có hãng API vừa cấu hình vừa capable theo đơn → chọn hãng đó (hành vi cũ đúng).
            //  · Ngược lại: để carrier='' (nút Tạo vận đơn tự khoá do required) — nhân viên tự bấm Bổ sung
            //    địa chỉ, Đi tới Cấu hình, hoặc chủ động tick "Tự giao" khi thật sự muốn tự giao. Silent
            //    fallback về SELF là root cause của bug "chỉ có Tự giao" — người dùng tưởng bắt buộc dùng SELF.
            var api = list.filter(function(c) { return c.carrier_code !== 'SELF' && c.has_config && self.shipCarrierCapable(c.carrier_code); })[0];
            if (api) { self.shipModal.carrier = api.carrier_code; self.onShipCarrierChange(); }
            else { self.shipModal.carrier = ''; }
          })
          .catch(function() {
            self.shipModal.loading = false;
            self.shipModal.carriers = [selfOpt];
            self.shipModal.carrier = 'SELF';
            core.showToast('Không tải được danh sách đối tác — chỉ còn tuỳ chọn tự giao.', 'error');
          });
      },
      // Mã panel Cấu hình đúng đối tác (khớp cfgTabs trong mops-admin-settings.js.bwt). Trả '' nếu carrier
      // chưa có panel Cấu hình (VD SPX thủ công) → template ẩn nút "Đi tới Cấu hình" cho carrier đó.
      carrierConfigPanelKey: function(carrierCode) {
        return ({ GOSHIP: 'goship', GHN: 'ghn', AHAMOVE: 'ahamove', GHTK: 'ghtk', VIETTELPOST: 'vtp' })[carrierCode] || '';
      },
      // Đi tới Cấu hình đối tác từ modal Tạo vận đơn — đóng modal, chuyển tab + panel. Ghi nhớ orderId
      // để nhân viên biết mình đang giữa flow tạo vận đơn (toast nhắc quay lại), tránh lạc mất luồng.
      openCarrierConfig: function(carrierCode) {
        var panel = this.carrierConfigPanelKey(carrierCode);
        if (!panel) return;
        var orderId = this.shipModal.order && this.shipModal.order.order_id;
        this.closeShipModal();
        this.setActiveTab('settings');       // core method — tự load loadSettingsData()
        this.setSettingsPanel(panel);        // mixin Cấu hình — chọn đúng panel đối tác
        if (orderId) {
          window.MopsAdminCore.showToast('Sau khi lưu Cấu hình, quay lại tab Đơn hàng → mở đơn ' + orderId + ' → Tạo vận đơn.', 'info');
        }
      },
      // ⚠️ LEGACY (V6 2026-08-04): đóng modal + mở form Sửa đơn để bổ sung địa chỉ. Vấn đề: mất
      // packageWeight/packageDims/carrier/rate đã nhập, staff phải nhập lại. Đã thay bằng
      // openShipAddrEdit (inline editor). Giữ lại làm fallback + backward compat.
      openAddShippingFromShipModal: function() {
        var orderId = this.shipModal.order && this.shipModal.order.order_id;
        if (!orderId) return;
        this.closeShipModal();
        this.openEditOrderForm(orderId);
      },
      // ── V6 2026-08-04 Inline Address Editor (Fulfillment refactor) ──────────────
      // Bấm [Thay đổi] ở address block → mở sub-form ngay trong shipModal, KHÔNG đóng
      // modal (giữ packageWeight/packageDims/carrier/rate). Sau khi Lưu:
      //   - update_order với địa chỉ mới (backend đã hỗ trợ ship_receiver_name/phone/
      //     address/province/district/ward từ trước, dùng chung với path Sửa đơn thường)
      //   - update shipModal.order.shipping_address + orders.detail + detailStore
      //   - trigger previewShipFee để reload rates các hãng (auto-recheck)
      // 2026-08-16 refactor: openShipAddrEdit init addrEdit.addr cho <mops-address-picker> —
      // reuse helper _buildAddrPayloadFromAddress (đã dùng ở form Sửa/Thêm địa chỉ khách + form
      // Tạo đơn) để lookup ngược names → GSO codes + adapters GHN. Bỏ 3 cascade handler cũ.
      openShipAddrEdit: function() {
        var sa = (this.shipModal.order && this.shipModal.order.shipping_address) || {};
        var e = this.shipModal.addrEdit;
        e.receiverName = sa.receiver_name || (this.shipModal.order && this.shipModal.order.customer_name) || '';
        e.phone        = this._ensureLeadingZeroPhone(sa.phone || (this.shipModal.order && this.shipModal.order.customer_phone) || '');
        e.address      = sa.address || '';
        if (typeof this._buildAddrPayloadFromAddress === 'function' && (sa.province || sa.ward)) {
          e.addr = this._buildAddrPayloadFromAddress(sa);
        } else {
          e.addr = {
            provinceCode: '', provinceName: sa.province || '',
            districtCode: '', districtName: sa.district || '',
            wardCode: '', wardName: sa.ward || '',
            newProvinceCode: '', newProvinceName: '',
            newWardCode: '', newWardName: '',
            fullShippingAddress: '',
            adapters: (sa.province_id || sa.district_id || sa.ward_code) ? {
              ghn: { province: sa.province_id || '', district: sa.district_id || '', ward: sa.ward_code || '' }
            } : {}
          };
        }
        // Sync backward-compat fields từ addr (một số code cũ vẫn đọc addrEdit.provinceName)
        e.provinceName = e.addr.provinceName || sa.province || '';
        e.districtName = e.addr.districtName || sa.district || '';
        e.wardName     = e.addr.wardName || sa.ward || '';
        e.error = '';
        e.open = true;
      },
      closeShipAddrEdit: function() {
        this.shipModal.addrEdit.open = false;
        this.shipModal.addrEdit.error = '';
      },
      saveShipAddrEdit: function() {
        var self = this, core = window.MopsAdminCore;
        var e = this.shipModal.addrEdit;
        var order = this.shipModal.order;
        if (!order || !order.order_id) return;
        // 2026-08-16: merge từ addr (picker) → text fields cho backend. District không bắt buộc
        // (Sapo 3-layer có thể chỉ có Tỉnh + Xã); backend accept 2 hoặc 3 cấp.
        var a   = e.addr || {};
        var ghn = (a.adapters && a.adapters.ghn) || {};
        var provText = a.provinceName || e.provinceName || '';
        var distText = a.districtName || e.districtName || '';
        var wardText = a.wardName || e.wardName || '';
        var missing = [];
        if (!(e.receiverName || '').trim()) missing.push('Họ tên người nhận');
        if (!(e.phone || '').trim())        missing.push('Số điện thoại');
        if (!(e.address || '').trim())      missing.push('Số nhà / Đường');
        if (!provText.trim())                missing.push('Tỉnh/Thành');
        if (!wardText.trim())                missing.push('Phường/Xã');
        if (missing.length) { e.error = 'Thiếu: ' + missing.join(', '); return; }
        e.saving = true; e.error = '';
        // V6.4 2026-08-05: action riêng update_order_shipping (KHÔNG dùng update_order — path đó
        // yêu cầu items > 0 → fail khi chỉ sửa địa chỉ inline). BE mops-gas/mops_02.js:1017
        // updateOrderShippingOnly() chỉ append ShippingAddresses + trỏ Orders.G, không đụng
        // items/finance/status.
        var body = {
          action: 'update_order_shipping',
          order_id: order.order_id,
          ship_receiver_name: e.receiverName.trim(),
          ship_phone: e.phone.trim(),
          ship_address: e.address.trim(),
          ship_province: provText,
          ship_district: distText,
          ship_ward: wardText,
          ship_province_id: ghn.province || '',
          ship_district_id: ghn.district || '',
          ship_ward_code:   ghn.ward     || '',
          save_customer_address: false
        };
        core.gasPost(body)
          .then(function(d) {
            e.saving = false;
            if (!d || !d.success) {
              e.error = (d && d.error) || 'Không cập nhật được địa chỉ. Thử lại?';
              return;
            }
            // Cập nhật state đồng bộ 3 nơi: shipModal.order, orders.detail (đang mở), detailStore cache
            var newAddr = {
              receiver_name: e.receiverName.trim(), phone: e.phone.trim(), address: e.address.trim(),
              province: provText, district: distText, ward: wardText,
              province_id: ghn.province || '', district_id: ghn.district || '', ward_code: ghn.ward || ''
            };
            if (self.shipModal.order) self.shipModal.order.shipping_address = newAddr;
            if (self.orders.detail && self.orders.detail.order_id === order.order_id) {
              self.orders.detail.shipping_address = newAddr;
            }
            if (self.orders.detailStore && self.orders.detailStore[order.order_id]) {
              // Cache bust — lần open detail sau sẽ fetch tươi
              delete self.orders.detailStore[order.order_id];
            }
            // Đóng sub-form + auto trigger refetch rates (giữ nguyên carrier/weight/dims đã chọn)
            e.open = false;
            core.showToast('Đã lưu địa chỉ · đang tính lại cước…', 'success');
            // Reload rates: nếu Goship/API hãng → previewShipFee; nếu SELF → skip
            if (typeof self.onShipCarrierChange === 'function') {
              try { self.onShipCarrierChange(); } catch (err) { /* ignore, keep order state */ }
            }
          })
          .catch(function() {
            e.saving = false;
            e.error = 'Lỗi kết nối. Thử lại sau ít giây.';
          });
      },
      onShipCarrierChange: function() {
        var m = this.shipModal;
        m.fee = null; m.feeError = ''; m.rates = []; m.rateId = ''; m.rateCarrier = '';
        // GHTK phải có pick_address_id trước khi tính phí. Không gọi preview song song với
        // request tải kho, nếu không lần gọi đầu sẽ thiếu kho lấy hàng và báo lỗi giả.
        if (m.carrier === 'GHTK') { this.loadShipGhtkPickAddresses(); return; }
        if (this.shipModalIsApi() && this.shipCarrierCapable(m.carrier)) this.previewShipFee();
      },
      loadShipGhtkPickAddresses: function() {
        var self = this, core = window.MopsAdminCore, m = this.shipModal;
        if (m.ghtkPickAddressesLoading) return;
        m.ghtkPickAddressesLoading = true;
        core.gasPost({ action: 'ghtk_pick_addresses' })
          .then(function(d) {
            m.ghtkPickAddressesLoading = false;
            if (!d || !d.success) { m.feeError = (d && d.error) || 'Không tải được kho GHTK.'; return; }
            m.ghtkPickAddresses = d.addresses || [];
            m.ghtkPickAddressId = d.selected_pick_address_id || '';
            if (d.selected_missing) m.feeError = d.message || 'Kho mặc định GHTK không còn tồn tại. Hãy chọn lại kho.';
            if (!m.ghtkPickAddressId && m.ghtkPickAddresses.length === 1) m.ghtkPickAddressId = m.ghtkPickAddresses[0].pick_address_id;
            if (!m.ghtkPickAddresses.length) { m.feeError = 'GHTK chưa trả về kho lấy hàng. Kiểm tra Token/môi trường rồi tải lại kho.'; return; }
            self.syncGhtkPickAddressFields();
            self.loadGhtkProvinces();
            if (!m.ghtkPickAddressId) m.feeError = 'Chọn kho GHTK trước khi tính phí hoặc tạo vận đơn.';
            else self.previewShipFee();
          })
          .catch(function() { m.ghtkPickAddressesLoading = false; m.feeError = 'Lỗi kết nối khi tải kho GHTK.'; });
      },
      syncGhtkPickAddressFields: function() {
        var m = this.shipModal;
        var selected = (m.ghtkPickAddresses || []).filter(function(w) { return String(w.pick_address_id) === String(m.ghtkPickAddressId); })[0];
        if (!selected) return;
        m.ghtkPickName = selected.pick_name || '';
        m.ghtkPickTel = selected.pick_tel || '';
        m.ghtkPickAddress = selected.address || '';
        m.ghtkPickProvince = selected.pick_province || '';
        m.ghtkPickDistrict = selected.pick_district || '';
        m.ghtkPickWard = selected.pick_ward || '';
      },
      ghtkLocationNameKey: function(value) {
        return String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd')
          .replace(/^(thanh pho|tinh|tp\.?|quan|huyen|thi xa)\s+/i, '').replace(/[^a-z0-9]+/g, ' ').trim();
      },
      loadGhtkProvinces: function() {
        var self = this, core = window.MopsAdminCore, m = this.shipModal;
        if (m.ghtkProvinces.length || m.ghtkLocationLoading) return;
        m.ghtkLocationLoading = true;
        core.gasGet({ action: 'ship_provinces' }).then(function(d) {
          m.ghtkProvinces = (d && d.success && d.provinces) || [];
          var match = m.ghtkProvinces.filter(function(p) {
            return self.ghtkLocationNameKey(p.name) === self.ghtkLocationNameKey(m.ghtkPickProvince);
          })[0];
          if (match) m.ghtkPickProvince = match.name;
          m.ghtkLocationLoading = false;
          self.loadGhtkDistricts(true);
        }).catch(function() { m.ghtkLocationLoading = false; });
      },
      loadGhtkDistricts: function(keepDistrict) {
        var self = this, core = window.MopsAdminCore, m = this.shipModal;
        var province = (m.ghtkProvinces || []).filter(function(p) { return p.name === m.ghtkPickProvince; })[0];
        m.ghtkDistricts = [];
        if (!province) return;
        m.ghtkLocationLoading = true;
        core.gasGet({ action: 'ship_districts', province_id: province.id }).then(function(d) {
          m.ghtkDistricts = (d && d.success && d.districts) || [];
          if (keepDistrict) {
            var match = m.ghtkDistricts.filter(function(x) {
              return self.ghtkLocationNameKey(x.name) === self.ghtkLocationNameKey(m.ghtkPickDistrict);
            })[0];
            if (match) m.ghtkPickDistrict = match.name;
          }
          m.ghtkLocationLoading = false;
        }).catch(function() { m.ghtkLocationLoading = false; });
      },
      onGhtkPickProvinceChange: function() {
        this.shipModal.ghtkPickDistrict = '';
        this.loadGhtkDistricts(false);
      },
      ghtkSelectedPickAddress: function() {
        var m = this.shipModal;
        return {
          pick_address_id: m.ghtkPickAddressId,
          pick_name: m.ghtkPickName,
          pick_tel: m.ghtkPickTel,
          address: m.ghtkPickAddress,
          pick_province: m.ghtkPickProvince,
          pick_district: m.ghtkPickDistrict,
          pick_ward: m.ghtkPickWard
        };
      },
      previewShipFee: function() {
        var self = this, core = window.MopsAdminCore, m = this.shipModal;
        if (!m.order || !this.shipModalIsApi()) return;
        if (m.carrier === 'GHTK' && !m.ghtkPickAddressId) { m.feeError = 'Chọn kho GHTK trước khi tính phí.'; return; }
        if (!this.shipCarrierCapable(m.carrier)) { m.fee = null; m.feeError = 'Đơn chưa có địa chỉ hợp lệ cho hãng này — không tính được phí.'; return; }
        m.feeLoading = true; m.feeError = ''; m.fee = null; m.rates = []; m.rateCarrier = '';
        core.gasPost({ action: 'calc_shipping_fee', order_id: m.order.order_id, carrier: m.carrier,
                       service_type_id: m.serviceTypeId,
                       // Cân thực đang nhập → báo giá đúng kiện, chưa cần lưu trước
                        package_weight: Number(m.packageWeight) || 0, package_dims: (m.packageDims || '').trim(),
                        // V6.1: cod_value tính insurance/COD fee (GHN đặc biệt tính phí COD ~0.5%
                        // theo Sapo dashboard). Đổi COD → phí thay đổi → nhân viên thấy ngay.
                        cod_value: Math.max(0, Number(m.codAmount) || 0),
                        // V6.2 multi-warehouse: từ kho nào lấy → khoảng cách + phí khác nhau.
                        pick_branch_id: (m.pickBranchId || '').trim(),
                        pick_address_id: m.carrier === 'GHTK' ? m.ghtkPickAddressId : '',
                        pick_address: m.carrier === 'GHTK' ? self.ghtkSelectedPickAddress() : null })
          .then(function(d) {
            m.feeLoading = false;
            if (d && d.success) {
              m.fee = d.fee || 0;
              // Goship trả kèm `rates` (n hãng). Chọn sẵn phương án backend auto-pick để nhân viên chỉ cần
              // bấm Tạo — muốn đổi hãng thì tick dòng khác. Hãng trực tiếp không có rates → bảng không hiện.
              if (d.rates && d.rates.length) { m.rates = d.rates; m.rateId = d.rate_id || d.rates[0].rate_id; }
            } else {
              m.feeError = (d && d.error) || 'Không tính được phí';
            }
          })
          .catch(function() { m.feeLoading = false; m.feeError = 'Lỗi kết nối khi tính phí'; });
      },
      // Danh sách hãng có trong chào giá (dựng ô lọc). Kèm số phương án + phí thấp nhất của từng hãng để
      // nhân viên chọn hãng ngay ở dropdown mà chưa cần lọc.
      shipRateCarriers: function() {
        var by = {};
        (this.shipModal.rates || []).forEach(function(r) {
          var k = r.carrier_name || '(không tên)';
          if (!by[k]) by[k] = { name: k, count: 0, min_fee: r.total_fee };
          by[k].count++;
          if (r.total_fee < by[k].min_fee) by[k].min_fee = r.total_fee;
        });
        return Object.keys(by).map(function(k) { return by[k]; })
          .sort(function(a, b) { return a.min_fee - b.min_fee; });
      },
      // Bảng so sánh: lọc theo hãng (nếu chọn) → sắp theo phí (mặc định) hoặc tỉ lệ giao thành công.
      shipRatesSorted: function() {
        var m = this.shipModal;
        var list = (m.rates || []).filter(function(r) {
          return !m.rateCarrier || r.carrier_name === m.rateCarrier;
        });
        if (m.rateSort === 'success') {
          list.sort(function(a, b) { return (b.success_percent - a.success_percent) || (a.total_fee - b.total_fee); });
        } else {
          list.sort(function(a, b) { return (a.total_fee - b.total_fee) || (b.success_percent - a.success_percent); });
        }
        return list;
      },
      // Đổi ô lọc: nếu phương án đang chọn bị lọc mất thì tự chọn dòng đầu của danh sách còn lại —
      // tránh cảnh bấm "Tạo vận đơn" trong khi rateId trỏ tới hãng không còn hiện trên bảng.
      onShipRateCarrierChange: function() {
        var list = this.shipRatesSorted();
        if (!list.length) return;
        var stillThere = list.filter(function(r) { return r.rate_id === this.shipModal.rateId; }.bind(this))[0];
        if (!stillThere) this.selectShipRate(list[0]);
      },
      selectShipRate: function(r) {
        if (!r) return;
        this.shipModal.rateId = r.rate_id;
        this.shipModal.fee = r.total_fee; // phí hiển thị đi theo hãng đang chọn
      },
      shipRateCheapest: function() {
        var list = (this.shipModal.rates || []);
        if (!list.length) return null;
        return list.slice().sort(function(a, b) { return a.total_fee - b.total_fee; })[0];
      },
      submitCreateShipment: function() {
        var self = this, core = window.MopsAdminCore, m = this.shipModal;
        if (!m.order || !m.carrier || !m.packedConfirmed || m.submitting) return;
        if (!m.pickBranchId) {
          core.showToast('Chưa chọn kho lấy hàng — vui lòng chọn 1 chi nhánh có địa chỉ kho.', 'error');
          return;
        }
        var ghtkManual = m.carrier === 'GHTK' && m.ghtkPickSource === 'manual';
        if (ghtkManual && !m.ghtkPickAddressId) {
          core.showToast('Bạn đã chọn "Kho GHTK khác" — hãy chọn 1 kho từ dropdown bên dưới.', 'error');
          return;
        }
        if (this.shipModalIsApi() && !this.shipPickBranchCapableForCarrier && !ghtkManual) {
          var cur = this.shipPickBranchCurrent;
          if (m.carrier === 'GHTK') {
            core.showToast('Chi nhánh chưa liên kết GHTK — chuyển sang tab "Chọn kho GHTK khác" hoặc bổ sung Pick Address ID ở tab Chi nhánh.', 'error');
          } else {
            core.showToast('Chi nhánh "' + (cur && cur.name || '') + '" chưa liên kết ' + m.carrier + '. Vào tab Chi nhánh → bổ sung mã kho hãng trước khi tạo vận đơn.', 'error');
          }
          return;
        }
        if (ghtkManual && !!m.ghtkPickAddressId && (!(m.ghtkPickProvince || '').trim() || !(m.ghtkPickDistrict || '').trim())) {
          core.showToast('Kho GHTK vừa chọn thiếu Tỉnh/TP hoặc Quận/Huyện. Hãy bổ sung 2 trường bên dưới rồi thử lại.', 'error');
          return;
        }
        var orderId = m.order.order_id;
        m.submitting = '1';
        var body;
        // Số đo thực gửi kèm MỌI hãng (kể cả tự giao) — backend ghi PackedAt + PackageWeight/Dims trong
        // _shipPrepareCreate, nên "đã đóng gói" thành mốc có dữ liệu thay vì chỉ 1 checkbox trên UI.
        var packing = { package_weight: Number(m.packageWeight) || 0, package_dims: (m.packageDims || '').trim() };
        // V6.1 2026-08-04: 3 trường giao hàng chuẩn (COD/requiredNote/deliveryNote) gửi CHO MỌI
        // path (manual + API) — backend adapter tự map sang key hãng tương ứng (GHN: cod_amount +
        // required_note + note; GHTK: pick_money + is_freeship + value + note; Goship pass-through).
        // SELF/MANUAL không có API push nhưng vẫn ghi vào Shipments sheet để đối soát/in phiếu.
        var codAmount = Math.max(0, Number(m.codAmount) || 0);
        var deliveryNote = (m.deliveryNote || '').trim();
        var pickBranchId = (m.pickBranchId || '').trim();   // V6.2: backend resolve pick address
        if (this.shipModalIsManual()) {
          body = { action: 'create_shipment', order_id: orderId, carrier: m.carrier,
            carrier_name: m.carrier === 'SELF' ? ((m.selfCarrierName || 'Tự giao').trim() || 'Tự giao') : '',
            manual_tracking: (m.manualTracking || '').trim(), manual_fee: Number(m.manualFee) || 0,
            package_weight: packing.package_weight, package_dims: packing.package_dims,
            cod_amount: codAmount, delivery_note: deliveryNote, pick_branch_id: pickBranchId };
        } else {
          body = { action: 'create_shipment', order_id: orderId, carrier: m.carrier,
            service_type_id: m.serviceTypeId, required_note: m.requiredNote,
            cod_amount: codAmount, delivery_note: deliveryNote, pick_branch_id: pickBranchId,
            package_weight: packing.package_weight, package_dims: packing.package_dims };
          if (m.carrier === 'GHTK' && m.ghtkPickSource === 'manual' && m.ghtkPickAddressId) {
            body.pick_address_id = m.ghtkPickAddressId;
            body.pick_address = self.ghtkSelectedPickAddress();
          }
          if (m.carrier === 'GOSHIP' && m.rateId) body.rate = m.rateId;
        }
        core.gasPost(body)
          .then(function(d) {
            m.submitting = '';
            if (d && d.success) {
              var msg = d.tracking_code
                ? ('Đã tạo vận đơn: ' + d.tracking_code + (d.shipping_fee ? ' — phí ' + core.formatMoney(d.shipping_fee) : ''))
                : 'Đã tạo vận đơn (tự giao) cho đơn ' + orderId;
              core.showToast(msg, 'success');
              self.closeShipModal();
              // Response create_shipment đã có tracking/phí; cập nhật state tức thì thay vì
              // bắt buộc gọi get_order rồi list_orders nối tiếp. Hai refresh này chạy nền.
              var shipmentPatch = {
                fulfillment_status: d.fulfillment_status || 'ready_to_pick',
                tracking_code: d.tracking_code || '',
                carrier: d.carrier || (m.carrier === 'SELF' ? m.selfCarrierName : m.carrier),
                shipping_fee: d.shipping_fee != null ? d.shipping_fee : (Number(m.manualFee) || 0),
                cod_amount: codAmount,
                package_weight: packing.package_weight,
                package_dims: packing.package_dims,
                packed_at: new Date().toISOString(),
                __optimistic: true
              };
              if (self.orders.detail && self.orders.detail.order_id === orderId) {
                self.orders.detail = Object.assign({}, self.orders.detail, shipmentPatch);
                self.orders.detailStore[orderId] = { data: self.orders.detail, loadedAt: Date.now(), optimistic: true };
              }
              self.orders.list = (self.orders.list || []).map(function(row) {
                return row && row.order_id === orderId ? Object.assign({}, row, shipmentPatch) : row;
              });
              setTimeout(function() { self.loadOrders(); }, 800);
            } else {
              core.showToast('Lỗi: ' + (d && d.error || 'Không tạo được vận đơn'), 'error');
            }
          })
          .catch(function() { m.submitting = ''; core.showToast('Lỗi kết nối khi tạo vận đơn.', 'error'); });
      },
      // 2026-08-09 — 3-Axis Status Architecture (Sapo/Haravan chuẩn): Payment / Fulfillment tách trục.
      // Nhận object đơn đầy đủ (không chỉ status) để loại bỏ "Xác nhận đã thanh toán" cho COD — với
      // COD tiền do vận chuyển thu, phải qua Đối soát COD/Phí (pay_reconciliation) mới auto PAID. Ép
      // staff bấm "Xác nhận đã trả" tay cho COD là ANTI-PATTERN — sai với model Sapo/Haravan/KiotViet.
      // Backward-compat: nếu caller vẫn truyền string status → orderActions(status) fallback qua object
      // {status, payment_method: ''}. Không bao giờ hide Cancel/Refund vì hai action đó áp cho mọi method.
      orderActions: function(orderOrStatus) {
        var order = (typeof orderOrStatus === 'string') ? { status: orderOrStatus, payment_method: '' } : (orderOrStatus || {});
        var status = order.status || '';
        var method = String(order.payment_method || '').toUpperCase();
        var actions = [];
        var isCod = method === 'COD';
        // canConfirm: chỉ VIETQR/CASH mới cần staff xác nhận. COD tự động qua đối soát (Sapo/Haravan model).
        var canConfirm = (status === 'PENDING' || status === 'PAYMENT_REPORTED') && !isCod;
        var canCancel  = status === 'PENDING' || status === 'PAYMENT_REPORTED';
        var canRefund  = status === 'PAID' || status === 'PROCESSING' || status === 'COMPLETED';
        if (canConfirm) actions.push({ status: 'PAID', label: 'Xác nhận đã thanh toán', icon: 'check_circle', cls: 'w-full flex items-center justify-center gap-2 bg-emerald-600 text-white py-2 rounded-lg font-bold text-label-md hover:bg-emerald-700 transition-all mb-2' });
        // Huỷ đơn = destructive thật sự (huỷ hẳn đơn bán) → viền đỏ dày hơn nút "Huỷ đóng gói" (chỉ
        // thu hồi mã vận đơn, có thể redo). Phân cấp thị giác: Huỷ đóng gói amber outline < Huỷ đơn
        // red outline đậm — bấm nhầm sẽ tốn công tạo lại đơn.
        if (canCancel)  actions.push({ status: 'CANCELLED', label: 'Huỷ đơn', icon: 'cancel', cls: 'w-full flex items-center justify-center gap-2 bg-surface-container-lowest text-error border-2 border-error/60 px-3 py-2.5 rounded-lg font-bold text-label-md hover:bg-error/10 hover:border-error/80 transition-all mb-2' });
        if (canRefund)  actions.push({ status: 'REFUNDED', label: 'Hoàn tiền', icon: 'undo', cls: 'w-full flex items-center justify-center gap-2 bg-violet-600 text-white py-2 rounded-lg font-bold text-label-md hover:bg-violet-700 transition-all mb-2' });
        return actions;
      },
      confirmUpdateOrderStatus: function(orderId, status) {
        var self = this;
        var core = window.MopsAdminCore;
        if (this.orders.actionBusy) return; // chặn double-click khi đang gọi API
        var labels = { PAID: 'Xác nhận đã thanh toán', CANCELLED: 'Huỷ đơn', REFUNDED: 'Hoàn tiền' };
        if (!confirm('Xác nhận: ' + labels[status] + ' cho đơn ' + orderId + '?')) return;
        this.orders.actionBusy = status; // nút tương ứng hiện spinner + khoá tới khi GAS trả về
        // 2026-08-10 OCC: gửi _version từ detail (get_order đã trả về). Nếu detail chưa mở → gửi
        // 0 = skip check (backward-compat cho các call site chưa tải detail).
        var _v = (self.orders.detail && self.orders.detail.order_id === orderId) ? self.orders.detail._version : 0;
        core.gasPost({ action: 'update_order_status', order_id: orderId, status: status, _version: _v })
          .then(function(d) {
            self.orders.actionBusy = '';
            if (d && d.success) {
              core.showToast('Đã cập nhật: ' + orderId + ' → ' + status, 'success');
              // Patch state ngay từ response write, không nối tiếp get_order + list_orders trên
              // critical path. Refresh danh sách ở nền vẫn là nguồn đồng bộ cuối cùng.
              // Điều này loại bỏ thêm 1 round-trip GAS (thường 2–5s) sau khi staff bấm xác nhận.
              var detail = self.orders.detail;
              if (detail && detail.order_id === orderId) {
                detail.status = status;
                detail.payment_status = status;
                if (status === 'PAID') detail.fulfillment_status = 'pending_packing';
                if (status === 'CANCELLED') detail.fulfillment_status = 'cancelled';
                detail.__optimistic = true;
                // 2026-08-10 OCC: đồng bộ _version từ response để gọi update kế không văng conflict
                if (d._version) detail._version = d._version;
              }
              self.orders.list = (self.orders.list || []).map(function(row) {
                if (!row || row.order_id !== orderId) return row;
                var next = Object.assign({}, row, { status: status, payment_status: status, __optimistic: true });
                if (status === 'PAID') next.fulfillment_status = 'pending_packing';
                if (status === 'CANCELLED') next.fulfillment_status = 'cancelled';
                return next;
              });
              if (detail && detail.order_id === orderId) {
                self.orders.detailStore[orderId] = { data: detail, loadedAt: Date.now(), optimistic: true };
              }
              setTimeout(function() { self.loadOrders(); }, 800);
            } else {
              // 2026-08-10 OCC: nếu server trả OCC_CONFLICT → tự động reload detail rồi báo staff
              var errMsg = String(d && d.error || 'Không cập nhật được');
              if (errMsg.indexOf('OCC_CONFLICT') !== -1) {
                core.showToast('Đơn đã được cập nhật ở nơi khác. Đang tải lại...', 'warning');
                self.loadOrders();
                if (self.orders.detail && self.orders.detail.order_id === orderId) {
                  self.toggleOrderDetail(orderId, true); // refetch detail với _version mới
                }
              } else {
                core.showToast('Lỗi: ' + errMsg, 'error');
              }
            }
          })
          .catch(function() { self.orders.actionBusy = ''; core.showToast('Lỗi kết nối khi cập nhật trạng thái.', 'error'); });
      },
      /* ── Kéo đơn từ SAPO về (pull, mops.md §10 Luồng 2) — cron đã tự chạy 15-30 phút/lần,
         nút này chỉ để chủ động kéo ngay khi cần, không thay thế cron ── */
      confirmPullFromSapo: function() {
        var self = this;
        var core = window.MopsAdminCore;
        if (this.orders.pulling) return;
        this.orders.pulling = true;
        core.gasPost({ action: 'pull_orders_from_sapo' })
          .then(function(d) {
            self.orders.pulling = false;
            if (!d.success) throw new Error(d.error || 'Kéo đơn từ SAPO thất bại');
            core.showToast('Đã kéo ' + d.total + ' đơn từ SAPO — tạo mới ' + d.created + ', cập nhật ' + d.updated, 'success');
            self.loadOrders();
          })
          .catch(function(e) { self.orders.pulling = false; core.showToast(e.message || 'Lỗi kết nối', 'error'); });
      },
      /* ── Đẩy đơn lên SAPO (V2.4 slice — thủ công, chỉ đơn product đã PAID+) ── */
      canPushToSapo: function(order) {
        if (!order) return false;
        var payableStatuses = ['PAID', 'PROCESSING', 'COMPLETED'];
        return order.order_type === 'product' && payableStatuses.indexOf(order.status) !== -1 && !order.sapo_order_id;
      },
      confirmPushToSapo: function(orderId) {
        var self = this;
        var core = window.MopsAdminCore;
        if (!confirm('Tạo đơn tương ứng trên SAPO cho đơn ' + orderId + '? Thao tác này không thể huỷ.')) return;
        core.gasPost({ action: 'push_order_to_sapo', order_id: orderId })
          .then(function(d) {
            if (d && d.success) {
              core.showToast('Đã tạo đơn trên SAPO: ' + d.sapo_order_id, 'success');
              if (self.orders.detail && self.orders.detail.order_id === orderId) {
                self.orders.detail.sapo_order_id = d.sapo_order_id;
                self.orders.detail.sapo_sync_status = d.sapo_sync_status;
              }
            } else {
              core.showToast('Lỗi: ' + (d && d.error || 'Không đẩy được lên SAPO'), 'error');
            }
          })
          .catch(function() { core.showToast('Lỗi kết nối khi đẩy đơn lên SAPO.', 'error'); });
      },
      /* ── Tạo đơn thủ công (staff, khách vãng lai/gọi điện) ──
         Ô tìm sản phẩm (manualOrderSearchResults) lọc trên products.all (domain Sản phẩm, vẫn ở
         core) — nếu staff vào thẳng tab Đơn hàng mà CHƯA từng mở tab Sản phẩm, tự tải bù ở đây. */
      openOrderFromUrl: function() {
        var query = new URLSearchParams(window.location.search);
        var id = (query.get('order_id') || '').trim();
        if (query.get('action') !== 'view' || !id) return;
        // Link từ tab Vận chuyển phải giữ nguyên tab trên URL. Vẫn nạp domain Đơn hàng
        // để lấy detail theo order_id, nhưng không để setActiveTab() ghi đè ?tab=shipping.
        if (query.get('tab') !== 'shipping') this.setActiveTab('orders');
        else if (!this.tabLoaded.orders) {
          this.loadOrders();
        }
        this.toggleOrderDetail(id, true);
      },
      // openManualOrderForm — V4 2026-08-04: chuyển từ modal (manualOrder.showForm=true) sang
      // workspaceView riêng ('orders.create'). Modal cũ đã bị loại bỏ; hiển thị hình thức trang
      // đầy đủ thay vì popup gối lên list.
      openManualOrderForm: function() {
        this.manualOrder.showForm = true; // backward compat cho paymentEditLock etc. (chưa migrate hết)
        // Quick-add từ header hoạt động ở MỌI tab (2026-08-05) — form chỉ render khi activeTab='orders'
        // (xem page.mops-admin.bwt v-if của <section workspaceView>). Nếu user đang ở tab Products/Customers/…
        // mà bấm Tạo đơn, không setActiveTab thì workspaceView bị đặt nhưng form vẫn ẩn.
        if (this.activeTab !== 'orders') this.setActiveTab('orders');
        if (typeof this.openWorkspaceView === 'function') this.openWorkspaceView('orders.create');
        else this.workspaceView = 'orders.create';
        // Manual Order search dùng this.products.all. List sản phẩm nay tải trang đầu trước rồi
        // hydrate nốt catalog ở nền (xem mixin Products) — nếu form mở khi mới có trang đầu, kích
        // hoạt hydrate đủ để tìm được SP ngoài trang 1. Không chặn mở form / nhập liệu.
        if (!this.products.all.length && !this.products.loading) this.loadProducts();
        else if (!this.products.hydrated && !this.products.hydrating && typeof this.loadProductsFull === 'function') this.loadProductsFull();
        if (!this.customers.all.length && !this.customers.loading) this.loadCustomers();
        this.ensureBranchesLoaded();
        this.ensureBankAccountsLoaded();
        // Load GHN provinces LUÔN khi mở form (2026-08-05): địa chỉ nay là dữ liệu khách hàng,
        // hiển thị cả khi Bán tại quầy → cần province options sẵn sàng, không đợi user bật Giao hàng.
        if (!this.manualOrder.ghnProvinces || !this.manualOrder.ghnProvinces.length) {
          try { this.loadGhnProvinces(); } catch (e) { /* mixin GHN chưa nạp — bỏ qua */ }
        }
      },
      // ── Hotkeys F2/F4/F9 cho luồng POS (V3 2026-08-04) ─────────────────────
      // F2: focus ô tìm sản phẩm | F4: focus ô tìm khách | F9: Tạo đơn (submit).
      // Chỉ hoạt động khi modal đang mở và không phải trạng thái result. e.preventDefault
      // để browser không bật menu Rename/Search-in-page mặc định của F2/F4.
      focusManualOrderProductSearch: function() {
        var el = this.$refs.manualOrderProductSearch;
        if (el && el.focus) { el.focus(); el.select && el.select(); }
      },
      focusManualOrderCustomerSearch: function() {
        var el = this.$refs.manualOrderCustomerSearch;
        if (el && el.focus) { el.focus(); el.select && el.select(); }
      },
      _makeManualOrderHotkeyHandler: function() {
        var self = this;
        return function(e) {
          if (!self.manualOrder.showForm || self.manualOrder.result) return;
          // V5 2026-08-04: đổi F2 → F3 khớp Sapo POS convention (F3=tìm SP, F4=tìm khách, F9=lưu).
          // F2 mặc định browser = Rename ở nhiều app, giữ F3 an toàn hơn.
          if (e.key === 'F3') { e.preventDefault(); self.focusManualOrderProductSearch(); }
          else if (e.key === 'F4') { e.preventDefault(); self.focusManualOrderCustomerSearch(); }
          else if (e.key === 'F9') {
            e.preventDefault();
            if (self.manualOrder.submitting) return;
            if (!self.manualOrder.editingOrderId && self.manualOrder.paymentMethod !== 'COD' && !self.paymentConfigured) return;
            self.submitManualOrder();
          }
          // 2026-08-08 — Alt+P: toggle checkbox "Đã nhận tiền, xác nhận thanh toán ngay"
          // (CASH/VIETQR) HOẶC checkbox "Tạo vận đơn ngay" (COD). Ẩn khi đang SỬA đơn (editing).
          // Không dùng phím thường vì clash với gõ tên khách trong ô search.
          else if (e.altKey && (e.key === 'p' || e.key === 'P')) {
            if (self.manualOrder.editingOrderId) return;
            e.preventDefault();
            if (self.manualOrder.paymentMethod === 'COD') {
              self.manualOrder.openShipmentImmediately = !self.manualOrder.openShipmentImmediately;
            } else {
              self.manualOrder.confirmPaymentImmediately = !self.manualOrder.confirmPaymentImmediately;
            }
          }
        };
      },
      // Reset manualOrder về default ĐẦY ĐỦ (mọi field như data()) — dùng khi mở form SỬA để không
      // sót field (closeManualOrderForm() reset thiếu quickAdd/branchId... — chấp nhận được khi ĐÓNG
      // nhưng nếu dùng để MỞ lại sẽ để undefined, vỡ template). Trả object mới, KHÔNG tự gán.
      _blankManualOrder: function() {
        return {
          showForm: false, itemSearch: '', cart: [],
          itemSearchFocused: false, categoryFilter: '',
          quickAdd: { show: false, title: '', price: '', inventoryQty: '', sku: '', productType: '', vendor: '', image: '', saving: false },
          orderType: 'product', branchId: '', appointmentDate: '', appointmentTime: '',
          customerName: '', phone: '', note: '', internal_note: '',
          customerSearch: '', customerSearchFocused: false, selectedCustomer: null,
          // customerAddressLoading: true trong lúc gọi get_customer sau khi chọn khách để đầy đủ
          // profile (customers.all là list rút gọn, KHÔNG có addresses[] — xem comment ở
          // pickManualOrderCustomer). Trước khi có flag này, template hiện "Chưa có địa chỉ" ngay
          // sau click → nhân viên tưởng khách chưa có sổ địa chỉ và bấm "Chọn địa chỉ" thừa.
          customerAddressLoading: false,
          discountType: '%', discountValue: '', discountReason: '', invalidField: null,
          couponCode: '', couponChecking: false, couponPreview: null,
          // wantsShipping mặc định true theo hướng POS V3 (2026-08-04): telesale/online là luồng
          // chính, hiện form giao hàng ngay để giảm 1 click. Bán tại quầy vẫn 1 click sang toggle.
          wantsShipping: true, shipToOther: false, shipReceiverName: '', shipPhone: '', shipAddress: '',
          selectedAddressId: '', saveCustomerAddress: false,
          shipReceiverAddress: '',
          shipProvinceId: '', shipProvinceName: '', shipDistrictId: '', shipDistrictName: '', shipWardCode: '', shipWardName: '',
          // Address 3 cấp — payload từ <mops-address-picker> qua v-model (2026-08-12 refactor).
          // Thay 11 field addrProvince/District/Ward/Smart{Code,Name,Query,Focused} rời rạc trước đây
          // bằng 1 object phẳng cùng schema với component. adapters map hãng ID (ghn/ghtk/vnp/…) trả
          // qua đây để mixin dựng ship_province_id/district_id/ward_code cho create_shipment.
          addr: {
            provinceCode: '', provinceName: '',
            districtCode: '', districtName: '',
            wardCode: '', wardName: '',
            fullShippingAddress: '',
            adapters: {}
          },
          ghnProvinces: [], ghnDistricts: [], ghnWards: [], ghnLoading: false, addressMasterSource: '', publicAddressData: [], shippingFee: null, shippingFeeLoading: false,
          provinceSearch: '', districtSearch: '', wardSearch: '', customerShippingFee: '', customerShippingFeeManual: false,
          paymentMethod: 'VIETQR',
          // 2026-08-08 — checkbox "Đã nhận tiền, xác nhận thanh toán ngay". Chỉ show với CASH/VIETQR
          // (COD tiền do vận chuyển thu → không có gì để xác nhận trước khi giao). Sau khi
          // create_order_admin thành công, submitManualOrder tự gọi update_order_status PAID (FE
          // tuần tự 2 request — nếu request 2 fail thì đơn giữ PENDING và toast warning).
          confirmPaymentImmediately: false,
          // 2026-08-08 — với COD (thay checkbox thanh toán), option "mở modal Tạo vận đơn ngay sau
          // khi tạo đơn" — 1-click UX cho luồng bán giao hàng: cart → create_order → openShipModal.
          openShipmentImmediately: false,
          // 2026-08-08 — collapse địa chỉ khách khi Bán tại quầy. wantsShipping=true → luôn mở
          // (không dùng cờ này). wantsShipping=false → mặc định thu gọn, staff bấm "Sửa địa chỉ
          // khách" để expand khi cần cập nhật (KHÔNG regress case "bán tại quầy vẫn phải sửa
          // được địa chỉ khách" đã fix 2026-08-05).
          expandCustomerAddress: false,
          editingOrderId: null, editReason: '', editLocks: [],
          // 2026-08-21 — optimistic Sửa đơn: bấm edit ở row → mở form NGAY với data snapshot,
          // fetch get_order song song, khi về merge full (items/shipping_address/activity_logs).
          // detailLoading=true trong lúc chờ → banner vàng "Đang tải chi tiết" trên đầu form.
          detailLoading: false,
          origPaymentMethod: '', origPaymentStatus: '',
          // 2026-08-12 — modal Tạo khách mới inline từ form Đơn hàng (reuse customers.createForm
          // state + saveCustomerCreate method của tab Khách hàng). Bật khi bấm nút "Tạo khách mới"
          // ở cột trái Khối Khách hàng (col-6 layout).
          showCreateCustomerModal: false,
          // Địa chỉ nhập ngay trong modal Tạo khách — payload picker + street riêng. Khi submit
          // sẽ được merge vào customers.createForm.address* để saveCustomerCreate tự gọi
          // save_customer_address (best-effort) → khách vừa tạo có luôn địa chỉ mặc định.
          newCustomerStreet: '',
          newCustomerAddr: {
            provinceCode: '', provinceName: '',
            districtCode: '', districtName: '',
            wardCode: '', wardName: '',
            fullShippingAddress: '',
            adapters: {}
          },
          // 2026-08-21 — Address picker modal state. Xem comment ở data.manualOrder.addressPicker.
          addressPicker: {
            open: false, mode: 'list', saving: false, pendingSelectId: '',
            tempAddr: { provinceCode: '', provinceName: '', districtCode: '', districtName: '', wardCode: '', wardName: '', fullShippingAddress: '', adapters: {} },
            tempStreet: '', tempReceiverName: '', tempPhone: ''
          },
          submitting: false, error: '', result: null
        };
      },
      // SỬA đơn đã tạo (2026-07-19) — tái dùng modal Tạo đơn ở "chế độ sửa". Tải chi tiết đơn (get_order),
      // đổ vào form, hiện cảnh báo trạng thái nhạy cảm. submitManualOrder() tự nhánh sang update_order.
      openEditOrderForm: function(orderId, rowLike) {
        var self = this;
        var core = window.MopsAdminCore;
        if (!orderId) return;
        if (!this.products.all.length && !this.products.loading) this.loadProducts();
        else if (!this.products.hydrated && !this.products.hydrating && typeof this.loadProductsFull === 'function') this.loadProductsFull();
        if (!this.customers.all.length && !this.customers.loading) this.loadCustomers();
        this.ensureBranchesLoaded();

        // Fast path 1 — orders.detail vừa mở đúng đơn này, dùng luôn (đủ items + shipping_address).
        var detail = this.orders.detail;
        if (detail && detail.order_id === orderId && Array.isArray(detail.items)) {
          this.orders.editLoading = false;
          this._openEditOrderFromDetail(orderId, detail);
          return;
        }
        // Fast path 2 — detailStore cache (openShipModalFromRow / previous view detail) đã có.
        var cached = this.orders.detailStore && this.orders.detailStore[orderId];
        if (cached && cached.data && Array.isArray(cached.data.items)) {
          this.orders.editLoading = false;
          this._openEditOrderFromDetail(orderId, cached.data);
          return;
        }

        // Optimistic path — bấm edit từ row list, chưa có detail cache. Mở form NGAY với snapshot
        // của row (tên, SĐT, số tiền, order_id) để user thấy phản hồi tức thì; get_order fetch song
        // song ~10s ở background rồi merge patch full (items, shipping_address, discount, activity_logs).
        // Cả 2 path đều dùng _openEditOrderFromDetail — thứ tự set field xác định (customer trước, items
        // sau) đảm bảo merge không đè dữ liệu user đã gõ nếu response về muộn.
        var partial = {
          order_id: orderId,
          _version: 0,
          customer_id: (rowLike && rowLike.customer_id) || '',
          customer_name: (rowLike && rowLike.customer_name) || '',
          customer_phone: (rowLike && rowLike.customer_phone) || '',
          customer_note: '',
          order_type: (rowLike && rowLike.order_type) || 'product',
          total_amount: (rowLike && (rowLike.amount || rowLike.total_amount)) || 0,
          merchandise_amount: (rowLike && (rowLike.amount || rowLike.total_amount)) || 0,
          customer_shipping_fee: (rowLike && rowLike.customer_shipping_fee) || 0,
          customer_shipping_fee_manual: false,
          payment_method: (rowLike && rowLike.payment_method) || 'VIETQR',
          status: (rowLike && rowLike.status) || '',
          payment_status: (rowLike && rowLike.status) || '',
          items: [],
          shipping_address: null,
          fulfillment_status: (rowLike && rowLike.fulfillment_status) || '',
          created_at: (rowLike && rowLike.created_at) || '',
          activity_logs: []
        };
        this._openEditOrderFromDetail(orderId, partial);
        this.manualOrder.detailLoading = true;

        core.gasGet({ action: 'get_order', order_id: orderId })
          .then(function(d) {
            if (self.manualOrder.editingOrderId !== orderId) return; // user đã đóng / chuyển đơn khác
            if (!d || !d.success) {
              self.manualOrder.detailLoading = false;
              core.showToast((d && d.error) || 'Không tải thêm được chi tiết đơn.', 'warning');
              return;
            }
            self.orders.detailStore[orderId] = { data: d, loadedAt: Date.now() };
            self._mergeManualOrderDetail(orderId, d);
          })
          .catch(function() {
            if (self.manualOrder.editingOrderId === orderId) self.manualOrder.detailLoading = false;
            core.showToast('Không tải thêm được chi tiết đơn — form đang dùng dữ liệu tóm tắt.', 'warning');
          });
      },
      // Merge full get_order response vào manualOrder đang mở. Chỉ patch những trường CHƯA có
      // trong form (items rỗng, address null, version 0…) — không đè dữ liệu user đang gõ dở.
      _mergeManualOrderDetail: function(orderId, o) {
        var mo = this.manualOrder;
        if (!mo || mo.editingOrderId !== orderId) return;
        if (!mo._editingOrderVersion) mo._editingOrderVersion = Number(o._version) || 0;
        // Customer object đầy đủ ID → phục vụ save/update và các reference con.
        if (mo.selectedCustomer && !mo.selectedCustomer.customer_id && o.customer_id) {
          mo.selectedCustomer = Object.assign({}, mo.selectedCustomer, { customer_id: o.customer_id });
        }
        if (!mo.customerName && o.customer_name) mo.customerName = o.customer_name;
        if (!mo.phone && o.customer_phone) mo.phone = this._ensureLeadingZeroPhone(o.customer_phone);
        if (!mo.note && o.customer_note) mo.note = o.customer_note;
        // 2026-08-23 internal_note (staff nội bộ, cột AQ). Prefill khi Sửa đơn — không đè user đang gõ dở.
        if (!mo.internal_note && o.internal_note) mo.internal_note = o.internal_note;
        // Cart items — chỉ ghi khi form chưa có (không đè user đã thêm/xoá SP dở).
        if ((!mo.cart || !mo.cart.length) && Array.isArray(o.items) && o.items.length) {
          mo.cart = o.items.map(function(it) {
            return {
              handle: it.handle, variant_id: it.variant_id || '', variant_title: it.variant_title || '',
              title: it.name, price: Number(it.price) || 0, qty: Number(it.qty) || 1,
              line_discount: Number(it.discount_value) || 0,
              image: it.image_url || '', sku: it.sku || ''
            };
          });
        }
        // Discount / coupon — chỉ áp khi user chưa nhập tay.
        if (!Number(mo.discountValue) && !mo.couponCode) {
          if (Number(o.order_discount_value) > 0) {
            mo.discountType   = o.order_discount_type || '%';
            mo.discountValue  = o.order_discount_value;
            mo.discountReason = o.order_discount_reason || '';
          } else if (o.discount_code) {
            mo.couponCode = o.discount_code;
          }
        }
        // Edit locks — luôn refresh vì phụ thuộc backend state hiện tại (đơn có thể vừa được PAID ở nơi khác).
        var locks = [];
        if (o.status === 'PAID') locks.push('Đơn ĐÃ THU TIỀN — Phiếu Thu giữ nguyên số cũ; nếu đổi tiền cần đối soát Tài chính thủ công.');
        if (o.sapo_order_id)     locks.push('Đơn đã đẩy SAPO (' + o.sapo_order_id + ') — sửa ở MOPS không tự cập nhật SAPO.');
        if (o.tracking_code)     locks.push('Đơn đã có vận đơn (' + o.tracking_code + ') — nếu đổi hàng, báo lại đơn vị vận chuyển.');
        mo.editLocks = locks;
        // Shipping address — chỉ populate nếu form chưa có province (dấu hiệu row snapshot ban đầu).
        var sa = o.shipping_address;
        if (sa && !mo.shipProvinceId && !mo.shipProvinceName) {
          mo.wantsShipping    = true;
          mo.shipReceiverName = sa.receiver_name || '';
          mo.shipPhone        = this._ensureLeadingZeroPhone(sa.phone);
          mo.shipAddress      = sa.address || '';
          mo.shipProvinceId   = sa.province_id || ''; mo.shipProvinceName = sa.province || '';
          mo.shipDistrictId   = sa.district_id || ''; mo.shipDistrictName = sa.district || '';
          mo.shipWardCode     = sa.ward_code || '';   mo.shipWardName     = sa.ward || '';
          mo.addr = {
            provinceCode: sa.province_code || '',
            provinceName: sa.province || '',
            districtCode: sa.district_code || '',
            districtName: sa.district || '',
            wardCode: sa.ward_code_gso || '',
            wardName: sa.ward || '',
            fullShippingAddress: sa.full_shipping_address || '',
            adapters: (sa.province_id || sa.district_id || sa.ward_code) ? {
              ghn: { province: sa.province_id || '', district: sa.district_id || '', ward: sa.ward_code || '' }
            } : {}
          };
          if (sa.province_id) this._prefillGhnCascade(sa);
        }
        mo.detailLoading = false;
      },
      _openEditOrderFromDetail: function(orderId, o) {
            // get_order → _ok(getOrder()) trả phẳng
            // V4 2026-08-04: chuyển sang workspaceView 'orders.edit' — trang riêng thay modal.
            var mo = this._blankManualOrder();
            mo.showForm = true; // backward compat cho computed paymentEditLock
            mo.editingOrderId = orderId;
            // 2026-08-10 OCC: bắt _version từ get_order để submit form gửi kèm — server check khi update.
            mo._editingOrderVersion = Number(o._version) || 0;
            mo.orderType = o.order_type || 'product';
            mo.customerName = o.customer_name || '';
            mo.phone = this._ensureLeadingZeroPhone(o.customer_phone);
            mo.note = o.customer_note || '';
            mo.internal_note = o.internal_note || ''; // 2026-08-23 ghi chú nội bộ staff (AQ=43)
            // Fix 2026-08-21: form template render customer card qua manualOrder.selectedCustomer
            // (object) — không phải customerName/phone. Nếu chỉ set 2 field lẻ → box khách hiển thị
            // "chưa chọn khách hàng" dù data đã có, gây tưởng bug backend. Set object đầy đủ để
            // template render đúng ngay khi mở Sửa đơn. customerSearch cần có để nếu user muốn đổi
            // khách khác, ô search hiện tên hiện tại thay vì trống.
            if (o.customer_id || o.customer_name || o.customer_phone) {
              mo.selectedCustomer = {
                customer_id: o.customer_id || '',
                name: o.customer_name || '',
                phone: o.customer_phone || ''
              };
              mo.customerSearch = o.customer_name || o.customer_phone || '';
            }
            mo.customerShippingFee = o.customer_shipping_fee || 0;
            mo.customerShippingFeeManual = !!o.customer_shipping_fee_manual;
            mo.appointmentDate = o.appointment_date || '';
            mo.appointmentTime = o.appointment_time || '';
            // Payment method: ưu tiên o.payment_method (backend chính thức từ Payments.D, 2026-07-28) —
            // suy diễn từ cod_amount là fallback cho đơn cũ. Ghi origPaymentMethod/origPaymentStatus để
            // computed paymentEditLock quyết định có cho đổi hay không (VIETQR↔COD khi NOT PAID + !CASH).
            mo.paymentMethod      = String(o.payment_method || '').toUpperCase() || ((Number(o.cod_amount) > 0) ? 'COD' : 'VIETQR');
            mo.origPaymentMethod  = mo.paymentMethod;
            mo.origPaymentStatus  = String(o.status || o.payment_status || '').toUpperCase();
            mo.cart = (o.items || []).map(function(it) {
              // image_url + variant_title do backend enrich từ Products (2026-07-28) — hiển thị đúng
              // ảnh SP + nhãn biến thể ở form sửa đơn. Đơn cũ (SP đã xoá) → 2 field rỗng → placeholder.
              // V5 2026-08-04: line_discount đọc từ backend nếu có (cột OrderItems.DiscountValue —
              // mops.md §16.5 spec, backend chưa code) — fallback 0.
              return {
                handle: it.handle, variant_id: it.variant_id || '', variant_title: it.variant_title || '',
                title: it.name, price: Number(it.price) || 0, qty: Number(it.qty) || 1,
                line_discount: Number(it.discount_value) || 0,
                image: it.image_url || '', sku: it.sku || ''
              };
            });
            if (Number(o.order_discount_value) > 0) {
              mo.discountType   = o.order_discount_type || '%';
              mo.discountValue  = o.order_discount_value;
              mo.discountReason = o.order_discount_reason || '';
            } else if (o.discount_code) {
              mo.couponCode = o.discount_code; // bấm "Áp dụng" để xem lại giảm; backend vẫn tính lại khi lưu
            }
            var locks = [];
            if (o.status === 'PAID') locks.push('Đơn ĐÃ THU TIỀN — Phiếu Thu giữ nguyên số cũ; nếu đổi tiền cần đối soát Tài chính thủ công.');
            if (o.sapo_order_id)     locks.push('Đơn đã đẩy SAPO (' + o.sapo_order_id + ') — sửa ở MOPS không tự cập nhật SAPO.');
            if (o.tracking_code)     locks.push('Đơn đã có vận đơn (' + o.tracking_code + ') — nếu đổi hàng, báo lại đơn vị vận chuyển.');
            mo.editLocks = locks;
            var sa = o.shipping_address;
            if (sa) {
              mo.wantsShipping    = true;
              mo.shipReceiverName = sa.receiver_name || '';
              mo.shipPhone        = this._ensureLeadingZeroPhone(sa.phone);
              mo.shipAddress      = sa.address || '';
              mo.shipProvinceId   = sa.province_id || ''; mo.shipProvinceName = sa.province || '';
              mo.shipDistrictId   = sa.district_id || ''; mo.shipDistrictName = sa.district || '';
              mo.shipWardCode     = sa.ward_code || '';   mo.shipWardName     = sa.ward || '';
              // 2026-08-12: populate mo.addr cho <mops-address-picker>. Code GSO (province_code/
              // district_code/ward_code) đọc từ order response nếu có; nếu backend chưa expose,
              // component sẽ hiện ô typeahead với TÊN sẵn để staff bấm dropdown chọn lại → tự
              // gắn code. adapters.ghn mirror ID hãng để backward-compat create_shipment.
              mo.addr = {
                provinceCode: sa.province_code || '',
                provinceName: sa.province || '',
                districtCode: sa.district_code || '',
                districtName: sa.district || '',
                wardCode: sa.ward_code_gso || '',
                wardName: sa.ward || '',
                fullShippingAddress: sa.full_shipping_address || '',
                adapters: (sa.province_id || sa.district_id || sa.ward_code) ? {
                  ghn: { province: sa.province_id || '', district: sa.district_id || '', ward: sa.ward_code || '' }
                } : {}
              };
            }
            this.manualOrder = mo;
            // V4 2026-08-04: navigate sang workspaceView 'orders.edit' để render trang riêng.
            if (typeof this.openWorkspaceView === 'function') this.openWorkspaceView('orders.edit', { orderId: orderId });
            else this.workspaceView = 'orders.edit';
            if (sa && sa.province_id) this._prefillGhnCascade(sa);
      },
      // Nạp tuần tự Tỉnh→Quận→Xã GHN cho form SỬA để 3 dropdown hiển thị đúng lựa chọn đã lưu
      // (nếu không nạp, select rỗng — người dùng tưởng mất địa chỉ). Ghi vào this.manualOrder hiện tại.
      _prefillGhnCascade: function(sa) {
        var core = window.MopsAdminCore, mo = this.manualOrder;
        mo.ghnLoading = true;
        core.gasGet({ action: 'ship_provinces' })
          .then(function(d) {
            if (d && d.success) { mo.addressMasterSource = 'GHN'; mo.ghnProvinces = d.provinces || []; }
            if (!sa.district_id) { mo.ghnLoading = false; return null; }
            return core.gasGet({ action: 'ship_districts', province_id: sa.province_id });
          })
          .then(function(d) {
            if (!d) return null;
            if (d.success) mo.ghnDistricts = d.districts || [];
            if (!sa.ward_code) { mo.ghnLoading = false; return null; }
            return core.gasGet({ action: 'ship_wards', district_id: sa.district_id });
          })
          .then(function(d) { mo.ghnLoading = false; if (d && d.success) mo.ghnWards = d.wards || []; })
          .catch(function() { mo.ghnLoading = false; });
      },
      // 2026-08-24 unify: In hoá đơn từ kết quả SỬA đơn → dùng chung printSingleOrder (fetch qua
      // get_orders_batch để có data BE canonical, format Sapo 12-block giống bulk print).
      printOrderDetailFromResult: function() {
        var o = this.manualOrder.result && this.manualOrder.result.order;
        if (!o || !o.order_id) return;
        this.printSingleOrder(o.order_id);
      },
      /* ── Chọn khách hàng (picker), cùng pattern poItemSearchResults ── */
      // Kết quả tìm khách cho dropdown autocomplete: đã chọn khách → rỗng; CHƯA gõ → gợi ý 8 khách
      // gần đây (hiện ngay khi focus); ĐÃ gõ → lọc theo tên/SĐT. Loading/empty/not-found do template lo.
      manualOrderCustomerResults: function() {
        if (this.manualOrder.selectedCustomer) return [];
        var q = (this.manualOrder.customerSearch || '').trim().toLowerCase();
        var all = this.customers.all || [];
        if (!q) return all.slice(0, 8);
        return all.filter(function(c) {
          return String(c.name || '').toLowerCase().indexOf(q) !== -1 || String(c.phone || '').toLowerCase().indexOf(q) !== -1;
        }).slice(0, 8);
      },
      pickManualOrderCustomer: function(c) {
        var self = this;
        var mo = this.manualOrder;
        mo.selectedCustomer = c;
        mo.customerSearch = (c.name || c.phone);
        mo.customerName = c.name || '';
        // Fix V5 2026-08-04: bù 0 đầu SĐT trước khi gán — dữ liệu ĐỌC từ Google Sheets có thể
        // rụng số 0 (đơn cũ trước khi backend fix _forcePlainText, xem memory phone_leading_zero).
        mo.phone = this._ensureLeadingZeroPhone(c.phone);
        if (c.customer_group === 'SỈ' && Number(c.default_discount_percent) > 0) {
          mo.discountType   = '%';
          mo.discountValue  = c.default_discount_percent;
          mo.discountReason = 'Áp giá Khách Sỉ theo hồ sơ';
          mo.couponCode      = '';
          mo.couponPreview   = null;
        }
        // customers.all (nguồn của c) là danh sách rút gọn — KHÔNG có địa chỉ (xem bảng tab
        // Khách hàng, chỉ có customer_id/phone/name/customer_group/...). Phải gọi get_customer
        // lấy đủ hồ sơ mới tự điền vận chuyển được (review UX: tránh bắt gõ lại địa chỉ đã có).
        mo.shipToOther = false;
        this.syncManualOrderShipping(); // điền tạm tên/SĐT ngay — địa chỉ vào sau khi fetch xong
        // Bật loading cho block địa chỉ; template thay text "Chưa có địa chỉ" bằng shimmer
        // "Đang tải địa chỉ khách hàng…" trong lúc chờ get_customer.
        mo.customerAddressLoading = true;
        window.MopsAdminCore.gasGet({ action: 'get_customer', phone: c.phone })
          .then(function(d) {
            // Guard theo reference — nếu nhân viên đã chọn khách khác trong lúc chờ, bỏ qua
            // response cũ (tránh đè nhầm dữ liệu khách đang chọn hiện tại).
            if (self.manualOrder.selectedCustomer !== c) return;
            if (d && d.success && d.found) {
              self.manualOrder.selectedCustomer = d;
              self.syncManualOrderShipping();
            }
            self.manualOrder.customerAddressLoading = false;
          })
          .catch(function() {
            if (self.manualOrder.selectedCustomer === c) self.manualOrder.customerAddressLoading = false;
          });
      },
      // Nguồn duy nhất tự điền "Thông tin vận chuyển" từ khách hàng đang chọn — gọi lại mỗi khi
      // chọn khách mới, hoặc khi bật checkbox "Cần giao hàng". Không ghi đè khi đang ở chế độ
      // sửa tay (shipToOther=true), tránh xoá thông tin người nhận khác nhân viên đang gõ dở.
      // Địa chỉ mặc định từ sổ khách là nguồn ưu tiên. Mã GHN chỉ được giữ khi bản ghi được chuẩn hoá
      // theo danh mục GHN; địa chỉ danh mục công khai vẫn dùng tên chuẩn cho GHTK/Goship/VTP.
      // _ensureLeadingZeroPhone (V5 2026-08-04): SĐT từ Google Sheets rụng số 0 đầu (memory
      // project_mops_phone_leading_zero) — GAS đã fix _forcePlainText khi GHI nhưng dữ liệu ĐỌC
      // qua get_customer / list_customers có thể vẫn 9-digit (đơn cũ + case race). formatPhone
      // trong core trả '—' khi rỗng (dùng cho hiển thị), không dùng được cho input v-model. Hàm
      // này giữ '' cho rỗng, bù 0 khi 9-digit /^[1-9]/.
      _ensureLeadingZeroPhone: function(p) {
        var s = String(p == null ? '' : p).replace(/\s+/g, '');
        if (!s) return '';
        if (s.length === 9 && /^[1-9]/.test(s)) return '0' + s;
        return s;
      },
      // ── Address Master helpers (V4 địa chỉ 3 cấp — 2026-08-11) ─────────────
      // _addrNoAccent: chuẩn hoá không dấu + lowercase + gộp Đ→d cho typeahead
      // matching. Dùng cho manualOrderAddrProvinceOptions/DistrictOptions/WardOptions
      // và manualOrderAddrSmartCandidates.
      _addrNoAccent: function(s) {
        var str = String(s == null ? '' : s).toLowerCase();
        if (!str) return '';
        // Normalize Vietnamese diacritics — sử dụng String.prototype.normalize khi có
        try { str = str.normalize('NFD').replace(/[̀-ͯ]/g, ''); } catch (e) {}
        str = str.replace(/đ/g, 'd').replace(/Đ/g, 'd');
        return str.trim();
      },
      // Chọn tỉnh từ dropdown master → set code+name + reset district/ward
      pickManualOrderAddrProvince: function(p) {
        var mo = this.manualOrder;
        mo.addrProvinceCode = p.c; mo.addrProvinceName = p.f || p.n || '';
        mo.addrDistrictCode = ''; mo.addrDistrictName = '';
        mo.addrWardCode = ''; mo.addrWardName = '';
        mo.addrProvinceQuery = mo.addrProvinceName;
        mo.addrProvinceFocused = false;
        // Legacy mirror để backend/GAS hiện tại đọc được province/district/ward tên
        mo.shipProvinceName = mo.addrProvinceName;
        mo.shipDistrictName = ''; mo.shipWardName = '';
        // Reset legacy GHN ID (không còn nguồn để suy — sẽ set từ master.ghn nếu có)
        mo.shipProvinceId = String(p.ghn || '');
        mo.shipDistrictId = ''; mo.shipWardCode = '';
        mo.addressMasterSource = 'MASTER';
      },
      pickManualOrderAddrDistrict: function(d) {
        var mo = this.manualOrder;
        mo.addrDistrictCode = d.c; mo.addrDistrictName = d.f || d.n || '';
        mo.addrWardCode = ''; mo.addrWardName = '';
        mo.addrDistrictQuery = mo.addrDistrictName;
        mo.addrDistrictFocused = false;
        mo.shipDistrictName = mo.addrDistrictName;
        mo.shipWardName = '';
        mo.shipDistrictId = String(d.ghn || '');
        mo.shipWardCode = '';
      },
      pickManualOrderAddrWard: function(w) {
        var mo = this.manualOrder;
        mo.addrWardCode = w.c; mo.addrWardName = w.f || w.n || '';
        mo.addrWardQuery = mo.addrWardName;
        mo.addrWardFocused = false;
        mo.shipWardName = mo.addrWardName;
        // GHN ward code từ master adapter (nếu có); fallback rỗng — payload chấp nhận
        mo.shipWardCode = String(w.ghn || '');
      },
      // Chọn 1 candidate từ smart-search gộp chuỗi → set cả 3 cấp
      pickManualOrderAddrSmart: function(cand) {
        if (!cand) return;
        this.pickManualOrderAddrProvince(cand.province);
        this.pickManualOrderAddrDistrict(cand.district);
        this.pickManualOrderAddrWard(cand.ward);
        var mo = this.manualOrder;
        mo.addrSmartQuery = ''; mo.addrSmartFocused = false;
      },
      // Reset toàn bộ picker địa chỉ 3 cấp (dùng khi bấm nút "Xoá địa chỉ")
      // Blur dropdown địa chỉ 3 cấp + smart-search: setTimeout 150ms để click option
      // (mousedown.prevent) kịp fire trước khi v-if ẩn dropdown. Trước 2026-08-12 dùng
      // inline @blur="setTimeout(function(){ this.manualOrder.XYZ = false }.bind(this), 150)"
      // — với Vue 2 in-DOM template, `this` trong function được compile qua `with(this){}`
      // có ràng buộc không đảm bảo, dropdown không ẩn. Chuyển sang method để chắc chắn.
      // Sau 2026-08-12 refactor sang <mops-address-picker>, handler này chỉ còn dùng cho
      // các dropdown legacy trong tab khác (nếu có) — giữ lại tránh vỡ khi có caller khác.
      blurManualOrderAddrDropdown: function(field) {
        var self = this;
        setTimeout(function() { self.manualOrder[field] = false; }, 150);
      },
      // 2026-08-12 — Quick-create customer trong form Manual Order. Reuse customers.createForm
      // state + saveCustomerCreate method của tab Khách hàng (không duplicate logic dupe-check).
      // opts.inline=true để saveCustomerCreate không navigate; onSuccess callback nhận customer
      // vừa tạo → tự pickManualOrderCustomer + đóng modal. UX POS: chọn KH hoặc tạo mới trong
      // cùng flow tạo đơn, không rời context.
      openManualOrderQuickCreateCustomer: function() {
        // Prefill từ ô search customerSearch (2026-08-16, sau khi bỏ 2 input walk-in Tên/SĐT):
        // detect query là số → prefill vào Phone; là chữ → prefill vào Name. Staff không phải gõ lại.
        var q = String(this.manualOrder.customerSearch || '').trim();
        var digits = q.replace(/[^\d]/g, '');
        var isPhoneQuery = digits.length >= 8 && digits.length === q.replace(/\s/g, '').length;
        var prefName  = isPhoneQuery ? '' : q;
        var prefPhone = isPhoneQuery ? digits : String(this.manualOrder.phone || '').replace(/[^\d]/g, '');
        this.customers.createForm = {
          name: prefName, phone: prefPhone,
          email: '', customerGroup: 'LẺ', defaultDiscountPercent: 0,
          addressStreet: '', addressWard: '', addressDistrict: '', addressCity: '',
          notes: '', gender: '', birthday: '', externalCode: '',
          dupeCheck: { status: 'idle', existingCustomer: null },
          _thenCreateOrder: false
        };
        // Reset địa chỉ modal-scope tránh rỉ dữ liệu lần mở trước.
        this.manualOrder.newCustomerStreet = '';
        this.manualOrder.newCustomerAddr = {
          provinceCode: '', provinceName: '',
          districtCode: '', districtName: '',
          wardCode: '', wardName: '',
          fullShippingAddress: '',
          adapters: {}
        };
        this.manualOrder.showCreateCustomerModal = true;
        // Nếu SĐT đã prefill đủ 10 số → chạy dupe check ngay (tránh user gõ lại rồi mới biết trùng).
        if (prefPhone.length >= 10 && typeof this.onCustomerPhoneInput === 'function') {
          this.onCustomerPhoneInput();
        }
      },
      closeManualOrderQuickCreateCustomer: function() {
        this.manualOrder.showCreateCustomerModal = false;
        this.customers.createSaving = false;
      },
      submitManualOrderQuickCreate: function() {
        var self = this;
        var mo = this.manualOrder;
        var cf = this.customers.createForm;
        // Merge địa chỉ vừa nhập trong modal vào createForm để saveCustomerCreate tự gọi
        // save_customer_address (best-effort). picker giữ chuẩn GSO names; nếu 3 cấp rỗng
        // thì save_customer_address không được gọi.
        cf.addressStreet   = String(mo.newCustomerStreet || '').trim();
        cf.addressWard     = String((mo.newCustomerAddr && mo.newCustomerAddr.wardName) || '').trim();
        cf.addressDistrict = String((mo.newCustomerAddr && mo.newCustomerAddr.districtName) || '').trim();
        cf.addressCity     = String((mo.newCustomerAddr && mo.newCustomerAddr.provinceName) || '').trim();
        this.saveCustomerCreate({
          inline: true,
          onSuccess: function(customerObj) {
            self.manualOrder.showCreateCustomerModal = false;
            // Bổ sung địa chỉ đã nhập vào object customer để pickManualOrderCustomer + sync sau đó
            // đọc được (server response không trả lại addresses[] vì save_customer_address async).
            if (cf.addressStreet || cf.addressCity) {
              customerObj.address_street   = cf.addressStreet;
              customerObj.address_ward     = cf.addressWard;
              customerObj.address_district = cf.addressDistrict;
              customerObj.address_city     = cf.addressCity;
              // Adapters GHN từ picker (nếu master data có key ghn cho row đã chọn) — cho phép
              // create_shipment trong lần đơn ngay sau đó.
              var ghn = mo.newCustomerAddr && mo.newCustomerAddr.adapters && mo.newCustomerAddr.adapters.ghn;
              if (ghn) {
                customerObj.default_address = {
                  address: cf.addressStreet, ward: cf.addressWard,
                  district: cf.addressDistrict, province: cf.addressCity,
                  province_id: ghn.province || '', district_id: ghn.district || '', ward_code: ghn.ward || ''
                };
              }
            }
            self.pickManualOrderCustomer(customerObj);
            // Prefill mo.addr trực tiếp từ payload picker (đầy đủ code+name+adapters, không cần
            // resolve lại) để 3 cấp Tỉnh/Huyện/Xã ở block Địa chỉ dưới form đơn hiện luôn.
            if (mo.newCustomerAddr && mo.newCustomerAddr.provinceCode) {
              self.manualOrder.addr = {
                provinceCode: mo.newCustomerAddr.provinceCode,
                provinceName: mo.newCustomerAddr.provinceName,
                districtCode: mo.newCustomerAddr.districtCode,
                districtName: mo.newCustomerAddr.districtName,
                wardCode: mo.newCustomerAddr.wardCode,
                wardName: mo.newCustomerAddr.wardName,
                fullShippingAddress: '',
                adapters: mo.newCustomerAddr.adapters || {}
              };
              self.onManualOrderAddressApply(self.manualOrder.addr);
            }
            if (cf.addressStreet) self.manualOrder.shipAddress = cf.addressStreet;
          }
        });
      },
      // Khi user bấm "Đổi khách" trên card info — bỏ chọn selectedCustomer, reset các field prefill
      // (customerName/phone/customerSearch/selectedAddressId). KHÔNG reset addr vì user có thể muốn
      // giữ địa chỉ đã nhập cho lần chọn KH tiếp theo.
      clearManualOrderSelectedCustomer: function() {
        var mo = this.manualOrder;
        mo.selectedCustomer = null;
        mo.customerSearch = '';
        mo.customerName = '';
        mo.phone = '';
        mo.selectedAddressId = '';
        mo.shipToOther = false;
        mo.customerAddressLoading = false;
      },
      // Trong dupe-check banner, nếu SĐT trùng khách sẵn có → 1 click chọn thẳng khách đó vào form.
      // KHÔNG dùng prefix '_' — Vue 3 không proxy _/S names cho template (rule đã ghi ở
      // customerLegacyAddressString phía trên).
      pickExistingCustomerFromDupe: function() {
        var existing = (this.customers.createForm.dupeCheck || {}).existingCustomer;
        if (!existing) return;
        // dupeCheck.existingCustomer chỉ có {customer_id, phone, name} — lookup full record từ
        // customers.all để lấy cả customer_group / addresses / default_discount_percent.
        var full = (this.customers.all || []).filter(function(c) {
          return String(c.customer_id) === String(existing.customer_id);
        })[0] || existing;
        this.closeManualOrderQuickCreateCustomer();
        this.pickManualOrderCustomer(full);
      },
      // Handler khi <mops-address-picker> emit 'apply' — component đã set 3 cấp code+name +
      // adapters IDs (ghn/ghtk/…). Payload đã được sync qua v-model vào mo.addr, nhưng ta cần
      // mirror thêm sang legacy shipProvinceId/DistrictId/WardCode để backward-compat module
      // create_shipment cũ (đọc ship_province_id khi addressMasterSource='GHN'). Set source =
      // 'MASTER' để nhánh submitManualOrder chọn đúng field ghi payload cho GAS.
      onManualOrderAddressApply: function(payload) {
        var mo = this.manualOrder;
        if (!payload) return;
        var ghn = (payload.adapters && payload.adapters.ghn) || {};
        mo.shipProvinceId   = String(ghn.province || '');
        mo.shipDistrictId   = String(ghn.district || '');
        mo.shipWardCode     = String(ghn.ward || '');
        mo.shipProvinceName = payload.provinceName || '';
        mo.shipDistrictName = payload.districtName || '';
        mo.shipWardName     = payload.wardName || '';
        mo.addressMasterSource = 'MASTER';
      },
      onManualOrderAddressClear: function() {
        var mo = this.manualOrder;
        mo.shipProvinceId = ''; mo.shipProvinceName = '';
        mo.shipDistrictId = ''; mo.shipDistrictName = '';
        mo.shipWardCode = '';   mo.shipWardName = '';
        mo.addressMasterSource = '';
      },
      clearManualOrderAddr: function() {
        var mo = this.manualOrder;
        mo.addrProvinceCode = ''; mo.addrProvinceName = '';
        mo.addrDistrictCode = ''; mo.addrDistrictName = '';
        mo.addrWardCode = ''; mo.addrWardName = '';
        mo.addrProvinceQuery = ''; mo.addrDistrictQuery = ''; mo.addrWardQuery = '';
        mo.shipProvinceId = ''; mo.shipProvinceName = '';
        mo.shipDistrictId = ''; mo.shipDistrictName = '';
        mo.shipWardCode = ''; mo.shipWardName = '';
      },
      // Từ tên (province/district/ward — string) lookup ngược master data → set code
      // Dùng khi selectedCustomer đã có địa chỉ text ở Sheets (customer.default_address).
      _addrResolveByNames: function(provinceName, districtName, wardName) {
        var m = window.MopsAddressMaster; if (!m) return null;
        var self = this;
        var pKey = self._addrNoAccent(provinceName);
        var dKey = self._addrNoAccent(districtName);
        var wKey = self._addrNoAccent(wardName);
        var p = null;
        if (pKey) {
          p = (m.provinces || []).filter(function(x) {
            return self._addrNoAccent(x.f) === pKey || self._addrNoAccent(x.n) === pKey;
          })[0] || null;
        }
        var d = null;
        if (p && dKey) {
          d = (m.districts || []).filter(function(x) {
            return x.p === p.c && (self._addrNoAccent(x.f) === dKey || self._addrNoAccent(x.n) === dKey);
          })[0] || null;
        }
        var w = null;
        if (d && wKey) {
          w = (m.wards || []).filter(function(x) {
            return x.p === d.c && (self._addrNoAccent(x.f) === wKey || self._addrNoAccent(x.n) === wKey);
          })[0] || null;
        }
        return { province: p, district: d, ward: w };
      },
      // Chiều 1 (Legacy → Mới): staff paste chuỗi "217A Phạm Viết Chánh, Dịch Vọng, Cầu Giấy, Hà Nội"
      // → tự đổ vào shipAddress + 3 cấp. Tolerant: split theo dấu phẩy; last 3 token cố gắng match
      // ward/district/province theo NoAccent. Không match được → giữ nguyên, không throw.
      // 2026-08-12 refactor: pick* cũ đã gỡ, giờ resolve trực tiếp qua MopsAddressMaster và set
      // mo.addr (payload cho <mops-address-picker>) + adapters.ghn để backward-compat create_shipment.
      parseManualOrderShipAddressLegacy: function() {
        var mo = this.manualOrder;
        var raw = String(mo.shipAddress || '').trim();
        if (!raw || raw.indexOf(',') === -1) return;
        var parts = raw.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
        if (parts.length < 3) return;
        var street = '', wardName = '', districtName = '', provinceName = '';
        if (parts.length >= 4) {
          provinceName = parts[parts.length - 1];
          districtName = parts[parts.length - 2];
          wardName = parts[parts.length - 3];
          street = parts.slice(0, parts.length - 3).join(', ');
        } else {
          provinceName = parts[parts.length - 1];
          districtName = parts[parts.length - 2];
          wardName = parts[parts.length - 3];
        }
        var m = window.MopsAddressMaster; if (!m || !m.provinces) return;
        var noAccent = function(s) {
          var str = String(s == null ? '' : s).toLowerCase();
          if (!str) return '';
          try { str = str.normalize('NFD').replace(/[̀-ͯ]/g, ''); } catch (e) {}
          return str.replace(/đ/g, 'd').replace(/Đ/g, 'd').trim();
        };
        var pKey = noAccent(provinceName), dKey = noAccent(districtName), wKey = noAccent(wardName);
        var p = (m.provinces || []).filter(function(x) {
          return noAccent(x.f) === pKey || noAccent(x.n) === pKey;
        })[0];
        if (!p) return;
        var d = (m.districts || []).filter(function(x) {
          return x.p === p.c && (noAccent(x.f) === dKey || noAccent(x.n) === dKey);
        })[0];
        var w = (d && (m.wards || []).filter(function(x) {
          return x.p === d.c && (noAccent(x.f) === wKey || noAccent(x.n) === wKey);
        })[0]) || null;
        mo.addr = {
          provinceCode: p.c, provinceName: p.f || p.n || '',
          districtCode: (d && d.c) || '', districtName: (d && (d.f || d.n)) || '',
          wardCode: (w && w.c) || '', wardName: (w && (w.f || w.n)) || '',
          fullShippingAddress: '',
          adapters: (p.ghn || (d && d.ghn) || (w && w.ghn)) ? {
            ghn: { province: p.ghn || '', district: (d && d.ghn) || '', ward: (w && w.ghn) || '' }
          } : {}
        };
        this.onManualOrderAddressApply(mo.addr);
        if (street && d && w) mo.shipAddress = street;
      },
      syncManualOrderShipping: function() {
        var mo = this.manualOrder;
        var c = mo.selectedCustomer;
        mo.shipReceiverName = mo.shipReceiverName || mo.customerName || '';
        mo.shipPhone = mo.shipPhone || this._ensureLeadingZeroPhone(mo.phone);
        if (!c) return;
        var a = (c.addresses || []).filter(function(x) { return x.is_default; })[0] || c.default_address || (c.address_street || c.address_city ? {
          receiver_name: c.name, phone: c.phone, address: c.address_street, ward: c.address_ward, district: c.address_district, province: c.address_city
        } : null);
        if (!a || mo.shipToOther) return;
        mo.selectedAddressId = a.address_id || '';
        mo.shipReceiverName = a.receiver_name || mo.customerName || '';
        mo.shipPhone = this._ensureLeadingZeroPhone(a.phone || mo.phone);
        mo.shipAddress = a.address || '';
        mo.shipReceiverAddress = '';
        mo.shipProvinceId = a.province_id || ''; mo.shipProvinceName = a.province || '';
        mo.shipDistrictId = a.district_id || ''; mo.shipDistrictName = a.district || '';
        mo.shipWardCode = a.ward_code || ''; mo.shipWardName = a.ward || '';
        // 2026-08-12 (v2): populate mo.addr cho <mops-address-picker>. Resolve names → GSO
        // codes qua MopsAddressMaster để 3 combobox typeahead có ĐỦ code + name (tránh
        // District/Ward bị disabled do provinceCode rỗng). Nếu master chưa load hoặc name
        // không match → giữ tên hiển thị, code rỗng — staff bấm dropdown chọn lại.
        mo.addr = this._buildAddrPayloadFromAddress(a);
        if (a.province_id && a.district_id && a.ward_code) this._prefillGhnCascade(a);
      },
      // 2026-08-12 (v2): build STRING địa chỉ từ selectedCustomer để truyền vào prop
      // legacyAddress của <mops-address-picker>. Trước đây bind trực tiếp
      // customer.default_address — có thể là object → Vue cast '[object Object]' → parse fail.
      // Method này ưu tiên: address string sẵn có → build từ object → build từ address_* fields.
      // KHÔNG dùng prefix '_' vì Vue 3 KHÔNG proxy prop/method bắt đầu bằng _ hay $ trong template
      // (coi là internal reserved) → template gọi ReferenceError. Đây là method dùng TỪ template.
      customerLegacyAddressString: function(c) {
        if (!c) return '';
        var a = c.default_address;
        if (typeof a === 'string' && a.trim()) return a.trim();
        if (a && typeof a === 'object') {
          return [a.address || '', a.ward || '', a.district || '', a.province || '']
            .map(function(s) { return String(s || '').trim(); })
            .filter(Boolean).join(', ');
        }
        if (c.address_street || c.address_city || c.address_ward || c.address_district) {
          return [c.address_street || '', c.address_ward || '', c.address_district || '', c.address_city || '']
            .map(function(s) { return String(s || '').trim(); })
            .filter(Boolean).join(', ');
        }
        return '';
      },
      // 2026-08-12: helper build payload mops-address-picker từ 1 address record. Resolve
      // qua master (nếu ready) để có code GSO đầy đủ. Adapters.ghn giữ từ address book
      // (backward-compat create_shipment cho đơn cũ đã lưu ID GHN).
      _buildAddrPayloadFromAddress: function(a) {
        var payload = {
          provinceCode: '', provinceName: a.province || '',
          districtCode: '', districtName: a.district || '',
          wardCode: '',     wardName: a.ward || '',
          fullShippingAddress: '',
          adapters: (a.province_id || a.district_id || a.ward_code) ? {
            ghn: { province: a.province_id || '', district: a.district_id || '', ward: a.ward_code || '' }
          } : {}
        };
        var resolved = null;
        try { resolved = this._addrResolveByNames(a.province, a.district, a.ward); } catch (e) {}
        if (resolved) {
          if (resolved.province) { payload.provinceCode = resolved.province.c; payload.provinceName = resolved.province.f || resolved.province.n || payload.provinceName; }
          if (resolved.district) { payload.districtCode = resolved.district.c; payload.districtName = resolved.district.f || resolved.district.n || payload.districtName; }
          if (resolved.ward)     { payload.wardCode = resolved.ward.c;         payload.wardName = resolved.ward.f || resolved.ward.n || payload.wardName; }
        }
        return payload;
      },
      applyManualOrderCustomerAddress: function(addressId) {
        var mo = this.manualOrder, c = mo.selectedCustomer;
        var a = (c && c.addresses || []).filter(function(x) { return String(x.address_id) === String(addressId); })[0];
        if (!a) return;
        mo.shipToOther = false; mo.selectedAddressId = a.address_id;
        mo.shipReceiverName = a.receiver_name || mo.customerName || '';
        mo.shipPhone = this._ensureLeadingZeroPhone(a.phone || mo.phone);
        mo.shipAddress = a.address || ''; mo.shipReceiverAddress = '';
        mo.shipProvinceId = a.province_id || ''; mo.shipProvinceName = a.province || '';
        mo.shipDistrictId = a.district_id || ''; mo.shipDistrictName = a.district || ''; mo.shipWardCode = a.ward_code || ''; mo.shipWardName = a.ward || '';
        // 2026-08-12 (v2): resolve name → code qua helper chung để combobox mở District/Ward.
        mo.addr = this._buildAddrPayloadFromAddress(a);
        if (a.province_id && a.district_id && a.ward_code) this._prefillGhnCascade(a);
      },

      // ══════════════════════════════════════════════════════════════════
      // Address picker modal (2026-08-21) — thay khối inline picker cũ
      // ══════════════════════════════════════════════════════════════════
      openAddressPicker: function() {
        var mo = this.manualOrder;
        if (!mo.selectedCustomer) {
          window.MopsAdminCore.showToast('Chọn khách hàng trước rồi mới chọn địa chỉ giao.', 'info');
          return;
        }
        mo.addressPicker.open = true;
        mo.addressPicker.mode = 'list';
        mo.addressPicker.pendingSelectId = mo.selectedAddressId || '';
      },
      closeAddressPicker: function() {
        var ap = this.manualOrder.addressPicker;
        ap.open = false;
        ap.mode = 'list';
        ap.saving = false;
        ap.tempAddr = { provinceCode: '', provinceName: '', districtCode: '', districtName: '', wardCode: '', wardName: '', fullShippingAddress: '', adapters: {} };
        ap.tempStreet = '';
        ap.tempReceiverName = '';
        ap.tempPhone = '';
      },
      switchAddressPickerToAdd: function() {
        var mo = this.manualOrder, ap = mo.addressPicker;
        ap.mode = 'add';
        // Prefill người nhận/SĐT theo khách hiện tại — staff sửa nếu muốn.
        ap.tempReceiverName = (mo.selectedCustomer && mo.selectedCustomer.name) || mo.customerName || '';
        ap.tempPhone = (mo.selectedCustomer && mo.selectedCustomer.phone) || mo.phone || '';
        ap.tempStreet = '';
        ap.tempAddr = { provinceCode: '', provinceName: '', districtCode: '', districtName: '', wardCode: '', wardName: '', fullShippingAddress: '', adapters: {} };
      },
      switchAddressPickerToList: function() {
        this.manualOrder.addressPicker.mode = 'list';
      },
      confirmAddressPicker: function() {
        var ap = this.manualOrder.addressPicker;
        if (!ap.pendingSelectId) return;
        this.applyManualOrderCustomerAddress(ap.pendingSelectId);
        // Clear invalidField nếu trước đó có báo thiếu địa chỉ.
        if (this.manualOrder.invalidField === 'addr' || this.manualOrder.invalidField === 'shipAddress') {
          this.manualOrder.invalidField = null;
        }
        this.closeAddressPicker();
      },
      saveNewAddressFromPicker: function() {
        var self = this, core = window.MopsAdminCore;
        var mo = this.manualOrder, ap = mo.addressPicker;
        var c = mo.selectedCustomer;
        if (!c) { core.showToast('Chưa chọn khách hàng', 'error'); return; }
        if (ap.saving) return;
        var a = ap.tempAddr || {};
        var ghn = (a.adapters && a.adapters.ghn) || {};
        var wardText = a.wardName || '';
        var distText = a.districtName || '';
        var provText = a.provinceName || '';
        if (!(ap.tempStreet || '').trim()) {
          core.showToast('Nhập số nhà / đường trước khi lưu.', 'error');
          return;
        }
        if (!provText.trim() || !wardText.trim()) {
          core.showToast('Chọn đủ Tỉnh — (Huyện) — Xã trước khi lưu.', 'error');
          return;
        }
        ap.saving = true;
        core.gasPost({
          action: 'save_customer_address',
          customer_id: c.customer_id,
          receiver_name: (ap.tempReceiverName || '').trim(),
          phone: (ap.tempPhone || '').trim(),
          address: (ap.tempStreet || '').trim(),
          ward: wardText.trim(), district: distText.trim(), province: provText.trim(),
          province_id: ghn.province || '',
          district_id: ghn.district || '',
          ward_code:   ghn.ward     || '',
          is_default: false  // KHÔNG set default — user chọn thủ công qua radio nếu muốn.
        }).then(function(res) {
          ap.saving = false;
          if (!res || !res.success) throw new Error((res && res.error) || 'Lưu địa chỉ thất bại');
          // Cập nhật sổ địa chỉ trong customer object hiện tại (Vue reactivity trên array replace).
          c.addresses = res.addresses || c.addresses || [];
          // Đồng bộ vào customers.all nếu có (khi FE tải lại danh sách sẽ khớp).
          var list = self.customers && self.customers.all;
          if (Array.isArray(list)) {
            var idx = list.findIndex(function(x) { return String(x.customer_id) === String(c.customer_id); });
            if (idx !== -1) list[idx] = Object.assign({}, list[idx], { addresses: c.addresses });
          }
          var newId = res.address && res.address.address_id;
          if (newId) {
            // Apply luôn địa chỉ mới cho đơn + đóng modal.
            self.applyManualOrderCustomerAddress(newId);
            if (mo.invalidField === 'addr' || mo.invalidField === 'shipAddress') mo.invalidField = null;
            core.showToast('Đã thêm địa chỉ và áp dụng cho đơn.', 'success');
            self.closeAddressPicker();
          } else {
            // Fallback: quay lại list mode để user chọn.
            ap.mode = 'list';
            core.showToast('Đã thêm địa chỉ. Chọn từ danh sách để áp dụng.', 'success');
          }
        }).catch(function(e) {
          ap.saving = false;
          core.showToast(e.message || 'Lỗi kết nối khi lưu địa chỉ', 'error');
        });
      },
      // Áp tên (từ customer.default_address hoặc paste legacy) vào 3 combobox smart-search
      _addrApplyFromNames: function(provinceName, districtName, wardName) {
        var mo = this.manualOrder;
        var resolved = this._addrResolveByNames(provinceName, districtName, wardName);
        if (!resolved) {
          mo.addrProvinceCode = ''; mo.addrProvinceName = provinceName || '';
          mo.addrDistrictCode = ''; mo.addrDistrictName = districtName || '';
          mo.addrWardCode = ''; mo.addrWardName = wardName || '';
          mo.addrProvinceQuery = mo.addrProvinceName;
          mo.addrDistrictQuery = mo.addrDistrictName;
          mo.addrWardQuery = mo.addrWardName;
          return;
        }
        if (resolved.province) {
          mo.addrProvinceCode = resolved.province.c;
          mo.addrProvinceName = resolved.province.f || resolved.province.n || '';
          mo.addrProvinceQuery = mo.addrProvinceName;
        } else { mo.addrProvinceCode = ''; mo.addrProvinceName = provinceName || ''; mo.addrProvinceQuery = mo.addrProvinceName; }
        if (resolved.district) {
          mo.addrDistrictCode = resolved.district.c;
          mo.addrDistrictName = resolved.district.f || resolved.district.n || '';
          mo.addrDistrictQuery = mo.addrDistrictName;
        } else { mo.addrDistrictCode = ''; mo.addrDistrictName = districtName || ''; mo.addrDistrictQuery = mo.addrDistrictName; }
        if (resolved.ward) {
          mo.addrWardCode = resolved.ward.c;
          mo.addrWardName = resolved.ward.f || resolved.ward.n || '';
          mo.addrWardQuery = mo.addrWardName;
        } else { mo.addrWardCode = ''; mo.addrWardName = wardName || ''; mo.addrWardQuery = mo.addrWardName; }
      },
      onWantsShippingToggle: function() {
        if (this.manualOrder.wantsShipping) { this.syncManualOrderShipping(); this.loadGhnProvinces(); }
      },
      /* ── Picker địa chỉ 3 cấp: Goship là hướng chính; GHN/public là nguồn fallback. ── */
      loadGhnProvinces: function() {
        var self = this, core = window.MopsAdminCore, mo = this.manualOrder;
        if (mo.ghnProvinces.length || mo.ghnLoading) return;
        mo.ghnLoading = true;
        core.gasGet({ action: 'ship_provinces' })
          .then(function(d) {
            if (d && d.success && (d.provinces || []).length) {
              mo.ghnLoading = false; mo.addressMasterSource = 'GHN'; mo.ghnProvinces = d.provinces || [];
              return;
            }
            return self.loadPublicShippingAddressData();
          })
          .catch(function() { return self.loadPublicShippingAddressData(); });
      },
      loadPublicShippingAddressData: function() {
        var core = window.MopsAdminCore, mo = this.manualOrder;
        return fetch('https://provinces.open-api.vn/api/?depth=3')
          .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
          .then(function(list) {
            mo.publicAddressData = list || [];
            mo.ghnProvinces = mo.publicAddressData.map(function(p) { return { id: String(p.code), name: p.name }; });
            mo.addressMasterSource = 'PUBLIC';
            mo.ghnLoading = false;
            core.showToast('Đang dùng danh mục hành chính công khai: địa chỉ lưu theo tên chuẩn, phù hợp Goship/GHTK.', 'info');
          })
          .catch(function() {
            mo.ghnLoading = false;
            core.showToast('Không tải được danh sách địa chỉ. Kiểm tra kết nối Internet hoặc cấu hình GHN.', 'error');
          });
      },
      onGhnProvinceChange: function() {
        var self = this, core = window.MopsAdminCore, mo = this.manualOrder;
        var p = mo.ghnProvinces.filter(function(x) { return String(x.id) === String(mo.shipProvinceId); })[0];
        mo.shipProvinceName = p ? p.name : '';
        mo.shipDistrictId = ''; mo.shipDistrictName = ''; mo.shipWardCode = ''; mo.shipWardName = '';
        mo.ghnDistricts = []; mo.ghnWards = []; mo.shippingFee = null;
        if (!mo.shipProvinceId) return;
        if (mo.addressMasterSource === 'PUBLIC') {
          var sourceProvince = mo.publicAddressData.filter(function(x) { return String(x.code) === String(mo.shipProvinceId); })[0];
          mo.ghnDistricts = ((sourceProvince && sourceProvince.districts) || []).map(function(d) { return { id: String(d.code), name: d.name }; });
          return;
        }
        mo.ghnLoading = true;
        core.gasGet({ action: 'ship_districts', province_id: mo.shipProvinceId })
          .then(function(d) { mo.ghnLoading = false; if (d && d.success) mo.ghnDistricts = d.districts || []; })
          .catch(function() { mo.ghnLoading = false; core.showToast('Không tải được quận/huyện GHN.', 'error'); });
      },
      onGhnDistrictChange: function() {
        var self = this, core = window.MopsAdminCore, mo = this.manualOrder;
        var d0 = mo.ghnDistricts.filter(function(x) { return String(x.id) === String(mo.shipDistrictId); })[0];
        mo.shipDistrictName = d0 ? d0.name : '';
        mo.shipWardCode = ''; mo.shipWardName = ''; mo.ghnWards = []; mo.shippingFee = null;
        if (!mo.shipDistrictId) return;
        if (mo.addressMasterSource === 'PUBLIC') {
          var sourceProvince = mo.publicAddressData.filter(function(x) { return String(x.code) === String(mo.shipProvinceId); })[0];
          var sourceDistrict = ((sourceProvince && sourceProvince.districts) || []).filter(function(x) { return String(x.code) === String(mo.shipDistrictId); })[0];
          mo.ghnWards = ((sourceDistrict && sourceDistrict.wards) || []).map(function(w) { return { code: String(w.code), name: w.name }; });
          return;
        }
        mo.ghnLoading = true;
        core.gasGet({ action: 'ship_wards', district_id: mo.shipDistrictId })
          .then(function(d) { mo.ghnLoading = false; if (d && d.success) mo.ghnWards = d.wards || []; })
          .catch(function() { mo.ghnLoading = false; core.showToast('Không tải được phường/xã GHN.', 'error'); });
      },
      onGhnWardChange: function() {
        var mo = this.manualOrder;
        var w = mo.ghnWards.filter(function(x) { return String(x.code) === String(mo.shipWardCode); })[0];
        mo.shipWardName = w ? w.name : '';
        if (mo.addressMasterSource !== 'GHN') { mo.shippingFee = null; return; }
        this.previewShippingFee();
      },
      // Xem trước cước GHN theo quận/xã người nhận + tổng khối lượng giỏ (server tính, weight từ Products gram).
      previewShippingFee: function() {
        var self = this, core = window.MopsAdminCore, mo = this.manualOrder;
        if (!mo.shipDistrictId || !mo.shipWardCode) { mo.shippingFee = null; return; }
        mo.shippingFeeLoading = true;
        var codVal = mo.paymentMethod === 'COD' ? this.manualOrderAmounts.total : 0;
        core.gasPost({ action: 'calc_shipping_fee', to_district_id: mo.shipDistrictId, to_ward_code: mo.shipWardCode, weight: 0, cod_value: codVal })
          .then(function(d) { mo.shippingFeeLoading = false; mo.shippingFee = (d && d.success) ? (d.fee || 0) : null; })
          .catch(function() { mo.shippingFeeLoading = false; mo.shippingFee = null; });
      },
      onManualOrderCustomerFieldInput: function() {
        if (this.manualOrder.selectedCustomer) this.manualOrder.selectedCustomer = null;
      },
      addToManualOrderCart: function(p) {
        // Đa-biến-thể (2026-07-17): giỏ giữ variant_id (khoá thật gửi lên create_order) + variant_title
        // để phân biệt size/mẫu. title đã ghép nhãn biến thể để hiển thị + gửi làm snapshot tên.
        // V2 2026-08-04: bỏ reset itemSearch — catalog persistent, user thường muốn giữ filter.
        // V5 2026-08-04: thêm field line_discount (VND, client-only) — backend createOrder chưa
        // consume per-item discount (mops.md §16.5: cột M/N/O OrderItems có schema nhưng chưa code).
        // Hiển thị input trong cart table để staff quen thao tác + chuẩn bị dữ liệu cho lần backend
        // update sau này. HIỆN TẠI KHÔNG áp vào subtotal — tránh mismatch client/server total.
        var label = (p.title || p.handle) + (p.variant_title ? ' — ' + p.variant_title : '');
        this.manualOrder.cart.push({
          handle: p.handle, variant_id: p.variant_id || '', variant_title: p.variant_title || '',
          title: label, price: p.price, qty: 1, line_discount: 0, image: p.image || '', sku: p.sku || ''
        });
      },
      // openProductEditFromCart — V5 2026-08-04: click icon bút chì trên hàng cart để mở tab Sản
      // phẩm chỉnh biến thể/giá. Cart state (manualOrder.cart, khách, ship…) giữ nguyên trong
      // memory — user click lại "Tạo đơn thủ công" sẽ thấy lại giỏ. TODO tương lai: thêm nút
      // "← Trở về đơn đang tạo" trong products.detail để rút gọn 3 click về 1.
      openProductEditFromCart: function(item) {
        var core = window.MopsAdminCore;
        var key = item.variant_id || item.handle;
        var p = (this.products.all || []).filter(function(x) { return (x.variant_id || x.handle) === key; })[0];
        if (!p) { core.showToast('Sản phẩm không có trong kho MOPS (đã bị gỡ hoặc chỉ tồn tại ở SAPO).', 'error'); return; }
        if (typeof this.openProductEdit !== 'function') { core.showToast('Module Sản phẩm chưa nạp — thử lại sau.', 'error'); return; }
        this.setActiveTab('products');
        this.openProductEdit(p);
      },
      // Click card catalog = checkbox toggle (V2 2026-08-04): có trong giỏ → xoá; chưa có → thêm qty 1.
      // Muốn +1 nữa dùng nút + trên card. Ưu điểm: mapping 1-1 checkbox ↔ trạng thái, không mơ hồ.
      toggleManualOrderCartItem: function(p) {
        var key = p.variant_id || p.handle;
        if (this.manualOrderCartMap[key]) this.removeFromManualOrderCart(key);
        else this.addToManualOrderCart(p);
      },
      removeFromManualOrderCart: function(variantKey) {
        this.manualOrder.cart = this.manualOrder.cart.filter(function(i) { return (i.variant_id || i.handle) !== variantKey; });
      },
      incManualOrderCartQty: function(item) { item.qty++; },
      decManualOrderCartQty: function(item) {
        item.qty--;
        // Fix 2026-08-04: xoá theo variant_id||handle (đúng key đa biến thể), không phải handle trần
        // — trước đây decrement biến thể A về 0 vô ý xoá luôn biến thể B cùng handle.
        if (item.qty <= 0) this.removeFromManualOrderCart(item.variant_id || item.handle);
      },
      onManualOrderSearchBlur: function() {
        var self = this;
        setTimeout(function() {
          if (!self.manualOrder.quickAdd.show) self.manualOrder.itemSearchFocused = false;
        }, 150);
      },
      // Đóng dropdown khách sau blur (delay 150ms để kịp bắt @click/@mousedown chọn khách trong dropdown).
      onManualOrderCustomerBlur: function() {
        var self = this;
        setTimeout(function() { self.manualOrder.customerSearchFocused = false; }, 150);
      },
      /* ── Quick Add — thêm nhanh sản phẩm chưa có, ngay trong modal Tạo đơn ──
         Tái dùng thẳng action create_local_product đã có cho tab Sản phẩm — không thêm backend mới. */
      openManualOrderQuickAdd: function() {
        this.manualOrder.quickAdd = {
          show: true, title: (this.manualOrder.itemSearch || '').trim(),
          price: '', inventoryQty: '', sku: '',
          productType: this.manualOrder.categoryFilter || '', vendor: '', image: '',
          saving: false
        };
      },
      closeManualOrderQuickAdd: function() {
        this.manualOrder.quickAdd.show = false;
      },
      submitManualOrderQuickAdd: function() {
        var self = this;
        var core = window.MopsAdminCore;
        var qa = this.manualOrder.quickAdd;
        var title = (qa.title || '').trim();
        var price = Number(qa.price);
        if (!title) { core.showToast('Vui lòng nhập tên sản phẩm.', 'error'); return; }
        if (isNaN(price) || price < 0) { core.showToast('Giá bán không hợp lệ.', 'error'); return; }
        var inventoryQty = qa.inventoryQty === '' ? 0 : Number(qa.inventoryQty);
        if (isNaN(inventoryQty) || inventoryQty < 0) { core.showToast('Tồn kho ban đầu không hợp lệ.', 'error'); return; }
        var productType = (qa.productType || '').trim();
        var vendor = (qa.vendor || '').trim();
        var image = (qa.image || '').trim();
        qa.saving = true;
        core.gasPost({
          action: 'create_local_product', title: title, price: price, sku: (qa.sku || '').trim(),
          inventory_qty: inventoryQty, product_type: productType, vendor: vendor, image: image
        })
          .then(function(d) {
            qa.saving = false;
            if (!d.success) throw new Error(d.error || 'Tạo sản phẩm thất bại');
            // Thêm ngay vào giỏ + cache products.all (domain Sản phẩm, vẫn ở core) tại chỗ —
            // không loadProducts() lại toàn bộ, giữ nguyên luồng lên đơn đang làm.
            var newProduct = {
              handle: d.handle, product_id: d.product_id, title: title, price: price, sku: (qa.sku || '').trim(),
              status: 'active', in_mops: true, mops_enabled: true, inventory_qty: inventoryQty,
              image: image, product_type: productType, vendor: vendor || 'MOPS Local',
              updated_at: new Date().toISOString(), source: 'LOCAL'
            };
            self.products.all.push(newProduct);
            self.addToManualOrderCart(newProduct);
            core.showToast('Đã tạo và thêm "' + title + '" vào đơn.', 'success');
            self.manualOrder.quickAdd.show = false;
          })
          .catch(function(e) { qa.saving = false; core.showToast(e.message || 'Lỗi kết nối', 'error'); });
      },
      // closeManualOrderForm — V4 2026-08-04: navigate về list/detail thay vì đóng modal.
      // Nếu đang ở workspaceView orders.create/edit → restoreWorkspaceView về list.
      // State manualOrder được reset về _blankManualOrder() (đảm bảo lần mở tiếp không rỉ dữ liệu).
      closeManualOrderForm: function() {
        var hadResult = !!this.manualOrder.result;
        this.manualOrder = this._blankManualOrder();
        if (typeof this.restoreWorkspaceView === 'function') this.restoreWorkspaceView('orders');
        else this.workspaceView = 'orders';
        if (hadResult) this.loadOrders();
      },
      // In hoá đơn — dùng chung cho 2 điểm gọi: ngay sau khi tạo đơn thủ công (còn customerName/
      // phone/cart trong state form) và từ chi tiết đơn ở tab Đơn hàng. `data` được chuẩn hoá về
      // 1 shape trước khi đổ vào #mo-invoice (ngoài Vue, DOM thuần) rồi window.print().
      // 2026-08-24 UNIFIED PRINT — 3 caller (printOrderDetail + printManualOrderResult + printOrderDetailFromResult)
      // trước đây gọi printOrderInvoice(data) legacy dùng DOM inline mo-inv-* + window.print() (in trang admin
      // đè lên UI). Nay đều dùng printSingleOrder(orderId) → fetch qua get_orders_batch → _buildOrderPrintHtml
      // (12-block Sapo-style, khớp bulk print). Đồng nhất giao diện, không còn duplicate template + logic.
      printManualOrderResult: function() {
        var mo = this.manualOrder;
        if (!mo.result || !mo.result.order_id) return;
        this.printSingleOrder(mo.result.order_id);
      },
      printOrderDetail: function() {
        var d = this.orders.detail;
        if (!d || !d.order_id) return;
        this.printSingleOrder(d.order_id);
      },
      // Deep link ngược — từ chi tiết đơn sang Hồ sơ khách hàng (domain Khách hàng), đối xứng với
      // viewOrderFromCustomer() (mixin Customers). openCustomerDrawer() tra theo phone.
      viewCustomerFromOrder: function() {
        var d = this.orders.detail;
        if (!d || !d.customer_phone) return;
        this.setActiveTab('customers');
        this.openCustomerDrawer({ customer_id: d.customer_id, phone: d.customer_phone });
      },
      // Click-to-enlarge QR VietQR — dùng chung cho QR ở chi tiết đơn và QR vừa tạo ở modal Tạo
      // đơn thủ công. Đóng bằng backdrop/nút X/ESC — ESC lắng nghe global ở mounted() (core).
      openQrLightbox: function(url) {
        if (!url) return;
        this.qrLightboxUrl = url;
      },
      closeQrLightbox: function() {
        this.qrLightboxUrl = null;
      },
      applyManualOrderCoupon: function() {
        var self = this;
        var core = window.MopsAdminCore;
        var code = (this.manualOrder.couponCode || '').trim().toUpperCase();
        this.manualOrder.couponPreview = null;
        if (!code) { core.showToast('Vui lòng nhập mã giảm giá.', 'error'); return; }
        this.manualOrder.couponChecking = true;
        core.gasGet({
          action: 'preview_coupon', code: code, total_amount: this.manualOrderAmounts.subtotal,
          // Pha B: gửi giỏ để server tính scope (mã giới hạn theo loại/SP). Server tự resolve giá+loại.
          items: (this.manualOrder.cart || []).map(function(i) { return { handle: i.handle, qty: i.qty }; })
        })
          .then(function(d) {
            self.manualOrder.couponChecking = false;
            if (!d || !d.success) { core.showToast((d && d.error) || 'Không kiểm tra được mã.', 'error'); return; }
            self.manualOrder.couponPreview = d;
            if (!d.valid) core.showToast(d.error, 'error');
            else core.showToast('Đã áp dụng — giảm ' + core.formatMoney(d.discount_amount), 'success');
          })
          .catch(function() { self.manualOrder.couponChecking = false; core.showToast('Lỗi kết nối.', 'error'); });
      },
      // Mirror validate ở createOrder() server (docs/mops.md §16) — báo lỗi sớm phía client, server
      // vẫn chặn lại độc lập.
      manualOrderDiscountValid: function() {
        return true;
      },
      // Nhắc field bắt buộc đang thiếu: toast + tự cuộn tới + focus + tô viền đỏ (qua
      // manualOrder.invalidField, xem template) — dùng chung cho MỌI field bắt buộc trong form
      // Tạo đơn (review UX 2026-07-17: trước đây chỉ set mo.error text tĩnh dễ bị khuất, nhân
      // viên tưởng hệ thống bị đơ khi bấm Tạo đơn không thấy phản hồi gì). Không chặn hẳn việc
      // TẠO ĐƠN như một tính năng — vẫn cho bấm lại bình thường ngay sau khi đã sửa field.
      focusManualOrderField: function(fieldName, refName, message) {
        var self = this;
        this.manualOrder.invalidField = fieldName;
        window.MopsAdminCore.showToast(message, 'error');
        this.$nextTick(function() {
          var el = self.$refs[refName];
          if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.focus(); }
        });
      },
      submitManualOrder: function() {
        var self = this;
        var core = window.MopsAdminCore;
        var mo = this.manualOrder;
        this.manualOrder.error = '';
        this.manualOrder.invalidField = null;
        if (!mo.cart.length) { mo.error = 'Chưa có sản phẩm nào trong đơn.'; return; }
        // 2026-08-16: bỏ 2 input walk-in Tên/SĐT → mọi khách phải chọn từ dropdown hoặc modal
        // "Tạo khách mới". Nếu chưa có customer → guide user chọn/tạo trước, focus ô search.
        if (!(mo.phone || '').trim() || !mo.selectedCustomer) {
          this.focusManualOrderField('phone', 'manualOrderCustomerSearch', 'Vui lòng chọn khách hàng có sẵn hoặc bấm "Tạo khách mới" để tiếp tục');
          return;
        }
        if (mo.orderType !== 'product' && !mo.appointmentDate) {
          this.focusManualOrderField('appointmentDate', 'manualOrderAppointmentDate', 'Vui lòng chọn ngày hẹn để tiếp tục');
          return;
        }
        // 2026-08-20 — Pre-flight cho checkbox "Tạo vận đơn ngay" (COD-only từ 2026-08-30).
        // Đơn sẽ tự openShipModal sau khi tạo → nếu thiếu địa chỉ giao/tên/SĐT thì shipModal
        // sẽ báo "không có carrier nào khả dụng" (shipCarrierCapable=false). Chặn ngay ở đây
        // để không tạo "đơn hụt" phải quay lại chỉnh, đồng bộ pattern focusManualOrderField.
        // Guard thêm paymentMethod==='COD': ô checkbox chỉ hiện với COD (v-if template), nhưng
        // nếu staff tick khi COD rồi đổi sang VIETQR/CASH, cờ này vẫn còn true trong state — không
        // chặn nhầm submit VIETQR/CASH vì lý do của 1 checkbox đã ẩn.
        if (!mo.editingOrderId && mo.openShipmentImmediately && mo.paymentMethod === 'COD') {
          if (!mo.wantsShipping) {
            mo.openShipmentImmediately = false;
            core.showToast('Đã tắt "Tạo vận đơn ngay" vì đơn không giao hàng.', 'info');
          } else {
            var addr = mo.addr || {};
            var receiverName = (mo.shipToOther ? mo.shipReceiverName : mo.customerName) || '';
            var receiverPhone = (mo.shipToOther ? mo.shipPhone : mo.phone) || '';
            var streetAddr = (mo.shipToOther && mo.shipReceiverAddress) ? mo.shipReceiverAddress : mo.shipAddress;
            if (!String(receiverName).trim()) {
              this.focusManualOrderField('shipReceiverName', 'manualOrderShipReceiverName', 'Tạo vận đơn ngay: cần tên người nhận.');
              return;
            }
            if (!String(receiverPhone).trim()) {
              this.focusManualOrderField('shipPhone', 'manualOrderShipPhone', 'Tạo vận đơn ngay: cần SĐT người nhận.');
              return;
            }
            if (!String(streetAddr || '').trim()) {
              this.focusManualOrderField('shipAddress', 'manualOrderShipAddress', 'Tạo vận đơn ngay: cần số nhà / đường.');
              return;
            }
            if (!addr.provinceName || !addr.districtName || !addr.wardName) {
              this.focusManualOrderField('addr', 'manualOrderAddrPicker', 'Tạo vận đơn ngay: cần chọn đủ Tỉnh / Huyện / Xã.');
              return;
            }
          }
        }
        var discountValue = Number(mo.discountValue) || 0;
        var couponCode    = (mo.couponCode || '').trim();
        if (couponCode && discountValue > 0) {
          mo.error = 'Không thể áp dụng đồng thời mã giảm giá và chiết khấu thủ công/Khách Sỉ.'; return;
        }
        // Payload dùng chung cho tạo & sửa (SP/khách/hẹn/chiết khấu/giao hàng). Riêng phần khác nhau
        // (action, order_id, reason, branch_id, payment_method) gắn thêm ở từng nhánh bên dưới.
        var body = {
          items: mo.cart.map(function(i) { return { handle: i.handle, variant_id: i.variant_id || '', quantity: i.qty }; }),
          customer_name: mo.customerName,
          phone: mo.phone,
          note: mo.note,
          internal_note: mo.internal_note || '', // 2026-08-23 ghi chú nội bộ staff (không in tem/hóa đơn)
          order_type: mo.orderType,
          appointment_date: mo.appointmentDate,
          appointment_time: mo.appointmentTime,
          coupon_code: couponCode,
          order_discount_type: mo.discountType,
          order_discount_value: discountValue,
          order_discount_reason: (mo.discountReason || '').trim(),
          customer_shipping_fee: mo.wantsShipping ? (Number(mo.customerShippingFee) || 0) : 0,
          customer_shipping_fee_manual: !!(mo.wantsShipping && mo.customerShippingFeeManual),
          // Người nhận mặc định = Khách hàng (2026-08-05, sau khi gộp UI Khách hàng + Vận chuyển).
          // shipReceiverName/shipPhone chỉ khác customerName/phone khi user mở "Giao cho người khác".
          ship_receiver_name: mo.wantsShipping ? ((mo.shipReceiverName || mo.customerName || '').trim()) : '',
          ship_phone: mo.wantsShipping ? ((mo.shipPhone || mo.phone || '').trim()) : '',
          // shipReceiverAddress override khi shipToOther=true — chỉ ảnh hưởng "số nhà/đường"
          // của người nhận, không đụng shipAddress (địa chỉ khách gốc). Rỗng → fallback shipAddress.
          ship_address: mo.wantsShipping ? (((mo.shipToOther && mo.shipReceiverAddress) || mo.shipAddress || '').trim()) : '',
          // Địa chỉ giao GHN — gửi cả TÊN (hiển thị/lưu) và MÃ (id/code cho GHN tạo vận đơn).
          // 2026-08-12: đọc từ mo.addr (payload từ <mops-address-picker>). Fallback shipXxxName
          // cho các row edit đơn cũ (khi mo.addr chưa được populate từ order response).
          ship_province:     mo.wantsShipping ? ((mo.addr && mo.addr.provinceName) || mo.shipProvinceName || '') : '',
          ship_district:     mo.wantsShipping ? ((mo.addr && mo.addr.districtName) || mo.shipDistrictName || '') : '',
          ship_ward:         mo.wantsShipping ? ((mo.addr && mo.addr.wardName) || mo.shipWardName || '') : '',
          // Mã hành chính chuẩn GSO (MopsAddressMaster) — nguồn sự thật MỚI. GAS lưu vào
          // ShippingAddresses (K/L/M) & Customers khi save_customer_address=true. Adapter
          // ID hãng (GHN…) suy ra qua master.ghn lookup nếu cần.
          province_code:     mo.wantsShipping ? ((mo.addr && mo.addr.provinceCode) || '') : '',
          district_code:     mo.wantsShipping ? ((mo.addr && mo.addr.districtCode) || '') : '',
          ward_code:         mo.wantsShipping ? ((mo.addr && mo.addr.wardCode) || '') : '',
          // Chuỗi hiển thị đầy đủ (tương thích ngược module vận chuyển/Sapo cũ vốn đọc 1 string)
          full_shipping_address: mo.wantsShipping ? this.manualOrderFullShippingAddress : '',
          // Legacy GHN adapter — chỉ ghi khi picker lấy từ GHN. Không dùng khi source=MASTER.
          ship_province_id:  mo.wantsShipping && mo.addressMasterSource === 'GHN' ? (mo.shipProvinceId || '') : '',
          ship_district_id:  mo.wantsShipping && mo.addressMasterSource === 'GHN' ? (mo.shipDistrictId || '') : '',
          ship_ward_code:    mo.wantsShipping && mo.addressMasterSource === 'GHN' ? (mo.shipWardCode || '') : ''
          ,save_customer_address: mo.wantsShipping && mo.saveCustomerAddress
        };

        if (mo.editingOrderId) {
          body.action        = 'update_order';
          body.order_id      = mo.editingOrderId;
          body.reason        = (mo.editReason || '').trim();
          // 2026-08-10 OCC: gửi _version từ detail đã load. Server so khớp, khác = throw OCC_CONFLICT.
          if (mo._editingOrderVersion) body._version = mo._editingOrderVersion;
          // submitManualOrder() luôn refresh list và gọi get_order() để render lại detail, nên không
          // yêu cầu server dựng thêm snapshot cùng request update_order.
          body.return_order  = false;
          body.clear_shipping = !mo.wantsShipping; // gỡ địa chỉ giao nếu tắt vận chuyển
          // Chỉ gửi payment_method khi user thật sự đổi (2026-07-28) — no-op guard tránh backend chạy
          // nhánh methodChanged trong updateOrder cho request không định đổi. Backend vẫn tự re-guard
          // (isPaid/CASH/bank config); FE gửi bổ sung là để 1 request cover cả sửa đơn + đổi method.
          var curMethod = String(mo.paymentMethod || '').toUpperCase();
          var origMethod = String(mo.origPaymentMethod || '').toUpperCase();
          if (curMethod && origMethod && curMethod !== origMethod) {
            body.payment_method = curMethod;
          }
        } else {
          body.action         = 'create_order_admin';
          body.branch_id      = mo.branchId;
          body.payment_method = mo.paymentMethod || 'VIETQR';
          body.source         = 'mops-admin';
        }

        // V4 2026-08-04: bỏ overlay spinner busy-card; navigate ngay + persistent toast Đang xử lý.
        // Response tới sẽ replace toast bằng success/error. Trên success → mở orders.detail của
        // đơn mới nhất (kèm timestamp URL param để _updateUrlParam bust cache) + reset form.
        // Trên failure → giữ state form, quay lại workspaceView create/edit để user thử lại.
        // V5 2026-08-04: chèn optimistic pending row vào đầu orders.list ngay khi bấm Tạo đơn
        // để user thấy đơn đang xử lý (thay vì list cũ trống — feedback "đơn đâu?"). Row có
        // marker __pending → template render skeleton style + click disabled. Khi response OK
        // loadOrders() sẽ replace list (xoá temp luôn). Khi lỗi → filter thủ công.
        var isEdit = !!mo.editingOrderId;
        var fromView = isEdit ? 'orders.edit' : 'orders.create';
        var editOrderId = mo.editingOrderId;
        var pendingTempId = null;
        this.manualOrder.submitting = true;
        this.manualOrder.error = '';
        core.showToast(isEdit ? 'Đang xử lý lưu đơn…' : 'Đang xử lý tạo đơn…', 'info', { duration: 0 });
        // Navigate ngay: create → về danh sách đơn (list); edit → về chi tiết đơn đang sửa.
        if (isEdit) {
          if (typeof this.restoreWorkspaceView === 'function') this.restoreWorkspaceView('orders.detail');
          else this.workspaceView = 'orders.detail';
          this.orders.expandedId = editOrderId;
        } else {
          if (typeof this.restoreWorkspaceView === 'function') this.restoreWorkspaceView('orders');
          else this.workspaceView = 'orders';
          // Chèn pending row vào đầu list (chỉ luồng create — edit đã có expanded detail để nhìn).
          pendingTempId = '__pending_' + Date.now();
          var totalQty = mo.cart.reduce(function(s, i) { return s + Number(i.qty || 0); }, 0);
          var productSummary = mo.cart.map(function(i) { return (i.title || i.handle || '?') + ' ×' + (i.qty || 1); }).join(' · ');
          var pendingRow = {
            __pending: true,
            order_id: pendingTempId,
            customer_name: (mo.customerName || (mo.selectedCustomer && mo.selectedCustomer.name) || '').trim() || 'Khách lẻ',
            customer_phone: (mo.phone || '').trim(),
            product_summary: productSummary,
            total_quantity: totalQty,
            total_amount: this.manualOrderAmounts.total,
            amount: this.manualOrderAmounts.total,
            customer_shipping_fee: this.manualOrderAmounts.fee || 0,
            status: 'PENDING',
            payment_method: mo.paymentMethod || 'VIETQR',
            fulfillment_status: '',
            created_at: new Date().toISOString()
          };
          this.orders.list = [pendingRow].concat(this.orders.list || []);
        }
        core.gasPost(body)
          .then(function(d) {
            self.manualOrder.submitting = false;
            if (!d || !d.success) {
              // Rollback: xoá temp row + về lại form (state manualOrder còn nguyên) + toast lỗi.
              if (pendingTempId) {
                self.orders.list = (self.orders.list || []).filter(function(o) { return o.order_id !== pendingTempId; });
              }
              var _emsg = String((d && d.error) || (isEdit ? 'Sửa đơn thất bại.' : 'Tạo đơn thất bại.'));
              // 2026-08-10 OCC: bắt riêng conflict → reload detail để lấy _version mới rồi báo staff sửa lại.
              if (_emsg.indexOf('OCC_CONFLICT') !== -1 && isEdit) {
                core.showToast('Đơn đã được cập nhật ở nơi khác. Đang tải lại nội dung mới nhất — kiểm tra rồi sửa lại.', 'warning', { duration: 6000 });
                if (typeof self.openWorkspaceView === 'function') self.openWorkspaceView(fromView);
                else self.workspaceView = fromView;
                if (editOrderId) self.toggleOrderDetail(editOrderId, true);
                self.loadOrders();
                return;
              }
              self.manualOrder.error = _emsg;
              if (typeof self.openWorkspaceView === 'function') self.openWorkspaceView(fromView);
              else self.workspaceView = fromView;
              core.showToast(self.manualOrder.error, 'error');
              return;
            }
            var newId = d.order_id || editOrderId;
            var warnings = (d.warnings || []);
            // 2026-08-08 — checkbox "Đã nhận tiền, xác nhận thanh toán ngay": lưu cờ TRƯỚC khi
            // reset form (blank sẽ set về false). Chỉ áp cho luồng tạo mới (!isEdit) + CASH/VIETQR
            // (form đã ẩn checkbox với COD). Sau reset, ngay dưới cùng handler sẽ gọi
            // update_order_status PAID nếu cờ này bật.
            var wantConfirmPaid = !isEdit && !!mo.confirmPaymentImmediately && mo.paymentMethod !== 'COD';
            // 2026-08-08 — checkbox "Tạo vận đơn ngay": mở modal sau khi có order_id. Từng mở
            // rộng 2026-08-20 sang VIETQR, thu hồi lại COD-only ở 2026-08-30: Alt+P chỉ thật sự
            // điều khiển checkbox này khi COD (khi VIETQR phím đó lại toggle checkbox "Xác nhận
            // thanh toán ngay"), và VIETQR chưa chắc đã được chuyển khoản nên ép điền đủ địa chỉ
            // giao hàng ngay lúc tạo đơn là dư — trang chi tiết đơn đã có sẵn nút "Tạo vận đơn".
            var wantOpenShipment = !isEdit && !!mo.openShipmentImmediately && mo.paymentMethod === 'COD';
            // Reset form state (kể cả cart) — thành công không cần giữ nữa.
            self.manualOrder = self._blankManualOrder();
            // Hiển thị kết quả ghi ngay từ response. Không gọi loadOrders()+get_order() nối tiếp
            // trên critical path: hai request GAS này từng làm một thao tác ghi phải chờ thêm 5-15s.
            // Refresh nền để đồng bộ các field do server/trigger bổ sung; khi người dùng mở lại
            // detail, toggleOrderDetail() vẫn đọc get_order và là nguồn dữ liệu cuối cùng.
            if (newId && isEdit) {
              var currentDetail = self.orders.detail || {};
              self.orders.detail = Object.assign({}, currentDetail, {
                order_id: newId,
                customer_name: mo.customerName,
                customer_phone: mo.phone,
                customer_note: mo.note,
                internal_note: mo.internal_note || '', // 2026-08-23 optimistic snapshot
                order_type: mo.orderType,
                total_amount: d.total_amount != null ? d.total_amount : currentDetail.total_amount,
                payment_method: mo.paymentMethod || currentDetail.payment_method,
                __optimistic: true,
                __snapshot: true
              });
              self.orders.detailStore[newId] = { data: self.orders.detail, loadedAt: Date.now(), optimistic: true };
            } else if (newId && pendingTempId) {
              self.orders.list = (self.orders.list || []).map(function(row) {
                if (row.order_id !== pendingTempId) return row;
                return Object.assign({}, row, {
                  order_id: newId,
                  __pending: false,
                  __optimistic: true,
                  total_amount: d.total_amount != null ? d.total_amount : row.total_amount,
                  amount: d.total_amount != null ? d.total_amount : row.amount,
                  payment_method: d.payment_method || row.payment_method,
                  status: d.status || row.status
                });
              });
            }
            // Background reconciliation is deliberately delayed outside the response path.
            setTimeout(function() { self.loadOrders(); }, 800);
            // Toast success (auto-dismiss 3.5s). Warnings → info toast tiếp theo (chồng lên).
            var totalStr = d.total_amount != null ? (' · ' + core.formatMoney(d.total_amount)) : '';
            core.showToast((isEdit ? 'Đã lưu ' : 'Đã tạo ') + (newId || '') + totalStr, 'success');
            if (warnings.length) {
              setTimeout(function() { core.showToast('⚠ ' + warnings.join(' · '), 'info', { duration: 6000 }); }, 400);
            }
            // 2026-08-08 — flow "Tạo + xác nhận thanh toán ngay": gọi tuần tự update_order_status
            // PAID (FE-only, không đụng backend). Best-effort: nếu fail thì đơn giữ PENDING và
            // toast warning, staff có thể vào detail bấm nút "Xác nhận đã trả" như thường lệ.
            // Row optimistic ở list được patch status='PAID' ngay để badge đổi, loadOrders sau 800ms
            // sẽ đồng bộ với server (kể cả trường hợp GAS đã ghi PAID nhưng response chậm).
            if (wantConfirmPaid && newId) {
              // 3-Axis (2026-08-09): POS tại quầy (wantsShipping=false) → chốt cả 3 trục Payment+Fulfillment+Order.
              // Đơn giao hàng (wantsShipping=true) chỉ chốt Payment (kho vẫn phải đóng gói/gửi ĐVVC).
              var isPosCounter = !mo.wantsShipping;
              core.gasPost({ action: 'update_order_status', order_id: newId, status: 'PAID' })
                .then(function(r) {
                  if (r && r.success) {
                    self.orders.list = (self.orders.list || []).map(function(row) {
                      return row.order_id === newId ? Object.assign({}, row, { status: 'PAID' }) : row;
                    });
                    if (isPosCounter) {
                      // POS quầy: chain update_fulfillment_status='delivered' rồi update_order_status='COMPLETED'
                      // (không dùng 'fulfilled' vì backend enum FULFILLMENT_STATUSES chỉ có 'delivered').
                      // Best-effort: nếu step nào fail, toast INFO — không rollback (đơn đã ghi PAID rồi).
                      return core.gasPost({ action: 'update_fulfillment_status', order_id: newId, fulfillment_status: 'delivered' })
                        .then(function(r2) {
                          if (r2 && r2.success) {
                            self.orders.list = (self.orders.list || []).map(function(row) {
                              return row.order_id === newId ? Object.assign({}, row, { fulfillment_status: 'delivered' }) : row;
                            });
                            return core.gasPost({ action: 'update_order_status', order_id: newId, status: 'COMPLETED' });
                          }
                          return { success: false, error: (r2 && r2.error) || 'Không set được Fulfillment' };
                        })
                        .then(function(r3) {
                          if (r3 && r3.success) {
                            self.orders.list = (self.orders.list || []).map(function(row) {
                              return row.order_id === newId ? Object.assign({}, row, { status: 'COMPLETED' }) : row;
                            });
                            core.showToast('POS · Đã chốt đơn ' + newId + ' (Đã TT · Đã giao · Hoàn tất)', 'success');
                          } else {
                            core.showToast('Đơn đã PAID nhưng chưa Hoàn tất được: ' + ((r3 && r3.error) || 'lỗi').substring(0,80) + '. Vào chi tiết đơn để cập nhật trạng thái tay.', 'info', { duration: 8000 });
                          }
                          setTimeout(function() { self.loadOrders(); }, 400);
                        });
                    } else {
                      core.showToast('Đã xác nhận thanh toán · ' + newId, 'success');
                      setTimeout(function() { self.loadOrders(); }, 400);
                    }
                  } else {
                    core.showToast('Đơn đã tạo nhưng chưa xác nhận thanh toán được: ' + ((r && r.error) || 'lỗi không xác định') + '. Bấm "Xác nhận đã trả" ở chi tiết đơn để thử lại.', 'info', { duration: 8000 });
                  }
                })
                .catch(function() {
                  core.showToast('Đơn đã tạo nhưng lỗi mạng khi xác nhận thanh toán. Vào chi tiết đơn bấm "Xác nhận đã trả" để thử lại.', 'info', { duration: 8000 });
                });
            }
            // 2026-08-08 — COD "tạo + tạo vận đơn ngay": đợi get_order xong (fulfillment='pending_packing'
            // vì STAFF-COD tự vào bước này, xem createOrder mops_02.js:400) rồi mở modal Tạo vận đơn.
            // 600ms guard vì list_orders + get_order chưa xong ngay sau create response — nếu mở modal
            // sớm, orders.detail rỗng → shipModal validation fail. Best-effort: nếu vẫn chưa có detail
            // thì bỏ qua, toast hướng dẫn mở tay.
            if (wantOpenShipment && newId) {
              core.gasGet({ action: 'get_order', order_id: newId })
                .then(function(r) {
                  // getOrder() trả object phẳng (order_id/items/... ở top-level qua _ok()), không có
                  // field `.order` lồng — kiểm tra `r.order` trước đây luôn false, nhánh mở modal Tạo
                  // vận đơn tự động sau khi tạo đơn COD không bao giờ chạy (bug phát hiện 2026-09-04).
                  if (r && r.success && r.order_id) {
                    self.orders.detail = r;
                    self.orders.expandedId = newId;
                    if (typeof self.openShipModal === 'function') {
                      self.openShipModal(r);
                      core.showToast('Đã mở modal Tạo vận đơn cho ' + newId, 'info');
                    }
                  } else {
                    core.showToast('Đơn tạo xong nhưng không mở được modal vận đơn. Bấm "Tạo vận đơn" ở chi tiết đơn để thử lại.', 'info', { duration: 8000 });
                  }
                })
                .catch(function() {
                  core.showToast('Đơn tạo xong nhưng lỗi mạng khi mở modal vận đơn. Vào chi tiết đơn bấm "Tạo vận đơn" để thử lại.', 'info', { duration: 8000 });
                });
            }
          })
          .catch(function() {
            self.manualOrder.submitting = false;
            // V5: xoá temp pending row khi lỗi mạng (loadOrders sẽ không được gọi ở nhánh này).
            if (pendingTempId) {
              self.orders.list = (self.orders.list || []).filter(function(o) { return o.order_id !== pendingTempId; });
            }
            self.manualOrder.error = 'Lỗi kết nối. Vui lòng thử lại.';
            if (typeof self.openWorkspaceView === 'function') self.openWorkspaceView(fromView);
            else self.workspaceView = fromView;
            core.showToast('Lỗi kết nối. Vui lòng thử lại.', 'error');
          });
      }
    }
  });
})();
