/* ── page_home.scss.bwt ─ Homepage Styles ── */


/* ══════════════════════════════════════════
   HOMEPAGE LEGACY (index.scss)
   ══════════════════════════════════════════ */

@mixin ulwebkit() {
	ul{
		scrollbar-face-color: #367CD2;
		scrollbar-shadow-color: #FFFFFF;
		scrollbar-highlight-color: #FFFFFF;
		scrollbar-3dlight-color: #FFFFFF;
		scrollbar-darkshadow-color: #FFFFFF;
		scrollbar-track-color: #FFFFFF;
		scrollbar-arrow-color: #FFFFFF;
		scrollbar-width: none;
	}


	ul::-webkit-scrollbar {
		width: 0;
		height: 0;
	}


	ul::-webkit-scrollbar-track {
		-webkit-box-shadow: none; 
		-webkit-border-radius: 0;
		border-radius: 0;
		height:0;
	}


	ul::-webkit-scrollbar-thumb {
		-webkit-border-radius: 0;
		border-radius: 0;
		background: rgba(255,0,0,0.8); 
		-webkit-box-shadow: none; 
	}
}
@mixin button() {

	.grad-left {
		position:absolute;
		top: calc(50% - 12px);
		left:0;
		z-index:3;
		width: 24px;
		display: flex;
		justify-content: start;
		align-items: center;
		svg {
			transform: rotate(180deg);
			path {
				stroke: var(--mainColor);
			}
			rect {
				fill: var(--mainColor);
			}
		}
	}
	.grad-right {
		position:absolute;
		top: calc(50% - 12px);
		z-index:3;
		right:0;
		width: 24px;
		display: flex;
		justify-content: end;
		align-items: center;
		svg {
			path {
				stroke: var(--mainColor);
			}
			rect {
				fill: var(--mainColor);
			}
		}
	}
	.button {
		cursor: pointer;
	}
}
@mixin controlswiper(){
	.swiper-pagination-bullets{
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 4px;
		.swiper-pagination-bullet{
			box-shadow: none;
			outline: 0;
			width: 10px;
			height: 10px;
			border: 1px solid #ddd;
			border-radius: 50%;
			background: rgba(255, 255, 255 ,0.2);
			padding: 0;
			font-size: 0;
			opacity: 1;
			&.swiper-pagination-bullet-active{
				transition: all .2s;
				background: var(--mainColor);
			}
		}
	}
	.swiper-button-next{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		right: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(32px , -50%);
		-ms-transform: translate(32px, -50%);
		transform: translate(32px, -50%);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%);
		transform: translateY(-50%);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	.swiper-button-prev{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		left: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(-32px, -50%) rotate(180deg);
		-ms-transform: translate(-32px, -50%) rotate(180deg);
		transform: translate(-32px, -50%) rotate(180deg);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%) rotate(180deg);
		transform: translateY(-50%) rotate(180deg);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	@media(max-width: 767px) {
		.swiper-button-next,.swiper-button-prev{
			width: 25px;
			height: 25px;
			line-height: 25px;
			&:after {
				font-size: var(--fs-sm);
			}
		}
	}
	.swiper-button-lock {
		display: none !important;
	}
	.swiper-button-disabled{
		opacity: 0.35;
	}
}

@keyframes fadeInUp {
	0% {
		opacity: 0;
		-webkit-transform: translate3d(0px,50px,0px);
		-moz-transform: translate3d(0px,50px,0px);
		transform: translate3d(0px,50px,0px)
	}

	100% {
		opacity: 1;
		-webkit-transform: translate3d(0px,0px,0px);
		-moz-transform: translate3d(0px,0px,0px);
		transform: translate3d(0px,0px,0px)
	}
}
@keyframes snakeItem {
	50% {
		-webkit-transform: translate(0,-8px);
		-moz-transform: translate(0,-8px);
		-o-transform: translate(0,-8px);
		transform: translate(0,-8px)
	}
}

@-webkit-keyframes animationDuoi {
	0% {
		-webkit-transform: rotate(0deg);
		transform: rotate(0deg)
	}

	to {
		-webkit-transform: rotate(20deg);
		transform: rotate(20deg)
	}
}

/*============================================================================
COMMON INDEX
==============================================================================*/

.section-index {
	padding: 30px 0;
	@media (max-width: 767px) {
		padding: 25px 0;
	}
	.section-title {
		text-align: center;
		position: relative;
		margin-bottom: 25px;
		&.a-left {
			text-align: left;
		}
		&.txt-uppercese {
			text-transform: uppercase;
		}
		h2 {
			display: inline-block;
			font-weight: 500;
			font-size: 1.875rem;
			margin-bottom: 0px;
			color: var(--mainColor);
			@media (max-width: 1025px) {
				font-size: 1.5rem;
			}
			@media (max-width: 767px) {
				font-size: 1.25rem;
			}
			a {
				color: var(--mainColor);
				&:hover, &:focus{
					color: var(--subColor);
				}
			}
			span {
				font-weight: bold;
				display: block;
				position: relative;
				padding-bottom: 5px;
				&:before {
					content: "";
					position: absolute;
					height: 5px;
					border-radius: 5px;
					width: 100%;
					background-color: var(--subColor);
					left: 0px;
					bottom: 0px;
				}
			}
		}
	}
}

/*============================================================================
SECTION
==============================================================================*/
.section_slider {
	margin-top: 30px;
	margin-bottom: 30px;
	@media(max-width: 767px) {
		margin-top: 25px;
		margin-bottom: 25px;
	}
	.swiper-container {
		position: relative;
		@include controlswiper();
		overflow: hidden;
		border-radius: 10px;
		.swiper-pagination.swiper-pagination-clickable.swiper-pagination-bullets {
			bottom: 10px;
			min-height: 10px;
		}
		.swiper-slide {
			background: #fff;
			overflow: hidden;
			border-radius: 10px;
			aspect-ratio: {{settings.slider_width | default: 900 }}/{{settings.slider_height | default: 342 }};
			img {
				width: 100%;
			}
		}
	}
	@media (max-width: 767px) {
		margin-bottom: 20px !important;
	}
	.banner_slide {
		position: relative;
		@media(max-width: 767px) {
			margin-top: 14px;
			float: left;
			float: left;
			display: inline-block;
			width: calc(50% - 7px);
			&:last-child {
				margin-left: 14px;
			}
		}
		.a_banner {
			position: relative;
			display: block;
			overflow: hidden;
			border-radius: 10px;
			&:before {
				position: absolute;
				top: 50%;
				left: 50%;
				z-index: 2;
				display: block;
				content: '';
				width: 0;
				height: 0;
				background: rgba(255,255,255,.2);
				border-radius: 100%;
				-webkit-transform: translate(-50%, -50%);
				transform: translate(-50%, -50%);
				opacity: 0;
			}
			&:hover::before {
				-webkit-animation: circle .75s;
				animation: circle .75s;
			}
			&.a_banner_1 {
				margin-bottom: 20px;
			}
		}
	}
}
.section_tien_ich {
	position: relative;
	.list_tien_ich{
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;

		.item_tien_ich {
			width: calc((100% - 24px) / 2);
			width: -moz-calc((100% - 24px)/ 2);
			width: -webkit-calc((100% - 24px) / 2);
			width: -o-calc((100% - 24px)/ 2);
			margin-bottom: 24px;
			display: flex;
			cursor: pointer;

			@media(max-width: 767px) {
				width: calc((100% - 14px) / 2);
				width: -moz-calc((100% - 14px)/ 2);
				width: -webkit-calc((100% - 14px) / 2);
				width: -o-calc((100% - 14px)/ 2);
			}
			&:nth-child(1) {
				.item-info {
					border-radius: 40px 40px 0px 40px;
				}
				&.active, &:hover, &:focus {
					.item-info {
						background-color: var(--mainColor);
						color:#fff;
						.icon_tienich img{
							filter: brightness(0) invert(1);
						}
						.actions_tienich {
							a {
								color: #fff;
								svg {
									path {
										fill:#fff;
									}
								}
							}
						}
					}
				}
			}
			&:nth-child(2) {
				.item-info {
					border-radius: 40px 40px 40px 0px;
				}
				&.active, &:hover, &:focus {
					.item-info {
						background-color: var(--subColor);
						color:#fff;
						.icon_tienich img{
							filter: brightness(0) invert(1);
						}
						.actions_tienich {
							a {
								color: #fff;
								svg {
									path {
										fill:#fff;
									}
								}

							}
						}
					}
				}
			}
			&:nth-child(3) {
				.item-info {
					border-radius: 40px 0px 40px 40px;
				}
				&.active, &:hover, &:focus {
					.item-info {
						background-color: var(--subColor);
						color:#fff;
						.icon_tienich img{
							filter: brightness(0) invert(1);
						}
						.actions_tienich {
							a {
								color: #fff;
								svg {
									path {
										fill:#fff;
									}
								}

							}
						}
					}
				}
			}
			&:nth-child(4) {
				.item-info {
					border-radius: 0px 40px 40px 40px;
				}

				&.active, &:hover, &:focus {
					.item-info {
						background-color: var(--mainColor);
						color:#fff;
						.icon_tienich img{
							filter: brightness(0) invert(1);
						}
						.actions_tienich {
							a {
								color: #fff;
								svg {
									path {
										fill:#fff;
									}
								}

							}
						}
					}
				}
			}
			.item-info {
				box-shadow: -3px 6px 28px rgba(0, 0, 0, 0.08);
				border-radius: 10px;
				background-color: #fff;
				font-size: var(--fs-sm);
				line-height: 24px;
				padding: 20px 16px;
				-webkit-transition: 0.2s;
				-o-transition: 0.2s;
				transition: 0.2s;
				width: 100%;
				display: flex;
				flex-direction: column;
				position: relative;
				.opacity_tienich{
					position: absolute;
					top: 0px;
					left: 0px;
					width: 100%;
					height: 100%;
					background-color: transparent;
					z-index: 1;
				}
				@media (max-width: 767px) {
					padding: 14px 10px;
				}
				.icon_tienich{
					width: 48px;
					height: 48px;
					display: flex;
					justify-content: center;
					align-items: center;
					margin-bottom: 10px;
					@media (max-width: 767px) {
						width: 40px;
						height: 40px;
					}
					img {
						max-width: 100%
					}
				}
				.title_tienich {
					font-size: var(--fs-lg);
					min-height: 24px;
					margin-bottom: 10px;
				}
				.des_tienich {
					display: block;
					margin-bottom: 10px;
				}
				.actions_tienich {
					text-align: right;
					display: flex;
					justify-content: flex-end;
					margin-top: auto;
					position: relative;
					z-index: 2;
					a {
						display: flex;
						align-items: center;
						color: var(--mainColor);
						width: fit-content;
						font-size: var(--fs-lg);
						font-weight: 600;
						text-decoration: underline;
						@media (max-width: 767px) {
							font-size: var(--fs-md);
						}
						svg {
							width: 16px;
							height:16px;
							margin-left: 5px;
							path {
								fill:var(--mainColor);
							}
						}
					}
				}
			}
		}
	}
	.row {
		align-items: center;
	}
	.banner_tien_ich{
		display: block;
		aspect-ratio: 704 / 617;
		position: relative;
	}
}
.section_services {
	position: relative;
	.promo-box {
		.promo-item {
			display: flex;
			flex-flow: column;
			align-items: center;
			justify-content: flex-start;
			grid-gap: 0px;
			@media (max-width: 992px) {
				margin-bottom: 15px;
			}
			.icon{
				width: 60px;
				height: 60px;
				position: relative;
				display: inline-block;
				border: 1px solid var(--subColor);
				background-color:#fff;
				border-radius: 50%;
				padding: 10px;
				margin-bottom: 10px;
				&::after {
					content: "";
					width: 54px;
					height: 54px;
					display: block;
					border-radius: 50%;
					position: absolute;
					top: 2px;
					left: 2px;
					background-color: var(--bgBodySub);
				}
				img {
					position: relative;
					z-index: 2;

				}
			}
			.info{
				text-align: center;
				display: flex;
				flex-flow: column;
				justify-content: center;
				margin-bottom: 0px;
				margin-top: 0;
				h3 {
					font-size: var(--fs-lg);
					font-weight: 700;
					margin: 0px;
					margin-bottom: 3px;
					line-height: 1.4;
					margin-bottom: 5px;
					@media (max-width: 992px) {
						font-size: var(--fs-md);
						text-align: center;
					}
				}
				span {
					font-size: var(--fs-md);
					display: block;
					opacity: .75;
					line-height: 1.4;
					@media (max-width: 992px) {
						font-size: var(--fs-sm);
						text-align: center;
					}
				}

			}
		}
	} 
}
.section_coupons{
	.swiper_coupons{
		@include controlswiper();
		.swiper-slide {
			height: auto;
			.box-coupon {
				display: flex;
				align-items: center;
				border-radius: 4px;
				padding: 0px;
				position: relative;
				height: 100%;
				max-width: 100%;
				.image{
					width: 70px;
					height: 95px;
					display: flex;
					position: relative;
					flex:none;
					flex-grow: 0;
					background: var(--bgBodySub);
					border: 1px solid var(--bgBodySub);
					border-radius: 8px;
					padding: 7px;
					justify-content: center;
					align-items: center;
					margin-right: 5px;
					img{
						height: 50px;
						width: 50px;
					}
				}
				.content_wrap{
					flex-grow: 1;
					display: flex;
					flex-direction: column;
					padding-left: 12px;
					position: relative;
					width: 100%;
					height: 95px;
					justify-content: space-between;
					background: var(--bgBodySub);
					border: 1px solid var(--bgBodySub);
					border-radius: 8px;
					padding: 7px;
					.content-top{
						font-size: var(--fs-lg);
						font-weight: 700;
						span{
							font-size: var(--fs-sm);
							color: #444;
							font-weight: 500;
						}
						@media(max-width: 350px){
							font-size: var(--fs-md);
							span{
								font-size: var(--fs-xs); /* TODO confirm - rounded from 10px */
							}
						}
					}
					.content-bottom{
						display: flex;
						align-items: center;
						justify-content: space-between;
						gap: 4px;
						span{
							font-size: 0.625rem; /* below-scale, intentional */
							font-weight: 500;
							line-height: normal;
							color: var(--textSub, #636E72);
						}
						.coupon-code{
							position: relative;
							display: inline-block;
							color: #fff;
							background: var(--mainColor);
							padding: 2px 8px;
							margin-left: 0;
							min-width: 70px;
							text-align: center;
							cursor: pointer;
							font-size: 0.6875rem; /* below-scale, intentional */
							border-radius: 8px;
							&:hover{
								background: var(--hover);
							}
						}
					}
					.info-button{
						display: flex;
						justify-content: center;
						align-items: center;
						width: 20px;
						height: 20px;
						font-size: var(--fs-md);
						border: 1px solid var(--mainColor);
						border-radius: 99px;
						position: absolute;
						right: 7px;
						top: 7px;
						svg{
							width: 10px;
							height: 10px;
							fill: var(--mainColor);
						}
						&:hover{
							border: 1px solid var(--hover);
							svg{
								fill: var(--hover);
							}
						}
					}
				}

			}
		}
	}
	@media (max-width: 767px) {
		.swiper_coupons {
			overflow: initial;
			padding: 0;
			margin: 0;
			.swiper-wrapper {
				-ms-flex-wrap: nowrap;
				flex-wrap: nowrap;
				overflow-x: auto;
				scroll-snap-type: x mandatory; 
				margin-left: -7px;
				width: auto;
				.swiper-slide{
					padding-left: 7px;
					padding-right: 7px;
					-ms-flex: 0 0 85%;
					flex: 0 0 85%;
					max-width: 85%;
					min-width: 85%;
					height: auto;
					&:last-child {
						padding-right: 0px;
					}
					.box-coupon {
						.content_wrap {
							.content-bottom {
								.coupon-code { 
									min-width: 70px;
									font-size: 0.6875rem;
								}
								span {
									font-size: 0.6875rem;
									font-weight: 500;
									line-height: normal;
								}
							}
						}
					}
				}
			}
		}
	}
}
.popup-coupon{
	padding: 0 8px;
	box-sizing: border-box;
	width: 450px;
	max-height: 505px;
	height: auto;
	background: transparent;
	margin: 0 auto;
	position: relative;
	position: fixed;
	left: 50%;
	top: 15%;
	transition: transform 0.5s cubic-bezier(0.645, 0.045, 0.355, 1),visibility 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
	box-shadow: none;
	touch-action: manipulation;
	opacity: 0;
	transform: translateX(-50%);
	z-index: -1;
	min-height: 200px;
	@media(max-width: 767px){
		width: 100%;
	}
	&.active{
		opacity: 1;
		z-index: 99999;

	}
	.content{
		display: flex;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		border-radius: 10px;
		background-color: #fff;
		margin: 0 auto;
		-webkit-box-shadow: 3px 3px 20px 0 rgba(0,0,0,0.15);
		box-shadow: 3px 3px 20px 0 rgba(0,0,0,0.15);
		position: relative;
		overflow: hidden;
		.title{
			display: block;
			width: 100%;
			padding: 10px;
			background: var(--mainColor);
			color: #fff;
		}
		.close-popup-coupon{
			position: absolute;
			top: 8px;
			right: 10px;
			cursor: pointer;
			svg{
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
				path{
					fill: #fff;
				}
			}
			&:hover{
				svg{
					transform: rotate(90deg);
				}
			}
		}
		ul{
			width: 100%;
			li{
				padding: 10px;
				display: flex;
				&:nth-child(2n + 1){
					background-color:#f9f9f9;

				}
				span:first-child{
					min-width: 126px;
					display: inline-block;
					color: var(--mainColor);
				}
			}
		}
	}
}
.section_4_banner{
	.three_banner {
		display: block;
		position: relative;
		.duration-300 {
			display: block;
			aspect-ratio: {{settings.banner4_width | default: 640 }}/{{settings.banner4_height | default: 240 }};
			position: relative;
			overflow: hidden;
			border-radius: 10px;
			&:hover {
				img {
					transform: scale(1.1);
				}
			}
		}
		.info_banner {
			position: absolute;
			z-index: 1;
			top: 50%;
			left: 20px;
			transform: translate(0, -50%);
			max-width: 50%;
			color: var(--custom-color);
			h3 {
				line-height: 1.2;
				font-size: var(--fs-md);
				font-weight: 500;
				display: block;
				margin-bottom: 10px;
			}
			h2 {
				line-height: 1.2;
				font-size: var(--fs-xl);
				font-weight: 500;
				display: block;
				margin-bottom: 10px;
			}
			.content_banner {
				line-height: 1.4;
				font-size: var(--fs-sm);
				font-weight: 400;
				display: block;
				margin-bottom: 10px;
			}
			@media(max-width: 1199px) {
				max-width: 60%;
				h2 {
					font-size: var(--fs-md);
				}
			}
			.actions_banner {
				display: flex;
				justify-content: start;
				margin-top: auto;
				a {
					display: flex;
					align-items: center;
					color: #fff;
					width: fit-content;
					font-size: var(--fs-sm);
					font-weight: 500;
					background-color:var(--custom-color);
					padding: 3px 10px;
					border-radius: 30px;
					svg {
						width: 14px;
						height:14px;
						margin-left: 3px;
						path {
							fill:#fff;
						}
					}
					&:hover, &:focus {
						background-color:var(--subColor);
					}
				}
			}
			@media(max-width: 350px) {
				h3 {
					font-size: var(--fs-sm);
				}
				h2 {
					font-size: var(--fs-md);
				}
				.content_banner {
					font-size: 0.6875rem;
				}
			}
		}
	}
	.banner-slider {
		@include controlswiper();
		.swiper-button-disabled {
			display: none;
		}
		@media (max-width: 767px) {
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
	}
}
.section_banner_2 {
	.three_banner {
		display: block;
		position: relative;
		.duration-300 {
			display: block;
			aspect-ratio: {{settings.banner2_width | default: 480 }}/{{settings.banner2_height | default: 200 }};
			position: relative;
			overflow: hidden;
			border-radius: 10px;
			&:hover {
				img {
					transform: scale(1.1);
				}
			}
		}
	}
	.banner2-slider {
		@include controlswiper();
		.swiper-button-disabled {
			display: none;
		}
		@media (max-width: 767px) {
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
	}
}
.section_1_banner{
	.three_banner {
		display: block;
		position: relative;
		.duration-300 {
			display: block;
			aspect-ratio: {{settings.banner1_width | default: 1020 }}/{{settings.banner1_height | default: 360 }};
			position: relative;
			overflow: hidden;
			border-radius: 10px;
			img {
				width: 100%;
			}
			&:hover {
				img {
					transform: scale(1.1);
				}
			}
		}
		.info_banner {
			display: block;
			width: 100%;
			background: linear-gradient(90deg, var(--mainColor), transparent);
			color: var(--one-color);
			border-radius: 10px;
			display: flex;
			align-items: center;
			padding: 20px;
			@media(min-width: 992px) {
				position: absolute;
				z-index: 1;
				top: 50%;
				left: 20px;
				transform: translate(0, -50%);
				max-width: 70%;
				height: calc(100% - 40px);
			}
			.item_banner_info {
				display: block;
				max-width: 80%;
			}
			h3 {
				line-height: 1.2;
				font-size: var(--fs-md);
				font-weight: 500;
				display: block;
				margin-bottom: 10px;
			}
			h2 {
				line-height: 1.2;
				font-size: var(--fs-xl);
				font-weight: 500;
				display: block;
				margin-bottom: 10px;
			}
			.content_banner {
				line-height: 1.4;
				font-size: var(--fs-sm);
				font-weight: 300;
				display: block;
				margin-bottom: 10px;
			}
			@media(max-width: 1199px) {
				max-width: 80%;
				h2 {
					font-size: var(--fs-md);
				}
			}
			@media(max-width: 1025px) {
				max-width: 90%;
			}
			@media(max-width: 992px) {
				max-width: 100%;
				margin-top: 15px;
				padding: 14px;
				h2 {
					font-size: var(--fs-lg);
				}
				.content_banner {
					font-size: var(--fs-sm);
				}
			}
			.actions_banner {
				display: flex;
				justify-content: start;
				margin-top: auto;
				a {
					display: flex;
					align-items: center;
					color: var(--subColor);
					width: fit-content;
					font-size: var(--fs-md);
					font-weight: 500;
					background-color:var(--one-color);
					padding: 5px 15px;
					border-radius: 30px;
					svg {
						width: 20px;
						height:20px;
						margin-left: 5px;
						path {
							fill: var(--subColor);
						}
					}
					&:hover, &:focus {
						color: #fff;
						background-color:var(--subColor);
						svg {
							path {
								fill:#fff;
							}
						}
					}
				}
			}
		}
	}

}
/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   Flash Sale — BEM: .pc-flashsale
   .section_flash_sale & .swiper_sale kept as JS hooks (lazyBlockProduct / Swiper)
   Convention: CSS variables only · spacing 4/8/16/24/32/48px · font var(--fs-*)
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.section_flash_sale { width: 100%; overflow: hidden; }

@keyframes pc-pulsescale {
	50% { opacity: 0.3; transform: scale(1.3); }
}

.pc-flashsale {
	&__body {
		margin: 0 auto;
		overflow: hidden;

		@media (max-width: 767px) {
			.alert.alert-warning { margin: 0; }
			.swiper-button-next, .swiper-button-prev { display: block !important; }
		}
	}

	&__header {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		flex-wrap: nowrap;
		padding: 12px 16px;
		margin-bottom: 16px;
		background: var(--mainColor);

		@media (max-width: 767px) {
			padding: 10px 12px;
			margin-bottom: 12px;
		}
	}

	&__header-inner {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		width: 100%;
		flex-wrap: nowrap;
	}

	&__title {
		font-family: var(--font-primary);
		font-size: var(--fs-lg); /* section title — 20px */
		font-weight: 600;
		margin: 0 24px 0 0;
		display: inline-block;
		flex-shrink: 0;

		@media (max-width: 767px) { margin: 0 12px 0 0; }

		img {
			height: 32px;
			width: auto;
			animation: pc-pulsescale 0.8s linear infinite;
			@media (max-width: 480px) { height: 24px; }
		}

		a {
			background: var(--sale-gradient);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
			&:hover { color: var(--subColor); }
		}
	}

	&__countdown {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		padding: 0;
		background: transparent;
		position: relative;
	}

	&__countdown-label {
		font-family: var(--font-secondary);
		color: #fff;
		display: inline-block;
		margin-right: 8px;

		@media (max-width: 767px) { display: none; }
	}

	/* .block-timer divs are generated by the JS countdown plugin — styled by descendant */
	&__countdown-timer {
		display: inline-flex;
		align-items: center;
		flex-wrap: nowrap;
		text-align: left;

		.block-timer {
			width: 45px;
			height: 45px;
			background: var(--sale-gradient);
			border-radius: 4px;
			display: inline-flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			padding: 4px 0;
			margin-right: 4px;
			text-align: center;
			flex-shrink: 0;
			&:last-child { margin-right: 0; }

			@media (max-width: 767px) {
				width: 36px;
				height: 36px;
				padding: 2px 0;
			}
			@media (max-width: 480px) {
				width: 30px;
				height: 30px;
				margin-right: 3px;
			}

			p {
				display: block;
				font-family: var(--font-primary);
				font-weight: 500;
				color: #fff;
				font-size: var(--fs-lg);
				margin: 0;
				line-height: 1.2;

				@media (max-width: 767px) { font-size: var(--fs-base); }
				@media (max-width: 480px) { font-size: var(--fs-sm); }
			}

			span {
				display: block;
				font-family: var(--font-secondary);
				color: #fff;
				font-size: var(--fs-sm);
				font-weight: 400;
				line-height: 1.2;

				@media (max-width: 480px) { font-size: var(--fs-xs); }
			}
		}

		.lof-labelexpired { color: #fff; }
	}

	&__viewall {
		flex: 1 1 auto;
		text-align: right;

		a {
			color: #fff;
			display: inline-flex;
			align-items: center;
			font-family: var(--font-secondary);
			font-size: var(--fs-md);
			font-weight: 600;
			text-decoration: underline;

			svg { width: 16px; height: 16px; margin-left: 4px; path { fill: #fff; } }

			&:hover, &:focus {
				color: var(--subColor);
				svg path { fill: var(--subColor); }
			}
		}
	}

	&__carousel {
		@include controlswiper();
		padding-left: 8px;
		margin-left: -8px;
		padding-bottom: 4px;

		.swiper-slide {
			height: auto !important;
			@media (min-width: 992px)  { max-width: 25%; }
			@media (min-width: 1025px) { max-width: 20%; }
		}
	}

	&__viewmore {
		text-align: center;
		display: none;

		@media (max-width: 767px) {
			display: block !important;
			margin-top: 16px;
		}

		.flexbtn:hover, .flexbtn:focus {
			background-color: var(--subColor);
			opacity: 0.8;
		}
	}

	/* ── Product card modifier (used inside flash sale carousel) ─────────── */
	&__card {
		.box-product-sale { flex: 1 1 0%; }
	}

	/* ── Sold-count progress bar ─────────────────────────────────────────── */
	&__progress {
		width: 100%;
		display: inline-block;
		margin-top: 8px;
		margin-bottom: 4px;
	}

	&__progress-bar {
		width: 100%;
		height: 16px;
		border-radius: 8px;
		position: relative;
		background: {{settings.count_down_bg | default: settings.theme_main_color | default: '#3cb371'}};
		z-index: 1;

		&--active  { background: var(--bgBodySub); }

		&--soldout .pc-flashsale__progress-fill {
			background: linear-gradient(90deg, #6b7280, #9ca3af) !important;
		}
	}

	&__progress-icon {
		position: absolute;
		width: 22px;
		height: 22px;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 1;
		top: -6px;
		left: 0;
	}

	&__progress-fill {
		position: absolute;
		height: 16px;
		border-radius: 8px;
		background: var(--sale-bar-gradient);
		z-index: 0;
		left: 0;
		top: 0;
	}

	&__progress-label {
		font-family: var(--font-secondary);
		font-size: var(--fs-sm);
		position: absolute;
		top: 0;
		z-index: 4;
		color: #fff;
		line-height: 16px;
		left: 50%;
		min-width: 70px;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.25);
		transform: translateX(-50%);
		text-align: center;

		b { font-weight: 600; }
	}
}

.item_product_main { padding-bottom: 0; }
.item_null         { margin-bottom: 0; }
.section_product_tab {
	.tab_big {
		height: auto;
		background-color: var(--mainColor);
		padding: 10px;
		border-radius: 10px;
		margin-bottom: 15px;
		.tab_ul {
			position: relative;
			max-width: 100%; 
			margin: 0px auto 0 auto;
			@include ulwebkit();
			@include button();
			&.actice {
				padding: 0px 30px;
				ul {
					padding-left: 10px;
					padding-right: 10px;
					-webkit-mask: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 1) 10px, rgba(0, 0, 0, 1) calc(100% - 10px), transparent 100%);
				}
			}
			ul {
				max-width: 100%;
				overflow-x: auto;
				overflow-y:hidden;
				white-space: nowrap;
				padding:0;
				margin:0;

				li {
					padding: 0px;
					position: relative;
					width: auto;
					line-height: 36px;
					height: auto;
					font-weight: 400;
					color: #fff;
					transition: background-color 0.3s ease;
					margin-right: 15px;
					border: 1px solid #fff;
					border-radius: 10px;
					padding: 7px 10px;
					span {
						position: relative;
						display: block;
						line-height:1.4;
						&.txt-title-tab {
							font-size:1rem;
							font-weight: 400;
						}
					}
					@media(max-width: 767px) {
						span {
							&.txt-title-tab {
								font-size: var(--fs-md);
							}
						}
					}
					@media (min-width: 767px) {
						&:last-child {
							margin-right: 0px;
						}
					}

					&:hover{
						color: #fff;
						border-color: var(--subColor);
						background-color: var(--subColor);
					} 
					&.current {
						color: #fff;
						border-color: var(--subColor);
						background-color: var(--subColor);
					}
				}
			}
			.button{
				display: flex;
				justify-content: center;
				align-items: center;
				cursor: pointer;	
				background-color: var(--bgBodySub);
				border-radius: 5px;
				&:hover {
					svg {
						color: var(--subColor);
						path {
							fill: var(--subColor);
						}
					}
				}
			}
		}
	}
	.tab-content {
		overflow: initial;
	}
	.view-more {
		text-align: center;
	}
	.swiper-container {
		position: relative;
		padding: 2px;
		margin-bottom: 20px;
		.item_product_main {
			padding-bottom: 0px;
		}
		@include controlswiper();
		@media (max-width: 767px) {
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
	}
	@media (max-width: 767px) {
		.col-lg-3 {
			order: 2 !important;
		}
		.col-lg-9 {
			order: 1 !important;
		}
		.tab_big {
			.tab_ul {
				padding: 0px 30px;
			}
		}
		.tab-content.current {
			overflow: initial;
		}
	}
	@media (min-width: 767px) {
		.pro_sticky {
			position: sticky;
			top: 60px;
		}
	}

	.image-tab {
		overflow: hidden;
		border-radius: 10px;
		@media (max-width: 767px) {
			margin-top: 20px;
		}
		img {
			transition: 0.5s all;
		}
		&:hover, &:focus {
			img {
				transform: scale(1.1);
			}
		}
	}
	.key-pro{
		margin-top: 20px;
		.tilte-key{
			font-size: var(--fs-md);
			text-transform: uppercase;
			font-weight: 700;
			margin-bottom: 10px;
		}
		.list-search-key{
			li{
				display: inline-block;
				margin-right: 5px;
				border: 1px solid var(--mainColor);
				border-radius: 10px;
				margin-bottom: 10px;
				a{
					padding: 4px 15px;
					display: block;
				}
				&:hover{
					background: var(--mainColor);
					a{
						color: #fff;
					}
				}
			}
		}
	}
}
.section_about {
	position: relative;
	@media (min-width: 992px) {
		.col-lg-3 {
			-ms-flex: 0 0 30%;
			flex: 0 0 30%;
			max-width: 30%;
		}
		.col-lg-6 {
			-ms-flex: 0 0 40%;
			flex: 0 0 40%;
			max-width: 40%;
		}
		.product-content {
			padding-top: 40px;
		}
	}
	@media (min-width: 767px) and (max-width: 992px) {

	}
	.section-title {
		margin-bottom: 15px;
	}
	.container {
		position: relative;
	}
	.product-content {
		max-width: 80%;
		@media(max-width: 767px) {
			margin-bottom: 15px;
			max-width: 100%;
		}
		.sub-section-title {
			font-size: var(--fs-md);
			color: var(--subColor);
		}
		.section-title {
			text-align: left;
			h2 {
				line-height: 1.2;
			}
		}
		a.show-more {
			margin-top: 15px;
		}
	}
	.banner-product {
		display: inline-flex;
		justify-content: center;
		align-items: center;
		margin: 0 auto;
		width: {{settings.section_about_product_width | default: "900" | append: 'px'}};
		max-width: 100%;
		border-radius: 20px 20px 120px 20px;
		overflow: hidden;
		position: relative;
		aspect-ratio: {{settings.section_about_product_width | default: "900"}}/{{settings.section_about_product_height | default: "501"}};
		@media (max-width: 767px) {
			display: none;
		}
		.exp-wrap {
			position: absolute;
			bottom: 10px;
			left: 10px;
			padding: 10px;
			width: fit-content;
			height: fit-content;
			background: var(--subColor);
			display: flex;
			justify-content: center;
			align-items: center;
			border-radius: 15px 15px 40px 15px;
			@media (max-width: 767px) {
				border-radius: 10px 10px 30px 10px ;
			}
			.exp-content {
				color:#fff;
				border: 1px solid #fff;
				text-align: center;
				display: flex;
				flex-direction: column;
				padding: 15px;
				border-radius: 15px 15px 36px 15px;
				@media (max-width: 767px) {
					border-radius: 10px 10px 26px 10px;
				}
				.exp-tt {    
					font-size: 1.625rem;
					font-weight: bold;
					line-height: 1.2;
					margin-bottom: 0px;
					@media(max-width: 1025px) {
						font-size: 1.25rem;
					}
				}
			}

		}
	}
	.swiper-slide img {
		border-radius: 10px;
	}
	.faq-list {
		list-style: none;
		padding: 0;
		@media (min-width: 767px) and (max-width: 992px) {
			margin-bottom: 15px;
		}
	}
	.faq-item {
		padding: 10px 0;
		border-bottom: 1px solid #ddd;
		cursor: pointer;
		&:last-child {
			border-bottom: none;
		}
	}
	.faq-item.is-active .faq-content {
		display: block;
	} 
	.faq-content {
		display: none;
		margin-top: 5px;
		color: #444;
	}
	.faq-header {
		padding: 0;
		padding-left: 30px;
		border: 0;
		font-weight: 600;
		color: #5a5a5a;
		position: relative;
		&::after {
			content: "";
			position: absolute;
			left: 0;
			top: 0.2rem;
			width: 20px;
			height:20px;
			background-size: 100%;
			background-position: center;
			background-image: url({{'plus.svg' | asset_url}});
		}
	}

	.faq-item {
		&.is-active {
			.faq-header {
				h3 {
					color: var(--mainColor);
				}
				&::after {
					background-image: url({{'minus.svg' | asset_url}});
				}
			}
		}
	}
	.faq-header h3 {
		margin: 0;
		font-size: var(--fs-lg);
		font-weight: 600;
		@media (max-width: 767px) {
			border-radius: 10px 10px 30px 10px ;
		}
	}
}
.section_category {

	.list_category{
		grid-template-columns: repeat(4, 1fr);
		display: grid;
		gap: 20px;
		@media(max-width: 1025px) {
			grid-template-columns: repeat(3, 1fr);
		}
		@media(max-width: 767px) {
			display: flex;
			flex-wrap: nowrap;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			gap: 10px;
			padding-bottom: 6px;
			scroll-snap-type: x mandatory;
			&::-webkit-scrollbar { display: none; }
			.box-cate {
				flex: 0 0 100px;
				width: 100px;
				scroll-snap-align: start;
				a {
					flex-direction: column;
					align-items: center;
					text-align: center;
					padding: 10px 6px;
					gap: 6px;
				}
				picture {
					margin-right: 0;
				}
			}
		}
		.box-cate{
			position: relative;
			width: 100%;
			display: none;
			picture{
				display: inline-block;
				margin-right:14px;
				display: block;
				aspect-ratio: 56/ 56;
				position: relative;
				min-width: 56px;
				@media(max-width: 767px) {
					aspect-ratio: 40/ 40;
					min-width: 40px;
					margin-right:7px;
				}
				img {
					border-radius: 10px;
				}
			}
			a{
				display: flex;
				align-items: center;
				overflow: hidden;
				padding: 10px;
				border: 1px solid #e5e7eb;
				border-radius: 10px;
				img{
					height: 56px;
					width: 56px;
					transform: scale(1);
					position: relative;
					border-radius: 50%;
					@media(max-width: 767px) {
						height: 40px;
						width: 40px;
					}
				}
				.nam_count_cate {
					display: flex;
					h3{
						font-size: var(--fs-lg);
						margin-bottom: 0px;
						font-weight:500;
						-webkit-line-clamp: 2;
						height: inherit;
						max-height: calc(1em * 1.4 * 2);
						@media(max-width: 767px){
							font-size: var(--fs-md);
						}
						span{
							display: block;
						}
					}

				}
				&:hover {
					border: 1px solid var(--mainColor);
					color: #fff;
					background-color: var(--mainColor);
				}
			}
		}
	}

	.box_btn_showmore {
		display: block;
		text-align: center;
		#loadMoreBtn {
			margin-top: 16px;
			padding: 8px 16px;
			cursor: pointer;
			text-align: center;
			display: none;
			border: none;
			background: transparent;
			align-items: center;
			svg {
				display: inline-block;
				margin-right: 4px;
			}
			&:hover, &:focus {
				color: var(--subColor);
				svg {
					path {
						fill: var(--subColor);
					}
				}
			}
		}
	}

}
.section_blog {
	.tab_big {
		height: auto;
		margin-bottom: 15px;
		.tab_ul {
			position: relative;
			max-width: 100%; 
			margin: 0px auto 0 auto;
			@include ulwebkit();
			@include button();
			&.actice {
				padding: 0px 30px;
				ul {
					padding-left: 10px;
					padding-right: 10px;
					-webkit-mask: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 1) 10px, rgba(0, 0, 0, 1) calc(100% - 10px), transparent 100%);
				}
			}
			ul {
				max-width: 100%;
				overflow-x: auto;
				overflow-y:hidden;
				white-space: nowrap;
				padding:0;
				margin:0;

				li {
					padding: 0px;
					position: relative;
					width: auto;
					line-height: 36px;
					height: auto;
					font-weight: 400;
					transition: background-color 0.3s ease;
					margin-right: 15px;
					border: 1px solid var(--mainColor);
					border-radius: 10px;
					padding: 7px 10px;
					span {
						position: relative;
						display: block;
						line-height:1.4;
						&.txt-title-tab {
							font-size:1rem;
							font-weight: 400;
						}
					}
					@media(max-width: 767px) {
						span {
							&.txt-title-tab {
								font-size: var(--fs-md);
							}
						}
					}
					@media(min-width: 767px) {
						&:last-child {
							margin-right: 0px;
						}
					}

					&:hover{
						color: #fff;
						background-color: var(--mainColor);
					} 
					&.current {
						color: #fff;
						background-color: var(--mainColor);
					}
				}
			}
			.button{
				display: flex;
				justify-content: center;
				align-items: center;
				cursor: pointer;	
				background-color: var(--bgBodySub);
				border-radius: 5px;
				&:hover {
					svg {
						color: var(--subColor);
						path {
							fill: var(--subColor);
						}
					}
				}
			}
		}
	}
	.tab-content {
		overflow: initial;
	}
	.view-more {
		text-align: center;
	}
	.swiper-container {
		position: relative;
		padding: 2px;
		margin-bottom: 20px;
		.item_product_main {
			padding-bottom: 0px;
		}
		@include controlswiper();
		@media (max-width: 767px) {
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
	}
	@media (max-width: 767px) {
		.tab_big {
			.tab_ul {
				padding: 0px 30px;
			}
		}
		.tab-content.current {
			overflow: initial;
		}
	}
	.item_blog_index {
		display: block;
		position: relative;
		.update_date {
			display: flex;
			margin-bottom: 7px;
			font-size: var(--fs-xs);
			color: #838383;
			justify-content: space-between;
			.user_name {
				b {
					color: var(--mainColor);
					font-weight: 500;
				}
			}

		}
		.image-blog{
			padding-bottom: 56.25%; /* 16:9 */
			overflow: hidden;
			height: 0;
			display: block;
			position: relative;
			border-radius: 10px;
			background-color: #f8f8f8;
			.user_date {
				position: absolute;
				top: 0px;
				left: 0px;
				background-color: var(--subColor);
				padding: 5px;
				border-radius: 10px 0px 10px 0px;
				color:#fff;
				font-size: var(--fs-sm);
				font-weight: 600;
			}
			img {
				width: 100% !important;
				height: 100%;
				object-fit: cover;
				position: absolute;
				top: 0;
				left: 0;
				transition: .3s ease-in-out all;
				transform: scale(1.05);
			}
		}
		.blog_content {
			position: relative;
			width: 100%;
			padding-top: 15px;
			background-color: #fff;
			h3 {
				margin-bottom: 7px;
				line-height: 22px;
				a {
					color:var(--textColor);
					font-size: var(--fs-lg);
					line-height: 22px;
					font-weight: 600;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					overflow: hidden;
					height: 44px;
					&:hover {
						color:var(--subColor);
					}
				}
			}
			.blog_description {
				color: var(--textColor);
				line-height: 20px;
				margin-bottom: 10px;
				word-break: break-word;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				text-overflow: ellipsis;
				overflow: hidden;
				height: 40px;
			}
			.read_more {
				font-weight: 600;
			}
		}
		&:hover{
			.image-blog img {
				transform: scale(1.15);
			}
		}
	}
	.view-more {
		text-align: center;
		display: block;
		margin-top: 15px;
	}
}
.item_null {
	.item_product_main {
		aspect-ratio: 242/382;
		background: #f1f1f1;
		border-radius: 0px;
		height: auto;
		padding: 0px; 
		margin-bottom: 28px;
	}
}
.section_product {
	position: relative;
	display: block;
	.item_null {
		margin-bottom: 0px;
	}
	@media (min-width: 1025px) {
		.col-xl-20 {
			-ms-flex: 0 0 20%;
			flex: 0 0 20%;
			max-width: 20%;
		}
	}
	.swiper-container {
		position: relative;
		padding: 2px;
		@include controlswiper();
		@media (max-width: 767px) {
			.alert.alert-warning {
				margin: 0 20px;
			}
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
	}
	.view-more {
		text-align: center;
	}
	.box_banner_pro {
		.image-tab {
			overflow: hidden;
			border-radius: 10px;
			margin-bottom: 20px;
			display: block;
			@media (max-width: 767px) {
				margin-top: 20px;
			}
			.image_effect{
				display: block;
				aspect-ratio: 1280/ 229;
				position: relative;
			}
			img {
				transition: 0.5s all;
			}
			&:hover, &:focus {
				img {
					transform: scale(1.1);
				}
			}
		}
		.link_title {
			display: -webkit-box;
			display: -ms-flexbox;
			display: flex;
			-ms-flex-wrap: wrap;
			flex-wrap: wrap;
			gap: 8px;
			margin-bottom: 20px;
			@media (max-width: 991px){
				display: -webkit-flex;
				display: -ms-flexbox;
				display: flex;
				overflow-x: auto;
				overflow-y: hidden;
				-webkit-overflow-scrolling: touch;
				flex-direction: unset;
				-webkit-flex-flow: unset;
				flex-flow: unset;
				-webkit-justify-content: unset;
				justify-content: unset;
				-webkit-align-items: unset;
				align-items: unset;
				padding-bottom:5px;
				@media (max-width: 767px) {
					padding-top:10px;
				}
			}
			.item_cate_index {
				border: 1px solid var(--mainColor);
				-webkit-transition: all .1s ease-in;
				-o-transition: all .1s ease-in;
				transition: all .1s ease-in;
				padding: 2px 15px;
				border-radius: 10px;
				background-color: #fff;
				.title_cate {
					display: block;
					text-overflow: ellipsis;
					overflow: hidden;
					white-space: nowrap;
					margin-bottom: 3px;
					margin-top: 3px;
					text-align: center;
				}
				&:hover{
					color: #fff;
					background-color: var(--mainColor);
				}
			}
		}
	}
}
.section_brand {
	.box-trend {
		@include controlswiper();
		.swiper-button-disabled {
			display: none;
		}
		@media (max-width: 767px) {
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		}
		.item-trend {
			padding: 15px 15px 25px;
			text-align: left; 
			border-radius: 10px;
			background-color: color-mix(in srgb, var(--mainColor), #fff 95%);
			position: relative;
			overflow: hidden;
			.opaci-topic {
				position: absolute;
				width: 100%;
				height: 100%;
				top: 0px;
				left: 0px;
				z-index: 2;
			}
			.img_trend {
				position: relative;
				gap: 15px;
				grid-template-columns: repeat(2, 1fr);
				display: grid;
				overflow: auto;
				justify-content: start;
				.img_trend_child {
					background-color: #fff;
					border-radius: 10px;
					padding: 15px;
					position: relative;
					overflow: hidden;
					width: 100%;
					display: flex;
					-o-justify-content: center;
					-moz-justify-content: center;
					-webkit-justify-content: center;
					-os-justify-content: center;
					-o-display: flex;
					-moz-display: flex;
					-webkit-display: flex;
					-os-display: flex;
					align-items: center;
					height: auto !important;
					padding-bottom: 90%;
					img {
						width: auto !important;
						max-height: 90%;
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						margin: auto;
						transition: .3s ease-in-out all;
						will-change: opacify;
					}
				}
			}
			.content-topic {
				position: absolute;
				transition: height .3s;
				bottom: 0;
				left: 0;
				width: 100%;
				display: block;
				align-content: end;
				height: 70px;
				padding: 10px;
				padding-right: 60px;
				h3, span {
					position: relative;
					z-index: 1;
				}
				h3 {
					margin-bottom: 0px;
					color: var(--mainColor);
					font-weight: bold;
					font-size: 1.125rem;
					line-height: 1;
				}
				span {
					font-size: var(--fs-sm);
					color:var(--mainColor);
				}
				.icon-svg {
					position: absolute;
					top: 15px;
					width: 45px;
					height: 45px;
					cursor: pointer;
					color: var(--mainColor);
					outline: none;
					border: 0px;
					background: transparent;
					text-align: center;
					z-index: 2;
					right: 10px;
					background-color: #fff;
					border-radius: 5px;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: 3px;
					img {
						max-width: 100%;
						border-radius: 5px;
					}
				}

			}
			&:before {
				position: absolute;
				content: "";
				left: 0;
				right: 0;
				bottom: 0;
				height: 80px;
				background: linear-gradient(180deg, transparent 17%, color-mix(in srgb, var(--mainColor), #fff 50%) 120%);
				z-index: 1;
				transition: height .3s;
			}
			&:hover {
				&:before {
					height: 100%;
					background: linear-gradient(180deg, transparent 0, color-mix(in srgb, var(--mainColor), #fff 0%) 100%);
				}
				.content-topic{
					h3 {
						color: #fff;
					}
					span {
						color: #fff;
					}
					.icon-svg {
						background-color: var(--subColor);
					}
				}
			}
		}
	}
}
.section_disease {
	.box_disaese {
		padding: 30px;
		border-radius: 10px;
		overflow: hidden;
		background: var(--mainColor);
		position: relative;
		@media(max-width: 767px) {
			padding: 14px;
		}
		.box_bng_basse {
			position: absolute;
			top: 0px;
			left: 0px;
			width: 100%;
			height: 100%;
			background-position: center;
			opacity: 0.3;
			background-size: contain;
		}
		h2 {
			line-height: 1.2;
			font-size: 1.375rem;
			font-weight: 600;
			display: block;
			margin-bottom: 10px;
			color:#fff;
			position: relative;
		}
		.content_banner {
			line-height: 1.4;
			font-size: var(--fs-md);
			font-weight: 400;
			display: block;
			margin-bottom: 20px;
			color:#fff;
			position: relative;
		}
		.disease-slider {
			position: relative;
			@include controlswiper();
			.swiper-button-disabled {
				display: none;
			}
			@media (max-width: 767px) {
				.swiper-button-next, .swiper-button-prev{
					display: block !important;
				}
			}
		}
		a {
			background: #fff;
			display: block;
			padding: 10px;
			border-radius: 10px;
		}
		.thumb {
			position: relative;
			display: block;
			margin: 0 auto;
			border-radius: 10px;
			overflow: hidden;
			padding-bottom: 100%;
			height: auto;
			margin-bottom: 10px;
			img {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				-o-object-fit: cover;
				object-fit: cover;
				border-radius: 10px;
				transition: transform .5s ease;
				transform: scale(1);
			}
		}
		h3 {
			font-size: var(--fs-lg);
			font-weight: 600;
			margin-bottom: 0px;
		}
	}
}
