  padding-bottom: 3px;
}
.layout-collection .dqdt-sidebar .section-box-bg .collection-category .aside-content .navbar-pills .nav-item a:hover, .layout-collection .dqdt-sidebar .section-box-bg .collection-category .aside-content .navbar-pills .nav-item a:focus {
