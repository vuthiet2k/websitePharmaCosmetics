}
.layout-collection .dqdt-sidebar .section-box-bg .collection-category .show-all-col .view-all-col, .layout-collection .dqdt-sidebar .section-box-bg .collection-category .show-all-col .less-all-col {
  font-size: var(--fs-sm);
