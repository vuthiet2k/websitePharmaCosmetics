$main-color: {{ settings.theme_main_color }};
$hover: {{ settings.theme_sub_color }};
#quick-view-product {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.quick-view-product {
		position: absolute;
		width: 800px;
		top: 5%;
		height: auto;
		margin: 0 auto;
		left: 0;
		right: 0;
		padding: 15px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 10px;
		@media(max-width: 991px){
			width: 95%;
		}
		.quickview-close{
			position: absolute;
			right: -7px;
			top: -7px;
			width: 30px;
			height: 30px;
			border: 2px solid #f9f9f9;
			display: flex;
			justify-content: center;
			align-items: center;
			background: var(--mainColor);
			color: #fff;
			border-radius: 7px;
			svg {
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
			}
			&:hover{
				background-color: var(--subColor);
				svg {
					transform: rotate(90deg);
				}
			}

		}
	}
	.quickview-overlay {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
		top: 0 !important;
	}
	.large-image{
		.img-product{
			padding-bottom: 100%;
			display: block;
			height: 0;
			position: relative;
			@media(max-width: 991px){
				padding-bottom: 40%;
				margin-bottom: 10px;
			}
			img{
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				max-width: 100% !important;
				max-height: 100% !important;
				width: auto !important;
				height: auto !important;
				position: absolute;
			}
		}
	}
	.thumbs_list_quickview {
		margin-top: 15px;
		ul {
			list-style: none;
			padding: 0;
			margin: 0;
			.swiper-slide {
				a{
					padding-bottom: 100%;
					display: block;
					height: 0;
					position: relative;
					border: 1px solid #e9edf5;
					img{
						left: 50%;
						top: 50%;
						transform: translate(-50%, -50%);
						max-width: 100% !important;
						max-height: 100% !important;
						width: auto !important;
						height: auto !important;
						position: absolute;
					}
				}
				&.active{
					a{
						border: 1px solid $main-color;
					}
				}
			}
		}
	}
	.product-info {
		margin-top: 10px;
		padding-top: 10px;
		padding-left: 10px;
		padding-right: 10px;
		@media(max-width: 767px) {
			padding-left: 0px;
			padding-right: 0px;
		}

		.title-product {
			font-size: var(--fs-xl);
			color: #333;
			font-weight: bold;
		}
		&::-webkit-scrollbar-thumb {
			background-color: $main-color;
			outline: 1px solid $main-color;
		}
		&::-webkit-scrollbar {
			width: 3px;
		}
	}
	.group-status{
		margin-bottom: 10px;
		.left_vend{
			display: -ms-flexbox;
			display: flex;
			-ms-flex-wrap: wrap;
			flex-wrap: wrap;
			font-weight: 600;
			.first_status {
				-ms-flex: 0 0 50%;
				flex: 0 0 50%;
				max-width: 50%;
				.status_name{
					color: $main-color;
				}
			}
		}

		.line_tt {
			padding: 0 5px;
		}
	}
	.selector-wrapper {
		display: none !important;
	}
	.price-box {
		margin-bottom: 10px;
		display: block;
		.product-price {
			color: var(--price);
			font-size: var(--fs-lg);
			font-weight: 700;
		}
		.old-price {
			color: #a5a5a5;
			font-size: var(--fs-base);
			margin-left: 5px;
		}
	}
	.product-summary {
		margin-bottom: 10px;
		font-size: var(--fs-sm);
		border-top: 1px solid #e6e6e6;
		padding-top: 10px;
		p {
			margin-bottom: 5px;
		}
		img{
			display: none;
		}
	}
	.form_product_content{
		.count_btn_style  {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
		.soluong1 {
			display: block;
			margin-bottom: 0px;
			font-size: var(--fs-sm);
			margin-right: 15px;
			.soluong_h {
				margin-bottom: 10px;
				display: block;
			}
			.input_number_product {
				display: inline-flex;
				vertical-align: top;
				white-space: nowrap;
				input#quantity-detail{
					width: 60px;
					border-right: none;
					border-left: none;
					padding: 0px;
					margin: 0px;
					text-align: center;
					height:40px;
					min-height: 40px;
				}
				.btn_num {
					padding: 0 5px;
					min-width: 40px;
					min-height: unset;
					height: 40px;
					border: 1px solid #ddd;
					background: #f3f3f3;
					box-shadow: none;
					display: flex;
					justify-content: center;
					align-items: center;
					&:hover {
						background: var(--mainColor);
						color: #fff;
					}
					&.num_1 {
						border-radius: 0;
						border-top-left-radius: 8px;
						border-bottom-left-radius: 8px;
					}
					&.num_2 {
						border-radius: 0;
						border-top-right-radius: 8px;
						border-bottom-right-radius: 8px;
					}
				}

			}

		}
		.button_actions{
			display: inline-block;
			button{
				height: 40px;
				line-height: 40px;
				&.btn[disabled]{
					margin-top: 5px;
					opacity: 0.6;
				}
			}
		}
	}
	.swatch{
		font-size: var(--fs-sm);
		margin-bottom: 0px;
		.header{
			margin-bottom: 5px;
		}
		.swatch-element {
			display: inline-block;
			margin: 0px 10px 10px 0;
			position: relative;
			&.color {
				&:hover {
					@media (min-width: 1200px) {
						&:before {
							content: attr(title);
							position: absolute;
							bottom: calc(100% + 8px);
							left: 50%;
							padding: 3px 7px;
							background: #666;
							color: #fff;
							font-size: var(--fs-base);
							white-space: nowrap;
							display: inline-block;
							line-height: initial;
							transform: translate(-50% ,0%);
						}
						&:after {
							display: block;
							position: absolute;
							border: 10px solid transparent;
							border-top-color: #666;
							content: "";
							left: 50%;
							bottom: calc(100% + -7px);
							z-index: -1;
							transform: translate(-50%, 0%);
						}
					}
				}
			}
			input{
				opacity: 0;
				z-index: 10;
				position: absolute;
				width: 100%;
				cursor: pointer;
				height: 100%;
			}
			label{
				min-width: 30px;
				height: 30px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #ebebeb;
				cursor: pointer;
				white-space: nowrap;
				padding: 0 5px;
				position: relative;
				margin-bottom: 0;
				text-align: center;
				line-height: 28px;

			}
			input:checked+label {
				background: var(--mainColor);
				border-color: #ddd;
				color: #fff;
			}
			.tooltip{
				display: none;
			}
			&.soldout {
				position: relative;
				label{
					position: relative;
				}
			}
			&.color{
				{%for i in (1..20)%}
				{% capture label%}color_{{i}}{%endcapture%}                            
				{% assign title = settings[label]| downcase | handle%}
				{% capture color%}color_{{i}}_c{%endcapture%}			
				{% assign color1 = settings[color] %}
				{%if title != null and title != '' %}
				&.{{title}}{
					label{
						background-color:{{color1}};
						min-width: 30px;
						height: 30px;
					}
				}
				{%endif%}
				{%endfor%}
				label{
					border-radius: 50%;
				}
				input:checked+label{
					border: 2px solid #fff;
					box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
				}
			}
		}
	}
	.title-product{
		font-size: var(--fs-base);
		font-weight: 600;
		line-height: 22px;
		margin-bottom: 5px;
		@media(max-width: 991px){
			font-size: var(--fs-base);
			line-height: 20px;
		}

	}
}
.thump-swatch{
	display: -ms-flexbox;
	display: flex;
	-ms-flex-wrap: wrap;
	flex-wrap: wrap;
}
.product-note {
	margin-bottom: 15px
}

.product-note .header {
	font-weight: 600;
	margin-bottom: 5px
}

.product-note .note-box {
	position: relative
}

.product-note .note-box svg {
	position: absolute;
	top: 0;
	left: 0;
	width: 40px;
	height: 40px;
	margin: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 10px
}

.product-note .note-box input {
	width: 100%;
	border: 0 none;
	padding: 0 10px 0 40px;
	line-height: 40px;
	background: #fff;
	color: #333;
	border: solid 1px #7d7d7d;
	-webkit-transition: 0.2s ease-in-out;
	transition: 0.2s ease-in-out;
	border-radius: 5px;
}