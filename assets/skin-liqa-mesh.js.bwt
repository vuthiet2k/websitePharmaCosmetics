/* Soi da AI 2026-09-24: nạp MediaPipe theo nhu cầu; không nạp khi trang vừa mở. */
(function (window, document) {
  'use strict';
  var loader;
  function load() {
    if (window.FaceMesh) return Promise.resolve(window.FaceMesh);
    if (loader) return loader;
    loader = new Promise(function (resolve, reject) {
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js';
      script.async = true; script.onload = function () { resolve(window.FaceMesh || null); }; script.onerror = reject;
      document.head.appendChild(script);
    });
    return loader;
  }
  function evaluate(landmarks, step, aspectRatio) {
    if (!landmarks || !landmarks[33] || !landmarks[263] || !landmarks[1]) return { available: false, valid: false, reason: 'mesh_unavailable' };
    var leftEye = landmarks[33]; var rightEye = landmarks[263]; var nose = landmarks[1];
    var eyeDistance = Math.max(0.0001, Math.abs(rightEye.x - leftEye.x));
    var yaw = Math.asin(Math.max(-1, Math.min(1, (2 * (nose.x - (leftEye.x + rightEye.x) / 2)) / eyeDistance))) * 180 / Math.PI;
    var verticalScale = Math.max(.1, Number(aspectRatio) || (16 / 9));
    var pitch = Math.atan(((nose.y - (leftEye.y + rightEye.y) / 2) / verticalScale) / eyeDistance) * 180 / Math.PI;
    // 468 landmarks bao gồm vùng tai/oval; chuẩn hoá theo tỷ lệ khung hình thực,
    // không dùng bounding rectangle của toàn mesh làm diện tích khuôn mặt.
    var oval = [10, 109, 67, 103, 54, 21, 162, 127, 234, 93, 132, 58, 172, 136, 150, 149, 176, 148, 152, 377, 400, 378, 379, 365, 397, 288, 361, 323, 454, 356, 389, 251, 284, 332, 297, 338];
    var face = oval.map(function (index) { return landmarks[index]; }).filter(Boolean);
    var xs = face.map(function (point) { return point.x; }); var ys = face.map(function (point) { return point.y; });
    var area = (Math.max.apply(null, xs) - Math.min.apply(null, xs)) * (Math.max.apply(null, ys) - Math.min.apply(null, ys));
    var yawPass = step === 'front' ? Math.abs(yaw) <= 10 : step === 'left' ? yaw >= -52 && yaw <= -38 : yaw >= 38 && yaw <= 52;
    return { available: true, yaw: yaw, pitch: pitch, faceAreaRatio: area, valid: yawPass && Math.abs(pitch) <= 15 && area >= .08 && area <= .55 };
  }
  function start(video, onQuality) {
    var stopped = false;
    var mesh;
    var busy = false;
    var lastFrame = 0;
    return load().then(function (FaceMesh) {
      if (!FaceMesh) throw new Error('mesh_unavailable');
      mesh = new FaceMesh({ locateFile: function (file) { return 'https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/' + file; } });
      mesh.setOptions({ maxNumFaces: 1, refineLandmarks: false, minDetectionConfidence: .55, minTrackingConfidence: .55 });
      mesh.onResults(function (result) { onQuality((result.multiFaceLandmarks && result.multiFaceLandmarks[0]) || null); });
      function frame(timestamp) {
        if (stopped) return;
        window.requestAnimationFrame(frame);
        if (busy || timestamp - lastFrame < 100 || video.readyState < 2) return;
        busy = true; lastFrame = timestamp;
        mesh.send({ image: video }).catch(function () {}).finally(function () { busy = false; });
      }
      window.requestAnimationFrame(frame);
      return { stop: function () { stopped = true; if (mesh && mesh.close) mesh.close(); } };
    });
  }
  window.PharmaSkinMesh = { load: load, evaluate: evaluate, start: start };
})(window, document);
