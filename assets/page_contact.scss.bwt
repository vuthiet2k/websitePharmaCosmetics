/* 2026-10-07: biến CSS khai báo ở snippets/design_tokens.bwt — Sapo không render Liquid trong asset, giá trị phải đổi được trong Admin */

@media (max-width: 991px) {
  .form-contact {
    margin-bottom: 30px;
  }
}
#contact_map iframe {
  width: 100%;
  height: 450px;
  overflow: hidden;
  border-radius: 10px;
}
@media (min-width: 992px) {
  #contact_map {
    height: 100%;
  }
  #contact_map iframe {
    width: 100%;
    height: 100%;
  }
}
