$gutter: 30px;
$main-color: {{ settings.theme_main_color | default: '#3CB371' }};
$sub-color: {{ settings.theme_sub_color | default: '#1F5A3B' }};
$hover: {{ settings.hover | default: '#1F5A3B' }};
$text-color: {{ settings.theme_body_text_color | default: '#13241F' }};
$header-bg: {{ settings.theme_main_color | default: '#3CB371' }};
.layout-contact {
	margin-bottom: 30px;
	.des_foo {
		margin-bottom: 10px;
	}
	.contact  {
		margin-bottom: 40px;
		h4{
			font-size: 1.25rem;
			text-transform: uppercase;
			font-weight: bold;
			margin-bottom: 8px;
		}
		.time_work {
			.item {
				position: relative;
				font-size: 1rem;
				margin-bottom: 5px;
				a {
					color: var(--mainColor);
					&:hover {
						color: var(--hover);
					}
					&.btn-extent {
						color: #fff;
						display: inline-flex;
						align-items: center;
						margin-top: 4px;
						svg:not(.border-svg) {
							width: 20px;
							height: 20px;
							margin-right: 6px;
						}
					}
				}
			}
		}

	}
	.form-contact{
		background: #f5f5f5;
		padding: 15px;
		border: 1px solid #ddd;
		border-radius: 10px;
		h4{
			font-size: 1rem;
			text-transform: uppercase;
			font-weight: bold;
			margin-bottom: 10px;
		}
		#contact {
			margin-bottom: 0px;
		}
		.group_contact  {
			input, textarea{
				border: 1px solid #e1e1e1;
				width: 100%;
				margin-bottom: 15px;
				outline: none;
				border-radius: 10px;
			}
			input{
				padding:5px 20px;
			}
			textarea{
				padding: 10px 20px;
			}
			
		}
	}
}
@media (max-width: 991px){
	.form-contact{
		margin-bottom: 30px;
	}
}
#contact_map {
	iframe {
		width: 100% ;
		height: 450px;
		overflow: hidden;
		border-radius: 10px;
	}
	@media (min-width: 992px) {
		height: 100%;
		iframe {
			width: 100%;
			height: 100%;
		}
	}
}