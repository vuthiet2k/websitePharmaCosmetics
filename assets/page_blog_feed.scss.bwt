/* ══ blog.instagram-feed (2026-10-18): feed bài mới nhất kiểu Instagram, ưu tiên mobile — templates/blog.instagram-feed.bwt ══ */
.pc-ig {
  --ig-line: #E6ECE8;
  --ig-ink: #13241F;
  --ig-sub: #5F7A6D;
  --ig-green: var(--pc-brand-secondary, #267348);
  max-width: 520px; margin: 0 auto; padding: 0 0 32px; background: #fff; color: var(--ig-ink);
  a { color: inherit; text-decoration: none; }
}

/* Hồ sơ */
.pc-ig-profile { display: flex; align-items: center; gap: 18px; padding: 20px 16px 14px; }
.pc-ig-profile__ring { flex: none; display: inline-flex; padding: 3px; border-radius: 50%; background: conic-gradient(from 210deg, #3CB371, #075B40, #D79A7D, #3CB371); }
.pc-ig-avatar { display: inline-flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #fff; border: 2px solid #fff;
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
}
.pc-ig-profile .pc-ig-avatar { width: 76px; height: 76px; padding: 10px; }
.pc-ig-profile__info { min-width: 0; }
.pc-ig-profile__title { margin: 0; font-size: var(--fs-lg); font-weight: 700; line-height: 1.3; color: var(--ig-ink); }
.pc-ig-profile__meta { margin: 4px 0 0; font-size: var(--fs-sm); color: var(--ig-sub); strong { color: var(--ig-ink); } }
.pc-ig-profile__desc { margin: 6px 0 0; font-size: var(--fs-sm); line-height: 1.5; color: var(--ig-ink); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

/* Story */
.pc-ig-stories { border-bottom: 1px solid var(--ig-line);
  ul { display: flex; gap: 14px; margin: 0; padding: 6px 16px 14px; list-style: none; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: 16px; }
  ul::-webkit-scrollbar { display: none; }
  li { flex: none; scroll-snap-align: start; }
}
.pc-ig-story { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 72px; }
.pc-ig-story__ring { position: relative; display: block; width: 66px; height: 66px; padding: 2px; border-radius: 50%; background: #C9D6CE;
  img, .pc-ig-story__ph { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border: 2px solid #fff; border-radius: 50%; object-fit: cover; background: #F4F7F4; color: var(--ig-green); font-size: var(--fs-lg); }
}
.pc-ig-story.is-new .pc-ig-story__ring { background: conic-gradient(from 210deg, #3CB371, #075B40, #D79A7D, #3CB371); }
.pc-ig-story.is-current .pc-ig-story__ring { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--ig-ink); }
.pc-ig-story__new { position: absolute; left: 50%; bottom: -6px; transform: translateX(-50%); padding: 1px 6px; border: 2px solid #fff; border-radius: 4px; background: #E5484D; color: #fff; font-size: var(--fs-3xs); font-weight: 700; line-height: 1.4; text-transform: uppercase; letter-spacing: .04em; }
.pc-ig-story__label { max-width: 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-2xs); color: var(--ig-ink); }
.pc-ig-story.is-current .pc-ig-story__label { font-weight: 700; }

/* Bài */
.pc-ig-feed { display: flex; flex-direction: column; }
.pc-ig-post { border-bottom: 1px solid var(--ig-line); padding-bottom: 14px; }
.pc-ig-post__head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; }
.pc-ig-post__avatar { flex: none; display: inline-flex; padding: 2px; border-radius: 50%; background: conic-gradient(from 210deg, #3CB371, #075B40, #D79A7D, #3CB371);
  .pc-ig-avatar { width: 34px; height: 34px; padding: 4px; }
}
.pc-ig-post__who { display: flex; flex-direction: column; min-width: 0; }
.pc-ig-post__name { font-size: var(--fs-sm); font-weight: 700; line-height: 1.25; color: var(--ig-ink); i { margin-left: 2px; font-size: var(--fs-2xs); color: #3897F0; } }
.pc-ig-post__sub { font-size: var(--fs-xs); color: var(--ig-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pc-ig-post__time { margin-left: auto; flex: none; font-size: var(--fs-xs); color: var(--ig-sub); }
.pc-ig-post__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #F4F7F4;
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
}
.pc-ig-post__ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; height: 100%; padding: 32px; text-align: center; background: linear-gradient(160deg, #EAF7EE, #F6E3D8); color: var(--ig-green);
  i { font-size: var(--fs-3xl); }
  span { font-size: var(--fs-lg); font-weight: 700; line-height: 1.35; color: var(--ig-ink); }
}
.pc-ig-post__play { position: absolute; top: 50%; left: 50%; display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: rgba(0,0,0,.45); color: #fff; font-size: var(--fs-xl); transform: translate(-50%, -50%); pointer-events: none; }
.pc-ig-post__new { position: absolute; top: 12px; left: 12px; padding: 3px 9px; border-radius: 4px; background: #E5484D; color: #fff; font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
.pc-ig-post__actions { display: flex; align-items: center; gap: 4px; padding: 6px 8px 2px; }
.pc-ig-act { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0; background: none; color: var(--ig-ink); cursor: pointer; font-size: var(--fs-xl); transition: transform .15s ease;
  &:hover, &:focus-visible { color: var(--ig-sub); }
  &:focus-visible { outline: 2px solid var(--ig-green); outline-offset: 1px; border-radius: 6px; }
  &.is-on[data-ig-like] { color: #E5484D; }
  &.is-pop { animation: pc-ig-pop .35s ease; }
}
.pc-ig-act--save { margin-left: auto; }
@keyframes pc-ig-pop { 0% { transform: scale(1); } 40% { transform: scale(1.28); } 100% { transform: scale(1); } }
.pc-ig-post__caption { padding: 0 14px; font-size: var(--fs-sm); line-height: 1.5; }
.pc-ig-post__title { display: block; color: var(--ig-ink); strong { margin-right: 4px; } }
.pc-ig-post__text { margin: 4px 0 0; color: var(--ig-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.pc-ig-post__more { color: var(--ig-sub); }
.pc-ig-post__tags { margin: 4px 0 0; a { color: #00376B; } }
.pc-ig-post__comments { display: inline-block; margin-top: 4px; color: var(--ig-sub); }
.pc-ig-empty { padding: 40px 16px; text-align: center; color: var(--ig-sub); }
.pc-ig-more { padding: 20px 16px 0; text-align: center; }
.pc-ig-more__btn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 22px; border: 1px solid var(--ig-line); border-radius: 999px; font-size: var(--fs-sm); font-weight: 600; color: var(--ig-ink) !important; }
.pc-ig-toast { position: fixed; left: 50%; bottom: 88px; z-index: 60; padding: 10px 16px; border-radius: 8px; background: rgba(19,36,31,.92); color: #fff; font-size: var(--fs-sm); transform: translateX(-50%); }
.pc-ig-toast[hidden] { display: none; }

/* Tablet/desktop: cột feed giữa, viền nhẹ như Instagram web */
@media (min-width: 768px) {
  .pc-ig { padding-top: 16px; }
  .pc-ig-post { margin: 0 0 20px; border: 1px solid var(--ig-line); border-radius: 8px; overflow: hidden; }
  .pc-ig-stories { margin-bottom: 20px; }
}
@media (prefers-reduced-motion: reduce) { .pc-ig-act.is-pop { animation: none; } }
