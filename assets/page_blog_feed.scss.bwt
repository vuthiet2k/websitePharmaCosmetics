.pc-feed-wrap { max-width: 600px; margin: 0 auto; padding-bottom: 72px; }

.pc-feed-stories {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding: 16px;
  border-bottom: 1px solid var(--lineColor);
}
.pc-feed-story { text-align: center; flex-shrink: 0; width: 64px; }
.pc-feed-story-ring {
  width: 56px; height: 56px;
  border-radius: 50%;
  border: 2.5px solid var(--mainColor);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 4px;
}
.pc-feed-story-ring span { width: 44px; height: 44px; border-radius: 50%; background: var(--bg-subtle, #F8F9FA); display: block; }
.pc-feed-story-label { font-size: 10px; color: var(--textSub); }

.pc-feed-posts { display: flex; flex-direction: column; }
.pc-feed-post { border-bottom: 8px solid var(--bg-subtle, #F8F9FA); padding-bottom: 12px; }
.pc-feed-post-head { display: flex; align-items: center; gap: 8px; padding: 10px 14px; }
.pc-feed-post-avatar { width: 32px; height: 32px; font-size: 14px; }
.pc-feed-post-author { font-weight: 700; font-size: var(--fs-sm); color: var(--textBody); display: flex; align-items: center; gap: 4px; }
.pc-feed-post-badge {
  margin-left: auto;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 50px;
  background: var(--mainColorLight);
  color: var(--mainColorDark);
}
.pc-feed-post-media {
  display: block;
  width: 100%;
  aspect-ratio: 1;
  background-size: cover;
  background-position: center;
}
.pc-feed-post-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pc-feed-post-actions { display: flex; gap: 16px; padding: 10px 14px 4px; font-size: 20px; }
.pc-feed-post-save { margin-left: auto; }
.pc-feed-post-likes { padding: 0 14px; font-weight: 700; font-size: var(--fs-sm); color: var(--textBody); margin-bottom: 4px; }
.pc-feed-post-caption { padding: 0 14px; font-size: var(--fs-sm); color: var(--textBody); margin-bottom: 10px; }
.pc-feed-post-cta { margin: 0 14px; display: block; text-align: center; padding: 10px; }

.pc-feed-bottomnav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  display: flex;
  background: #fff;
  border-top: 1px solid var(--lineColor);
  z-index: 50;
}
.pc-feed-bottomnav-item {
  flex: 1;
  text-align: center;
  padding: 8px 0 6px;
  font-size: 20px;
  text-decoration: none;
  color: var(--textSub);
}
.pc-feed-bottomnav-item span { display: block; font-size: 10px; margin-top: 2px; }
.pc-feed-bottomnav-item--active { color: var(--mainColorDark); }

/* Tablet: 2-col feed + sidebar */
@media (min-width: 768px) {
  .pc-feed-wrap { max-width: 100%; display: grid; grid-template-columns: 2fr 1fr; gap: 24px; padding: 24px; }
  .pc-feed-stories { grid-column: 1 / -1; max-width: 700px; }
  .pc-feed-posts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .pc-feed-post { border: 1px solid var(--lineColor); border-radius: 16px; overflow: hidden; }
  .pc-feed-bottomnav { position: static; grid-column: 1 / -1; }
}
