@mixin controlswiper(){
	.swiper-pagination-bullets{
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 4px;
		.swiper-pagination-bullet{
			box-shadow: none;
			outline: 0;
			width: 10px;
			height: 10px;
			border: 1px solid #ddd;
			border-radius: 50%;
			background: rgba(255, 255, 255 ,0.2);
			padding: 0;
			font-size: 0;
			opacity: 1;
			&.swiper-pagination-bullet-active{
				transition: all .2s;
				background: var(--mainColor);
			}
		}
	}
	.swiper-button-next{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		right: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(32px , -50%);
		-ms-transform: translate(32px, -50%);
		transform: translate(32px, -50%);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%);
		transform: translateY(-50%);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	.swiper-button-prev{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		left: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(-32px, -50%) rotate(180deg);
		-ms-transform: translate(-32px, -50%) rotate(180deg);
		transform: translate(-32px, -50%) rotate(180deg);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%) rotate(180deg);
		transform: translateY(-50%) rotate(180deg);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	@media(max-width: 767px) {
		.swiper-button-next,.swiper-button-prev{
			width: 25px;
			height: 25px;
			line-height: 25px;
			&:after {
				font-size: var(--fs-sm);
			}
		}
	}
	.swiper-button-lock {
		display: none !important;
	}
	.swiper-button-disabled{
		opacity: 0.35;
	}
}
.layout-blog{
	padding-bottom: 30px;
	.title-page{
		margin-bottom: 15px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		.btxt_blog {
			font-size: var(--fs-3xl);
			font-weight: bold;
			color: var(--mainColor);
			margin-bottom: 0px;
		}
		.see_more_blog {
			font-weight: 600;
			color: var(--mainColor);
			font-size: var(--fs-md);
			@media(max-width: 767px) {
				display: none !important;
			}
			&:hover {
				color: var(--subColor);
			}
		}
	}
	.d-md-none.text-center{
		text-align: center;
		.see_more_blog_mob {
			display: inline-block;
			border: 1px solid var(--mainColor);
			color: var(--mainColor);
			font-size: var(--fs-sm);
			font-weight: 500;
			padding: 3px 15px;
			border-radius: 10px;
			&:hover {
				border: 1px solid var(--subColor);
				color: var(--subColor);
			}
		}
	}
	.blog-item-big {
		position: relative;
		border-radius: 10px;
		overflow: hidden;
		.image-blog {
			padding-bottom: 57%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			img {
				width: auto !important;
				max-height: 100%;
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				transition: .3s ease-in-out all;
				will-change: opacify;
				border-radius: 10px;
				transform: scale(1.05);
			}
		}
		.content_blog {
			position: absolute;
			padding: 5px 5px;
			width: 100%;
			bottom: 0;
			background: linear-gradient(180deg,rgba(51,51,51,0) 0%,rgba(51,51,51,1) 100%);
			a {
				color:#fff;
				&:hover, &:focus {
					color: var(--subColor);
				}
			}
			h2 {
				margin-bottom: 0px;
				a{
					line-height: 24px;
					margin: 0;
					word-break: break-word;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					text-overflow: ellipsis;
					overflow: hidden;
					height: 48px;
					font-size: var(--fs-md);
					@media(max-width: 767px) {
						font-size: var(--fs-base);
					}
				}
			}
		}
	}
	.item_small_blog {
		display: flex;
		flex-wrap: wrap;
		padding-bottom: 7px;
		padding-top: 7px;
		.post-thumb {
			width: 140px;
			margin-right: 10px;
			border-radius: 5px;
			overflow: hidden;
			@media (max-width:767px) {
				width: 130px;
			}
			.image-blog {
				padding-bottom: 54%;
				overflow: hidden;
				height: auto;
				display: block;
				position: relative;
				border-radius: 10px;
				img {
					width: auto !important;
					max-height: 100%;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
					transition: .3s ease-in-out all;
					will-change: opacify;
					border-radius: 10px;
					transform: scale(1.05);
				}
			}
		}
		.contentright {
			width: calc(100% - 150px);
			@media (max-width:767px) {
				width: calc(100% - 140px);
			}
			h3{
				font-size: var(--fs-sm);
				margin: 0;
				margin-bottom: 0px;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				&:hover {
					color: var(--subColor);
					a {
						color: var(--subColor);
					}
				}
			}
		}
		.time-post {
			margin-bottom: 0px;
			span {
				font-size: var(--fs-sm);  /* rounded from 13px */
				font-style: italic;
			}
		}
		&:last-child{
			border: initial;
			margin: 0;
			padding: 0;
			@media(max-width: 767px) {
				margin-bottom: 10px;
			}
		}
	}
	.list-news {
		.item-blog {
			display: block;
			position: relative;
			margin-bottom: 20px;
			.update_date {
				display: flex;
				margin-bottom: 7px;
				font-size: var(--fs-xs);
				color: #838383;
				justify-content: space-between;
				.user_name {
					b {
						color: var(--mainColor);
						font-weight: 500;
					}
				}
				.user_date {
					font-style: italic;
				}
			}
			.image-blog{
				padding-bottom: 57%;
				overflow: hidden;
				height: auto;
				display: block;
				position: relative;
				border-radius: 10px 10px 0px 0px;
				background-color: #fff;
				img {
					width: auto !important;
					max-height: 100%;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
					transition: .3s ease-in-out all;
					will-change: opacify;
					transform: scale(1.05);
				}
			}
			.blog_content {
				position: relative;
				width: 100%;
				padding: 20px;
				background-color: #fff;
				border-radius: 0px 0px 10px 10px;
				@media(max-width: 767px) {
					padding: 10px;
				} 
				@media(max-width: 322px) {
					padding: 5px;
				}
				h3 {
					margin-bottom: 7px;
					line-height: 22px;
					a {
						color:var(--textColor);
						font-size: var(--fs-base);
						line-height: 22px;
						font-weight: 600;
						display: -webkit-box;
						-webkit-line-clamp: 2;
						-webkit-box-orient: vertical;
						overflow: hidden;
						height: 44px;
						&:hover, &:focus {
							color:var(--subColor);
						}
					}
				}
				.blog_description {
					color: var(--textColor);
					line-height: 20px;
					margin-bottom: 0px;
					word-break: break-word;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					text-overflow: ellipsis;
					overflow: hidden;
					height: 40px;
				}
			}
			&:hover{
				.image-blog img {
					transform: scale(1.15);
				}
			}
		}
	}

}
.side-right-stick {
	position: sticky;
	top: 60px;
}
.aside-content-blog{
	border: 1px solid #dee2e6;
	border-radius: 10px;
	padding: 15px;
	margin-bottom: 30px;
	@media(max-width: 767px) {
		margin-bottom: 25px;
	}
	.title-head{
		color: var(--textColor);
		margin: 0;
		font-size: var(--fs-xl);
		font-weight: 600;
		padding: 0px 0px 8px;
		border-bottom: .5px dashed #ebe0e0;
		margin-bottom: 10px;
		line-height: 1.4;
	}
	.nav-category{
		ul{
			padding: 0;
			margin: 0;
			list-style: none;
			.nav-item{
				.nav-link {
					display: block;
					padding: 3px 0;
					&.pr-5{
						padding-right: 30px;
					}
				}
				&:hover, &:focus{
					>a{
						color: var(--subColor);
						background-color: transparent;
					}
					>.down_icon {
						&::before, &::after{
							background-color: var(--subColor);
						}
					}
				}
				&.active{
					> .nav-link{
						color: var(--mainColor);
					}
				}
			}
			.menu_down {
				padding-left: 10px !important;
			}
			.down_icon{
				width: 30px;
				height: 30px;
				top: 2px;
				right: 0;
				transition: 0.5s all;
				cursor: pointer;
				position: absolute;
				display: flex;
				justify-content: center;
				align-items: center;
				&::before, &::after{
					position: absolute;
					content: '';
					top: 50%;
					left: 50%;
					-webkit-transform: translate(-50%, -50%) rotate(-90deg);
					transform: translate(-50%, -50%) rotate(-90deg);
					background-color: currentColor;
					-webkit-transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
					transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
					transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
					transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
				}
				&::before {
					width: 11px;
					height: 1px;
					opacity: 1;
				}
				&::after {
					width:1px;
					height: 11px;
				}
				&:hover, &:focus{
					&::before, &::after{
						background-color: var(--subColor);
					}
				}
				&.cls_mn{
					>a {
						color: var(--mainColor);
					}
					&::after {
						-webkit-transform: translate(-50%, -50%) rotate(90deg);
						transform: translate(-50%, -50%) rotate(90deg);
					}
					&::before {
						opacity: 0;
					}
				}
			}
		}
	}
}
.blog_noibat{
	border: 1px solid #dee2e6;
	border-radius: 15px;
	padding: 15px;
	h2{
		color: var(--textColor);
		margin: 0;
		font-size: var(--fs-xl);
		font-weight: 600;
		padding: 0px 0px 8px;
		border-bottom: .5px dashed #ebe0e0;
		margin-bottom: 15px;
		line-height: 1.4;
		a {
			color: var(--textColor);
			position: relative;
			&:hover {
				color: var(--subColor);
			}
		}
	}
	.blog_content {
		.item {
			display: flex;
			flex-wrap: wrap;
			margin-bottom: 10px;
			border-bottom: 1px dashed #F2F2F2;
			padding-bottom: 5px;
			.post-thumb {
				width: 100px;
				margin-right: 10px;
				a {
					display: block;
					width: 100%;
					aspect-ratio: 600/380;
					overflow: hidden;
					border-radius: 4px;
					position: relative;
					img.loaded {
						width: auto !important;
						max-height: 100%;
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						margin: auto;
					}
				}
			}
			.contentright {
				width: calc(100% - 110px);
				h3{
					font-size: var(--fs-sm);
					margin: 0;
					margin-bottom: 0px;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					overflow: hidden;
					&:hover {
						color: var(--subColor);
						a {
							color: var(--subColor);
						}
					}
				}
			}
			.time-post {
				margin-bottom: 0px;
				span {
					font-size: var(--fs-sm);  /* rounded from 13px */
					font-style: italic;
				}
			}
			&:last-child{
				border: initial;
				margin: 0;
				padding: 0;
			}
		}
	}
}

