				padding-right: 35px;
			}
			@media(max-width: 992px) {
				padding-right: 0px;
			}
		}
		.article-content-main {
			h2 {
				color: var(--mainColor);
			}
		}
		.box_img_cont {
			display: flex;
			align-items:center;
			margin-bottom: 20px;
			.img_duoc_si{
				padding-bottom: 170px;
				overflow: hidden;
				height: auto;
				display: block;
				position: relative;
				border-radius: 10px;
				width: 170px;
				margin-right: 15px;
				min-width: 170px;
				@media(max-width: 767px) {
					width: 140px;
					min-width: 140px;
					padding-bottom: 140px;
				}
				img {
					max-height: 150px;
					max-width: 150px;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
					transition: .3s ease-in-out all;
					will-change: opacify;
					max-width: 100%;
					display: block;
					width: 150px;
					height: 150px;
					border-radius: 50%;
					overflow: hidden;
					margin-left: auto;
					margin-right: auto;
					object-fit: cover;
					@media(max-width: 767px) {
						max-height: 130px;
						max-width: 130px;
					}
				}
			}
			.article-title{
				margin-top: 0px;
				margin-bottom: 4px;
				font-size: 1.625rem;
				font-weight: 700;
				line-height: 1.4;
				color: var(--mainColor);
				@media(max-width: 767px) {
					font-size: 1.375rem;
				}
			}
		}
		.box_summary {
			padding: 20px;
			border-radius: 8px;
			font-size: var(--fs-base);
			box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 4px, rgba(0, 0, 0, 0.3) 0px 7px 13px -3px, rgba(0, 0, 0, 0.2) 0px -3px 0px inset;
			border-left: 4px solid var(--mainColor);
			margin-bottom: 20px;
			display: block;
			p:last-child {
				margin-bottom: 0px;
			}
		}
		.link_duoc_si {
			display: block;
			margin-bottom: 20px;
			ul {
				list-style: none;
				padding: 0;
				li {
					display: grid;
					grid-template-columns: 24px minmax(0, 1fr);
					grid-gap: 8px;
					align-items: center;
					margin-bottom: 8px;
					svg {
						width: 24px;
						height: 25px;
						color: var(--mainColor);
					}
				}
			}
		}

		.blog_related {
			margin-top: 30px;
			margin-bottom: 15px;
			@media (min-width: 992px) {
				margin-bottom: -20px;
			}
			.title {
				color: var(--textColor);
				margin: 0;
				margin-bottom: 15px;
				display: inline-block;
				font-weight: 600;
				font-size: 1.625rem;
				@media (max-width: 767px) {
					font-size: var(--fs-2xl);
				}
			}
			.item-duoc-si-blog {
				box-shadow: none;
				border: 1px solid #f0f1f2;
			}
			.blog-swiper {
				padding: 2px;
				@include controlswiper();
