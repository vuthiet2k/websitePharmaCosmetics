					.swiper-button-next, .swiper-button-prev {
						display: block;
					}
				}
			}
		}
	}
	.box_blog_list {
		padding: 15px 15px 0px;
		background-color: #fff;
		border-radius: 15px;
		margin-bottom: 30px;
		@media(min-width:992px){
			&:last-child {
				margin-bottom: 0px;
			}
		}
	}
	.item-blog-all {
		display: block;
		position: relative;
		margin-bottom: 20px;

		.update_date {
			display: flex;
			margin-bottom: 7px;
			font-size: var(--fs-xs);
			color: #838383;
			justify-content: space-between;
			.user_name {
				b {
					color: var(--mainColor);
					font-weight: 500;
				}
			}
			.user_date {
				font-style: italic;
			}
		}
		.image-blog{
			padding-bottom: 57%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			border-radius: 10px 10px 0px 0px;
			background-color: var(--bgBodySub);
			img {
				width: auto !important;
				max-height: 100%;
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				transition: .3s ease-in-out all;
				will-change: opacify;
			}
		}
		.blog_content {
			position: relative;
			width: 100%;
			padding: 20px;
			background-color: var(--bgBodySub);
			border-radius: 0px 0px 10px 10px;
			@media(max-width: 767px) {
				padding: 10px;
			} 
			@media(max-width: 322px) {
				padding: 5px;
			}
			h3 {
				margin-bottom: 7px;
				line-height: 22px;
				a {
					color:var(--textColor);
					font-size: var(--fs-base);
					line-height: 22px;
					font-weight: 600;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					overflow: hidden;
					height: 44px;
					&:hover {
						color:var(--subColor);
					}
				}
			}
			.blog_description {
				color: var(--textColor);
				line-height: 20px;
				margin-bottom: 0px;
				word-break: break-word;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				text-overflow: ellipsis;
				overflow: hidden;
				height: 40px;
			}
		}
		&:hover{
			.image-blog img {
				transform: scale(1.1);
			}
		}
	}
	.box_all_duocsi {
		background-color: var(--bgBodySub);
		padding: 40px 0px;
		.title-page{
			margin-bottom: 15px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			.btxt_blog {
				font-size: var(--fs-3xl);
				font-weight: bold;
				color: var(--mainColor);
				margin-bottom: 0px;
				font-family: "Coiny", system-ui;
			}
			.see_more_blog {
				font-weight: 600;
				color: var(--mainColor);
				font-size: var(--fs-md);
				@media(max-width: 767px) {
					display: none !important;
				}
				&:hover {
					color: var(--hover);
				}
			}
		}
	}
	.blog_noibat {
		background-color:#fff;
	}
}
.hidescroll {
	display: none;
}
.auto{
	display: block;
}
.fixMenu {
	margin: 0;
	padding: 0;
	position: fixed;
	top: 60px;
	right: 0;
	width: auto;
	min-width: 300px;
	border: 1px solid rgba(224,224,224,0.95);
	background: #f9f9f9;
	overflow: auto;
	z-index: 999;
	max-width: 300px;
	.closeftoc {
		padding: 7px;
		position: relative;
		margin-bottom: 10px;
		background: rgba(237,237,237,.95);
		font-weight: 400;
		font-size: var(--fs-lg);
		img {
			width: 24px;
			margin-right: 10px;
			vertical-align: middle;
		}
		span {
			cursor: pointer;
			position: absolute;
			right: 10px;
			top: 9px;
			font-size: var(--fs-lg);
			border-radius: 100%;
			width: 25px;
			height: 25px;
			border: 2px solid #333;
			line-height: 18px;
			text-align: center;
			font-weight: 400;
			&:hover {
				background-color:var(--mainColor);
				border: 2px solid var(--mainColor);
				color: #fff;
			}
		}
	}
	.bean-toc-bottom {
		max-height: 450px;
		overflow-y: scroll;
		> ol {
			padding-left: 0px;
			list-style: decimal;
			list-style-type: none;
			list-style-position: inherit;
			padding-left: 0px;
			li {
				> a {
					padding: 5px 10px;
					display: inline-block;
					width: 100%;
					&:hover {
						background: var(--mainColor);
						color: #fff;
					}
				}
				.is-collapsible {
					list-style: decimal;
					list-style-type: circle;
					list-style-position: inherit;
					padding-left: 0px;
					li {
						padding-left: 0px;
						display: inline-block;
						width: 100%;
						a {
							padding-left: 30px;
							font-style: italic;
							position: relative;
							width: 100%;
							&:before {
								content: "";
								top: 13px;
								left: 15px;
								position: absolute;
								width: 9px;
								height: 9px;
								border: solid 2px #d7d7d7;
								border-radius: 50%;
							}
						}
						&.is-active-li {
							> a {
								background: var(--mainColor);
								color:#fff;
							}
						}
					}
				}
				&.is-active-li {
					> a {
						background: var(--mainColor);
						color:#fff;
					}
				}
			}
		}
	}
}
.setmenuclick {
	z-index: 9999;
    position: relative;
}
.tabClick{
	position: fixed;
	top: calc(30% + 60px) !important;
	right: 0;
	z-index: 99;
	padding: 10px;
	border-radius: 5px 0 0 5px;
	background: var(--subColor);
	cursor: pointer;
	img{
		width: 30px;
		filter: brightness(0) invert(1);
		-webkit-filter: brightness(0) invert(1);
	}
}
.ftoc-head{
	background:#ebf9ff;
	padding: 5px 10px;
	border-radius: 5px;
	margin-bottom: 30px;
	.title-goto-wrapper{
		position: relative;
		font-size: var(--fs-xl);
		font-weight: 700;
		color: var(--mainColor);
		display: inline-block;
		img{
			height: 25px;
			position: absolute;
			left: 100%;
			top: -2px;
		}
	}
	.bean-toc {
		.toc-list  {
			list-style: decimal;
			list-style-type: disc;
			list-style-position: inherit;
			padding-left: 20px;

			.toc-list-item {
				color: #000;
				margin-bottom: 10px;
				font-size: var(--fs-base);
				a {
					color: #000;
					font-size: var(--fs-base);
				}
				.is-collapsible {
					list-style: decimal;
					list-style-type: circle;
					list-style-position: inherit;
					padding-left: 20px;
				}
			}
		}
	}
}