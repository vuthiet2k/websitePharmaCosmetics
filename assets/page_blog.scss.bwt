.pagi-div {
	display: block;
	position: relative;
	width: 100%;
}
.alert-success, .alert-danger {
	margin-bottom: 15px;
}

.article-main  {
	.time-post {
		font-weight: 400;
		color: #747474;
		display: inline-block;
		margin-right: 10px;
		svg{
			width: 15px;
			height: 15px;
			margin-top: -5px;
			margin-right: 2px;
		}
	}
	.article-title{
		margin-top: 0px;
		margin-bottom: 4px;
		font-size: 1.625rem;
		font-weight: 700;
		color: #333;
	}
	.goto-wrapper {
		width: 100%;
		background:var(--bgBodySub);
		border-radius: 5px;
		display: table;
		margin-bottom: 1em;
		padding: 10px;
		position: relative;
		.title-goto-wrapper {
			font-weight: 600;
			display: flex;
			align-items: center;
			justify-content: space-between;
			.icon {
				width: 34px;
				height: 34px;
				border-radius: 5px;
				padding: 5px 4px;
				background: var(--mainColor);
				line-height: 1;
				svg {
					width: 24px;
					height: 24px;
					path {
						fill: #fff;
					}
				}
				&:hover {
					background: var(--subColor);
				}
			}
		}
		.menu-toc{
			margin-top: 8px;
			.toc-list  {
				list-style: decimal;
				list-style-type: disc;
				list-style-position: inherit;
				padding-left: 20px;

				.toc-list-item {
					color: #000;
					margin-bottom: 4px;
					font-size: var(--fs-lg);
					a {
						color: #000;
						font-size: var(--fs-lg);
						&:hover {
							color: var(--subColor);
						}
					}
					.is-collapsible {
						list-style: decimal;
						list-style-type: circle;
						list-style-position: inherit;
						padding-left: 20px;
					}
				}
			}
		}
	}
	.article-content-main {
		margin-bottom: 20px;
		transition: 0.5s all;
		h2, h3 {
			transition: 0.5s all;
		}
		&.font-large {
			font-size: var(--fs-xl);
			h2 {
				font-size: var(--fs-3xl);
			}
			h3 {
				font-size: 1.21875rem;
			}
		}
		a {
			color: blue;
			text-decoration: underline;
			&:hover {
				color: var(--subColor);
			}
		}
		h2,h3 {
			&:before {
				display: block;
				content: " ";
				height: 60px;
				margin-top: -60px;
				visibility: hidden;
			}
		}
	}
	.posts {
		font-size: var(--fs-md);
		margin-bottom: 0px;
	}
	.size-content-detail {
		margin-bottom: 15px;
		padding-bottom: 15px;
		border-bottom: 1px solid #e4e8ed;
		p {
			margin-bottom: 0px;
		}

		.lc-switch-size {
			display: -webkit-box;
			display: -webkit-flex;
			display: -ms-flexbox;
			display: flex;
			-webkit-align-items: center;
			-webkit-box-align: center;
			-ms-flex-align: center;
			align-items: center;
			-webkit-box-pack: justify;
			-webkit-justify-content: space-between;
			justify-content: space-between;
			gap: 10px;
			margin-top: 8px;

			.lc-option-box-size {
				display: -webkit-box;
				display: -webkit-flex;
				display: -ms-flexbox;
				display: flex;
				border: 1px solid #e4e8ed;
				border-radius: 1000px;
				padding: 2px !important;
				list-style: none !important;
				margin-bottom: 0px !important;
				.cursor-pointer {
					padding: 4px 8px;
					display: -webkit-box;
					display: -webkit-flex;
					display: -ms-flexbox;
					display: flex;
					-webkit-box-pack: center;
					-ms-flex-pack: center;
					-webkit-justify-content: center;
					justify-content: center;
					color: #4a4f63;
					cursor: pointer;
					&.active {
						background-color: var(--mainColor);
						color: #fff;
						border-radius: 40px;
					}
				}
				p {
					margin-bottom: 0px;
				}
			}
		}
		@media screen and (min-width: 769px){
			display: -webkit-box;
			display: -webkit-flex;
			display: -ms-flexbox;
			display: flex;
			-webkit-box-pack: justify;
			-webkit-justify-content: space-between;
			justify-content: space-between;
			align-items: center;
			.lc-switch-size {
				margin-top: 0;
				-webkit-flex-basis: 280px;
				-ms-flex-preferred-size: 280px;
				flex-basis: 280px;
				-webkit-box-pack: end;
				-ms-flex-pack: end;
				-webkit-justify-content: flex-end;
				justify-content: flex-end;
				margin-left: auto;
				min-width: 280px;
			}
		}
	}
	.rte {
		iframe{
			@media (max-width: 767px){
				width: 100%;
			}
		}
		ul { 
			list-style: initial; 
			padding-left: 25px;
			margin-bottom: 15px;
		} 
	}
	form {
		display: block;
		padding: 15px;
		background: var(--bgBodySub);
		margin-bottom: 0px;
		border-radius: 5px;
		@media (max-width: 767px) {
			padding: 15px 10px;
		}
		label {
			display: block;
			margin-bottom: 4px;
			font-weight:700;
			.required {
				color: #ff0000;
			}
		}
	}
	.form-group {
		input {
			height:40px;
			border:solid 1px #cfcfcf;
			padding: 0 15px;
			outline: none;
			width: 100%;
			margin-bottom: 15px;
			&::placeholder {
				color: #7c7c7c;	
			}
			&:-ms-input-placeholder { 
				color: #7c7c7c;
			}
			&::-ms-input-placeholder {
				color: #7c7c7c;
			}
		}

	}
	textarea {
		border:solid 1px #cfcfcf;
		padding: 10px;
		outline: none;
		width: 100%;
		&::placeholder {
			color: #7c7c7c;	
			opacity: 1; 
		}
		&:-ms-input-placeholder { 
			color: #7c7c7c;
		}
		&::-ms-input-placeholder {
			color: #7c7c7c;
		}
	}
	.button_45 {
		margin-top: 15px;
	}
	.title-form-coment {
		color: var(--textColor);
		margin: 0;
		font-size: var(--fs-xl);
		font-weight: 600;
		margin-bottom: 15px;
		line-height: 1.4;
	}
}
.article-comment-list {
	margin-top: 20px;
	.article-comment {
		margin-bottom: 10px;
		padding-bottom: 10px;
		border-bottom: 1px dotted #c9c8c5;
		display: flex;
		justify-content: space-between;
		&:last-child {
			border-bottom: 0px dotted #c9c8c5;
		}
		.article-comment-user-image {
			margin: 0;
			float: left;
			width: 45px;
			height:45px;
			display:block;
			border-radius: 50%;
			border: 1px solid #ddd;
			flex-grow: 0;
			flex: none;
			overflow: hidden;
		}
		.article-comment-user-comment {
			display:block;
			float:left;
			padding-left:10px;
			word-break: break-word;
			font-size: var(--fs-md);
			flex-grow: 1;
		}
		.user-name-comment {
			margin: 0;
			font-size: var(--fs-md);
			font-weight: 500 !important;
		}
		.article-comment-date-bull {
			display: block;
			color: #b0b0b0;
			font-size:0.75rem;
		}
		.cm {
			font-size:0.875rem;
			color:#707070;
			margin: 0px;
		}
	}
}
.tag_article {
	padding: 15px 0;
	.inline {
		font-weight: 600;
		margin-right: 4px;
	}
	a {
		background: var(--subColor);
		color: #fff;
		display: inline-block;
		height: 24px;
		line-height: 24px;
		padding: 0 15px 0 15px;
		position: relative;
		margin: 0 5px 5px 0;
		text-decoration: none;
		border-radius: 4px;
		&:hover {
			background: var(--mainColor);
		}
	}
}
.social-sharing {
	margin-bottom: 20px;
	.social-media {
		display: flex;
		align-items: center;
		gap: 10px;
		li {
			&.title {
				svg {
					width: 20px;
					height: 20px;
					margin-right: 4px;
				}
			}
			a {
				width: 28px;
				height: 28px;
				border-radius: 4px;
				background: var(--mainColor);
				display: flex;
				justify-content: center;
				align-items: center;
				svg {
					width: 20px;
					height: 20px;
					path {
						fill: #fff !important;
					}
				}
				&:hover {
					background: var(--subColor);
				}
			}
		}
	}
}
.blog_related {
	margin-top: 30px;
	margin-bottom: 15px;
	@media (min-width: 992px) {
		margin-bottom: -20px;
	}
	.title {
		color: var(--textColor);
		margin: 0;
		margin-bottom: 15px;
		display: inline-block;
		font-weight: 600;
		font-size: 1.625rem;
		@media (max-width: 767px) {
			font-size: var(--fs-2xl);
		}
	}
	.item-blog {
		display: block;
		position: relative;
		.update_date {
			display: flex;
			margin-bottom: 7px;
			font-size: var(--fs-xs);
			color: #838383;
			justify-content: space-between;
			.user_name {
				b {
					color: var(--mainColor);
					font-weight: 500;
				}
			}

		}
		.image-blog{
			padding-bottom: 57%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			border-radius: 10px;
			background-color: #f8f8f8;
			.user_date {
				position: absolute;
				top: 0px;
				left: 0px;
				background-color: var(--mainColor);
				padding: 5px;
				border-radius: 10px 0px 10px 0px;
				color:#fff;
				font-size: var(--fs-sm);
				font-weight: 600;
			}
			img {
				width: auto !important;
				max-height: 100%;
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				transition: .3s ease-in-out all;
				will-change: opacify;
			}
		}
		.blog_content {
			position: relative;
			width: 100%;
			padding-top: 15px;
			background-color: #fff;
			h3 {
				margin-bottom: 7px;
				line-height: 22px;
				a {
					color:var(--textColor);
					font-size: var(--fs-base);
					line-height: 22px;
					font-weight: 600;
					display: -webkit-box;
					-webkit-line-clamp: 2;
					-webkit-box-orient: vertical;
					overflow: hidden;
					height: 44px;
					&:hover {
						color:var(--subColor);
					}
				}
			}
			.blog_description {
				color: var(--textColor);
				line-height: 20px;
				margin-bottom: 10px;
				word-break: break-word;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				text-overflow: ellipsis;
				overflow: hidden;
				height: 40px;
			}
			.read_more {
				font-weight: 600;
			}
		}
		&:hover{
			.image-blog img {
				transform: scale(1.1);
			}
		}
	}
	.blog-swiper {
		@include controlswiper();
	}
}
.box_blog_list {
	margin-bottom: 30px;
	@media(min-width:992px){
		&:last-child {
			margin-bottom: 0px;
		}
	}
}
