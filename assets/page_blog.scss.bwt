.box_kiem_duyet{
	color: #000;
	background-color: var(--bgBodySub);
	padding: 15px;
	border-radius: 10px;
	margin: 30px 0px;
	border: 1px solid #ddd;
	@media(max-width: 767px) {
		margin: 25px 0px;
		.name_title {
			margin-bottom: 5px !important;
		}
	}
	.box_content_kiemd {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
		@media(max-width: 767px) {
			display: block;

		}
	}
	.title{
		-ms-flex: 0 0 100%;
		flex: 0 0 100%;
		max-width: 100%;
		position: relative;
		width: 100%;
		font-weight: 700;
		margin-top: 5px;
		b{
			color: var(--mainColor);
			display: block;
			font-size: var(--fs-xl);  /* TODO confirm — rounded from 26px */
			margin-bottom: 5px;
		}
		span{
			padding: 2px 5px;
			display: inline-flex;
			align-items: center;
			font-size: var(--fs-xs);
			border: 2px solid var(--subColor);
			border-radius: 10px;
			color: var(--subColor);
			margin-bottom: 10px;
			svg{
				border: 2px solid;
				border-radius: 50%;
				margin-right: 5px;
				width: 16px;
				height: 16px;
			}
			path{
				fill:var(--subColor) ;
			}
		}
	}
	.item_store{
		display:flex;
		.item_image_store {
			width:72px;
			height: 70px;
			margin-right: 10px;
			min-width:72px;
		}
		.image{
			padding-bottom: 100%;
			overflow: hidden;
			height: auto;
			display: block;
			position: relative;
			width: 100%;
			margin: auto;
			background: #fff;
			border-radius: 5px;
			border: 1px solid #DDE1EF !important;
			img {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				-o-object-fit: contain;
				object-fit: contain;
				padding: 3px;
			}
		}

		.info_store {
			width: 100%;
			.name_title, .text_title {
				margin-bottom: 0px;
				font-size: var(--fs-xl);
				font-weight: 600;
				line-height: 1.2;
				@media(max-width: 767px) {
					font-size: var(--fs-md);
				}
			}
			.text_title { 
				color: var(--mainColor);
			}
			.kiem_d_content {
				display: flex;
				align-items: center;
				svg {
					width: 16px;
					height: 16px;
					margin-right: 5px;
				}
			}
		}
	}
	.content_kiemd {
		p {
			margin-bottom: 0px;
		}
		.text-body2 {
			color: var(--mainColor);
			display: inline-flex;
			align-items: center;
			font-weight: 500;
			svg {
				width: 12px;
				height: 12px;
				margin-left: 2px;
				margin-top: 1px;
				path {
					fill: var(--mainColor);
				}
			}
			&:hover, &:focus {
				color: var(--subColor);
				svg {
					path {
						fill: var(--subColor);
					}
				}
			}
		}
	}

}
.box_cate_pro {
	border-bottom: 1px dotted #ddd;
	border-top: 1px dotted #ddd;
	display: block;
	padding: 15px 0;
	margin-bottom: 30px;
