.bread-crumb {
	background: var(--bgBodySub);
	margin-bottom: 30px;
}
.bizweb-product-reviews-module {
	margin:0!important;
}
.breadcrumb {
	margin: 0;
	font-size: var(--fs-sm);
	padding: 10px 0px;
	border-radius: 0;
	font-weight: 500;
	line-height: 24px;
	background-color: transparent;
	width: 100%;
	text-align: left;
	word-break: break-word;
	li {
		display: inline;
		> a {
			color: #666;
			> span {
				color:#666;
			}
		}
		.mr_lr {
			padding: 0px 3px;
			color: #666;
			svg{
				width: 10px;
				height: 10px;
				margin-top: -2px;
			}
		}
		span {
			display: inline;
			color:#666;

			.fa {
				color: #666;
				padding: 0px 5px;
			}
		}
		a:hover, &.active, strong {
			color: var(--subColor);
			font-weight: 500;
			text-decoration:none;
			span {
				color: var(--mainColor);
			}
		}
	}
	>li+li:before{
		display: none;
	}
}
/*3.4 Pagination*/

.pagenav {
	position:relative;
	width:100%;
	margin-bottom: 20px;
	span {
		display:inline-block;
		float:left;
		margin-right:10px;
		line-height:30px;
		font-weight:700;
	}
}
.nav_pagi {
	display: inline-block;
	width: 100%;
	.pagination {
		position: relative;
		z-index: 1;
		padding: 0 0px;
		margin: 0 0 0px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		list-style: none;
		@media (max-width: 768px){
			padding: 0 0px;
		}
		.page-link {
			font-weight:400;
			float: left;
			margin: 0 2.5px;
			margin-bottom: 5px;
			width: 30px;
			background: transparent;
			border:solid 1px var(--mainColor);
			text-align: center;
			height: 30px;
			font-size: var(--fs-sm);
			padding:0;
			line-height: 28px;		
			color: var(--mainColor); 
			text-decoration: none;
			border-radius: 5px;
			&.link-next-pre {
				line-height: 26px;	
			}

			&.page-db {
				width: auto;
				padding: 0 20px;
			}	
			&:hover {
				background-color: var(--mainColor);			
				color: #fff;
			}
			svg{
				width: 14px;
				height: 14px;
				margin-top: -3px;
			}
		}
		.page-item {
			&.disabled .page-link {
				border: 0;
				display: none;
			}
			&.active .page-link {
				background-color: var(--mainColor);
				border-color: var(--mainColor);
				color: #fff;
				display: flex;
				justify-content: center;
				align-items: center;
			}
		}
	}
}