#quick-view-product {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.product-center-column {
		display: flex;
	}
	.quick-view-product {
		position: absolute;
		width:840px;
		top: 50%;
		transform: translate(0px, -50%);
		height: auto;
		margin: 0 auto;
		left: 0;
		right: 0;
		padding: 15px;
		background-color: #fff;
		z-index: 8011;
		border-radius: 5px;
		opacity: 0;
		animation-delay: 0.2s;
		animation-duration: 0.3s;
		animation-timing-function: ease-out;
		animation-fill-mode: forwards;
		animation-name: popup-fade-in-up;
		.quickview-close{
			position: absolute;
			right: -7px;
			top: -7px;
			width: 30px;
			height: 30px;
			border: 2px solid #f9f9f9;
			border-radius: 50%;
			display: flex;
			justify-content: center;
			align-items: center;
			background: var(--mainColor);
			color: #fff;
			svg {
				width: 15px;
				height: 15px;
				transition: transform 0.3s;
			}
			&:hover{
				svg {
					transform: rotate(90deg);
				}
			}

		}
	}
	.quickview-overlay {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}
	.large-image{
		.img-product{
			padding-bottom: 100%;
			display: block;
			height: 0;
			position: relative;
			img{
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				max-width: 100% !important;
				max-height: 100% !important;
				width: auto !important;
				height: auto !important;
				position: absolute;
			}
		}
	}
	.thumbs_list_quickview {
		margin-top: 15px;
		margin-right: -1px;
		padding-right: 1px;
		ul {
			list-style: none;
			padding: 0;
			margin: 0;
			.swiper-slide {
				a{
					padding-bottom: 100%;
					display: block;
					height: 0;
					position: relative;
					border: 1px solid #e9edf5;
					img{
						left: 50%;
						top: 50%;
						transform: translate(-50%, -50%);
						max-width:100% !important;
						max-height: 100% !important;
						width: auto !important;
						height: auto !important;
						position: absolute;
					}
				}
				&.active{
					a{
						border: 1px solid var(--mainColor);
						overflow: hidden;
						z-index: 1;
					}
				}
			}

		}
		.swiper-button-next {
			right: 0px;
		}
		.swiper-button-prev {
			left: 0px;
		}
		.swiper-button-next, .swiper-button-prev{
			background: transparent;
			&:after{
				font-size: 14px; /* icon size — giữ px */
				font-weight: bold;
				background: #fff;
				padding: 8px 5px;
				color: #333;
				box-shadow: 0 1px 2px 2px rgba(0, 0, 0, 0.04);
			}
			&:hover{
				&:after{
					color: var(--mainColor);
				}
			}
			&.swiper-button-disabled {
				display: none;
			}
		}
	}
	.product-info {
		.title-product {
			font-size: var(--fs-3xl);
			color: #333;
			font-weight: 600;
			padding-right: 20px;
		}
	}
	.group-status{
		margin-bottom: 10px;
		.first_status {
			display: inline-block;
			font-size: var(--fs-sm);
			.status_name{
				color: var(--mainColor);
			}
		}
		.line_tt {
			padding: 0 5px;
		}
	}
	.selector-wrapper {
		display: none !important;
	}
	.price-box {
		margin-bottom: 10px;
		display: block;
		.product-price {
			color: var(--price);
			font-size: var(--fs-lg);
			font-weight: 700;
		}
		.product-unit {
			color: var(--price);
			font-size: var(--fs-lg);
			font-weight: 700;
		}
		.old-price {
			color: #a5a5a5;
			font-size: var(--fs-base);
			margin-left: 5px;
		}
	}
	.product-summary {
		margin-bottom: 10px;
		font-size: var(--fs-sm);
		img{
			display: none;
		}
	}
	.form_product_content{
		margin-top: 10px;
		.quantity_wanted_p {
			display: -ms-flexbox;
			display: -webkit-flex;
			display: flex;
			align-items: center;
		}
		.soluong1 {
			display: inline-block;
			margin-bottom: 0px;
			font-size: var(--fs-sm);
			margin-right: 15px;
			.soluong_h {
				margin-bottom: 10px;
				display: block;
			}
			.input_number_product {
				display: inline-flex;
				vertical-align: top;
				white-space: nowrap;
				input#quantity-detail{
					width: 60px;
					border-radius: 0;
					border-right: none;
					border-left: none;
					padding: 0px;
					margin: 0px;
					text-align: center;
					height:40px;
					min-height: 40px;
				}
				.btn_num {
					padding: 0 5px;
					min-width: 40px;
					min-height: unset;
					height: 40px;
					border: 1px solid #ddd;
					background: #f3f3f3;
					box-shadow: none;
					display: flex;
					justify-content: center;
					align-items: center;
					&:hover {
						background: var(--mainColor);
						color: #fff;
					}
				}
				.num_1 {
					border-radius: 0;
					border-top-left-radius: 8px;
					border-bottom-left-radius: 8px;
				}
				.num_2 {
					border-radius: 0;
					border-top-right-radius: 8px;
					border-bottom-right-radius: 8px;
				}
			}

		}
		.button_actions{
			display: inline-block;
			button{
				border-radius: 8px;
				&.btn[disabled]{
					margin-top: 5px;
					opacity: 0.6;
				}
			}
		}
	}
	.swatch{
		font-size: var(--fs-sm);
		margin-bottom: 0px;
		.header{
			margin-bottom: 5px;
		}
		.swatch-element {
			display: inline-block;
			margin: 0px 10px 10px 0;
			position: relative;
			&.color {
				&:hover {
					@media (min-width: 1200px) {
						&:before {
							content: attr(title);
							position: absolute;
							bottom: calc(100% + 8px);
							left: 50%;
							padding: 3px 7px;
							background: #666;
							color: #fff;
							border-radius: 5px;
							font-size: var(--fs-base);
							white-space: nowrap;
							display: inline-block;
							line-height: initial;
							transform: translate(-50% ,0%);
						}
						&:after {
							display: block;
							position: absolute;
							border: 10px solid transparent;
							border-top-color: #666;
							content: "";
							left: 50%;
							bottom: calc(100% + -7px);
							z-index: -1;
							transform: translate(-50%, 0%);
						}
					}
				}
			}
			input{
				opacity: 0;
				z-index: 10;
				position: absolute;
				width: 100%;
				cursor: pointer;
				height: 100%;
			}
			label{
				min-width: 30px;
				height: 30px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #ebebeb;
				cursor: pointer;
				white-space: nowrap;
				padding: 0 5px;
				position: relative;
				margin-bottom: 0;
				text-align: center;
				line-height: 28px;
				border-radius: 8px;

			}
			input:checked+label {
				background: var(--mainColor);
				border-color: #ddd;
				color: #fff;
			}
			.tooltip{
				display: none;
			}
			&.soldout {
				position: relative;
				label{
					position: relative;
				}
			}
			&.color{
				{%for i in (1..20)%}
				{% capture label%}color_{{i}}{%endcapture%}                            
				{% assign title = settings[label]| downcase | handle%}
				{% capture color%}color_{{i}}_c{%endcapture%}			
				{% assign color1 = settings[color] %}
				{%if title != null and title != '' %}
				&.{{title}}{
					label{
						background-color:{{color1}};
						min-width: 30px;
						height: 30px;
					}
				}
				{%endif%}
				{%endfor%}
				label{
					border-radius: 50%;
				}
				input:checked+label{
					border: 2px solid #fff;
					box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
				}
			}
		}
	}
}