/* comp_article_card — thẻ bài viết snippets/pc_article_card.bwt (thiết kế "Kiến thức chăm sóc da", 2026-10-10).
   2026-10-13: tách khỏi page_product.scss.bwt để dùng chung trang sản phẩm, danh mục bài viết (templates/blog.bwt)
   và trang tổng tin tức (templates/page.tin-tuc.bwt). Nạp ở snippets/header_style.bwt. */
.pc-acard { display: flex; flex-direction: column; height: 100%; background: var(--white); border-radius: 18px; overflow: hidden; box-shadow: 0 6px 24px rgba(16, 64, 48, .08); font-family: var(--font-primary); }
.pc-acard__media { position: relative; display: block; aspect-ratio: 580 / 314; overflow: hidden; background: var(--color-mint-subtle); }
.pc-acard__media img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
.pc-acard:hover .pc-acard__media img { transform: scale(1.04); }
.pc-acard__cat { position: absolute; top: 18px; left: 22px; display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; font-size: var(--fs-sm); font-weight: 700; letter-spacing: .02em; text-transform: uppercase; background: var(--pc-topic-sand-bg); color: var(--pc-topic-sand); }
.pc-acard--tone1 .pc-acard__cat { background: var(--pc-topic-orange-bg); color: var(--pc-topic-orange); }
.pc-acard--tone2 .pc-acard__cat { background: var(--primary-mint-100); color: var(--pc-brand-deep); }
.pc-acard__body { display: flex; flex-direction: column; flex: 1; padding: 22px 22px 20px; }
.pc-acard__title { margin: 0 0 12px; font-family: var(--font-primary); font-size: var(--fs-lg); font-weight: 700; line-height: 1.4; text-transform: none; }
.pc-acard__title a { color: var(--color-text-main); text-decoration: none; }
.pc-acard__title a:hover { color: var(--pc-brand-deep); }
.pc-acard__excerpt { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin: 0 0 20px; font-size: var(--fs-base); line-height: 1.6; color: var(--color-text-muted); }
.pc-acard__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; }
.pc-acard__by { display: flex; align-items: center; gap: 12px; min-width: 0; }
.pc-acard__avatar { flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
.pc-acard__avatar--blank { display: inline-flex; align-items: center; justify-content: center; background: var(--primary-mint-50); color: var(--pc-brand-deep); }
.pc-acard__by-text { display: flex; flex-direction: column; min-width: 0; }
.pc-acard__name { font-size: var(--fs-sm); font-weight: 600; line-height: 1.35; color: var(--color-text-main); }
.pc-acard__date { font-size: var(--fs-sm); color: var(--color-text-muted); }
.pc-acard__more { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; font-size: var(--fs-sm); font-weight: 700; text-transform: uppercase; color: var(--pc-brand-deep); text-decoration: none; }
.pc-acard__more:hover { color: var(--pc-brand-primary); }
@media (max-width: 575px) {
  .pc-acard__body { padding: 18px 16px 16px; }
}
