/* ============================================================
   Order Tracking Page — MOPS V2
   page_order_tracking.scss.bwt
   ============================================================ */

.ot-page {
  min-height: 60vh;
  padding-top: 40px;
  padding-bottom: 64px;
  background-color: var(--bgBodySub, #f8f9fa);
}

.ot-page .container {
  max-width: 640px !important;
  padding-left: 14px;
  padding-right: 14px;
}

/* ── Header ─────────────────────────────────────────────── */
.ot-header {
  text-align: center;
  margin-bottom: 32px;
}

.ot-header__icon {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}

.ot-header__title {
  font-family: var(--font-primary);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  margin: 0 0 8px;
}

.ot-header__sub {
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  color: var(--textSub, #636e72);
  margin: 0;
}

/* ── Form card ───────────────────────────────────────────── */
.ot-form-card {
  background: #fff;
  border-radius: 12px;
  padding: 28px 24px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.08);
}

.ot-field {
  margin-bottom: 20px;
}

.ot-field__label {
  display: block;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--textColor, #333);
  margin-bottom: 6px;
}

.ot-field__input {
  display: block;
  width: 100%;
  height: 48px;
  padding: 0 14px;
  font-family: var(--font-secondary);
  font-size: var(--fs-base);
  color: var(--textColor, #333);
  background: #fff;
  border: 1.5px solid #dfe6e9;
  border-radius: 8px;
  outline: none;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.ot-field__input:focus {
  border-color: var(--mainColor, #3cb371);
}

.ot-error {
  background: #fff3f3;
  border: 1px solid #fca5a5;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: var(--fs-sm);
  color: #dc2626;
  margin-bottom: 16px;
}

.ot-btn-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 50px;
  background: var(--mainColor, #3cb371);
  color: #fff;
  font-family: var(--font-primary);
  font-size: var(--fs-base);
  font-weight: 600;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s;
  letter-spacing: 0.01em;
}

.ot-btn-search:hover {
  background: var(--mainColorDark, #267348);
}

.ot-btn-search:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* ── Spinner ─────────────────────────────────────────────── */
.ot-spinner {
  display: inline-block;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: ot-spin 0.7s linear infinite;
  vertical-align: middle;
  margin-right: 6px;
}

@keyframes ot-spin {
  to { transform: rotate(360deg); }
}

/* ── Result wrapper ──────────────────────────────────────── */
.ot-result {
  padding-top: 8px;
}

/* ── Stepper ─────────────────────────────────────────────── */
.ot-stepper {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  margin-bottom: 24px;
  padding: 20px 16px 0;
}

.ot-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 80px;
  gap: 8px;
}

.ot-step__dot {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #fff;
  border: 2px solid #dfe6e9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s, border-color 0.3s;
  position: relative;
  z-index: 1;
}

.ot-step__num {
  font-family: var(--font-primary);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: #b2bec3;
  transition: color 0.3s;
}

.ot-step__label {
  font-family: var(--font-secondary);
  font-size: 11px;
  color: #b2bec3;
  text-align: center;
  line-height: 1.3;
  transition: color 0.3s;
}

.ot-step-line {
  flex: 1;
  height: 2px;
  background: #dfe6e9;
  margin-top: 15px;
  transition: background 0.3s;
  min-width: 16px;
}

/* Done state */
.ot-step--done .ot-step__dot {
  background: var(--mainColor, #3cb371);
  border-color: var(--mainColor, #3cb371);
}
.ot-step--done .ot-step__num {
  color: #fff;
}
.ot-step--done .ot-step__num::before {
  content: '✓';
}
.ot-step--done .ot-step__label {
  color: var(--mainColorDark, #267348);
  font-weight: 600;
}
.ot-step-line--done {
  background: var(--mainColor, #3cb371);
}

/* Active state */
.ot-step--active .ot-step__dot {
  background: var(--mainColorDark, #267348);
  border-color: var(--mainColorDark, #267348);
  box-shadow: 0 0 0 4px rgba(60,179,113,0.2);
  animation: ot-pulse 1.8s ease-in-out infinite;
}
.ot-step--active .ot-step__num {
  color: #fff;
}
.ot-step--active .ot-step__label {
  color: var(--mainColorDark, #267348);
  font-weight: 600;
}

@keyframes ot-pulse {
  0%   { box-shadow: 0 0 0 0   rgba(60,179,113,0.35); }
  70%  { box-shadow: 0 0 0 8px rgba(60,179,113,0); }
  100% { box-shadow: 0 0 0 0   rgba(60,179,113,0); }
}

/* Hide number when done, show checkmark */
.ot-step--done .ot-step__num {
  font-size: 0;
}
.ot-step--done .ot-step__dot::after {
  content: '✓';
  font-size: 14px;
  color: #fff;
  font-weight: 700;
}

/* ── Status card ─────────────────────────────────────────── */
.ot-status-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
}

.ot-status-card__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.ot-status-card__left {
  flex: 1;
}

.ot-status-card__right {
  text-align: right;
  flex-shrink: 0;
}

.ot-status-card__desc {
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  color: var(--textSub, #636e72);
  margin: 8px 0 0;
}

.ot-status-card__id {
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  color: var(--textSub, #636e72);
  margin-bottom: 4px;
}

.ot-status-card__amount {
  font-family: var(--font-primary);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  font-variant-numeric: tabular-nums;
}

.ot-status-card__action {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #f1f3f5;
}

/* ── Badges ──────────────────────────────────────────────── */
.ot-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 20px;
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.ot-badge--ok   { background: #dcfce7; color: #166534; }
.ot-badge--warn { background: #fef9c3; color: #854d0e; }
.ot-badge--info { background: #dbeafe; color: #1e40af; }
.ot-badge--err  { background: #fee2e2; color: #991b1b; }

/* ── QR card ─────────────────────────────────────────────── */
.ot-qr-card {
  background: #fff;
  border: 2px solid var(--mainColor, #3cb371);
  border-radius: 12px;
  padding: 24px 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(60,179,113,0.1);
}

.ot-qr-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.ot-qr-card__title {
  font-family: var(--font-primary);
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  margin: 0;
}

.ot-qr-card__expire {
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  color: #dc2626;
  margin: 0;
  font-variant-numeric: tabular-nums;
}

.ot-qr-card__qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.ot-qr-card__qr-img {
  width: 200px;
  height: 200px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
}

.ot-qr-card__qr-hint {
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  color: var(--textSub, #636e72);
  margin: 8px 0 0;
}

.ot-qr-card__info {
  background: #f8fffe;
  border-radius: 8px;
  padding: 14px 16px;
}

.ot-qr-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 0;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  border-bottom: 1px solid #e9f5ef;
}

.ot-qr-card__row:last-child {
  border-bottom: none;
}

.ot-qr-card__row span {
  color: var(--textSub, #636e72);
}

.ot-qr-card__amount {
  font-family: var(--font-primary);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  font-variant-numeric: tabular-nums;
}

/* ── Items card ──────────────────────────────────────────── */
.ot-items-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
}

.ot-items-card__title {
  font-family: var(--font-primary);
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--textColor, #333);
  margin: 0 0 14px;
}

.ot-items-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 0;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  border-bottom: 1px solid #f1f3f5;
}

.ot-items-card__row:last-of-type {
  border-bottom: none;
}

.ot-items-card__name {
  color: var(--textColor, #333);
  flex: 1;
}

.ot-items-card__price {
  color: var(--mainColorDark, #267348);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.ot-items-card__total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0 0;
  margin-top: 4px;
  border-top: 2px solid #f1f3f5;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
}

.ot-items-card__total strong {
  font-family: var(--font-primary);
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  font-variant-numeric: tabular-nums;
}

/* ── Appointment card ────────────────────────────────────── */
.ot-appt-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  border-left: 4px solid var(--mainColor, #3cb371);
}

.ot-appt-card__title {
  font-family: var(--font-primary);
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--mainColorDark, #267348);
  margin: 0 0 12px;
}

.ot-appt-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 0;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
}

.ot-appt-card__row span {
  color: var(--textSub, #636e72);
}

/* ── Notice ──────────────────────────────────────────────── */
.ot-notice {
  padding: 12px 14px;
  border-radius: 8px;
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  margin-top: 16px;
  line-height: 1.5;
}

.ot-notice--info {
  background: #eff6ff;
  color: #1e40af;
  border: 1px solid #bfdbfe;
}

/* ── Footer ──────────────────────────────────────────────── */
.ot-result-footer {
  text-align: center;
  padding-top: 8px;
  padding-bottom: 16px;
}

.ot-btn-new {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 12px 28px;
  background: transparent;
  color: var(--mainColorDark, #267348);
  font-family: var(--font-primary);
  font-size: var(--fs-sm);
  font-weight: 600;
  border: 2px solid var(--mainColor, #3cb371);
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
}

.ot-btn-new:hover {
  background: var(--mainColor, #3cb371);
  color: #fff;
}

.ot-btn-secondary {
  display: inline-flex;
  align-items: center;
  padding: 10px 20px;
  background: transparent;
  color: var(--mainColorDark, #267348);
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  font-weight: 600;
  border: 1.5px solid var(--mainColor, #3cb371);
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}

.ot-btn-secondary:hover {
  background: var(--mainColorLight, #eaf7ee);
}

.ot-poll-status {
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  color: var(--textSub, #636e72);
  margin: 10px 0 0;
}

/* ── Mobile ──────────────────────────────────────────────── */
@media (max-width: 480px) {
  .ot-page {
    padding-top: 24px;
  }
  .ot-form-card {
    padding: 20px 16px;
  }
  .ot-header__title {
    font-size: var(--fs-lg);
  }
  .ot-step__label {
    font-size: 10px;
  }
  .ot-qr-card__qr-img {
    width: 180px;
    height: 180px;
  }
  .ot-status-card__amount {
    font-size: var(--fs-lg);
  }
  .ot-qr-card__row {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
}
