/* ── global_core.scss.bwt ─ Reset, Fonts, Global Styles ── */


/* ══════════════════════════════════════════
   FONTS
   ══════════════════════════════════════════ */

/* Montserrat + Inter — loaded via Google Fonts CDN in theme.bwt <head>.
   REOPEN 2026-09-11: xoá 2 @font-face 'Inter' tự host trỏ tới
   ucco3fwrk3iltcv*.woff2 — file KHÔNG tồn tại trong assets/ (404 mỗi lần tải
   trang), và Inter đã được nạp đủ qua Google Fonts <link> nên fallback này
   chưa từng cần thiết. */


/* ══════════════════════════════════════════
   GLOBAL RESET & CORE STYLES
   ══════════════════════════════════════════ */

@font-face{font-family:swiper-icons;src:url('data:application/font-woff;charset=utf-8;base64, ') format('woff');font-weight:400;font-style:normal}:root{--swiper-theme-color:#007aff}.swiper-container{margin-left:auto;margin-right:auto;position:relative;overflow:hidden;list-style:none;padding:0;z-index:1}.swiper-container-vertical>.swiper-wrapper{flex-direction:column}.swiper-wrapper{position:relative;width:100%;height:100%;z-index:1;display:flex;transition-property:transform;box-sizing:content-box}.swiper-container-android .swiper-slide,.swiper-wrapper{transform:translate3d(0px,0,0)}.swiper-container-multirow>.swiper-wrapper{flex-wrap:wrap}.swiper-container-multirow-column>.swiper-wrapper{flex-wrap:wrap;flex-direction:column}.swiper-container-free-mode>.swiper-wrapper{transition-timing-function:ease-out;margin:0 auto}.swiper-slide{flex-shrink:0;width:100%;height:100%;position:relative;transition-property:transform}.swiper-slide-invisible-blank{visibility:hidden}.swiper-container-autoheight,.swiper-container-autoheight .swiper-slide{height:auto}.swiper-container-autoheight .swiper-wrapper{align-items:flex-start;transition-property:transform,height}.swiper-container-3d{perspective:1200px}.swiper-container-3d .swiper-cube-shadow,.swiper-container-3d .swiper-slide,.swiper-container-3d .swiper-slide-shadow-bottom,.swiper-container-3d .swiper-slide-shadow-left,.swiper-container-3d .swiper-slide-shadow-right,.swiper-container-3d .swiper-slide-shadow-top,.swiper-container-3d .swiper-wrapper{transform-style:preserve-3d}.swiper-container-3d .swiper-slide-shadow-bottom,.swiper-container-3d .swiper-slide-shadow-left,.swiper-container-3d .swiper-slide-shadow-right,.swiper-container-3d .swiper-slide-shadow-top{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:10}.swiper-container-3d .swiper-slide-shadow-left{background-image:linear-gradient(to left,rgba(0,0,0,.5),rgba(0,0,0,0))}.swiper-container-3d .swiper-slide-shadow-right{background-image:linear-gradient(to right,rgba(0,0,0,.5),rgba(0,0,0,0))}.swiper-container-3d .swiper-slide-shadow-top{background-image:linear-gradient(to top,rgba(0,0,0,.5),rgba(0,0,0,0))}.swiper-container-3d .swiper-slide-shadow-bottom{background-image:linear-gradient(to bottom,rgba(0,0,0,.5),rgba(0,0,0,0))}.swiper-container-css-mode>.swiper-wrapper{overflow:auto;scrollbar-width:none;-ms-overflow-style:none}.swiper-container-css-mode>.swiper-wrapper::-webkit-scrollbar{display:none}.swiper-container-css-mode>.swiper-wrapper>.swiper-slide{scroll-snap-align:start start}.swiper-container-horizontal.swiper-container-css-mode>.swiper-wrapper{scroll-snap-type:x mandatory}.swiper-container-vertical.swiper-container-css-mode>.swiper-wrapper{scroll-snap-type:y mandatory}:root{--swiper-navigation-size:44px}.swiper-button-next,.swiper-button-prev{position:absolute;top:50%;width:calc(var(--swiper-navigation-size)/ 44 * 27);height:var(--swiper-navigation-size);margin-top:calc(-1 * var(--swiper-navigation-size)/ 2);z-index:10;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--swiper-navigation-color,var(--swiper-theme-color))}.swiper-button-next.swiper-button-disabled,.swiper-button-prev.swiper-button-disabled{opacity:.35;cursor:auto;pointer-events:none}.swiper-button-next:after,.swiper-button-prev:after{font-family:swiper-icons;font-size:var(--swiper-navigation-size);text-transform:none!important;letter-spacing:0;text-transform:none;font-variant:initial;line-height:1}.swiper-button-prev,.swiper-container-rtl .swiper-button-next{left:10px;right:auto}.swiper-button-prev:after,.swiper-container-rtl .swiper-button-next:after{content:'prev'}.swiper-button-next,.swiper-container-rtl .swiper-button-prev{right:10px;left:auto}.swiper-button-next:after,.swiper-container-rtl .swiper-button-prev:after{content:'next'}.swiper-button-next.swiper-button-white,.swiper-button-prev.swiper-button-white{--swiper-navigation-color:#ffffff}.swiper-button-next.swiper-button-black,.swiper-button-prev.swiper-button-black{--swiper-navigation-color:#000000}.swiper-button-lock{display:none}.swiper-pagination{position:absolute;text-align:center;transition:.3s opacity;transform:translate3d(0,0,0);z-index:10}.swiper-pagination.swiper-pagination-hidden{opacity:0}.swiper-container-horizontal>.swiper-pagination-bullets,.swiper-pagination-custom,.swiper-pagination-fraction{bottom:10px;left:0;width:100%}.swiper-pagination-bullets-dynamic{overflow:hidden;font-size:0}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet{transform:scale(.33);position:relative}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active{transform:scale(1)}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active-main{transform:scale(1)}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active-prev{transform:scale(.66)}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active-prev-prev{transform:scale(.33)}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active-next{transform:scale(.66)}.swiper-pagination-bullets-dynamic .swiper-pagination-bullet-active-next-next{transform:scale(.33)}.swiper-pagination-bullet{width:8px;height:8px;display:inline-block;border-radius:100%;background:#000;opacity:.2}button.swiper-pagination-bullet{border:none;margin:0;padding:0;box-shadow:none;-webkit-appearance:none;-moz-appearance:none;appearance:none}.swiper-pagination-clickable .swiper-pagination-bullet{cursor:pointer}.swiper-pagination-bullet-active{opacity:1;background:var(--swiper-pagination-color,var(--swiper-theme-color))}.swiper-container-vertical>.swiper-pagination-bullets{right:10px;top:50%;transform:translate3d(0px,-50%,0)}.swiper-container-vertical>.swiper-pagination-bullets .swiper-pagination-bullet{margin:6px 0;display:block}.swiper-container-vertical>.swiper-pagination-bullets.swiper-pagination-bullets-dynamic{top:50%;transform:translateY(-50%);width:8px}.swiper-container-vertical>.swiper-pagination-bullets.swiper-pagination-bullets-dynamic .swiper-pagination-bullet{display:inline-block;transition:.2s transform,.2s top}.swiper-container-horizontal>.swiper-pagination-bullets .swiper-pagination-bullet{margin:0 4px}.swiper-container-horizontal>.swiper-pagination-bullets.swiper-pagination-bullets-dynamic{left:50%;transform:translateX(-50%);white-space:nowrap}.swiper-container-horizontal>.swiper-pagination-bullets.swiper-pagination-bullets-dynamic .swiper-pagination-bullet{transition:.2s transform,.2s left}.swiper-container-horizontal.swiper-container-rtl>.swiper-pagination-bullets-dynamic .swiper-pagination-bullet{transition:.2s transform,.2s right}.swiper-pagination-progressbar{background:rgba(0,0,0,.25);position:absolute}.swiper-pagination-progressbar .swiper-pagination-progressbar-fill{background:var(--swiper-pagination-color,var(--swiper-theme-color));position:absolute;left:0;top:0;width:100%;height:100%;transform:scale(0);transform-origin:left top}.swiper-container-rtl .swiper-pagination-progressbar .swiper-pagination-progressbar-fill{transform-origin:right top}.swiper-container-horizontal>.swiper-pagination-progressbar,.swiper-container-vertical>.swiper-pagination-progressbar.swiper-pagination-progressbar-opposite{width:100%;height:4px;left:0;top:0}.swiper-container-horizontal>.swiper-pagination-progressbar.swiper-pagination-progressbar-opposite,.swiper-container-vertical>.swiper-pagination-progressbar{width:4px;height:100%;left:0;top:0}.swiper-pagination-white{--swiper-pagination-color:#ffffff}.swiper-pagination-black{--swiper-pagination-color:#000000}.swiper-pagination-lock{display:none}.swiper-scrollbar{border-radius:10px;position:relative;-ms-touch-action:none;background:rgba(0,0,0,.1)}.swiper-container-horizontal>.swiper-scrollbar{position:absolute;left:1%;bottom:3px;z-index:50;height:5px;width:98%}.swiper-container-vertical>.swiper-scrollbar{position:absolute;right:3px;top:1%;z-index:50;width:5px;height:98%}.swiper-scrollbar-drag{height:100%;width:100%;position:relative;background:rgba(0,0,0,.5);border-radius:10px;left:0;top:0}.swiper-scrollbar-cursor-drag{cursor:move}.swiper-scrollbar-lock{display:none}.swiper-zoom-container{width:100%;height:100%;display:flex;justify-content:center;align-items:center;text-align:center}.swiper-zoom-container>canvas,.swiper-zoom-container>img,.swiper-zoom-container>svg{max-width:100%;max-height:100%;object-fit:contain}.swiper-slide-zoomed{cursor:move}.swiper-lazy-preloader{width:42px;height:42px;position:absolute;left:50%;top:50%;margin-left:-21px;margin-top:-21px;z-index:10;transform-origin:50%;animation:swiper-preloader-spin 1s infinite linear;box-sizing:border-box;border:4px solid var(--swiper-preloader-color,var(--swiper-theme-color));border-radius:50%;border-top-color:transparent}.swiper-lazy-preloader-white{--swiper-preloader-color:#fff}.swiper-lazy-preloader-black{--swiper-preloader-color:#000}@keyframes swiper-preloader-spin{100%{transform:rotate(360deg)}}.swiper-container .swiper-notification{position:absolute;left:0;top:0;pointer-events:none;opacity:0;z-index:-1000}.swiper-container-fade.swiper-container-free-mode .swiper-slide{transition-timing-function:ease-out}.swiper-container-fade .swiper-slide{pointer-events:none;transition-property:opacity}.swiper-container-fade .swiper-slide .swiper-slide{pointer-events:none}.swiper-container-fade .swiper-slide-active,.swiper-container-fade .swiper-slide-active .swiper-slide-active{pointer-events:auto}.swiper-container-cube{overflow:visible}.swiper-container-cube .swiper-slide{pointer-events:none;-webkit-backface-visibility:hidden;backface-visibility:hidden;z-index:1;visibility:hidden;transform-origin:0 0;width:100%;height:100%}.swiper-container-cube .swiper-slide .swiper-slide{pointer-events:none}.swiper-container-cube.swiper-container-rtl .swiper-slide{transform-origin:100% 0}.swiper-container-cube .swiper-slide-active,.swiper-container-cube .swiper-slide-active .swiper-slide-active{pointer-events:auto}.swiper-container-cube .swiper-slide-active,.swiper-container-cube .swiper-slide-next,.swiper-container-cube .swiper-slide-next+.swiper-slide,.swiper-container-cube .swiper-slide-prev{pointer-events:auto;visibility:visible}.swiper-container-cube .swiper-slide-shadow-bottom,.swiper-container-cube .swiper-slide-shadow-left,.swiper-container-cube .swiper-slide-shadow-right,.swiper-container-cube .swiper-slide-shadow-top{z-index:0;-webkit-backface-visibility:hidden;backface-visibility:hidden}.swiper-container-cube .swiper-cube-shadow{position:absolute;left:0;bottom:0px;width:100%;height:100%;background:#000;opacity:.6;-webkit-filter:blur(50px);filter:blur(50px);z-index:0}.swiper-container-flip{overflow:visible}.swiper-container-flip .swiper-slide{pointer-events:none;-webkit-backface-visibility:hidden;backface-visibility:hidden;z-index:1}.swiper-container-flip .swiper-slide .swiper-slide{pointer-events:none}.swiper-container-flip .swiper-slide-active,.swiper-container-flip .swiper-slide-active .swiper-slide-active{pointer-events:auto}.swiper-container-flip .swiper-slide-shadow-bottom,.swiper-container-flip .swiper-slide-shadow-left,.swiper-container-flip .swiper-slide-shadow-right,.swiper-container-flip .swiper-slide-shadow-top{z-index:0;-webkit-backface-visibility:hidden;backface-visibility:hidden}
/*============================================================================
THEME BASE NEW MAX SPEED __haidt2
==============================================================================*/
@mixin clearfix() {
	&:after {
		content: "";
		display: table;
		clear: both; }
	*zoom: 1;
}
/*============================================================================
#Variable
==============================================================================*/
$gutter: 30px;
/*================ Gerenal ================*/
.display_, .hidden, .d-none {display:none;}
.hidden {
	display: none !important;
}
.visually-hidden {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
	white-space: nowrap;
	border: 0;
}

@media (min-width: 992px){
	.col-xl-fix-5, .col-lg-fix-5 {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
}
.alert-success {
	p {
		margin: 0;
	}
}
.lazyload {
	background:#ebebeb;
	&.loaded {
		background:transparent;
	}
}
.row{
	margin-right: -10px;
	margin-left: -10px;
	@media(max-width: 480px){
		margin-right: -14px;
		margin-left: -14px;
		padding-left: 7px;
		padding-right: 7px;
	}
}
.col-1, .col-10, .col-11, .col-12, .col-2, .col-3, .col-4, .col-5, .col-6, .col-7, .col-8, .col-9, .col-lg-1, .col-lg-10, .col-lg-11, .col-lg-12, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8, .col-lg-9, .col-md-1, .col-md-10, .col-md-11, .col-md-12, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6, .col-md-7, .col-md-8, .col-md-9, .col-sm-1, .col-sm-10, .col-sm-11, .col-sm-12, .col-sm-2, .col-sm-3, .col-sm-4, .col-sm-5, .col-sm-6, .col-sm-7, .col-sm-8, .col-sm-9, .col-xs-1, .col-xs-10, .col-xs-11, .col-xs-12, .col-xs-2, .col-xs-3, .col-xs-4, .col-xs-5, .col-xs-6, .col-xs-7, .col-xs-8, .col-xs-9,.col-lg-cus-30, .col-lg-cus-20{
	padding-left: 10px;
	padding-right: 10px;
	@media(max-width: 480px){
		padding-left: 7px;
		padding-right: 7px;
	}
}
.col-xl-cus-20 {
	@media (min-width: 1200px) {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
}
@media (min-width: 992px) {
	.col-lg-cus-25 {
		-ms-flex: 0 0 25%;
		flex: 0 0 25%;
		max-width: 25%;
	}
	.col-lg-cus-20 {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
	.col-lg-cus-35 {
		-ms-flex: 0 0 35%;
		flex: 0 0 35%;
		max-width: 35%;
	}
}

.swiper-button-next:after, .swiper-button-prev:after {
	font-size: var(--fs-lg);
	font-weight: bold;
	color: #333;
}
/* ── Grid System — Project Standard (không dùng Bootstrap mặc định 1140px) ── */
.container, .container-fluid {
	width: 100%;
	margin-right: auto;
	margin-left: auto;
	padding-left: 14px;
	padding-right: 14px;
}
@media (min-width: 576px) {
	.container { max-width: 540px; }
}
@media (min-width: 768px) {
	.container { max-width: 720px; }
}
@media (min-width: 992px) {
	.container { max-width: 960px; }
}
@media (min-width: 1200px) {
	.container {
		max-width: 1280px !important;
		padding-left: 30px;
		padding-right: 30px;
	}
	.container-fluid {
		padding-left: 30px;
		padding-right: 30px;
	}
}
@media(min-width: 1199px) {
	@-webkit-keyframes shine {
		100% {
			left: 125%
		}
	}
	@keyframes shine {
		100% {
			left: 125%
		}
	}
}
.duration-300{
	transition-duration: .3s;
}
.aspect-1 {
	aspect-ratio: 1;
}
.md-hidden {
	@media (min-width: 992px) {
		display: none !important;
	}
}
.sm-hidden {
	@media (max-width: 991px) {
		display: none !important;
	}
}
.line-clamp {
	display: block;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	position: relative;
	line-height: 1.4 !important;
	overflow: hidden;
	text-overflow: ellipsis;
	padding: 0 !important
}
.line-clamp:after {
	content: '';
	text-align: right;
	bottom: 0;
	right: 0;
	width: 25%;
	display: block;
	position: absolute;
	height: calc(1em * 1.4);
	background: linear-gradient(to right, rgba(255,255,255,0), #fff 75%)
}
@supports (-webkit-line-clamp: 1) {
	.line-clamp:after {
		display: none !important
	}
}
.line-clamp-1 {
	-webkit-line-clamp: 1;
	height: calc(1em * 1.4 * 1)
}
.line-clamp-1-new {
	-webkit-line-clamp: 1;
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
}
.line-clamp-2-new {
	-webkit-line-clamp: 2;
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
}
.line-clamp-3-new {
	-webkit-line-clamp: 3;
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
}
.line-clamp-4-new {
	-webkit-line-clamp: 4;
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
}
.line-clamp-5-new {
	-webkit-line-clamp: 5;
	overflow: hidden;
	display: -webkit-box;
	-webkit-box-orient: vertical;
}
.line-clamp-2 {
	-webkit-line-clamp: 2;
	height: calc(1em * 1.4 * 2)
}
.line-clamp-3 {
	-webkit-line-clamp: 3;
	height: calc(1em * 1.4 * 3)
}
.alert {
	position: relative;
	padding: 0.75rem 1.25rem;
	margin-bottom: 1rem;
	border: 1px solid transparent;
	border-radius: 5px;
}
.alert-warning {
	color: #856404;
	background-color: #fff3cd;
	border-color: #ffeeba;
}
.alert-danger {
	color: #721c24;
	background-color: #f8d7da;
	border-color: #f5c6cb;
}
.alert-primary {
	color: #004085;
	background-color: #cce5ff;
	border-color: #b8daff;
}
.alert-success {
	color: #155724;
	background-color: #d4edda;
	border-color: #c3e6cb;
}
html, body {
	overflow-x: hidden;
	padding: 0 !important;
	margin: 0;
}
html {
	/* Rem base — admin chỉnh qua Tùy chỉnh → "Cỡ chữ tổng thể". Mọi --fs-* (rem) co/giãn theo.
	   87.5% = 1rem 14px (mặc định). LƯU Ý: chữ hardcode px (code cũ) KHÔNG đổi theo núm này. */
	font-size: {{ settings.theme_font_scale | default: '87.5' }}%;
}
@media (max-width: 768px) {
	html {
		font-size: 90%;
	}
	:root {
		--fs-base: 0.95rem;
		--fs-lg:   1.1rem;
		--fs-xl:   1.35rem;
	}
}
body {
	background: {{settings.theme_body_bg | default: '#fff'}};
	font-size: var(--fs-base);
	line-height: 1.5;
	word-break: break-word;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}
article, aside, details, figcaption, figure, footer, header, hgroup, main, nav, section, summary {
	display: block;
}
audio, canvas, progress, video {
	display: inline-block;
	vertical-align: baseline;
}
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
	height: auto;
}
input[type="search"]::-webkit-search-cancel-button,
input[type="search"]::-webkit-search-decoration {
	-webkit-appearance: none;
}
input[type="text"],
input[type="email"],
input[type="password"],
input[type="tel"]{
	border: 1px solid #e9e9e9;
	color: #1c1c1c;
	margin: 0 0 19px;
	min-height: 40px;
	padding: 0 20px;
}
a{
	color: var(--textColor);
	&:hover{
		color: var(--subColor);
		text-decoration: none;
		cursor: pointer;
	}
}
.dropdown-menu{
	box-shadow: none;
}
.dropdown-menu>li>a{
	white-space: inherit;
}
.dropdown-menu>.active>a, .dropdown-menu>.active>a:focus, .dropdown-menu>.active>a:hover{
	background: none;
}
/*================ Partials | Typography styles ================*/
body,
input,
textarea,
button,
select {	
	line-height: 1.7;
	color: var(--textColor);
	-webkit-font-smoothing: antialiased;
	-webkit-text-size-adjust: 100%;
	&:focus { 
		outline:none;
		box-shadow:none;
	}
}
body{
	font-size: var(--fs-base);
	font-family: var(--font-secondary);
	color: var(--textColor);
}

h1, h2, h3, h4, h5, h6 {
	line-height: 1.4;
	font-family: var(--font-primary);
	a {
		text-decoration: none;
		font-weight: inherit;
	}
}
a{
	&:focus{
		outline: none;
	}
}

p {
	margin: 0 0 ($gutter / 2) 0;
	img {
		margin: 0;
	}
}
em {
	font-style: italic;
}
img.lazyload:not(.loaded) {
	opacity: 0;
}
img.lazyload.loaded {
	opacity: 1;
	transition: opacity 0.25s ease;
}
@media (max-width: 768px) {
	.section {
		padding-top: 2.5rem !important;
		padding-bottom: 2.5rem !important;
	}
	h1, .h1 {
		line-height: 1.1;
		margin-bottom: 1rem;
	}
	p {
		line-height: 1.5;
	}
}
.page-title {
	.title-head {
		font-size: var(--fs-lg);
		text-transform: uppercase;
		font-weight: bold;
		margin-bottom: 16px;
		@media (max-width: 767px){
			font-size: var(--fs-md);
			margin-bottom: 10px;
		}
	}
}
.banner-effect{
	position: relative;
	overflow: hidden;
	display: block;
	&:before {
		position: absolute;
		top: 0;
		left: -100%;
		z-index: 2;
		display: block;
		content: '';
		width: 50%;
		height: 100%;
		background: -webkit-linear-gradient(left, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 100%);
		background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 100%);
		-webkit-transform: skewX(-25deg);
		transform: skewX(-25deg);
	}
	&:hover {
		&:before {
			-webkit-animation: shine 1.1s;
			animation: shine 1.1s;
		}
	}
}
@-webkit-keyframes shine {
	100% {
		left: 125%; } }

@keyframes shine {
	100% {
		left: 125%; } }
/*================ Partials | Lists ================*/

ul { list-style: none outside; margin-bottom: 0px; padding-left: 0px; }
ol { list-style: decimal; }
ul.square { list-style: square outside; }
ul.disc { list-style: disc outside; }
ol.alpha { list-style: lower-alpha outside; }
.inline-list li {
	display: inline-block;
	margin-bottom: 0;
}
/*================ Partials | Tables ================*/
table {
	width: 100%;
	margin-bottom: 1em;
	border-collapse: collapse;
	border-spacing: 0;
}
.table-wrap {
	max-width: 100%;
	overflow: auto;
	-webkit-overflow-scrolling: touch;
}
th {
	font-weight: 500;
}
th, td {
	text-align: center;
	padding: $gutter / 2;
	border: 1px solid #ebebeb;  
	color: #1c1c1c;
}
/*================ Partials | Links and Buttons ================*/
a,
.text-link {
	color: var(--textColor);
	text-decoration: none;
	background: transparent;
	&:hover,
	&:focus {
	}
}
button {
	overflow: visible;
}
button[disabled],
html input[disabled] {
	cursor: default;
}
/*================ Partials | Images, SVG, and iframes ================*/
img {
	border: 0 none;
	max-width: 100%;
	height: auto; 
}
svg:not(:root) {
	overflow: hidden;
}
.video-wrapper {
	position: relative;
	overflow: hidden;
	max-width: 100%;
	padding-bottom: 56.25%;
	height: 0;
	height: auto;
	iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}
}
.table-wrapper {
	max-width: 100%;
	overflow: auto;
}
/*================ Partials | Forms ================*/
form {
	margin-bottom: $gutter;

}
a, .btn, button, .page-link, .button, .btn-button {
	&:focus {
		outline:none;
		box-shadow:none;
	}
}
input,
textarea,
button,
select {
	font-size: 1em;
	&:focus{
		outline: none;
	}
}
button,
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
input[type="submit"],
textarea {
	-webkit-appearance: none;
	-moz-appearance: none;
}
input,
textarea,
select,
fieldset {
	border-radius: 0; 
	max-width: 100%;
	&.input-full {
		width: 100%;
	}
}
fieldset {
	border: 1px solid #ebebeb;
	padding: $gutter / 2;
}
legend {
	border: 0;
	padding: 0;
}
optgroup {
	font-weight: bold;
}
input {
	display: inline-block;
	width: auto;
}
button,
input[type="submit"] {
	cursor: pointer;
}
input[type="submit"] {
	@extend .btn;
}
button.close {
	padding: 0;
	cursor: pointer;
	background: transparent;
	border: 0;
	-webkit-appearance: none;
}
/*================ Input width and border ================*/
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
textarea,
select {
	border: 1px solid #ebebeb;
	padding: 0 110px 0 15px;
	width: 100%;
	max-width: 100%;
	display: block;
	&:focus {
	}
	&[disabled],
	&.disabled {
		cursor: default;
	}
}
textarea {
	min-height: 100px;
	padding-top: 6px;
	padding-bottom: 6px;
	border-radius: 8px;
}
input[type="checkbox"] {
	display: inline;
	margin: 0;
	padding: 0;
	width: 100%;
	height: 40px;
	position: absolute;
	background: transparent;
	outline: none;
	opacity: 0;
}
select {
	-webkit-appearance: none;
	-moz-appearance: none;
	appearance: none;
	background-position: right center;
	background: {
		image: url('{{ "ico-select.png" | asset_url }}');
			repeat: no-repeat;
			position: right 10px center;
			color: #fff !important;
			}
	padding-right: 28px;
	text-indent: 0.01px;
	text-overflow: '';
	cursor: pointer;
	/*================ Hide the svg arrow in IE9 and below ================*/
	.ie9 &,
	.lt-ie9 & {
		padding-right: 10px;
		background-image: none;
	}
}
// Force option color (affects IE only)
option {
	color: #000;
	background-color: #fff;
}
select::-ms-expand {
	display: none;
}
/*================ Form labels ================*/
label,
legend {
	display: block;
	font-weight: 400;
	&.inline {
		display: inline;
	}
}
/*================ We don't want the same label treatment for checkboxes/radios ================*/
input[type="checkbox"] + label,
input[type="radio"] + label {
	font-weight: normal;
}
label[for] {
	cursor: pointer;
}
.label-hint {
	color: #999;
}
/*================ Horizontal Form ================*/
form.form-horizontal,
.form-horizontal {
	margin-bottom: 0;
	input[type="text"],
	input[type="search"],
	input[type="password"],
	input[type="email"],
	input[type="file"],
	input[type="number"],
	input[type="tel"],
	textarea,
	select,
	label {
		display: inline-block;
		margin-bottom: 0;
		width: auto;
	}
}
/*================ Error styles ================*/
input[type="text"],
input[type="search"],
input[type="password"],
input[type="email"],
input[type="file"],
input[type="number"],
input[type="tel"],
textarea {
	&.error {
		border-color: red;    
		color: red;
	}
}
label.error {
	color: red;
}
.hidden {
	display:none;
}
label {
	display:inline-block!important;
}
/*================ Input Group ================*/
.input-group {
	position: relative;
	display: table;
	border-collapse: separate;
	.input-group-field:first-child,
	.input-group-btn:first-child,
	.input-group-btn:first-child > .btn,
	input[type="hidden"]:first-child + .input-group-field,
	input[type="hidden"]:first-child + .input-group-btn > .btn {
		border-radius: 0;
	}
	.input-group-field:last-child,
	.input-group-btn:last-child > .btn {
		border-radius: 0;
	}
	input {
		// Nasty Firefox hack for inputs http://davidwalsh.name/firefox-buttons
		&::-moz-focus-inner {
			border: 0;
			padding: 0;
			margin-top: -1px;
			margin-bottom: -1px;
		}
	}
}
.input-group-field,
.input-group-btn {
	display: table-cell;
	vertical-align: middle;
	margin: 0;
}
.input-group .btn,
.input-group .input-group-field {
	height: 40px;
}
.input-group .input-group-field {
	width: 100%;
	margin-bottom: 0;
}
.input-group-btn {
	position: relative;
	white-space: nowrap;
	width: 1%;
	padding: 0;
}
.form-group{
	margin: 0;
	padding: 0 0 8px;
	border: 0;
	.form-control {
		display: block;
		width: 100%;
		min-height: 40px;
		padding: 10px 15px;
		font-size: var(--fs-sm);
		line-height: 1.5;
		color: var(--textColor);
		background-color: #fff;
		background-image: none;  
		margin-bottom: 15px;
		border: 1px solid #EAEBF3;
		box-shadow: none;
		border-radius: 8px;
		&::-webkit-input-placeholder {color: #cdcfdd};
		&::-moz-placeholder {color: #cdcfdd};
		&:-ms-input-placeholder {color: #cdcfdd};
	}
	input, select{
		height: 40px;
	}
}
.flexbox, .awe-popup {
	display: -ms-flexbox;
	display: -webkit-flex;
	display: flex;
	-ms-flex-align: center;
	-webkit-align-items: center;
	-webkit-box-align: center;
	align-items: center;
}
.list-inline{
	@include clearfix();
	li{
		float: left;
		margin: 0;
	}
}
.hidden-xs {
	@media (max-width: 767px){
		display: none !important;
	}
}
.text-bold {
	font-weight: bold !important; 
}
.a-center{
	text-align: center !important
}
.a-left{
	text-align: left !important
}
.a-right{
	text-align: right !important
}

.f-right{
	float: right!important;
}
.f-none{
	float: none!important;
}
.inline{
	display: inline!important;
}
.block{
	display: block!important;
}
.inline-block{
	display: inline-block!important;
}
.flexbox{
	display: -webkit-flex;
	display: -ms-flexbox;
	display: flex;
	overflow: hidden;
	> div{
		flex: 1;
	}
}
.background-none{
	background: none !important;
}
.no-margin{
	margin: 0 !important;
}
.no-padding{
	padding: 0 !important;
}
.no-border{
	border: none!important;
}
.ov-h{
	overflow: hidden !important;
}
.relative{
	position: relative !important;
}
.absolute{
	position: absolute !important;
}
/* Margin and padding helpers */
@for $i from 0 through 20 {
	$name: $i*5;
	$size: #{$name}px;

	/* Margin */
	.margin-#{$name} {
		margin: $size !important;
	}

	.margin-vertical-#{$name} {
		margin-top: $size !important;
		margin-bottom: $size !important;
	}

	.margin-horizontal-#{$name} {
		margin-left: $size !important;
		margin-right: $size !important;
	}

	.margin-top-#{$name} {
		margin-top: #{$size} !important;
	}

	.margin-bottom-#{$name} {
		margin-bottom: #{$size} !important;
	}

	.margin-left-#{$name} {
		margin-left: #{$size} !important;
	}

	.margin-right-#{$name} {
		margin-right: #{$size} !important;
	}

	/* Padding */
	.padding-#{$name} {
		padding: $size !important;
	}

	.padding-vertical-#{$name} {
		padding-top: $size !important;
		padding-bottom: $size !important;
	}

	.padding-horizontal-#{$name} {
		padding-left: $size !important;
		padding-right: $size !important;
	}

	.padding-top-#{$name} {
		padding-top: #{$size} !important;
	}

	.padding-bottom-#{$name} {
		padding-bottom: #{$size} !important;
	}

	.padding-left-#{$name} {
		padding-left: #{$size} !important;
	}

	.padding-right-#{$name} {
		padding-right: #{$size} !important;
	}
}

@keyframes fadeInDown {
	0% {
		transform: translateY(-20px)
	}
	100% {
		transform: translateY(0)
	}
}
@keyframes popup-fade-in-up {
	0% {
		opacity: 0;
		transform: translateY(100px);
	}
	100% {
		opacity: 1;
	}
}


/*============================================================================
1. BUTTON
==============================================================================*/
.btn-continus {
	height: 40px !important;
	line-height: 40px !important;
	text-transform: uppercase;
	font-size: var(--fs-sm);
	padding: 0 25px !important;
	background: #ec2c1e !important;
	border: 1px solid #ec2c1e !important;
	&:hover {
		border: 1px solid var(--subColor);
		background: #fff !important;
		color: var(--subColor) !important;
	}
}
.btn {
	display: inline-block;
	height: 40px;
	line-height: 39px;
	padding: 0 20px;
	text-align: center;
	white-space: nowrap;
	outline: none!important;
	cursor: pointer;
	border: none;
	font-family: var(--font-primary);
	font-weight: 400;
	border-radius: 0;
	letter-spacing: 0;
	&.btn-primary{
		position: relative;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		line-height: 40px;
		background: var(--mainColor);
		color: #fff;
		text-decoration: none;
		font-size: var(--fs-lg);
		font-weight: 600;
		padding: 0 20px;
		transition-duration: .3s;
		border-radius:10px;
		@media (max-width: 767px) {
			font-size: var(--fs-md);
		}
		&:hover{
			background: var(--subColor);
		}
	}
	&.btn-extent{
		position: relative;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		line-height: 40px;
		background: var(--subColor);
		color: #fff;
		text-decoration: none;
		font-size: var(--fs-lg);
		font-weight: 600;
		padding: 0 20px;
		transition-duration: .3s;
		border-radius:10px;
		@media (max-width: 767px) {
			font-size: var(--fs-md);
		}
		&:hover{
			background: var(--mainColor);
			color: #fff;
		}
	}
	&.btn-popup{
		text-transform: uppercase !important;
		width: 100%;
		padding: 0 20px;
		background: var(--mainColor);
		color: #fff !important;
		border-radius: 10px;
		font-weight: bold;
		border: 1px solid transparent !important;
		&:hover{
			background: #fff;
			color: var(--subColor) !important;
			border: 1px solid var(--subColor) !important;
		}
	}
	&.btn-circle{
		border-radius: 50%;				
		padding: 0;		
	}
	&.btn-large{
		height: 50px;
		line-height: 50px;
		padding: 0 74px;
	}
	&.btn-small{
		height: 34px;
		line-height: 34px;
		padding: 0 32px;
		font-size: em(12px);
	}
	&.btn-dark-address{
		background: #2a2a2a;
		border: 1px solid transparent !important;
		color: #fff;
		padding: 0 20px;
		color: #fff;
		border-radius: 0px;
	}
	&.btn-white{
		background: #fff;
		color: var(--textColor);
		border: 1px solid #ebebeb;
		font-weight: 400;
		&:hover{
			background: var(--subColor);
			color: #fff;
		}
	}
	&.btn-gray{
		background:#9e9e9e;
		color: #fff;
		&:hover{
			background: var(--subColor);
		}
		a{
			color: #fff;
		}
	}
	&.btn-full{
		display:block;
		width: 100%;
	}
	&[disabled],
	&.disabled {
		color:#fff;
		cursor: default;
		background-color: #b8b8b8 !important;
	}
	&.flexbtn {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		svg {
			width: 18px;
			height:18px;
			margin-left: 5px;
			path {
				fill:#fff;
			}
		}
	}
}
.btn-link{
	line-height: 40px;
	color: var(--mainColor);
	&:hover{
		text-decoration: underline;
	}
}

@media (max-width: 1199px) {
	.header-action_cart .top-cart-content {
		display:none!important;
	}
}
.header-action_cart:hover {
	.header-action_cart .top-cart-content {
		display: block;
	}
}
.header-action_cart .top-cart-content {
	display: none;
	position: absolute;
	top: calc(100% + 15px);
	right: 0px;
	background: #fff;
	padding: 0;
	text-align: left;
	box-shadow: 2px 4px 9px rgba(0,0,0,0.329);
	z-index: 9999;
	border-radius: 5px;
	&:before {
		display: block;
		position: absolute;
		border: 10px solid transparent;
		border-bottom-color: #fff;
		content: "";
		right: 3px;
		top: -18px;
	}
}

/********************************************************
2. TABS
********************************************************/
.tab-wrap{
	.tabs-title{
		@include clearfix(); 
		display: inline-block;
		position: relative;
		z-index: 9;
		margin: 0 0 26px;

		li{
			font-size: var(--fs-xl);
			font-weight: 700;
			text-transform: uppercase;
			position: relative;
			line-height: 40px;
			float: left;

			&:before{
				content:"|";
				color: #c9c9c9;
				padding: 0 16px;
				color: #1c1c1c;
			}

			&:first-child{
				&:before{
					display: none;
				}
			}

			&.current{
				color: #212121;
			}
		}
	}

	.tab-content{
		position: relative;

	}

}

ul.tabs li{
	background: none;
	display: inline-block;

	cursor: pointer;

	&.current{
		color: #000
	}
}

.tab-content{
	opacity: 0;
	visibility: hidden;
	height: 0;
	overflow: hidden;

	&.current{ 
		opacity: 1;
		visibility: visible;
		height: auto;
	}

}
/*============================================================================
5. Header
==============================================================================*/
.banner-top{
	text-align: center;
	display: block;
	position: relative;
	z-index: 5;
	a {
		display: block;
		aspect-ratio: 1920/80;
		position: relative;
		overflow: hidden;
		@media(max-width: 767px) {
			aspect-ratio: inherit;
		}
		&:hover {
			img {
				transform: scale(1.03);
			}
		}
	}
}
header.header {
	.top-main-header {
		height: 30px;
		line-height: 30px;
		margin-bottom: 5px;
		.topbar-slider {
			color: var(--txtHeader);
			.swiper-slide {
				padding-left: 15px;
				font-weight: 500;
				@media(max-width: 767px) {
					font-size: var(--fs-sm);
				}
			}
			@keyframes pulsing {
				to {
					box-shadow: 0 0 0 12px rgba(232, 76, 61, 0); 
				} 
			}
			span {
				box-shadow: 0 0 0 0 var(--txtHeader);
				height: 8px;
				width: 8px;
				transition: all .3s ease-in-out;
				border-radius: 50%;
				margin-right: 10px;
				display: inline-block;
				background-color: var(--txtHeader);
				color:var(--txtHeader);
				animation: pulsing 1.25s cubic-bezier(0.66, 0, 0, 1) infinite;
			}
		}
		.text-hea-right {
			text-align: right;
			font-weight: 500;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			@media(max-width: 767px) {
				text-align: center;
			}
			.box_top_hea {
				color: var(--txtHeader);
				position: relative;
				display: inline-flex;
				align-items: center;
				margin-right: 20px;
				svg {
					margin-right: 5px;
				}
				&:last-child {
					margin-right: 0px;
				}
				.opaci_href {
					position: absolute;
					width: 100%;
					height: 100%;
					top: 0px;
					left: 0px;
					z-index: 1;
				}
				b {
					color: var(--txtHeader);
					font-weight: 600;
				}
				&:hover {
					.sub-text {
						color: var(--subColor);
					}
				}
				img {
					margin-bottom: 3px;
					max-width: 19px;
				}
			}
			.hoverContainer {
				position: relative;
				z-index: 4;

				#hoverDiv {
					display: none;
					position: absolute;
					width:340px;
					top: 100%;
					left: -100%;
					background-color: #f9f9f9;
					padding: 15px;
					border: 1px solid #ccc;
					box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
					z-index: 1;
					border-radius:0.5rem;
					color: var(--textColor);
					text-align: left;
				}
				.content-pop{
					margin-bottom:15px;
				}
				.mg-bt-20{
					margin-bottom:20px;
				}
				.content-pop h3{
					font-size:var(--fs-base);
				}
				.content-pop ul{
					padding-left:20px;
					list-style: inherit;

				}
				.android-button {
					display: inline-block;
					aspect-ratio: 356/105;
					margin-right: 10px;
					&:hover img {
						opacity: 0.8
					}
				}
				.ios-button {
					display: inline-block;
					aspect-ratio: 356/105;
					&:hover img {
						opacity: 0.8
					}
				}
				img {
					width: 120px;
					min-width: 120px;
					max-width: 120px;
				}
				.item_app {
					background-color: transparent;
					border-radius: 20px;
					border: 2px solid transparent;
					height: 30px;
					line-height: 26px;
					padding: 0px 10px;
					cursor: pointer;
				}
				&:hover {
					.item_app {
						background-color: var(--subColor);
						border: 2px solid var(--txtHeader);
					}
					#hoverDiv {
						display: block;
					}
				}
			}
			.lang-switcher {
				position: relative;
				.lang-btn {
					background: transparent;
					border: none;
					color: var(--txtHeader);
					padding: 4px 0;
					cursor: pointer;
					display: flex;
					align-items: center;
					gap: 6px;
					font-size: var(--fs-base);
					font-weight: 500;
					opacity: 0.9;
					transition: opacity 0.2s;
					&:hover { opacity: 1; }
				}
				.lang-list {
					position: absolute;
					top: calc(100% + 8px);
					right: 0;
					background: #fff;
					border-radius: 6px;
					box-shadow: 0 4px 16px rgba(0,0,0,0.18);
					min-width: 148px;
					list-style: none;
					padding: 6px 0;
					margin: 0;
					display: none;
					z-index: 9999;
					&.open { display: block; }
					li {
						padding: 9px 16px;
						cursor: pointer;
						color: #333;
						font-size: var(--fs-base);
						white-space: nowrap;
						display: flex;
						align-items: center;
						gap: 8px;
						transition: color 0.15s;
						&:hover { color: var(--mainColor); }
						&.active {
							color: var(--mainColor);
							font-weight: 600;
						}
					}
				}
			}
			.hotline-box {
				> a {
					display: flex;
					align-items: center;
					gap: 6px;
					color: var(--txtHeader);
					font-size: var(--fs-base);
					font-weight: 500;
					opacity: 0.9;
					transition: opacity 0.2s;
					text-decoration: none;
					b { font-weight: 600; }
					&:hover { opacity: 1; color: var(--txtHeader); }
				}
			}
			.topbar-account {
				position: relative;
				.topbar-account-btn {
					background: transparent;
					border: none;
					padding: 0;
					cursor: pointer;
					display: flex;
					align-items: center;
					gap: 5px;
					color: var(--txtHeader);
					font-size: var(--fs-base);
					font-weight: 500;
					opacity: 0.9;
					transition: opacity 0.2s;
					white-space: nowrap;
					&:hover { opacity: 1; }
					svg { flex-shrink: 0; }
					.topbar-account-label {
						max-width: 120px;
						overflow: hidden;
						text-overflow: ellipsis;
						white-space: nowrap;
					}
				}
				.topbar-account-list {
					display: none;
					position: absolute;
					top: 100%;
					right: 0;
					background: #fff;
					border-radius: 8px;
					box-shadow: 0 4px 20px rgba(0,0,0,0.12);
					min-width: 180px;
					padding: 16px 0 6px;
					list-style: none;
					margin: 0;
					z-index: 9999;
					li a {
						display: flex;
						align-items: center;
						gap: 8px;
						padding: 9px 16px;
						color: #333;
						font-size: var(--fs-base);
						text-decoration: none;
						white-space: nowrap;
						transition: background 0.15s;
						&:hover { background: #f5f5f5; color: var(--mainColor); }
						svg { flex-shrink: 0; opacity: 0.7; }
					}
				}
				&:hover .topbar-account-list,
				&.open .topbar-account-list {
					display: block;
				}
			}
			.lang-flag-img {
				border-radius: 2px;
				object-fit: cover;
				flex-shrink: 0;
				display: inline-block;
				vertical-align: middle;
			}
		}
	}
	// Ẩn Google Translate toolbar mặc định
	.goog-te-banner-frame,
	.skiptranslate iframe { display: none !important; }
	body { top: 0 !important; }
	.main-header {
		padding: 0 0 5px 0;
		background-color: var(--bgHeader);
		position: sticky;
		top: 0;
		z-index: 100;
		transition: box-shadow .3s ease;
		&.is-scrolled {
			box-shadow: 0 2px 16px rgba(0,0,0,.12);
		}
		.container {
			position: relative;
			z-index: 6;
		}
		.img_opacity {
			position: absolute;
			height: 100%;
			width: 100%;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			color: transparent;
			user-select: none;
			pointer-events: none;
			-o-object-fit: cover;
			object-fit: cover;
			z-index: 1;
		}
		// Box header: logo | search fill | icons — đều như Shopee
		.box-hearder {
			> .container > .pc-header-row {
				display: flex;
				flex-wrap: nowrap;
    			justify-content: space-between;
				align-items: center;
				margin: 0;           // reset Bootstrap row -15px gutters
				column-gap: 16px;
				row-gap: 0;
				> [class*="col-"] {
					padding: 0;      // reset Bootstrap col 15px padding
				}
				.header-logo {
					flex: 0 0 auto;
					width: auto;
					max-width: none;
				}
				.header-mid {
					flex: 1 1 0;
					width: auto;
					max-width: none;
					min-width: 0;
				}
				.header-right {
					flex: 0 0 auto;
					width: auto;
					max-width: none;
				}
			}
		}
		.align-items-center {
			.header-logo {
				@media(min-width: 992px) {
					display: flex;
					align-items: center;
				}
				.logo-wrapper {
					position: relative;
					display: inline-flex;
					align-items: center;
					text-decoration: none;
					.logo-icon {
						width: 60px;
						height: 60px;
						flex-shrink: 0;
						object-fit: contain;
					}
					.logo-text-block {
						display: flex;
						flex-direction: column;
						line-height: 1.25;
						.logo-store-name {
							font-weight: 700;
							color: var(--txtHeader);
							white-space: nowrap;
							letter-spacing: 0.3px;
						}
						.logo-store-sub {
							font-size: var(--fs-base);
							font-weight: 400;
							color: var(--txtHeader);
							opacity: 0.9;
							white-space: nowrap;
							letter-spacing: 0.4px;
						}
					}
				}
			}
			.header-mid { 
				.header_tim_kiem {
					position: relative;
					form.search-bar {
						margin-bottom: 0px;
						position: relative;
						width: 100%;
						background: #fff;
						border-radius: 7px;
						border: 1px solid var(--txtHeader);
						input {
							height: 40px;
							line-height: 40px;
							margin: 0px;
							border: 0px;
							background: transparent;
							padding-right: 45px;
							min-height: initial;
							width: 100%;
							min-width: 0;
						}
						.icon-fallback-text {
							width: 38px;
							height:38px;
							line-height:38px;
							position: absolute;
							top: 1px;
							right: 1px;
							padding: 0px;
							display: flex;
							background: var(--subColor);
							justify-content: center;
							align-items: center;
							border-radius: 5px;
							svg {
								width: 20px;
								height:20px;
								path {
									fill: #fff;
								}
							}
							&:hover{
								background: var(--mainColor);
							}
						}
						.search-suggest {
							position: absolute;
							top: calc(100% + 6px);
							left: 0;
							width: 100%;
							z-index: 99;
							background: #fff;
							border: none;
							box-shadow: 0 8px 28px rgba(0,0,0,0.13);
							border-radius: 12px;
							padding: 0;
							display: none;
							overflow: hidden;
							&.open { display: block; }

							// Banner khuyến mãi
							.coupon_search {
								background: #fff8f0;
								border-bottom: 1px solid #f0ebe3;
								padding: 10px 16px;
								border-radius: 0;
								margin: 0;
								display: flex;
								align-items: center;
								gap: 10px;
								.icon_ma_gg {
									width: 20px; height: 20px; flex-shrink: 0;
									display: flex; align-items: center; justify-content: center;
									svg { fill: var(--mainColor); width: 100%; height: 100%; display: block; }
								}
								.txt_sea_coupon {
									flex: 1; font-size: var(--fs-base); color: #555;
									margin: 0;
									white-space: nowrap;
									overflow: hidden;
									text-overflow: ellipsis;
								}
								.icon_next_gg {
									width: 14px; height: 14px; flex-shrink: 0;
									display: flex; align-items: center; justify-content: center;
									svg { fill: #aaa; width: 100%; height: 100%; display: block; }
								}
								&:hover {
									background: #fff3e6;
									.txt_sea_coupon { color: var(--mainColor); }
									.icon_next_gg svg { fill: var(--mainColor); }
								}
							}

							// Tiêu đề section
							.search-title {
								display: flex;
								align-items: center;
								gap: 6px;
								font-size: var(--fs-xs);
								font-weight: 600;
								color: #aaa;
								text-transform: uppercase;
								letter-spacing: 0.4px;
								padding: 14px 16px 8px;
								border: none;
								svg {
									width: 13px; height: 13px;
									position: static;
									path { fill: #aaa !important; }
								}
							}

							// Tìm kiếm gần đây — dạng row
							.search-recent {
								margin: 0;
								.search-list {
									display: block;
									margin: 0;
									a.search-item {
										display: flex;
										align-items: center;
										gap: 10px;
										width: 100%;
										padding: 10px 16px;
										border: none;
										border-radius: 0;
										background: none;
										margin: 0;
										color: #333;
										font-size: var(--fs-md);
										transition: background 0.15s;
										.search-item-icon {
											color: #bbb;
											display: flex;
											align-items: center;
											flex-shrink: 0;
										}
										.search-item-text { flex: 1; }
										span.close {
											display: flex;
											align-items: center;
											color: #ccc;
											margin-left: auto;
											flex-shrink: 0;
											width: auto; height: auto;
											background: none;
											position: static;
											transform: none;
											filter: none;
											padding: 4px;
											border-radius: 50%;
											transition: color 0.15s, background 0.15s;
											svg { display: block; }
											&:hover { color: #666; background: #f0f0f0; }
										}
										&:hover {
											background: #f7f7f7;
											color: #111;
											span.close { color: #888; }
										}
									}
								}
							}

							// Đề xuất phổ biến — dạng pill tags
							.item-suggest {
								padding-bottom: 14px;
								.search-list {
									display: flex;
									flex-wrap: wrap;
									gap: 8px;
									padding: 4px 16px 0;
									margin: 0;
									.search-item {
										display: inline-flex;
										align-items: center;
										padding: 6px 14px;
										border: 1px solid #e8e8e8;
										background: #f7f7f7;
										border-radius: 20px;
										color: #444;
										font-size: var(--fs-base);
										margin: 0;
										transition: all 0.15s;
										&:hover {
											background: var(--mainColor);
											border-color: var(--mainColor);
											color: #fff;
										}
									}
								}
							}
						}
					}
				}
				.list-search-key{
					text-align: left;
					margin-top: 5px;
					display: flex;
					flex-wrap: nowrap;
					align-items: center;
					gap: 4px;
					list-style: none;
					padding: 0;
					overflow: hidden;
					white-space: nowrap;
					li {
						display: inline-flex;
						align-items: center;
						gap: 4px;
						flex-shrink: 0;
						a {
							color: rgba(255,255,255,0.85);
							font-size: var(--fs-base);
							font-weight: 400;
							white-space: nowrap;
							transition: color 0.15s;
							@media(max-width:767px) { font-size: var(--fs-sm); }
							&:hover { color: #fff; }
						}
						span {
							color: rgba(255,255,255,0.4);
							font-size: var(--fs-xs);
						}
					}
				}
			}
			.header-right {
				display: flex;
				justify-content: end;
				align-items: center;
				gap: 15px;
				@media (max-width: 1199px) {
					gap: 14px;
				}
				.sudes-header-stores {
					display: inline-block;
					position: relative;
					transition: color 0.2s ease-in-out;
					>a {
						display: flex;
						justify-content: center;
						align-items: center;
						color:var(--txtHeader);
						.box-icon {
							margin-right: 7px;
							svg {
								width: 28px;
								height: 28px; 
								path {
									fill: var(--txtHeader);
								}
							}
						}
						.item-title {
							display: inline-block;
							font-size: var(--fs-sm);
							span {
								font-weight: 600;
							}
						}
						&:hover {
							color: rgba(255,255,255,0.7);
							.box-icon {
								svg {
									path {
										fill: rgba(255,255,255,0.7);
									}
								}
							}
						}
					}
				}
				.sudes-header-iwish {
					display: inline-block;
					position: relative;
					transition: color 0.2s ease-in-out;
					>a {
						display: flex;
						flex-wrap: wrap;
						justify-content: center;
						flex-direction: column;
						color:var(--txtHeader);
						.box-icon {
							display: inline-flex;
							align-items: center;
							justify-content: center;
							width: 28px;
							height: 28px;
							text-align: center;
							position: relative;
							i {
								font-size: 22px;
								line-height: 1;
								display: block;
								color: inherit;
							}
							.js-wishlist-count {
								display: none;
								position: absolute;
								top: -4px;
								right: -5px;
								min-width: 16px;
								height: 16px;
								border-radius: 50%;
								background-color: var(--subColor);
								transition: all 0.3s ease-in-out;
								text-align: center;
								line-height: 16px;
								font-size: 0.5rem;
								color: #fff;
								font-weight: 500;
							}
						}
						.item-title {
							display: inline-block;
							text-align: center;
							font-size: var(--fs-sm);
							margin-top: 6px;
						}
						&:hover {
							color: rgba(255,255,255,0.7);
						}
					}
				}
				.sudes-header-account {
					display: inline-block;
					position: relative;
					transition: color 0.2s ease-in-out;
					>a {
						display: flex;
						justify-content: center;
						align-items: center;
						color:var(--txtHeader);
						.box-icon {
							text-align: center;
							margin-right: 7px;
							@media(max-width: 992px) {
								margin-right: 0px;
							}
							svg {
								width: 28px;
								height: 28px;
								position: relative;
								path {
									fill: var(--txtHeader);
								}
							}
						}
						> svg {
							width: 10px;
							height: 10px;
							transform: rotate(90deg);
							path {
								stroke: var(--txtHeader);
							}
							position:absolute;
							top: 12px;
							right: 0px;
						}
						.item-title {
							display: inline-block;
							font-size: var(--fs-sm);
							span {
								font-weight: 600;
							}
						}
						&:hover {
							color: rgba(255,255,255,0.7);
							> svg {
								path {
									stroke: rgba(255,255,255,0.7);
								}
							}
							.box-icon {
								svg {
									path {
										fill: rgba(255,255,255,0.7);
										stroke: rgba(255,255,255,0.7);
									}
								}
							}
						}
					}
					ul{
						position: absolute;
						border: 1px solid rgb(239, 239, 239);
						background: rgb(255, 255, 255);
						width: auto;
						min-width: 125px;
						z-index: 15;
						list-style: none;
						margin: 0px;
						padding: 10px;
						box-shadow: rgba(0, 0, 0, 0.18) 0px 6px 12px 0px;
						top: calc(100% + 15px);
						right: -15px;
						text-align: left;
						display:none;
						width: 220px;
						background-color: #fff;
						box-shadow: 2px 4px 9px rgba(0,0,0,.329);
						gap: 4px;
						&::before {
							display: block;
							position: absolute;
							border: 10px solid transparent;
							border-bottom-color: #fff;
							content: "";
							top: -18px;
							right: 30px;
						}
						li{
							padding: 5px 5px;
							transition: background 0.5s;
							border-radius: 5px;
							a{
								color: #000;
								display: flex;
								text-align: center;
								touch-action: manipulation;
								cursor: pointer;
								border: 0px;
								white-space: nowrap;
								padding: 0px;
								font-size: var(--fs-md);
								user-select: none;
								line-height: 20px;
								width: 100%;
								outline: none;
								align-items: center;
								svg {
									width: 18px;
									height: 18px;
									margin-right: 5px;
								}


							}
							&:hover, &:focus{
								color: #fff;
								background-color: var(--mainColor);
								a {
									color: #fff;
									svg {
										path {
											fill:#fff;
										}
									}
								}
							}
						}
					}
					&:before {
						position: absolute;
						content: '';
						top: 100%;
						left: 0px;
						bottom: 0;
						width: 100%;
						height: 20px;
						z-index: 1;
					}
					&:hover >ul{
						display: grid;
					}
				}
				.sudes-header-cart {
					display: inline-block;
					transition: color 0.2s ease-in-out;
					position: relative;
					background: transparent;
					> a {
						color: var(--txtHeader);
						display: flex;
						flex-wrap: wrap;
						justify-content: center;
						flex-direction: column;
						.box-icon {
							display: inline-flex;
							align-items: center;
							justify-content: center;
							width: 28px;
							height: 28px;
							position: relative;
							text-align: center;
							i {
								font-size: 22px;
								line-height: 1;
								display: block;
								color: inherit;
							}
							.count_item_pr {
								position: absolute;
								top: -4px;
								right: -5px;
								width: 16px;
								height: 16px;
								border-radius: 50%;
								background-color: var(--subColor);
								transition: all 0.3s ease-in-out;
								text-align: center;
								line-height: 16px;
								font-size: 0.5rem;
								color: #fff;
								font-weight: 500;
							}
						}
						.item-title {
							display: inline-block;
							text-align: center;
							margin-top: 6px;
							font-size: var(--fs-sm);
						}
						&:hover {
							color: var(--subColor);
						}
					}

					&:before {
						position: absolute;
						content: '';
						right: 0px;
						top: 100%;
						width: 100%;
						height: 20px;
						z-index: 1;
					}
				}
			}
		}
	}
	@media (min-width: 992px) {
		.mobile-nav-overflow.open {
			content: " ";
			width: 100vw;
			height: 100vh;
			background: rgba(0,0,0,0.6);
			position: fixed;
			top: 0px;
			left: 0px;
			z-index: 4;
		}
	}
	.header-menu {
		background: #fff;
		box-shadow: 0 3px 5px -1px rgba(0, 0, 0, 0.15);
		border-top: 1px solid #ededed;
		position: relative;
		z-index:5;
		@media (min-width: 992px) {
			.navigation-horizontal {
				position: static;
				&.overflow {
					#nav {
						justify-content: flex-start;
					}
				}
				>.row {
					justify-content: space-between;
					align-items: center;
				}
				.sudes-cate-header {
					padding-top: 6px;
					padding-bottom: 6px;
					.title {
						padding: 0px 10px;
						position: relative;
						font-weight: 600;
						display: flex;
						align-items: center;
						cursor:pointer;
						font-size: var(--fs-md);
						border-radius: 5px;
						background-color: var(--mainColor);
						color: #fff;
						height: 36px;
						line-height: 1;
						border: 1px solid transparent;
						transition: background-color 0.2s, color 0.2s, border-color 0.2s;
						&:hover, &:focus {
							background-color: #fff;
							color: var(--mainColor);
							border-color: var(--mainColor);
							.scg_menu path, .scg_drop path { fill: var(--mainColor); }
						}
						span {
							width: 100%;
							padding: 0px 7px !important;
						}
						.scg_menu {
							width: 20px;
							height: 20px;
							path{
								fill: #fff;
							}
						}
						.scg_drop {
							width: 12.83px;
							height: 14px;
							transition: 0.5s all;
							path{
								fill: #fff;
							}
						}
						&.active {
							background-color: var(--mainColor);
							border-color: transparent;
							.scg_drop {
								transform: rotate(180deg);
							}
						}
					}
					.sudes-list-cate{
						width: calc(100% + 25px); 
						background-color: #fff;
						padding: 0;
						position: absolute;
						top: calc(100% + 10px);
						opacity: 0;
						visibility: hidden;
						transition: all 0.2s ease-in-out;
						z-index: 1030;
						&.active {
							opacity: 1;
							visibility: visible;
							top: 100%;
						}
						.sudes-main-cate{
							width: 100%;
							max-height: 400px;
							background-color: #fff;
							z-index: 99;
							overflow-y: auto;
							&::-webkit-scrollbar-thumb {
								background-color: var(--mainColor);
							}
							&::-webkit-scrollbar {
								width: 3px;
							}
							li{
								a{
									padding: 12px 15px 12px 28px;
									@media(max-width: 1024px){
										padding-bottom: 7px;
									}
									color: #444;
									display: block;
									margin: 0 10px;
									position: relative;
									font-weight: 600;
									img{
										width: 22px !important;
										height: 22px !important;
										position: absolute;
										right: auto;
										left: 0;
										top: 50%;
										transform: translate(0, -50%);
										margin: auto 0;
									}
									&:hover, &:focus{
										color: var(--mainColor);
										font-weight: 600;
									}
								}
								&+li{
									border-top: 1px solid rgba(0, 0, 0, 0.04);
								}
								&.sudes-main-cate-has-child{
									position: static;
									&>a{
										.icon_mask {
											position: absolute;
											right: 0px;
											top: 50%; 
											transform: translateY(-50%);
											width: 10px;
											height: 10px;
											-webkit-mask-image: url({{'ic-list.svg' | asset_url }});
											mask-image: url({{'ic-list.svg' | asset_url }});
											-webkit-mask-size: contain;
											mask-size: contain;
											mask-repeat: no-repeat;
											transition: background-color 0.3s;
											background-color: #666; 
										}
									}
									.menu-child{
										&.sub-menu{
											width: 100%;
											position: absolute;
											top: 0px;
											left: 100%;
											z-index: 100;
											min-height: 100%;
											box-shadow: 2px 3px 7px 0 rgba(0,0,0,.2);
											background-color: #fff;
											border: 1px solid var(--mainColor);
											display: none;
											li{
												a{
													padding-left: 0;
												}
											}
											&:not(.sudes-sub-mega-menu) {
												.sudes-main-cate-has-child{
													position: static;
													.menu-child-2{
														&.sub-menu{
															width: 100%;
															position: absolute;
															top: -1px;
															left: 100%;
															z-index: 100;
															min-height: calc(100% + 2px);
															border: 1px solid var(--mainColor);
															box-shadow: 2px 3px 7px 0 rgba(0,0,0,.2);
															background-color: #fff;
															display: none;
														}
													}
													&:hover{
														.menu-child-2{
															&.sub-menu{
																display: block;
															}
														}
													}
												}
											}

											&.sudes-sub-mega-menu{
												width: calc(405% + 30px);
												height: 100%;
												overflow-y: auto;
												padding: 10px;
												border: none;
												background-color: #fff;
												top: 0px;
												box-shadow: none;
												.icon_mask {
													display: none;
												}
												li{
													width: 33.333333%;
													float: left;
													border:none;
													margin-bottom: 15px;
													&:nth-child(3n+1){
														clear: left;
													}
													&>a{
														font-weight: 600;
														background-image:none;
														padding:0;
														padding-bottom: 6px;
														position: relative;
													}
													.menu-child-2{
														width: auto;
														position: relative;
														top: inherit;
														left: inherit ;
														z-index: 100;
														min-height: 100% ;
														box-shadow: none;
														background-color: transparent !important;
														display: block;
														margin-bottom: 16px;
														border: none;
														list-style: initial;
														padding-left: 25px !important;
														li{
															width: 100%;
															border:none;
															a{
																font-weight: normal;
																padding: 0;
																padding-left: 0px;
																&:before {
																	display: none;
																}
																&:after {
																	display: none;
																}
															}
														}
													}
												}
												&::-webkit-scrollbar-track {
													border-radius: 3px;
													background-color:#f7f8fa
												}
												&::-webkit-scrollbar {
													width: 6px;
												}
												&::-webkit-scrollbar-thumb {
													border-radius:3px;
													background-color: #e0e0e0;
												}
											}
										}
									}
									.sudes-main-cate-has-child-2 {
										.sub-menu {
											text-align: left;
											box-shadow: 0 0px 2px 0 rgba(60,64,67,0.1), 0 0px 6px 0px rgba(60,64,67,0.25);
											background: #fff;
											border-radius: 10px !important;
											padding: 5px !important;
											margin: 5px 10px 10px !important;
											background-color: #fff !important;
										}
										.image_thumb {
											text-align: left;
											box-shadow: 0 0px 2px 0 rgba(60,64,67,0.1), 0 0px 6px 0px rgba(60,64,67,0.25);
											background: #fff;
											display: flex;
											border-radius: 10px !important;
											padding: 5px !important;
											align-items: center;
											overflow: hidden;
											.image{
												position: relative;
												overflow: hidden;
												width: 100%;
												display: flex;
												-o-justify-content: center;
												-moz-justify-content: center;
												-webkit-justify-content: center;
												-os-justify-content: center;
												-o-display: flex;
												-moz-display: flex;
												-webkit-display: flex;
												-os-display: flex;
												align-items: center;
												position: relative;
												width: 60px;
												height: 60px;
												min-width: 60px;
												img {
													width: auto !important;
													height: auto !important;
													max-height: 100%;
													position: absolute;
													top: 0;
													bottom: 0;
													left: 0;
													right: 0;
													margin: auto;
													will-change: opacify;
													transform: scale(0.8);
													transition: all 0.5s ease;
												}
												&.allcol {
													transform: scale(0.6);
												}
											}
											span{
												height: auto !important;
												margin-left: 10px;
											}
											&:hover{
												box-shadow: 0 0px 2px 0 var(--subColor), 0 0px 6px 0px var(--subColor);
												.image img{
													-webkit-transform: scale(0.9);
												}
											}
										}
										&:hover{
											&>a {
												color:var(--mainColor); 
												.icon_mask{
													background-color: var(--mainColor); 
												}
											}
											.menu-child{
												&.sub-menu{
													display: block;
													&.sudes-sub-mega-menu{
														display: block;
													}
												}
											}
										}
									}
								}
								&.sudes-main-cate-has-child{
									&:hover, &:focus {
										background-color: var(--bgBodySub); 
										&>a {
											color:var(--mainColor); 
											.icon_mask{
												background-color: var(--mainColor); 
											}
										}
									}
									&.active {
										background-color: var(--bgBodySub); 
										&>a {
											color:var(--mainColor); 
											.icon_mask{
												background-color: var(--mainColor); 
											}
										}
										.menu-child{
											&.sub-menu{
												display: block;
												&.sudes-sub-mega-menu{
													display: block;
												}
											}
										}
									}
								}
							}
						}
					}


				}
				.sudes-main-header {
					display: flex;
					align-items: center;
					position: static;
					&.actimenucol {
						.col-menu, .control-menu{
							pointer-events: none;
							opacity: 0.6
						}
					}
					.control-menu {
						display: none;
						svg {
							width: 22px;
							height: 16px;
							path {
								fill: #000;
							}
							&:hover {
								path {
									fill: var(--subColor);
								}
							}
						}
						a.unactive {
							pointer-events: none;
							opacity: 0.3;
						}

					}
					.col-menu {
						flex: 1;
						display: block;
						overflow-x: hidden;
						overflow-y: hidden;
					}
					.button-promo {
						flex: none;
						flex-grow: 0;
						max-width: 200px;
						padding-left: 12px;
						a {
							display: flex;
							align-items: center;
							position: relative;
							padding: 6.5px 7px;
							color: #fff;
							background: var(--mainColor);
							border-radius: 5px;
							img {
								width: 22px !important;
								margin-right:5px;
								border-radius: 4px;

							}
							&:hover{
								background: var(--subColor);
							}
						}
					}
					.header-box-live {
						padding-left: 12px;
						@keyframes pulse-red {
							0% {
								transform: scale(0.8);
								box-shadow: 0 0 0 0 var(--header-live-color);
							}
							70% {
								transform: scale(1);
								box-shadow: 0 0 0 10px rgba(255, 82, 82, 0);
							}
							100% {
								transform: scale(0.8);
								box-shadow: 0 0 0 0 rgba(255, 82, 82, 0);
							}
						}
						@keyframes pulse-red-hover {
							0% {
								transform: scale(0.8);
								box-shadow: 0 0 0 0 #fff;
							}
							70% {
								transform: scale(1);
								box-shadow: 0 0 0 10px rgba(255, 82, 82, 0);
							}
							100% {
								transform: scale(0.8);
								box-shadow: 0 0 0 0 rgba(255, 82, 82, 0);
							}
						}
						.btn-live{
							border-radius: 5px;
							padding: 5.5px 8px 5.5px 22px;
							color: var(--header-live-color);
							border: 1px solid var(--header-live-color);
							background: transparent;
							outline: none;
							position: relative;
							white-space: nowrap;
							text-overflow: ellipsis;
							vertical-align: middle;
							max-width: 130px;
							cursor: pointer!important;
							overflow: hidden;
							height:inherit;
							&:after {
								content: " ";
								background: var(--header-live-color);
								width: 6px;
								height: 6px;
								position: absolute;
								left: 7px;
								top: calc(50% - 3px);
								border-radius: 50%;
								animation: pulse-red 1.65s linear infinite;
							}
							&:hover {
								color: #fff;
								background-color: var(--header-live-color);
								&:after {
									background: #fff;
									animation: pulse-red-hover 1.65s linear infinite;
								}
							}
						}

					}

				}
				&.overflow .control-menu {
					display: flex;
					align-items: center;
					padding-left: 5px;

				}
			}


		}
		@media (min-width: 1199px) {
			.navigation-horizontal {
				.sudes-cate-header {
					.sudes-list-cate{
						.sudes-main-cate{
							li{
								&.sudes-main-cate-has-child{
									.menu-child{
										&.sub-menu{
											&.sudes-sub-mega-menu{
												width: calc(405% + 50px);
											}
										}
									}

								}

							}
						}
					}


				}


			}


		}
		.col-menu {
			.title_menu { 
				display: none;
			}
			#nav {
				position: static;
				display: flex;
				flex-wrap: nowrap;
				overflow: visible;
				margin-bottom: 0;
				.nav-item{ 
					float: none;		
					position: static;
					display: inline-block;
					@media (min-width: 992px) {
						&.has-mega{
							@media (min-width: 992px) {
								position: static;
								.mega-content {
									background: #fff none repeat scroll 0 0;
									display: block;
									opacity: 0;
									margin: 0;
									visibility: hidden;
									padding: 10px 0px 10px 0px;
									position: absolute;
									top: calc(100% + 10px);
									left: 0;
									z-index: 999;
									width: 100%;
									transition: all 0.2s ease-in-out;
									-webkit-box-shadow: 0px 2px 6px 0px rgba(37, 105, 225, 0.33);
									-moz-box-shadow: 0px 2px 6px 0px rgba(37, 105, 225, 0.33);
									box-shadow: 0px 2px 6px 0px rgba(37, 105, 225, 0.33);
									.mega-menu-list {
										overflow: hidden;
										max-height: 450px;
										overflow-y: auto;
										&::-webkit-scrollbar-track {
											-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											border-radius: 5px;
											background-color: #F5F5F5;
										}
										&::-webkit-scrollbar {
											width: 5px;
											background-color: #F5F5F5;
										}
										&::-webkit-scrollbar-thumb {
											border-radius:5px;
											-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											background-color: var(--mainColor);
										}
										.level0{
											display: -ms-flexbox;
											display: -webkit-flex;
											display: flex;
											-webkit-flex-wrap: wrap;
											-ms-flex-wrap: wrap;
											flex-wrap: wrap;
										}

										.level1.item {
											float: left;
											width: 25%;
											padding: 10px 0px;
											display: block;
											&>a{
												font-weight: 600;
												margin-bottom: 10px;
												text-transform: uppercase;
												display:block;
												line-height: normal;
												width: 100%;
												padding-bottom: 5px;
												&:hover {
													color: var(--mainColor);
												}
											}
											h2{
												font-size: var(--fs-sm);
												margin-top: 0;
											}
											ul{
												&.level1{
													margin-bottom: 0px;
													li.level2{
														line-height: normal;
														margin-bottom: 5px;
														a{
															font-weight: normal !important;
															text-transform: none;
															&:hover {
																color: var(--mainColor);
															}
														}
													}
												}
											}
										}
										&.mega-sp {
											.level1.item {
												width: 33.33333%;
											}
										}
									}
								}
							}
						}
						&:hover, &:focus{
							background-color: transparent;
						}
						>a{
							font-size: var(--fs-md);
							padding: 10px 10px;
							display: inline-block;
							text-align: center;
							position: relative;
							font-weight: 500;
							white-space: nowrap;
							&.acti-order {
								color: var(--textorder);
								.icon_order {
									position: absolute;
									top: 1px;
									right: -5px;
									max-height: 13px;
									max-width: 36px;
									margin-right: 5px;
								}
							}
							svg{
								width: 12px;
								height: 12px;
								margin-left: 5px;
								transform: rotate(90deg);
								transition: all .4s;
								overflow: hidden;
								vertical-align: middle;
								margin-left: 3px;
								margin-bottom: 3px;
								path{
									stroke: #000;
								}
							}
						}
						&:hover, &:focus{
							> a{
								color: var(--mainColor);
								svg{
									path{
										stroke: var(--mainColor);
									}
								}
							}
						}
						&.has-childs{
							&:hover{
								>.dropdown-menu{
									opacity: 1;
									visibility: visible;
									top: 100%;
									margin-top: 0px;
									display: block;
									height: 600px;
									overflow-y: scroll;
								}
								>.mega-content{
									visibility: visible;
									opacity: 1;
									top: 100%;
									@media(min-width: 1025px){
										opacity: 1;
										filter: alpha(opacity=100);
										visibility: visible;
										-moz-transition: .3s ease-in;
										-o-transition: .3s ease-in;
										-webkit-transition: .3s ease-in;
										-ms-transition: .3s ease-in;
										transition: .3s ease-in;
										-moz-transform: translateY(0px);
										-o-transform: translateY(0px);
										-ms-transform: translateY(0px);
										-webkit-transform: translateY(0px);
										transform: translateY(0px);
									}
								}
							}

						}
						.nav-item-lv2 {
							padding: 0 10px;
						}
						.nav-item-lv3:not(.level2) {
							padding: 0 10px;
						}
						li.dropdown-submenu {
							position: relative;
							.dropdown-menu{
								left: -100%;
								top: 0;
							}
						}
						&.active{
							>a{
								color: var(--mainColor);
								svg{
									path{
										stroke: var(--mainColor);
									}
								}
							}
						}
						ul{
							&.dropdown-menu:not(.level1){
								{%- comment -%}
								  T-106 (2026-09-11): "0.15%" là lỗi gõ (alpha CSS đọc là 0.15 PHẦN
								  TRĂM = 0.0015, gần như vô hình) — đúng ra phải là 0.15 (15%).
								  Đây là nguyên nhân THẬT khiến dropdown-menu (nền trắng, không viền)
								  hoà lẫn vào nền trang trắng phía sau, nhìn như "trong suốt" — bug
								  người dùng báo cáo trên cả localhost và production.
								{%- endcomment -%}
								-webkit-box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
								box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
								border: 1px solid rgba(0, 0, 0, 0.06);
								background: #ffffff;
								position: absolute;
								top: calc(100% + 10px);
								left: auto;
								width: 210px;
								z-index: 1030;
								display: block;
								opacity: 0;
								visibility: hidden;
								border-radius: 0;
								-webkit-transition: all 0.2s ease-in-out;
								transition: all 0.2s ease-in-out;
								padding: 0px;

								li{
									padding: 0;
									border-bottom: 1px solid #ebebeb;
									&+li{
										@media(max-width: 991px){
											margin-top: 0;
											border-top: 1px solid #ebebeb;
										}
									}
									&:last-child {
										border-bottom: none;
									}
									&:hover, &:focus{
										>a {
											color: var(--mainColor);
										}
									}
									a{
										padding: 7px 15px 7px 10px;
										line-height: 25px;
										position: relative;
										padding-right: 20px;
										-moz-transition: all 0.2s;
										-o-transition: all 0.2s;
										-webkit-transition: all 0.2s;
										transition: all 0.2s;
										color: #222;
										font-size: var(--fs-base);
										display: block;
										i{
											float: right;
										}
									}
									&.dropdown-submenu{
										.dropdown-menu{
											top: -1px;
											left: 100%;
											@media(max-width: 991px){
												left: 0;
												.nav-item-lv3{
													a{
														padding-left: 35px;
													}
												}
											}
										}
										>a{
											svg{
												height: 9px;
												position: absolute;
												right: 6px;
												top: calc(50% - 4px);
												transition: all .4s;
												path {
													stroke: #222;
												}
												@media(max-width: 991px){
													height: 20px;
													position: absolute;
													top: 50%;
													transform: translate(0, -50%);
													right: 10px;
													margin-right: 0;
													float: right;
													line-height: 22px;
													width: 20px;
													text-align: center;
												}
											}
											&:hover{
												svg{
													path{
														fill: var(--mainColor);
													}
												}
											}
										}
										&:hover{
											.dropdown-menu{
												opacity: 1;
												visibility: visible;
												top: -1px;
												margin-top: 0;
												box-shadow: none;
												border-top: 1px solid #ebebeb;
											}
										}
									}
								}
							}
						}
						&.hover-left {
							ul{
								&.dropdown-menu{
									li{
										padding: 0;
										&:hover, &:focus{
											>a {
												svg {
													transform: rotate(90deg) translateX(0px) !important;
													path{
														stroke: var(--mainColor);
													}
												}
											}
										}
										&.dropdown-submenu{
											.dropdown-menu{
												top: 0;
												right: 0;
												left: initial !important;
												padding-left: 10px;
											}
											&:hover {
												.dropdown-menu{
													position: relative;
													right: 0;
													padding-left: 10px;
												}
											}

										}
									}
								}
							}
						}
					}

				}
			}
		}
	}
	&.hSticky {
		@media (min-width: 992px) {
			.header-menu {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				z-index: 9999;
				-webkit-box-shadow: 0 0 10px rgba(0,0,0,0.2);
				-moz-box-shadow: 0 0 10px rgba(0,0,0,0.2);
				box-shadow: 0 0 10px rgba(0,0,0,0.2);
				-webkit-animation: fadeInDown 0.4s both;
				animation: fadeInDown 0.4s both;
				border-top: 0px;
			}
		}

	}
	@media (max-width: 991px) {
		.main-header {
			padding: 7px 0px;
			.align-items-center {
				.header-logo {
					order: 1;
					.logo-wrapper {
						margin: 0 auto;
						padding: 0;
						.logo-icon { width: 44px; height: 44px; }
						.logo-store-name { font-size: var(--fs-lg); }
						.logo-store-sub { font-size: var(--fs-xs); }
					}
				}
				.header-mid {
					order: 3;
					.header_tim_kiem {
						margin-top: 7px;
						form.search-bar {
							input {
								height: 36px;
								line-height: 36px;
								margin: 0px;
								border: 0px;
								background: transparent;
								padding-right: 45px;
								min-height: initial;
							}
							.icon-fallback-text {
								width: 34px;
								height: 34px;
								line-height: 34px;
								svg {
									width: 18px;
									height: 18px;
								}
							}
						} 

					}
				}
				.header-right {
					order: 2;
					gap: 10px;
					.sudes-header-account {
						padding-right: 12px;
						&:before {
							display: none;
						}
						> a {
							.box-icon {
								margin-bottom: 0px;
								svg {
									width: 27px;
									height: 27px;
								}
							}
							> svg {
								width: 10px;
								height: 10px;
							}
							.text-box {
								margin-left: 5px;
								.acc-text {
									font-size: 0px !important;
								}
							}


						}
						ul {
							top: calc(100% + 5px);
						}
					}
					.sudes-header-cart {
						&:before {
							display: none;
						}
						>a {
							padding-right: 0; /* cart sát mép gutter phải (góc phải) */
							.box-icon {
								.count_item_pr {
									position: absolute;
									top: -8px;
									right: -9px;
									width: 16px;
									height: 16px;
									min-width: 0;
									border-radius: 50%;
									background: var(--accentColor);
									border: none;
									color: #fff;
									font-size: 0.5rem;
									line-height: 16px;
									text-align: center;
									padding: 0;
								}
								svg {
									width: 27px;
									height: 27px;
									position: relative;
								}
							}
						} 
					}
					.menu-icon {
						line-height: 1;
						transition: color 0.2s ease-in-out;
						position: relative;
						background: transparent;
						border: none;
						border-radius: 0;
						-webkit-appearance: none;
						padding: 0;
						width: 32px;
						height: auto;
						vertical-align: middle;
						color: var(--txtHeader);
						svg {
							width: 32px;
							height: 32px;
							position: relative;
							top: 2px;
							right: -3px;
							path {
								fill: var(--txtHeader);
							}
						}

					} 
				}
			}

		}
		.header-menu {
			height: 100%;
			position: fixed;
			top: 0 !important;
			left: 0;
			z-index: 99999;
			width: 100%;
			transform: translateX(-100%);
			visibility: hidden;
			transition: transform 0.5s cubic-bezier(0.645, 0.045, 0.355, 1),visibility 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
			box-shadow: none;
			touch-action: manipulation;
			border: 0px;
			background: #fff;
			&.current{
				visibility: visible;
				transform: translateX(0);
			}
			.container {
				padding: 0px;
				height: 100%;
				.title_menu {
					width: 100%;
					background: var(--bgHeader);
					padding: 0 10px;
					display: block;
					.close-mb-menu {
						position: absolute;
						width: 30px;
						height: 30px;
						top: 0px;
						left: 100%;
						cursor: pointer;
						border: 1px solid #494949;
						background: var(--mainColor);
						&::before {
							transform: rotate(45deg);
							content: "";
							width: 1px;
							height: 20px;
							background: #fff;
							position: absolute;
							top: 5px;
							right: 14px;
						}
						&::after {
							content: "";
							width: 1px;
							height: 20px;
							background: #fff;
							position: absolute;
							top: 5px;
							right: 14px;
							transform: rotate(-45deg);
						}
						&:hover, &:focus {
							background: var(--subColor);
						}
					}
					ul#tabs-menu-mb {
						display: flex;
						justify-content: center;
						align-items: center;
						flex-direction: row;
						list-style: none;
						margin: 0;
						gap: 12px;
						li.tab-link {
							position: relative;
							text-align: left;
							font-size: var(--fs-lg);
							font-weight: 600;
							padding: 10px 0;
							cursor: pointer;
							min-width: 100px;
							text-align: center;
							color: #fff;
							&:before {
								content: "";
								display: inline-block;
								position: absolute;
								height: 4px;
								width: 100%;
								left:0;
								bottom: 0;
								opacity: 0;
								visibility: hidden;
								-webkit-transform: scale(.6);
								-ms-transform: scale(.6);
								transform: scale(.6);
								-webkit-transition: all .3s ease;
								transition: all .3s ease;
								background-color: var(--subColor);
							}
							&.active {
								color: var(--subColor);
								&:before {
									opacity: 1;
									visibility: visible;
									-webkit-transform: scale(1);
									-ms-transform: scale(1);
									transform: scale(1);
								}
							}
						}
					}

				}
				.navigation-horizontal {
					display: flex;
					padding: 0px;
					margin: 0px;
					flex-direction: column;
					overflow: hidden;
					height: 100%;
					> .row {
						margin: 0px;
						padding: 0px;
						overflow-y: auto;
						flex-grow: 1;
						flex-basis: 0;
						display: block;
						.col-12 {
							padding: 0px;
						}
					}
					.sudes-cate-header {
						.title {
							display: none;
						}
						.sudes-list-cate {
							.sudes-main-cate {
								display: block;
								padding-bottom: 10px;
								.menu-item-count {
									position: relative;
									display: inline-block;
									width: 100%;
									a {
										display: block;
										padding: 4px 10px 4px 10px;
										text-align: left;
										text-decoration: none !important;
										color: #222;
										img {
											position: relative;
											top: -1px;
											width: 18px !important;
											height: 18px !important;
											margin-right: 5px;
										}
									}
									&.sudes-main-cate-has-child {
										> a {
											padding: 4px 35px 4px 10px;
										}
										>ul.menu-child {
											display: none;
											width: 100%;
											background: transparent;
											position: relative;
											box-shadow: none;
											opacity: 1;
											visibility: visible;
											transition: none;
											padding-left: 10px;
											&:before {
												content: "";
												width: 1px;
												background: #ddd;
												height: 100%;
												position: absolute;
												top: 0;
												left: 10px;
											}
											>li {
												border: 0px;
												&.sudes-main-cate-has-child, &.sudes-main-cate-has-child-2 {
													position: relative;
													> a {
														padding: 4px 35px 4px 10px;
													}
													>ul.menu-child-2 {
														display: none;
														width: 100%;
														background: transparent;
														position: relative;
														box-shadow: none;
														opacity: 1;
														visibility: visible;
														transition: none;
														padding-left: 10px;
														&:before {
															content: "";
															width: 1px;
															background: #ddd;
															height: 100%;
															position: absolute;
															top: 0;
															left: 10px;
														}
													}
												}
												>a {
													color: #222;
													&.image_thumb {
														display: flex;
														align-items: center;
														.line-clamp-2 {
															-webkit-line-clamp: 1 !important;
															height: calc(1em * 1.4 * 1) !important;
														}
													}
												}
											}
										}
									}
									.down_icon {
										width: 35px;
										height: 35px;
										top: 0px;
										right: 0;
										transition: 0.5s all;
										cursor: pointer;
										position: absolute;
										display: flex;
										justify-content: center;
										align-items: center;
										&:before {
											content: "";
											position: absolute;
											display: block;
											width: 10px;
											height: 10px;
											transition: all .5s;
											background: url("{{'ic-list.svg' | asset_url}}") center/cover no-repeat;
												}
										&.current {
											&:before {
												transform: rotate(90deg);
												moz-transition: all .5s ease;
												-webkit-transition: all .5s ease;
												-o-transition: all .5s ease;
											}
										}
									}

								}
							}
						}
					}
					.sudes-main-header {
						.col-menu {
							#nav {
								display: block;
								padding-bottom: 10px;
								.nav-item{ 
									position: relative;
									display: inline-block;
									width: 100%;
									&.has-mega{
										.mega-content.dropdown-menu {
											display: none;
											width: 100%;
											background: transparent;
											position: relative;
											box-shadow: none;
											opacity: 1;
											visibility: visible;
											transition: none;
											.row {
												padding: 0px;
												margin: 0px;
												.mega-menu-list {
													padding: 0px;
													.level0 {
														padding-left: 10px;
														ul li >a{
															padding: 6px 10px 6px 10px;
															color: #222;
														}
													} 
												}
											}

										}
									}
									&:hover, &:focus{
										background-color: transparent;
									}
									a {
										display: block;
										padding: 4px 10px 4px 10px;
										text-align: left;
										text-decoration: none !important;
										color: #222;
										&.acti-order {
											color: var(--textorder);
											.icon_order {
												display: none;
											}
										}
										svg {
											display: none;
										}
										&:before {
											display: none !important;
										}
										&:after {
											display: none !important;
										}
									}
									.down_icon{
										width: 35px;
										height: 35px;
										top: 0px;
										right: 0;
										transition: 0.5s all;
										cursor: pointer;
										position: absolute;
										display: flex;
										justify-content: center;
										align-items: center;
										&:before {
											content: "";
											position: absolute;
											display: block;
											width: 10px;
											height: 10px;
											transition: all .5s;
											background: url("{{'ic-list.svg' | asset_url}}") center/cover no-repeat;
												}
										&.current {
											&:before {
												transform: rotate(90deg);
												moz-transition: all .5s ease;
												-webkit-transition: all .5s ease;
												-o-transition: all .5s ease;
											}
										}
									} 
									&.active {
										>a {
											color: var(--subColor);
										}
									}
									&.has-childs {
										>ul.dropdown-menu {
											display: none;
											width: 100%;
											background: transparent;
											position: relative;
											box-shadow: none;
											opacity: 1;
											visibility: visible;
											transition: none;
											padding-left: 10px;
											&:before {
												content: "";
												width: 1px;
												background: #ddd;
												height: 100%;
												position: absolute;
												top: 0;
												left: 10px;
											}
											>li {
												border: 0px;
												>a {
													color: #222;
												}
											}

										}
										>a {
											padding: 4px 35px 4px 10px;
										}
									}
									.nav-item-lv2 {
										&.has-childs2 {
											position: relative;
											>ul.dropdown-menu {
												display: none;
												width: 100%;
												background: transparent;
												position: relative;
												box-shadow: none;
												opacity: 1;
												visibility: visible;
												transition: none;
												padding-left: 10px;
												&:before {
													content: "";
													width: 1px;
													background: #ddd;
													height: 100%;
													position: absolute;
													top: 0;
													left: 10px;
												}
												>li {
													border: 0px;
													>a {
														color: #222;
														text-decoration: none !important;
													}
												}

											}
											>a {
												padding: 4px 35px 4px 10px;
											}
										}
									}
								}

							}
						}
						.control-menu, .button-promo, .header-box-live {
							display: none;
						}

					}
					.list-menu-account {
						width: 100%;
						border-top: 1px solid #ddd;
						padding: 10px 0; 
						.li-account {
							a {
								display: block;
								padding: 4px 10px 4px 10px;
								text-align: left;
								text-decoration: none !important;
								color: #222;
								svg {
									position: relative;
									top: -1px;
									width: 18px;
									height: 18px;
									margin-right: 5px;
									path {
										fill: #333;
									}
								}
								img {
									position: relative;
									top: -1px;
									width: 18px !important;
									height: 18px !important;
									margin-right: 5px;
									-webkit-animation: playnow 2000ms infinite;
									-moz-animation: playnow 2000ms infinite;
									-o-animation: playnow 2000ms infinite;
									animation: playnow 2000ms infinite;

								}
								&:hover {
									color: var(--subColor);
								}
								.js-wishlist-count {
									display: inline-block;
									width: 20px;
									height: 20px;
									line-height: 20px;
									font-size: var(--fs-sm);
									border-radius: 20px;
									background: var(--mainColor);
									text-align: center;
									position: relative;
									color: #fff;
									top: -2px;
								}
								span {
									font-weight: 700;
								}
							}
						}
					}
					.tab-content-mb {
						display: none;
						&.active {
							display: block;
							padding-top: 12px;
						}
					}


				}
			}
		}
		.mobile-nav-overflow.open {
			content: " ";
			width: 100vw;
			height: 100vh;
			background: rgba(0,0,0,0.6);
			position: fixed;
			top: 0px;
			left: 0px;
			z-index: 999;
		}

	}
}

/*============================================================================
5. FOOTER
==============================================================================*/
footer.footer { 
	position: relative;
	display: block;
	.mid-footer {
		position: relative;
		padding: 30px 0 30px;
		background: var(--subColor);
		overflow: hidden;
		border-top: 3px solid var(--subColor);
		color:#fff;
		.logo-footer {
			margin-bottom: 20px;
			position: relative;
			.logo-wrapper {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				.logo-icon {
					width: 44px;
					height: 44px;
					flex-shrink: 0;
					object-fit: contain;
				}
				.logo-text-block {
					display: flex;
					flex-direction: column;
					line-height: 1.2;
					.logo-store-name {
						font-size: 1.5625rem;
						font-weight: 700;
						color: #fff;
						white-space: nowrap;
					}
					.logo-store-sub {
						font-size: var(--fs-xs);
						font-weight: 400;
						color: #fff;
						opacity: 0.85;
						white-space: nowrap;
						letter-spacing: 0.5px;
					}
				}
			}
		}
		.info_foo_content {
			margin-bottom: 20px;
			position: relative;
			p {
				margin-bottom: 5px;
			}
		}
		.footer-info {
			.content-contact {
				font-weight: 500;
				position: relative;
				.list_footer {
					padding-left: 30px;
					display: block;
					margin-bottom: 10px;
					b {
						position: absolute;
						left: 0px;
						top: -1px;
						svg {
							path {
								fill: #fff;
							}
						}

					}
					a {
						color:#fff;
						&:hover, &:focus {
							color:var(--subColor);
						}
					}
				}
			}
		}

		.social-footer{
			margin-top: 20px;
			.social{
				a{
					display: inline-block;
					background-color: transparent;
					width: 35px;
					font-size: var(--fs-sm);
					margin-right: 3px;
					height: 35px;
					line-height: 35px;
					border-radius: 50%;
					text-align: center;
					position: relative;
					&+a{
						margin-left: 3px;
					}
					img{
						height: 35px;
						width: 35px;
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						margin: auto;
					}
					&:hover, &:focus{
						filter: brightness(1.3);
						transition-duration: .3s;
					}
				}
			}
		}
		.col-xs-12 {
			.title-menu { 
				line-height: normal;
				position:relative;
				font-size: var(--fs-lg);
				margin: 0px 0 12px 0;
				font-weight: 700;
				@media (max-width: 767px) {
					margin-top: 0px;
					padding-top: 0px;
					position:relative;
				}
			}
			.info_support {
				@media (max-width: 767px) {
					margin-left: 0px;
					display: flex;
					gap: 30px;
				}
				@media (max-width: 330px) {
					gap: 15px;
				}
				.title_sup {
					margin-bottom: 3px;
				}
				.inforsup {
					margin:0px;
					.hotline_sup {
						color: red;
						display: block;
						font-size: var(--fs-xl);
						font-weight: bold;
						&:hover, &:focus {
							color: var(--subColor);
						}
					}
					.email_sup {
						display: block;
						color: #fff;
						&:hover, &:focus {
							color: var(--subColor);
						}
						@media (min-width: 767px) {
							margin-bottom: 15px;
						}
					}
				}
			}
			.info_zalo {
				a{
					aspect-ratio: 120/120;
					display: block;
					position: relative;
					overflow: hidden;
					max-width: 120px;
					&:hover {
						opacity: 0.8;
					}
				}
			}
			.list-menu {
				line-height: 26px;
				padding-left:0px;
				margin:0;
				&.hidden-mob {
					@media(max-width: 767px) {
						display: none;
						&.current {
							display: block;
						}
					}
				}
				.li_menu {
					display: block;
					margin-bottom: 10px;
					a{
						position:relative;
						line-height: 1.4;
						display: block;
						-webkit-transition: all ease 0.2s;
						-moz-transition: all ease 0.2s;
						-ms-transition: all ease 0.2s;
						-o-transition: all ease 0.2s;
						transition: all ease 0.2s;
						color: #fff;
						&:hover, &:focus {
							color: var(--subColor);
						}
					}
				}
			}
		}
		.block-payment {
			.payment-item {
				display: inline-block;
				width: 63px;
				margin-right: 5px;
				height: 29px;
				border-radius: 5px;
				position: relative;
				overflow: hidden;
				&+a{
					margin-left: 5px;
				}
				img{
					height: 29px;
					width: 63px;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
				}
			}
		}
		.col-xs-12 {
			.title-menu span{
				display: block;
				position: relative;
			}
		}
	}
	.top-search-foo {
		border-top: 1px solid rgba(255, 255, 255, 0.7);
		padding-top: 20px;
		margin-top: 20px;
		.top-search-title {
			line-height: normal;
			position:relative;
			font-size: var(--fs-lg);
			margin: 0px 0 10px 0;
			color: #fff;
			font-weight: 700;
			@media (max-width: 767px) {
				margin-top: 0px;
				padding-top: 0px;
				position:relative;
			}
		}
		.box_top_search {
			a {
				display: inline-block;
				padding: 5px 15px;
				border-radius: 20px;
				color: #fff;
				background-color: rgba(255,255,255,0.1);
				margin-right: 10px;
				margin-bottom: 10px;
				&:hover {
					background-color: var(--subColor);
				}
			}
		}

	}
	$main-color: {{ settings.theme_main_color | default: '#3cb371' }};
	.copyright {
		text-align: center;
		margin-bottom: 0px;
		position: relative;
		background: darken($main-color, 5%);
		span.wsp {
			display: block;
			padding: 10px 0;
			color: #fff;
			b {
				font-weight: 700;
			}
		}
		a{     
			font-weight: 700;
			color: #fff;
			&:hover{
				color: var(--subColor) !important;
				text-decoration: underline;
			}
		}

	}
	@media (max-width: 992px) {
		.footer-info {
			margin-bottom:30px;
		}
	}
	@media (max-width: 767px) {
		.copyright {
			.wsp {
				overflow:hidden;
				display:block;
				line-height: 24px;
			}
			.mobile {
				display:block;
				width:100%;
				line-height: 24px;
			}
			.dash {
				display: none;
			}
		}
		.padding-bottom-50 {
			padding-bottom:20px!important;
		}
	}
	.clicked{
		position:relative;
		@media(max-width:767px){
			&::before, &::after {
				position: absolute;
				content: '';
				top: 50%;
				right: 0;
				-webkit-transform: translate(-50%, -50%) rotate(-90deg);
				transform: translate(-50%, -50%) rotate(-90deg);
				background-color: currentColor;
				-webkit-transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
				transition: opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
				transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
				transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out, -webkit-transform 0.4s ease-in-out;
			}
			&::before {
				width: 11px;
				height: 1.5px;
				opacity: 1;
			}
			&::after {
				width: 1.5px;
				height: 11px;
				right: 10px;
			}
			&.open_ {
				&:after {
					transform: rotate(180deg);
					right: 0;
				}
			}
			&.cls_mn{
				&::after {
					-webkit-transform: translate(-50%, -50%) rotate(90deg);
					transform: translate(-50%, -50%) rotate(90deg);
				}
				&::before {
					opacity: 0;
				}
			}
		}
	}
	.footer-info {
		margin-bottom:20px;
	}
	.footer-click{
		margin-bottom:20px;
		@media (max-width: 767px) {
			margin-bottom:4px;
        	padding-inline: 8px;
		}
		&:last-child{
			margin:0;
		}
	}
}


/*BACK TO TOP*/
.backtop {
	position:fixed;
	bottom: 100px;
	right: 15px;
	z-index:3;
	top:auto;
	width: 40px;
	height: 40px;
	display: flex;
	background: transparent;
	text-decoration:none;
	transition: all 0.3s ease-out 0s;
	transform: translateY(-20px);
	opacity: 0;
	visibility: hidden;
	background-color: var(--bgBodySub);
	border-radius: 7px;
	svg{
		width: 100%;
		height: 100%;
		transform: rotate(270deg);
		path {
			stroke: var(--mainColor);
		}
	}
	&:hover {
		background-color: var(--subColor);
		svg{
			path {
				stroke: var(--bgBodySub);
			}
		}
	}
	@media (max-width: 767px) {
		bottom: 130px;
	}
}
.backtop.show {
	transition: all 0.3s ease-out 0s;
	transform: translateY(0px);
	opacity: 1;
	visibility: visible;
}


/*============================================================================
#13. FIXED APPS
==============================================================================*/
/*Fix fancybox review*/
.fancybox-close {
	background-color: transparent !important; 
}

/*FIX APP ĐÁNH GIÁ*/
@media (min-width:992px)and (max-width:1199px){
	#bizweb-product-reviews {
		width: 100% !important;
	}
}

.bizweb-product-reviews-form {
	@media (max-width: 480px){
		min-width: 250px !important;
	}
}
@media (max-width: 1199px){
	.h_recover {
		margin-bottom: 30px;
	}
}
.page_404 {
	background-size:cover;
	background-position:center center;
	background-repeat:no-repeat;
	height: 100%;
	width: 100%;
	min-height: 700px;
	display: -webkit-box;
	display: -ms-flexbox;
	display: flex;
	-webkit-box-pack: center;
	-ms-flex-pack: center;
	justify-content: center;
	-webkit-box-align: center;
	-ms-flex-align: center;
	align-items: center;
	@media (max-width: 767px) {
		min-height:400px;
	}
	.page-404 {
		text-align: center;
		h1 {
			font-size:200px;
			font-weight:700;
			line-height: 200px;
			margin:0;
			padding:0;
			color:var(--textColor);
			@media (max-width: 767px) {
				font-size:100px;
				line-height:100px;
			}
		}
		p {
			font-size:var(--fs-xl); /* TODO confirm — rounded from 22px */
			color:var(--textColor);
			@media (max-width: 767px) {
				font-size:var(--fs-base);
			}
		}
	}
}

.bizweb-product-reviews-module {
	margin:0!important;
}
.breadcrumb {
	margin: 0;
	font-size: var(--fs-sm);
	padding: 0px;
	border-radius: 0;
	font-weight: 400;
	line-height: 24px;
	background-color: transparent;
	width: 100%;
	text-align: left;
	li {
		display: inline;
		> a {
			color: var(--textColor);
			> span {
				color:var(--textColor);;
			}
		}
		.mr_lr {
			padding: 0px 3px;
			color: var(--textColor);;
		}
		span {
			display: inline;
			color:var(--textColor);
			.fa {
				color: var(--textColor);
				padding: 0px 5px;
			}
		}
		a:hover, &.active, strong {
			color: var(--subColor);
			font-weight: 400;
			text-decoration:none;
			span {
				color: var(--subColor);
			}
		}
	}
	>li+li:before{
		display: none;
	}
}
/*PAGINATION*/
.pagination>li:first-child>a, .pagination>li:first-child>span {
	border-top-left-radius: 0px;
	border-bottom-left-radius: 0px;
	border-radius: 50%;
}
.pagination>li:last-child>a, .pagination>li:last-child>span {
	border-top-left-radius: 0px;
	border-bottom-left-radius: 0px;
	border-radius: 50%;
}
.pagenav {
	text-align: right;
	span {
		display:inline-block;
		float:left;
		margin-right:10px;
		line-height:30px;
		font-weight:700;
	}
}


/*============================================================================
PRODUCT GRID ITEM
==============================================================================*/
/*Product loop gird main*/
.item_product_main {
	display: block;
	height: 100%;
	padding-bottom: 28px;
	position: relative;
	.product-action {
		background: #fff;
		border-radius: 0px;
		height: 100%;
		margin-bottom: 0px;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: end;
		overflow: hidden;
		border: 1px solid #ddd;
		border-radius: 10px;
		.product-thumbnail {
			width: 100%;
			aspect-ratio: 1;
			position: relative;
			overflow: hidden;
			.image_thumb{
				img {
					width: auto;
					max-height: 100%;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
					object-fit: contain;
					&.image2{
						position: absolute;
						top: 0;
						left: 0;
						opacity: 0;
						transition: all 0.5s ease 0s;
						visibility: hidden;
					}
				}
			}
			.badge {
				position: absolute;
				bottom: 7px;
				left: 7px;
				line-height: 1;
				span {
					background-color: var(--bgBodySub);
					color:var(--mainColor);
					padding: 5px;
					font-size: var(--fs-sm);
					font-weight: 600;
					display: inline-block;
					border-radius: 20px;
				}
			}

			.pre-order {
				justify-content: center;
				align-items: center;
				display: flex;
				position: absolute;
				width: 100%;
				top: 50%;
				left: 50%;
				text-align: center;
				z-index: 0;
				transition: all 0.3s ease-in-out;
				transform: translate(-50%, -50%);
				transition: all 0.3s ease-in-out;
				width: 70px;
				height: 57px;
				img {
					max-width: 70px;
					max-height: 57px;
				}
			}
			.product-button{
				display: flex;
				justify-content: center;
				align-items: center;
				width: 100%;
				position: absolute;
				top: 100%;
				left: 0;
				padding: 0 10px;
				padding-top: 12px;
				gap: 8px;
				transition: 0.3s all;
				z-index: 3;
				button {
					display: flex;
					justify-content: center;
					align-items: center;
					transition-duration: .3s;
					position: relative;
					width: 36px;
					font-size: var(--fs-md);
					padding: 0;
					height: 36px;
					background:#fff;
					border: 1px solid #ddd;
					border-radius: 10px;
					svg {
						width: 18px;
						height: 18px;
						display: block;
						path {
							fill: #000;
						}
					}
					&:hover {
						background-color:var(--subColor);
						svg {
							path {
								fill: #fff;
							}
						}
					}
				}
				a.btn-circle {
					display: flex;
					justify-content: center;
					align-items: center;
					width: 36px;
					height: 36px;
					position: relative;
					z-index: 1;
					font-size: 0px;
					color: #000;
					background:#fff;
					border: 1px solid #ddd;
					border-radius: 10px;
					img {
						width: 18px;
						height: 18px;
					}
					&:hover {
						background:var(--subColor);
						&:not(.active) {
							img {
								filter: brightness(0) invert(1);
							}
						}
					}
				}
				@media (max-width: 991px) {
					padding: 0 7px;
					button {
						font-size: var(--fs-sm);
						width: 100%;
						min-width: inherit;
						padding: 0 12px;
						height: 36px;
						svg {
							width: 16px;
							height: 16px;
							display: block;
						} 
					} 
				}
			}
			.flash-sale { 
				width: 50px;
				height: auto;
				height: 24px;
				line-height: 24px;
				text-align: center;
				font-size: var(--fs-sm);
				font-weight: 400;
				display: inline-block;
				position: absolute;
				top: 7px;
				right: 7px;
				color: #ffffff;
				z-index: 1;
				--gradient-red-3: linear-gradient(295deg, #CD1A0C 0%, #FF5246 98.45%);
				background-image: var(--gradient-red-3);
				padding: 0px;
				border-radius: 0px 10px 0px 10px;
			}
		}
		.product-info {
			width: 100%;
			padding:10px 7px;
			position: relative;
			background: #fff;
			transition-duration: .3s;
			z-index: 1;
			.product-name {
				font-size: var(--fs-lg);
				min-height: 46px;
				font-weight: 700;
				@media(max-width: 767px) {
					font-size: var(--fs-lg);
					min-height: 44px;
				}
				&:hover, &:focus{
					color: var(--subColor);
					a {
						color: var(--subColor);
					}
				}
			}
			.product-price-cart {
				margin-top: 7px;
				min-height: 16px;
				margin-bottom: 7px;
				@media(max-width: 991px){
					min-height: 42px;
				}
				.compare-price {
					display:inline-block;
					width: auto;
					color: #666;
					font-size: var(--fs-base);
					text-decoration: line-through;
					line-height: 1;
					margin-left: 7px;
					@media(max-width: 992px) {
						font-size: var(--fs-sm);
						margin-left: 0px;
						display: block;
					}
				}
				.price {
					color: var(--price);
					font-weight: 700;
					display:inline-block;
					width: auto;
					font-size: var(--fs-md);
					line-height: 1;
					position: relative;
					@media(max-width: 992px) {
						font-size: var(--fs-md);
					}
				}

			}
			.btn-views {
				display: block;
				width: 100%;
				background: var(--mainColor);
				color: #fff;
				border: 0;
				font-weight: 700;
				font-size: var(--fs-base);
				padding: 5px;
				border-radius: 10px;
				@media(max-width: 767px){
					font-size: var(--fs-sm);
					padding: 5px 5px;
				}
				&:hover{
					background: var(--subColor);
				}
				&.disabled{
					opacity: 0.7;
					&:hover{
						background: var(--subColor);
					}
				}
			}
		}
		.video_tem {
			justify-content: center;
			align-items: center;
			display: flex;
			position: absolute;
			width: 100%;
			top: 50%;
			left: 50%;
			text-align: center;
			transition: all 0.3s ease-in-out;
			transform: translate(-50%, -50%);
			transition: all 0.3s ease-in-out;
			img {
				max-width: 46px;
				max-height: 46px;
			}
		}
		&:hover {
			@media (min-width: 1200px) {
				border: 1px solid var(--subColor);
				.product-thumbnail {
					.scale_hover{
						.image1{
							opacity: 0;
						}
						.image2{
							opacity: 1;
							overflow: hidden;
							transition: all 0.5s ease 0s;
							visibility: visible;
						}

					}
					.product-button {
						top: calc(100% - 65px);
					}
				}
			}
		}
		@media (max-width: 991px) {
			.product-info {
				.name-price {
					.product-name {
						font-size: var(--fs-md);
					}
					.product-price-cart {
						gap: 4px;
						.price {
							font-weight: 700;
							font-size: var(--fs-lg);
							@media (max-width: 480px) {
								font-size: var(--fs-md);
							}
						}
						.compare-price {
							font-size: var(--fs-sm);
						}
					}
				}
			}
		}
	}
}

.content-page  {
	min-height:400px;
	ul, ol {
		padding-left:20px;
	}
}
.wd-icon:before {
	content: "\f180";
}

{%if settings.header_search_smart%}
.list-search-style {
	&.list-search {
		margin-bottom: 15px;
	}
	.title-search {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 4px 12px 8px;
		margin-bottom: 0;
		span {
			font-size: var(--fs-lg);
			font-weight: 600;
		}
		.see-all-search {
			display: block;
			position: relative;
			text-align: center;
			&:hover {
				text-decoration: underline;
			}
		}
	}
	.product-smart, .art-smart{
		display: flex;
		padding: 10px 12px;
		border-bottom: 1px solid #ededed;
		background: #fff;
		position: relative;
		width: 100%;
		&:first-child {
			margin-top: 12px;
		}
		&:last-child {
			border-bottom: none;
		}
		&:hover {
			background: #f5f5f5;
			border-radius: 5px;
		}
		.image_thumb {
			display: flex;
			justify-content: center;
			align-items: center;
			width: 60px;
			height: 60px;
			aspect-ratio: 1;
			border: 1px solid #f1f1f1;
			border-radius: 4px;
			position: relative;
			img {
				width: auto;
				max-height: 100%;
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				object-fit: contain;
			}
		}
		.product-info {
			display: block;
			width: calc(100% - 60px);
			-o-width: calc(100% - 60px);
			-moz-width: calc(100% - 60px);
			-webkit-width: calc(100% - 60px);
			padding-left: 10px;
		}
		.product-info {
			margin: 5px 0 5px;
			position: relative;
			h3 {
				padding:0;
				font-size: var(--fs-md);
				font-weight: 500;
				margin: 0 0 3px;
				padding-bottom: 3px;
				overflow: hidden;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
			}
			.price-box {
				color: var(--price);
				line-height: 23px;
				display: block;
				font-size: var(--fs-md);
				font-weight: 600;
				.price{
					padding-right:5px;
				}
				.compare-price {
					text-decoration: line-through;
					font-size: var(--fs-base);
					color: #9e9e9e;
					line-height: 24px;
					font-weight: 300;
				}
			}
		}
	}

	.not-pro {
		margin-top: 5px;
		font-style: italic;
		padding: 4px 12px;
		background: #ffedca;
		border-radius: 6px;
	}
}
{% endif %}

@keyframes alert-fade-in-up {
	0% {
		opacity: 0;
		transform: translateY(20px);
	}
	100% {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes alert-fade-out {
	0% {
		opacity: 1;
	}
	100% {
		opacity: 0;
	}
}
#js-global-alert{
	position: fixed;
	top: 5%;
	right: 15px;
	width: 290px;
	transition: all ease .0.5s;
	z-index: 9999;
	padding: 10px;
	margin-bottom: 0;
	opacity: 0;
	animation-duration: 0.3s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
	display: none;
	.alert-heading{
		margin-bottom: 0;
		font-size: var(--fs-lg);
	}
	.alert-content{
		font-size: var(--fs-md);
		margin-bottom: 0;
		line-height: 1.4;
	}
	&.active{
		display: block;
		animation-name: alert-fade-in-up;
	}
	&.inactive {
		animation-name: alert-fade-out;
	}
	button.close {
		position: absolute;
		top: 0;
		right: 10px;
	}
}


{% if settings.contact_us_enable %}
$support-color: {{ settings.contact_us_color }};
@keyframes zoomzoom{
	from {transform: scale(0)}
	to {transform: scale(1.2)}
}
.main-widget {
	position: fixed;
	right: 14px;
	bottom: 20px;
	z-index: 3;
	top: auto !important;
	@media (max-width: 767px) {
		bottom: 72px;
	}
}
.main-widge{
	.img svg{
		width: 100%;
		height: 100%;
	}
}
.main-widget .img{
	width: 25px;
	height: 25px;
}
.main-icon svg{
	width: 20px;
	height: 20px;
	fill: #fff;
	margin-bottom: 5px;
}
.main-icon p{
	font-size: 0.625rem;
	color: #fff;
	margin: 0px;
}

.out-circle{
	overflow: hidden;
	padding: 17px;
	border-radius: 100%;
	background: $support-color;
	width: 60px;
	height: 60px;
}
.main-icon{
	line-height: 0;
	color: #fff;
	width: 100%;
	height: 32px;
	display: block;
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	text-align: center;
}
.main-icon i{
	width: 26px;
	height: 26px;
	transform: translateX(2px);
}
.ser-icon{
	display: inline-flex;
	position: absolute;
	font-size: 30px;
	top: 0;
	left: 0;
	padding: 10%;
	background: #fff;
	max-width: 100%;
	overflow: hidden;
	border-radius: 100%;
	color: $support-color;
	width: 70%;
	height: 70%;
	margin: 15%;
	transition: .2s all;
}
.unsee{
	opacity: 0;
	transform: scale(0);
}
.process{
	display: inline-flex;
	transform: translateX(0px);
	transition: 0.15s linear transform;
	line-height: 0;
}
.ser-icon .item {
	margin-right: 40px;
	width: 30px;
	height: 30px;
	color: $support-color;
	display: flex;
	justify-content: center;
	align-items: center;
	svg {
		width: 25px;
		height: 25px;
		color: $support-color;
	}
}
.ser-icon i:nth-child(2n) {
	color: #000;
}
.def-content {
	position: absolute;
	bottom: 62px;
	right: 0;
	background: #fff;
	border-radius: 8px;
	transition: .2s all;
	box-shadow: 0 0 10px rgba(0,0,0,0.2);
	width: 300px;
	z-index: 1;
	&:before {
		position: absolute;
		bottom: -8px;
		right: 22px;
		left: auto;
		display: inline-block !important;
		border-right: 8px solid transparent;
		border-top: 8px solid #fff;
		border-left: 8px solid transparent;
		content: '';
	}
	.def-header {
		background: $support-color;
		padding:10px;
		border-radius: 8px 8px 0 0px;
		color: #fff;
		position: relative;
		.close-icon {
			display: flex;
			justify-content: center;
			align-items: center;
			position: absolute;
			right: 10px;
			top: 50%;
			transform: translateY(-50%);
			left: initial;
			padding: 0;
			margin: 0;
			border: 0 none;
			background: rgba(255,255,255,0.2);
			line-height: 1;
			width: 28px;
			height: 28px;
			cursor: pointer;
			color: #fff;
			border-radius: 50%;
			text-align: center;
			transition: background 0.2s ease;
			&:hover {
				background: rgba(255,255,255,0.35);
			}
		}
	}
	.item{
		> a {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			padding: 5px 10px;
			transition: .3s linear all;
			.img {
				flex-grow: 0;
				flex: none;
				height: 34px;
				width: 34px;
				display: flex; 
				justify-content: center;
				align-items: center;
				margin-right: 10px;
				border-radius: 50%;
				color: #fff !important;
				svg {
					height: 20px;
					width: 20px;
				}
			}
			.detail {
				flex-grow: 1;
				line-height: normal;
				.arcu-item-title {
					font-weight: 700;
					font-size: var(--fs-md);
					display: block;
					line-height: normal;
				}
				.arcu-item-subtitle {
					font-size: var(--fs-base);
					color: #787878;
				}
			}	
		}	
		&.phone {
			> a .img {
				background: #4EB625;
			}
		}
		&.mess {
			> a .img {
				background: #31ADFF;
			}
		}
		&.zalo {
			> a .img {
				background: #0165f8;
			}
		}
		&.map {
			> a .img {
				background: #d94234;
			}
		}
		&.whatsapp {
			> a .img {
				background: #25D366;
			}
		}
	}
	.item:last-child{
		margin-bottom: 0;
	}
}

.main-widget .close-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	position: absolute;
	font-size: 25px;
	top: 0;
	padding: 10px;
	left: 0;
	width: 60px;
	height: 60px;
	line-height: 1;
	text-align: center;
	color: #fff;
	background: $support-color;
	border-radius: 100%;
	transition: .2s all;
	transform: rotate(0);
	cursor: pointer;
	svg {
		width: 25px;
		height: 25px;
	}
}
.close-icon.unsee{
	transform: rotate(180deg);
}
.pregan {
	position: absolute;
	width: 100%;
	height: 100%;
	left: 0;
	top: 0;
	background: darken($support-color, 3);
	z-index: -2;
	border-radius: 100%;
	opacity: 0.6;
	animation: zoomzoom 3s linear .2s infinite;
}
.pregan:nth-child(1){
	animation-delay: .5s;
}
.main-widget{
	.item svg{
		fill: $support-color;
	}
}
.def-content .item svg{
	fill: #fff;
}
.def-content .item:hover {
	background: #f1f1f1;
}
{% endif %}
.popup-sapo{
	position: fixed;
	bottom: 60px;
	@media (min-width: 992px) {
		bottom: 30px;
	}
	left: 17px;
	margin: 0;
	z-index: 99;
	top: auto !important;
	font-size: var(--fs-md);
	.icon{
		position: relative;
		z-index: 4;
		height: 48px;
		width: 48px;
		text-align: center;
		border-radius: 50%;
		border: 1px solid #ffffff;
		cursor: pointer;
		background: var(--mainColor);
		box-shadow: 0 4px 8px rgba(0,0,0,0.15);
		box-sizing: border-box;
		-moz-box-sizing: border-box;
		-webkit-box-sizing: border-box;
		animation: pulse 2s infinite;
		animation: pulse 2s infinite;
		cursor: pointer;
		svg {
			fill: #fff;
			width: 20px;
			height: 20px;
			transition: opacity 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
			transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out;
			transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out, -webkit-transform 0.35s ease-in-out;
			animation: iconSkew 1s infinite ease-out;
			min-height: -webkit-fill-available;
		}
	}
	.content{
		background: var(--mainColor);
		color: #fff;
		padding: 20px 20px 25px;
		border-radius: 10px;
		width: 300px;
		position: absolute;
		bottom: 27px;
		left: 20px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.2);
		-webkit-transform-origin: 100% bottom;
		transform-origin: 0 bottom;
		transform: scale(0);
		-webkit-transform: scale(0);
		-moz-transform: scale(0);
		-ms-transform: scale(0);
		-o-transform: scale(0);
		transition: -webkit-transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
		transition: transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
		transition: transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1),-webkit-transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
		-webkit-transition: transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
		@media(max-width: 767px){
			width: 250px;
			padding: 14px;
		}
		.title{
			font-size: var(--fs-lg);
			line-height: normal;
			font-weight: bold;
			margin-bottom: 5px;
			@media(max-width: 767px){
				margin-bottom: 5px;
			}
		}
		.close-popup-sapo{
			position: absolute;
			right: 5px;
			top: 5px;
			cursor: pointer;
			svg{
				width: 15px;
				height: 15px;
				path{
					fill: #fff;
				}
			}
		}
		ul{
			margin-bottom: 15px;
			li{
				margin-bottom: 7px;
				svg{
					margin-right: 10px;
					path{
						fill: #fff;
					}
				}
				a{
					color: #fff;
					&:hover{
						opacity: var(--subColor);
					}
				}
			}
		}
		.ghichu{
			font-style: italic;
		}
	}
	&.active{
		.content{
			-ms-transition-delay: 0.1s;
			-webkit-transition-delay: 0.15s;
			transition-delay: 0.1s;
			transform: scale(1);
			-webkit-transform: scale(1);
			-moz-transform: scale(1);
			-ms-transform: scale(1);
			-o-transform: scale(1);
		}
	}
}
.popup-ngonngu{
	position: fixed;
	right: 0px;
	top: 30% !important;
	z-index: 999;
	.icon{
		width: 40px;
		height: 40px;
		background: #dd0115;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 5px 0 0 5px;
		path{
			fill: #fff;
		}
	}
	.language{
		opacity: 0;
		filter: alpha(opacity=0);
		visibility: hidden;
		-moz-transition: .2s ease-out;
		-o-transition: .2s ease-out;
		-webkit-transition: .2s ease-out;
		-ms-transition: .2s ease-out;
		transition: .2s ease-out;
		-moz-transform: translateY(20px);
		-o-transform: translateY(20px);
		-ms-transform: translateY(20px);
		-webkit-transform: translateY(20px);
		transform: translateY(20px);
		position: absolute;
		top: 100%;
		right: 0;
		width: 110px;
		background: #fff;
		box-shadow: 0px 2px 6px 0px rgba(50,50,50,0.33);
		padding: 5px;
		li{
			margin-bottom: 5px;
			&:last-child {
				margin-bottom: 0px;
			}
		}
		a{
			display: flex;
			align-items: center;
			font-size: var(--fs-md);
			img{
				margin-right: 4px;
			}
		}
	}
	&:hover{
		.language{
			opacity: 1;
			filter: alpha(opacity=100);
			visibility: visible;
			-moz-transition: .3s ease-in;
			-o-transition: .3s ease-in;
			-webkit-transition: .3s ease-in;
			-ms-transition: .3s ease-in;
			transition: .3s ease-in;
			-moz-transform: translateY(0px);
			-o-transform: translateY(0px);
			-ms-transform: translateY(0px);
			-webkit-transform: translateY(0px);
			transform: translateY(0px);
		}
	}
}
{%if settings.header_live_enable%}
.modal-live {
	position: fixed;
	max-width: 45%;
	max-height: 75%;
	bottom: -10px;
	z-index: 999;
	left: 50%;
	transform: translate(-50%, 100%);
	-webkit-transition: all 500ms ease-in-out;
	-moz-transition: all 500ms ease-in-out;
	-ms-transition: all 500ms ease-in-out;
	-o-transition: all 500ms ease-in-out;
	transition: all 500ms ease-in-out;
}
.modal-live.opened {
	transform: translate(-50%, 0%);
	bottom: 0px;
}
.modal-live .box-close {
	position: absolute;
	right: -40px;
	top: 0;
	cursor: pointer;
	padding: 0 10px; 
	&:hover path:first-child, &:focus path:first-child {
		fill: var(--mainColor);
	}
}
.modal-live iframe {
	border-radius: 10px;
	display: block;
	width: 100%;
	height: 100%; 
}
.modal-live__inner {
	background: #fff;
	border-radius: 10px;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12); 
}
@media (max-width: 992px) {
	.modal-live {
		max-width: 100%;
		max-height: 100%; 
	}
	.modal-live .box-close {
		right: -5px;
		top: 5px;
		opacity: 1; 
	} 
}
{%endif%}
.mua_shop {
	background: #3cb371;
	font-size: var(--fs-base);
	outline: none;
	box-shadow: none;
	padding: 10px 30px;
	color: #fff;
	line-height: inherit;
	border-radius: 10px;
	height: 55px;
	border: none;
	margin-top: 10px;
	width: 100%;
	cursor: pointer;
	margin-bottom: 10px;
	text-align: center;
}
.mua_shop a {
	color: #fff;
	font-weight: 700;
	font-size: var(--fs-base);
}


/* ── Section Header — Global Component (Convention §19) ── */
/* Spacing tokens — chỉnh 1 chỗ áp toàn site. Giảm để bớt "trống trải". */
:root {
  --pc-section-mb: 24px;     /* khoảng cách tiêu đề → nội dung (cũ 32px) */
  --pc-section-py: 56px;     /* padding dọc mỗi section, desktop (cũ 80px) */
  --pc-section-py-sm: 36px;  /* padding dọc mỗi section, mobile (cũ 48px) */
}

.pc-section-header {
  text-align: center;
  margin-bottom: var(--pc-section-mb);
  .pc-section-title {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: var(--fs-2xl);
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--section-title-color, var(--mainColorDark));
    text-transform: uppercase;
    margin: 0;
  }
  .pc-section-subtitle {
    font-family: var(--font-secondary);
    font-size: var(--fs-base);
    color: var(--section-subtitle-color, var(--textColor));
    margin-top: 8px;
  }
  .pc-section-eyebrow {
    font-family: var(--font-secondary);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-eyebrow-color, var(--mainColor));
    margin: 0 0 8px;
  }
}
.pc-section-header--left { text-align: left; }
@media (max-width: 767px) {
  .pc-section-header { text-align: left; }
  .pc-section-header .pc-section-title { font-size: var(--fs-xl); }
  .pc-section-header .pc-section-subtitle { font-size: var(--fs-sm); }
}

/* ── Alternating Sections — Layer 1: Background ── */
/* Quy tắc: Không đặt 2 section cùng màu nền liền kề nhau */
.section--light    { background-color: var(--bg-default); }
.section--none     { background-color: transparent; }
.section--subtle   { background-color: var(--bg-subtle); }
.section--dark     { background-color: #003336; }
.section--brand    { background: var(--bg-gradient-green); }  /* xanh lá luxury: Hero, Testimonials */
.section--sale     { background: var(--bg-gradient-sale); }   /* hồng nhạt: Flash Sale */
.section--clinical { background: var(--bg-gradient-clinical); } /* trắng→xám nhẹ: Ingredients, Y khoa */

/* ── Alternating Sections — Layer 2: Text color vars ── */
/* Nhóm nền sáng (light / subtle / none): chữ đậm */
.section--light,
.section--none,
.section--subtle {
  --section-title-color:    var(--mainColorDark);
  --section-subtitle-color: var(--textColor);
  --section-eyebrow-color:  var(--mainColor);
}
/* Nhóm brand (gradient xanh lá): title xanh đậm */
.section--brand {
  --section-title-color:    var(--mainColorDark);
  --section-subtitle-color: var(--textBody);
  --section-eyebrow-color:  var(--mainColor);
}
/* Nhóm sale (gradient hồng nhạt): title đỏ đậm */
.section--sale {
  --section-title-color:    #c0392b;
  --section-subtitle-color: var(--textBody);
  --section-eyebrow-color:  var(--sale-color);
}
/* Nhóm clinical (gradient trắng→xám): chữ đậm trung tính */
.section--clinical {
  --section-title-color:    var(--textBody);
  --section-subtitle-color: var(--textSub);
  --section-eyebrow-color:  var(--mainColor);
}
/* Nhóm nền đậm (dark): chữ trắng */
.section--dark {
  --section-title-color:    #ffffff;
  --section-subtitle-color: rgba(255,255,255,0.85);
  --section-eyebrow-color:  #FCDC9D;
}

/* ── Alternating Sections — Layer 3: Spacing chuẩn ── */
.pc-section {
  padding-top: var(--pc-section-py);
  padding-bottom: var(--pc-section-py);
  @media (max-width: 767px) {
    padding-top: var(--pc-section-py-sm);
    padding-bottom: var(--pc-section-py-sm);
  }
}

/* ═══════════════════════════════════════════════════════════════════
   MOTION — Scroll Reveal + Reduced Motion Guard
   Tokens (--dur-*, --ease-*) khai báo trong header_style.bwt → :root H
   ═══════════════════════════════════════════════════════════════════ */
.pc-reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity var(--dur-slow) var(--ease-out),
              transform var(--dur-slow) var(--ease-out);
  will-change: opacity, transform;
}
.pc-reveal.is-visible {
  opacity: 1;
  transform: none;
}
/* Hướng vào */
.pc-reveal--left  { transform: translateX(-32px); }
.pc-reveal--right { transform: translateX(32px); }
.pc-reveal--scale { transform: scale(0.92); }
/* Stagger delay */
.pc-reveal--d1 { transition-delay: 100ms; }
.pc-reveal--d2 { transition-delay: 200ms; }
.pc-reveal--d3 { transition-delay: 300ms; }
.pc-reveal--d4 { transition-delay: 400ms; }
.pc-reveal--d5 { transition-delay: 500ms; }

/* Số count-up giữ width ổn định khi đang đếm (tránh layout shift) */
.pc-stat-number[data-target] {
  font-variant-numeric: tabular-nums;
  display: block;
}

/* Reduced motion — accessibility safeguard */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .pc-reveal { opacity: 1; transform: none; }
}

/* ==========================================================================
   Mobile Header — 3-col centered logo (Luxury/Clinic), ≤991px
   Bố cục: [☰][🔍] | LOGO | [🛒]
   - Hamburger + Search cluster bên trái, Logo tuyệt đối giữa, Cart bên phải
   - FA icons đồng bộ font-size 18px; badge → notification dot 7px tinh tế
   ========================================================================== */

/* Icon search mobile — ẩn trên desktop */
.header-action-search { display: none; }

/* Badge ẩn khi giỏ hàng trống — JS (ajaxcartfunction) add/remove class này */
.hidden-count { display: none !important; }

@media (max-width: 991px) {

  {% if settings.mobile_header_sticky %}
  header.header .main-header {
    position: sticky;
    top: 0;
    z-index: 9980;
    background: var(--bgHeader);
  }
  {% endif %}

  /* Ẩn topbar (promo slider / text chạy) trên mobile */
  header.header .main-header .top-main-header { display: none; }

  /* Khoảng thở luxury */
  header.header .main-header { padding-top: 8px; padding-bottom: 8px; }

  {%- comment -%}
    T-124 (2026-09-12) — BUG THẬT (Playwright đo rect + matchMedia thật, không đoán): 4 selector
    logo mobile bên dưới dùng combinator "> .row" (con TRỰC TIẾP của .box-hearder), nhưng DOM hiện
    tại (sau khi người dùng tự chỉnh header.bwt) là ".box-hearder > .container > .row" — có thêm 1
    lớp .container xen giữa, nên "> .row" KHÔNG match được nữa (0 rule nào trong 4 rule này thật sự
    áp dụng, matchMedia vẫn đúng false→true bình thường nhưng selector sai target). Hậu quả: hàng
    không có position:relative làm bệ đỡ, logo không position:absolute để canh giữa — logo rơi về
    layout Bootstrap col-6 mặc định, LỆCH TRÁI thay vì canh giữa. Đổi "> .row" thành " .row"
    (descendant, xuyên qua .container) để khớp đúng DOM thật, không cần sửa header.bwt.
  {%- endcomment -%}
  /* ── Row: position relative để logo absolute hoạt động ── */
  header.header .main-header .box-hearder .row {
    position: relative;
    flex-wrap: nowrap;
    column-gap: 0 !important;
  }

  /* ── Logo: absolute center, pointer-events passthrough ── */
  header.header .main-header .box-hearder .row .header-logo {
    position: absolute !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    flex: none !important;
    width: auto !important;
    min-width: 0 !important;
    overflow: visible !important;
    padding: 0 !important;
    pointer-events: none;
    z-index: 1;
  }

  header.header .main-header .box-hearder .row .header-logo .logo-wrapper {
    pointer-events: all;
    display: inline-flex;
  }

  /* Ẩn text logo — chỉ giữ icon mark trên mobile (logo cũ img.logo-icon + .logo-text-block) */
  header.header .main-header .box-hearder .row .header-logo .logo-text-block {
    display: none;
  }

  {%- comment -%}
    T-124 (2026-09-12) — BUG THẬT thứ 2, cũng đo bằng Playwright: từ T-121, logo đổi sang SVG
    Master hợp nhất (snippets/logo-master-svg.bwt, class .pc-logo-master-svg, KHÔNG có thuộc tính
    width/height, chỉ có viewBox) — chỉ có 1 rule set kích thước rõ ràng cho nó
    (snippets/pharma_ui_kit.bwt, trong "@media (min-width: 992px)"). Dưới 992px KHÔNG có rule nào
    khác cấp kích thước → 1 thẻ <svg> nội tuyến không có width/height/CSS-size sẽ co về 0×0 (khác
    hành vi <img>, SVG không tự có "kích thước mặc định" khi dùng trực tiếp trong HTML) → logo
    biến mất hoàn toàn trên mobile (đã xác nhận: getBoundingClientRect = 0×0 trước khi có rule
    dưới đây). Bổ sung kích thước rõ ràng riêng cho mobile, nhỏ hơn bản desktop (42px) cho vừa
    hàng header nhỏ hơn. Màu: dùng var(--txtHeader) (trắng) THAY VÌ var(--mainColor) như bản
    desktop — nền .main-header trên mobile vẫn là var(--bgHeader) xanh đậm (không có nền trắng
    .box-hearder riêng như >=992px), đo thử contrast xanh-lá-trên-xanh-đậm (--mainColor #3CB371
    trên --bgHeader #1F5A3B) chỉ ~3:1 (dưới ngưỡng AA 4.5:1, cùng dạng lỗi "màu trùng nền" người
    dùng đã báo) — trắng khớp đúng tông với hamburger/search/cart icon đang dùng cùng
    var(--txtHeader) trên cùng nền xanh này.
  {%- endcomment -%}
  header.header .main-header .box-hearder .row .header-logo .pc-logo-master {
    display: inline-flex;
    align-items: center;
    height: 28px;
    width: auto;
    color: var(--txtHeader, #fff);
  }
  header.header .main-header .box-hearder .row .header-logo .pc-logo-master .pc-logo-master-svg {
    height: 100%;
    width: auto;
    display: block;
  }

  /* Header-mid (search inline) ẩn trên mobile */
  header.header .header-mid { display: none !important; }

  /* ── Header-right: full width, hamburger+search trái / cart phải ── */
  header.header .header-right {
    flex: 0 0 100% !important;
    max-width: 100% !important;
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding: 0 !important;
    gap: 0 !important;
  }

  /* Hamburger: order 1, bật lại trên mobile */
  header.header .header-right .menu-icon {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    order: 1;
    padding: 8px;
    margin-left: -8px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--txtHeader);
  }

  /* Search icon: order 2, ngay cạnh hamburger */
  header.header .header-right .header-action-search {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    order: 2;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--txtHeader);
  }

  header.header .header-right .header-action-search .box-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Cart: margin-left auto đẩy sát phải */
  header.header .header-right .sudes-header-cart {
    order: 10;
    margin-left: auto;
  }

  header.header .header-right .sudes-header-cart > a {
    padding-right: 16px;
    padding-left: 8px;
  }

  /* Ẩn wishlist + stores trên mobile */
  header.header .header-right .sudes-header-iwish { display: none !important; }
  header.header .header-right .sudes-header-stores { display: none !important; }

  /* ── FA Icons: đồng bộ size 18px + màu header ── */
  header.header .header-right .menu-icon i,
  header.header .header-right .header-action-search .box-icon i {
    font-size: 18px;
    color: var(--txtHeader);
    line-height: 1;
    display: block;
  }

  /* Cart icon to hơn so với các icon khác */
  header.header .header-right .sudes-header-cart .box-icon i {
    font-size: 22px;
    color: var(--txtHeader);
    line-height: 1;
    display: block;
  }

  /* Box-icon cart: position relative để badge anchor */
  header.header .header-right .sudes-header-cart .box-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
  }

  /* ── Badge giỏ hàng — đỏ nổi bật ── */
  header.header .header-right .sudes-header-cart .box-icon .count_item_pr {
    position: absolute;
    top: -3px;
    right: 0;
    width: 16px;
    height: 16px;
    min-width: 0;
    border-radius: 50%;
    background: var(--accentColor);
    border: none;
    color: #fff;
    font-size: 0.5rem;
    line-height: 16px;
    text-align: center;
    padding: 0;
  }

  {% if settings.mobile_header_compact %}
  header.header.mb-compact .main-header { padding-top: 6px; padding-bottom: 6px; }
  header.header.mb-compact .main-header .top-main-header { display: none; }
  {% endif %}

} /* end @media (max-width: 991px) */

/* ≤480px: thu nhỏ container padding */
@media (max-width: 480px) {
  header.header .main-header .container { padding-left: 10px; padding-right: 10px; }
}

/* ≤370px: tối thiểu */
@media (max-width: 370px) {
  header.header .main-header .container {
    padding-left: 8px !important;
    padding-right: 8px !important;
  }
  header.header .header-right { gap: 0 !important; }
}

@media (max-width: 991px) {
  /* Lời chào tài khoản đầu khối account trong drawer */
  .mb-drawer-account .mb-drawer-greeting {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    margin-bottom: 4px;
    background: var(--mainColorLight);
    border-bottom: 1px solid var(--lineColor);

    .mb-drawer-greeting__avatar {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      color: var(--mainColorDark);
      background: #{"var(--white, #ffffff)"};
      border-radius: 50%;
    }

    .mb-drawer-greeting__text {
      display: flex;
      flex-direction: column;
      line-height: 1.3;
      font-family: var(--font-primary);
      font-size: var(--fs-base);

      a {
        color: var(--mainColorDark);
        font-weight: 600;
        text-decoration: none;
        &:hover, &:focus { color: var(--subColor); }
      }
    }

    .mb-drawer-greeting__hi {
      font-size: var(--fs-xs);
      font-weight: 400;
      color: var(--textSub);
    }

    .mb-drawer-greeting__sep { color: var(--textSub); margin: 0 4px; }
  }
}

@media (max-width: 991px) {
  /* Mobile drawer: ẩn sidebar danh mục, main nav chiếm toàn width */
  .header-menu .sudes-cate-header { display: none !important; }
  .header-menu .sudes-main-header {
    flex: 0 0 100% !important;
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* Topbar drawer — logo trái, nút đóng phải, nền thương hiệu */
  .mb-drawer-topbar {
    width: 100%;
    background: var(--bgHeader);
    border-bottom: none;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 50px;
  }
  .mb-drawer-logo { display: flex; align-items: center; }
  .mb-drawer-logo img { display: block; height: 36px; width: auto; }

  /* Nút đóng drawer */
  .mb-drawer-close {
    position: static;
    width: auto;
    height: auto;
    top: auto;
    left: auto;
    border: none;
    background: none;
    cursor: pointer;
    color: rgba(255,255,255,0.85);
    padding: 8px;
    font-size: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
  }
  .mb-drawer-close:hover { color: #fff; }

  /* Nav links: xoá ALL-CAPS */
  .header-menu .sudes-main-header .col-menu a { text-transform: none; }

  /* Nav list — clean bordered rows (tham chiếu: Biologique Recherche) */
  .header-menu .sudes-main-header .col-menu #nav { padding-bottom: 0; }
  .header-menu .sudes-main-header .col-menu #nav .nav-item { border-bottom: 1px solid #f0f0f0; }
  .header-menu .sudes-main-header .col-menu #nav .nav-item > a {
    display: block;
    padding: 10px 18px !important;
    font-size: var(--fs-base);
    font-weight: 600;
    font-family: var(--font-primary);
    color: #2D3436;
    line-height: 1.3;
    text-decoration: none;
  }
  .header-menu .sudes-main-header .col-menu #nav .nav-item > a .bi { display: none; }
  .header-menu .sudes-main-header .col-menu #nav .nav-item.active > a { color: var(--mainColorDark); }
  .header-menu .sudes-main-header .col-menu #nav .nav-item.has-childs .down_icon {
    height: 56px;
    width: 56px;
    border-left: 1px solid #f0f0f0;
  }
  .header-menu .sudes-main-header .col-menu #nav .nav-item .dropdown-menu > li > a {
    padding: 10px 20px 10px 28px;
    font-size: var(--fs-sm);
    color: #555;
    display: block;
    text-decoration: none;
  }
  .header-menu .sudes-main-header .col-menu #nav .nav-item .dropdown-menu > li > a:hover {
    color: var(--mainColorDark);
  }

  /* Liên kết phụ (Tích điểm, Yêu thích, Cửa hàng) */
  .mb-drawer-secondary {
    list-style: none;
    padding: 8px 0 0;
    margin: 0;
    border-top: 1px solid #eee;
  }
  .mb-drawer-secondary li a {
    display: block;
    padding: 10px 16px;
    color: #555;
    font-size: var(--fs-sm);
    text-decoration: none;
    font-family: var(--font-secondary);
  }
  .mb-drawer-secondary li a:hover { color: var(--mainColorDark); }

  /* Khối tài khoản */
  .mb-drawer-account { border-top: 1px solid #eee; padding-bottom: 12px; }
  .mb-drawer-account .mb-drawer-greeting__avatar {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--mainColorDark);
    background: #ffffff;
    border-radius: 50%;
  }
  .mb-drawer-account .mb-drawer-greeting__text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    font-family: var(--font-primary);
    font-size: var(--fs-base);
  }
  .mb-drawer-account .mb-drawer-greeting__text a {
    color: var(--mainColorDark);
    font-weight: 600;
    text-decoration: none;
  }
  .mb-drawer-account .mb-drawer-greeting__text a:hover { color: var(--subColor); }
  .mb-drawer-account .mb-drawer-greeting__hi {
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--textSub);
  }
  .mb-drawer-account .mb-drawer-greeting__sep { color: var(--textSub); margin: 0 4px; }

  /* Link hành động tài khoản (Tài khoản của tôi / Đăng xuất) */
  .mb-drawer-account-links {
    display: flex;
    gap: 16px;
    padding: 10px 16px 6px;
  }
  .mb-drawer-account-links a {
    font-size: var(--fs-sm);
    color: #555;
    text-decoration: none;
    font-family: var(--font-secondary);
  }
  .mb-drawer-account-links a:hover { color: var(--mainColorDark); }

  /* Chọn ngôn ngữ trong drawer — pill buttons */
  .mb-drawer-lang {
    padding: 10px 16px 14px;
    border-top: 1px solid #eee;
  }
  .mb-drawer-lang-opts {
    display: flex;
    gap: 6px;
  }
  .mb-drawer-lang-opt {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 7px 4px 6px;
    border: 1.5px solid #e8e8e8;
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    font-size: 11px;
    font-family: var(--font-secondary);
    color: #777;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .mb-drawer-lang-opt img { display: block; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,0.08); }
  /* Chặn nhãn xuống dòng khi đổi font/dịch trang → pill không đổi chiều cao, UI không nhảy */
  .mb-drawer-lang-opt span {
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mb-drawer-lang-opt:hover { border-color: var(--mainColor); color: var(--mainColorDark); }
  .mb-drawer-lang-opt.active {
    border-color: var(--mainColor);
    color: var(--mainColorDark);
    background: var(--mainColorLight, #eaf7ee);
    font-weight: 600;
  }
}

/* Shared FAQ accordion (dùng ở booking/PDP/account) */
.pc-booking-faq-section, .pc-account-faq-section {
  padding: 48px 0 64px;
  max-width: 760px;
  margin: 0 auto;
}
.pc-booking-faq-title { text-align: center; margin-bottom: 24px; }
.pc-booking-faq-list { display: flex; flex-direction: column; gap: 12px; }
.pc-faq-item {
  background: #fff;
  border: 1px solid var(--lineColor);
  border-radius: 12px;
  padding: 16px 20px;
}
.pc-faq-q {
  cursor: pointer;
  font-weight: 600;
  color: var(--textBody);
  list-style: none;
}
.pc-faq-q::-webkit-details-marker { display: none; }
.pc-faq-q::before { content: '+ '; color: var(--mainColorDark); font-weight: 700; }
.pc-faq-item[open] .pc-faq-q::before { content: '– '; }
.pc-faq-a {
  margin-top: 10px;
  color: var(--textSub);
  font-size: var(--fs-sm);
  line-height: 1.6;
}

/* Search — bộ lọc chuyên sâu */
.pc-search-filters {
  background: #fff;
  border: 1px solid var(--lineColor);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
}
.pc-search-filters-title {
  font-size: var(--fs-sm);
  text-transform: uppercase;
  color: var(--mainColorDark);
  font-weight: 700;
  margin: 0 0 16px;
}
.pc-search-filter-group { margin-bottom: 18px; }
.pc-search-filter-group h4 {
  font-size: var(--fs-xs);
  text-transform: uppercase;
  color: var(--textBody);
  margin: 0 0 8px;
}
.pc-search-filter-group label {
  display: block;
  font-size: var(--fs-sm);
  color: var(--textSub);
  padding: 4px 0;
  cursor: default;
}
.pc-search-filter-group input { margin-right: 8px; }

/* Account — thông tin cá nhân + sổ địa chỉ preview */
.pc-acct-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px 32px;
}
@media (max-width: 599px) { .pc-acct-info-grid { grid-template-columns: 1fr; } }
.pc-acct-info-grid > div { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--lineColor); }
.pc-acct-info-label { color: var(--textSub); font-size: var(--fs-sm); }
.pc-acct-info-value { color: var(--textBody); font-weight: 600; font-size: var(--fs-sm); }

.pc-acct-addr-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
@media (max-width: 599px) { .pc-acct-addr-grid { grid-template-columns: 1fr; } }
.pc-acct-addr-card {
  position: relative;
  background: #fff;
  border: 1px solid var(--lineColor);
  border-radius: 12px;
  padding: 16px;
}
.pc-acct-addr-card--default { border-color: var(--mainColor); }
.pc-acct-addr-tag {
  display: inline-block;
  font-size: var(--fs-xs);
  color: var(--mainColorDark);
  font-weight: 700;
  margin-bottom: 6px;
}
.pc-acct-addr-name { font-weight: 700; color: var(--textBody); margin-bottom: 4px; }
.pc-acct-addr-line, .pc-acct-addr-phone { font-size: var(--fs-sm); color: var(--textSub); }

/* Cart — 3-step progress + note + gift banner */
.pc-cart-steps {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 16px 0;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--textSub);
}
.pc-cart-step--active { color: var(--mainColorDark); }
.pc-cart-step-arrow { color: var(--lineColor); }
.pc-cart-note {
  background: var(--mainColorLight);
  color: var(--mainColorDark);
  padding: 10px 16px;
  border-radius: 10px;
  font-size: var(--fs-sm);
  margin-bottom: 10px;
}
.pc-cart-gift {
  background: var(--clay-soft, #F6E3D8);
  color: var(--ink, #13241F);
  padding: 10px 16px;
  border-radius: 10px;
  font-size: var(--fs-sm);
  margin-bottom: 16px;
}
