.pc-loy-hero {
  padding: 56px 0 32px;
  text-align: center;
  background: var(--mainColorGradient, var(--mainColorLight));
}
.pc-loy-hero .pc-section-title { margin: 16px 0 12px; font-size: var(--fs-2xl); }
.pc-loy-hero-desc { max-width: 600px; margin: 0 auto; color: var(--textSub); }

.pc-loy-widget-section { padding: 32px 0 0; }

.pc-loy-tiers-section { padding: 48px 0; }
.pc-loy-tiers-title { text-align: center; margin-bottom: 32px; }
.pc-loy-tiers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
@media (max-width: 991px) { .pc-loy-tiers-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 599px) { .pc-loy-tiers-grid { grid-template-columns: 1fr; } }

.pc-loy-tier-card { border-top: 4px solid var(--tier-color, var(--mainColor)); }
.pc-loy-tier-badge {
  display: inline-block;
  padding: 4px 14px;
  border-radius: 50px;
  background: var(--tier-color, var(--mainColor));
  color: #fff;
  font-weight: 700;
  font-size: var(--fs-sm);
}
.pc-loy-tier-threshold {
  margin-top: 10px;
  font-size: var(--fs-xs);
  color: var(--textSub);
  font-weight: 600;
}
.pc-loy-perks {
  margin: 12px 0 0;
  padding: 0;
  list-style: none;
}
.pc-loy-perks li {
  padding: 8px 0;
  border-top: 1px solid var(--lineColor);
  font-size: var(--fs-sm);
  color: var(--textBody);
}
.pc-loy-perks li:first-child { border-top: none; }

.pc-loy-howto-section { padding: 48px 0 64px; background: var(--bg-subtle, #F8F9FA); }
.pc-loy-howto-section .pc-section-title { text-align: center; margin-bottom: 32px; }
.pc-loy-howto-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 767px) { .pc-loy-howto-grid { grid-template-columns: 1fr; } }
.pc-loy-howto-step { text-align: center; }
.pc-loy-howto-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--mainColor);
  color: #fff;
  font-weight: 700;
  font-size: var(--fs-lg);
  margin-bottom: 12px;
}
.pc-loy-howto-step h3 { margin: 0 0 8px; font-size: var(--fs-base); color: var(--textBody); }
.pc-loy-howto-step p { margin: 0; color: var(--textSub); font-size: var(--fs-sm); }
