{% comment %} mops-admin.js.bwt — JS cho MOPS Admin (Templates/page.mops-admin.bwt).
  Vue 3 local compile #mops-app-template với delimiters ['[[',']]'] để không đụng {{ }} Liquid; quản lý TOÀN BỘ 11 tab:
  auth (login/logout/session), sidebar (collapse/mobile drawer/active tab, ẩn tab Cấu hình
  nếu không phải OWNER và ẩn tab Tài chính nếu !canViewFinance — chỉ là UX, quyền thật luôn
  xác thực lại ở code.gs qua token), Tổng quan, Đơn hàng, Sản phẩm, Khách hàng, Tài chính,
  Kho & NCC, Thông báo, Nhật ký, Nhân viên, Mã giảm giá, Cấu hình.
  Kiến trúc/boot invariant: docs/mops-admin-frontend.md. {% endcomment %}
(function() {
function bootstrapMopsAdmin() {
  'use strict';

  window.__mopsAdminRuntime = window.__mopsAdminRuntime || {};
  window.__mopsAdminRuntime.startedAt = new Date().toISOString();
  window.__mopsAdminRuntime.state = 'starting';

  // Idempotency guard — nếu trang bị deploy lỗi khiến toàn bộ script này xuất hiện
  // nhiều lần, CHỈ bản đầu tiên được phép khởi tạo.
  if (window.__mopsAdminBooted) {
    console.warn('[MOPS Admin] Phát hiện script bị nạp nhiều lần trên cùng trang — bỏ qua bản lặp. Kiểm tra lại quá trình đồng bộ/deploy theme.');
    return;
  }
  window.__mopsAdminBooted = true;

  /* ── Config ── */
  var GAS_URL   = {{ settings.mops_gas_url | json }};
  // Zero-Wait Path (2026-08-10): nếu Vercel Edge proxy đã deploy, dùng nó thay GAS trực tiếp.
  // Edge sẽ tự cache reads + enqueue non-critical writes + rate limit trước khi tới GAS. Để trống
  // → FE gọi thẳng GAS như cũ (fallback không mất chức năng).
  var EDGE_URL  = {{ settings.mops_edge_url | json }};
  var API_URL   = EDGE_URL ? (String(EDGE_URL).replace(/\/+$/, '') + '/api/gas') : GAS_URL;
  var TOKEN_KEY = 'mops_token';
  var STAFF_KEY = 'mops_staff';
  var REMEMBER_TOKEN_KEY = 'mops_remember_token';
  var REMEMBER_STAFF_KEY = 'mops_remember_staff';
  var REMEMBER_USERNAME_KEY = 'mops_remember_username';
  // Danh mục Tỉnh/Xã dùng chung cho mọi form địa chỉ (Khách hàng/Chi nhánh/NCC/Nhân viên/Đơn hàng)
  // — API công khai, cập nhật theo cấu trúc hành chính 2 cấp từ 01/07/2025 (bỏ cấp huyện), xem
  // ensureProvincesLoaded()/loadWardsForProvince() (review 2026-07-16).
  var PROVINCE_API = 'https://provinces.open-api.vn/api/v2';
  var appInstance = null; // gán sau Vue.mount()

  // Không để một CDN bị chặn/lỗi biến thành lỗi mơ hồ "Vue is not defined".
  // Giữ preloader trên màn hình và hiển thị nguyên nhân có thể hành động được.
  if (!window.Vue || typeof window.Vue.createApp !== 'function') {
    var dependencyPreloader = document.getElementById('ma-preloader');
    var dependencyStatus = dependencyPreloader && dependencyPreloader.querySelector('.ma-loader-status');
    if (dependencyStatus) {
      dependencyStatus.textContent = 'Không tải được thư viện Vue. Kiểm tra kết nối mạng, extension chặn nội dung hoặc chính sách bảo mật trình duyệt rồi tải lại trang.';
    }
    if (dependencyPreloader) dependencyPreloader.classList.add('is-error');
    window.__mopsAdminRuntime.state = 'dependency-error';
    console.error('[MOPS Admin] Vue CDN không khả dụng; app không thể khởi tạo.', window.Vue);
    return;
  }

  function getToken()     { return sessionStorage.getItem(TOKEN_KEY) || localStorage.getItem(REMEMBER_TOKEN_KEY) || ''; }
  function getStaffInfo() { try { return JSON.parse(sessionStorage.getItem(STAFF_KEY) || localStorage.getItem(REMEMBER_STAFF_KEY) || 'null'); } catch(e) { return null; } }
  function setSession(token, staff, remember) {
    sessionStorage.setItem(TOKEN_KEY, token);
    sessionStorage.setItem(STAFF_KEY, JSON.stringify(staff));
    if (remember) {
      localStorage.setItem(REMEMBER_TOKEN_KEY, token);
      localStorage.setItem(REMEMBER_STAFF_KEY, JSON.stringify(staff));
    } else {
      localStorage.removeItem(REMEMBER_TOKEN_KEY);
      localStorage.removeItem(REMEMBER_STAFF_KEY);
    }
  }
  function clearSession() {
    sessionStorage.removeItem(TOKEN_KEY);
    sessionStorage.removeItem(STAFF_KEY);
    localStorage.removeItem(REMEMBER_TOKEN_KEY);
    localStorage.removeItem(REMEMBER_STAFF_KEY);
  }
  // Token hết hạn (phát hiện qua gasGet/gasPost) → đá về màn login.
  function forceLogin() {
    clearSession();
    if (appInstance) { appInstance.staff = null; appInstance.screen = 'login'; }
  }

  /* ── HTTP helpers ── */
  // Đọc dữ liệu: ĐI QUA POST (token nằm trong body) — KHÔNG gắn token vào query string.
  // Trước đây dựng '?...&token=' → token lộ qua URL / lịch sử trình duyệt / Referer / redirect
  // googleusercontent, replay được tới 6h. Giữ nguyên tên + chữ ký để mọi caller (kể cả các module
  // gọi qua window.MopsAdminCore.gasGet) không phải thay đổi.
  function gasGet(params) {
    return gasPost(params || {});
  }

  // Zero-Wait Path cache (2026-08-10): sessionStorage lưu response theo (action, params, _gen).
  // Bắt được: chuyển tab lần 2 = 0 API call. Reload trang = chỉ 1 API get_cache_gen (~5ms edge).
  // Danh sách action được cache — reads đắt tiền + ít thay đổi. Loại trừ: reports/analytics
  // (thời gian thực), get_cache_gen (bản thân là poll), staff_me (per-request), bulk_bootstrap
  // (Edge đã cache riêng, FE cần data mới nhất mỗi lần vào lại).
  var CACHEABLE_READS = {
    list_products: 1, list_products_lite: 1, list_customers: 1, list_customers_lite: 1,
    list_orders_lite: 1, list_branches: 1, list_bank_accounts: 1, list_carriers: 1,
    list_coupons: 1, list_cash_accounts: 1, list_categories: 1, list_suppliers: 1,
    list_mappings: 1
  };
  var LOCAL_GEN_KEY  = 'mops_local_gen';
  var CACHE_PREFIX   = 'mops:cache:';
  function _stableKey(action, body) {
    var copy = {}; for (var k in body) if (body.hasOwnProperty(k) && k !== 'token' && k !== 'action') copy[k] = body[k];
    var keys = Object.keys(copy).sort();
    var out = {}; for (var i = 0; i < keys.length; i++) out[keys[i]] = copy[keys[i]];
    return action + '|' + JSON.stringify(out);
  }
  function _getLocalGen() { try { return sessionStorage.getItem(LOCAL_GEN_KEY) || ''; } catch (e) { return ''; } }
  function _setLocalGen(g) { if (!g) return; try { sessionStorage.setItem(LOCAL_GEN_KEY, String(g)); } catch (e) {} }
  function _invalidateAllReadCaches() {
    // Xoá mọi key mops:cache:* — dùng khi FE tự write (bump gen local) hoặc phát hiện gen server đổi.
    try {
      var toDel = [];
      for (var i = 0; i < sessionStorage.length; i++) {
        var k = sessionStorage.key(i);
        if (k && k.indexOf(CACHE_PREFIX) === 0) toDel.push(k);
      }
      for (var j = 0; j < toDel.length; j++) sessionStorage.removeItem(toDel[j]);
    } catch (e) {}
  }
  function _cacheGet(action, body) {
    if (!CACHEABLE_READS[action]) return null;
    var gen = _getLocalGen();
    if (!gen) return null;
    try {
      var raw = sessionStorage.getItem(CACHE_PREFIX + _stableKey(action, body) + ':' + gen);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }
  function _cachePut(action, body, response) {
    if (!CACHEABLE_READS[action] || !response || !response.success) return;
    var gen = String(response._gen || '');
    if (!gen) return;
    _setLocalGen(gen);
    try {
      var key = CACHE_PREFIX + _stableKey(action, body) + ':' + gen;
      var s = JSON.stringify(response);
      if (s.length < 500000) sessionStorage.setItem(key, s); // ~500KB cap mỗi key
    } catch (e) { /* quota — bỏ qua, không phải lỗi nghiệp vụ */ }
  }

  // Timeout mặc định cho mọi gasPost (2026-08-12) — trước đây fetch không giới hạn thời gian,
  // Edge/GAS treo → spinner nút quay vô hạn, user bấm nhiều lần → nguy cơ double-submit.
  // 30s khớp với timeout của Vercel Edge Functions (Edge tự cắt ~30s). Riêng staff_me lúc restore
  // session dùng 10s riêng (line ~1927) vì boot cần quyết định nhanh (login ngay nếu chậm).
  var GAS_POST_TIMEOUT_MS = 30000;

  // fetchWithTimeout (2026-09-04) — 1 helper dùng chung cho MỌI fetch tới GAS/Edge, thay cho các
  // bản AbortController+setTimeout viết tay rải rác (gasPost, polling, doLogin, doLogout, staff_me
  // restore session). Trước đây doLogin/doLogout KHÔNG có timeout — có thể treo vô hạn nếu Edge/GAS
  // không phản hồi. Giữ nguyên các mốc thời gian đã có (gasPost 30s, polling/staff_me 10s), chỉ gộp
  // code trùng lặp và bổ sung timeout cho 2 chỗ còn thiếu.
  function fetchWithTimeout(url, fetchOpts, timeoutMs) {
    var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
    var timedOut   = false;
    var timeoutId  = setTimeout(function() {
      // Chỉ tự nhận "đã timeout" khi có controller để THỰC SỰ abort() — nếu không có AbortController
      // (trình duyệt rất cũ), fetch vẫn chạy tiếp sau mốc này; gắn timedOut=true vô điều kiện sẽ gán
      // nhầm mọi lỗi fetch xảy ra sau đó (network reset, DNS...) thành "timeout" dù nguyên nhân khác
      // (review 2026-09-05 — 3 chỗ mới dùng chung fetchWithTimeout, trước đây không có timeout nên
      // không gặp trường hợp này: doLogin/doLogout/staff_me).
      if (controller) { timedOut = true; controller.abort(); }
    }, timeoutMs);
    var opts = Object.assign({}, fetchOpts);
    if (controller) opts.signal = controller.signal;
    return fetch(url, opts).then(function(r) {
      clearTimeout(timeoutId);
      return r;
    }).catch(function(err) {
      clearTimeout(timeoutId);
      if (timedOut || (err && err.name === 'AbortError')) {
        var e = new Error('Kết nối quá chậm (>' + Math.round(timeoutMs / 1000) + 's) hoặc không phản hồi. Vui lòng thử lại.');
        e.kind = 'timeout';
        throw e;
      }
      err.kind = err.kind || 'network';
      throw err;
    });
  }

  function gasPost(body) {
    if (!body || !body.action) {
      return Promise.reject(new Error('Thiếu action khi gọi API MOPS. Vui lòng tải lại trang rồi thử lại.'));
    }
    var action = body.action;
    var b = Object.assign({}, body, { token: getToken() });

    // Cache HIT — trả ngay từ sessionStorage, không network. Kết quả có _cache='HIT-FE'
    // để caller phân biệt nếu cần.
    var hit = _cacheGet(action, b);
    if (hit) return Promise.resolve(Object.assign({}, hit, { _cache: 'HIT-FE' }));

    var fetchOpts = {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(b)
    };

    return fetchWithTimeout(API_URL, fetchOpts, GAS_POST_TIMEOUT_MS).then(function(r) {
      return r.text().then(function(text) {
        var contentType = (r.headers && r.headers.get('content-type')) || '';
        if (!r.ok || /^\s*</.test(text) || contentType.indexOf('json') === -1) {
          // err.status/httpStatus/kind (2026-09-04) — cho phép caller MỚI phân biệt 403/500/502/...
          // nếu cần; 158 caller cũ chỉ đọc err.message nên không bị ảnh hưởng gì (thuần bổ sung).
          var httpErr = new Error('API MOPS không trả JSON (HTTP ' + r.status + '). Kiểm tra Edge URL/GAS URL và deployment đang hoạt động.');
          httpErr.status = r.status;
          httpErr.httpStatus = r.status;
          httpErr.kind = !r.ok ? 'http' : 'parse';
          throw httpErr;
        }
        try { return JSON.parse(text); }
        catch (e) { var pe = new Error('Phản hồi API không hợp lệ, không thể đọc JSON.'); pe.kind = 'parse'; throw pe; }
      });
    })
      .then(function(d) {
        if (!d.success && (d.error || '').indexOf('hết hạn') !== -1) {
          forceLogin(); throw new Error(d.error);
        }
        // Zero-Wait: mỗi response mang _gen; đồng bộ local gen. Nếu là write thành công (không thuộc
        // read cache-able) → gen server đã bump → xoá cache local để lần đọc sau lấy tươi.
        if (d && d.success && d._gen) {
          var prev = _getLocalGen();
          if (prev && prev !== String(d._gen)) _invalidateAllReadCaches();
          _setLocalGen(d._gen);
          _cachePut(action, b, d);
        }
        return d;
      })
      .catch(function(err) {
        // Gắn lại tên action + "GAS" vào message timeout (review 2026-09-05: fetchWithTimeout dùng
        // chung nên message gốc mất action — trước đây 158 caller .catch(e){ showToast(e.message) }
        // dựa vào đúng nội dung này để biết action nào treo mà không cần mở DevTools).
        if (err && err.kind === 'timeout') {
          var te = new Error('Kết nối GAS quá chậm (>' + Math.round(GAS_POST_TIMEOUT_MS / 1000) + 's) hoặc không phản hồi. Vui lòng thử lại. (' + action + ')');
          te.kind = 'timeout';
          throw te;
        }
        throw err;
      });
  }

  // gasPostOptimistic — wrapper cho write hành động: hiển thị kết quả trước khi server xác nhận.
  //   onOptimistic(tempId) — chạy NGAY (đồng bộ) trước khi fetch. Trả về data tạm để FE render.
  //   onConfirm(realData) — chạy khi server trả 2xx {success:true} — thay thế state tạm bằng data thật.
  //   onRollback(err)     — chạy nếu server 4xx/5xx hoặc {success:false} — huỷ state tạm, toast lỗi.
  // Trả về Promise resolve khi onConfirm chạy xong (hoặc reject nếu rollback).
  function gasPostOptimistic(body, onOptimistic, onConfirm, onRollback) {
    var tempId = 'tmp_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    try { if (typeof onOptimistic === 'function') onOptimistic(tempId); } catch (e) {}
    return gasPost(body).then(function(d) {
      if (!d.success) {
        try { if (typeof onRollback === 'function') onRollback(new Error(d.error || 'Lỗi máy chủ'), tempId); } catch (e) {}
        throw new Error(d.error || 'Lỗi máy chủ');
      }
      try { if (typeof onConfirm === 'function') onConfirm(d, tempId); } catch (e) {}
      return d;
    }).catch(function(err) {
      try { if (typeof onRollback === 'function') onRollback(err, tempId); } catch (e) {}
      throw err;
    });
  }

  // Poll get_cache_gen mỗi 30s khi tab visible — bắt được write từ máy khác (nhân viên B thấy đơn
  // nhân viên A vừa tạo trong ≤30s). Endpoint này Edge cache 5s → chi phí ~5ms.
  // Timeout 10s (2026-08-12) — poll interval 30s, timeout ngắn hơn để tránh 2 request overlap
  // khi Edge/GAS treo (poll #2 nổ trước khi poll #1 hoàn tất). Silent fail — không toast.
  function _startGenPolling() {
    var POLL_MS = 30000;
    var POLL_TIMEOUT_MS = 10000;
    function tick() {
      if (document.hidden) return; // im lặng khi tab ẩn
      var pollOpts = {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: 'get_cache_gen' })
      };
      fetchWithTimeout(API_URL, pollOpts, POLL_TIMEOUT_MS).then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d || !d._gen) return;
          var prev = _getLocalGen();
          if (prev && prev !== String(d._gen)) {
            _invalidateAllReadCaches();
            _setLocalGen(d._gen);
          } else if (!prev) {
            _setLocalGen(d._gen);
          }
        }).catch(function() { /* im lặng — không làm phiền user */ });
    }
    setInterval(tick, POLL_MS);
  }
  // Chạy 1 lần sau khi bundle load. Nếu chưa login (token rỗng) get_cache_gen vẫn public → chạy được.
  try { _startGenPolling(); } catch (e) {}

  /* ── Format helpers (expose làm Vue methods bên dưới) ── */
  function formatMoney(n) {
    if (!n && n !== 0) return '—';
    return Number(n).toLocaleString('vi-VN') + ' ₫';
  }

  function formatDate(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d)) return iso;
    var pad = function(x) { return String(x).padStart(2, '0'); };
    return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear()
      + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }

  // numberToVietnameseWords — chuyển sang mixin Assets/mops-admin-orders.js.bwt (dùng bởi
  // _buildOrderPrintHtml unified — 2026-08-24 sau khi bỏ printOrderInvoice legacy).

  // Ghép Địa chỉ/Xã/Tỉnh thành 1 dòng hiển thị cho bảng danh sách (Chi nhánh/NCC/Nhân viên) —
  // lọc bỏ phần rỗng, không để dính 2 dấu phẩy liền khi thiếu Ward hoặc Province.
  function formatAddress(street, ward, province) {
    var parts = [street, ward, province].filter(function(x) { return (x || '').trim(); });
    return parts.length ? parts.join(', ') : '—';
  }

  // LOW_STOCK_THRESHOLD — chuyển sang mixin Assets/mops-admin-products.js.bwt.

  function formatPercent(n) {
    if (n === undefined || n === null || isNaN(n)) return '—';
    return Math.round(n * 100) + '%';
  }

  // Dạng rút gọn cho trục biểu đồ (formatMoney đầy đủ dùng trong tooltip/bảng) — "1,2tr", "500k"
  function formatCompactVnd(n) {
    n = Number(n) || 0;
    var abs = Math.abs(n);
    if (abs >= 1e9) return (n / 1e9).toFixed(1).replace(/\.0$/, '') + ' tỷ';
    if (abs >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, '') + ' tr';
    if (abs >= 1e3) return (n / 1e3).toFixed(0) + 'k';
    return String(n);
  }

  /* ── Biểu đồ (Chart.js CDN — xem layouts/mops-admin.bwt) ──────────────────────
     Sapo không có thư viện biểu đồ cho trang admin custom này (kiểm tra 2026-07-08).
     Quy ước theo skill dataviz nội bộ: 1 hue/series (Thu=emerald, Chi=red — tái dùng
     đúng màu đã dùng cho badge IN/OUT ở Finance Core), bar ngang cho xếp hạng theo
     danh mục (đã có label trục, không cần palette nhiều màu), line+area cho xu hướng
     theo thời gian, tooltip 1 điểm cho mọi series (mode:'index', intersect:false),
     gridline hairline 1 màu xám nhạt, không bao giờ 2 trục y. */
  var chartInstances = {}; // canvasId -> Chart instance, KHÔNG phải Vue reactive data (Chart.js instance quá nặng cho Proxy)
  var CHART_GRID_COLOR = 'rgba(60, 74, 66, 0.12)'; // hairline, 1 nấc so với surface — xem marks-and-anatomy
  var CHART_TEXT_COLOR = '#3c4a42'; // = --on-surface-variant, đồng bộ với text-on-surface-variant trong UI
  var CHART_TOOLTIP_BG = '#213145'; // = --inverse-surface

  // Zero-Wait 2026-08-10: Chart.js giờ lazy-load. Nếu render được gọi khi thư viện chưa có → kick
  // load và retry khi tải xong. Không đổi chữ ký các hàm render (giữ nguyên caller). Guard cũ
  // `if (typeof Chart === 'undefined') return;` được thay bằng _ensureChart(cb) — chạy cb khi sẵn sàng.
  function _ensureChart(cb) {
    if (typeof Chart !== 'undefined') { cb(); return; }
    if (!window.MopsAssets) return; // fallback: Layout chưa expose helper → im lặng (env test)
    window.MopsAssets.loadChart().then(function() {
      Chart.defaults.font.family = "'Montserrat', sans-serif";
      Chart.defaults.color = CHART_TEXT_COLOR;
      cb();
    }).catch(function() { /* nuốt lỗi mạng — render sẽ vẽ lại ở lần sau */ });
  }

  if (typeof Chart !== 'undefined') {
      Chart.defaults.font.family = "'Montserrat', sans-serif";
    Chart.defaults.color = CHART_TEXT_COLOR;
  }

  function destroyChart(canvasId) {
    if (chartInstances[canvasId]) { chartInstances[canvasId].destroy(); delete chartInstances[canvasId]; }
  }

  // Doanh thu theo kỳ (ngày/tháng) — CỘT dọc, không phải line+area. Khác quy ước mặc định ở
  // đầu file ("line+area cho xu hướng theo thời gian") có chủ đích: mỗi kỳ ở đây là 1 khối dữ
  // liệu rời (bucket ngày/tháng), không phải 1 phép đo liên tục — cột so sánh độ cao giữa các
  // kỳ rõ hơn line khi số điểm ít (theo tháng thường <12 điểm). Giữ 1 hue (mark spec bar ≤24px,
  // 4px bo góc đầu cột/square baseline), tooltip mode như renderTrendChart.
  function renderColumnChart(canvasId, buckets, valueKey, hexColor) {
    _ensureChart(function() { _renderColumnChart(canvasId, buckets, valueKey, hexColor); });
  }
  function _renderColumnChart(canvasId, buckets, valueKey, hexColor) {
    var el = document.getElementById(canvasId);
    if (!el) return;
    destroyChart(canvasId);
    var counts = buckets.map(function(b) { return b.order_count; });
    chartInstances[canvasId] = new Chart(el.getContext('2d'), {
      type: 'bar',
      data: {
        labels: buckets.map(function(b) { return b.key; }),
        datasets: [{
          data: buckets.map(function(b) { return b[valueKey]; }),
          backgroundColor: hexColor, borderRadius: 4, borderSkipped: 'bottom', // bo góc đầu cột, vuông ở baseline
          maxBarThickness: 24, // ≤24px theo mark spec
          _counts: counts
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false }, // 1 series — không cần legend box
          tooltip: {
            backgroundColor: CHART_TOOLTIP_BG, padding: 10, cornerRadius: 8,
            titleColor: '#ffffff', bodyColor: '#ffffff', bodyFont: { weight: '700' },
            callbacks: {
              label: function(ctx) { return formatMoney(ctx.parsed.y); },
              afterLabel: function(ctx) {
                var c = ctx.dataset._counts && ctx.dataset._counts[ctx.dataIndex];
                return c !== undefined ? c + ' đơn' : '';
              }
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 11 } } },
          y: {
            beginAtZero: true,
            grid: { color: CHART_GRID_COLOR, drawTicks: false },
            border: { display: false },
            ticks: { font: { size: 11 }, callback: function(v) { return formatCompactVnd(v); } }
          }
        }
      }
    });
  }

  // Xếp hạng theo danh mục/chi nhánh — bar NGANG, 1 hue (mỗi mục đã có nhãn trên trục,
  // không cần gán 1 màu/mục — xem choosing-a-form §Job "Compare magnitude" → sequential 1 hue).
  function renderRankedBarChart(canvasId, items, labelKey, valueKey, hexColor, tooltipExtraFn) {
    _ensureChart(function() { _renderRankedBarChart(canvasId, items, labelKey, valueKey, hexColor, tooltipExtraFn); });
  }
  function _renderRankedBarChart(canvasId, items, labelKey, valueKey, hexColor, tooltipExtraFn) {
    var el = document.getElementById(canvasId);
    if (!el) return;
    destroyChart(canvasId);
    chartInstances[canvasId] = new Chart(el.getContext('2d'), {
      type: 'bar',
      data: {
        labels: items.map(function(it) { return it[labelKey]; }),
        datasets: [{
          data: items.map(function(it) { return it[valueKey]; }),
          backgroundColor: hexColor, borderRadius: 4, borderSkipped: 'left', // 4px bo góc đầu dữ liệu, vuông ở baseline
          maxBarThickness: 22 // ≤24px theo mark spec
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: CHART_TOOLTIP_BG, padding: 10, cornerRadius: 8,
            titleColor: '#ffffff', bodyColor: '#ffffff', bodyFont: { weight: '700' },
            callbacks: {
              label: function(ctx) { return formatMoney(ctx.parsed.x); },
              afterLabel: function(ctx) { return tooltipExtraFn ? tooltipExtraFn(items[ctx.dataIndex]) : ''; }
            }
          }
        },
        scales: {
          x: {
            beginAtZero: true, grid: { color: CHART_GRID_COLOR }, border: { display: false },
            ticks: { font: { size: 11 }, callback: function(v) { return formatCompactVnd(v); } }
          },
          y: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 12 } } }
        }
      }
    });
  }

  function renderDoughnutChart(canvasId, items, centerLabel) {
    _ensureChart(function() { _renderDoughnutChart(canvasId, items, centerLabel); });
  }
  function _renderDoughnutChart(canvasId, items, centerLabel) {
    var el = document.getElementById(canvasId);
    if (!el) return;
    destroyChart(canvasId);
    var values = items.map(function(item) { return Number(item.value) || 0; });
    var hasValue = values.some(function(value) { return value > 0; });
    var centerText = {
      id: 'maCenterText',
      afterDraw: function(chart) {
        var ctx = chart.ctx, area = chart.chartArea;
        if (!area) return;
        var x = (area.left + area.right) / 2, y = (area.top + area.bottom) / 2;
        ctx.save(); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillStyle = '#1c1b1f'; ctx.font = '700 14px Montserrat, system-ui, sans-serif'; ctx.fillText(centerLabel || '', x, y - 8);
        ctx.fillStyle = '#777680'; ctx.font = '500 11px Montserrat, system-ui, sans-serif'; ctx.fillText('Tổng trong kỳ', x, y + 10);
        ctx.restore();
      }
    };
    chartInstances[canvasId] = new Chart(el.getContext('2d'), {
      type: 'doughnut',
      data: { labels: items.map(function(item) { return item.label; }), datasets: [{ data: hasValue ? values : [1], backgroundColor: hasValue ? items.map(function(item) { return item.color; }) : ['#e7e0ec'], borderColor: '#ffffff', borderWidth: 3, hoverOffset: 5 }] },
      options: { responsive: true, maintainAspectRatio: false, cutout: '64%', plugins: { legend: { position: 'right', labels: { boxWidth: 10, boxHeight: 10, padding: 14, font: { size: 12 } } }, tooltip: { enabled: hasValue, backgroundColor: CHART_TOOLTIP_BG, padding: 10, cornerRadius: 8, titleColor: '#ffffff', bodyColor: '#ffffff', callbacks: { label: function(ctx) { var item = items[ctx.dataIndex]; return item.label + ': ' + (canvasId === 'overviewOrderRatioChart' ? ctx.parsed + ' đơn' : formatMoney(ctx.parsed)); }, afterLabel: function(ctx) { return items[ctx.dataIndex].extra || ''; } } } } },
      plugins: [centerText]
    });
  }

  // Crosshair dọc mỏng (hairline, không đứt nét) khi hover line chart — Chart.js không có
  // sẵn, xem interaction.md "The crosshair finds the X". Áp dụng cho mọi chart có bật
  // options.plugins.crosshair.enabled — không ảnh hưởng bar chart (không bật cờ này).
  // Zero-Wait 2026-08-10: Chart giờ lazy — đăng ký plugin cũng phải đợi. _ensureChart tự bảo
  // đảm chỉ chạy khi Chart đã load, nên bọc luôn Chart.register vào đây.
  _ensureChart(function() {
    Chart.register({
      id: 'crosshairLine',
      afterDatasetsDraw: function(chart) {
        var opts = chart.options.plugins && chart.options.plugins.crosshair;
        if (!opts || !opts.enabled) return;
        var tooltip = chart.tooltip;
        if (!tooltip || !tooltip.getActiveElements || !tooltip.getActiveElements().length) return;
        var x = tooltip.getActiveElements()[0].element.x;
        var ctx = chart.ctx;
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(x, chart.chartArea.top);
        ctx.lineTo(x, chart.chartArea.bottom);
        ctx.lineWidth = 1;
        ctx.strokeStyle = CHART_GRID_COLOR;
        ctx.stroke();
        ctx.restore();
      }
    });
  });

  /* ── Lookup tables dùng chung nhiều tab ── */
  var STATUS_COLORS = {
    PENDING: 'amber', PAYMENT_REPORTED: 'blue', PAID: 'emerald', PROCESSING: 'blue',
    COMPLETED: 'emerald', CANCELLED: 'red', EXPIRED: 'gray', REFUNDED: 'violet',
    SENT: 'emerald', FAILED: 'red', SKIPPED: 'gray'
  };
  // Nhãn PENDING dùng chữ 'Chờ xác nhận' (không phải 'Chờ TT') vì với COD tiền do vận
  // chuyển thu — MOPS không track khoảng "chờ chuyển khoản" cho đơn COD. Với VIETQR/CASH,
  // 'Chờ xác nhận' vẫn đúng nghĩa: chờ staff xác nhận đã nhận tiền. Đọc thêm phần bổ nghĩa
  // theo payment_method ở fulfillmentLabel (pending_payment = 'Chờ khách chuyển khoản' —
  // chỉ VIETQR mới rơi vào bước này).
  var STATUS_LABELS = {
    PENDING: 'Chờ xác nhận', PAYMENT_REPORTED: 'Đã báo', PAID: 'Đã TT', PROCESSING: 'Đang xử lý',
    COMPLETED: 'Hoàn thành', CANCELLED: 'Đã huỷ', EXPIRED: 'Hết hạn', REFUNDED: 'Hoàn tiền',
    SENT: 'Đã gửi', FAILED: 'Lỗi', SKIPPED: 'Bỏ qua'
  };
  // NOTIF_LABELS — đã chuyển sang Assets/mops-admin-notifications.js.bwt.
  // AUDIT_CAT_ENTITIES, AUDIT_ACTION_COLOR — đã chuyển sang Assets/mops-admin-audit.js.bwt
  // cùng với data/computed/methods của tab Nhật ký (tách domain đầu tiên, 2026-07-16).
  // FINANCE_CATEGORIES — chuyển sang mixin Assets/mops-admin-finance.js.bwt.
  // PERM_LABELS/ROLE_CHIP_COLOR/SENSITIVE_PERMISSIONS — chuyển sang mixin
  // Assets/mops-admin-staff.js.bwt (chỉ Staff dùng, đã grep xác nhận).

  var _toastTimer = null;
  // 2026-08-28: 'bg-on-surface'/'text-surface' KHÔNG có trong mops-tailwind.css biên dịch sẵn (grep xác
  // nhận 0 kết quả — 'on-surface' chỉ tồn tại dạng text-*, không có bg-* tương ứng) → toast info/warning
  // trước đây không có màu. Đổi sang class đã có sẵn trong file compiled: bg-surface-container-high +
  // text-on-surface (info), bg-amber-100 + text-amber-900 (warning, dùng cho bulkPrintGoshipLabels).
  var TOAST_STYLES = {
    success: 'bg-emerald-600 text-white',
    error:   'bg-red-600 text-white',
    warning: 'bg-amber-100 text-amber-900',
    info:    'bg-surface-container-high text-on-surface'
  };

  // showToast(msg, type, opts?) — opts.duration mặc định 3500ms; truyền 0 (hoặc âm) để hiện
  // persistent (dùng cho luồng async như Tạo đơn V4 2026-08-04: bấm Submit → toast Đang xử lý…
  // không tự tắt, chờ response mới thay bằng success/error toast). Call tiếp theo tự clearTimeout
  // của call trước rồi replace, không cần dismissToast() giữa các bước.
  function showToast(msg, type, opts) {
    opts = opts || {};
    var el = document.getElementById('ma-toast');
    if (!el) { console.warn('[MOPS Admin] Không tìm thấy #ma-toast:', msg); return; }
    el.textContent = msg;
    el.className = 'fixed bottom-6 right-6 z-[100] px-4 py-3 rounded-lg shadow-lg text-body-sm font-medium max-w-xs ' + (TOAST_STYLES[type] || TOAST_STYLES.info);
    clearTimeout(_toastTimer);
    var duration = opts.duration != null ? opts.duration : 3500;
    if (duration > 0) _toastTimer = setTimeout(function() { el.classList.add('hidden'); }, duration);
  }
  function dismissToast() {
    clearTimeout(_toastTimer);
    var el = document.getElementById('ma-toast');
    if (el) el.classList.add('hidden');
  }

  /* ── Confirm dialog (Promise-based) — dùng trước khi đổi secret trong tab Cấu hình ── */
  function showConfirm(title, message) {
    return new Promise(function(resolve) {
      var overlay   = document.getElementById('ma-confirm-overlay');
      var dialog    = document.getElementById('ma-confirm-dialog');
      var okBtn     = document.getElementById('ma-confirm-ok');
      var cancelBtn = document.getElementById('ma-confirm-cancel');
      var titleEl   = document.getElementById('ma-confirm-title');
      var msgEl     = document.getElementById('ma-confirm-message');
      if (!overlay || !dialog || !okBtn || !cancelBtn || !titleEl || !msgEl) {
        console.warn('[MOPS Admin] Thiếu phần tử confirm dialog — huỷ hành động để an toàn.');
        resolve(false);
        return;
      }
      titleEl.textContent = title;
      msgEl.textContent   = message;
      overlay.style.display = 'block';
      dialog.style.display = 'block';
      function cleanup(result) {
        overlay.style.display = 'none';
        dialog.style.display = 'none';
        okBtn.removeEventListener('click', onOk);
        cancelBtn.removeEventListener('click', onCancel);
        overlay.removeEventListener('click', onCancel);
        resolve(result);
      }
      function onOk() { cleanup(true); }
      function onCancel() { cleanup(false); }
      okBtn.addEventListener('click', onOk);
      cancelBtn.addEventListener('click', onCancel);
      overlay.addEventListener('click', onCancel);
    });
  }

  // validateSettingClient — chuyển sang mixin Assets/mops-admin-settings.js.bwt.

  // _loadPermsOnce / _loadPermCatalogOnce — chuyển sang mixin Assets/mops-admin-staff.js.bwt.

  function downloadCsv(filename, lines) {
    var blob = new Blob([String.fromCharCode(0xFEFF) + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(url); }, 1000);
  }
  function csvCell(v) { return '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"'; }

  // isValidResponse / registerRecovery (2026-09-04) — lớp bảo vệ chung cho state "detail"/"report"
  // được ghi từ NHIỀU action khác nhau (vd shipping.detail từ 5 action đối soát): kiểm tra d.success
  // VÀ (tuỳ chọn) hình dạng field kỳ vọng TRƯỚC khi domain gán vào state reactive, thay vì chỉ tin
  // truthy .success như trước (bug lớp này: r.order thiếu ở orders.js.bwt, đã fix riêng — đây là bản
  // dùng chung để domain khác không lặp lại). Đây là predicate thuần (không tự gán) để mỗi call site
  // chỉ đổi điều kiện if, không phải viết lại toàn bộ logic toast/reload xung quanh.
  // Đồng thời ghi "breadcrumb" resource vừa được kiểm tra — app.config.errorHandler dùng để biết nên
  // rollback state nào nếu render ngay sau đó throw (xem registerRecovery + errorHandler bên dưới).
  function isValidResponse(d, shapeCheck, resourceName) {
    window.__mopsAdminRuntime.lastResource = { key: resourceName || '', ts: Date.now() };
    if (!d || !d.success) return false;
    if (typeof shapeCheck === 'function') {
      try {
        if (!shapeCheck(d)) {
          console.warn('[MOPS Admin] Response thiếu field mong đợi cho ' + (resourceName || '(unknown)') + ':', d);
          return false;
        }
      } catch (e) { console.warn('[MOPS Admin] shapeCheck lỗi cho ' + resourceName, e); return false; }
    }
    return true;
  }
  var _resourceRecovery = {};
  // registerRecovery(key, fn) — domain mixin gọi trong mounted() riêng của mixin đó để đăng ký cách
  // đưa 1 resource (đã qua isValidResponse) về trạng thái an toàn (đóng detail/tắt loading) nếu
  // render sau khi gán resource đó bị lỗi. fn(vm) nhận thẳng root instance.
  function registerRecovery(key, fn) { _resourceRecovery[key] = fn; }

  // Namespace share cho các file domain tách riêng (bắt đầu 2026-07-16 với Nhật ký —
  // domain nhỏ nhất, dùng làm bản mẫu trước khi tách tiếp các tab khác). File domain
  // KHÔNG nằm trong IIFE này nên không thấy trực tiếp gasGet/showToast/... — phải gọi
  // qua MopsAdminCore.xxx(...). Chỉ thêm hàm vào đây khi có domain khác thật sự cần dùng.
  window.MopsAdminCore = { gasGet: gasGet, gasPost: gasPost, gasPostOptimistic: gasPostOptimistic, showToast: showToast, dismissToast: dismissToast, showConfirm: showConfirm, downloadCsv: downloadCsv, csvCell: csvCell, formatMoney: formatMoney, formatDate: formatDate, formatPercent: formatPercent, renderColumnChart: renderColumnChart, renderRankedBarChart: renderRankedBarChart, renderDoughnutChart: renderDoughnutChart, isValidResponse: isValidResponse, registerRecovery: registerRecovery };

  // An toàn khi tách domain (2026-07-16) — nếu 1 file domain (vd mops-admin-audit.js.bwt) quên
  // tạo trên Sapo / bị 404 / lỡ nạp SAU file này, window.MopsAdminMixins sẽ thiếu domain đó.
  // KHÔNG để cả trang trắng vì thiếu 1 object domain (bài học "reading 'length'"/"reading 'entity'"
  // — v-show khiến MỌI tab, kể cả tab domain lỗi, đều bị evaluate mỗi lần render bất kỳ tab nào
  // khác đổi state) — tự chèn data() rỗng thay thế + báo lỗi rõ ràng thay vì crash mù mờ.
  // Mỗi domain tách ra thêm 1 dòng vào map này.
  // LƯU Ý: fallback phải khớp CẢ data VÀ methods được template gọi TRẦN không kèm ()
  // (@click="loadAuditLogs", @keydown.enter="loadAuditLogs") — khác với gọi có tham số
  // (@click="setAuditCat(cat.key)") chỉ nằm trong v-for nên tự an toàn khi list rỗng, các
  // handler trần này luôn nằm ngoài v-for/v-if nên LUÔN được Vue resolve mỗi lần render,
  // dù domain có bị vô hiệu hay không — thiếu method (không chỉ thiếu data) cũng crash
  // (Vue nội bộ ném "Cannot read properties of undefined (reading '_withKeys')" khi
  // withKeys() nhận fn = undefined — bài học từ lần domain audit bị thiếu asset thật).
  var MOPS_DOMAIN_FALLBACKS = {
    shipping: function() {
      return {
        data: function() {
          return { shipping: { subtab: 'recon', carriers: [], carriersLoading: false,
            reconList: [], reconLoading: false, reconError: 'Không tải được module Vận chuyển (mops-admin-shipping.js) — báo dev kiểm tra deploy.',
            filterCarrier: '', filterStatus: '', createForm: { show: false }, detail: null, detailLoading: false, acting: false,
            report: null, reportLoading: false, reportFrom: '', reportTo: '' } };
        },
        computed: { shippingReconEmpty: function() { return this.shipping.reconError; } },
        methods: {
          setShippingSubtab: function() {}, loadCarriers: function() {}, toggleCarrier: function() {},
          shipStatusBadge: function() { return ''; }, loadReconciliations: function() {}, openReconCreate: function() {},
          submitReconCreate: function() {}, openReconDetail: function() {}, saveReconItem: function() {},
          confirmRecon: function() {}, payRecon: function() {}, loadShippingReport: function() {}
        }
      };
    },
    audit: function() {
      return {
        data: function() {
          return {
            audit: { activeCat: '', entity: '', logAction: '', entityId: '', loading: false,
              error: 'Không tải được module Nhật ký (mops-admin-audit.js) — báo dev kiểm tra deploy.', list: [] },
            auditCats: []
          };
        },
        computed: {
          auditEmptyMessage: function() { return this.audit.error; }
        },
        methods: {
          setAuditCat: function() {},
          loadAuditLogs: function() {},
          auditActionClass: function() { return 'text-on-surface'; },
          exportAuditCsv: function() { console.error('[MOPS Admin] Module Nhật ký chưa tải — không thể xuất CSV.'); }
        }
      };
    },
    coupons: function() {
      return {
        data: function() {
          return {
            couponsMgmt: { all: [], loading: false, error: 'Không tải được module Mã giảm giá (mops-admin-coupons.js) — báo dev kiểm tra deploy.',
              search: '', creating: false, showAddForm: false,
              newCoupon: { code: '', valueType: 'percent', value: '', minOrderAmount: '', maxUses: '', startAt: '', expiresAt: '', description: '' } }
          };
        },
        computed: {
          couponsFiltered: function() { return []; },
          couponsEmptyMessage: function() { return this.couponsMgmt.error; }
        },
        methods: {
          loadCoupons: function() {},
          createCoupon: function() {},
          doToggleCouponActive: function() {}
        }
      };
    },
    customers: function() {
      return {
        data: function() {
          return {
            customers: { all: [], search: '', loading: false,
              error: 'Không tải được module Khách hàng (mops-admin-customers.js) — báo dev kiểm tra deploy.',
              expandedId: null, detail: null, detailLoading: false, orderSearch: '', notesSaving: false,
              showEditForm: false, editTarget: null,
              editForm: { name: '', email: '', customerGroup: 'LẺ', defaultDiscountPercent: '',
                addressStreet: '', addressWard: '', addressDistrict: '', addressCity: '',
                birthday: '', acquisitionChannel: '', loyaltyPoints: '', membershipTier: '' },
              editSaving: false }
          };
        },
        computed: {
          customersFiltered: function() { return []; },
          customersEmptyMessage: function() { return this.customers.error; },
          customersPaidOrders: function() { return []; },
          customersTotalPaid: function() { return 0; },
          customerOrdersFiltered: function() { return []; }
        },
        methods: {
          loadCustomers: function() {},
          openCustomerDrawer: function() {},
          closeCustomerDrawer: function() {},
          viewOrderFromCustomer: function() {},
          startEditCustomer: function() {},
          saveCustomerEdit: function() {},
          saveCustomerNotes: function() {},
          copyCustomerAddress: function() {},
          membershipTierMeta: function() { return null; }
        }
      };
    },
    branches: function() {
      return {
        data: function() {
          return {
            branches: { all: [], loading: false,
              error: 'Không tải được module Chi nhánh (mops-admin-branches.js) — báo dev kiểm tra deploy.',
              search: '', filterActive: '', showAddForm: false, submitting: false,
              newBranch: { name_vi: '', name_en: '', phone: '', email: '', address: '', tax_code: '', province: '', ward: '' },
              showEditForm: false, editTarget: null,
              editForm: { name_vi: '', name_en: '', phone: '', email: '', address: '', tax_code: '', active: true, is_default: false, province: '', ward: '' },
              editSaving: false },
            // bankAccounts PHẢI có trong fallback — modal Thêm/Sửa TK ngân hàng nằm ngoài tab
            // (page.mops-admin.bwt:1013 dùng v-if="bankAccounts.showForm") và bảng liệt kê ở
            // tab Chi nhánh (mops_admin_tab_branches.bwt:17-30) đều v-show → luôn evaluate. Thiếu
            // object cha → TypeError "reading 'showForm'/'loading'/'all'" → trắng toàn trang.
            bankAccounts: { all: [], loading: false, error: '', submitting: false,
              showForm: false, editing: false,
              form: { bank_account_id: '', bank_code: '', account_no: '', account_name: '', is_default: false, active: true } }
          };
        },
        // activeBranches PHẢI có trong fallback — dropdown chi nhánh ở form Tạo đơn thủ công
        // (domain Đơn hàng) và Thêm tài khoản quỹ (domain Tài chính) dùng computed này dù đang ở
        // tab nào (v-show render mọi tab), không riêng gì tab Chi nhánh.
        computed: {
          activeBranches: function() { return []; },
