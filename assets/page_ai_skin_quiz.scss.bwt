/* ==========================================================================
   Pharma Cosmetics - AI Skin Diagnostic Conversational Chat Interface
   Style: Live Clinical Chat (Zalo / Messenger / Medical Assistant Concept)
   ========================================================================== */

:root {
  --chat-primary: #3CB371;
  --chat-primary-dark: #267348;
  --chat-emerald: #166B55;
  --chat-pine: #0F2318;
  --chat-bg-app: #F4F7F5;
  --chat-bubble-bot: #FFFFFF;
  --chat-text-dark: #0F2318;
  --chat-text-muted: #64748B;
  --chat-border: #E2E8F0;
  --chat-font-sans: 'Montserrat', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --chat-font-display: 'Montserrat', system-ui, sans-serif;
}

.ai-skin-chat-app, .ai-skin-chat-app *, .ai-skin-chat-app *::before, .ai-skin-chat-app *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* App Outer Shell (Centered on desktop, full screen on mobile) */
.ai-skin-chat-app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  /* Bỏ max-width riêng — dùng chung .container chuẩn (global_core.scss.bwt: ≥1200px → 1280px) */
  margin: 24px auto;
  font-family: var(--chat-font-sans);
  color: var(--chat-text-dark);
  background: #FFFFFF;
  box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

/* ==========================================================================
   Pharma Cosmetics - AI Skin Camera & Diagnostic UI (Mockup PharmaCosmetics (1).svg)
   Style: Widescreen Clinical Card, 2-Column Responsive Grid, Floating Controls
   ========================================================================== */

.pc-skin-mode-tabs {
  /* Bỏ max-width/padding riêng — dùng chung .container chuẩn (global_core.scss.bwt) */
  margin: 32px auto 16px;
  display: flex;
  gap: 12px;
  font-family: var(--chat-font-sans);
}

.pc-skin-mode-tabs button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 46px;
  padding: 8px 22px;
  border-radius: 9999px;
  border: 1.5px solid #d1fae5;
  background: #ffffff;
  color: #164834;
  font: inherit;
  font-weight: 700;
  font-size: 0.92rem;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.pc-skin-mode-tabs button .pc-mode-tab-icon {
  width: 18px;
  height: 18px;
  stroke: currentColor;
  flex-shrink: 0;
}

.pc-skin-mode-tabs button:hover {
  background: #f4fbf7;
  border-color: #3cb371;
  transform: translateY(-1px);
}

.pc-skin-mode-tabs button[aria-selected="true"] {
  background: #205a3b;
  border-color: #205a3b;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(32, 90, 59, 0.28);
}

.pc-skin-mode-tabs button[aria-selected="true"]:hover {
  background: #17472e;
  border-color: #17472e;
}

/* MAIN CARD CONTAINER */
.pc-skin-scan {
  margin: 0 auto 48px;
  padding: 36px 36px 32px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 20px 50px rgba(15, 35, 24, 0.06);
  font-family: var(--chat-font-sans);
  position: relative;
  overflow: hidden;
}

.pc-skin-scan[hidden] {
  display: none;
}

/* 2-COLUMN LAYOUT */
.pc-skin-scan__layout {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 36px;
  align-items: stretch;
}

/* LEFT COLUMN: Medical Info & Features */
.pc-skin-scan__col-info {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  position: relative;
  padding-bottom: 24px;
}

.pc-skin-scan__eyebrow {
  margin: 0 0 10px;
  color: #267348;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pc-skin-scan__intro h2 {
  margin: 0 0 16px;
  color: #0f2318;
  font-size: clamp(1.65rem, 2.5vw, 2.15rem);
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.pc-skin-scan__desc {
  margin: 0 0 28px;
  color: #52655b;
  font-size: 0.92rem;
  line-height: 1.62;
}

/* 3 Feature items */
.pc-skin-features {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 28px;
}

.pc-skin-feature-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 14px;
  background: #f8faf8;
  border-radius: 14px;
  border: 1px solid #edf2ef;
  transition: all 0.2s ease;
}

.pc-skin-feature-item:hover {
  background: #f1f7f3;
  border-color: #d1fae5;
  transform: translateX(3px);
}

.pc-skin-feature-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pc-skin-feature-title {
  font-weight: 700;
  font-size: 0.95rem;
  color: #0f2318;
  margin-bottom: 2px;
}

.pc-skin-feature-subtitle {
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.35;
}

.pc-skin-leaf-accent {
  position: absolute;
  left: -8px;
  bottom: -8px;
  opacity: 0.9;
  pointer-events: none;
}

/* RIGHT COLUMN: Camera Viewfinder Stage */
.pc-skin-scan__col-stage {
  display: flex;
  flex-direction: column;
}

.pc-skin-scan__stage {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  min-height: 380px;
  border-radius: 20px;
  background: #0c2117;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.45);
}

.pc-skin-scan__stage video,
.pc-skin-scan__stage canvas {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}

.pc-skin-scan__stage canvas {
  pointer-events: none;
  z-index: 2;
}

/* Standby Overlay */
.pc-skin-standby {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 24px;
  text-align: center;
  z-index: 5;
  background: radial-gradient(circle at center, #153828 0%, #0a1b13 100%);
  transition: opacity 0.35s ease, visibility 0.35s ease;
}

.pc-skin-standby__ring-icon {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  border: 2px solid rgba(45, 212, 191, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2dd4bf;
  margin-bottom: 18px;
  box-shadow: 0 0 28px rgba(45, 212, 191, 0.28);
  background: rgba(45, 212, 191, 0.08);
  animation: pulseCameraRing 2.4s infinite ease-in-out;
}

@keyframes pulseCameraRing {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 24px rgba(45, 212, 191, 0.25);
  }
  50% {
    transform: scale(1.04);
    box-shadow: 0 0 36px rgba(45, 212, 191, 0.45);
  }
}

.pc-skin-standby__title {
  color: #ffffff;
  font-size: 1.18rem;
  font-weight: 700;
  margin: 0 0 8px;
  letter-spacing: -0.01em;
}

.pc-skin-standby__subtitle {
  color: #94a3b8;
  font-size: 0.88rem;
  margin: 0 0 24px;
  max-width: 300px;
  line-height: 1.5;
}

.pc-btn-start-pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 44px;
  padding: 10px 26px;
  border-radius: 9999px;
  background: #267348;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(38, 115, 72, 0.38);
  transition: all 0.2s ease;
}

.pc-btn-start-pill:hover {
  background: #1e5c3a;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(38, 115, 72, 0.48);
}

/* Steps inside Viewfinder */
.pc-skin-scan__steps {
  position: absolute;
  bottom: 12px;
  left: 14px;
  right: 14px;
  z-index: 6;
  display: flex;
  justify-content: space-around;
  gap: 8px;
  margin: 0;
  padding: 6px 10px;
  list-style: none;
  background: rgba(10, 27, 19, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.pc-skin-scan__steps li {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 9999px;
  color: #94a3b8;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.25s ease;
  user-select: none;
}

.pc-skin-scan__steps li .pc-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  color: inherit;
}

.pc-skin-scan__steps li.is-active {
  background: rgba(38, 115, 72, 0.85);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.pc-skin-scan__steps li.is-active .pc-step-dot {
  background: #ffffff;
  color: #267348;
}

.pc-skin-scan__steps li.is-complete {
  color: #34d399;
}

.pc-skin-scan__steps li.is-complete .pc-step-dot {
  background: #34d399;
  color: #0c2117;
}

/* Floating Status overlay */
.pc-skin-scan__status {
  position: absolute;
  top: 14px;
  left: 14px;
  right: 68px;
  margin: 0;
  padding: 8px 14px;
  border-radius: 12px;
  background: rgba(10, 27, 19, 0.85);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 0.84rem;
  z-index: 6;
  line-height: 1.4;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.pc-skin-scan__status[data-skin-mode-unavailable] {
  top: auto;
  bottom: 60px;
  right: 14px;
  background: rgba(185, 28, 28, 0.9);
}

/* Floating Flip Switch */
.pc-skin-scan__flip-btn {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 7;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(10, 27, 19, 0.85);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.pc-skin-scan__flip-btn:hover {
  background: rgba(38, 115, 72, 0.9);
  transform: rotate(180deg);
}

.pc-skin-scan__flip-btn[hidden] {
  display: none !important;
}

/* Shutter Live Stream Controls */
.pc-skin-stream-controls {
  position: absolute;
  bottom: 60px;
  left: 0;
  right: 0;
  display: none;
  justify-content: center;
  z-index: 7;
  pointer-events: none;
}

.pc-skin-scan.is-streaming .pc-skin-standby {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.pc-skin-scan.is-streaming .pc-skin-stream-controls {
  display: flex;
}

.pc-btn-shutter {
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 46px;
  padding: 10px 24px;
  border-radius: 9999px;
  background: #22a05d;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.92rem;
  border: 2px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
  cursor: pointer;
  transition: all 0.2s ease;
}

.pc-btn-shutter:hover:not(:disabled) {
  background: #1e8e52;
  transform: scale(1.03);
}

.pc-btn-shutter:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  filter: grayscale(0.4);
}

.pc-shutter-outer-ring {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-shutter-inner-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ffffff;
}

/* Shutter Flash Animation */
.pc-skin-scan__stage.pc-shutter-flash::after {
  content: '';
  position: absolute;
  inset: 0;
  background: #ffffff;
  z-index: 10;
  pointer-events: none;
  animation: shutterFlashFade 0.22s ease-out forwards;
}

@keyframes shutterFlashFade {
  0% { opacity: 0.85; }
  100% { opacity: 0; }
}

/* Bottom Bar - Full Width col-12 Row below 2-Col Layout */
.pc-skin-scan__bottom-bar {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1.5px solid #edf2ef;
  width: 100%;
}

.pc-skin-scan__actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  max-width: 580px;
  margin: 0 auto;
}

.pc-skin-scan__primary,
.pc-skin-scan__secondary {
  min-height: 46px;
  padding: 10px 18px;
  border-radius: 12px;
  font: inherit;
  font-weight: 700;
  font-size: 0.92rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.pc-skin-scan__primary {
  border: 1.5px solid #267348;
  background: #267348;
  color: #ffffff;
}

.pc-skin-scan__primary:hover:not(:disabled) {
  background: #1e5c3a;
  border-color: #1e5c3a;
  transform: translateY(-1px);
}

.pc-skin-scan__primary:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.pc-skin-scan__secondary {
  border: 1.5px solid #d1fae5;
  background: #f8faf8;
  color: #1e6b42;
}

.pc-skin-scan__secondary:hover:not(:disabled) {
  background: #edf7f1;
  border-color: #3cb371;
  transform: translateY(-1px);
}

.pc-btn-upload-trigger,
.pc-btn-analyze {
  flex: 1;
}

/* Clinical 3-Angle Upload Dropzone Cards */
.pc-skin-scan__upload {
  margin-top: 20px;
  width: 100%;
}

.pc-skin-scan__upload[hidden] {
  display: none !important;
}

.pc-dropzone-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  width: 100%;
}

.pc-upload-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 22px 18px;
  border: 1.5px dashed #b8c7c0;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  position: relative;
}

.pc-upload-card:hover {
  border-color: #267348;
  background: #fbfdfc;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(38, 115, 72, 0.12);
}

.pc-upload-card.has-file {
  border-color: #34d399;
  border-style: solid;
  background: #f0fdf4;
}

.pc-dropzone-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
}

.pc-upload-label {
  display: block;
  font-weight: 700;
  font-size: 0.95rem;
  color: #0f2318;
  margin-bottom: 4px;
}

.pc-dropzone-hint {
  display: block;
  font-size: 0.8rem;
  color: #64748b;
  margin-bottom: 12px;
}

.pc-upload-card input[type="file"] {
  width: 100%;
  font-size: 0.8rem;
  color: #52655b;
  cursor: pointer;
}

/* Report Section */
.pc-skin-scan__report {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1.5px solid #edf2ef;
}

.pc-skin-scan__report[hidden] {
  display: none !important;
}

.pc-report-header {
  margin-bottom: 16px;
}

.pc-report-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #267348;
  background: #edf7f1;
  padding: 4px 10px;
  border-radius: 999px;
  margin-bottom: 8px;
}

.pc-skin-scan__report h3 {
  margin: 0 0 8px;
  color: #0f2318;
  font-size: 1.25rem;
  font-weight: 700;
}

.pc-skin-scan__report p {
  color: #52655b;
  font-size: 0.9rem;
}

.pc-skin-scan__layers {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
  margin: 14px 0 20px;
  padding: 12px 16px;
  border: 1px solid #d7e4dc;
  border-radius: 12px;
  background: #fbfdfc;
}

.pc-skin-scan__layers legend {
  padding: 0 6px;
  color: #164834;
  font-weight: 700;
  font-size: 0.85rem;
}

.pc-skin-scan__layers label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #294238;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
}

.pc-skin-scan__previews {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.pc-skin-scan__previews figure {
  min-width: 0;
  margin: 0;
}

.pc-skin-scan__previews figcaption {
  margin-bottom: 6px;
  color: #294238;
  font-size: 0.84rem;
  font-weight: 700;
  text-align: center;
}

.pc-skin-scan__previews canvas {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 12px;
  background: #0c2117;
  border: 1px solid #d7e4dc;
}

.pc-report-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20px;
}

.pc-skin-scan__report-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  border-radius: 12px;
  padding: 12px 24px;
}

.pc-skin-scan__disclaimer {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid #edf2ef;
  color: #64748b;
  font-size: 0.82rem;
  line-height: 1.55;
  text-align: center;
}

/* Radar chart */
.pc-skin-radar {
  max-width: 440px;
  margin: 18px auto;
  text-align: center;
}

.pc-skin-radar[hidden] {
  display: none;
}

.pc-skin-radar h3 {
  margin: 0 0 8px;
  color: #0f2318;
  font-size: 1.1rem;
}

.pc-skin-radar svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

.pc-skin-radar__grid polygon {
  fill: none;
  stroke: #d7e4dc;
  stroke-width: 1;
}

.pc-skin-radar__grid path {
  fill: none;
  stroke: #b8c7c0;
  stroke-width: 1;
}

.pc-skin-radar__area {
  fill: rgba(38, 115, 72, .22);
  stroke: #267348;
  stroke-width: 2.5;
  stroke-linejoin: round;
}

.pc-skin-radar__labels {
  fill: #294238;
  font-size: 10px;
}

.pc-skin-radar figcaption {
  color: #52655b;
  font-size: 0.8rem;
  line-height: 1.5;
}

/* RESPONSIVE BREAKPOINTS */
@media (max-width: 860px) {
  .pc-skin-scan__layout {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .pc-skin-scan {
    padding: 28px 20px;
    margin: 0 auto 32px;
  }

  .pc-skin-mode-tabs {
    margin: 20px auto 12px;
  }

  .pc-dropzone-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .pc-skin-scan__actions {
    max-width: 100%;
    flex-direction: column;
  }

  .pc-skin-scan__actions > * {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .pc-skin-scan {
    border-radius: 0;
    border-left: none;
    border-right: none;
    padding: 20px 16px;
  }

  .pc-skin-scan__steps,
  .pc-skin-scan__upload,
  .pc-skin-scan__previews {
    grid-template-columns: 1fr;
  }

  .pc-skin-scan__steps {
    border-radius: 12px;
    flex-direction: column;
    gap: 4px;
  }

  .pc-skin-mode-tabs {
    flex-direction: column;
  }

  .pc-skin-mode-tabs button {
    width: 100%;
    justify-content: center;
  }
}

/* CRM Intake 2026-09-23: modal scope riêng, không khoá cuộn toàn trang. */
.ai-skin-crm-modal[hidden] { display: none; }
.ai-skin-crm-modal {
  position: fixed;
  z-index: 10020;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
}
.ai-skin-crm-modal__backdrop { position: absolute; inset: 0; background: rgba(0, 46, 35, .58); }
.ai-skin-crm-modal__dialog {
  position: relative;
  width: min(100%, 520px);
  padding: 28px;
  border-radius: 20px;
  background: #fff;
  color: #13241F;
  box-shadow: 0 20px 60px rgba(0, 46, 35, .28);
}
.ai-skin-crm-modal__dialog h2 { margin: 0 0 12px; font-size: 1.3rem; }
.ai-skin-crm-modal__dialog p { margin: 0; line-height: 1.6; }
.ai-skin-crm-modal__status { min-height: 1.5em; margin-top: 12px !important; color: #267348; font-size: .9rem; }
.ai-skin-crm-modal__actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }
.ai-skin-crm-modal__actions button, .btn-result-crm {
  border-radius: 10px;
  min-height: 42px;
  padding: 10px 16px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}
.ai-skin-crm-modal__cancel { border: 1px solid #b8c7c0; background: #fff; color: #294238; }
.ai-skin-crm-modal__accept, .btn-result-crm { border: 1px solid #267348; background: #267348; color: #fff; }
.ai-skin-crm-modal__accept:disabled { cursor: not-allowed; opacity: .58; }
.btn-result-crm { width: 100%; margin-bottom: 10px; }
@media (max-width: 480px) {
  .ai-skin-crm-modal { padding: 12px; }
  .ai-skin-crm-modal__dialog { padding: 22px; }
  .ai-skin-crm-modal__actions { flex-direction: column-reverse; }
  .ai-skin-crm-modal__actions button { width: 100%; }
}

@media (min-width: 768px) {
  .ai-skin-chat-app {
    height: 92vh;
    border-radius: 24px;
    border: 1px solid rgba(22, 107, 85, 0.15);
    box-shadow: 0 25px 60px -15px rgba(15, 35, 24, 0.25);
  }
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.chat-app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #FFFFFF;
  border-bottom: 1px solid var(--chat-border);
  z-index: 20;
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-back-nav {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--chat-pine);
  text-decoration: none;
  background: #F1F5F9;
  transition: all 0.2s ease;
}

.btn-back-nav:hover {
  background: #E2E8F0;
  color: var(--chat-primary-dark);
}

.doctor-avatar-wrap {
  position: relative;
  width: 44px;
  height: 44px;
}

.doctor-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--chat-primary) 0%, var(--chat-emerald) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 20px;
  box-shadow: 0 2px 8px rgba(60, 179, 113, 0.3);
}

.online-indicator {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 12px;
  height: 12px;
  background: #10B981;
  border: 2px solid #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
}

.doctor-info {
  display: flex;
  flex-direction: column;
}

.doctor-name-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.doctor-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--chat-pine);
}

.verified-badge {
  font-size: 10px;
  font-weight: 700;
  color: var(--chat-primary-dark);
  background: #E8F8EE;
  padding: 2px 6px;
  border-radius: 999px;
  border: 1px solid #D1FAE5;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.doctor-status {
  font-size: 11.5px;
  color: var(--chat-text-muted);
}

.btn-chat-action {
  background: #F8FAF7;
  border: 1px solid var(--chat-border);
  color: var(--chat-text-muted);
  font-size: 12px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-chat-action:hover {
  background: #F1F5F9;
  color: var(--chat-pine);
}

/* Progress Wrap */
.chat-progress-wrap {
  background: #FAFDFB;
  padding: 8px 16px 6px;
  border-bottom: 1px solid #EDF2F7;
  flex-shrink: 0;
}

.progress-info-row {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--chat-text-muted);
  margin-bottom: 4px;
}

.progress-track {
  height: 4px;
  background: #E2E8F0;
  border-radius: 2px;
  overflow: hidden;
}

.progress-bar-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, var(--chat-primary) 0%, var(--chat-emerald) 100%);
  transition: width 0.4s ease;
}

/* ==========================================================================
   CHAT MESSAGES VIEWPORT
   ========================================================================== */
.chat-messages-viewport {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  background: #F8FAF7;
  scroll-behavior: smooth;
  display: flex;
  flex-direction: column;
}

.chat-timeline-divider {
  text-align: center;
  margin: 8px 0 14px;
}

.chat-timeline-divider span {
  font-size: 11px;
  color: var(--chat-text-muted);
  background: #E2E8F0;
  padding: 3px 10px;
  border-radius: 999px;
  font-weight: 600;
}

.chat-security-banner {
  background: #E8F8EE;
  border: 1px solid #C6F6D5;
  color: var(--chat-primary-dark);
  font-size: 11.5px;
  padding: 8px 12px;
  border-radius: 10px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  text-align: left;
}

.messages-flow {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Message Rows */
.chat-message-row {
  display: flex;
  gap: 8px;
  align-items: flex-end;
  animation: fadeInMsg 0.3s ease-out forwards;
}

@keyframes fadeInMsg {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.doctor-avatar-mini {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--chat-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  flex-shrink: 0;
  margin-bottom: 16px;
}

.message-content-wrap {
  display: flex;
  flex-direction: column;
  max-width: 84%;
}

.message-bubble {
  padding: 12px 16px;
  font-size: 14px;
  line-height: 1.55;
  position: relative;
  word-break: break-word;
}

/* Bot Bubble */
.bot-row .message-content-wrap {
  align-items: flex-start;
}

.bot-bubble {
  background: #FFFFFF;
  color: var(--chat-text-dark);
  border: 1px solid #E2E8F0;
  border-radius: 18px 18px 18px 4px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.quiz-phase-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--chat-primary-dark);
  background: #E8F8EE;
  padding: 2px 8px;
  border-radius: 6px;
  margin-bottom: 8px;
}

.quiz-question-heading {
  font-size: 14.5px;
  color: #0F2318;
}

/* User Bubble */
.user-row {
  justify-content: flex-end;
}

.user-row .message-content-wrap {
  align-items: flex-end;
}

.user-bubble {
  background: linear-gradient(135deg, var(--chat-primary) 0%, var(--chat-primary-dark) 100%);
  color: #FFFFFF;
  border-radius: 18px 18px 4px 18px;
  box-shadow: 0 4px 12px rgba(60, 179, 113, 0.25);
  font-weight: 500;
}

.message-timestamp {
  font-size: 10.5px;
  color: var(--chat-text-muted);
  margin-top: 4px;
  padding: 0 4px;
}

/* Typing Indicator Bubble */
.typing-bubble-wrap {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin-top: 6px;
}

.typing-bubble {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 16px 16px 16px 4px;
  padding: 10px 14px;
  display: flex;
  gap: 4px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.typing-bubble .dot {
  width: 6px;
  height: 6px;
  background: #94A3B8;
  border-radius: 50%;
  animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-bubble .dot:nth-child(1) { animation-delay: 0s; }
.typing-bubble .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-bubble .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
  40% { transform: translateY(-6px); opacity: 1; background: var(--chat-primary); }
}

/* Diagnostic Result Card inside Chat */
.diagnostic-result-card {
  background: #FFFFFF;
  border: 2px solid var(--chat-primary);
  border-radius: 16px;
  padding: 18px;
  margin-top: 6px;
  box-shadow: 0 10px 25px rgba(60, 179, 113, 0.12);
}

.card-tag {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--chat-primary-dark);
  background: #E8F8EE;
  padding: 4px 10px;
  border-radius: 999px;
  display: inline-block;
  margin-bottom: 8px;
}

.result-skin-title {
  font-family: var(--chat-font-display);
  font-size: 22px;
  color: var(--chat-pine);
  font-weight: 700;
  margin-bottom: 6px;
}

.result-skin-summary {
  font-size: 13px;
  color: var(--chat-text-muted);
  line-height: 1.5;
  margin-bottom: 14px;
}

.rec-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--chat-pine);
  margin-bottom: 8px;
}

.result-recommend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 16px;
}

.res-rec-badge {
  background: #F1F5F9;
  border: 1px solid #E2E8F0;
  color: var(--chat-pine);
  font-size: 12px;
  font-weight: 600;
  padding: 5px 10px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.res-rec-badge i {
  color: var(--chat-primary);
}

.result-card-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.btn-result-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--chat-primary) 0%, var(--chat-primary-dark) 100%);
  color: #FFFFFF;
  text-decoration: none;
  padding: 12px 18px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  box-shadow: 0 4px 12px rgba(60, 179, 113, 0.3);
  transition: transform 0.2s;
}

.btn-result-cta:hover {
  transform: translateY(-1px);
}

.btn-result-zalo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #0068FF;
  color: #FFFFFF;
  text-decoration: none;
  padding: 10px 18px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 13px;
}

/* ==========================================================================
   ACTION DOCK (BOTTOM)
   ========================================================================== */
.chat-action-dock {
  background: #FFFFFF;
  border-top: 1px solid var(--chat-border);
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 20;
  flex-shrink: 0;
}

/* Quick Replies horizontal scroll / stack */
.quick-replies-scroll {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  max-height: 150px;
  overflow-y: auto;
}

.quick-reply-chip {
  background: #FFFFFF;
  border: 1.5px solid var(--chat-primary);
  color: var(--chat-primary-dark);
  font-size: 13px;
  font-weight: 600;
  padding: 8px 14px;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
  line-height: 1.35;
  box-shadow: 0 1px 4px rgba(60, 179, 113, 0.1);
  display: inline-block;
}

.quick-reply-chip:hover, .quick-reply-chip:active {
  background: var(--chat-primary);
  color: #FFFFFF;
  transform: scale(0.98);
}

/* Input Bar */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.chat-text-input {
  flex: 1;
  height: 40px;
  padding: 0 14px;
  border: 1px solid var(--chat-border);
  border-radius: 20px;
  font-size: 13.5px;
  background: #F8FAF7;
  outline: none;
  font-family: inherit;
  transition: border-color 0.2s;
}

.chat-text-input:focus {
  border-color: var(--chat-primary);
  background: #FFFFFF;
}

.btn-send-chat {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: var(--chat-primary);
  color: #FFFFFF;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  transition: all 0.2s;
  flex-shrink: 0;
}

.btn-send-chat:hover {
  background: var(--chat-primary-dark);
  transform: scale(1.05);
}

/* ==========================================================================
   Pharma Cosmetics - AI Deliberate Scanning Overlay & Inline Clinical Dashboard
   ========================================================================== */

/* Scanning Overlay */
.pc-skin-scanning-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 27, 19, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.pc-skin-scanning-overlay[hidden] {
  display: none !important;
}

.pc-scanning-card {
  background: #ffffff;
  border-radius: 24px;
  padding: 32px 28px;
  max-width: 440px;
  width: 100%;
  text-align: center;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
  animation: scanModalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes scanModalPop {
  from { opacity: 0; transform: scale(0.92) translateY(12px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.pc-scanning-radar-pulse {
  position: relative;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18px;
}

.pc-pulse-ring, .pc-pulse-ring-delay {
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 2px solid #267348;
  opacity: 0;
  animation: pulseScanRing 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

.pc-pulse-ring-delay {
  animation-delay: 0.75s;
}

@keyframes pulseScanRing {
  0% { transform: scale(0.85); opacity: 0.8; }
  100% { transform: scale(1.4); opacity: 0; }
}

.pc-scanning-title {
  color: #0f2318;
  font-size: 1.25rem;
  font-weight: 800;
  margin: 0 0 8px;
}

.pc-scanning-status-text {
  color: #267348;
  font-size: 0.92rem;
  font-weight: 600;
  min-height: 2.6em;
  margin: 0 0 16px;
  line-height: 1.45;
}

.pc-scanning-bar-track {
  width: 100%;
  height: 8px;
  border-radius: 999px;
  background: #e2e8f0;
  overflow: hidden;
  margin-bottom: 8px;
}

.pc-scanning-bar-fill {
  width: 0%;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #3cb371 0%, #267348 100%);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.pc-scanning-percent {
  font-size: 0.85rem;
  font-weight: 800;
  color: #1e5c3a;
  display: block;
  margin-bottom: 12px;
}

.pc-scanning-subhint {
  font-size: 0.78rem;
  color: #94a3b8;
  margin: 0;
}

/* Button Ready Pulse */
.pc-btn-analyze.pc-pulse-ready {
  animation: analyzePulse 1.8s infinite;
}

@keyframes analyzePulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(38, 115, 72, 0.45);
  }
  50% {
    box-shadow: 0 0 0 10px rgba(38, 115, 72, 0);
  }
}

/* Inline Scores Section */
.pc-inline-scores-section {
  margin-top: 28px;
  padding: 24px 20px;
  background: #f8faf8;
  border-radius: 18px;
  border: 1px solid #edf2ef;
}

.pc-inline-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  flex-wrap: wrap;
  gap: 8px;
}

.pc-inline-section-heading {
  color: #0f2318;
  font-size: 1.12rem;
  font-weight: 800;
  margin: 0;
}

.pc-inline-section-badge {
  font-size: 0.75rem;
  font-weight: 700;
  color: #267348;
  background: #e8f5ee;
  padding: 3px 10px;
  border-radius: 999px;
}

.pc-inline-scores-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
}

.pc-inline-score-card {
  background: #ffffff;
  border-radius: 14px;
  padding: 14px 12px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.pc-inline-score-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05);
}

.pc-score-card-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 8px;
}

.pc-score-name {
  font-size: 0.8rem;
  font-weight: 700;
  color: #264a36;
  line-height: 1.25;
  min-height: 2em;
}

.pc-score-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
  display: inline-block;
  align-self: flex-start;
}

.pc-score-badge.is-good {
  background: #dcfce7;
  color: #15803d;
}

.pc-score-badge.is-fair {
  background: #fef9c3;
  color: #854d0e;
}

.pc-score-badge.is-attention {
  background: #fee2e2;
  color: #b91c1c;
}

.pc-score-main {
  display: flex;
  align-items: baseline;
  gap: 2px;
  margin-bottom: 8px;
}

.pc-score-number {
  font-size: 1.55rem;
  font-weight: 900;
  color: #0f2318;
  line-height: 1;
}

.pc-score-unit {
  font-size: 0.72rem;
  color: #94a3b8;
  font-weight: 600;
}

.pc-score-bar-track {
  height: 5px;
  border-radius: 999px;
  background: #f1f5f9;
  overflow: hidden;
}

.pc-score-bar-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.6s ease;
}

.pc-score-bar-fill.is-good {
  background: #22c55e;
}

.pc-score-bar-fill.is-fair {
  background: #eab308;
}

.pc-score-bar-fill.is-attention {
  background: #ef4444;
}

.pc-inline-meta-row {
  display: flex;
  gap: 12px;
  margin-top: 14px;
  flex-wrap: wrap;
}

.pc-inline-meta-chip {
  background: #ffffff;
  border: 1px solid #d1fae5;
  border-radius: 10px;
  padding: 6px 14px;
  font-size: 0.82rem;
  color: #1e5c3a;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.pc-meta-label {
  color: #64748b;
}

.pc-meta-val {
  font-weight: 700;
  color: #0f2318;
}

/* Inline Radar Section */
.pc-inline-radar-section {
  margin-top: 24px;
  padding: 20px;
  background: #ffffff;
  border-radius: 18px;
  border: 1px solid #edf2ef;
}

.pc-inline-radar-box {
  max-width: 480px;
  margin: 0 auto;
  text-align: center;
}

.pc-radar-heading {
  color: #0f2318;
  font-size: 1.05rem;
  font-weight: 800;
  margin: 0 0 10px;
}

.pc-radar-caption {
  margin-top: 10px;
  font-size: 0.78rem;
  color: #64748b;
  line-height: 1.5;
}

/* Inline Regimen Section */
.pc-inline-regimen-section {
  margin-top: 24px;
  padding: 24px 20px;
  background: #f8faf8;
  border-radius: 18px;
  border: 1px solid #edf2ef;
}

.pc-inline-regimen-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.pc-regimen-stage-card {
  background: #ffffff;
  border-radius: 14px;
  padding: 18px 16px;
  border: 1px solid #e2e8f0;
  display: flex;
  flex-direction: column;
}

.pc-stage-badge {
  font-size: 0.7rem;
  font-weight: 800;
  color: #1e5c3a;
  background: #e8f5ee;
  padding: 2px 8px;
  border-radius: 6px;
  display: inline-block;
  align-self: flex-start;
  margin-bottom: 8px;
}

.pc-stage-title {
  color: #0f2318;
  font-size: 0.95rem;
  font-weight: 800;
  margin: 0 0 6px;
}

.pc-stage-desc {
  color: #52655b;
  font-size: 0.82rem;
  line-height: 1.55;
  margin-bottom: 14px;
  flex: 1;
}

.pc-regimen-product-box {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px dashed #e2e8f0;
}

.pc-regimen-prod-label {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 6px;
}

.pc-regimen-prod-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  font-weight: 700;
  color: #267348;
  text-decoration: none;
  background: #edf7f1;
  padding: 6px 10px;
  border-radius: 8px;
  line-height: 1.35;
  transition: all 0.2s ease;
}

.pc-regimen-prod-link:hover {
  background: #267348;
  color: #ffffff;
}

/* Actions Bar at Footer of Report */
.pc-report-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
  flex-wrap: wrap;
}

.pc-btn-rescan {
  border: 1.5px solid #d1fae5;
  background: #ffffff;
  color: #1e6b42;
}

.pc-btn-rescan:hover {
  background: #edf7f1;
}

.pc-btn-zalo-doctor {
  background: #0068ff !important;
  border-color: #0068ff !important;
  color: #ffffff !important;
  text-decoration: none;
}

.pc-btn-zalo-doctor:hover {
  background: #0056d6 !important;
  border-color: #0056d6 !important;
}

/* ==========================================================================
   Pharma Cosmetics - Clinical Assessment Card Styling (Zone-by-Zone Insights)
   ========================================================================== */

.pc-inline-assessment-section {
  margin-top: 24px;
  padding: 24px 22px;
  background: #ffffff;
  border-radius: 20px;
  border: 1.5px solid #d1fae5;
  box-shadow: 0 4px 18px rgba(38, 115, 72, 0.06);
}

.pc-assessment-main-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 18px;
  border-bottom: 1px solid #edf2ef;
  gap: 16px;
  flex-wrap: wrap;
}

.pc-assessment-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #267348;
  background: #e8f5ee;
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 6px;
}

.pc-assessment-skin-type {
  color: #0f2318;
  font-size: 1.45rem;
  font-weight: 800;
  margin: 0;
  letter-spacing: -0.01em;
}

.pc-assessment-score-badge {
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 14px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.pc-overall-label {
  font-size: 0.82rem;
  color: #4b6354;
  font-weight: 600;
}

.pc-overall-score {
  font-size: 1.35rem;
  font-weight: 900;
  color: #15803d;
}

.pc-overall-status {
  font-size: 0.82rem;
  color: #166534;
  font-weight: 700;
}

/* 4 Zones Grid */
.pc-assessment-zones-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 20px 0 16px;
}

.pc-zone-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #f8faf8;
  border-radius: 14px;
  padding: 14px 14px;
  border: 1px solid #edf2ef;
  transition: all 0.2s ease;
}

.pc-zone-item:hover {
  background: #f1f7f3;
  border-color: #d1fae5;
  transform: translateY(-1px);
}

.pc-zone-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pc-zone-content {
  flex: 1;
}

.pc-zone-name {
  display: block;
  font-size: 0.86rem;
  font-weight: 700;
  color: #0f2318;
  margin-bottom: 4px;
}

.pc-zone-desc {
  font-size: 0.8rem;
  color: #52655b;
  line-height: 1.45;
  margin: 0;
}

/* Advice Box */
.pc-assessment-advice-box {
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border: 1px solid #a7f3d0;
  border-radius: 14px;
  padding: 14px 16px;
}

.pc-advice-header {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #166534;
  font-size: 0.85rem;
  font-weight: 800;
  margin-bottom: 6px;
}

.pc-advice-body {
  font-size: 0.82rem;
  color: #1f4e38;
  line-height: 1.55;
  margin: 0;
}

@media (max-width: 860px) {
  .pc-inline-scores-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .pc-inline-regimen-grid {
    grid-template-columns: 1fr;
  }
  .pc-assessment-zones-grid {
    grid-template-columns: 1fr;
  }
  .pc-report-actions {
    flex-direction: column;
    align-items: stretch;
  }
  .pc-report-actions > * {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .pc-inline-scores-grid {
    grid-template-columns: 1fr;
  }
}
