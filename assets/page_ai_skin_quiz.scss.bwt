.pc-quiz-wrap {
  min-height: 100vh;
  padding: 32px 0 48px;
  background: var(--mainColorLight);
}
.pc-quiz-container { max-width: 480px; }

.pc-quiz-intro { text-align: center; padding-top: 24px; }
.pc-quiz-intro .pc-section-title { margin: 16px 0 12px; font-size: var(--fs-xl); }
.pc-quiz-intro-desc { color: var(--textSub); margin-bottom: 24px; }
.pc-quiz-start-btn,
.pc-cg-cta-btn {
  display: inline-block;
  padding: 14px 32px;
  background: var(--mainColor);
  color: #fff;
  border: none;
  border-radius: 50px;
  font-weight: 700;
  font-size: var(--fs-base);
  cursor: pointer;
  text-decoration: none;
}

.pc-quiz-progress {
  height: 6px;
  background: var(--lineColor);
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 24px;
}
.pc-quiz-progress-bar {
  height: 100%;
  width: 0%;
  background: var(--mainColor);
  transition: width .3s ease;
}
.pc-quiz-question-text {
  font-size: var(--fs-lg);
  color: var(--textBody);
  margin-bottom: 20px;
  text-align: center;
}
.pc-quiz-options { display: flex; flex-direction: column; gap: 12px; }
.pc-quiz-option-btn {
  padding: 14px 18px;
  background: #fff;
  border: 1px solid var(--lineColor);
  border-radius: 12px;
  text-align: left;
  font-size: var(--fs-sm);
  color: var(--textBody);
  cursor: pointer;
  transition: border-color .2s ease, background .2s ease;
}
.pc-quiz-option-btn:hover,
.pc-quiz-option-btn:active {
  border-color: var(--mainColor);
  background: var(--mainColorLight);
}

.pc-quiz-result { text-align: center; padding-top: 24px; }
.pc-quiz-result .pc-section-title { margin: 12px 0 20px; }
.pc-quiz-recommend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
}
.pc-quiz-recommend-tag {
  padding: 6px 14px;
  border-radius: 50px;
  background: rgba(60, 179, 113, 0.1);
  color: var(--mainColorDark);
  font-size: var(--fs-xs);
  font-weight: 700;
}
.pc-quiz-retry-btn {
  display: block;
  margin: 16px auto 0;
  background: none;
  border: none;
  color: var(--textSub);
  text-decoration: underline;
  cursor: pointer;
  font-size: var(--fs-sm);
}
