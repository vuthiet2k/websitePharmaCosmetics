/* ==========================================================================
   Pharma Cosmetics - AI Skin Diagnostic Conversational Chat Interface
   Style: Live Clinical Chat (Zalo / Messenger / Medical Assistant Concept)
   ========================================================================== */

:root {
  --chat-primary: #3CB371;
  --chat-primary-dark: #267348;
  --chat-emerald: #166B55;
  --chat-pine: #0F2318;
  --chat-bg-app: #F4F7F5;
  --chat-bubble-bot: #FFFFFF;
  --chat-text-dark: #0F2318;
  --chat-text-muted: #64748B;
  --chat-border: #E2E8F0;
  --chat-font-sans: 'Montserrat', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --chat-font-display: 'Montserrat', system-ui, sans-serif;
}

.ai-skin-chat-app, .ai-skin-chat-app *, .ai-skin-chat-app *::before, .ai-skin-chat-app *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* App Outer Shell (Centered on desktop, full screen on mobile) */
.ai-skin-chat-app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  margin: 24px auto;
  font-family: var(--chat-font-sans);
  color: var(--chat-text-dark);
  background: #FFFFFF;
  box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

/* ==========================================================================
   Pharma Cosmetics - AI Skin Camera & Diagnostic UI (Mockup PharmaCosmetics (1).svg)
   Style: Widescreen Clinical Card, 2-Column Responsive Grid, Floating Controls
   ========================================================================== */

.pc-skin-mode-tabs {
  margin: 32px auto 16px;
  display: flex;
  gap: 12px;
  font-family: var(--chat-font-sans);
}

.pc-skin-mode-tabs button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 46px;
  padding: 8px 22px;
  border-radius: 9999px;
  border: 1.5px solid #d1fae5;
  background: #ffffff;
  color: #164834;
  font: inherit;
  font-weight: 700;
  font-size: 0.92rem;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.pc-skin-mode-tabs button .pc-mode-tab-icon {
  width: 18px;
  height: 18px;
  stroke: currentColor;
  flex-shrink: 0;
}

.pc-skin-mode-tabs button:hover {
  background: #f4fbf7;
  border-color: #3cb371;
  transform: translateY(-1px);
}

.pc-skin-mode-tabs button[aria-selected="true"] {
  background: #205a3b;
  border-color: #205a3b;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(32, 90, 59, 0.28);
}

.pc-skin-mode-tabs button[aria-selected="true"]:hover {
  background: #17472e;
  border-color: #17472e;
}

/* MAIN CARD CONTAINER */
.pc-skin-scan {
  margin: 0 auto 48px;
  padding: 36px 36px 32px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 20px 50px rgba(15, 35, 24, 0.06);
  font-family: var(--chat-font-sans);
  position: relative;
  overflow: hidden;
}

.pc-skin-scan[hidden] {
  display: none;
}

/* 2-COLUMN LAYOUT */
.pc-skin-scan__layout {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 36px;
  align-items: stretch;
}

/* LEFT COLUMN: Medical Info & Features */
.pc-skin-scan__col-info {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  position: relative;
  padding-bottom: 24px;
}

.pc-skin-scan__eyebrow {
  margin: 0 0 10px;
  color: #267348;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pc-skin-scan__intro h2 {
  margin: 0 0 16px;
  color: #0f2318;
  font-size: clamp(1.65rem, 2.5vw, 2.15rem);
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.pc-skin-scan__desc {
  margin: 0 0 28px;
  color: #52655b;
  font-size: 0.92rem;
  line-height: 1.62;
}

/* 3 Feature items */
.pc-skin-features {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 28px;
}

.pc-skin-feature-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 14px;
  background: #f8faf8;
  border-radius: 14px;
  border: 1px solid #edf2ef;
  transition: all 0.2s ease;
}

.pc-skin-feature-item:hover {
  background: #f1f7f3;
  border-color: #d1fae5;
  transform: translateX(3px);
}

.pc-skin-feature-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pc-skin-feature-title {
  font-weight: 700;
  font-size: 0.95rem;
  color: #0f2318;
  margin-bottom: 2px;
}

.pc-skin-feature-subtitle {
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.35;
}

.pc-skin-leaf-accent {
  position: absolute;
  left: -8px;
  bottom: -8px;
  opacity: 0.9;
  pointer-events: none;
}

/* RIGHT COLUMN: Camera Viewfinder Stage */
.pc-skin-scan__col-stage {
  display: flex;
  flex-direction: column;
}

.pc-skin-scan__stage {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  min-height: 380px;
  border-radius: 20px;
  background: #0c2117;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.45);
}

.pc-skin-scan__stage video,
.pc-skin-scan__stage canvas {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}

.pc-skin-scan__stage canvas {
  pointer-events: none;
  z-index: 2;
}

/* Standby Overlay */
.pc-skin-standby {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 24px;
  text-align: center;
  z-index: 5;
  background: radial-gradient(circle at center, #153828 0%, #0a1b13 100%);
  transition: opacity 0.35s ease, visibility 0.35s ease;
}

.pc-skin-standby__ring-icon {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  border: 2px solid rgba(45, 212, 191, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2dd4bf;
  margin-bottom: 18px;
  box-shadow: 0 0 28px rgba(45, 212, 191, 0.28);
  background: rgba(45, 212, 191, 0.08);
  animation: pulseCameraRing 2.4s infinite ease-in-out;
}

@keyframes pulseCameraRing {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 24px rgba(45, 212, 191, 0.25);
  }
  50% {
    transform: scale(1.04);
    box-shadow: 0 0 36px rgba(45, 212, 191, 0.45);
  }
}

.pc-skin-standby__title {
  color: #ffffff;
  font-size: 1.18rem;
  font-weight: 700;
  margin: 0 0 8px;
  letter-spacing: -0.01em;
}

.pc-skin-standby__subtitle {
  color: #94a3b8;
  font-size: 0.88rem;
  margin: 0 0 24px;
  max-width: 300px;
  line-height: 1.5;
}

.pc-btn-start-pill {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 44px;
  padding: 10px 26px;
  border-radius: 9999px;
  background: #267348;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(38, 115, 72, 0.38);
  transition: all 0.2s ease;
}

.pc-btn-start-pill:hover {
  background: #1e5c3a;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(38, 115, 72, 0.48);
}

/* Steps inside Viewfinder */
.pc-skin-scan__steps {
  position: absolute;
  bottom: 12px;
  left: 14px;
  right: 14px;
  z-index: 6;
  display: flex;
  justify-content: space-around;
  gap: 8px;
  margin: 0;
  padding: 6px 10px;
  list-style: none;
  background: rgba(10, 27, 19, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.pc-skin-scan__steps li {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 9999px;
  color: #94a3b8;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.25s ease;
  user-select: none;
}

.pc-skin-scan__steps li .pc-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  color: inherit;
}

.pc-skin-scan__steps li.is-active {
  background: rgba(38, 115, 72, 0.85);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.pc-skin-scan__steps li.is-active .pc-step-dot {
  background: #ffffff;
  color: #267348;
}

.pc-skin-scan__steps li.is-complete {
  color: #34d399;
}

.pc-skin-scan__steps li.is-complete .pc-step-dot {
  background: #34d399;
  color: #0c2117;
}

/* Floating Status overlay */
.pc-skin-scan__status {
  position: absolute;
  top: 14px;
  left: 14px;
  right: 68px;
  margin: 0;
  padding: 8px 14px;
  border-radius: 12px;
  background: rgba(10, 27, 19, 0.85);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 0.84rem;
  z-index: 6;
  line-height: 1.4;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.pc-skin-scan__status[data-skin-mode-unavailable] {
  top: auto;
  bottom: 60px;
  right: 14px;
  background: rgba(185, 28, 28, 0.9);
}

/* Floating Flip Switch */
.pc-skin-scan__flip-btn {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 7;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(10, 27, 19, 0.85);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.pc-skin-scan__flip-btn:hover {
  background: rgba(38, 115, 72, 0.9);
  transform: rotate(180deg);
}

.pc-skin-scan__flip-btn[hidden] {
  display: none !important;
}

/* Shutter Live Stream Controls */
.pc-skin-stream-controls {
  position: absolute;
  bottom: 60px;
  left: 0;
  right: 0;
  display: none;
  justify-content: center;
  z-index: 7;
  pointer-events: none;
}

.pc-skin-scan.is-streaming .pc-skin-standby {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.pc-skin-scan.is-streaming .pc-skin-stream-controls {
  display: flex;
}

.pc-btn-shutter {
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 46px;
  padding: 10px 24px;
  border-radius: 9999px;
  background: #22a05d;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.92rem;
  border: 2px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
  cursor: pointer;
  transition: all 0.2s ease;
}

.pc-btn-shutter:hover:not(:disabled) {
  background: #1e8e52;
  transform: scale(1.03);
}

.pc-btn-shutter:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  filter: grayscale(0.4);
}

.pc-shutter-outer-ring {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-shutter-inner-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ffffff;
}

/* Shutter Flash Animation */
.pc-skin-scan__stage.pc-shutter-flash::after {
  content: '';
  position: absolute;
  inset: 0;
  background: #ffffff;
  z-index: 10;
  pointer-events: none;
  animation: shutterFlashFade 0.22s ease-out forwards;
}

@keyframes shutterFlashFade {
  0% { opacity: 0.85; }
  100% { opacity: 0; }
}

/* Bottom Bar - Full Width col-12 Row below 2-Col Layout */
.pc-skin-scan__bottom-bar {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1.5px solid #edf2ef;
  width: 100%;
}

.pc-skin-scan__actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  max-width: 580px;
  margin: 0 auto;
}

.pc-skin-scan__primary,
.pc-skin-scan__secondary {
  min-height: 46px;
  padding: 10px 18px;
  border-radius: 12px;
  font: inherit;
  font-weight: 700;
  font-size: 0.92rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.pc-skin-scan__primary {
  border: 1.5px solid #267348;
  background: #267348;
  color: #ffffff;
}

.pc-skin-scan__primary:hover:not(:disabled) {
  background: #1e5c3a;
  border-color: #1e5c3a;
  transform: translateY(-1px);
}

.pc-skin-scan__primary:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.pc-skin-scan__secondary {
  border: 1.5px solid #d1fae5;
  background: #f8faf8;
  color: #1e6b42;
}

.pc-skin-scan__secondary:hover:not(:disabled) {
  background: #edf7f1;
  border-color: #3cb371;
  transform: translateY(-1px);
}

.pc-btn-upload-trigger,
.pc-btn-analyze {
  flex: 1;
}

/* Clinical 3-Angle Upload Dropzone Cards */
.pc-skin-scan__upload {
  margin-top: 20px;
  width: 100%;
}

.pc-skin-scan__upload[hidden] {
  display: none !important;
}

.pc-dropzone-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  width: 100%;
}

.pc-upload-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 22px 18px;
  border: 1.5px dashed #b8c7c0;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  position: relative;
}

.pc-upload-card:hover {
  border-color: #267348;
  background: #fbfdfc;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(38, 115, 72, 0.12);
}

.pc-upload-card.has-file {
  border-color: #34d399;
  border-style: solid;
  background: #f0fdf4;
}

.pc-dropzone-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #e8f5ee;
  color: #267348;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
}

.pc-upload-label {
  display: block;
  font-weight: 700;
  font-size: 0.95rem;
  color: #0f2318;
  margin-bottom: 4px;
}

.pc-dropzone-hint {
  display: block;
  font-size: 0.8rem;
  color: #64748b;
  margin-bottom: 12px;
}

.pc-upload-card input[type="file"] {
  width: 100%;
  font-size: 0.8rem;
  color: #52655b;
  cursor: pointer;
}

/* Report Section */
.pc-skin-scan__report {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1.5px solid #edf2ef;
}

.pc-skin-scan__report[hidden] {
  display: none !important;
}

.pc-report-header {
  margin-bottom: 16px;
}

.pc-report-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #267348;
  background: #edf7f1;
  padding: 4px 10px;
  border-radius: 999px;
  margin-bottom: 8px;
}

.pc-skin-scan__report h3 {
  margin: 0 0 8px;
  color: #0f2318;
  font-size: 1.25rem;
  font-weight: 700;
}

.pc-skin-scan__report p {
  color: #52655b;
  font-size: 0.9rem;
}

.pc-skin-scan__layers {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
  margin: 14px 0 20px;
  padding: 12px 16px;
  border: 1px solid #d7e4dc;
  border-radius: 12px;
  background: #fbfdfc;
}

.pc-skin-scan__layers legend {
  padding: 0 6px;
  color: #164834;
  font-weight: 700;
  font-size: 0.85rem;
}

.pc-skin-scan__layers label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #294238;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
}

.pc-skin-scan__previews {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.pc-skin-scan__previews figure {
  min-width: 0;
  margin: 0;
}

.pc-skin-scan__previews figcaption {
  margin-bottom: 6px;
  color: #294238;
  font-size: 0.84rem;
  font-weight: 700;
  text-align: center;
}

.pc-skin-scan__previews canvas {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 12px;
  background: #0c2117;
  border: 1px solid #d7e4dc;
}

.pc-report-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20px;
}

.pc-skin-scan__report-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  border-radius: 12px;
  padding: 12px 24px;
}

.pc-skin-scan__disclaimer {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid #edf2ef;
  color: #64748b;
  font-size: 0.82rem;
  line-height: 1.55;
  text-align: center;
}

/* Radar chart */
.pc-skin-radar {
  max-width: 440px;
  margin: 18px auto;
  text-align: center;
}

.pc-skin-radar[hidden] {
  display: none;
}

.pc-skin-radar h3 {
  margin: 0 0 8px;
  color: #0f2318;
  font-size: 1.1rem;
}

.pc-skin-radar svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

.pc-skin-radar__grid polygon {
  fill: none;
  stroke: #d7e4dc;
  stroke-width: 1;
}

.pc-skin-radar__grid path {
  fill: none;
  stroke: #b8c7c0;
  stroke-width: 1;
}

.pc-skin-radar__area {
  fill: rgba(38, 115, 72, .22);
  stroke: #267348;
  stroke-width: 2.5;
  stroke-linejoin: round;
}

.pc-skin-radar__labels {
  fill: #294238;
  font-size: 10px;
}

.pc-skin-radar figcaption {
  color: #52655b;
  font-size: 0.8rem;
  line-height: 1.5;
}

/* RESPONSIVE BREAKPOINTS */
@media (max-width: 860px) {
  .pc-skin-scan__layout {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .pc-skin-scan {
    padding: 28px 20px;
    margin: 0 auto 32px;
  }

  .pc-skin-mode-tabs {
    margin: 20px auto 12px;
  }

  .pc-dropzone-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .pc-skin-scan__actions {
    max-width: 100%;
    flex-direction: column;
  }

  .pc-skin-scan__actions > * {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .pc-skin-scan {
    border-radius: 0;
    border-left: none;
    border-right: none;
    padding: 20px 16px;
  }

  .pc-skin-scan__steps,
  .pc-skin-scan__upload,
  .pc-skin-scan__previews {
    grid-template-columns: 1fr;
  }

  .pc-skin-scan__steps {
    border-radius: 12px;
    flex-direction: column;
    gap: 4px;
  }

  .pc-skin-mode-tabs {
    flex-direction: column;
  }

  .pc-skin-mode-tabs button {
    width: 100%;
    justify-content: center;
  }
}

/* ==========================================================================
   Pharma Cosmetics - Fullscreen Immersive Camera & Dual State Separation
   ========================================================================== */

/* Fullscreen Immersive Viewfinder Stage */
.pc-skin-scan.is-camera-fullscreen .pc-skin-scan__stage {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  height: 100dvh !important;
  max-width: 100% !important;
  aspect-ratio: auto !important;
  min-height: 100% !important;
  border-radius: 0 !important;
  z-index: 99999 !important;
  background: radial-gradient(circle at center, #0e2a1d 0%, #05120c 100%) !important;
  box-shadow: none !important;
  padding: 0 !important;
  animation: fadeInCameraStage 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInCameraStage {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

.pc-skin-scan.is-camera-fullscreen .pc-skin-scan__stage video,
.pc-skin-scan.is-camera-fullscreen .pc-skin-scan__stage canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

body.pc-camera-fullscreen-active {
  overflow: hidden !important;
}

.pc-camera-modal-close {
  position: absolute;
  top: 20px;
  right: 76px;
  z-index: 100002;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(10, 27, 19, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.pc-camera-modal-close:hover {
  background: rgba(220, 38, 38, 0.9);
  border-color: rgba(220, 38, 38, 0.9);
  transform: rotate(90deg);
}

.pc-camera-modal-close[hidden] {
  display: none !important;
}

/* Review 3 Angles Stage */
.pc-skin-review-stage[hidden] {
  display: none !important;
}

.pc-skin-review-stage {
  margin-top: 28px;
  padding: 28px;
  border-radius: 20px;
  background: #ffffff;
  border: 1.5px solid #d1fae5;
  box-shadow: 0 10px 30px rgba(38, 115, 72, 0.08);
  animation: fadeInReviewStage 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInReviewStage {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.pc-review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid #edf2ef;
  flex-wrap: wrap;
}

.pc-review-badge-top {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
  background: #e8f5ee;
  color: #267348;
  border: 1px solid #c6f6d5;
}

.pc-review-title {
  margin: 8px 0 4px;
  font-size: 1.18rem;
  font-weight: 800;
  color: #0f2318;
}

.pc-review-subtitle {
  margin: 0;
  font-size: 0.86rem;
  color: #52655b;
  line-height: 1.5;
}

.pc-review-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0 24px;
}

.pc-review-card {
  background: #f8faf8;
  border-radius: 16px;
  border: 1.5px solid #e2e8f0;
  overflow: hidden;
  transition: all 0.25s ease;
}

.pc-review-card:hover {
  border-color: #34d399;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(38, 115, 72, 0.1);
}

.pc-review-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #0f2318;
  overflow: hidden;
}

.pc-review-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pc-review-chip-status {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 10.5px;
  font-weight: 700;
  background: #267348;
  color: #ffffff;
  padding: 3px 8px;
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
}

.pc-review-card-footer {
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-top: 1px solid #edf2ef;
}

.pc-review-card-meta strong {
  display: block;
  font-size: 0.88rem;
  color: #0f2318;
}

.pc-review-card-meta span {
  display: block;
  font-size: 0.78rem;
  color: #64748b;
}

.pc-btn-retake-angle {
  font-size: 0.82rem;
  font-weight: 700;
  color: #267348;
  background: none;
  border: none;
  cursor: pointer;
  text-decoration: underline;
  padding: 4px 6px;
}

.pc-btn-retake-angle:hover {
  color: #1e5c3a;
}

.pc-review-action-wrap {
  display: flex;
  justify-content: center;
  margin-top: 8px;
}

.pc-btn-analyze-large {
  min-width: 320px;
  font-size: 1.02rem !important;
  padding: 14px 32px !important;
  border-radius: 9999px !important;
  box-shadow: 0 8px 24px rgba(38, 115, 72, 0.35) !important;
}

.pc-btn-analyze-large:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 12px 30px rgba(38, 115, 72, 0.45) !important;
}

/* Report Session View & Navbar */
.pc-report-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  margin-bottom: 24px;
  background: #f0fdf4;
  border: 1.5px solid #bbf7d0;
  border-radius: 16px;
  flex-wrap: wrap;
}

.pc-report-nav-info h3 {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 800;
  color: #0f2318;
}

.pc-btn-restart-scan {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 18px;
  border-radius: 12px;
  background: #267348;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.86rem;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(38, 115, 72, 0.25);
}

.pc-btn-restart-scan:hover {
  background: #1e5c3a;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(38, 115, 72, 0.35);
}

@media (max-width: 768px) {
  .pc-review-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .pc-review-header {
    flex-direction: column;
    align-items: stretch;
  }
  .pc-review-action-wrap .pc-btn-analyze-large {
    width: 100%;
    min-width: unset;
  }
  .pc-report-nav-bar {
    flex-direction: column;
    align-items: stretch;
  }
}
