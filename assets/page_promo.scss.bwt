.page-khuyen-mai {
	position: relative;
	margin-top: 15px;
	.count-down{
		display: block;
		font-size: var(--fs-sm);
		padding: 0;
		text-align: center;
		margin-bottom: 30px;
		margin-top: 30px;
		.title{
			font-size: var(--fs-3xl);
			display: block;
			font-weight: 700;
			line-height: 1.3;
			color: red;
			margin-bottom: 10px;
		}
	}
	.timer-view{
		display: inline-block;
		text-align: left;
		.block-timer {
			width: 45px;
			height: 45px;
			background: var(--subColor);
			border-radius: 5px;
			display: inline-block;
			padding: 5px 0px;
			margin-right: 5px;
			text-align: center;
			&:last-child {
				margin-right: 0px;
			}
			p {
				display: block;
				font-weight: 500;
				color: #fff;
				font-size: 1rem;
				margin: 0;
				line-height: 1.2;
				margin-bottom: 0px;
			}
			span {
				display: block;
				color: #fff;
				font-size: 0.875rem;
				font-weight: 400;
				line-height: 1.2;
			}
		}
	}
	.lof-labelexpired {
		color: #000;
	}
	.page-section {
		padding-top: 30px;
		margin-bottom: 20px;
	}


}
@mixin controlswiper(){
	.swiper-pagination-bullets{
		text-align: center;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 4px;
		.swiper-pagination-bullet{
			box-shadow: none;
			outline: 0;
			width: 10px;
			height: 10px;
			border: 1px solid #ddd;
			border-radius: 50%;
			background: rgba(255, 255, 255 ,0.2);
			padding: 0;
			font-size: 0;
			opacity: 1;
			&.swiper-pagination-bullet-active{
				transition: all .2s;
				background: var(--mainColor);
			}
		}
	}
	.swiper-button-next{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		right: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(32px , -50%);
		-ms-transform: translate(32px, -50%);
		transform: translate(32px, -50%);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%);
		transform: translateY(-50%);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	.swiper-button-prev{
		font-size: 0;
		line-height: 0;
		position: absolute;
		top: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		cursor: pointer;
		color: var(--mainColor);
		outline: none;
		border: 0px;
		background: transparent;
		text-align: center;
		z-index: 2;
		left: 10px;
		opacity: 0;
		-webkit-transition: all .25s ease;
		transition: all .25s ease;
		-webkit-transform: translate(-32px, -50%) rotate(180deg);
		-ms-transform: translate(-32px, -50%) rotate(180deg);
		transform: translate(-32px, -50%) rotate(180deg);
		margin-top: 0px;
		background-color: var(--bgBodySub);
		border-radius: 5px;
		visibility: visible;
		opacity: 1;
		-webkit-transform: translateY(-50%) rotate(180deg);
		transform: translateY(-50%) rotate(180deg);
		svg {
			width: 100%;
			height: 100%;
			path {
				stroke: var(--mainColor);
			}
		}
		&:after {
			display: none
		}
		&:hover {
			background-color: var(--subColor);
			svg {
				path {
					stroke: #fff;
				}
			}
		}
		@media (max-width: 767px) {
			display: none;
		}
	}
	@media(max-width: 767px) {
		.swiper-button-next,.swiper-button-prev{
			width: 25px;
			height: 25px;
			line-height: 25px;
			&:after {
				font-size: 0.75rem;
			}
		}
	}
	.swiper-button-lock {
		display: none !important;
	}
	.swiper-button-disabled{
		opacity: 0.35;
	}
}
.section_flash_product{
	margin-bottom: 40px;
	@media (max-width: 767px) {
		margin-bottom: 30px;
	}
}
.bg-thumb {
	padding: 20px;
	border-radius: 10px;
	background-color:var(--mainColor);
	@media (max-width: 767px) {
		padding: 14px;
	}
	.title-index {
		display: block;
		margin-bottom: 20px;
		@media (max-width: 767px) {
			margin-bottom: 14px;
		}
	}
	.swiper_pro {
		@include controlswiper();
		.item_product_main {
			padding-bottom: 0px;
		}
		.swiper-slide  {
			height: auto !important;
		}
	}

	@media (max-width: 767px) {
		.swiper_pro {
			overflow: hidden;
			.alert.alert-warning {
				margin: 0 20px;
			}
			.swiper-button-next, .swiper-button-prev{
				display: block !important;
			}
		} 
	}
	.view-more {
		text-align: center;
		display: block !important;
		margin-top: 20px;
		@media (max-width: 767px) {
			margin-top: 14px;
		}
		.flexbtn:hover, .flexbtn:focus {
			background-color: var(--subColor);
			opacity: 0.8;
		}
	}
}
@media (min-width: 1025px) {
	.col-xl-20 {
		-ms-flex: 0 0 20%;
		flex: 0 0 20%;
		max-width: 20%;
	}
}