/* ==========================================================================
   mobile-ui.js — Header compact-on-scroll + Search overlay + lịch sử tìm kiếm
   Chỉ tác động ở mobile (≤991px). Cấu hình bật/tắt qua settings.
   ========================================================================== */
(function () {
  'use strict';

  var CFG = {
    /* 2026-10-07: đọc cấu hình lúc chạy (window.PC_CFG, snippets/theme_runtime_config.bwt) — Sapo không render Liquid trong asset */
    compact: !!(window.PC_CFG || {}).mobileCompact,
    smart:   !!(window.PC_CFG || {}).searchSmart,
    popup:   true
  };

  var MOBILE_BP  = 991;
  var RECENT_KEY = 'pc_recent_search';
  var RECENT_MAX = 8;

  function isMobile() { return window.innerWidth <= MOBILE_BP; }

  /* ── 1. Header thu gọn khi cuộn ───────────────────────────────────────── */
  function initCompact() {
    if (!CFG.compact) return;
    var header = document.querySelector('header.header');
    if (!header) return;

    var ticking   = false;
    var THRESHOLD = 60;

    function update() {
      if (isMobile() && window.scrollY > THRESHOLD) {
        header.classList.add('mb-compact');
      } else {
        header.classList.remove('mb-compact');
      }
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    update();
  }

  /* ── 2. Lịch sử tìm kiếm (localStorage) ───────────────────────────────── */
  function getRecent() {
    try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); }
    catch (e) { return []; }
  }

  function addRecent(term) {
    term = (term || '').trim();
    if (!term) return;
    var list = getRecent().filter(function (t) {
      return t.toLowerCase() !== term.toLowerCase();
    });
    list.unshift(term);
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, RECENT_MAX))); } catch (e) {}
  }

  function removeRecentAt(idx) {
    var list = getRecent();
    list.splice(idx, 1);
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(list)); } catch (e) {}
  }

  /* ── 3. Render lịch sử tìm kiếm ───────────────────────────────────────── */
  function renderRecent() {
    var section = document.getElementById('mb-recent');
    var listEl  = document.getElementById('mb-recent-list');
    if (!section || !listEl) return;

    var items = getRecent();
    if (!items.length) {
      section.hidden = true;
      listEl.innerHTML = '';
      return;
    }

    section.hidden = false;

    /* M-09: mục dựng từ <template id="mb-recent-tpl"> (class Tailwind nằm trong snippet mobile_search_popup, JS không chứa class) */
    var tpl = document.getElementById('mb-recent-tpl');
    listEl.innerHTML = '';
    items.forEach(function (kw, idx) {
      var li = tpl.content.firstElementChild.cloneNode(true);
      li.querySelector('[data-mb-recent-link]').setAttribute('href', '/search?query=' + encodeURIComponent(kw) + '&type=product');
      li.querySelector('[data-mb-recent-text]').textContent = kw;
      var del = li.querySelector('[data-mb-recent-del]');
      del.setAttribute('data-idx', idx);
      del.setAttribute('aria-label', 'Xóa "' + kw + '"');
      listEl.appendChild(li);
    });

    /* Bind nút xóa từng item — chỉ gắn 1 lần (delegation) */
    if (listEl.getAttribute('data-bound')) return;
    listEl.setAttribute('data-bound', '1');
    listEl.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-mb-recent-del]');
      if (!btn) return;
      e.preventDefault();
      var idx = parseInt(btn.getAttribute('data-idx'), 10);
      if (!isNaN(idx)) { removeRecentAt(idx); renderRecent(); }
    });
  }

  /* ── 4. Search overlay mở / đóng ──────────────────────────────────────── */
  function initPopup() {
    if (!CFG.popup) return;

    var overlay     = document.getElementById('mb-search-popup');
    var openBtn     = document.getElementById('mb-search-open');
    var closeBtn    = document.getElementById('mb-search-close');
    var clearBtn    = document.getElementById('mb-search-clear');
    var input       = document.getElementById('mb-search-input');
    var form        = document.getElementById('mb-search-form');
    var suggestWrap = document.getElementById('mb-suggest-tags');

    if (!overlay || !openBtn) return;

    function updateClearBtn() {
      if (!clearBtn) return;
      clearBtn.hidden = !(input && input.value.length > 0);
    }

    function open() {
      overlay.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('search-overlay-active');
      renderRecent();
      updateClearBtn();
      if (input) { setTimeout(function () { input.focus(); }, 80); }
    }

    function close() {
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('search-overlay-active');
      if (input) input.value = '';
      updateClearBtn();
      var _sr = document.getElementById('mb-smart-results');
      if (_sr) _sr.hidden = true;
    }

    /* Bind trực tiếp + delegation (fallback Sapo cache) */
    openBtn.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);

    document.addEventListener('click', function (e) {
      if (e.target.closest('#mb-search-open, [data-open-search]')) { e.preventDefault(); open(); }
      if (e.target.closest('#mb-search-close')) { close(); }
    });

    /* Clear button — xóa text, reset về trạng thái ban đầu */
    if (input) input.addEventListener('input', updateClearBtn);

    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (input) { input.value = ''; input.focus(); }
        updateClearBtn();
        var _sr = document.getElementById('mb-smart-results');
        if (_sr) _sr.hidden = true;
        var _ls = document.getElementById('mb-list-search');
        if (_ls) _ls.innerHTML = '';
        var _ls2 = document.getElementById('mb-list-search2');
        if (_ls2) _ls2.innerHTML = '';
        renderRecent();
        if (suggestWrap) {
          var _ss = suggestWrap.closest('[data-mb-section]');
          if (_ss) _ss.style.display = '';
        }
      });
    }

    /* Escape key */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) close();
    });

    /* Lưu lịch sử khi submit */
    if (form) {
      form.addEventListener('submit', function () {
        if (input && input.value.trim()) addRecent(input.value.trim());
      });
    }

    /* Lưu lịch sử khi bấm suggest tag */
    if (suggestWrap) {
      suggestWrap.addEventListener('click', function (e) {
        var tag = e.target.closest('[data-mb-tag]');
        if (tag) addRecent(tag.textContent.trim());
      });
    }

    if (CFG.smart) {
    /* ── Smart search AJAX (mobile) ────────────────────────────────────── */
    var smartSection  = document.getElementById('mb-smart-results');
    var mbListSearch  = document.getElementById('mb-list-search');
    var mbListSearch2 = document.getElementById('mb-list-search2');
    var recentSection = document.getElementById('mb-recent');
    var mbTimer = null;

    function clearSmart() {
      if (smartSection)  smartSection.hidden = true;
      if (mbListSearch)  mbListSearch.innerHTML = '';
      if (mbListSearch2) mbListSearch2.innerHTML = '';
    }

    function showContextSections() {
      renderRecent();
      var suggestSection = suggestWrap ? suggestWrap.closest('[data-mb-section]') : null;
      if (suggestSection) suggestSection.style.display = '';
    }

    function hideContextSections() {
      if (recentSection) recentSection.hidden = true;
      var suggestSection = suggestWrap ? suggestWrap.closest('[data-mb-section]') : null;
      if (suggestSection) suggestSection.style.display = 'none';
    }

    function highlightMatch(text, query) {
      if (!query) return text;
      var q = query.replace(/[-[\]{}()*+?.,\\^$|#\s]/g, '\\$&');
      var regex = new RegExp('(' + q + ')', 'gi');
      return text.replace(regex, '<strong class="font-bold text-ink">$1</strong>');
    }

    function buildSuggestionRow(phrase, query) {
      var highlighted = highlightMatch(phrase, query);
      var enc = encodeURIComponent(phrase);
      return '<div class="pc-tiktok-suggest-row flex items-center justify-between min-h-[46px] py-2 px-4 border-b border-line-soft hover:bg-slate-50 transition-colors">'
        + '<a href="/search?query=' + enc + '&type=product" class="flex items-center gap-3 flex-1 min-w-0 text-sm text-slate-700 no-underline">'
        + '<span class="text-slate-400 shrink-0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>'
        + '<span class="truncate">' + highlighted + '</span>'
        + '</a>'
        + '<button type="button" class="pc-tiktok-suggest-fill inline-flex items-center justify-center w-9 h-9 text-slate-400 hover:text-primary cursor-pointer border-0 bg-transparent" data-fill="' + phrase.replace(/"/g, '&quot;') + '" aria-label="Điền vào ô tìm kiếm">'
        + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>'
        + '</button>'
        + '</div>';
    }

    if (input && smartSection && typeof getItemSearch === 'function') {
      input.addEventListener('input', function () {
        clearTimeout(mbTimer);
        var term = (this.value || '').trim();

        if (term.length < 2) {
          clearSmart();
          showContextSections();
          return;
        }

        hideContextSections();

        mbTimer = setTimeout(function () {
          var enc = encodeURIComponent(term);

          getItemSearch(term, 'smartjson').then(function (data) {
            var keys = Object.keys(data || {});
            var html = '';
            if (keys.length > 0) {
              html = '<div class="pc-tiktok-suggestions">';
              var addedPhrases = [];
              keys.forEach(function (k) {
                var p = data[k];
                var namePhrase = p.name ? p.name.trim() : '';
                if (namePhrase && addedPhrases.indexOf(namePhrase.toLowerCase()) === -1) {
                  addedPhrases.push(namePhrase.toLowerCase());
                  html += buildSuggestionRow(namePhrase, term);
                }
              });
              html += '</div>';

              // Thêm khối Xu hướng tìm kiếm bên dưới gợi ý chuẩn TikTok
              html += '<div class="pc-tiktok-trending px-4 pt-5 pb-4 bg-white">'
                + '<div class="flex items-center gap-2 mb-3 text-xs font-bold text-amber-600 uppercase tracking-wider font-sans">'
                + '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>'
                + '<span>Xu hướng tìm kiếm</span>'
                + '</div>'
                + '<div class="flex flex-wrap gap-2 text-xs font-sans">'
                + '<a href="/search?query=Phục%20hồi%20da%20treatment&type=product" class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-brand-tint hover:text-primary transition-colors no-underline">#Phục hồi da treatment</a>'
                + '<a href="/search?query=Kem%20chống%20nắng%20không%20cồn&type=product" class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-brand-tint hover:text-primary transition-colors no-underline">#Kem chống nắng không cồn</a>'
                + '<a href="/search?query=Serum%20HA%20B5&type=product" class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-brand-tint hover:text-primary transition-colors no-underline">#Serum HA B5</a>'
                + '<a href="/search?query=BHA%20trị%20mụn%20ẩn&type=product" class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-brand-tint hover:text-primary transition-colors no-underline">#BHA trị mụn ẩn</a>'
                + '</div>'
                + '</div>';
            } else {
              /* Khối trống gọn dùng chung */
              html = (typeof window.pcSearchEmptyHtml === 'function' && window.pcSearchEmptyHtml(term))
                || '<div class="p-6 text-center text-sm text-slate-500">Không tìm thấy từ khoá phù hợp</div>';
            }
            if (mbListSearch) mbListSearch.innerHTML = html;
            if (smartSection) smartSection.hidden = false;

            // Gán sự kiện cho các nút mũi tên chéo ↗ để điền vào ô input
            if (mbListSearch) {
              var fillBtns = mbListSearch.querySelectorAll('.pc-tiktok-suggest-fill');
              fillBtns.forEach(function(b) {
                b.addEventListener('click', function(ev) {
                  ev.preventDefault();
                  ev.stopPropagation();
                  var val = b.getAttribute('data-fill');
                  if (input && val) {
                    input.value = val;
                    input.focus();
                    var event = new Event('input', { bubbles: true });
                    input.dispatchEvent(event);
                  }
                });
              });
            }
          });

          if (mbListSearch2) mbListSearch2.innerHTML = '';
        }, 220);
      });
    }
    }
  }

  /* ── Init ──────────────────────────────────────────────────────────────── */
  function init() { initCompact(); initPopup(); }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
