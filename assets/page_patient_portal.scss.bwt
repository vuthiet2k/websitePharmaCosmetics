.pc-pp-wrap { padding: 32px 0 64px; }

.pc-pp-hero {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
  background: var(--subColor);
  color: #fff;
  border-radius: 20px;
  padding: 28px 32px;
  margin-bottom: 24px;
}
@media (max-width: 767px) { .pc-pp-hero { grid-template-columns: 1fr; } }
.pc-pp-hero-tag { font-size: var(--fs-xs); opacity: 0.75; display: block; }
.pc-pp-hero-doctor { font-size: var(--fs-xs); opacity: 0.75; float: right; }
.pc-pp-hero-title { font-size: var(--fs-xl); margin: 8px 0 4px; color: #fff; }
.pc-pp-hero-score { font-size: var(--fs-2xl); font-weight: 800; color: var(--mainColorLight); }
.pc-pp-hero-note { font-size: var(--fs-xs); opacity: 0.8; margin: 2px 0 12px; }
.pc-pp-hero-metrics { display: flex; flex-wrap: wrap; gap: 16px; font-size: var(--fs-sm); margin-bottom: 20px; }
.pc-pp-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.pc-pp-btn-outline { background: transparent; border: 1.5px solid #fff; }
.pc-pp-hero-side {
  background: rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 18px;
}
.pc-pp-hero-side h3 { font-size: var(--fs-sm); margin: 0 0 12px; }
.pc-pp-appt-card { display: flex; flex-direction: column; gap: 6px; font-size: var(--fs-sm); margin-bottom: 12px; }
.pc-pp-appt-link { color: var(--mainColorLight); font-size: var(--fs-sm); text-decoration: none; }

.pc-pp-order-block { margin-bottom: 24px; }
.pc-pp-order-status { color: var(--mainColorDark); font-weight: 700; font-size: var(--fs-sm); }
.pc-pp-order-items { color: var(--textBody); font-size: var(--fs-sm); margin: 8px 0 16px; }
.pc-pp-order-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.pc-pp-btn-ghost {
  padding: 12px 24px;
  border-radius: 50px;
  background: var(--mainColorLight);
  color: var(--mainColorDark);
  text-decoration: none;
  font-weight: 700;
}

.pc-pp-bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
@media (max-width: 767px) { .pc-pp-bottom-grid { grid-template-columns: 1fr; } }
.pc-pp-plan-progress { color: var(--mainColorDark); font-weight: 600; font-size: var(--fs-sm); margin: 8px 0 4px; }
.pc-pp-plan-note { color: var(--textSub); font-size: var(--fs-sm); margin-bottom: 16px; }
.pc-pp-voucher-item {
  padding: 12px 0;
  border-bottom: 1px solid var(--lineColor);
  font-size: var(--fs-sm);
  color: var(--textBody);
}
