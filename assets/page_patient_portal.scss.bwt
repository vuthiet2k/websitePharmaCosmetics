/* page_patient_portal.scss.bwt — 14/11/2026: đã biên dịch phẳng + gỡ quy tắc chết bằng scripts/purge-dead-css.mjs (UI-0.4).
   File CŨ đang được thay dần bằng class Tailwind — KHÔNG thêm quy tắc mới vào đây. */
.pc-pp-wrap {
  padding: 32px 0 64px;
}

.pc-pp-hero {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
  background: var(--subColor);
  color: #fff;
  border-radius: 20px;
  padding: 28px 32px;
  margin-bottom: 24px;
}

@media (max-width: 767px) {
  .pc-pp-hero {
    grid-template-columns: 1fr;
  }
}
.pc-pp-hero-tag {
  font-size: var(--fs-xs);
  opacity: 0.75;
  display: block;
}

.pc-pp-hero-title {
  font-size: var(--fs-xl);
  margin: 8px 0 4px;
  color: #fff;
}

.pc-pp-hero-note {
  font-size: var(--fs-xs);
  opacity: 0.8;
  margin: 2px 0 12px;
}

.pc-pp-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.pc-pp-btn-outline {
  background: transparent;
  border: 1.5px solid #fff;
}

/* L02 25/10/2026: page_chuyen_gia (định nghĩa .pc-cg-cta-btn) không nạp ở trang này ⇒ link nút hero mang màu link mặc định #231f20 trên nền --subColor (2:1). */
.pc-pp-hero-actions a {
  color: #fff;
}

.pc-pp-order-block {
  margin-bottom: 24px;
}

.pc-pp-order-status {
  color: var(--mainColorDark);
  font-weight: 700;
  font-size: var(--fs-sm);
}

.pc-pp-order-items {
  color: var(--textBody);
  font-size: var(--fs-sm);
  margin: 8px 0 16px;
}

.pc-pp-order-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.pc-pp-btn-ghost {
  padding: 12px 24px;
  border-radius: 50px;
  background: var(--mainColorLight);
  color: var(--mainColorDark);
  text-decoration: none;
  font-weight: 700;
}
