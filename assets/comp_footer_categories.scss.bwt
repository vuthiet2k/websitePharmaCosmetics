/* ============================================================
   Footer SEO — Mega footer section (global, mọi trang)
   Snippet: section_footer_brands.bwt (gộp từ section_footer_categories)
   Blocks: pc-footer-brands · pc-footer-cats · pc-footer-keywords
   Style: pc- / BEM / CSS variables. Desktop 4 cột, mobile accordion.
   ============================================================ */

.pc-footer-cats {
  padding: 20px 0;
  background: var(--bg-subtle, #F8F9FA);
  border-top: 1px solid var(--lineColor, #DFE6E9);

  /* ── Header (tùy chọn) — căn trái, đơn giản ── */
  &__header {
    margin-bottom: 24px;
    text-align: left;
  }

  &__heading {
    margin: 0;
    font-family: var(--font-primary);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--mainColorDark);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  &__sub {
    margin: 6px 0 0;
    font-family: var(--font-secondary);
    font-size: var(--fs-sm);
    color: var(--textSub);
  }

  /* ── Grid: Desktop 4 cột (kiểu danh mục sàn TMĐT) ── */
  &__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px 40px;
  }

  &__col {
    min-width: 0;
  }

  /* ── Tiêu đề cột ── */
  &__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  &__title {
    display: block;
    font-family: var(--font-primary);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--textBody);
    text-decoration: none;
    line-height: 1.4;
  }

  a.pc-footer-cats__title {
    transition: color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--mainColor);
    }
  }

  /* Nút toggle accordion — ẩn ở desktop */
  &__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--textSub);
    cursor: pointer;
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* ── Cụm link: inline + ngăn bằng dấu "|", tự xuống dòng (kiểu sàn TMĐT) ── */
  &__links {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;

    li {
      display: inline;
    }
    /* Dấu | ngăn cách giữa các link (trừ link cuối) */
    li:not(:last-child)::after {
      content: "|";
      margin: 0 5px;
      color: var(--lineColor);
    }

    a {
      font-family: var(--font-secondary);
      font-size: var(--fs-sm);
      color: var(--textSub);
      text-decoration: none;
      line-height: 1.6;
      white-space: nowrap;
      transition: color var(--dur-fast) var(--ease-out);

      &:hover {
        color: var(--mainColor);
      }
    }
  }

  /* ── Tablet: 3 cột ── */
  @media (max-width: 991px) {
    &__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px 20px;
    }
  }

  /* ── Mobile: 1 cột, accordion ── */
  @media (max-width: 767px) {
    padding: 16px 0;

    &__grid {
      display: block;
    }

    &__col {
      border-bottom: 1px solid var(--lineColor, #DFE6E9);
    }

    &__head {
      padding: 14px 0;
    }

    &__toggle {
      display: inline-flex;
    }

    /* Mặc định thu gọn ở mobile */
    &__links {
      display: none;
      margin: 0 0 14px;
    }

    .is-open &__links {
      display: block;
    }

    .is-open &__toggle {
      transform: rotate(180deg);
    }
  }
}

/* ============================================================
   Top thương hiệu nổi bật (section_footer_brands.bwt)
   Đặt ngay trên DANH MỤC SẢN PHẨM. Inline + ngăn bằng "|".
   ============================================================ */
.pc-footer-brands {
  padding: 20px 0;
  background: var(--bg-subtle, #F8F9FA);
  border-top: 1px solid var(--lineColor, #DFE6E9);

  &__block { margin-bottom: 18px; }
  &__block:last-child { margin-bottom: 0; }

  &__title {
    margin: 0 0 8px;
    font-family: var(--font-primary);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--mainColorDark);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  &__list a {
    font-family: var(--font-secondary);
    font-size: var(--fs-sm);
    color: var(--textSub);
    text-decoration: none;
    line-height: 1.6;
    white-space: nowrap;
    transition: color var(--dur-fast, .15s) var(--ease-out, ease);

    &:hover { color: var(--mainColor); }
  }

  &__sep {
    margin: 0 5px;
    color: var(--lineColor);
  }

  &__more {
    margin-left: 8px;
    font-family: var(--font-secondary);
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    color: var(--mainColorDark);
    text-decoration: none;
    &:hover { color: var(--mainColor); text-decoration: underline; }
  }

  @media (max-width: 767px) {
    padding: 16px 0;
  }
}

/* ============================================================
   Từ khoá xu hướng — keyword tag blocks (nền sáng bg-subtle)
   Thay thế .top-search-foo cũ (nền tối footer) cho block này.
   ============================================================ */
.pc-footer-keywords {
  padding: 20px 0;
  background: var(--bg-subtle, #F8F9FA);
  border-top: 1px solid var(--lineColor, #DFE6E9);

  &__title {
    margin: 0 0 12px;
    font-family: var(--font-primary);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--mainColorDark);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  &__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    a {
      display: inline-block;
      /* DEF-GT-02 (Báo cáo UI Quality Audit trang Giới thiệu 13/09/2026): tag cao ~28-32px,
         dưới chuẩn WCAG 2.2 SC 2.5.8. Tăng padding để vùng bấm thực tế đạt ~24px+ chiều cao. */
      padding: 10px 16px;
      border-radius: 20px;
      font-family: var(--font-secondary);
      font-size: var(--fs-sm);
      color: var(--textSub, #636E72);
      background: #fff;
      border: 1px solid var(--lineColor, #DFE6E9);
      text-decoration: none;
      white-space: nowrap;
      transition: color .15s ease, border-color .15s ease, background .15s ease;

      &:hover {
        color: var(--mainColor);
        border-color: var(--mainColor);
        background: var(--mainColorLight, #eaf7ee);
      }
    }
  }

  @media (max-width: 767px) {
    padding: 16px 0;

    &__tags {
      gap: 6px;
    }
  }
}
