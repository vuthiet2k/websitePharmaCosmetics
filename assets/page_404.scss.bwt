.a-center {
	text-align: center;
}
.layout-404 {
	img {
		max-width: 100%;
		margin-top: -40px;
	}
	h1 {
		margin: 20px 0 10px 0;
		font-size: var(--fs-2xl);
		font-weight: bold;
	}
}
.btn-home {
	display: inline-block;
	text-align: center;
	white-space: nowrap;
	outline: none !important;
	cursor: pointer;
	border: none;
	font-weight: 400;
	border-radius: 0;
	letter-spacing: 0;
	box-shadow: none !important;
	text-transform: uppercase;
	&:hover{
		border-color: var(--subColor);
		background: var(--subColor);
		color:#fff;
	}
	&.btn[disabled]{
		margin-top: 5px;
		opacity: 0.6;
	}
}
.padding-top-15{
	padding-top: 15px;
}
.margin-bottom-40{
	margin-bottom: 40px;
}