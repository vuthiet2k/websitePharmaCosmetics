.pc-seo-dir { padding: 32px 0 56px; }
.pc-seo-dir-row { margin-bottom: 28px; }
.pc-seo-dir-heading {
  font-size: var(--fs-base);
  text-transform: uppercase;
  color: var(--textBody);
  font-weight: 800;
  margin: 0 0 12px;
}
.pc-seo-dir-links { font-size: var(--fs-sm); line-height: 2; }
.pc-seo-dir-links a { color: var(--mainColorDark); text-decoration: none; }
.pc-seo-dir-links a:hover { text-decoration: underline; }
.pc-seo-dir-links span { color: var(--lineColor); margin: 0 10px; }

.pc-seo-dir-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-bottom: 28px;
}
@media (max-width: 767px) { .pc-seo-dir-grid { grid-template-columns: repeat(2, 1fr); } }
.pc-seo-dir-col h3 { font-size: var(--fs-sm); color: var(--textBody); margin: 0 0 10px; }
.pc-seo-dir-col a {
  display: block;
  font-size: var(--fs-sm);
  color: var(--textSub);
  text-decoration: none;
  padding: 4px 0;
  border-bottom: 1px solid var(--lineColor);
}
.pc-seo-dir-col a:hover { color: var(--mainColorDark); }

.pc-seo-dir-keywords { border-top: 1px solid var(--lineColor); padding-top: 24px; }
.pc-seo-dir-tags { display: flex; flex-wrap: wrap; gap: 10px; }
.pc-seo-dir-tag {
  padding: 8px 16px;
  border-radius: 50px;
  border: 1px solid var(--lineColor);
  color: var(--textSub);
  font-size: var(--fs-xs);
  text-decoration: none;
}
.pc-seo-dir-tag:hover { border-color: var(--mainColor); color: var(--mainColorDark); }

/* Dark variant (Figma: Dark Mega SEO Directory) */
.pc-seo-dir--dark { background: var(--ink, #13241F); }
.pc-seo-dir--dark .pc-seo-dir-heading,
.pc-seo-dir--dark .pc-seo-dir-col h3 { color: #fff; }
.pc-seo-dir--dark .pc-seo-dir-links a,
.pc-seo-dir--dark .pc-seo-dir-col a,
.pc-seo-dir--dark .pc-seo-dir-tag { color: rgba(255,255,255,0.75); border-color: rgba(255,255,255,0.2); }
