// comp_loyalty.scss.bwt
// Style đồng bộ AppBulk Loyalty widget với theme PHARMA COSMETICS
// Load điều kiện: chỉ khi customer đăng nhập (snippet appbulk-loyalty-widgets.bwt)
//
// ─────────────────────────────────────────────────────────────────────────────
// PHẦN A — CSS này apply được từ store (ngoài iframe)
// ─────────────────────────────────────────────────────────────────────────────

// ── Trigger button (div.appbulk-loyalty-widget + nút floating do AppBulk inject) ──
.appbulk-loyalty-widget {
	// AppBulk JS sẽ inject nút floating vào đây hoặc cạnh đây
}

// Nút floating AppBulk thường có class/id dạng ab-* hoặc loyalty-*
[id^="ab-floating"],
[class*="ab-floating"],
[class*="loyalty-float"],
[class*="loyaty-float"] {
	background-color: var(--mainColor) !important;
	border-color: var(--mainColor) !important;
	color: #fff !important;
	box-shadow: 0 4px 16px rgba(60, 179, 113, 0.4) !important;
	transition: background-color 0.2s ease, transform 0.2s ease !important;

	&:hover {
		background-color: var(--subColor) !important;
		border-color: var(--subColor) !important;
		transform: translateY(-2px) !important;
	}
}

// ── Popup container (inject vào DOM của store, NGOÀI iframe) ──
// AppBulk JS set inline style="height:204px" → cần !important để override
.loyaty-overlay-menu {
	border-radius: 12px !important;
	overflow: hidden !important;
	box-shadow: 0 8px 32px rgba(0, 0, 0, 0.20) !important;
	border: 1px solid rgba(60, 179, 113, 0.20) !important;
	// Override inline height từ AppBulk JS
	height: auto !important;
	min-height: 500px !important;

	// Ẩn scrollbar trên container ngoài
	&::-webkit-scrollbar { display: none; }
	scrollbar-width: none;

	iframe {
		display: block !important;
		width: 100% !important;
		border: none !important;
		// AppBulk JS set inline style="height:184px" → override
		height: 480px !important;
		min-height: 480px !important;
	}
}

// ── Trang full /apps/tich-diem-doi-qua (nếu app render trong theme layout) ──
// Sapo wrap app content vào .app-content hoặc tương tự
.app-content,
.loyalty-full-page,
#loyalty-page-container {
	max-width: 760px;
	margin: 0 auto;
	border-radius: 12px;
	overflow: hidden;
	box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);

	iframe {
		display: block;
		width: 100%;
		min-height: 600px;
		border: none;
	}
}

// ─────────────────────────────────────────────────────────────────────────────
// PHẦN B — CSS dán vào AppBulk Admin > Cài đặt > Custom CSS  (TRONG iframe)
// KHÔNG tự động apply — cần copy/paste thủ công vào admin app
// URL admin: https://loyaltyrewards.sapoapps.vn/Admin hoặc qua Sapo Apps
// ─────────────────────────────────────────────────────────────────────────────
