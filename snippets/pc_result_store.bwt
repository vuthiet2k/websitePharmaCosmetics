{%- comment -%}
  pc_result_store.bwt (2026-10-10) — lưu kết quả soi da AI / khảo sát chat trên thiết bị (localStorage) có hạn dùng.
  Lý do: trước đây chỉ giữ trong sessionStorage (đóng tab là mất) nên khi khách quay lại trang kết quả không còn gì
  để gợi ý tạo hồ sơ CRM. Nay giữ settings.skin_result_retention_days ngày (mặc định 7), có nút xoá trên trang kết quả.
  - Khoá localStorage có tiền tố "pcr:" (không đụng khoá cũ pc_quiz_skin_type mà trang quiz vẫn xoá vì lý do cũ).
  - Vẫn ghi/đọc sessionStorage để tương thích (test và phiên cũ đặt thẳng sessionStorage).
  - Không bao giờ lưu ảnh khuôn mặt — chỉ điểm số/kết quả như trước.
  Script nội tuyến, include TRƯỚC mọi script dùng window.PharmaResultStore (trang quiz, trang kết quả).
{%- endcomment -%}
<script>
(function (window) {
  'use strict';
  if (window.PharmaResultStore) return;
  var days = parseInt({{ settings.skin_result_retention_days | default: '7' | json }}, 10);
  if (!(days > 0)) days = 7;
  var TTL = days * 24 * 60 * 60 * 1000;
  var PREFIX = 'pcr:';
  var KEYS = ['pc_skin_scan_result', 'pc_quiz_skin_type', 'pc_quiz_saved_at', 'pc_quiz_result',
    'pc_crm_intake_record_id', 'pc_crm_saved_at', 'pc_crm_intake_session_id'];

  function readLocal(key) {
    try {
      var raw = window.localStorage.getItem(PREFIX + key);
      if (!raw) return null;
      var box = JSON.parse(raw);
      if (!box || typeof box.v !== 'string' || !(box.exp > Date.now())) {
        window.localStorage.removeItem(PREFIX + key);
        return null;
      }
      return box.v;
    } catch (e) { return null; }
  }

  // 2026-10-10: báo thay đổi để thanh "đã có hồ sơ" (snippets/skin_profile_notice.bwt) tự cập nhật khi vừa làm xong.
  function changed(key) {
    try { window.dispatchEvent(new CustomEvent('pc:result-store', { detail: { key: key } })); } catch (e) {}
  }

  window.PharmaResultStore = {
    retentionDays: days,
    get: function (key) {
      var v = readLocal(key);
      if (v !== null) return v;
      try { return window.sessionStorage.getItem(key); } catch (e) { return null; }
    },
    set: function (key, value) {
      value = String(value);
      try { window.localStorage.setItem(PREFIX + key, JSON.stringify({ v: value, exp: Date.now() + TTL })); } catch (e) {}
      try { window.sessionStorage.setItem(key, value); } catch (e) {}
      changed(key);
    },
    remove: function (key) {
      try { window.localStorage.removeItem(PREFIX + key); } catch (e) {}
      try { window.sessionStorage.removeItem(key); } catch (e) {}
      changed(key);
    },
    // Có kết quả soi da/khảo sát (chưa hết hạn) trên thiết bị này không.
    hasResult: function () {
      return !!(this.get('pc_skin_scan_result') || this.get('pc_quiz_skin_type'));
    },
    // Kết quả mới nhất trên thiết bị: { source: 'camera'|'quiz', saved_at: ms, saved: đã lưu hồ sơ CRM } hoặc null.
    latestResult: function () {
      var scan = null;
      try { scan = JSON.parse(this.get('pc_skin_scan_result') || 'null'); } catch (e) {}
      var scanAt = scan && scan.scores ? Number(scan.saved_at) || 0 : -1;
      var quizAt = this.get('pc_quiz_skin_type') ? Number(this.get('pc_quiz_saved_at')) || 0 : -1;
      if (scanAt < 0 && quizAt < 0) return null;
      return {
        source: scanAt >= quizAt ? 'camera' : 'quiz',
        saved_at: Math.max(scanAt, quizAt),
        saved: !!this.get('pc_crm_intake_record_id')
      };
    },
    // 2026-10-16: dựng lại kết quả trên thiết bị từ bản ghi CRM đầy đủ (GAS chỉ trả khi khớp submission_id/session_id
    // của thiết bị — crm-intake.js getCustomerInfo). Dùng chung trang kết quả + giỏ hàng. resultsData = quiz_results_data.
    // Trả về true nếu đã ghi được kết quả (sự kiện pc:result-store báo cho các khối đang mở).
    hydrateFromCrm: function (info, resultsData) {
      if (!info || !info.stored_in_gas || !info.consultation) return false;
      resultsData = resultsData || {};
      var rec = info.consultation;
      var savedAt = Date.parse(rec.created_at) || Date.now();
      var sc = (rec.scores && typeof rec.scores === 'object') ? rec.scores : {};
      if (info.source === 'ai_skin_scan_camera' && sc.acne) {
        this.set('pc_skin_scan_result', JSON.stringify({
          saved_at: savedAt, scores: sc, skin_type: rec.skin_type, skin_age: rec.skin_age, primary_concern: rec.primary_concern,
          regimen: rec.regimen || [], recommended_products: rec.recommended_products || [], source: 'crm'
        }));
      } else {
        // Khảo sát: scores = { skin_type: 'oily' } (lưu từ trang kết quả) hoặc số điểm theo từng loại da (lưu từ trang chat).
        var key = (typeof sc.skin_type === 'string' && sc.skin_type !== 'cases' && resultsData[sc.skin_type]) ? sc.skin_type : null;
        if (!key) {
          Object.keys(sc).forEach(function (k) {
            if (k !== 'cases' && resultsData[k] && typeof sc[k] === 'number' && (key === null || sc[k] > sc[key])) key = k;
          });
        }
        if (!key) return false;
        this.set('pc_quiz_skin_type', key);
        this.set('pc_quiz_saved_at', String(savedAt));
      }
      if (info.record_id) {
        this.set('pc_crm_intake_record_id', String(info.record_id));
        this.set('pc_crm_saved_at', new Date(savedAt).toISOString());
      }
      return true;
    },
    clearAll: function () {
      var self = this;
      KEYS.forEach(function (k) { self.remove(k); });
    },
    // 2026-10-10: khách vãng lai phải đăng nhập mới tạo hồ sơ CRM (quyết định người dùng). Ghi đường quay lại rồi
    // chuyển tới /account/login; templates/customers/account.bwt đọc cờ này để đưa khách về trang kết quả và
    // trang kết quả tự mở hộp đồng ý lưu (openSaveRequested).
    goLoginToSave: function (returnPath) {
      var path = /^\/[^\/]/.test(returnPath || '') ? returnPath : '/ai-skin-quiz-results';
      try { window.localStorage.setItem('pc_login_return', JSON.stringify({ path: path, at: Date.now() })); } catch (e) {}
      window.location.href = '/account/login';
    },
    openSaveRequested: function () {
      try {
        if (window.sessionStorage.getItem('pc_open_save_after_login') !== '1') return false;
        window.sessionStorage.removeItem('pc_open_save_after_login');
        return true;
      } catch (e) { return false; }
    }
  };
})(window);
</script>
