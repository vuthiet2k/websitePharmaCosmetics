{%- comment -%}
  quiz_results_data.bwt (2026-10-03) — bảng kết quả AI Skin Quiz theo loại da, in ra 1 object JS.
  Dùng chung cho page.ai-skin-quiz.bwt (chấm điểm) và page.ai-skin-quiz-results.bwt (hiển thị) —
  trước đây 2 trang đọc biến mock quiz_results (không có trên Sapo) nên trang kết quả luôn rơi
  về 1 kết quả mặc định. Nội dung giữ nguyên bản fallback đang chạy ở trang quiz.
{%- endcomment -%}
{
  oily: { skin_type: "Làn Da Dầu / Dễ Nổi Mụn", recommend: ["Salicylic Acid (BHA 2%)", "Niacinamide 10%", "Gel Dưỡng Không Dầu Oil-Free"] },
  dry: { skin_type: "Làn Da Khô Thiếu Ẩm", recommend: ["Hyaluronic Acid Đa Tầng", "Ceramide Phục Hồi", "Kem Dưỡng Khóa Ẩm Chuyên Sâu"] },
  combination: { skin_type: "Làn Da Hỗn Hợp Thiên Dầu", recommend: ["Niacinamide 5%", "Serum Cấp Nước B5", "Kem Cân Bằng Dầu Nước"] },
  sensitive: { skin_type: "Làn Da Nhạy Cảm / Tổn Thương", recommend: ["Rau Má Centella Asiatica", "Panthenol (Vitamin B5)", "Kem Chống Nắng Vật Lý Dịu Nhẹ"] },
  normal: { skin_type: "Làn Da Thường Khỏe Mạnh", recommend: ["Vitamin C 15% Chống Oxy Hóa", "Kem Dưỡng Phục Hồi", "Chống Nắng Phổ Rộng Broad-Spectrum"] },
  pigmentation: { skin_type: "Làn Da Tăng Sắc Tố & Nám", recommend: ["Tranexamic Acid 3%", "Vitamin C Tinh Khiết", "Retinoid Nồng Độ Kiểm Soát"] },
  aging: { skin_type: "Làn Da Lão Hóa & Thiếu Săn Chắc", recommend: ["Retinol 0.5% - 1.0%", "Phức Hợp Peptides", "Kem Chống Nắng Phổ Rộng"] }
}
