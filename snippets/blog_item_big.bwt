<div class="blog-item-big margin-bottom-10">
	{% if article.image == null %}
	<a  class="image-blog" href="{{ article.url }}" title="{{ article.title | escape }}"><img width="800" height="500" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{ 'no-image.jpg' | asset_url }}" alt="{{ article.title | escape }}" class="lazyload img-responsive" /></a>
	{%else%}
	<a class="image-blog" href="{{ article.url }}" title="{{ article.title | escape }}"><img width="800" height="500" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{ article.image.src | img_url}}" alt="{{ article.title | escape }}" class="lazyload img-responsive" /></a>
	{% endif %}
	<div class="content_blog"><h2><a href="{{ article.url }}" title="{{ article.title }}">{{ article.title }}</a></h2></div>
</div>