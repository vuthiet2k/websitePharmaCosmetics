{%- comment -%} Mobile Search Overlay — BEM, đồng bộ settings desktop search {%- endcomment -%}
<div class="search-overlay" id="mb-search-popup" aria-hidden="true">

  {%- comment -%} Header: Back ← · Form (input + clear X) · Submit icon {%- endcomment -%}
  <div class="search-overlay__header">

    <button class="search-overlay__back" id="mb-search-close" type="button" aria-label="Quay lại">
      {% include 'ui_icon', name: 'arrow-left', size: 24 %}
    </button>

    <form class="search-overlay__form" action="/search" method="get" id="mb-search-form">
      <input
        type="text"
        name="query"
        id="mb-search-input"
        class="search-overlay__input"
        placeholder="Tìm sản phẩm, thương hiệu..."
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
      >
      <input type="hidden" name="type" value="product">
      <button type="button" class="search-overlay__clear" id="mb-search-clear" aria-label="Xóa" hidden>
        {% include 'ui_icon', name: 'x', size: 'em' %}
      </button>
    </form>

    <button type="submit" form="mb-search-form" class="search-overlay__submit" aria-label="Tìm kiếm">
      {% include 'ui_icon', name: 'search', size: 20 %}
    </button>

  </div>

  {%- comment -%} Body: Promo · Recent · Suggest {%- endcomment -%}
  <div class="search-overlay__body">

    {%- comment -%} 2026-10-07: dùng chung khuyến mãi tìm kiếm với desktop (header_search_gg_title/url) — trường riêng header_search_promo đã xoá theo yêu cầu. {%- endcomment -%}
    {%- if settings.header_search_gg_title != blank -%}
    <a class="coupon_search mx-4 mt-3 flex items-center gap-3 rounded-xl bg-brand-tint p-3 text-brand-deep no-underline" href="{{settings.header_search_gg_url}}" title="{{settings.header_search_gg_title}}">
      <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-primary" aria-hidden="true">{% include 'ui_icon', name: 'gift', size: 20 %}</span>
      <p class="m-0 line-clamp-2 text-sm leading-snug">{{ settings.header_search_gg_title }}</p>
    </a>
    {%- endif -%}

    {%- comment -%} Lịch sử tìm kiếm — JS render từ localStorage {%- endcomment -%}
    <div class="px-4 pt-3" id="mb-recent" hidden>
      <p class="m-0 mb-1 text-xs font-bold uppercase tracking-wider text-ink-muted">Tìm kiếm gần đây</p>
      <ul class="m-0 list-none p-0" id="mb-recent-list"></ul>
      <template id="mb-recent-tpl">
        <li class="flex items-center justify-between border-0 border-b border-solid border-line-soft last:border-b-0">
          <a class="flex min-h-[44px] min-w-0 flex-1 items-center gap-3 text-sm text-ink no-underline" data-mb-recent-link href="/search">
            <span class="shrink-0 text-ink-muted" aria-hidden="true">{% include 'ui_icon', name: 'history', size: 20 %}</span>
            <span class="truncate" data-mb-recent-text></span>
          </a>
          <button type="button" class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-ink-muted hover:text-sale" data-mb-recent-del aria-label="Xóa">{% include 'ui_icon', name: 'x', size: 20 %}</button>
        </li>
      </template>
    </div>

    {%- comment -%} Đề xuất phổ biến — từ settings, horizontal scroll {%- endcomment -%}
    {%- if settings.header_search_suggest and settings.header_search_suggest_list != blank -%}
    <div class="px-4 pt-3" data-mb-section>
      <p class="m-0 mb-2 text-xs font-bold uppercase tracking-wider text-ink-muted">
        {%- if settings.header_search_suggest_title != blank -%}
          {{ settings.header_search_suggest_title }}
        {%- else -%}
          Đề xuất phổ biến
        {%- endif -%}
      </p>
      <div class="flex flex-wrap gap-2 pb-3" id="mb-suggest-tags">
        {%- assign mb_keywords = settings.header_search_suggest_list | split: ',' -%}
        {%- for mb_kw in mb_keywords -%}
          {%- assign mb_kw_clean = mb_kw | strip -%}
          {%- if mb_kw_clean != blank -%}
          <a class="inline-flex items-center rounded-full border border-solid border-line-soft bg-surface-soft px-4 py-2.5 text-sm text-ink no-underline hover:bg-brand-tint hover:text-brand-deep" data-mb-tag href="/search?query={{ mb_kw_clean | url_encode }}&type=product">{{ mb_kw_clean }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} Kết quả smart search AJAX — JS render, ẩn khi không có query {%- endcomment -%}
    {%- if settings.header_search_smart -%}
    <div id="mb-smart-results" hidden>
      <div class="list-search list-search-style" id="mb-list-search"></div>
      <div class="list-search2 list-search-style" id="mb-list-search2"></div>
    </div>
    {%- endif -%}

  </div>
</div>
