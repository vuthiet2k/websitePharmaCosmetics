{%- comment -%}
  service_getglowing_mechanism — 3. Công nghệ và cơ chế tác động: ảnh sản phẩm chính hãng (trái) + 3 hoạt chất (phải).
  Không có ảnh ⇒ 3 hoạt chất chiếm toàn ngang. Ghi chú nồng độ/INCI chỉ hiện khi Admin nhập (đã đối chiếu tài liệu kỹ thuật) —
  trước đây ghi cứng "Nồng độ… INCI đã đối chiếu" khi chưa có đối chiếu nào.
{%- endcomment -%}
<section id="service-mechanism-section" class="gg-section gg-section--soft">
  <div class="container">
    <header class="gg-head">
      {%- if settings.gg_tech_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_tech_eyebrow | escape }}</p>{%- endif -%}
      <h2 class="gg-title">{{ settings.gg_tech_title | default: 'GetGlowing Micro-Peel' | escape }}</h2>
      {%- if settings.gg_tech_text != blank -%}<p class="gg-lead">{{ settings.gg_tech_text | escape }}</p>{%- endif -%}
    </header>
    <div class="gg-tech{% if settings.gg_tech_image == blank %} gg-tech--full{% endif %}">
      {%- if settings.gg_tech_image != blank -%}
      <div class="gg-card gg-tech__media"><div class="gg-media gg-media--4x3"><img src="{{ settings.gg_tech_image | img_url: 'large' }}" alt="{{ settings.gg_tech_title | default: 'GetGlowing Micro-Peel' | escape }}" width="1200" height="900" loading="lazy" decoding="async"></div></div>
      {%- endif -%}
      <div class="gg-actives">
        {%- if settings.gg_actives_title != blank -%}<h3 class="gg-subtitle">{{ settings.gg_actives_title | escape }}</h3>{%- endif -%}
        {%- for i in (1..3) -%}
        {%- assign k_n = 'gg_active_' | append: i | append: '_name' -%}
        {%- assign k_r = 'gg_active_' | append: i | append: '_role' -%}
        {%- assign k_t = 'gg_active_' | append: i | append: '_text' -%}
        {%- if settings[k_n] != blank -%}
        <article class="gg-card gg-active">
          <span class="gg-active__mark" aria-hidden="true">{{ settings[k_n] | slice: 0, 1 }}</span>
          <div>
            <h4 class="gg-active__name">{{ settings[k_n] | escape }}{% if settings[k_r] != blank %} <span class="gg-active__role">{{ settings[k_r] | escape }}</span>{% endif %}</h4>
            {%- if settings[k_t] != blank -%}<p class="gg-card__text">{{ settings[k_t] | escape }}</p>{%- endif -%}
          </div>
        </article>
        {%- endif -%}
        {%- endfor -%}
        {%- if settings.gg_actives_note != blank -%}<p class="gg-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ settings.gg_actives_note | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
