{%- comment -%}
  2026-10-13 (thiết kế "Tin tức liên quan" — chi tiết bài viết): thẻ trắng bo góc, nhãn ngày nằm trên ảnh,
  tiêu đề 2 dòng → tóm tắt 2 dòng → "Đăng bởi: <tác giả>" → "Đọc tiếp →". Chỉ dùng ở templates/article.bwt.
{%- endcomment -%}
<article class="item-blog">
	<a class="image-blog" href="{{ article.url }}" title="{{ article.title | escape }}" tabindex="-1">
		<img src="{% if article.image.src != blank %}{{ article.image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}"
			alt="{{ article.image.alt | default: article.title | replace: '"', '' | escape }}" width="480" height="300" loading="lazy">
		<time class="user_date" datetime="{{ article.published_on | date: 'yyyy-MM-dd' }}">{{ article.published_on | date: 'dd/MM/yyyy' }}</time>
	</a>
	<div class="blog_content">
		<h3><a href="{{ article.url }}" title="{{ article.title | escape }}">{{ article.title }}</a></h3>
		<p class="blog_description">{{ article.summary | default: article.content | strip_html | truncatewords: 24 }}</p>
		{%- if article.author != blank -%}
		<p class="update_date">
			<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5"/></svg>
			<span class="user_name">Đăng bởi: <b>{{ article.author }}</b></span>
		</p>
		{%- endif -%}
		<a href="{{ article.url }}" class="read_more">Đọc tiếp <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg></a>
	</div>
</article>
