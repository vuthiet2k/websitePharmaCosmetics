{%- comment -%}
  lieu_trinh_details — "Thông tin chi tiết" = Mô tả chi tiết sản phẩm (product.content): ưu điểm, thành phần, đối tượng phù hợp,
  chống chỉ định, phục hồi, chăm sóc sau… Thu gọn khi dài, nút "Xem thêm" (assets/lieu-trinh.js). Trống ⇒ ẩn.
  h1 trong nội dung soạn thảo hạ thành h2 (mô tả thật của GetGlowing có sẵn <h1> ⇒ trang 2 h1, UI-2.5).
{%- endcomment -%}
{%- if lt_product.content != blank -%}
<section id="service-details-section" class="lt-section lt-section--soft">
  <div class="container">
    <header class="lt-head"><h2 class="lt-title">{{ settings.lt_details_title | default: 'Thông tin chi tiết liệu trình' | escape }}</h2></header>
    <div class="lt-details" data-lt-collapse>
      <div class="lt-rte lt-details__body">{{ lt_product.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' }}</div>
      <button type="button" class="lt-btn lt-btn--light lt-details__toggle" data-lt-toggle hidden aria-expanded="false"><span>Xem thêm</span> <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
    </div>
  </div>
</section>
{%- endif -%}
