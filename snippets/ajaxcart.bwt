								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex h-7 w-7 shrink-0 items-center justify-center rounded-xl border-0 bg-transparent p-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}">
									-
	</button>
								<input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar h-7 w-8 border-0 bg-transparent p-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex h-7 w-7 shrink-0 items-center justify-center rounded-xl border-0 bg-transparent p-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">
									+							
	</button>
	</div>
	</div>
	</div>
					<div class="grid">
						<div class="grid__item w-auto shrink-0 grow text-right cart_prices">
							<span class="cart-price">{{linePrice}}</span>

	</div>
	</div>
	</div>
	</div>
	</div>
		{{/items}}
	</div>
	<div class="ajaxcart__footer ajaxcart__footer--fixed cart-footer">
		<div class="row">
			<div class="col-lg-4 col-12 offset-md-8 offset-lg-8 offset-xl-8">
				<div class="ajaxcart__subtotal">
					<div class="cart__subtotal">
						<div class="cart__col-6">Tổng tiền:</div>
						<div class="text-right cart__totle"><span class="total-price">{{{totalPrice}}}</span></div>
	</div>
	</div>
				<div class="cart__btn-proceed-checkout-dt">
					<button onclick="location.href='/checkout'" type="button" class="button btn btn-primary cart__btn-proceed-checkout" id="btn-proceed-checkout" title="Thanh toán">Thanh toán</button>
	</div>
	</div>
	</div>
	</div>
	</form>

{% endraw %}
</script>

<script id="CartMobileTemplate" type="text/template">
 {% raw %}
<form action="{% endraw %}{{ routes.cart_url }}{% raw %}" method="post" novalidate class="cart ajaxcart cart-mobile">
  <div class="cart-mobile-select-all">
    <label><input type="checkbox" id="cart-select-all" title="Chọn tất cả" checked> Chọn tất cả</label>
  </div>
  <div class="ajaxcart__inner ajaxcart__inner--has-fixed-footer cart_body">
    {{#items}}
      <div class="ajaxcart__row">
        <div class="cart-item-check cart-item-check--mobile">
          <input type="checkbox" class="cart-item-select" data-key="{{key}}" data-line="{{line}}" data-raw-price="{{rawLinePrice}}" checked>
        </div>
        <div class="ajaxcart__product cart_product " data-line="{{line}}">
          <a href="{{url}}" class="ajaxcart__product-image cart_image" title="{{name}}">
            <img width="80" height="80" src="{{img}}" alt="{{name}}">
          </a>
          <div class="grid__item cart_info">
            <div class="ajaxcart__product-name-wrapper cart_name">
              <a href="{{url}}" class="ajaxcart__product-name h4 line-clamp line-clamp-2-new" title="{{name}}">{{name}}</a>
              {{#if variation}}
                <span class="ajaxcart__product-meta variant-title">{{variation}}</span>
              {{/if}}
			 
            </div>
            <div class="grid flex-wrap gap-y-1">
              <div class="grid__item w-auto flex-none cart_select cart_item_name {{nopro}}">
                <div class="ajaxcart__qty input-group-btn flex w-fit flex-nowrap items-center overflow-hidden rounded-xl border-0 bg-surface-soft p-0.5">
                  <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex h-7 w-7 shrink-0 items-center justify-center rounded-xl border-0 bg-transparent p-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}"> - </button>
                  <input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar h-7 w-8 border-0 bg-transparent p-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
                  <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex h-7 w-7 shrink-0 items-center justify-center rounded-xl border-0 bg-transparent p-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}"> + </button>
                </div>
              </div>
              <div class="grid__item w-auto shrink-0 grow text-right cart_prices">
                <span class="cart-price">{{price}}</span>
                <a title="Xóa" class="cart__btn-remove remove-item-cart ajaxifyCart--remove min-h-[44px] min-w-[44px] inline-flex items-center justify-center" href="javascript:;" data-line="{{line}}">Xóa</a>
              </div>
            </div>
            {{#if discountsApplied}}
              <div class="grid grid--table">
                <div class="grid__item text-right">
                  <ul class="order-discount order-discount--list order-discount--title order-discount--cart order-discount--cart-title" aria-label="{% endraw %}Giảm giá{% raw %}">
                    {{#each discounts}}
                      <li class="order-discount__item">
                        <span class="icon icon-saletag" aria-hidden="true"></span>{{ this.discount_application.title }} (-{{{ this.formattedAmount }}})
                      </li>
                    {{/each}}
                  </ul>
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    {{/items}} {% endraw %}{% if settings.cart_notes_enable %}{% raw %} <div class="ajaxcart__row">
      <label for="CartSpecialInstructions" class="txt--minor">{% endraw %}Ghi chú:{% raw %}</label>
      <textarea name="note" class="input-full ajaxcart__note" id="CartSpecialInstructions">{{note}}</textarea>
    </div> {% endraw %}{% endif %}{% raw %}
  </div>
</form>
{% endraw %}

</script>

<script id="FooterCartTemplate" type="text/template">
 {% raw %}
 <div class="cart-summary-breakdown">
   {{#if hasDiscount}}
   <div class="cart-summary-row">
     <span class="cart-summary-label">Tạm tính</span>
     <span class="cart-summary-value js-subtotal"><s>{{{totalLineItemsPrice}}}</s></span>
   </div>
   <div class="cart-summary-row cart-summary-row--saving">
     <span class="cart-summary-label">Tiết kiệm được</span>
     <span class="cart-summary-saving">-{{{totalDiscounts}}}</span>
   </div>
   {{else}}
   <div class="cart-summary-row">
     <span class="cart-summary-label">Tạm tính</span>
     <span class="cart-summary-value js-subtotal">{{{totalLineItemsPrice}}}</span>
   </div>
   {{/if}}
 </div>
 {% endraw %}
</script>

<script id="JsQty" type="text/template">
{% raw %}
<div class="js-qty">
	<button type="button" class="js-qty__adjust js-qty__adjust--minus items-count" data-id="{{key}}" data-qty="{{itemMinus}}" aria-label="{% endraw %}-{% raw %}">
	-
	</button>
	<input type="text" class="js-qty__num number-sidebar" maxlength="3" value="{{itemQty}}" min="1" data-id="{{key}}" aria-label="quantity" pattern="[0-9]*" name="{{inputName}}" id="{{inputId}}">
	<button type="button" class="js-qty__adjust js-qty__adjust--plus items-count" data-id="{{key}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">
	+
	</button>
	</div>
{% endraw %}
</script>
<!-- Popup Cart Desktop (Ẩn - thay bằng Shopee HUD Alert) -->
<div id="popup-cart-desktop" class="popup-cart" style="display: none !important;">
</div>

<!-- ==========================================
     SHOPEE ADD-TO-CART CENTER HUD ALERT
     ========================================== -->
<div id="pc-shopee-hud" class="pc-shopee-hud" aria-hidden="true">
  <div class="pc-shopee-hud__box">
    <div class="pc-shopee-hud__icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <div class="pc-shopee-hud__text">Sản phẩm đã được thêm vào Giỏ hàng</div>
  </div>
</div>

<style>
/* ── Dropdown Giỏ Hàng Header Chuẩn Shopee ── */
.top-cart-content {
  position: absolute;
  top: calc(100% + 4px);
  right: -8px;
  width: 360px;
  background: var(--white);
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(0, 0, 0, 0.08);
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  z-index: 10000;
  pointer-events: none;
}
.sudes-header-cart:hover .top-cart-content,
.top-cart-content:hover {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.pc-shopee-cart-dropdown {
  position: relative;
  display: flex;
  flex-direction: column;
}
.pc-shopee-cart-dropdown__arrow {
  position: absolute;
  top: -6px;
  right: 20px;
  width: 12px;
  height: 12px;
  background: var(--white);
  transform: rotate(45deg);
  border-left: 1px solid rgba(0, 0, 0, 0.08);
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  z-index: 1;
}
.pc-shopee-cart-dropdown__head {
  padding: 12px 14px 8px;
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  font-weight: 500;
  color: var(--pc-color-ink-muted);
  border-bottom: 1px solid var(--pc-color-line-soft);
}
.pc-shopee-cart-dropdown__body {
  max-height: 290px;
  overflow-y: auto;
  scrollbar-width: thin;
}
.pc-shopee-cart-dropdown__body::-webkit-scrollbar {
  width: 4px;
}
.pc-shopee-cart-dropdown__body::-webkit-scrollbar-thumb {
  background: var(--pc-color-line-control);
  border-radius: 4px;
}
.pc-shopee-cart-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  text-decoration: none !important;
  color: inherit;
  transition: background 0.15s ease;
}
.pc-shopee-cart-item:hover {
  background: var(--pc-color-surface-soft);
}
.pc-shopee-cart-item__thumb {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border: 1px solid var(--pc-color-line);
  border-radius: 4px;
  overflow: hidden;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-shopee-cart-item__thumb img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.pc-shopee-cart-item__title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  color: var(--pc-color-ink);
  line-height: 1.35;
}
.pc-shopee-cart-item__title span {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pc-shopee-cart-item__variant {
  display: block;
  font-size: var(--fs-2xs, 10px);
  color: var(--pc-color-ink-muted);
  margin-top: 2px;
}
.pc-shopee-cart-item__price {
  flex-shrink: 0;
  margin-left: 8px;
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  font-weight: 600;
  color: var(--pc-color-brand-primary);
  text-align: right;
}
.pc-shopee-cart-empty {
  padding: 36px 20px;
  text-align: center;
  color: var(--pc-color-ink-muted);
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-sm, 13px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.pc-shopee-cart-empty p {
  margin: 0;
}
.pc-shopee-cart-dropdown__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  background: var(--pc-color-surface-soft);
  border-top: 1px solid var(--pc-color-line-soft);
  border-radius: 0 0 8px 8px;
}
.pc-shopee-cart-dropdown__count {
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  color: var(--pc-color-ink-muted);
}
.pc-shopee-cart-dropdown__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 14px;
  background: var(--pc-color-brand-primary);
  color: var(--white) !important;
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  font-weight: 600;
  border-radius: 4px;
  text-decoration: none !important;
  transition: background 0.15s ease;
}
.pc-shopee-cart-dropdown__btn:hover {
  background: var(--pc-color-brand-deep);
}

.pc-shopee-hud {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}
.pc-shopee-hud.is-active {
  opacity: 1;
  visibility: visible;
}
.pc-shopee-hud__box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: min(300px, 86vw);
  padding: 24px 20px;
  background: rgba(30, 30, 30, 0.88);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  border-radius: 16px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  transform: scale(0.85);
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  text-align: center;
}
.pc-shopee-hud.is-active .pc-shopee-hud__box {
  transform: scale(1);
}
.pc-shopee-hud__icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--pc-color-brand-primary);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(60, 179, 113, 0.3);
}
.pc-shopee-hud__text {
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-base, 15px);
  font-weight: 500;
  color: var(--white);
  line-height: 1.45;
}
</style>

<script>
window.showShopeeCartAlert = function() {
  var hud = document.getElementById('pc-shopee-hud');
  if (!hud) return;
  hud.classList.add('is-active');
  if (window._shopeeHudTimer) clearTimeout(window._shopeeHudTimer);
  window._shopeeHudTimer = setTimeout(function() {
    hud.classList.remove('is-active');
  }, 1400);
};
</script>



<div id="popup-cart-mobile" class="popup-cart-mobile pc-cart-toast">
  <div class="pc-cart-toast__inner">
    <div class="pc-cart-toast__info">
      <span class="pc-cart-toast__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="pc-cart-toast__text">
        <span class="pc-cart-toast__label">Đã thêm vào giỏ hàng</span>
        <div class="media-content bodycart-mobile"></div>
      </div>
    </div>
    <div class="pc-cart-toast__actions">
      <a href="/cart" class="pc-cart-toast__btn noti-cart-count" title="Xem giỏ hàng">
        Xem giỏ<span class="count_item_pr ml-1 empty:hidden"></span>
      </a>
      <button type="button" class="pc-cart-toast__close cart_btn-close iconclose" aria-label="Đóng">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="pc-cart-toast__progress"></div>
</div>

<style>
/* ── Override popup-cart-mobile → bottom toast ── */
.popup-cart-mobile.pc-cart-toast {
  top: auto !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  transform: translateY(110%) !important;
  max-width: 100% !important;
  min-width: 0 !important;
  width: 100% !important;
  height: auto !important;
  border-radius: 16px 16px 0 0;
  border-top: 3px solid var(--mainColor);
  box-shadow: 0 -4px 24px rgba(0,0,0,.12);
  overflow: visible;
  visibility: visible !important;
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1) !important;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.popup-cart-mobile.pc-cart-toast.active {
  transform: translateY(0) !important;
  visibility: visible !important;
}

/* Ẩn backdrop khi toast mobile active — không cần overlay */
@media (max-width: 767px) {
  .backdrop__body-backdrop___1rvky.active {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}

/* Toast layout */
.pc-cart-toast__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px 16px;
}
.pc-cart-toast__info {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}
.pc-cart-toast__icon {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  background: var(--pc-color-brand-tint);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pc-color-brand-deep);
}
.pc-cart-toast__text {
  flex: 1;
  min-width: 0;
}
.pc-cart-toast__label {
  display: block;
  font-family: var(--font-primary);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--pc-color-brand-deep);
  line-height: 1.3;
}
/* Reset old media-content styles, hiện tên sản phẩm dạng text nhỏ */
.pc-cart-toast .bodycart-mobile {
  display: block;
  padding: 0;
  border: none;
  margin: 2px 0 0;
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  color: var(--pc-color-ink-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pc-cart-toast__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.pc-cart-toast__btn {
  display: inline-flex;
  align-items: center;
  background: var(--pc-color-brand-deep);
  color: var(--white) !important;
  font-family: var(--font-primary);
  font-size: var(--fs-xs);
  font-weight: 600;
  padding: 8px 14px;
  min-height: 44px;
  border-radius: 6px;
  text-decoration: none !important;
  white-space: nowrap;
  transition: background var(--dur-fast, 150ms) var(--ease-out, ease);
}
.pc-cart-toast__btn:hover {
  background: var(--pc-color-brand-primary);
}
.pc-cart-toast__close {
  width: 44px;
  height: 44px;
  border: none;
  background: transparent;
  color: var(--pc-color-ink-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.15s, color 0.15s;
}
.pc-cart-toast__close:hover {
  background: var(--pc-color-surface-soft);
  color: var(--pc-color-ink);
}

/* Progress bar — đếm ngược 3s tự đóng */
.pc-cart-toast__progress {
  height: 3px;
  background: var(--pc-color-brand-primary);
  transform-origin: left;
  transform: scaleX(0);
}
.pc-cart-toast.active .pc-cart-toast__progress {
  animation: pc-toast-progress 3s linear forwards;
}
@keyframes pc-toast-progress {
  from { transform: scaleX(1); }
  to   { transform: scaleX(0); }
}
</style>

<script>
$(document).ready(function() {
  var _toastTimer = null;
  var $toast = $('#popup-cart-mobile');
  if (!$toast.length) return;

  // MutationObserver: khi JS bên ngoài add class 'active' → bắt đầu đếm ngược 3s
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName !== 'class') return;
      if ($toast.hasClass('active')) {
        clearTimeout(_toastTimer);
        // Reset progress bar animation
        var $bar = $toast.find('.pc-cart-toast__progress');
        $bar.css('animation', 'none');
        $bar[0] && $bar[0].offsetWidth; // force reflow
        $bar.css('animation', '');
        // Auto-dismiss
        _toastTimer = setTimeout(function() {
          $toast.removeClass('active');
          $('.backdrop__body-backdrop___1rvky').removeClass('active');
        }, 3000);
      } else {
        clearTimeout(_toastTimer);
      }
    });
  });
  observer.observe($toast[0], { attributes: true });
});
</script>