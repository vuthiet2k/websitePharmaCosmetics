<div class="backdrop__body-backdrop___1rvky"></div>
{%include 'ajaxcartfunction'%}
<script id="SideCartTemplate" type="text/template">
 {% raw %}
<form action="{% endraw %}{{ routes.cart_url }}{% raw %}" method="post" novalidate class="cart ajaxcart">
	<div class="ajaxcart__inner ajaxcart__inner--has-fixed-footer cart_body items">
		{{#items}}
		<div class="ajaxcart__row">
			<div class="ajaxcart__product cart_product" data-line="{{line}}">
				<a href="{{url}}" class="ajaxcart__product-image cart_image" title="{{name}}"><img width="80" height="80" src="{{img}}" alt="{{name}}"></a>
				<div class="grid__item cart_info">
					<div class="ajaxcart__product-name-wrapper cart_name">
						<a href="{{url}}" class="ajaxcart__product-name h4" title="{{name}}">{{name}}</a>
						{{#if variation}}
						<span class="ajaxcart__product-meta variant-title">{{variation}}</span>
						{{/if}}
	</div>
					<div class="grid flex-wrap gap-y-1">
						<div class="grid__item w-auto flex-none cart_select cart_item_name">
						<label class="cart_quantity">Số lượng</label>
							<div class="ajaxcart__qty input-group-btn flex !w-fit flex-nowrap items-center overflow-hidden rounded-xl bg-surface-soft !p-0.5">
								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}">
								-
	</button>
								<input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar !h-7 !min-h-0 !w-8 !min-w-0 !border-0 !bg-transparent !p-0 !m-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">
								+							
	</button>
	</div>
	</div>
						<div class="grid__item w-auto shrink-0 grow text-right cart_prices">
							<span class="cart-price">{{price}}</span>
							<a title="Xóa" class="cart__btn-remove remove-item-cart ajaxifyCart--remove inline-flex min-h-[44px] min-w-[44px] items-center justify-center" href="javascript:;" data-line="{{line}}">Xóa</a>
	</div>
	</div>
					{{#if discountsApplied}}
					<div class="grid grid--table">
						<div class="grid__item text-right">
							<ul class="order-discount order-discount--list order-discount--title order-discount--cart order-discount--cart-title" aria-label="{% endraw %}Giảm giá{% raw %}">
								{{#each discounts}}
								<li class="order-discount__item">
									<span class="icon icon-saletag" aria-hidden="true"></span>{{ this.discount_application.title }} (-{{{ this.formattedAmount }}})
	</li>
								{{/each}}
	</ul>
	</div>
	</div>
					{{/if}}
	</div>
	</div>
	</div>
		{{/items}}

		{% endraw %}{% if settings.cart_notes_enable %}{% raw %}
		<div class="ajaxcart__row">
			<label for="CartSpecialInstructions" class="txt--minor">{% endraw %}Ghi chú:{% raw %}</label>
			<textarea name="note" class="input-full ajaxcart__note" id="CartSpecialInstructions">{{note}}</textarea>
	</div>
		{% endraw %}{% endif %}{% raw %}
	</div>
	<div class="ajaxcart__footer ajaxcart__footer--fixed cart-footer">
		<div class="ajaxcart__subtotal">
			{{#if cartDiscountsApplied}}
			<div class="grid grid--table ajaxcart__discounts">
				{{#each cartDiscounts}}
				<div class="grid__item two-thirds">
					<span class="order-discount order-discount--title order-discount--cart-title">
						<span class="icon icon-saletag" aria-hidden="true"></span><span class="visually-hidden">{% endraw %}%{% raw %}:</span>{{ this.title }}
	</span>
	</div>
				<div class="grid__item one-third text-right">
					<span class="order-discount">-{{{ this.formattedAmount }}}</span>
	</div>
				{{/each}}
	</div>
			{{/if}}
			<div class="cart__subtotal">
				<div class="cart__col-6">Tổng tiền:</div>
				<div class="text-right cart__totle"><span class="total-price">{{{totalPrice}}}</span></div>
	</div>
	</div>
		<div class="cart__btn-proceed-checkout-dt">
			<button onclick="location.href='/checkout'" type="button" class="button btn btn-primary cart__btn-proceed-checkout" id="btn-proceed-checkout" title="Thanh toán">Thanh toán</button>
	</div>
	</div>
	</form>
{% endraw %}

</script>

<script id="CartTemplate" type="text/template">
 {% raw %}
<form action="{% endraw %}{{ routes.cart_url }}{% raw %}" method="post" novalidate class="cart ajaxcart cartpage">
  <div class="cart-header-info">
    <div class="cart-check-col"><label><input type="checkbox" id="cart-select-all" title="Chọn tất cả" checked></label></div>
    <div>Thông tin sản phẩm</div>
    <div>Số lượng</div>
    <div>Thành tiền</div>
  </div>
  <div class="ajaxcart__inner ajaxcart__inner--has-fixed-footer cart_body items">
    {{#items}}
      <div class="ajaxcart__row">
        <div class="cart-item-check">
          <input type="checkbox" class="cart-item-select" data-key="{{key}}" data-line="{{line}}" data-raw-price="{{rawLinePrice}}" checked>
        </div>
        <div class="cart-item-info" data-line="{{line}}">
          <a href="{{url}}" class="cart-item-thumb" title="{{name}}">
            <img src="{{img}}" alt="{{name}}" width="90" height="90">
          </a>
          <div class="cart-item-meta">
            <a href="{{url}}" class="cart-item-name line-clamp line-clamp-2-new" title="{{name}}">{{name}}</a>
            {{#if variation}}<span class="cart-item-variant">{{variation}}</span>{{/if}}
            <span class="cart-item-unit-price-inline"><span class="cart-price">{{price}}</span></span>
            <a title="Xóa" class="cart-item-remove remove-item-cart ajaxifyCart--remove" href="javascript:;" data-line="{{line}}">Xóa</a>
          </div>
        </div>
        <div class="cart-item-qty">
          <div class="ajaxcart__qty input-group-btn flex !w-fit flex-nowrap items-center overflow-hidden rounded-xl bg-surface-soft !p-0.5">
            <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}">-</button>
            <input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar !h-7 !min-h-0 !w-8 !min-w-0 !border-0 !bg-transparent !p-0 !m-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
            <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">+</button>
          </div>
        </div>
        <div class="cart-item-line-price">
          <span class="cart-price">{{linePrice}}</span>
        </div>
      </div>
    {{/items}} {% endraw %}{% if settings.cart_notes_enable %}{% raw %} <div class="ajaxcart__row">
      <label for="CartSpecialInstructions" class="txt--minor">{% endraw %}Ghi chú:{% raw %}</label>
      <textarea name="note" class="input-full ajaxcart__note" id="CartSpecialInstructions">{{note}}</textarea>
    </div> {% endraw %}{% endif %}{% raw %}
  </div>
</form>
{% endraw %}
</script>
<script id="CartHeaderTemplate" type="text/template">
{% raw %}
<div class="pc-shopee-cart-dropdown">
  <div class="pc-shopee-cart-dropdown__arrow"></div>
  <div class="pc-shopee-cart-dropdown__head">
    <span>Sản Phẩm Mới Thêm</span>
  </div>
  <div class="pc-shopee-cart-dropdown__body">
    {{#if items.length}}
      {{#each items}}
      <a href="{{url}}" class="pc-shopee-cart-item" title="{{name}}">
        <div class="pc-shopee-cart-item__thumb">
          <img width="42" height="42" src="{{img}}" alt="{{name}}">
        </div>
        <div class="pc-shopee-cart-item__title">
          <span>{{name}}</span>
          {{#if variation}}
            <small class="pc-shopee-cart-item__variant">{{variation}}</small>
          {{/if}}
        </div>
        <div class="pc-shopee-cart-item__price">
          {{price}}
        </div>
      </a>
      {{/each}}
    {{else}}
      <div class="pc-shopee-cart-empty">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-line-control" stroke-width="1.5">
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
        </svg>
        <p>Chưa có sản phẩm trong giỏ</p>
      </div>
    {{/if}}
  </div>
  {{#if items.length}}
  <div class="pc-shopee-cart-dropdown__foot">
    <div class="pc-shopee-cart-dropdown__count">
      {{itemCount}} Thêm Hàng Vào Giỏ
    </div>
    <a href="/cart" class="pc-shopee-cart-dropdown__btn">
      Xem Giỏ Hàng
    </a>
  </div>
  {{/if}}
</div>
{% endraw %}
</script>

<script id="CartPopupTemplate" type="text/template">
{% raw %}
<form action="{% endraw %}{{ routes.cart_url }}{% raw %}" method="post" novalidate class="cart ajaxcart cartpopup">
	<div class="cart-header-info">
		<div>Thông tin sản phẩm</div><div>Đơn giá</div><div>Số lượng</div><div>Thành tiền</div>
	</div>
	<div class="ajaxcart__inner ajaxcart__inner--has-fixed-footer cart_body items">
