							<div class="ajaxcart__qty input-group-btn flex !w-fit flex-nowrap items-center overflow-hidden rounded-xl bg-surface-soft !p-0.5">
								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}">
									-
	</button>
								<input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar !h-7 !min-h-0 !w-8 !min-w-0 !border-0 !bg-transparent !p-0 !m-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
								<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">
									+							
	</button>
	</div>
	</div>
	</div>
					<div class="grid">
						<div class="grid__item w-auto shrink-0 grow text-right cart_prices">
							<span class="cart-price">{{linePrice}}</span>

	</div>
	</div>
	</div>
	</div>
	</div>
		{{/items}}
	</div>
	<div class="ajaxcart__footer ajaxcart__footer--fixed cart-footer">
		<div class="row">
			<div class="col-lg-4 col-12 offset-md-8 offset-lg-8 offset-xl-8">
				<div class="ajaxcart__subtotal">
					<div class="cart__subtotal">
						<div class="cart__col-6">Tổng tiền:</div>
						<div class="text-right cart__totle"><span class="total-price">{{{totalPrice}}}</span></div>
	</div>
	</div>
				<div class="cart__btn-proceed-checkout-dt">
					<button onclick="location.href='/checkout'" type="button" class="button btn btn-primary cart__btn-proceed-checkout" id="btn-proceed-checkout" title="Thanh toán">Thanh toán</button>
	</div>
	</div>
	</div>
	</div>
	</form>

{% endraw %}
</script>

<script id="CartMobileTemplate" type="text/template">
 {% raw %}
<form action="{% endraw %}{{ routes.cart_url }}{% raw %}" method="post" novalidate class="cart ajaxcart cart-mobile">
  <div class="cart-mobile-select-all">
    <label><input type="checkbox" id="cart-select-all" title="Chọn tất cả" checked> Chọn tất cả</label>
  </div>
  <div class="ajaxcart__inner ajaxcart__inner--has-fixed-footer cart_body">
    {{#items}}
      <div class="ajaxcart__row">
        <div class="cart-item-check cart-item-check--mobile">
          <input type="checkbox" class="cart-item-select" data-key="{{key}}" data-line="{{line}}" data-raw-price="{{rawLinePrice}}" checked>
        </div>
        <div class="ajaxcart__product cart_product " data-line="{{line}}">
          <a href="{{url}}" class="ajaxcart__product-image cart_image" title="{{name}}">
            <img width="80" height="80" src="{{img}}" alt="{{name}}">
          </a>
          <div class="grid__item cart_info">
            <div class="ajaxcart__product-name-wrapper cart_name">
              <a href="{{url}}" class="ajaxcart__product-name h4 line-clamp line-clamp-2-new" title="{{name}}">{{name}}</a>
              {{#if variation}}
                <span class="ajaxcart__product-meta variant-title">{{variation}}</span>
              {{/if}}
			 
            </div>
            <div class="grid flex-wrap gap-y-1">
              <div class="grid__item w-auto flex-none cart_select cart_item_name {{nopro}}">
                <div class="ajaxcart__qty input-group-btn flex !w-fit flex-nowrap items-center overflow-hidden rounded-xl bg-surface-soft !p-0.5">
                  <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-qty="{{itemMinus}}" data-line="{{line}}" aria-label="{% endraw %}-{% raw %}"> - </button>
                  <input type="text" name="updates[]" class="ajaxcart__qty-num number-sidebar !h-7 !min-h-0 !w-8 !min-w-0 !border-0 !bg-transparent !p-0 !m-0 text-center text-xs font-semibold text-ink focus:outline-none" maxlength="3" value="{{itemQty}}" min="0" data-id="{{key}}" data-line="{{line}}" aria-label="quantity" pattern="[0-9]*">
                  <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count relative flex !h-7 !min-h-0 !w-7 !min-w-0 shrink-0 items-center justify-center !rounded-xl !border-0 !bg-transparent !p-0 !m-0 text-sm font-medium text-ink-secondary transition-colors after:absolute after:-inset-2 hover:bg-white hover:text-ink" data-id="{{key}}" data-line="{{line}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}"> + </button>
                </div>
              </div>
              <div class="grid__item w-auto shrink-0 grow text-right cart_prices">
                <span class="cart-price">{{price}}</span>
                <a title="Xóa" class="cart__btn-remove remove-item-cart ajaxifyCart--remove min-h-[44px] min-w-[44px] inline-flex items-center justify-center" href="javascript:;" data-line="{{line}}">Xóa</a>
              </div>
            </div>
            {{#if discountsApplied}}
              <div class="grid grid--table">
                <div class="grid__item text-right">
                  <ul class="order-discount order-discount--list order-discount--title order-discount--cart order-discount--cart-title" aria-label="{% endraw %}Giảm giá{% raw %}">
                    {{#each discounts}}
                      <li class="order-discount__item">
                        <span class="icon icon-saletag" aria-hidden="true"></span>{{ this.discount_application.title }} (-{{{ this.formattedAmount }}})
                      </li>
                    {{/each}}
                  </ul>
                </div>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    {{/items}} {% endraw %}{% if settings.cart_notes_enable %}{% raw %} <div class="ajaxcart__row">
      <label for="CartSpecialInstructions" class="txt--minor">{% endraw %}Ghi chú:{% raw %}</label>
      <textarea name="note" class="input-full ajaxcart__note" id="CartSpecialInstructions">{{note}}</textarea>
    </div> {% endraw %}{% endif %}{% raw %}
  </div>
</form>
{% endraw %}

</script>

<script id="FooterCartTemplate" type="text/template">
 {% raw %}
 <div class="cart-summary-breakdown">
   {{#if hasDiscount}}
   <div class="cart-summary-row">
     <span class="cart-summary-label">Tạm tính</span>
     <span class="cart-summary-value js-subtotal"><s>{{{totalLineItemsPrice}}}</s></span>
   </div>
   <div class="cart-summary-row cart-summary-row--saving">
     <span class="cart-summary-label">Tiết kiệm được</span>
     <span class="cart-summary-saving">-{{{totalDiscounts}}}</span>
   </div>
   {{else}}
   <div class="cart-summary-row">
     <span class="cart-summary-label">Tạm tính</span>
     <span class="cart-summary-value js-subtotal">{{{totalLineItemsPrice}}}</span>
   </div>
   {{/if}}
 </div>
 {% endraw %}
</script>

<script id="JsQty" type="text/template">
{% raw %}
<div class="js-qty">
	<button type="button" class="js-qty__adjust js-qty__adjust--minus items-count" data-id="{{key}}" data-qty="{{itemMinus}}" aria-label="{% endraw %}-{% raw %}">
	-
	</button>
	<input type="text" class="js-qty__num number-sidebar" maxlength="3" value="{{itemQty}}" min="1" data-id="{{key}}" aria-label="quantity" pattern="[0-9]*" name="{{inputName}}" id="{{inputId}}">
	<button type="button" class="js-qty__adjust js-qty__adjust--plus items-count" data-id="{{key}}" data-qty="{{itemAdd}}" aria-label="{% endraw %}+{% raw %}">
	+
	</button>
	</div>
{% endraw %}
</script>
{%- comment -%} 23/11/2026 (chủ dự án: «mobile vẫn giao diện thêm vào giỏ cũ — viết snippet dùng chung»): thông báo «đã thêm vào giỏ» = 1 snippet dùng chung cho MỌI màn hình và mọi nơi bấm thêm giỏ (trang SP, thẻ SP, quickview, tìm kiếm, kết quả soi da); đã gỡ toast mobile cũ (#popup-cart-mobile + ~140 dòng CSS) và HUD CSS riêng. {%- endcomment -%}
{%- include 'ui_cart_added' -%}

<style>
/* ── Dropdown Giỏ Hàng Header Chuẩn Shopee ── */
.top-cart-content {
  position: absolute;
  top: calc(100% + 4px);
  right: -8px;
  width: 360px;
  background: var(--white);
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(0, 0, 0, 0.08);
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  z-index: 10000;
  pointer-events: none;
}
.sudes-header-cart:hover .top-cart-content,
.top-cart-content:hover {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.pc-shopee-cart-dropdown {
  position: relative;
  display: flex;
  flex-direction: column;
}
.pc-shopee-cart-dropdown__arrow {
  position: absolute;
  top: -6px;
  right: 20px;
  width: 12px;
  height: 12px;
  background: var(--white);
  transform: rotate(45deg);
  border-left: 1px solid rgba(0, 0, 0, 0.08);
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  z-index: 1;
}
.pc-shopee-cart-dropdown__head {
  padding: 12px 14px 8px;
  font-family: var(--font-primary, 'Montserrat', sans-serif);
  font-size: var(--fs-xs, 12px);
  font-weight: 500;
  color: var(--pc-color-ink-muted);
  border-bottom: 1px solid var(--pc-color-line-soft);
}
.pc-shopee-cart-dropdown__body {
  max-height: 290px;
  overflow-y: auto;
  scrollbar-width: thin;
}
.pc-shopee-cart-dropdown__body::-webkit-scrollbar {
  width: 4px;
}
.pc-shopee-cart-dropdown__body::-webkit-scrollbar-thumb {
  background: var(--pc-color-line-control);
  border-radius: 4px;
}
.pc-shopee-cart-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  text-decoration: none !important;
  color: inherit;
  transition: background 0.15s ease;
}
.pc-shopee-cart-item:hover {
