{%- comment -%}
  snippets/ui_trust_badges.bwt — Khối 4 cam kết thương hiệu dùng chung (SSOT).
  Áp dụng đồng bộ cho: Trang chủ (section_portal_split), Trang chi tiết sản phẩm (product.bwt), và Trang danh mục (collection_hero).
  Layout: dạng thẻ tròn bo tròn nền trắng, icon FontAwesome/ui_icon, tiêu đề đậm + mô tả phụ (chuẩn theo collection_hero).
{%- endcomment -%}
<ul class="pc-trust-badges m-0 p-0 list-none grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
  <li class="flex items-center gap-2.5 sm:gap-3">
    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white text-primary border border-line-soft" aria-hidden="true">
      {% include 'ui_icon', name: 'shield-check', size: 18 %}
    </span>
    <span class="flex flex-col leading-tight min-w-0">
      <strong class="text-xs sm:text-sm font-bold text-ink">{{ settings.collection_hero_usp_1_title | default: settings.home_trust_1_title | default: '100% chính hãng' }}</strong>
      <small class="text-xs text-ink-muted mt-0.5">{{ settings.collection_hero_usp_1_desc | default: settings.home_trust_1_desc | default: 'Nguồn gốc rõ ràng' }}</small>
    </span>
  </li>
  <li class="flex items-center gap-2.5 sm:gap-3">
    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white text-primary border border-line-soft" aria-hidden="true">
      {% include 'ui_icon', name: 'message-circle', size: 18 %}
    </span>
    <span class="flex flex-col leading-tight min-w-0">
      <strong class="text-xs sm:text-sm font-bold text-ink">{{ settings.collection_hero_usp_2_title | default: settings.home_trust_2_title | default: 'Tư vấn chuyên sâu' }}</strong>
      <small class="text-xs text-ink-muted mt-0.5">{{ settings.collection_hero_usp_2_desc | default: settings.home_trust_2_desc | default: 'Đồng hành cùng da bạn' }}</small>
    </span>
  </li>
  <li class="flex items-center gap-2.5 sm:gap-3">
    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white text-primary border border-line-soft" aria-hidden="true">
      {% include 'ui_icon', name: 'truck', size: 18 %}
    </span>
    <span class="flex flex-col leading-tight min-w-0">
      <strong class="text-xs sm:text-sm font-bold text-ink">{{ settings.collection_hero_usp_3_title | default: settings.home_trust_3_title | default: 'Giao hàng nhanh' }}</strong>
      <small class="text-xs text-ink-muted mt-0.5">{{ settings.collection_hero_usp_3_desc | default: settings.home_trust_3_desc | default: 'Nhận hàng tận nhà' }}</small>
    </span>
  </li>
  <li class="flex items-center gap-2.5 sm:gap-3">
    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full bg-white text-primary border border-line-soft" aria-hidden="true">
      {% include 'ui_icon', name: 'gift', size: 18 %}
    </span>
    <span class="flex flex-col leading-tight min-w-0">
      <strong class="text-xs sm:text-sm font-bold text-ink">{{ settings.collection_hero_usp_4_title | default: settings.home_trust_4_title | default: 'Ưu đãi hấp dẫn' }}</strong>
      <small class="text-xs text-ink-muted mt-0.5">{{ settings.collection_hero_usp_4_desc | default: settings.home_trust_4_desc | default: 'Chính sách công khai' }}</small>
    </span>
  </li>
</ul>
