{%- comment -%}
  quiz_safety_copy (2026-10-05) — câu chữ phân tầng/an toàn AI Skin Quiz, dùng chung trang quiz + trang kết
  quả (in 1 object JS). Cấu hình: Theme Settings → nhóm AI Skin → "Phân tầng & an toàn khảo sát".
{%- endcomment -%}
{%- assign pc_qs_zalo = settings.contact_zalo | default: settings.store_phone | remove: ' ' | remove: '.' -%}
{
  redFlagTitle: {{ settings.quiz_red_flag_title | default: 'Cần chuyên gia đánh giá trực tiếp' | json }},
  redFlagText: {{ settings.quiz_red_flag_text | default: 'Dấu hiệu bạn chọn có thể là tình trạng cấp tính. Hãy tạm ngưng các sản phẩm đang dùng, không thử thêm sản phẩm mới và liên hệ chuyên gia sớm nhất. Nếu sưng đỏ lan nhanh hoặc kèm sốt, hãy đến cơ sở y tế ngay.' | json }},
  tier2Note: {{ settings.quiz_tier2_note | default: 'Mức độ này nên được chuyên gia đánh giá trực tiếp trước khi bắt đầu routine. Routine dưới đây chỉ để tham khảo.' | json }},
  pregnancyNote: {{ settings.quiz_pregnancy_note | default: 'Bạn đang mang thai, cho con bú hoặc có kế hoạch mang thai: các bước có Retinoid, BHA, AHA hoặc Cysteamine đã được ẩn — chuyên gia sẽ chỉ định riêng.' | json }},
  allergyNote: {{ settings.quiz_allergy_note | default: 'Bạn có tiền sử dị ứng hoặc kích ứng nặng: các bước có hoạt chất mạnh đã được ẩn — chuyên gia sẽ chỉ định riêng.' | json }},
  blockedStepLabel: {{ settings.quiz_blocked_step_label | default: 'Cần chuyên gia chỉ định riêng' | json }},
  noProductLabel: {{ settings.quiz_no_product_label | default: 'Tìm sản phẩm phù hợp' | json }},
  zaloLabel: {{ settings.quiz_zalo_cta_label | default: 'Liên hệ chuyên gia qua Zalo' | json }},
  zaloUrl: {% if pc_qs_zalo != blank %}{{ 'https://zalo.me/' | append: pc_qs_zalo | json }}{% else %}"/pages/dat-lich-tu-van"{% endif %}
}
