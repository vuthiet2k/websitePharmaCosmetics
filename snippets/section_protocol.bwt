<style>
  .pc-protocol-section { background-color: var(--primary-forest-900, #0F2318); padding: 48px 0; border-bottom: 1px solid #064E3B; color:#fff; }
  .pc-protocol-wrap { display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-items:center; margin-top:28px; }
  .pc-protocol-steps > div { padding:22px; border:1px solid #22543D; border-radius:10px; margin-bottom:14px; cursor:pointer; transition:background .25s,border-color .25s; }
  .pc-protocol-steps > div:last-child { margin-bottom:0; }
  .pc-protocol-steps > div.is-active { background:var(--primary-forest-800, #166B55); border-color: var(--primary-emerald-600, #3CB371); }
  .pc-protocol-tag { display:inline-block; font-size:11px; font-weight:700; border-radius:6px; padding:4px 10px; background:#1E3A2B; color:#34D399; margin-bottom:10px; }
  .pc-protocol-steps h3 { font-size:16px; font-weight:800; color:#fff; margin-bottom:8px; }
  .pc-protocol-steps p { font-size:13px; color:#CBD5E1; max-height:0; overflow:hidden; opacity:0; transition:max-height .3s,opacity .3s; }
  .pc-protocol-steps > div.is-active p { max-height:100px; opacity:1; }
  .pc-protocol-visual { aspect-ratio:4/5; border-radius:12px; border:1px solid #22543D; background:var(--primary-forest-800, #166B55); position:relative; overflow:hidden; }
  .pc-protocol-visual .pc-protocol-icon { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .4s; }
  .pc-protocol-visual .pc-protocol-icon.is-active { opacity:1; }
  .pc-protocol-visual svg { width:42%; }
  @media (max-width: 900px) {
    .pc-protocol-wrap { grid-template-columns:1fr; }
    .pc-protocol-visual { aspect-ratio:16/9; }
  }
</style>
<section class="pc-protocol-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--primary-emerald-600, #3CB371);">Quy Trình Khoa Học Chứng Minh</span>
    <h2 class="text-2xl sm:text-3xl font-extrabold font-heading mt-2 text-white">Phác Đồ Điều Trị &amp; Phục Hồi Da 3 Bước Chuẩn Clinic</h2>

    <div class="pc-protocol-wrap" id="pcProtocol">
      <div class="pc-protocol-steps">
        <div class="is-active" data-step="0">
          <span class="pc-protocol-tag">BƯỚC 01 &bull; CHẨN ĐOÁN DA</span>
          <h3>Soi Da &amp; Phân Tích Chỉ Số Y Khoa</h3>
          <p>Đánh giá chính xác mức độ tổn thương màng lipid, mật độ sắc tố và tuyến bã nhờn bằng thiết bị chuyên dụng.</p>
        </div>
        <div data-step="1">
          <span class="pc-protocol-tag">BƯỚC 02 &bull; PHÁC ĐỒ ĐIỀU TRỊ</span>
          <h3>Kê Đơn Dược Mỹ Phẩm Cá Nhân Hóa</h3>
          <p>Chuyên gia Da liễu xây dựng liệu trình phối hợp hoạt chất nồng độ chính xác, hạn chế tối đa nguy cơ kích ứng.</p>
        </div>
        <div data-step="2">
          <span class="pc-protocol-tag">BƯỚC 03 &bull; ĐỒNG HÀNH 1:1</span>
          <h3>Theo Dõi &amp; Tối Ưu Hàng Tuần</h3>
          <p>Đội ngũ chuyên viên theo dõi sát sao tiến trình phục hồi, điều chỉnh liều lượng đảm bảo hiệu quả tối đa.</p>
        </div>
      </div>
      <div class="pc-protocol-visual">
        <div class="pc-protocol-icon is-active" data-icon="0">
          <svg viewBox="0 0 200 200" fill="none"><circle cx="100" cy="90" r="52" stroke="#3CB371" stroke-width="2"/><circle cx="100" cy="90" r="32" stroke="#3CB371" stroke-width="1" stroke-dasharray="2 5" opacity=".6"/><circle cx="100" cy="90" r="6" fill="#3CB371"/><path d="M100 38v14M100 128v14M48 90h14M138 90h14" stroke="#34D399" stroke-width="2"/></svg>
        </div>
        <div class="pc-protocol-icon" data-icon="1">
          <svg viewBox="0 0 200 200" fill="none"><rect x="60" y="50" width="80" height="100" rx="6" stroke="#3CB371" stroke-width="2"/><path d="M75 75h50M75 92h50M75 109h30" stroke="#34D399" stroke-width="2.5"/><circle cx="140" cy="130" r="16" fill="#0F2318" stroke="#3CB371" stroke-width="2"/><path d="M134 130l4 5 8-9" stroke="#34D399" stroke-width="2"/></svg>
        </div>
        <div class="pc-protocol-icon" data-icon="2">
          <svg viewBox="0 0 200 200" fill="none"><circle cx="100" cy="100" r="52" stroke="#3CB371" stroke-width="2"/><path d="M100 68v32l22 14" stroke="#34D399" stroke-width="3" stroke-linecap="round"/><circle cx="100" cy="100" r="4" fill="#3CB371"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var wrap = document.getElementById('pcProtocol');
  if (!wrap) return;
  var steps = Array.prototype.slice.call(wrap.querySelectorAll('.pc-protocol-steps > div'));
  var icons = Array.prototype.slice.call(wrap.querySelectorAll('.pc-protocol-icon'));
  function activate(idx){
    steps.forEach(function(s){ s.classList.remove('is-active'); });
    icons.forEach(function(i){ i.classList.remove('is-active'); });
    steps[idx].classList.add('is-active');
    icons[idx].classList.add('is-active');
  }
  steps.forEach(function(step, idx){
    step.addEventListener('mouseenter', function(){ activate(idx); });
    step.addEventListener('click', function(){ activate(idx); });
  });
})();
</script>
