<div class="main-widget">
	<div class="def-content">
		<div class="def-header">
			Liên hệ với chúng tôi
			<div class="close-icon close-widget-btn" title="Đóng" role="button" tabindex="0" aria-label="Đóng bảng liên hệ">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
					<path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
				</svg>
			</div>
		</div>
		<div class="contact-list">
			<div class="item phone">
				<a href="{% if settings.store_edit %}tel:{{ settings.store_phone | remove: ' '}}{% else %}tel:{{ store.phone_number | remove: ' '}}{% endif %}">
					<span class="img">
						<svg width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg>
					</span>
					<div class="detail">
						<b class="arcu-item-title">Gọi điện</b>
						<span class="arcu-item-subtitle">
							{%- if settings.store_edit -%}{%- assign _ph = settings.store_phone | remove: ' ' | remove: '.' -%}{%- else -%}{%- assign _ph = store.phone_number | remove: ' ' | remove: '.' -%}{%- endif -%}
							{{ _ph | slice: 0, 4 }}.{{ _ph | slice: 4, 3 }}.{{ _ph | slice: 7, 3 }}
						</span>
					</div>
				</a>
			</div>
			{%if settings.contact_zalo_enable%}
			<div class="item zalo">
				<a target="_blank" href="https://zalo.me/{{ settings.contact_zalo | remove: ' '}}">
					<span class="img">
						<svg width="16" height="15.978" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 614.501 613.667" xml:space="preserve"><path fill="currentColor" d="M464.721,301.399c-13.984-0.014-23.707,11.478-23.944,28.312c-0.251,17.771,9.168,29.208,24.037,29.202   c14.287-0.007,23.799-11.095,24.01-27.995C489.028,313.536,479.127,301.399,464.721,301.399z"></path><path fill="currentColor" d="M291.83,301.392c-14.473-0.316-24.578,11.603-24.604,29.024c-0.02,16.959,9.294,28.259,23.496,28.502   c15.072,0.251,24.592-10.87,24.539-28.707C315.214,313.318,305.769,301.696,291.83,301.392z"></path><path fill="currentColor" d="M310.518,3.158C143.102,3.158,7.375,138.884,7.375,306.3s135.727,303.142,303.143,303.142   c167.415,0,303.143-135.727,303.143-303.142S477.933,3.158,310.518,3.158z M217.858,391.083   c-33.364,0.818-66.828,1.353-100.133-0.343c-21.326-1.095-27.652-18.647-14.248-36.583c21.55-28.826,43.886-57.065,65.792-85.621   c2.546-3.305,6.214-5.996,7.15-12.705c-16.609,0-32.784,0.04-48.958-0.013c-19.195-0.066-28.278-5.805-28.14-17.652   c0.132-11.768,9.175-17.329,28.397-17.348c25.159-0.026,50.324-0.06,75.476,0.026c9.637,0.033,19.604,0.105,25.304,9.789   c6.22,10.561,0.284,19.512-5.646,27.454c-21.26,28.497-43.015,56.624-64.559,84.902c-2.599,3.41-5.119,6.88-9.453,12.725   c23.424,0,44.123-0.053,64.816,0.026c8.674,0.026,16.662,1.873,19.941,11.267C237.892,379.329,231.368,390.752,217.858,391.083z    M350.854,330.211c0,13.417-0.093,26.841,0.039,40.265c0.073,7.599-2.599,13.647-9.512,17.084   c-7.296,3.642-14.71,3.028-20.304-2.968c-3.997-4.281-6.214-3.213-10.488-0.422c-17.955,11.728-39.908,9.96-56.597-3.866   c-29.928-24.789-30.026-74.803-0.211-99.776c16.194-13.562,39.592-15.462,56.709-4.143c3.951,2.619,6.201,4.815,10.396-0.053   c5.39-6.267,13.055-6.761,20.271-3.357c7.454,3.509,9.935,10.165,9.776,18.265C350.67,304.222,350.86,317.217,350.854,330.211z    M395.617,369.579c-0.118,12.837-6.398,19.783-17.196,19.908c-10.779,0.132-17.593-6.966-17.646-19.512   c-0.179-43.352-0.185-86.696,0.007-130.041c0.059-12.256,7.302-19.921,17.896-19.222c11.425,0.752,16.992,7.448,16.992,18.833   c0,22.104,0,44.216,0,66.327C395.677,327.105,395.828,348.345,395.617,369.579z M463.981,391.868   c-34.399-0.336-59.037-26.444-58.786-62.289c0.251-35.66,25.304-60.713,60.383-60.396c34.631,0.304,59.374,26.306,58.998,61.986   C524.207,366.492,498.534,392.205,463.981,391.868z"></path></svg>
					</span>
					<div class="detail">
						<b class="arcu-item-title">Zalo</b>
						<span class="arcu-item-subtitle">Kết nối Zalo</span>
					</div>
				</a>
			</div>
			{%endif%}
			{%- comment -%} 2026-10-19: mục Soi da AI (miễn phí) — dẫn tới trang khám da AI, tab camera (cùng link nút soi da ở giỏ hàng). {%- endcomment -%}
			{%- if settings.contact_skinscan_enable -%}
			<div class="item skinscan">
				<a href="{{ settings.contact_skinscan_url | default: '/kham-da-ai?tab=camera' | escape }}">
					<span class="img"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'camera', size: 'em' %}</i></span>
					<div class="detail">
						<b class="arcu-item-title">{{ settings.contact_skinscan_title | default: 'Soi da AI' }}</b>
						<span class="arcu-item-subtitle">{{ settings.contact_skinscan_sub | default: 'Phân tích da miễn phí' }}</span>
					</div>
				</a>
			</div>
			{%- endif -%}
			{%if settings.contact_messenger_enable%}
			<div class="item mess">
				<a target="_blank" href="https://m.me/{{ settings.contact_messenger | remove: 'https://www.facebook.com/' | remove: '/' | split: '?' | first }}">
					<span class="img">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-messenger" viewBox="0 0 16 16">
							<path d="M0 7.76C0 3.301 3.493 0 8 0s8 3.301 8 7.76-3.493 7.76-8 7.76c-.81 0-1.586-.107-2.316-.307a.639.639 0 0 0-.427.03l-1.588.702a.64.64 0 0 1-.898-.566l-.044-1.423a.639.639 0 0 0-.215-.456C.956 12.108 0 10.092 0 7.76zm5.546-1.459-2.35 3.728c-.225.358.214.761.551.506l2.525-1.916a.48.48 0 0 1 .578-.002l1.869 1.402a1.2 1.2 0 0 0 1.735-.32l2.35-3.728c.226-.358-.214-.761-.551-.506L9.728 7.381a.48.48 0 0 1-.578.002L7.281 5.98a1.2 1.2 0 0 0-1.735.32z"/>
						</svg>
					</span>
					<div class="detail">
						<b class="arcu-item-title">Messenger</b>
						<span class="arcu-item-subtitle">Pharma Cosmetics</span>
					</div>
				</a>
			</div>
			{%endif%}
			{%if settings.contact_whatsapp_enable%}
			<div class="item whatsapp">
				<a target="_blank" href="https://wa.me/{{ settings.contact_whatsapp | remove: ' ' | remove: '+' | remove: '-'}}">
					<span class="img">
						<svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
					</span>
					<div class="detail">
						{%- assign _wa = settings.contact_whatsapp | remove: ' ' | remove: '+' -%}
						{%- assign _wa2 = _wa | slice: 2, 9 -%}
						<b class="arcu-item-title">WhatsApp</b>
						<span class="arcu-item-subtitle">+{{ _wa | slice: 0, 2 }} {{ _wa2 | slice: 0, 3 }} {{ _wa2 | slice: 3, 3 }} {{ _wa2 | slice: 6, 3 }}</span>
					</div>
				</a>
			</div>
			{%endif%}
			{%if settings.contact_map_enable%}
			<div class="item map">
				<a target="_blank" href="{{settings.contact_map}}">
					<span class="img">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pin-map" viewBox="0 0 16 16">
							<path fill-rule="evenodd" d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8l3-4z"/>
							<path fill-rule="evenodd" d="M8 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z"/>
						</svg>	
					</span>
					<div class="detail">
						<b class="arcu-item-title">{{settings.contact_map_title}}</b>
						<span class="arcu-item-subtitle">Xem địa chỉ cửa hàng</span>
					</div>
				</a>
			</div>
			{%endif%}
		</div>
		{%- comment -%} 09/11/2026: nút «Ẩn nút liên hệ» trong bảng chuyển thành nút X ở góc robot (.pc-widget-dismiss, cùng data-contact-hide) — không để 2 nút trùng việc. {%- endcomment -%}
	</div>

	{%- comment -%} 2026-10-19: linh vật robot Pharma Cosmetics vẫy tay (GIF 96px nền trong suốt, ~55KB, cắt từ video CapCut)
	  thay cụm icon xoay vòng — nút liên hệ sinh động, dễ chú ý hơn. Tắt support_mascot_enable ⇒ về icon cũ;
	  Ảnh = field image "support_mascot.gif" (Admin tải ảnh mới ⇒ ghi đè assets/support_mascot.gif mặc định). {%- endcomment -%}
	{%- assign pc_mascot = false -%}
	{%- if settings.support_mascot_enable -%}{%- assign pc_mascot = true -%}{%- endif -%}
	<div class="pc-chat-btn-wrapper group" id="toggle-widget-btn" role="button" aria-label="Chat hỗ trợ">
		<span class="pc-chat-pill min-[1024px]:max-[1599px]:!hidden min-[1024px]:max-[1599px]:group-hover:!inline-flex" aria-hidden="true">
			<span class="pc-chat-pill-text-desktop">Chat hỗ trợ</span>
			<span class="pc-chat-pill-text-mobile">Hỗ trợ</span>
		</span>
		<div class="out-circle{% if pc_mascot %} has-mascot{% endif %}">
		<div class="pregan"></div>
		<div class="pregan"></div>
		{%- if pc_mascot -%}
		<img class="pc-support-mascot widget-toggle-elem" src="{{ 'support_mascot.gif' | asset_url }}" width="96" height="96" loading="lazy" decoding="async" alt="{{ settings.support_mascot_alt | default: 'Liên hệ tư vấn Pharma Cosmetics' | escape }}">
		{%- else -%}
		<div class="main-icon widget-toggle-elem">
			<svg width="20" height="20" viewBox="0 0 20 20" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g transform="translate(-825 -308)"><g><path transform="translate(825 308)" fill="#FFFFFF" d="M 19 4L 17 4L 17 13L 4 13L 4 15C 4 15.55 4.45 16 5 16L 16 16L 20 20L 20 5C 20 4.45 19.55 4 19 4ZM 15 10L 15 1C 15 0.45 14.55 0 14 0L 1 0C 0.45 0 0 0.45 0 1L 0 15L 4 11L 14 11C 14.55 11 15 10.55 15 10Z"></path></g></g></svg>
		</div>

		<div class="ser-icon widget-toggle-elem">
			<div class="process">
				<span class="img phone item active-icon"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 512 512"><path fill="currentColor" d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg></span>
				{%if settings.contact_zalo_enable%}<span class="img zalo item">
				<span class="img">
					<svg width="16" height="15.978" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 614.501 613.667" xml:space="preserve"><path fill="currentColor" d="M464.721,301.399c-13.984-0.014-23.707,11.478-23.944,28.312c-0.251,17.771,9.168,29.208,24.037,29.202c14.287-0.007,23.799-11.095,24.01-27.995C489.028,313.536,479.127,301.399,464.721,301.399z"></path><path fill="currentColor" d="M291.83,301.392c-14.473-0.316-24.578,11.603-24.604,29.024c-0.02,16.959,9.294,28.259,23.496,28.502c15.072,0.251,24.592-10.87,24.539-28.707C315.214,313.318,305.769,301.696,291.83,301.392z"></path><path fill="currentColor" d="M310.518,3.158C143.102,3.158,7.375,138.884,7.375,306.3s135.727,303.142,303.143,303.142c167.415,0,303.143-135.727,303.143-303.142S477.933,3.158,310.518,3.158z M217.858,391.083c-33.364,0.818-66.828,1.353-100.133-0.343c-21.326-1.095-27.652-18.647-14.248-36.583c21.55-28.826,43.886-57.065,65.792-85.621c2.546-3.305,6.214-5.996,7.15-12.705c-16.609,0-32.784,0.04-48.958-0.013c-19.195-0.066-28.278-5.805-28.14-17.652c0.132-11.768,9.175-17.329,28.397-17.348c25.159-0.026,50.324-0.06,75.476,0.026c9.637,0.033,19.604,0.105,25.304,9.789c6.22,10.561,0.284,19.512-5.646,27.454c-21.26,28.497-43.015,56.624-64.559,84.902c-2.599,3.41-5.119,6.88-9.453,12.725c23.424,0,44.123-0.053,64.816,0.026c8.674,0.026,16.662,1.873,19.941,11.267C237.892,379.329,231.368,390.752,217.858,391.083z M350.854,330.211c0,13.417-0.093,26.841,0.039,40.265c0.073,7.599-2.599,13.647-9.512,17.084c-7.296,3.642-14.71,3.028-20.304-2.968c-3.997-4.281-6.214-3.213-10.488-0.422c-17.955,11.728-39.908,9.96-56.597-3.866c-29.928-24.789-30.026-74.803-0.211-99.776c16.194-13.562,39.592-15.462,56.709-4.143c3.951,2.619,6.201,4.815,10.396-0.053c5.39-6.267,13.055-6.761,20.271-3.357c7.454,3.509,9.935,10.165,9.776,18.265C350.67,304.222,350.86,317.217,350.854,330.211z M395.617,369.579c-0.118,12.837-6.398,19.783-17.196,19.908c-10.779,0.132-17.593-6.966-17.646-19.512c-0.179-43.352-0.185-86.696,0.007-130.041c0.059-12.256,7.302-19.921,17.896-19.222c11.425,0.752,16.992,7.448,16.992,18.833c0,22.104,0,44.216,0,66.327C395.677,327.105,395.828,348.345,395.617,369.579z M463.981,391.868c-34.399-0.336-59.037-26.444-58.786-62.289c0.251-35.66,25.304-60.713,60.383-60.396c34.631,0.304,59.374,26.306,58.998,61.986C524.207,366.492,498.534,392.205,463.981,391.868z"></path></svg></span>
				</span>{%endif%}
				{%if settings.contact_messenger_enable%}
				<span class="img mess item">
					<span class="img"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 7.76C0 3.301 3.493 0 8 0s8 3.301 8 7.76-3.493 7.76-8 7.76c-.81 0-1.586-.107-2.316-.307a.639.639 0 0 0-.427.03l-1.588.702a.64.64 0 0 1-.898-.566l-.044-1.423a.639.639 0 0 0-.215-.456C.956 12.108 0 10.092 0 7.76zm5.546-1.459-2.35 3.728c-.225.358.214.761.551.506l2.525-1.916a.48.48 0 0 1 .578-.002l1.869 1.402a1.2 1.2 0 0 0 1.735-.32l2.35-3.728c.226-.358-.214-.761-.551-.506L9.728 7.381a.48.48 0 0 1-.578.002L7.281 5.98a1.2 1.2 0 0 0-1.735.32z"/></svg></span>
				</span>{%endif%}
				{%if settings.contact_whatsapp_enable%}
				<span class="img whatsapp item">
					<span class="img"><svg width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span>
				</span>{%endif%}
				{%if settings.contact_map_enable%}
				<span class="img map item">
					<span class="img"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8l3-4z"/><path fill-rule="evenodd" d="M8 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z"/></svg></span>
				</span>{%endif%}
			</div>
		</div>
		{%- endif -%}

		<div class="close-icon-main close-widget-elem">
			<i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'x', size: 'em' %}</i>
		</div>
	</div>
	{%- comment -%} 09/11/2026 (chủ dự án: robot liên hệ đè thẻ SP trên mobile, không có nút X, không kéo được): nút X ẩn nhanh
	  ngay góc robot (cùng cơ chế data-contact-hide của «Ẩn nút liên hệ» — hiện lại ở chân trang), vùng chạm 44px. {%- endcomment -%}
		<button type="button" class="pc-widget-dismiss" data-contact-hide aria-label="Ẩn nút liên hệ"><span class="pc-widget-dismiss__dot" aria-hidden="true">{% include 'ui_icon', name: 'x', size: 'em' %}</span></button>
	</div>
</div>

<script>
	// 1. Toggle widget — vanilla delegation chạy NGAY lúc parse (không chờ $(ready)/main.js)
	// để nút Liên hệ bấm được tức thì trong lúc trang còn đang load
	document.addEventListener('click', function(e){
		var t = e.target.closest ? e.target.closest('#toggle-widget-btn, .close-widget-btn') : null;
		if (!t) return;
		e.preventDefault();
		var w = document.querySelector('.main-widget');
		if (w) w.classList.toggle('widget-opened');
	});
	// 09/11/2026: nút X đầu bảng là <div role=button> ⇒ Enter / Space đóng bảng như bấm chuột
	document.addEventListener('keydown', function(e){
		if ((e.key === 'Enter' || e.key === ' ') && e.target.closest && e.target.closest('.close-widget-btn')) { e.preventDefault(); e.target.click(); }
	});

	// D02 (phase home-shopping-ux, 2026-09-20): 3 trạng thái — thu gọn (mặc định), mở panel
	// (widget-opened, xử lý ở khối trên) và ẩn hoàn toàn (widget-hidden, khối này). Ẩn hoàn toàn
	// dùng display:none thật (không chỉ ẩn thị giác) nên phần tử không còn bắt được click/focus.
	// Lưu lựa chọn qua sessionStorage; nếu storage bị chặn (Safari riêng tư, v.v.) thì coi như
	// không lưu được và luôn hiện lại — không lỗi vỡ trang.
	(function(){
		var STORE_KEY = 'pc_contact_widget_hidden';
		var widget = document.querySelector('.main-widget');
		if (!widget) return;
		function readHidden(){
			try { return sessionStorage.getItem(STORE_KEY) === '1'; } catch(e){ return false; }
		}
		function setHidden(hide){
			if (hide && document.activeElement && widget.contains(document.activeElement)) {
				document.activeElement.blur();
			}
			widget.classList.toggle('widget-hidden', hide);
			widget.setAttribute('aria-hidden', hide ? 'true' : 'false');
			try {
				if (hide) { sessionStorage.setItem(STORE_KEY, '1'); } else { sessionStorage.removeItem(STORE_KEY); }
			} catch(e) {}
		}
		if (readHidden()) setHidden(true);
		document.addEventListener('click', function(e){
			if (!e.target.closest) return;
			if (e.target.closest('[data-contact-hide]')) { e.preventDefault(); setHidden(true); }
			if (e.target.closest('[data-contact-show]')) { e.preventDefault(); setHidden(false); }
		});
	})();
	// 18/11/2026: Nút chat cố định ở giữa mép phải (top: 50%, right: 16px, translateY(-50%))
	(function(){
		try { localStorage.removeItem('pc_contact_widget_pos'); } catch(e){}
	})();
	$(function(){
		// 2. Logic Carousel Icon: Dùng Fade (mờ dần) thay vì trượt ngang bằng tọa độ (Rất mượt)
		var $carouselItems = $('.ser-icon .process .item');
		if ($carouselItems.length > 1) {
			var currentIndex = 0;
			setInterval(function(){
				// Nếu người dùng đang mở menu hoặc đã ẩn hoàn toàn cụm liên hệ, tạm dừng hiệu ứng
				// chuyển icon — vừa đỡ rối mắt, vừa khỏi chạy animation vô ích khi display:none.
				if ($('.main-widget').hasClass('widget-opened') || $('.main-widget').hasClass('widget-hidden')) return;

				$carouselItems.eq(currentIndex).removeClass('active-icon');
				currentIndex = (currentIndex + 1) % $carouselItems.length;
				$carouselItems.eq(currentIndex).addClass('active-icon');
			}, 2500); // Mỗi 2.5s sẽ fade sang icon tiếp theo
		}
	});
</script>

<style>
/* --- VỊ TRÍ MỚI (CHỐT 18/11/2026): GIỮA MÉP PHẢI + NHÃN CHAT HỖ TRỢ --- */
.main-widget {
	position: fixed;
	top: 50%;
	right: 16px;
	bottom: auto;
	transform: translateY(-50%);
	z-index: 9991;
	display: flex;
	align-items: center;
	pointer-events: auto;
}

.pc-chat-btn-wrapper {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	position: relative;
	cursor: pointer;
	-webkit-user-select: none;
	user-select: none;
}

/* Nhãn "Chat hỗ trợ": nền #1F5C45, chữ trắng, Montserrat 600, bo tròn */
.pc-chat-pill {
	background: var(--pc-color-chat-label);
	color: var(--white);
	font-family: Montserrat, sans-serif;
	font-weight: 600;
	font-size: var(--fs-sm);
	padding: 8px 16px;
	border-radius: 9999px;
	white-space: nowrap;
	box-shadow: 0 4px 14px rgba(31, 92, 69, 0.35);
	transition: all 0.25s ease;
	line-height: 1.2;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}
.pc-chat-btn-wrapper:hover .pc-chat-pill {
	filter: brightness(1.1);
	transform: scale(1.03);
}

.pc-chat-pill-text-desktop { display: inline; }
.pc-chat-pill-text-mobile { display: none; }

/* Nút × đóng widget di chuyển theo nút chat */
.pc-widget-dismiss {
	position: absolute;
	top: -14px;
	right: -12px;
	z-index: 5;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 52px; /* 52 × 0.85 (mobile) ≈ 44px vùng chạm tối thiểu */
	height: 52px;
	padding: 0;
	margin: 0;
	background: transparent;
	border: 0;
	border-radius: 50%;
	cursor: pointer;
}
.pc-widget-dismiss__dot {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 20px;
	height: 20px;
	border-radius: 50%;
	background: rgba(17, 24, 39, .75);
	color: var(--white);
	font-size: var(--fs-xs);
	line-height: 1;
	box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
}
.pc-widget-dismiss:hover .pc-widget-dismiss__dot {
	background: rgba(17, 24, 39, .95);
}

/* Robot mascot */
.out-circle {
	cursor: pointer;
	position: relative;
	width: 64px;
	height: 64px;
}
.out-circle.has-mascot {
	padding: 0;
	overflow: visible;
	background: transparent;
}
.out-circle.has-mascot .pregan,
.out-circle.has-mascot .close-icon-main {
	display: none;
}
.out-circle.has-mascot .pc-support-mascot {
	position: absolute;
	left: 50%;
	top: 50%;
	display: block;
	width: 76px;
	height: 76px;
	max-width: none;
	transform: translate(-50%, -50%);
	filter: drop-shadow(0 6px 8px rgba(0, 46, 35, .35)) drop-shadow(0 2px 2px rgba(0, 0, 0, .18));
	transition: transform 0.3s ease, filter 0.3s ease;
}
.pc-chat-btn-wrapper:hover .pc-support-mascot,
.main-widget.widget-opened .pc-support-mascot {
	transform: translate(-50%, -54%) scale(1.06);
	filter: drop-shadow(0 10px 12px rgba(0, 46, 35, .38)) drop-shadow(0 3px 3px rgba(0, 0, 0, .2));
}

/* Bảng menu liên hệ: mở sang bên trái nút chat */
.main-widget .def-content {
	position: absolute;
	right: calc(100% + 14px);
	top: 50%;
	transform: translateY(-50%) scale(0.9);
	transform-origin: right center;
	margin: 0;
	bottom: auto;
	visibility: hidden;
	opacity: 0;
	transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1.2);
	pointer-events: none;
}
.main-widget.widget-opened .def-content {
	visibility: visible;
	opacity: 1;
	transform: translateY(-50%) scale(1);
	pointer-events: auto;
}
.main-widget .def-content::before {
	content: "";
	position: absolute;
	top: 50%;
	right: -8px;
	transform: translateY(-50%);
	border-width: 8px 0 8px 8px;
	border-style: solid;
	border-color: transparent transparent transparent var(--white);
	display: block;
}

/* Nút đóng bảng bên trong def-header */
.main-widget .def-header .close-widget-btn::after { content: ""; position: absolute; inset: -8px; border-radius: 50%; }
.main-widget .def-header .close-widget-btn:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }
.main-widget.widget-opened .pc-widget-dismiss { display: none; }

/* Mobile: thu nhỏ 85%, nhãn rút gọn "Hỗ trợ" */
@media (max-width: 991px) {
	.main-widget {
		top: 50%;
		right: 12px;
		bottom: auto;
		transform: translateY(-50%) scale(0.85);
		transform-origin: right center;
	}
	.pc-chat-pill {
		padding: 6px 12px;
		font-size: var(--fs-xs);
	}
	.pc-chat-pill-text-desktop { display: none; }
	.pc-chat-pill-text-mobile { display: inline; }
	.out-circle {
		width: 58px;
		height: 58px;
	}
	.out-circle.has-mascot .pc-support-mascot {
		width: 68px;
		height: 68px;
	}
	.main-widget .def-content {
		right: 0;
		top: auto;
		bottom: calc(100% + 14px);
		transform: translateY(20px) scale(0.9);
		transform-origin: bottom right;
		margin-right: 0;
	}
	.main-widget.widget-opened .def-content {
		transform: translateY(0) scale(1);
	}
	.main-widget .def-content::before {
		top: auto;
		bottom: -8px;
		right: 24px;
		transform: none;
		border-width: 8px 8px 0 8px;
		border-color: var(--white) transparent transparent transparent;
	}
}

/* Trạng thái ẩn hoàn toàn */
.main-widget.widget-hidden {
	display: none !important;
}
@media (prefers-reduced-motion: reduce) {
	.main-widget, .pc-chat-pill, .pc-support-mascot, .main-widget .def-content { transition: none; }
}
</style>