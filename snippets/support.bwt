				</span>{%endif%}
				{%if settings.contact_messenger_enable%}
				<span class="img mess item">
					<span class="img"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 7.76C0 3.301 3.493 0 8 0s8 3.301 8 7.76-3.493 7.76-8 7.76c-.81 0-1.586-.107-2.316-.307a.639.639 0 0 0-.427.03l-1.588.702a.64.64 0 0 1-.898-.566l-.044-1.423a.639.639 0 0 0-.215-.456C.956 12.108 0 10.092 0 7.76zm5.546-1.459-2.35 3.728c-.225.358.214.761.551.506l2.525-1.916a.48.48 0 0 1 .578-.002l1.869 1.402a1.2 1.2 0 0 0 1.735-.32l2.35-3.728c.226-.358-.214-.761-.551-.506L9.728 7.381a.48.48 0 0 1-.578.002L7.281 5.98a1.2 1.2 0 0 0-1.735.32z"/></svg></span>
				</span>{%endif%}
				{%if settings.contact_whatsapp_enable%}
				<span class="img whatsapp item">
					<span class="img"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span>
				</span>{%endif%}
				{%if settings.contact_map_enable%}
				<span class="img map item">
					<span class="img"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M3.1 11.2a.5.5 0 0 1 .4-.2H6a.5.5 0 0 1 0 1H3.75L1.5 15h13l-2.25-3H10a.5.5 0 0 1 0-1h2.5a.5.5 0 0 1 .4.2l3 4a.5.5 0 0 1-.4.8H.5a.5.5 0 0 1-.4-.8l3-4z"/><path fill-rule="evenodd" d="M8 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM4 4a4 4 0 1 1 4.5 3.969V13.5a.5.5 0 0 1-1 0V7.97A4 4 0 0 1 4 3.999z"/></svg></span>
				</span>{%endif%}
			</div>
		</div>

		<div class="close-icon-main close-widget-elem">
			<i class="fas fa-xmark"></i>
		</div>
	</div>
</div>

<script>
	// 1. Toggle widget — vanilla delegation chạy NGAY lúc parse (không chờ $(ready)/main.js)
	// để nút Liên hệ bấm được tức thì trong lúc trang còn đang load
	document.addEventListener('click', function(e){
		var t = e.target.closest ? e.target.closest('#toggle-widget-btn, .close-widget-btn') : null;
		if (!t) return;
		e.preventDefault();
		var w = document.querySelector('.main-widget');
		if (w) w.classList.toggle('widget-opened');
	});
	$(function(){
		// 2. Logic Carousel Icon: Dùng Fade (mờ dần) thay vì trượt ngang bằng tọa độ (Rất mượt)
		var $carouselItems = $('.ser-icon .process .item');
		if ($carouselItems.length > 1) {
			var currentIndex = 0;
			setInterval(function(){
				// Nếu người dùng đang mở menu, tạm dừng hiệu ứng chuyển icon để đỡ rối mắt
				if ($('.main-widget').hasClass('widget-opened')) return; 

				$carouselItems.eq(currentIndex).removeClass('active-icon');
				currentIndex = (currentIndex + 1) % $carouselItems.length;
				$carouselItems.eq(currentIndex).addClass('active-icon');
			}, 2500); // Mỗi 2.5s sẽ fade sang icon tiếp theo
		}
	});
</script>

<style>
/* --- TRẠNG THÁI MẶC ĐỊNH (ĐÓNG) --- */
.main-widget .def-content {
    visibility: hidden;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transform-origin: bottom right;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1.2); /* Hiệu ứng nảy nhẹ (bounce) */
    pointer-events: none;
}

.out-circle {
	cursor: pointer;
	position: relative;
}

/* Xử lý chuyển đổi Icon bên trong nút (Fade Effect) */
.ser-icon .process {
	position: relative;
	width: 100%; 
	height: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
}
.ser-icon .process .item {
	position: absolute;
	opacity: 0;
	transform: scale(0.5);
	transition: all 0.4s ease-in-out;
	margin: 0;
}
.ser-icon .process .item.active-icon {
	opacity: 1;
	transform: scale(1);
}

/* Nút X ở ngoài bị ẩn lúc đóng */
.close-icon-main {
	position: absolute;
	top: 50%; left: 50%;
	transform: translate(-50%, -50%) rotate(-90deg);
	opacity: 0;
	transition: all 0.3s ease;
	color: #fff;
	font-size: 22px;
	line-height: 1;
}

/* --- TRẠNG THÁI MỞ MENU (KHI CÓ CLASS .widget-opened) --- */

/* Hiển thị bảng nội dung */
.main-widget.widget-opened .def-content {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
}

/* Ẩn các icon mặc định và nhịp đập khi mở menu */
.main-widget.widget-opened .widget-toggle-elem,
.main-widget.widget-opened .pregan {
	opacity: 0;
	transform: scale(0);
	transition: all 0.3s ease;
}

/* Hiện nút X (kèm hiệu ứng xoay) */
.main-widget.widget-opened .close-icon-main {
	opacity: 1;
	transform: translate(-50%, -50%) rotate(0deg);
}
</style>