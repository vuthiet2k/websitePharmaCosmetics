<div class="side-right-stick">
	{%- if settings.right_aside_blog and settings.aside_category_blog_menu != blank -%}
	{%- include 'aside-cate-blog' -%}
	{%- endif -%}
	{%- assign pc_show_noibat = true -%}
	{%- if settings.right_aside_noibat == false -%}{%- assign pc_show_noibat = false -%}{%- endif -%}
	{%- if pc_show_noibat -%}
	{%- assign relate_handle = settings.relate_blog | default: 'tin-tuc-va-kien-thuc' -%}
	{%- assign relate_b = blogs[relate_handle] -%}
	{%- assign relate_count = settings.number_relate_blog | default: 5 | plus: 0 -%}
	{%- if relate_count < 1 -%}{%- assign relate_count = 5 -%}{%- endif -%}
	{%- assign relate_url = relate_b.url -%}
	{%- if relate_url == blank -%}{%- assign relate_url = '/blogs/' | append: relate_handle -%}{%- endif -%}
	<div class="blog_noibat">
		<h2 class="h2_sidebar_blog">
			<a href="{{ relate_url }}" title="{{ settings.news_relate | default: 'Tin nổi bật' | escape }}">{{ settings.news_relate | default: 'Tin nổi bật' | escape }}</a>
		</h2>
		{%- if relate_b.articles.size > 0 -%}
		<div class="blog_content">
			{%- for article in relate_b.articles limit: relate_count -%}
			<div class="item clearfix">
				<div class="post-thumb">
					<a class="image-blog" href="{{ article.url }}" title="{{ article.title | escape }}">
						{%- if article.image != null and article.image.src != blank -%}
						<img width="100" height="63" class="img_blog" src="{{ article.image.src | img_url: 'compact' }}" alt="{{ article.title | escape }}" loading="lazy">
						{%- else -%}
						<img width="100" height="63" class="img_blog" src="{% include 'placeholder_img_url' %}" alt="{{ article.title | escape }}" loading="lazy">
						{%- endif -%}
					</a>
				</div>
				<div class="contentright">
					<h3><a title="{{ article.title | escape }}" href="{{ article.url }}">{{ article.title | escape }}</a></h3>
					<p class="time-post">
						<span>{{ article.published_on | date: 'dd/MM/yyyy' }}</span>
					</p>
				</div>
			</div>
			{%- endfor -%}
		</div>
		{%- else -%}
		<p class="box_alert text-muted m-0">
			{{ settings.news_empty_text | default: 'Danh mục đang được cập nhật.' | escape }}
		</p>				
		{%- endif -%}
	</div>
	{%- endif -%}
</div>
