{%- comment -%}
  Banner CTA — đặt cuối trang collection, sau best seller.
  Mục đích: chuyển user còn lưỡng lự sang luồng tư vấn 1:1 với chuyên gia.
{%- endcomment -%}

<section class="pc-section pc-col-cta-section">
  <div class="container">
    <div class="pc-col-cta">
      <div class="pc-col-cta__decor pc-col-cta__decor--1" aria-hidden="true"></div>
      <div class="pc-col-cta__decor pc-col-cta__decor--2" aria-hidden="true"></div>

      <div class="pc-col-cta__icon" aria-hidden="true">
        <i class="{{ settings.col_cta_icon | default: 'fas fa-user-md' }}"></i>
      </div>

      <div class="pc-col-cta__body">
        <p class="pc-col-cta__eyebrow">{{ settings.col_cta_eyebrow | default: 'Cần thêm hỗ trợ?' }}</p>
        <h3 class="pc-col-cta__title">
          {{ settings.col_cta_title | default: 'Chưa biết chọn sản phẩm phù hợp với da của bạn?' }}
        </h3>
        <p class="pc-col-cta__desc">
          {{ settings.col_cta_desc | default: 'Chuyên gia của PHARMA COSMETICS tư vấn 1:1 miễn phí — gửi ảnh da và nhận phác đồ điều trị cá nhân hóa trong vòng 24 giờ.' }}
        </p>
      </div>

      <div class="pc-col-cta__actions">
        <a class="pc-col-cta__btn pc-col-cta__btn--primary"
           href="{{ settings.col_cta_btn1_url | default: '/dat-lich-tu-van' }}">
          <i class="fas fa-stethoscope" aria-hidden="true"></i>
          {{ settings.col_cta_btn1_text | default: 'Tư vấn miễn phí' }}
        </a>
        {%- if settings.col_cta_phone or settings.hotline -%}
        <a class="pc-col-cta__btn pc-col-cta__btn--ghost"
           href="tel:{{ settings.col_cta_phone | default: settings.hotline | default: '1900xxxx' | remove: '.' | remove: ' ' }}">
          <i class="fas fa-phone-alt" aria-hidden="true"></i>
          {{ settings.col_cta_phone | default: settings.hotline | default: 'Gọi hotline' }}
        </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
.pc-col-cta-section {
  padding-top: 64px;
  padding-bottom: 64px;
}
.pc-col-cta {
  position: relative;
  background: var(--bg-gradient-green, linear-gradient(135deg, #f4fcf6 0%, #e8f5e9 100%));
  border-radius: 20px;
  padding: 40px 48px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 32px;
  align-items: center;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--mainColor) 15%, transparent);
}
.pc-col-cta__decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.pc-col-cta__decor--1 {
  width: 160px;
  height: 160px;
  background: rgba(60, 179, 113, 0.08);
  top: -60px;
  right: -30px;
}
.pc-col-cta__decor--2 {
  width: 100px;
  height: 100px;
  background: rgba(38, 115, 72, 0.08);
  bottom: -30px;
  left: 280px;
}
.pc-col-cta__icon {
  position: relative;
  z-index: 1;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #fff;
  color: var(--mainColorDark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  box-shadow: 0 8px 24px rgba(60, 179, 113, 0.18);
  flex-shrink: 0;
}
.pc-col-cta__body {
  position: relative;
  z-index: 1;
}
.pc-col-cta__eyebrow {
  font-family: var(--font-secondary);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--mainColor);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 0 0 6px;
}
.pc-col-cta__title {
  font-family: var(--font-primary);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--mainColorDark);
  margin: 0 0 8px;
  line-height: 1.3;
}
.pc-col-cta__desc {
  font-family: var(--font-secondary);
  font-size: var(--fs-sm);
  color: var(--textBody);
  margin: 0;
  line-height: 1.6;
  max-width: 560px;
}
.pc-col-cta__actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 12px;
  align-items: center;
  flex-shrink: 0;
}
.pc-col-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: 50px;
  font-family: var(--font-primary);
  font-size: var(--fs-sm);
  font-weight: 600;
  text-decoration: none;
  transition: transform var(--dur-fast, 150ms) var(--ease-out, ease),
              box-shadow var(--dur-fast, 150ms) var(--ease-out, ease),
              background var(--dur-base, 300ms) var(--ease-out, ease);
  white-space: nowrap;
}
.pc-col-cta__btn--primary {
  background: var(--mainColorDark);
  color: #fff;
}
.pc-col-cta__btn--primary:hover {
  background: var(--mainColor);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(38, 115, 72, 0.25);
  color: #fff;
}
.pc-col-cta__btn--ghost {
  background: transparent;
  color: var(--mainColorDark);
  border: 1.5px solid var(--mainColorDark);
}
.pc-col-cta__btn--ghost:hover {
  background: var(--mainColorDark);
  color: #fff;
}
@media (max-width: 991px) {
  .pc-col-cta {
    grid-template-columns: 1fr;
    padding: 32px 24px;
    gap: 20px;
    text-align: center;
  }
  .pc-col-cta__icon { margin: 0 auto; }
  .pc-col-cta__desc { margin-left: auto; margin-right: auto; }
  .pc-col-cta__actions { justify-content: center; flex-wrap: wrap; }
  .pc-col-cta__decor--2 { display: none; }
}
@media (max-width: 480px) {
  .pc-col-cta__title { font-size: var(--fs-lg); }
  .pc-col-cta__btn { width: 100%; justify-content: center; }
}
</style>
