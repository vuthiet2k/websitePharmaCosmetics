{%- comment -%}
  home_product_card.bwt — thẻ sản phẩm trang chủ (03/11/2026, chủ dự án: theo Figma "travel" node 5:2 — Flash sale + Bán chạy).
  Tham số: product (bắt buộc), eager (ảnh không lazy). Thiết kế: ảnh · thương hiệu (vendor) · tên 2 dòng · mô tả ngắn
  (product.summary, trống ⇒ ẩn) · giá (+ giá gốc gạch, nhãn -X% khi đang giảm). KHÔNG có nút giỏ (khác ui_product_card — thiết kế
  không có nút; cả thẻ dẫn vào trang SP). Kê toa (pc_is_rx) ⇒ ẩn giá, hiện nhãn "Cần tư vấn" + "Liên hệ để được tư vấn"
  (settings.product_rx_card_label). Giá 0 ⇒ "Liên hệ". CSS: ui-src/css/components.css mục 14.6.
{%- endcomment -%}
{%- if product != blank -%}
{%- assign hpc_name = product.name | default: product.title -%}
{%- assign hpc_var = product.selected_or_first_available_variant | default: product.variants.first -%}
{%- assign hpc_price = hpc_var.price | default: product.price -%}
{%- assign hpc_compare = hpc_var.compare_at_price | default: product.compare_at_price | default: 0 -%}
{%- include 'pc_is_rx' -%}
{%- assign hpc_off = 0 -%}
{%- if hpc_compare > hpc_price and hpc_price > 0 and pc_is_rx != true -%}
  {%- assign hpc_off = hpc_compare | minus: hpc_price | times: 100 | divided_by: hpc_compare | round -%}
  {%- if hpc_off < 1 -%}{%- assign hpc_off = 1 -%}{%- endif -%}
{%- endif -%}
{%- assign hpc_desc = product.summary | strip_html | strip_newlines | strip | truncate: 90 -%}
<article class="pc-h4-pcard">
  <a class="pc-h4-pcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <img src="{% if product.featured_image.src != blank %}{{ product.featured_image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ product.featured_image.alt | default: hpc_name | escape }}" width="436" height="380"{% unless eager %} loading="lazy"{% endunless %}>
    {%- if hpc_off > 0 -%}<span class="pc-h4-pcard__off">-{{ hpc_off }}%</span>{%- endif -%}
  </a>
  {%- if pc_is_rx -%}<p class="pc-h4-pcard__v">{{ settings.product_rx_card_kicker | default: 'Sản phẩm thuốc' | escape }}</p>
  {%- elsif product.vendor != blank -%}<p class="pc-h4-pcard__v">{{ product.vendor | escape }}</p>{%- endif -%}
  <h3 class="pc-h4-pcard__t notranslate" translate="no"><a href="{{ product.url }}">{{ hpc_name }}</a></h3>
  {%- if hpc_desc != blank -%}<p class="pc-h4-pcard__d">{{ hpc_desc | escape }}</p>{%- endif -%}
  {%- if pc_is_rx -%}
  <p class="pc-h4-pcard__rx"><b>{{ settings.product_rx_card_badge | default: 'Cần tư vấn' | escape }}</b><span>{{ settings.product_rx_card_label | default: 'Liên hệ để được tư vấn' | escape }}</span></p>
  {%- elsif hpc_price == 0 -%}
  <p class="pc-h4-pcard__p">{{ settings.product_card_contact_text | default: 'Liên hệ' | escape }}</p>
  {%- else -%}
  <p class="pc-h4-pcard__p"><span>{{ hpc_price | money }}</span>{%- if hpc_compare > hpc_price -%}<s><span class="sr-only">Giá gốc </span>{{ hpc_compare | money }}</s>{%- endif -%}</p>
  {%- endif -%}
</article>
{%- endif -%}
