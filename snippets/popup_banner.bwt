{%- comment -%}
  popup_banner.bwt — popup banner trang chủ (cảnh báo lừa đảo giao hàng...). M-07 (17/11/2026): viết lại 100% Tailwind (bỏ CSS #modal-banner trong header_style, bỏ jQuery .show()/.hide()):
  hiện / ẩn có hiệu ứng FADE bằng class (transition-opacity + opacity-0 ⇄ opacity-100; motion-reduce:transition-none và JS bỏ chờ khi người dùng giảm chuyển động),
  khoá cuộn nền khi mở (body overflow-hidden), Escape đóng, nút đóng 44px, ô "Không hiển thị hôm nay" (lưu theo ngày, localStorage) cao 44px, ảnh vừa khít màn hình.
  Ảnh = settings.popup_banner_image (Cấu hình theme › popup), chỉ tải sau khi hết thời gian chờ (template script). Chưa có ảnh / chưa bật ⇒ footer_script không nạp snippet này.
{%- endcomment -%}
<div id="modal-banner" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300 motion-reduce:transition-none" data-delay="{{ settings.popup_banner_delay_time }}" role="dialog" aria-modal="true" aria-label="{{ settings.popup_banner_alt | default: 'Thông báo' | escape }}" tabindex="-1">
	<div class="modalbanner-overlay absolute inset-0 bg-slate-900/80" data-popup-close></div>
	<div class="relative flex max-h-full w-full max-w-sm flex-col">
		<a href="{{ settings.popup_banner_url }}" title="{{ settings.popup_banner_alt | escape }}" class="banner-promotion block overflow-hidden rounded-2xl bg-white" data-section="banner_popup">
			<script type="text/x-custom-template" data-template="banner_popup">
				<img class="block h-auto max-h-screen w-full object-contain" width="{{ settings.popup_banner_width }}" height="{{ settings.popup_banner_height }}" alt="{{ settings.popup_banner_alt | escape }}" src="{{ settings.popup_banner_image | img_url: 'large' }}" />
			</script>
		</a>
		<button type="button" class="modalbanner-close absolute right-2 top-2 inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border-0 bg-white p-0 text-ink hover:bg-brand-tint" aria-label="Đóng" data-popup-close>{% include 'ui_icon', name: 'x', size: 24 %}</button>
		<label class="mt-2 flex min-h-[44px] cursor-pointer items-center justify-center gap-2 text-sm font-semibold text-white" for="check-close-banner">
			<input type="checkbox" id="check-close-banner" class="h-5 w-5 shrink-0 cursor-pointer accent-primary">
			<span>Không hiển thị hôm nay</span>
		</label>
	</div>
</div>

<script>
(function () {
	var box = document.getElementById('modal-banner');
	if (!box) return;
	var check = document.getElementById('check-close-banner');
	var link = box.querySelector('.banner-promotion');
	var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	var DAY_KEY = 'popupClosedDate';
	function today() { return new Date().toLocaleDateString('en-US', { timeZone: 'Asia/Ho_Chi_Minh' }); }
	function rememberToday() { try { localStorage.setItem(DAY_KEY, today()); } catch (e) {} }
	function closedToday() { try { return localStorage.getItem(DAY_KEY) === today(); } catch (e) { return false; } }

	function open() {
		var tpl = box.querySelector('script[data-template="banner_popup"]');
		if (tpl && link) link.innerHTML = tpl.innerHTML;
		box.classList.remove('hidden');
		box.classList.add('flex');
		void box.offsetWidth; /* ép trình duyệt tính layout rồi mới đổi opacity ⇒ có fade-in */
		box.classList.remove('opacity-0');
		box.classList.add('opacity-100');
		document.body.classList.add('overflow-hidden');
		var c = box.querySelector('.modalbanner-close');
		if (c) c.focus();
	}
	function close() {
		if (check && check.checked) rememberToday();
		box.classList.remove('opacity-100');
		box.classList.add('opacity-0');
		document.body.classList.remove('overflow-hidden');
		var done = function () { box.classList.remove('flex'); box.classList.add('hidden'); };
		if (reduce) done(); else box.addEventListener('transitionend', done, { once: true });
	}
	box.addEventListener('click', function (e) { if (e.target.closest('[data-popup-close]')) close(); });
	if (link) link.addEventListener('click', rememberToday);
	document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('opacity-100')) close(); });
	if (!closedToday()) {
		var delay = parseInt(box.getAttribute('data-delay'), 10) || 3000;
		setTimeout(open, delay);
	}
})();
</script>
