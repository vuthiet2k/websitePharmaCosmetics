{%- comment -%}
  section_zalo_consult.bwt (REOPEN 2026-09-11, khớp gap "Direct Zalo Consultation Banner" phát
  hiện khi đối chiếu Pharma_Cosmetics_Desktop_Homepage_Figma_260-84.html dòng 1780-1810).
  Dùng settings.contact_zalo/store_phone THẬT (đã cấu hình sẵn, khớp đúng số trong mockup) thay
  vì hard-code. Điều chỉnh ngôn từ RULE-P0-02: "Bác sĩ" → "Chuyên gia" (danh xưng chung).
{%- endcomment -%}
{%- assign zalo_num = settings.contact_zalo | default: settings.store_phone -%}
<section class="pc-zalo-section" style="background-color: var(--primary-forest-900, #0F2318); padding: 44px 0; border-bottom: 1px solid #064E3B;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl p-7 flex flex-col lg:flex-row gap-7 items-center justify-between" style="background:var(--primary-forest-800, #166B55); border:1px solid #22543D;">
      <div class="flex flex-col gap-2.5" style="max-width:800px;">
        <span class="text-[11px] font-bold w-fit rounded-md px-3 py-1" style="background:#1E3A2B;color:#34D399;"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align:-1px;margin-right:2px;"><path d="M13 2 3 14h7l-1 8 11-14h-8l1-6z"/></svg> KẾT NỐI ZALO TRỰC TIẾP — PHẢN HỒI TRONG 2 PHÚT</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white font-heading" style="line-height:1.35;">Gửi Ảnh Da Để Chuyên Gia Soi Vi Điểm &amp; Đưa Ra Minh Chứng Tương Tự</h2>
        <p class="text-[13px]" style="color:#CBD5E1;">Chat trực tiếp 1:1 qua Zalo OA với Chuyên gia để nhận phân tích tình trạng da và xem phác đồ của những ca bệnh tương tự hoàn toàn miễn phí.</p>
        <a href="https://zalo.me/{{ zalo_num | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener" class="text-xs font-bold py-3 px-5 rounded-md w-fit mt-1" style="background:#2A9C68;color:#fff;">
          Mở Zalo Chat Với Chuyên Gia 1:1 ➔
        </a>
      </div>

      <div class="rounded-xl p-4 flex items-center gap-4 flex-shrink-0" style="background: var(--primary-forest-900, #0F2318); border:1px solid #1E3A2B;">
        <div class="w-[76px] h-[76px] bg-white rounded-lg p-1.5 flex items-center justify-center flex-shrink-0">
          <div class="w-full h-full grid grid-cols-4 gap-0.5 p-0.5" style="background:#fff; border:2px solid #0F2318;">
            <div style="background:#0F2318;"></div><div style="background:#0F2318;"></div><div></div><div style="background:#0F2318;"></div>
            <div></div><div style="background:#0F2318;"></div><div style="background:#0F2318;"></div><div></div>
            <div style="background:#0F2318;"></div><div></div><div style="background:#0F2318;"></div><div style="background:#0F2318;"></div>
            <div style="background:#0F2318;"></div><div style="background:#0F2318;"></div><div></div><div style="background:#0F2318;"></div>
          </div>
        </div>
        <div class="text-[11px] font-medium" style="color:#A7F3D0; line-height:1.5;">
          <strong class="text-white">Quét mã Zalo OA Chuyên gia Da liễu</strong><br>
          Hotline: <strong class="text-white">{{ settings.store_phone }}</strong><br>
          <span style="color:#34D399;">Trực tuyến: 6h30 - 21h30 hàng ngày</span>
        </div>
      </div>
    </div>
  </div>
</section>
