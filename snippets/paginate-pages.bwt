<nav class="clearfix relative nav_pagi w_100 ">
	<ul class="pagination clearfix">
		{% if paginate.previous %}
		<li class="page-item hidden-xs"><a class="page-link link-next-pre" href="{{ paginate.previous.url }}">
			&laquo;
			</a></li>
		{% else %}  
		<li class="page-item disabled"><a class="page-link" href="#">
			&laquo;
			</a></li>
		{% endif %}

		{% for part in paginate.parts %}
		{% if part.is_link %}
		<li class="page-item"><a class="page-link" href="{{ part.url }}">{{ part.title }}</a></li>
		{% else %}
		{% if part.title == paginate.current_page %}
		<li class="active page-item disabled"><a class="page-link" href="#">{{ part.title }}</a></li>
		{% else %}
		<li class="page-item"><a class="page-link" href="{{ part.url }}">{{ part.title }}</a></li>
		{% endif %}
		{% endif %}
		{% endfor %}

		{% if paginate.next %}
		<li class="page-item hidden-xs"><a class="page-link link-next-pre" href="{{ paginate.next.url }}">
			&raquo;			</a></li>
		{% else %}
		<li class="page-item disabled"><a class="page-link" href="#">
			&raquo;
			</a></li>
		{% endif %}
	</ul>
</nav>