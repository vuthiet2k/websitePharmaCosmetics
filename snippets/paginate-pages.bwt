{%- comment -%}
  paginate-pages.bwt — phân trang danh sách bài viết / blog.
  Chuẩn hoá 100% class Tailwind (UI-0) — ô min 44×44, trang hiện tại nền màu chính, icon chevron dùng ui_icon.
{%- endcomment -%}
{%- assign pc_pg_link = 'flex min-h-[44px] min-w-[44px] items-center justify-center border border-solid border-line bg-white px-3 text-sm font-semibold !text-ink no-underline rounded-xl hover:border-primary transition-colors' -%}
{%- assign pc_pg_off = 'flex min-h-[44px] min-w-[44px] cursor-not-allowed items-center justify-center border border-solid border-line bg-white px-3 text-sm font-semibold text-ink-secondary opacity-40 rounded-xl' -%}
<nav class="clearfix relative nav_pagi w_100 mt-6 font-sans" aria-label="Phân trang">
	<ul class="pagination m-0 flex list-none flex-wrap items-center justify-center gap-0 p-0 sm:gap-2">
		{% if paginate.previous %}
		<li class="page-item"><a class="{{ pc_pg_link }}" href="{{ paginate.previous.url }}" aria-label="Trang trước">{% include 'ui_icon', name: 'chevron-left', size: 16 %}</a></li>
		{% else %}  
		<li class="page-item disabled"><span class="{{ pc_pg_off }}" aria-hidden="true">{% include 'ui_icon', name: 'chevron-left', size: 16 %}</span></li>
		{% endif %}

		{% for part in paginate.parts %}
		{% if part.is_link %}
		<li class="page-item"><a class="{{ pc_pg_link }}" href="{{ part.url }}">{{ part.title }}</a></li>
		{% else %}
		{% if part.title == paginate.current_page %}
		<li class="active page-item disabled"><span class="flex min-h-[44px] min-w-[44px] items-center justify-center border border-solid border-primary bg-primary px-3 text-sm font-semibold text-white rounded-xl" aria-current="page">{{ part.title }}</span></li>
		{% else %}
		<li class="page-item"><span class="flex min-h-[44px] min-w-6 items-center justify-center text-sm text-ink-secondary">{{ part.title }}</span></li>
		{% endif %}
		{% endif %}
		{% endfor %}

		{% if paginate.next %}
		<li class="page-item"><a class="{{ pc_pg_link }}" href="{{ paginate.next.url }}" aria-label="Trang sau">{% include 'ui_icon', name: 'chevron-right', size: 16 %}</a></li>
		{% else %}
		<li class="page-item disabled"><span class="{{ pc_pg_off }}" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 16 %}</span></li>
		{% endif %}
	</ul>
</nav>
