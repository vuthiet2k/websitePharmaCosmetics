{%- comment -%}
  video_card.bwt (2026-10-12, danh mục bài viết Video) — thẻ 1 bài video: ảnh bìa 16:9 + nút Play, nhãn nguồn
  (YouTube/Facebook), thời lượng (tag thoiluong:), chủ đề (tag chude:), tiêu đề, ngày đăng. Bấm thẻ mở trang xem video.
  Đầu vào: pc_vc_article, pc_vc_layout ('grid' = lưới trang danh mục | 'row' = thẻ ngang ở cột "Video đề xuất"),
  pc_vc_heading ('h3' mặc định). Thuộc tính data-pc-vfilter phục vụ bộ lọc chủ đề/nguồn ở templates/blog.video.bwt.
{%- endcomment -%}
{%- assign pc_vs_article = pc_vc_article -%}
{%- include 'video_source' -%}
{%- assign pc_vc_h = pc_vc_heading | default: 'h3' -%}
{%- assign pc_vc_topic_key = pc_vs_topic | handleize -%}
<article class="pc-vcard pc-vcard--{{ pc_vc_layout | default: 'grid' }}" data-pc-vfilter="topic-{{ pc_vc_topic_key }} src-{{ pc_vs_src }}">
	<a class="pc-vcard__media" href="{{ pc_vc_article.url }}" tabindex="-1" aria-hidden="true">
		<img src="{{ pc_vs_thumb_card }}" alt="{{ pc_vc_article.title | escape }}" width="480" height="270" loading="lazy">
		<span class="pc-vcard__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5.5v13l11-6.5z"/></svg></span>
		{%- if pc_vs_src == 'youtube' -%}
		<span class="pc-vcard__src pc-vcard__src--youtube">{{ settings.video_src_youtube_label | default: 'YouTube' | escape }}</span>
		{%- elsif pc_vs_src == 'facebook' -%}
		<span class="pc-vcard__src pc-vcard__src--facebook">{{ settings.video_src_facebook_label | default: 'Facebook' | escape }}</span>
		{%- endif -%}
		{%- if pc_vs_dur != blank -%}<span class="pc-vcard__dur">{{ pc_vs_dur | escape }}</span>{%- endif -%}
	</a>
	<div class="pc-vcard__body">
		{%- if pc_vs_topic != blank and pc_vc_layout != 'row' -%}<span class="pc-vcard__topic">{{ pc_vs_topic | escape }}</span>{%- endif -%}
		<{{ pc_vc_h }} class="pc-vcard__title"><a href="{{ pc_vc_article.url }}">{{ pc_vc_article.title | escape }}</a></{{ pc_vc_h }}>
		<div class="pc-vcard__meta">
			<time datetime="{{ pc_vc_article.published_on | date: 'yyyy-MM-dd' }}">{{ pc_vc_article.published_on | date: 'dd/MM/yyyy' }}</time>
			{%- if pc_vc_layout == 'row' and pc_vs_topic != blank -%}<span>{{ pc_vs_topic | escape }}</span>{%- endif -%}
		</div>
	</div>
</article>
