{%- comment -%}
  service_getglowing_concerns — 2. Những vấn đề da GetGlowing Micro-Peel hướng tới: 5 thẻ, ảnh 4:3 (settings gg_concern_N_*).
  Thẻ thiếu ảnh ⇒ chỉ hiện chữ (không vẽ ảnh giả). Ghi chú "ảnh minh hoạ" chỉ hiện khi có ít nhất 1 ảnh.
{%- endcomment -%}
{%- assign gg_has_img = false -%}
{%- for i in (1..5) -%}{%- assign k = 'gg_concern_' | append: i | append: '_image' -%}{%- if settings[k] != blank -%}{%- assign gg_has_img = true -%}{%- endif -%}{%- endfor -%}
<section id="service-concerns-section" class="gg-section gg-section--white">
  <div class="container">
    <header class="gg-head">
      {%- if settings.gg_concerns_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_concerns_eyebrow | escape }}</p>{%- endif -%}
      <h2 class="gg-title">{{ settings.gg_concerns_title | default: 'Một làn da có thể gặp nhiều vấn đề cùng lúc' | escape }}</h2>
      {%- assign gg_paras = settings.gg_concerns_text | newline_to_br | split: '<br />' -%}
      {%- for gg_p in gg_paras -%}{%- assign gg_p = gg_p | strip -%}{%- if gg_p != blank -%}<p class="gg-lead">{{ gg_p | escape }}</p>{%- endif -%}{%- endfor -%}
    </header>
    <div class="gg-concerns">
      {%- for i in (1..5) -%}
      {%- assign k_img = 'gg_concern_' | append: i | append: '_image' -%}
      {%- assign k_title = 'gg_concern_' | append: i | append: '_title' -%}
      {%- assign k_text = 'gg_concern_' | append: i | append: '_text' -%}
      {%- if settings[k_title] != blank -%}
      <article class="gg-card gg-concern">
        {%- if settings[k_img] != blank -%}
        <div class="gg-media gg-media--4x3"><img src="{{ settings[k_img] | img_url: 'large' }}" alt="{{ settings[k_title] | escape }}" width="1200" height="900" loading="lazy" decoding="async"></div>
        {%- endif -%}
        <div class="gg-card__body">
          <span class="gg-num">0{{ i }}</span>
          <h3 class="gg-card__title">{{ settings[k_title] | escape }}</h3>
          {%- if settings[k_text] != blank -%}<p class="gg-card__text">{{ settings[k_text] | escape }}</p>{%- endif -%}
        </div>
      </article>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if gg_has_img and settings.gg_concerns_note != blank -%}<p class="gg-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ settings.gg_concerns_note | escape }}</p>{%- endif -%}
  </div>
</section>
