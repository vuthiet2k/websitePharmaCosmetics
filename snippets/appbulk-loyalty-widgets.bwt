{% if customer %}
    {% assign digest = customer.id | append:customer.email | append: '47417377-6cf9-44fd-a1e2-76ff1f10c1ff' | md5 %}

	<script type="text/javascript">
	window.appbulkloyalty = window.appbulkloyalty || {};
	window.appbulkloyalty.shop = 'pharmacosmetics-vn.mysapo.net';

	window.appbulkloyalty.customer_id = '{{ customer.id }}';
	window.appbulkloyalty.digest = '{{ digest }}';
	</script>

	<div class="appbulk-loyalty-widget"
		data-digest="{{ digest }}"
		data-shop="pharmacosmetics-vn.mysapo.net"
		data-customer-id="{{ customer.id }}"
		data-channel-key="api_key??"></div>
{% else %}
	<script type="text/javascript">
	window.appbulkloyalty = window.appbulkloyalty || {};
	window.appbulkloyalty.shop = 'pharmacosmetics-vn.mysapo.net';
	</script>

	<div class="appbulk-loyalty-widget"
		data-shop="pharmacosmetics-vn.mysapo.net"></div>
{% endif %}