{%- comment -%} section_product_viewed.bwt — Sản phẩm đã xem gần đây (Tailwind snap-x, 0 style, 0 swiper) {%- endcomment -%}
<div class="section-recenview-product hidden py-6 lg:py-8">
  <div class="container">
    <div class="mb-4 flex items-center justify-between">
      <div>
        {%- if settings.product_viewed_eyebrow != blank -%}
        <p class="m-0 text-xs font-semibold uppercase tracking-wider text-primary">{{ settings.product_viewed_eyebrow }}</p>
        {%- endif -%}
        <h2 class="m-0 text-lg font-bold text-ink sm:text-xl">{{ settings.product_viewed_title | default: 'Sản phẩm đã xem' }}</h2>
      </div>
    </div>

    <ul class="js-viewed-list m-0 flex list-none snap-x snap-mandatory gap-3 overflow-x-auto p-0 pb-2 scrollbar-none lg:gap-4"></ul>
  </div>
</div>

<script>
$(document).ready(function() {
  if (!localStorage.last_viewed_products) return;

  var last_viewd_pro_array = JSON.parse(localStorage.last_viewed_products);
  var size_pro_review = Math.min(last_viewd_pro_array.length, 12);
  if (size_pro_review < 1) return;

  var recentview_promises = [];
  var requested_aliases = [];
  for (var i = 0; i < size_pro_review; i++) {
    var alias_product = last_viewd_pro_array[i];
    if (alias_product && alias_product.alias) {
      (function(alias) {
        var promise = new Promise(function(resolve) {
          $.ajax({
            url: '/' + alias + '?view=viewed',
            success: function(html) { resolve(html); },
            error:   function()     { resolve(''); }
          });
        });
        recentview_promises.push(promise);
        requested_aliases.push(alias);
      })(alias_product.alias);
    }
  }

  Promise.all(recentview_promises).then(function(values) {
    var appended_count = 0;
    var $list = $('.js-viewed-list');
    values.forEach(function(v) {
      if ($.trim(v) !== '') {
        $list.append(v);
        appended_count++;
      }
    });

    var failed_aliases = requested_aliases.filter(function(alias, i) {
      return values[i] === '';
    });
    if (failed_aliases.length) {
      var latest_viewed = JSON.parse(localStorage.getItem('last_viewed_products')) || [];
      latest_viewed = latest_viewed.filter(function(item) {
        return failed_aliases.indexOf(item.alias) === -1;
      });
      localStorage.setItem('last_viewed_products', JSON.stringify(latest_viewed));
    }

    if (!appended_count) return;
    $('.section-recenview-product').removeClass('hidden');

    if (window.awe_lazyloadImage) {
      awe_lazyloadImage();
    }
    {%- if settings.iwish_enable -%}
    if (window.favoriBean && favoriBean.Wishlist) {
      favoriBean.Wishlist.wishlistProduct();
    }
    {%- endif -%}
  }).catch(function(err) {
    console.warn('Lỗi tải sản phẩm đã xem:', err);
  });
});
</script>
