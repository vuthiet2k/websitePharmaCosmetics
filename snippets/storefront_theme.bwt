{%- comment -%}Shared brand tokens for Sapo storefront and clinic layouts. MOPS uses its own layout.{%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,450;9..144,560;9..144,650&display=swap" rel="stylesheet">
<style id="storefront-brand-tokens">
  :root {
    --pc-brand-primary: {{ settings.theme_main_color | default: '#3CB371' }};
    --pc-brand-deep: {{ settings.theme_forest_color | default: '#003F2D' }};
    --pc-brand-dark: {{ settings.theme_dark_color | default: '#002E23' }};
    --pc-brand-secondary: {{ settings.theme_secondary_green | default: '#075B40' }};
    --pc-page-background: {{ settings.theme_page_background | default: '#F4F7F4' }};
    --pc-font-display: 'Fraunces', Georgia, serif;
    --pc-font-body: 'Inter', system-ui, sans-serif;
  }
</style>
{{ 'storefront-v3.css' | asset_url | stylesheet_tag }}
{{ 'site-topbar.css' | asset_url | stylesheet_tag }}
<script defer src="{{ 'site-topbar.js' | asset_url }}"></script>
