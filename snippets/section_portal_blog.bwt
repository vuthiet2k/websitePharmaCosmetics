{%- comment -%}
  section_portal_blog.bwt — chuong III "Dong hanh".
  Dung 100% Tailwind utility class, mau theo he thong chu de chinh.
  Desktop: 3 bai viet (bai dau rong gap doi).
  Mobile: bai 1 the rong, 2 bai sau 2 cot.
{%- endcomment -%}
{%- assign portal_blog_handle = settings.portal_blog | default: settings.section_blog_url -%}
{%- assign portal_blog = blogs[portal_blog_handle] -%}
<section class="py-8 lg:py-16" aria-labelledby="portal-blog-title">
  <div class="container">
    <div class="mb-4 flex items-center gap-3">
      <p class="m-0 text-xs font-bold uppercase tracking-wider text-primary">
        III · {{ settings.portal_chapter_3 | default: 'Dong hanh' | escape }}
      </p>
      <span class="hidden lg:block h-px flex-1 bg-line-soft" aria-hidden="true"></span>
    </div>
    {%- comment -%} M-11 (17/11/2026): đầu section = ui_section_head (link "Xem tất cả" = nút tròn icon ở mobile). {%- endcomment -%}
    {%- assign pb_title_t = settings.portal_blog_title | default: 'Blog Pharma Cosmetics' | escape -%}
    {%- assign pb_eyebrow_t = settings.portal_blog_eyebrow | default: 'Kien thuc cham soc da' | escape -%}
    {%- assign pb_more_t = settings.portal_blog_viewall_text | default: 'Xem tat ca bai viet' | escape -%}
    {%- include 'ui_section_head', title: pb_title_t, title_id: 'portal-blog-title', eyebrow: pb_eyebrow_t, url: portal_blog.url, more_text: pb_more_t, label: pb_more_t, wrap_class: 'mb-4 lg:mb-6' -%}
    {%- if portal_blog.articles.size > 0 -%}
    {%- comment -%} M-21: mobile = danh sách NGANG (pc_article_card biến thể row: ảnh trái / chữ phải); desktop giữ lưới 3 bài như cũ. {%- endcomment -%}
    {%- assign pb_feat_t = settings.portal_blog_featured_label | default: 'Bai noi bat' -%}
    <div class="lg:hidden">
      {%- for article in portal_blog.articles limit: 3 -%}
        {%- if forloop.first -%}{%- assign pc_card_badge = pb_feat_t -%}{%- else -%}{%- assign pc_card_badge = '' -%}{%- endif -%}
        {%- include 'pc_article_card', article: article, pc_card_row: true, pc_card_badge: pc_card_badge -%}
      {%- endfor -%}
    </div>
    <div class="hidden lg:grid lg:grid-cols-[2fr_1fr_1fr] lg:gap-6">
      {%- for article in portal_blog.articles limit: 3 -%}
      <a class="group flex flex-col no-underline" href="{{ article.url }}">
        <span class="relative block h-[220px] overflow-hidden rounded-2xl bg-surface-soft">
          <img class="block h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" src="{% if article.image.src != blank %}{{ article.image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ article.title | escape }}" width="{% if forloop.first %}1232{% else %}616{% endif %}" height="440" loading="lazy">
        </span>
        <span class="m-0 mt-4 text-xs font-bold uppercase tracking-wider text-primary">{% if forloop.first %}{{ pb_feat_t | escape }}{% else %}{{ portal_blog.name | default: portal_blog.title | escape }}{% endif %} · {{ article.published_on | date: '%d.%m.%Y' }}</span>
        <span class="m-0 mt-2 line-clamp-2 text-base font-bold leading-snug text-ink transition-colors group-hover:text-primary">{{ article.title | escape }}</span>
        {%- if article.author != blank -%}
        <span class="m-0 mt-2 text-xs text-ink-muted">{{ settings.portal_blog_by_label | default: 'Boi' | escape }} {{ article.author | escape }}</span>
        {%- endif -%}
      </a>
      {%- endfor -%}
    </div>
    {%- else -%}
    <p class="text-sm text-ink-secondary">{{ settings.portal_blog_empty_text | default: 'Bai viet dang duoc cap nhat.' | escape }}</p>
    {%- endif -%}
  </div>
</section>