{%- comment -%}
  section_featured_products.bwt — Sản phẩm bán chạy nổi bật.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- assign feat_col = settings.home_featured_collection | default: 'san-pham-ban-chay-noi-bat' -%}
{%- assign feat_limit = settings.home_featured_limit | plus: 0 -%}
{%- if feat_limit < 1 or feat_limit > 16 -%}{%- assign feat_limit = 12 -%}{%- endif -%}
{%- assign feat_count = collections[feat_col].products_count -%}
{%- if feat_count > 0 -%}
{%- assign feat_all_url = collections[feat_col].url | default: feat_col -%}
{%- comment -%} M-14 (17/11/2026, PO chốt): bỏ hẳn thanh chip "Lọc theo nhu cầu" (+ tab/panel + 3 ô cấu hình home_featured_tab*). Link "Xem tất cả" theo M-11 (ui_section_head). {%- endcomment -%}
{%- assign feat_title_t = settings.home_featured_title | default: 'Sản phẩm bán chạy' | escape -%}
{%- assign feat_eyebrow_t = settings.home_featured_eyebrow | escape -%}
{%- assign feat_sub_t = settings.home_featured_subtitle | escape -%}
{%- assign feat_viewall_t = settings.home_featured_viewall_text | default: 'Xem tất cả' | escape -%}
<section class="bg-surface-soft py-10 lg:py-16 font-sans text-ink section_featured_products" aria-labelledby="section-featured-products-title">
  <div class="container">
    {%- include 'ui_section_head', title: feat_title_t, title_id: 'section-featured-products-title', eyebrow: feat_eyebrow_t, desc: feat_sub_t, url: feat_all_url, more_text: feat_viewall_t, label: feat_viewall_t, wrap_class: 'mb-6 lg:mb-8' -%}
    <div class="relative group/feat">
      <div class="swiper-container overflow-hidden featured-swiper" id="featured-swiper-0">
        <div class="swiper-wrapper">
          {%- for product in collections[feat_col].products limit: feat_limit -%}
            <div class="swiper-slide !h-auto">
              {%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <button type="button" class="featured-prev-0 max-md:hidden md:inline-flex absolute -left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 min-h-[44px] min-w-[44px] rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm trước">
        {% include 'ui_icon', name: 'chevron-left', size: '18' %}
      </button>
      <button type="button" class="featured-next-0 max-md:hidden md:inline-flex absolute -right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 min-h-[44px] min-w-[44px] rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm tiếp theo">
        {% include 'ui_icon', name: 'chevron-right', size: '18' %}
      </button>
      <div class="featured-pagination-0 flex justify-center items-center gap-1.5 mt-4 md:hidden"></div>
    </div>
  </div>
</section>
<script>
(function () {
  function initFeaturedSwipers() {
    if (typeof Swiper !== 'function') {
      window.addEventListener('load', initFeaturedSwipers);
      return;
    }
    var containers = document.querySelectorAll('.featured-swiper');
    Array.prototype.forEach.call(containers, function (el) {
      if (el.swiper) return;
      var id = el.id.replace('featured-swiper-', '');
      new Swiper(el, {
        slidesPerView: 2.2,
        spaceBetween: 12,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        navigation: {
          prevEl: '.featured-prev-' + id,
          nextEl: '.featured-next-' + id
        },
        pagination: {
          el: '.featured-pagination-' + id,
          clickable: true,
          dynamicBullets: true
        },
        breakpoints: {
          640: {
            slidesPerView: 3,
            spaceBetween: 16
          },
          768: {
            slidesPerView: 4,
            spaceBetween: 16
          },
          1024: {
            slidesPerView: 5,
            spaceBetween: 16
          }
        }
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeaturedSwipers);
  } else {
    initFeaturedSwipers();
  }
})();
</script>
{%- endif -%}
