{%- comment -%}
  news_cta.bwt (2026-10-13) — khung đặt lịch tư vấn cuối trang tổng tin tức và trang 1 danh mục bài viết (mockup
  design/blog.html SECTION 8). Câu chữ/link: field news_cta_*; tắt bằng news_cta_enable. Thay khung ghi cứng cũ trong
  templates/blog.bwt (có câu cam kết "miễn phí trong 24 giờ" không có nguồn).
{%- endcomment -%}
{%- if settings.news_cta_enable and settings.news_cta_title != blank -%}
<aside class="pc-ncta">
	<div>
		<p class="pc-ncta__title">{{ settings.news_cta_title | escape }}</p>
		{%- if settings.news_cta_text != blank -%}<p class="pc-ncta__text">{{ settings.news_cta_text | escape }}</p>{%- endif -%}
	</div>
	{%- if settings.news_cta_url != blank -%}<a class="pc-ncta__btn" href="{{ settings.news_cta_url }}">{{ settings.news_cta_label | default: 'Đặt lịch tư vấn' | escape }}</a>{%- endif -%}
</aside>
{%- endif -%}
