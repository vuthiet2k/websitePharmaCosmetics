{%- comment -%}
  section_brand_marquee.bwt — Thương hiệu tiêu biểu (T-18).
  Băng chạy CSS 2 hàng ngược chiều cùng tốc độ (23/11/2026, thay Swiper), full width, hover pause, edge gradients.
  100% Tailwind class theo token (UI-0), màu thương hiệu primary (UI-BRAND).
{%- endcomment -%}
{%- assign brand_menu_handle = settings.home_brand_menu | default: 'thuong-hieu' -%}
{%- assign brand_ll = linklists[brand_menu_handle] -%}
{%- if brand_ll == blank or brand_ll.links.size == 0 -%}
  {%- assign brand_ll = linklists['thuong-hieu'] -%}
{%- endif -%}

{%- assign brand_limit = settings.home_brand_limit | plus: 0 -%}
{%- if brand_limit < 1 -%}{%- assign brand_limit = 40 -%}{%- endif -%}
{%- assign brand_title_t = settings.home_brand_title | default: 'Thương hiệu tiêu biểu' | escape -%}
{%- assign brand_lead_t = settings.home_brand_lead | default: 'Nhập khẩu chính hãng' | escape -%}
{%- assign brand_sub_t = settings.home_brand_subtitle | escape -%}
{%- assign brand_viewall_t = settings.home_brand_viewall_text | default: 'Xem tất cả' | escape -%}
{%- assign brand_url = settings.home_brand_url | default: '/thuong-hieu' -%}

<section class="border-t border-line-soft bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-brand-title">
  <div class="container mb-6 lg:mb-8">
    {%- include 'ui_section_head', title: brand_title_t, title_id: 'section-brand-title', eyebrow: brand_lead_t, desc: brand_sub_t, url: brand_url, more_text: brand_viewall_t, label: 'Xem tất cả thương hiệu', wrap_class: 'mb-0' -%}
  </div>

  {%- if brand_ll.links.size > 0 -%}
  {%- comment -%} 23/11/2026 (chủ dự án: hàng dưới chạy rất nhanh, 2 hàng dính nhau): bỏ Swiper autoplay loop (chiều ngược
    reverseDirection + loop nhảy cóc, chạy nhanh bất thường) ⇒ băng chạy CSS thuần (keyframes marquee / marquee-reverse ở
    tailwind.pc.config.js), 2 hàng CÙNG thời lượng 90s ⇒ cùng tốc độ; nội dung in 2 lần (bản 2 aria-hidden, không tab) để lặp liền.
    Rê chuột / focus ⇒ dừng; giảm chuyển động ⇒ đứng yên, cuộn ngang tay. Khoảng cách 2 hàng = gap của khung cha (không phụ
    thuộc margin của .swiper-container). Nguồn: 1 menu thương hiệu, mục lẻ hàng trên / mục chẵn hàng dưới. {%- endcomment -%}
  {%- assign pc_bm_passes = '1,2' | split: ',' -%}
  <div class="relative flex w-full flex-col gap-3 sm:gap-4 overflow-hidden">
    <!-- Gradient mép trái -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 sm:w-24 lg:w-36 bg-gradient-to-r from-surface-soft to-transparent" aria-hidden="true"></div>
    <!-- Gradient mép phải -->
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 sm:w-24 lg:w-36 bg-gradient-to-l from-surface-soft to-transparent" aria-hidden="true"></div>

    <!-- Hàng 1: chạy sang trái (mục 1, 3, 5…) -->
    <div class="group/row overflow-hidden motion-reduce:overflow-x-auto">
      <div class="flex w-max motion-safe:animate-marquee motion-safe:[animation-duration:90s] group-hover/row:[animation-play-state:paused] group-focus-within/row:[animation-play-state:paused]">
        {%- for pass in pc_bm_passes -%}
        <div class="flex shrink-0 gap-4 pr-4"{% if pass == '2' %} aria-hidden="true"{% endif %}>
          {%- for link in brand_ll.links limit: brand_limit -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          {%- if mod == 0 -%}
            {%- assign b_title = link.title | strip -%}
            {%- assign b_first = b_title | upcase | slice: 0, 1 -%}
            {%- assign b_img = link.object.image.src | default: link.object.featured_image.src -%}
            <a href="{{ link.url | escape }}" title="{{ b_title | escape }}"{% if pass == '2' %} tabindex="-1"{% endif %} class="group/card flex shrink-0 flex-col justify-between items-center w-36 sm:w-44 h-28 sm:h-32 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl border border-solid border-line-soft bg-white text-center shadow-sm transition-all duration-200 hover:border-primary hover:shadow-md no-underline">
              <span class="relative flex h-14 sm:h-18 w-full items-center justify-center overflow-hidden rounded-lg bg-surface-soft/60 p-1.5">
                {%- if b_img != blank -%}
                  <img src="{{ b_img | img_url: 'medium' }}" alt="{{ b_title | escape }}" width="120" height="60" loading="lazy" class="block max-h-full max-w-full object-contain transition-transform duration-300 group-hover/card:scale-105">
                {%- else -%}
                  <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-brand-tint font-sans text-sm sm:text-base font-bold text-brand-deep">{{ b_first }}</span>
                {%- endif -%}
              </span>
              <span class="mt-1.5 sm:mt-2 flex w-full justify-center">
                <span class="inline-flex max-w-full items-center justify-center rounded-full border border-solid border-line-soft bg-white px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-brand-deep shadow-sm transition-colors group-hover/card:border-primary group-hover/card:bg-brand-tint">
                  <span class="truncate">{{ b_title | escape }}</span>
                </span>
              </span>
            </a>
          {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Hàng 2: chạy sang phải, ngược chiều (mục 2, 4, 6…) -->
    <div class="group/row overflow-hidden motion-reduce:overflow-x-auto">
      <div class="flex w-max motion-safe:animate-marquee-reverse motion-safe:[animation-duration:90s] group-hover/row:[animation-play-state:paused] group-focus-within/row:[animation-play-state:paused]">
        {%- for pass in pc_bm_passes -%}
        <div class="flex shrink-0 gap-4 pr-4"{% if pass == '2' %} aria-hidden="true"{% endif %}>
          {%- for link in brand_ll.links limit: brand_limit -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          {%- if mod == 1 -%}
            {%- assign b_title = link.title | strip -%}
            {%- assign b_first = b_title | upcase | slice: 0, 1 -%}
            {%- assign b_img = link.object.image.src | default: link.object.featured_image.src -%}
            <a href="{{ link.url | escape }}" title="{{ b_title | escape }}"{% if pass == '2' %} tabindex="-1"{% endif %} class="group/card flex shrink-0 flex-col justify-between items-center w-36 sm:w-44 h-28 sm:h-32 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl border border-solid border-line-soft bg-white text-center shadow-sm transition-all duration-200 hover:border-primary hover:shadow-md no-underline">
              <span class="relative flex h-14 sm:h-18 w-full items-center justify-center overflow-hidden rounded-lg bg-surface-soft/60 p-1.5">
                {%- if b_img != blank -%}
                  <img src="{{ b_img | img_url: 'medium' }}" alt="{{ b_title | escape }}" width="120" height="60" loading="lazy" class="block max-h-full max-w-full object-contain transition-transform duration-300 group-hover/card:scale-105">
                {%- else -%}
                  <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-brand-tint font-sans text-sm sm:text-base font-bold text-brand-deep">{{ b_first }}</span>
                {%- endif -%}
              </span>
              <span class="mt-1.5 sm:mt-2 flex w-full justify-center">
                <span class="inline-flex max-w-full items-center justify-center rounded-full border border-solid border-line-soft bg-white px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-brand-deep shadow-sm transition-colors group-hover/card:border-primary group-hover/card:bg-brand-tint">
                  <span class="truncate">{{ b_title | escape }}</span>
                </span>
              </span>
            </a>
          {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}
</section>
{%- include 'pc_swiper_boot' -%}
