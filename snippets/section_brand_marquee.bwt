{%- comment -%}
  section_brand_marquee.bwt — Thương hiệu tiêu biểu (T-18).
  Khối Swiper Slider 2 hàng chuyển động liên tục ngược chiều, full width, hover pause, edge gradients.
  100% Tailwind class theo token (UI-0), màu thương hiệu primary (UI-BRAND).
{%- endcomment -%}
{%- assign brand_menu_handle = settings.home_brand_menu | default: 'thuong-hieu' -%}
{%- assign brand_ll = linklists[brand_menu_handle] -%}
{%- if brand_ll == blank or brand_ll.links.size == 0 -%}
  {%- assign brand_ll = linklists['thuong-hieu'] -%}
{%- endif -%}

{%- assign brand_limit = settings.home_brand_limit | plus: 0 -%}
{%- if brand_limit < 1 -%}{%- assign brand_limit = 40 -%}{%- endif -%}
{%- assign brand_title_t = settings.home_brand_title | default: 'Thương hiệu tiêu biểu' | escape -%}
{%- assign brand_lead_t = settings.home_brand_lead | default: 'Nhập khẩu chính hãng' | escape -%}
{%- assign brand_sub_t = settings.home_brand_subtitle | escape -%}
{%- assign brand_viewall_t = settings.home_brand_viewall_text | default: 'Xem tất cả' | escape -%}
{%- assign brand_url = settings.home_brand_url | default: '/thuong-hieu' -%}

<section class="border-t border-line-soft bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-brand-title">
  <div class="container mb-6 lg:mb-8">
    {%- include 'ui_section_head', title: brand_title_t, title_id: 'section-brand-title', eyebrow: brand_lead_t, desc: brand_sub_t, url: brand_url, more_text: brand_viewall_t, label: 'Xem tất cả thương hiệu', wrap_class: 'mb-0' -%}
  </div>

  {%- if brand_ll.links.size > 0 -%}
  <div class="relative w-full overflow-hidden">
    <!-- Gradient mép trái -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 sm:w-24 lg:w-36 bg-gradient-to-r from-surface-soft to-transparent" aria-hidden="true"></div>
    <!-- Gradient mép phải -->
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 sm:w-24 lg:w-36 bg-gradient-to-l from-surface-soft to-transparent" aria-hidden="true"></div>

    <!-- Hàng 1: Trượt sang trái -->
    <div class="swiper-container pc-swiper-ticker mb-3 sm:mb-4 overflow-hidden motion-safe:[&>.swiper-wrapper]:!ease-linear" data-pc-brand-slider data-direction="normal" data-speed="5000">
      <div class="swiper-wrapper">
        {%- for link in brand_ll.links limit: brand_limit -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          {%- if mod == 0 -%}
            {%- assign b_title = link.title | strip -%}
            {%- assign b_first = b_title | upcase | slice: 0, 1 -%}
            {%- assign b_img = link.object.image.src | default: link.object.featured_image.src -%}
            <div class="swiper-slide !w-auto">
              <a href="{{ link.url | escape }}" title="{{ b_title | escape }}" class="group flex flex-col justify-between items-center w-36 sm:w-44 h-28 sm:h-32 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl border border-solid border-line-soft bg-white text-center shadow-sm transition-all duration-200 hover:border-primary hover:shadow-md no-underline">
                <div class="relative flex h-14 sm:h-18 w-full items-center justify-center overflow-hidden rounded-lg bg-surface-soft/60 p-1.5">
                  {%- if b_img != blank -%}
                    <img src="{{ b_img | img_url: 'medium' }}" alt="{{ b_title | escape }}" width="120" height="60" loading="lazy" class="block max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105">
                  {%- else -%}
                    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-brand-tint font-sans text-sm sm:text-base font-bold text-brand-deep">{{ b_first }}</span>
                  {%- endif -%}
                </div>
                <div class="mt-1.5 sm:mt-2 w-full flex justify-center">
                  <span class="inline-flex max-w-full items-center justify-center rounded-full border border-solid border-line-soft bg-white px-2.5 py-0.5 text-[11px] sm:text-xs font-bold uppercase tracking-wide text-brand-deep shadow-sm transition-colors group-hover:border-primary group-hover:bg-brand-tint">
                    <span class="truncate">{{ b_title | escape }}</span>
                  </span>
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Hàng 2: Trượt sang phải (ngược chiều) -->
    <div class="swiper-container pc-swiper-ticker overflow-hidden motion-safe:[&>.swiper-wrapper]:!ease-linear" data-pc-brand-slider data-direction="reverse" data-speed="5000">
      <div class="swiper-wrapper">
        {%- for link in brand_ll.links limit: brand_limit -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          {%- if mod == 1 -%}
            {%- assign b_title = link.title | strip -%}
            {%- assign b_first = b_title | upcase | slice: 0, 1 -%}
            {%- assign b_img = link.object.image.src | default: link.object.featured_image.src -%}
            <div class="swiper-slide !w-auto">
              <a href="{{ link.url | escape }}" title="{{ b_title | escape }}" class="group flex flex-col justify-between items-center w-36 sm:w-44 h-28 sm:h-32 p-2.5 sm:p-3 rounded-xl sm:rounded-2xl border border-solid border-line-soft bg-white text-center shadow-sm transition-all duration-200 hover:border-primary hover:shadow-md no-underline">
                <div class="relative flex h-14 sm:h-18 w-full items-center justify-center overflow-hidden rounded-lg bg-surface-soft/60 p-1.5">
                  {%- if b_img != blank -%}
                    <img src="{{ b_img | img_url: 'medium' }}" alt="{{ b_title | escape }}" width="120" height="60" loading="lazy" class="block max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105">
                  {%- else -%}
                    <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-brand-tint font-sans text-sm sm:text-base font-bold text-brand-deep">{{ b_first }}</span>
                  {%- endif -%}
                </div>
                <div class="mt-1.5 sm:mt-2 w-full flex justify-center">
                  <span class="inline-flex max-w-full items-center justify-center rounded-full border border-solid border-line-soft bg-white px-2.5 py-0.5 text-[11px] sm:text-xs font-bold uppercase tracking-wide text-brand-deep shadow-sm transition-colors group-hover:border-primary group-hover:bg-brand-tint">
                    <span class="truncate">{{ b_title | escape }}</span>
                  </span>
                </div>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}
</section>
{%- include 'pc_swiper_boot' -%}
