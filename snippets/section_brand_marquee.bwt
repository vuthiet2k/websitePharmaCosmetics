{%- comment -%}
  2026-10-13 (người dùng chốt): nguồn thương hiệu = Menu (settings.home_brand_menu) — cấu hình 1 lần, sau này chỉ sửa
  menu trỏ tới danh mục sản phẩm. Chưa chọn menu ⇒ tạm lấy danh sách nhà cung cấp (store.vendors) như trước.
  2026-10-16 (người dùng, theo ảnh thiết kế "Thương hiệu tiêu biểu"): bỏ dải chạy chữ dạng viên bo tròn — mỗi thương hiệu
  là 1 cột KHÔNG bo góc, KHÔNG đổ bóng: logo lớn (thương hiệu là chính, không để nhỏ) + mô tả 2 dòng bên dưới, ngăn nhau
  bằng đường kẻ dọc mảnh; dải tự chạy liên tục (Swiper loop) + mũi tên tròn 2 bên (không thanh phân trang); dòng giới thiệu dưới tiêu đề.
  - Logo: "Logo thương hiệu N" (home_brand_marquee_image_N) → ảnh danh mục mà link trỏ tới (link.object.image)
    → không có ảnh thì hiện tên thương hiệu cỡ lớn.
  - Mô tả: "Mô tả thương hiệu N" (home_brand_marquee_text_N) → mô tả danh mục nếu ngắn (≤ 70 ký tự sau khi bỏ HTML;
    mô tả dài kiểu bài giới thiệu thì không cắt bừa) → không có thì ẩn dòng mô tả.
  CSS: assets/home-portal.css (.pc-brands). Tên snippet giữ nguyên để không đổi thứ tự section đã cấu hình (home_section_N).
{%- endcomment -%}
{%- assign brand_ll = linklists[settings.home_brand_menu] -%}
{%- capture pc_br_slides -%}
{%- if settings.home_brand_menu != blank and brand_ll.links.size > 0 -%}
  {%- for link in brand_ll.links limit: 12 -%}
    {%- capture logo_key -%}home_brand_marquee_image_{{ forloop.index }}{%- endcapture -%}
    {%- capture text_key -%}home_brand_marquee_text_{{ forloop.index }}{%- endcapture -%}
    {%- assign pc_bm_img = settings[logo_key] -%}
    {%- if pc_bm_img == blank and link.object.image.src != blank -%}{%- assign pc_bm_img = link.object.image.src -%}{%- endif -%}
    {%- if pc_bm_img == blank and link.object.featured_image.src != blank -%}{%- assign pc_bm_img = link.object.featured_image.src -%}{%- endif -%}
    {%- assign pc_br_text = settings[text_key] | strip -%}
    {%- if pc_br_text == blank -%}
      {%- assign pc_br_desc = link.object.description | strip_html | strip_newlines | strip -%}
      {%- if pc_br_desc != blank and pc_br_desc.size <= 70 -%}{%- assign pc_br_text = pc_br_desc -%}{%- endif -%}
    {%- endif -%}
    <a class="swiper-slide pc-brand" href="{{ link.url | escape }}" title="{{ link.title | escape }}">
      <span class="pc-brand__logo">
        {%- if pc_bm_img != blank -%}
        <img src="{{ pc_bm_img | img_url: 'large' }}" alt="{{ link.title | escape }}" width="240" height="96" loading="lazy">
        {%- else -%}
        <span class="pc-brand__name">{{ link.title | escape }}</span>
        {%- endif -%}
      </span>
      {%- if pc_br_text != blank -%}<span class="pc-brand__text">{{ pc_br_text | escape }}</span>{%- endif -%}
    </a>
  {%- endfor -%}
{%- else -%}
  {%- for vendor in store.vendors limit: 12 -%}
    <a class="swiper-slide pc-brand" href="/collections/all?q=vendor:({{ vendor | url_encode }})&page=1&view=grid" title="{{ vendor | escape }}">
      <span class="pc-brand__logo"><span class="pc-brand__name">{{ vendor | escape }}</span></span>
    </a>
  {%- endfor -%}
{%- endif -%}
{%- endcapture -%}
{%- assign pc_bm_count = pc_br_slides | split: 'class="swiper-slide pc-brand"' | size | minus: 1 -%}
<section class="brands"><div class="wrap">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ settings.home_brand_lead | default: 'Nhập khẩu chính hãng' | escape }}</p>
      <h2>{{ settings.home_brand_title | default: 'Thương hiệu tiêu biểu' | escape }}</h2>
      {%- if settings.home_brand_subtitle != blank -%}<p class="lead pc-brands__lead">{{ settings.home_brand_subtitle | escape }}</p>{%- endif -%}
    </div>
    <a class="link-more" href="{{ settings.home_brand_url | default: settings.portal_shop_url | default: '/collections/all' | escape }}">{{ settings.home_brand_viewall_text | default: 'Xem tất cả thương hiệu' | escape }} →</a>
  </div>
  {%- if pc_bm_count > 0 -%}
  <div class="pc-brands" data-pc-brands>
    <button type="button" class="pc-brands__nav pc-brands__nav--prev" aria-label="Thương hiệu trước"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
    <div class="pc-brands__viewport swiper-container">
      <div class="swiper-wrapper">{{ pc_br_slides }}</div>
    </div>
    <button type="button" class="pc-brands__nav pc-brands__nav--next" aria-label="Thương hiệu sau"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>
  <script>
  (function () {
    // 2026-10-16 (người dùng): bỏ thanh phân trang; giữ mũi tên trước/sau 2 bên; tự chạy LIÊN TỤC như dải chạy ban đầu
    // (loop + autoplay delay 0 + chuyển động tuyến tính), rê chuột/focus thì dừng tại chỗ, rời ra chạy tiếp.
    var root = document.querySelector('[data-pc-brands]');
    if (!root || root.dataset.ready) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function init() {
      if (typeof Swiper !== 'function' || root.dataset.ready) return;
      root.dataset.ready = '1';
      var vp = root.querySelector('.pc-brands__viewport');
      var count = vp.querySelectorAll('.pc-brand').length;
      var swiper = new Swiper(vp, {
        slidesPerView: 2, spaceBetween: 0, loop: count > 2, loopedSlides: count, speed: reduce ? 400 : 3500,
        allowTouchMove: true, watchOverflow: true,
        autoplay: reduce ? false : { delay: 0, disableOnInteraction: false },
        breakpoints: { 576: { slidesPerView: 3 }, 992: { slidesPerView: 4 }, 1200: { slidesPerView: 6 } }
      });
      if (!reduce) root.classList.add('pc-brands--marquee');
      // Dừng đúng vị trí đang chạy: đọc translate hiện tại từ CSS rồi bỏ transition.
      function freeze() {
        if (reduce || !swiper.autoplay.running) return;
        swiper.autoplay.stop();
        var m = new DOMMatrixReadOnly(getComputedStyle(swiper.wrapperEl).transform);
        swiper.setTransition(0);
        swiper.setTranslate(m.m41);
        swiper.updateProgress(); // cắt transition ⇒ không có transitionEnd: tự bỏ cờ đang trượt để slide tiếp được
        swiper.animating = false;
      }
      function resume() {
        // Chỉ giữ dừng khi đang rê chuột hoặc focus BÀN PHÍM (bấm chuột vào mũi tên cũng để lại focus — không tính).
        if (reduce || root.matches(':hover') || root.querySelector(':focus-visible')) return;
        // Dừng giữa chừng đã cắt transition ⇒ Swiper không nhận transitionEnd nên cờ paused không tự bỏ; bỏ tay rồi chạy tiếp.
        swiper.autoplay.paused = false;
        swiper.autoplay.start();
      }
      root.addEventListener('mouseenter', freeze);
      root.addEventListener('mouseleave', resume);
      root.addEventListener('focusin', function (e) { if (e.target.matches(':focus-visible')) freeze(); });
      root.addEventListener('focusout', function () { window.setTimeout(resume, 0); });
      // Mũi tên: chuyển nhanh 1 thương hiệu (không theo tốc độ chạy chậm của dải).
      root.querySelector('.pc-brands__nav--prev').addEventListener('click', function () { freeze(); swiper.slidePrev(450); });
      root.querySelector('.pc-brands__nav--next').addEventListener('click', function () { freeze(); swiper.slideNext(450); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
  </script>
  {%- endif -%}
</div></section>
