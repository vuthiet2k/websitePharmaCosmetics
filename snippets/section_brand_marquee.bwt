<section class="brands"><div class="wrap">
  <div class="section-head"><div><p class="eyebrow">{{ settings.home_brand_lead | default: 'Nhập khẩu chính hãng' | escape }}</p><h2>{{ settings.home_brand_title | default: 'Thương hiệu tiêu biểu' | escape }}</h2></div><a class="link-more" href="{{ settings.home_brand_url | default: settings.portal_shop_url | default: '/collections/all' | escape }}">{{ settings.home_brand_viewall_text | default: 'Khám phá sản phẩm' | escape }} →</a></div>
  <div class="bgrid">
    {% assign brand_ll = linklists[settings.home_brand_menu] %}
    {% if brand_ll.links.size > 0 %}
      {% for link in brand_ll.links limit: 12 %}{% capture logo_key %}home_brand_marquee_image_{{ forloop.index }}{% endcapture %}<a href="{{ link.url | escape }}">{% if settings[logo_key] != blank %}<img src="{{ settings[logo_key] | img_url: 'compact' }}" alt="{{ link.title | escape }}" width="120" height="48" loading="lazy">{% else %}{{ link.title | escape }}{% endif %}</a>{% endfor %}
    {% else %}
      {% for vendor in store.vendors limit: 6 %}<a href="/collections/all?q=vendor:({{ vendor | url_encode }})&page=1&view=grid">{{ vendor | escape }}</a>{% endfor %}
    {% endif %}
  </div>
</div></section>
