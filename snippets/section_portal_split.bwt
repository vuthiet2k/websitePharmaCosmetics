{%- comment -%}
  Khối sau Hero gồm:
  (1) Dải 4 cam kết (home_trust_N_title / _desc, tắt bằng home_trust_enable)
  (2) Khám phá: 2 thẻ lối vào (Shop dược mỹ phẩm & Skin Health Beauty trị liệu 1:1).
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- unless settings.home_trust_enable == false or settings.home_trust_enable == 'false' -%}
<div class="border-0 border-b border-solid border-line-soft bg-white py-4 sm:py-6">
  <div class="container">
    {% include 'ui_trust_badges' %}
  </div>
</div>
{%- endunless -%}
<section class="m-0 bg-white px-0 py-8 lg:py-16 font-sans text-ink" aria-labelledby="section-portal-split-explore">
  <div class="container">
    <div class="mb-4 lg:mb-8 flex items-center gap-4">
      <p class="m-0 whitespace-nowrap text-xs font-bold uppercase tracking-wider text-primary" id="section-portal-split-explore">
        I · {{ settings.portal_chapter_1 | default: 'Khám phá' | escape }}
      </p>
      <span class="h-px flex-1 bg-line-soft" aria-hidden="true"></span>
    </div>
    <div class="grid grid-cols-2 gap-3 lg:gap-6">
      <a class="group box-border flex min-w-0 flex-col rounded-2xl border border-solid border-line-soft bg-surface-soft p-4 lg:p-8 no-underline" href="{{ settings.portal_shop_url | default: '/collections/all' | escape }}">
        <div class="flex min-w-0 items-center gap-2.5 lg:block">
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-deep text-white lg:hidden">
            {%- assign ps_ic = settings.portal_shop_icon | default: 'pill-bottle' -%}
            {% include 'ui_icon', name: ps_ic %}
          </span>
          <div class="min-w-0">
            <span class="m-0 block line-clamp-2 text-xs font-bold tracking-wider text-brand-deep lg:text-primary">{{ settings.portal_shop_kicker | default: 'Pharma Cosmetics' | escape }}</span>
            <h4 class="m-0 mt-0.5 lg:mt-3 line-clamp-3 lg:line-clamp-none text-xs lg:text-2xl font-semibold lg:font-bold text-primary lg:text-brand-deep">{{ settings.portal_shop_title | default: 'Mỹ phẩm chính hãng' | escape }}</h4>
          </div>
        </div>
        {%- if settings.portal_shop_desc != blank -%}
          <p class="m-0 mt-3 lg:mt-4 line-clamp-3 lg:line-clamp-none text-xs lg:text-sm leading-relaxed text-ink-muted">{{ settings.portal_shop_desc | escape }}</p>
        {%- endif -%}
        <span class="mt-4 lg:mt-6 box-border flex min-h-[44px] w-full lg:w-auto lg:inline-flex items-center justify-between lg:justify-start gap-1.5 rounded-full lg:rounded-none bg-brand-deep lg:bg-transparent px-4 py-2 lg:p-0 text-xs lg:text-sm font-bold text-white lg:text-brand-deep group-hover:underline">
          <span class="max-lg:hidden">{{ settings.portal_shop_btn_text | default: 'Vào cửa hàng' | escape }}</span><span class="lg:hidden">{{ settings.portal_shop_btn_short | default: 'Mua sắm' | escape }}</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">{% include 'ui_icon', name: 'arrow-right' %}</span>
        </span>
      </a>
      <a class="group box-border flex min-w-0 flex-col rounded-2xl border border-solid border-brand-deep bg-brand-deep p-4 lg:p-8 text-white no-underline" href="{{ settings.home_spa_btn_url | default: '/skin-health-beauty' | escape }}" title="{{ settings.home_spa_btn_text | default: 'Khám phá Skin Health Beauty' | escape }}">
        <div class="flex min-w-0 items-center gap-2.5 lg:block">
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white lg:hidden">
            {%- assign ps_ic = settings.portal_clinic_icon | default: 'shield-heart' -%}
            {% include 'ui_icon', name: ps_ic %}
          </span>
          <div class="min-w-0">
            <span class="m-0 block line-clamp-2 text-xs font-bold tracking-wider text-white/80 lg:text-white/90">{{ settings.portal_clinic_kicker | default: 'Skin Health Beauty' | escape }}</span>
            <h4 class="m-0 mt-0.5 lg:mt-3 line-clamp-3 lg:line-clamp-none text-xs lg:text-2xl font-semibold lg:font-bold text-white">{{ settings.portal_clinic_title | default: 'Trị liệu da 1:1 tại Hà Nội' | escape }}</h4>
          </div>
        </div>
        {%- if settings.portal_clinic_desc != blank -%}
          <p class="m-0 mt-3 lg:mt-4 line-clamp-3 lg:line-clamp-none text-xs lg:text-sm leading-relaxed text-white/85">{{ settings.portal_clinic_desc | escape }}</p>
        {%- endif -%}
        <span class="mt-4 lg:mt-6 box-border flex min-h-[44px] w-full lg:w-auto lg:inline-flex items-center justify-between lg:justify-start gap-1.5 rounded-full lg:rounded-none bg-white lg:bg-transparent px-4 py-2 lg:p-0 text-xs lg:text-sm font-bold text-brand-deep lg:text-white group-hover:underline">
          <span class="max-lg:hidden">{{ settings.portal_clinic_btn_text | default: 'Khám phá trị liệu' | escape }}</span><span class="lg:hidden">{{ settings.portal_clinic_btn_short | default: 'Khám phá' | escape }}</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">{% include 'ui_icon', name: 'arrow-right' %}</span>
        </span>
      </a>
    </div>
  </div>
</section>
