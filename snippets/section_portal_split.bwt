<div class="chapter"><div class="wrap"><div class="tag"><b>I</b> {{ settings.portal_chapter_1 | default: 'Khám phá' | escape }}</div><div class="rule"></div></div></div>
<section class="split"><div class="wrap"><div class="split-grid">
  <a class="entry entry-shop" href="{{ settings.portal_shop_url | default: '/collections/all' | escape }}">
    <div class="kicker">Pharma Cosmetics</div>
    <h2>{{ settings.portal_shop_title | default: 'Mua dược mỹ phẩm chính hãng' | escape }}</h2>
    <p>{{ settings.portal_shop_desc | escape }}</p><span class="go">{{ settings.portal_shop_btn_text | default: 'Vào cửa hàng' | escape }} →</span>
  </a>
  <a class="entry entry-clinic" href="{{ settings.home_spa_btn_url | default: '/skin-health-beauty' | escape }}">
    <div class="kicker">Skin Health Beauty</div>
    <h2>{{ settings.portal_clinic_title | default: 'Trị liệu da 1:1 tại Hà Nội' | escape }}</h2>
    <p>{{ settings.portal_clinic_desc | escape }}</p><span class="go">{{ settings.portal_clinic_btn_text | default: 'Khám phá trị liệu' | escape }} →</span>
  </a>
</div></div></section>
