{%- comment -%}
  section_spa.bwt — chương II "Tin cậy": Pharma Cosmetics × Skin Health Beauty.
  03/11/2026 (chủ dự án: trang chủ theo Figma "travel" node 5:2): nền xanh đậm, trái = eyebrow + tiêu đề 2 dòng
  (home_spa_title / home_spa_title_accent) + mô tả (home_spa_desc) + nhãn (portal_clinic_chips phân cách ";"; link / icon cùng thứ tự ở portal_clinic_chip_urls / portal_clinic_chip_icons — trống ⇒ nhãn chữ) + nút đặt lịch
  (home_spa_cta_text / _url, mặc định link nút 1 Hero) + địa chỉ (home_spa_address, trống ⇒ ẩn); phải = 4 thẻ bước đánh số
  portal_step_N_title / _desc (N = 1..4, có _url ⇒ thẻ là link). Bỏ ảnh / chip / carousel cũ (các trường đó giữ trong schema).
  CSS: ui-src/css/components.css mục 14.7.
{%- endcomment -%}
{%- assign spa_cta_url = settings.home_spa_cta_url | default: settings.home_hero_btn1_url | default: '/dat-lich-tu-van' -%}
{%- assign spa_tags = settings.portal_clinic_chips | split: ';' -%}
{%- assign spa_tag_urls = settings.portal_clinic_chip_urls | split: ';' -%}
{%- assign spa_tag_icons = settings.portal_clinic_chip_icons | split: ';' -%}
<section class="pc-h4 pc-h4-sec pc-h4-sec--dark" aria-labelledby="pc-h4-spa-title">
  <div class="pc-h4-wrap">
    <div class="pc-h4-chap"><p class="pc-h4-chap__tag">II · {{ settings.portal_chapter_2 | default: 'Tin cậy' | escape }}</p><span class="pc-h4-chap__rule" aria-hidden="true"></span></div>
    <div class="pc-h4-trust2">
      <div>
        <p class="pc-h4-eyebrow">{{ settings.home_spa_eyebrow | default: 'Khi routine tại nhà chưa đủ' | escape }}</p>
        <h2 class="pc-h4-trust2__t" id="pc-h4-spa-title">{{ settings.home_spa_title | default: 'Làn da cần lộ trình đúng,' | escape }}{%- if settings.home_spa_title_accent != blank -%}<br>{{ settings.home_spa_title_accent | escape }}{%- endif -%}</h2>
        {%- assign spa_desc = settings.home_spa_desc | default: settings.portal_clinic_desc -%}
        {%- if spa_desc != blank -%}<p class="pc-h4-trust2__d">{{ spa_desc | escape }}</p>{%- endif -%}
        {%- if settings.portal_clinic_chips != blank -%}
        <ul class="pc-h4-tags">
          {%- for t in spa_tags -%}{%- if t != blank -%}
          {%- assign spa_u = spa_tag_urls[forloop.index0] | strip -%}{%- assign spa_i = spa_tag_icons[forloop.index0] | strip -%}
          <li>{%- if spa_u != blank -%}<a href="{{ spa_u | escape }}">{%- endif -%}{%- if spa_i != blank -%}{% include 'ui_icon', name: spa_i, size: 'em' %} {% endif -%}{{ t | strip | escape }}{%- if spa_u != blank -%}</a>{%- endif -%}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
        {%- endif -%}
        <div class="pc-h4-trust2__act">
          <a class="pc-h4-cta" href="{{ spa_cta_url | escape }}">{{ settings.home_spa_cta_text | default: 'Đặt lịch phân tích da' | escape }}</a>
          {%- if settings.home_spa_address != blank -%}<p class="pc-h4-trust2__addr">{{ settings.home_spa_address | escape | newline_to_br }}</p>{%- endif -%}
        </div>
      </div>
      <ol class="pc-h4-steps">
        {%- assign spa_n = 0 -%}
        {%- for i in (1..4) -%}
          {%- capture k_t -%}portal_step_{{ i }}_title{%- endcapture -%}{%- capture k_d -%}portal_step_{{ i }}_desc{%- endcapture -%}{%- capture k_u -%}portal_step_{{ i }}_url{%- endcapture -%}
          {%- if settings[k_t] != blank -%}
          {%- assign spa_n = spa_n | plus: 1 -%}
          <li class="m-0">
            {%- if settings[k_u] != blank -%}<a class="pc-h4-step" href="{{ settings[k_u] | escape }}">{%- else -%}<div class="pc-h4-step">{%- endif -%}
              <span class="pc-h4-step__n block" aria-hidden="true">0{{ spa_n }}</span>
              <span class="pc-h4-step__t block">{{ settings[k_t] | escape }}</span>
              {%- if settings[k_d] != blank -%}<span class="pc-h4-step__d block">{{ settings[k_d] | escape }}</span>{%- endif -%}
            {%- if settings[k_u] != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
