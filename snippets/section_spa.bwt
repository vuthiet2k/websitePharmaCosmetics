<section class="dark-zone">
  <div class="chapter on-dark"><div class="wrap"><div class="tag"><b>II</b> {{ settings.portal_chapter_2 | default: 'Tin cậy' | escape }}</div><div class="rule"></div></div></div>
  <div class="wrap shb-grid">
    <div>
      <div class="shb-lock">Pharma Cosmetics <span>×</span> <b>Skin Health Beauty</b></div>
      <p class="eyebrow">{{ settings.home_spa_eyebrow | default: 'Khi routine tại nhà chưa đủ' | escape }}</p>
      <h2>{{ settings.home_spa_title | default: 'Khoa học vì làn da của bạn — phác đồ 1:1, không công thức chung.' | escape }}</h2>
      <p class="lead">{{ settings.home_spa_desc | default: settings.portal_clinic_desc | escape }}</p>
      <div class="chips">{% assign chips = settings.portal_clinic_chips | split: ';' %}{% for chip in chips %}<div class="chip"><i></i>{{ chip | escape }}</div>{% endfor %}</div>
      <div class="cta">
        <a class="btn btn-p" href="{{ settings.home_hero_btn1_url | default: '/dat-lich-tu-van' | escape }}">{{ settings.home_hero_btn1_text | default: 'Đặt lịch phân tích da' | escape }} →</a>
        <a class="btn btn-od" href="{{ settings.home_spa_btn_url | default: '/skin-health-beauty' | escape }}">{{ settings.home_spa_btn_text | default: 'Khám phá Skin Health Beauty' | escape }}</a>
      </div>
    </div>
    {% assign portal_diagram_clinic = true %}{% include 'portal_skin_diagram' %}{% assign portal_diagram_clinic = false %}
  </div>
  <div class="wrap"><div class="steps">
    {% for i in (1..3) %}
      {% capture title %}portal_step_{{ i }}_title{% endcapture %}{% capture desc %}portal_step_{{ i }}_desc{% endcapture %}
      <div class="step"><div class="n">0{{ i }}</div><h3>{{ settings[title] | escape }}</h3><p>{{ settings[desc] | escape }}</p></div>
    {% endfor %}
  </div></div>
</section>
