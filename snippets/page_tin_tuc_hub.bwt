{%- comment -%}
  snippets/page_tin_tuc_hub.bwt (2026-10-14) — KHỐI NỘI DUNG TRANG TỔNG TIN TỨC:
  Tách từ templates/page.tin-tuc.bwt để tái sử dụng: được gọi từ templates/page.tin-tuc.bwt,
  templates/page.bwt (khi alias là tin-tuc / trang-tin-tuc-tong) và templates/blog.bwt (khi blog.alias == 'tin-tuc'
  trên Sapo thật do URL phẳng /tin-tuc).
  Nếu danh mục đầu tiên trong news_hub_blogs chưa có bài hoặc không tồn tại, tự động lấy danh mục đầu tiên có bài làm
  nguồn khối cổng tin đầu trang (.pc-nportal). Handle thật trên Sapo: xem bảng "Đường dẫn & handle THẬT" ở .clinerules/02.
{%- endcomment -%}
{%- assign pc_nh_raw = settings.news_hub_blogs | strip -%}
{%- if pc_nh_raw == blank -%}{%- assign pc_nh_raw = 'bi-quyet, y-kien-chuyen-gia, tin-tuc-va-kien-thuc' -%}{%- endif -%}
{%- assign pc_nh_list = pc_nh_raw | split: ',' -%}
{%- assign pc_nh_main = pc_nh_list.first | strip -%}
{%- assign pc_nh_mb = blogs[pc_nh_main] -%}
{%- comment -%}
  2026-10-17: so sánh "> 0" thay cho "== 0" — danh mục khai báo mà KHÔNG tồn tại trên Sapo (vd 'tin-tuc' — /tin-tuc là Trang nội dung) có
  articles.size = nil, "nil == 0" là false ⇒ không dự phòng, mất cả khối Tin mới nhất / Tin nổi bật.
{%- endcomment -%}
{%- unless pc_nh_mb.articles.size > 0 -%}
	{%- assign pc_nh_found = false -%}
	{%- for pc_nh_try in pc_nh_list -%}
		{%- assign pc_nh_try_s = pc_nh_try | strip -%}
		{%- if pc_nh_found == false and blogs[pc_nh_try_s].articles.size > 0 -%}
			{%- assign pc_nh_found = true -%}
			{%- assign pc_nh_main = pc_nh_try_s -%}
			{%- assign pc_nh_mb = blogs[pc_nh_try_s] -%}
		{%- endif -%}
	{%- endfor -%}
{%- endunless -%}
{%- assign pc_nh_second = '' -%}
{%- if pc_nh_list.size > 1 -%}{%- assign pc_nh_second = pc_nh_list[1] | strip -%}{%- endif -%}
{%- assign pc_nh_ftag = settings.news_featured_tag | default: 'noibat' -%}
{%- assign pc_nh_count_label = settings.news_count_suffix | default: 'bài viết' -%}
<section class="pc-nhub">
	<div class="container">
		{%- comment -%} Giữ 1 <h1> ẩn cho SEO/trình đọc màn hình. {%- endcomment -%}
		<h1 class="sr-only">{{ page.title | default: blog.name | default: settings.news_hub_title | escape }}</h1>

		{%- comment -%}
			── Đầu trang kiểu cổng tin: cột trái "Tin mới nhất" = slider tin tiêu điểm
			(news_lead_count bài mới nhất của danh mục đầu) + lưới 2 cột các bài kế tiếp; cột phải "Tin nổi bật" (bài gắn tag
			nổi bật ở mọi danh mục, đánh số, mỗi trang 3 tin) + "Tin quan tâm của tôi" (bài khách đã đọc).
		{%- endcomment -%}
		{%- if pc_nh_mb.articles.size > 0 -%}
		{%- assign pc_nh_lead_n = settings.news_lead_count | default: 3 | plus: 0 -%}
		{%- assign pc_nh_grid_n = settings.news_grid_count | default: 6 | plus: 0 -%}
		{%- assign pc_nh_feat_max = settings.news_featured_count | default: 9 | plus: 0 -%}
		{%- assign pc_nh_feat_per = settings.news_featured_per_page | default: 3 | plus: 0 -%}
		{%- if pc_nh_feat_per < 1 -%}{%- assign pc_nh_feat_per = 3 -%}{%- endif -%}
		{%- assign pc_nh_fc = 0 -%}
		{%- capture pc_nh_feat -%}
			{%- for pc_nh_h in pc_nh_list -%}
				{%- assign pc_nh_hs = pc_nh_h | strip -%}
				{%- for pc_nh_a in blogs[pc_nh_hs].articles -%}
					{%- if pc_nh_fc < pc_nh_feat_max and pc_nh_a.tags contains pc_nh_ftag -%}
						{%- assign pc_nh_fc = pc_nh_fc | plus: 1 -%}
						{%- assign pc_ni_article = pc_nh_a -%}{%- assign pc_ni_style = 'rank' -%}{%- assign pc_ni_rank = pc_nh_fc -%}{% include 'news_item' %}
					{%- endif -%}
				{%- endfor -%}
			{%- endfor -%}
		{%- endcapture -%}
		{%- assign pc_nh_feat_title = settings.news_featured_title | default: 'Tin nổi bật' -%}
		{%- assign pc_nh_feat_url = '' -%}
		{%- if pc_nh_fc == 0 and pc_nh_second != '' and blogs[pc_nh_second].articles.size > 0 and pc_nh_second != pc_nh_main -%}
			{%- assign pc_nh_feat_title = blogs[pc_nh_second].name | default: blogs[pc_nh_second].title -%}
			{%- assign pc_nh_feat_url = blogs[pc_nh_second].url -%}
			{%- capture pc_nh_feat -%}
				{%- for pc_nh_a in blogs[pc_nh_second].articles limit: pc_nh_feat_max -%}
					{%- assign pc_nh_fc = forloop.index -%}
					{%- assign pc_ni_article = pc_nh_a -%}{%- assign pc_ni_style = 'rank' -%}{%- assign pc_ni_rank = forloop.index -%}{% include 'news_item' %}
				{%- endfor -%}
			{%- endcapture -%}
		{%- elsif pc_nh_fc == 0 and pc_nh_mb.articles.size > 0 -%}
			{%- capture pc_nh_feat -%}
				{%- for pc_nh_a in pc_nh_mb.articles limit: pc_nh_feat_max -%}
					{%- assign pc_nh_fc = forloop.index -%}
					{%- assign pc_ni_article = pc_nh_a -%}{%- assign pc_ni_style = 'rank' -%}{%- assign pc_ni_rank = forloop.index -%}{% include 'news_item' %}
				{%- endfor -%}
			{%- endcapture -%}
		{%- endif -%}
		{%- comment -%}
			2026-10-14: "Tin mới nhất" gom bài của MỌI danh mục trong news_hub_blogs, xếp theo thời gian đăng
			(mới → cũ) thay vì chỉ lấy danh mục đầu. Khoá sắp xếp "yyyyMMddHHmmss|handle|vị trí" ⇒ sort chuỗi
			= sort thời gian; duyệt reversed để lấy mới nhất trước. Bỏ qua handle khai báo trùng.
		{%- endcomment -%}
		{%- assign pc_nh_seen = ',' -%}
		{%- capture pc_nh_keys -%}
			{%- for pc_nh_h in pc_nh_list -%}
				{%- assign pc_nh_hs = pc_nh_h | strip -%}
				{%- assign pc_nh_hk = ',' | append: pc_nh_hs | append: ',' -%}
				{%- unless pc_nh_hs == blank or pc_nh_seen contains pc_nh_hk -%}
					{%- assign pc_nh_seen = pc_nh_seen | append: pc_nh_hs | append: ',' -%}
					{%- for pc_nh_a in blogs[pc_nh_hs].articles -%}{{ pc_nh_a.published_on | date: 'yyyyMMddHHmmss' }}|{{ pc_nh_hs }}|{{ forloop.index0 }};{%- endfor -%}
				{%- endunless -%}
			{%- endfor -%}
		{%- endcapture -%}
		{%- assign pc_nh_keys = pc_nh_keys | split: ';' | sort -%}
		{%- assign pc_nh_more = settings.news_more_short | default: 'Tất cả' -%}
		{%- capture pc_nh_nav -%}
			<div class="pc-nslider__nav">
				<button type="button" class="pc-nslider__btn" data-dir="-1" aria-label="{{ settings.news_prev_label | default: 'Tin trước' | escape }}" disabled><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg></button>
				<button type="button" class="pc-nslider__btn" data-dir="1" aria-label="{{ settings.news_next_label | default: 'Tin sau' | escape }}"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg></button>
			</div>
		{%- endcapture -%}
		<div class="pc-nportal">
			<div class="pc-nportal__main">
				<div class="pc-nhead"><h2 class="pc-nhead__title">{{ settings.news_latest_title | default: 'Tin mới nhất' | escape }}</h2><a class="pc-nhead__more" href="{{ pc_nh_mb.url }}">{{ pc_nh_more | escape }}</a></div>
				{%- comment -%} news_lead_count bài mới nhất vào Swiper (Swiper 6 nạp sẵn ở layouts/theme.bwt), các bài kế tiếp vào lưới. {%- endcomment -%}
				{%- assign pc_nh_n = 0 -%}
				{%- assign pc_nh_end = pc_nh_lead_n | plus: pc_nh_grid_n -%}
				{%- capture pc_nh_lead -%}
					{%- for pc_nh_k in pc_nh_keys reversed -%}
						{%- if pc_nh_k != blank and pc_nh_n < pc_nh_lead_n -%}
							{%- assign pc_nh_kp = pc_nh_k | split: '|' -%}{%- assign pc_nh_kh = pc_nh_kp[1] -%}{%- assign pc_nh_ki = pc_nh_kp[2] | plus: 0 -%}
							{%- assign pc_nh_n = pc_nh_n | plus: 1 -%}
							<div class="swiper-slide">
								{%- assign pc_ni_article = blogs[pc_nh_kh].articles[pc_nh_ki] -%}{%- assign pc_ni_style = 'lead' -%}{%- if pc_nh_n == 1 -%}{%- assign pc_ni_priority = true -%}{%- else -%}{%- assign pc_ni_priority = false -%}{%- endif -%}{% include 'news_item' %}
							</div>
						{%- endif -%}
					{%- endfor -%}
				{%- endcapture -%}
				{%- assign pc_ni_priority = false -%}
				{%- assign pc_nh_lead_cnt = pc_nh_n -%}
				{%- assign pc_nh_n = 0 -%}
				{%- capture pc_nh_cards -%}
					{%- for pc_nh_k in pc_nh_keys reversed -%}
						{%- if pc_nh_k != blank -%}
							{%- assign pc_nh_n = pc_nh_n | plus: 1 -%}
							{%- if pc_nh_n > pc_nh_lead_n and pc_nh_n <= pc_nh_end -%}
								{%- assign pc_nh_kp = pc_nh_k | split: '|' -%}{%- assign pc_nh_kh = pc_nh_kp[1] -%}{%- assign pc_nh_ki = pc_nh_kp[2] | plus: 0 -%}
								{%- assign pc_ni_article = blogs[pc_nh_kh].articles[pc_nh_ki] -%}{%- assign pc_ni_style = 'card' -%}{% include 'news_item' %}
							{%- endif -%}
						{%- endif -%}
					{%- endfor -%}
				{%- endcapture -%}
				<div class="pc-nslider pc-nslider--lead swiper-container" data-pc-nlead>
					<div class="swiper-wrapper">{{ pc_nh_lead }}</div>
					{%- if pc_nh_lead_cnt > 1 -%}
					<div class="pc-nslider__nav">
						<button type="button" class="pc-nslider__btn" data-dir="-1" aria-label="{{ settings.news_prev_label | default: 'Tin trước' | escape }}"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg></button>
						<div class="pc-nslider__dots"></div>
						<button type="button" class="pc-nslider__btn" data-dir="1" aria-label="{{ settings.news_next_label | default: 'Tin sau' | escape }}"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg></button>
					</div>
					{%- endif -%}
				</div>
				{%- if pc_nh_cards != blank -%}
				<div class="pc-ncards">{{ pc_nh_cards }}</div>
				{%- endif -%}
			</div>
			<aside class="pc-nportal__side">
				{%- if pc_nh_feat != blank -%}
				<div class="pc-nside">
					<div class="pc-nhead"><h2 class="pc-nhead__title">{{ pc_nh_feat_title | escape }}</h2>{% if pc_nh_feat_url != '' %}<a class="pc-nhead__more" href="{{ pc_nh_feat_url }}">{{ pc_nh_more | escape }}</a>{% endif %}</div>
					<div class="pc-nslider" data-pc-nslider data-per="{{ pc_nh_feat_per }}">
						<ol class="pc-nranks pc-nslider__track">{{ pc_nh_feat }}</ol>
						{%- if pc_nh_fc > pc_nh_feat_per -%}{{ pc_nh_nav }}{%- endif -%}
					</div>
				</div>
				{%- endif -%}
				{%- comment -%} 2026-10-17 (người dùng: "Chuyên mục để col-4 cho gọn, tương tự dạng list Tin nổi bật"): khối
				   Chuyên mục chuyển từ lưới 4 ô trải ngang vào cột phải cổng tin, mỗi dòng = 1 danh mục thật
				   (tên + số bài + bài mới nhất) theo kiểu .pc-news-rank. {%- endcomment -%}
				<div class="pc-nside">
					<div class="pc-nhead"><h2 class="pc-nhead__title">{{ settings.news_cats_title | default: 'Chuyên mục' | escape }}</h2></div>
					<ol class="pc-nranks pc-ncatlist">
						{%- assign pc_nh_ci = 0 -%}
						{%- for pc_nh_h in pc_nh_list -%}
						{%- assign pc_nh_hs = pc_nh_h | strip -%}
						{%- assign pc_nh_b = blogs[pc_nh_hs] -%}
						{%- if pc_nh_b.articles.size > 0 -%}
						{%- assign pc_nh_ci = pc_nh_ci | plus: 1 -%}
						<li class="pc-news-rank">
							<span class="pc-news-rank__no">{{ pc_nh_ci }}</span>
							<div class="pc-news-rank__body">
								<h3 class="pc-news-rank__title"><a href="{{ pc_nh_b.url }}">{{ pc_nh_b.name | default: pc_nh_b.title | escape }}</a></h3>
								<span class="pc-news-meta"><span class="pc-news-chip">{{ pc_nh_b.articles_count }} {{ pc_nh_count_label | escape }}</span></span>
								<a class="pc-ncatlist__latest" href="{{ pc_nh_b.articles.first.url }}">{{ pc_nh_b.articles.first.title | escape }}</a>
							</div>
						</li>
						{%- endif -%}
						{%- endfor -%}
						{%- if blogs[pc_nh_vblog].articles.size > 0 -%}
						{%- assign pc_nh_ci = pc_nh_ci | plus: 1 -%}
						<li class="pc-news-rank pc-ncatlist--video">
							<span class="pc-news-rank__no">{{ pc_nh_ci }}</span>
							<div class="pc-news-rank__body">
								<h3 class="pc-news-rank__title"><a href="{{ blogs[pc_nh_vblog].url }}">{{ blogs[pc_nh_vblog].name | default: blogs[pc_nh_vblog].title | escape }}</a></h3>
								<span class="pc-news-meta"><span class="pc-news-chip">{{ blogs[pc_nh_vblog].articles_count }} {{ pc_nh_count_label | escape }}</span></span>
								<a class="pc-ncatlist__latest" href="{{ blogs[pc_nh_vblog].articles.first.url }}">{{ blogs[pc_nh_vblog].articles.first.title | escape }}</a>
							</div>
						</li>
						{%- endif -%}
					</ol>
				</div>
				<div class="pc-nside" data-pc-nmine data-max="{{ settings.news_mine_count | default: 5 | plus: 0 }}" hidden>
					<div class="pc-nhead"><h2 class="pc-nhead__title">{{ settings.news_mine_title | default: 'Tin quan tâm của tôi' | escape }}</h2></div>
					<ol class="pc-nranks"></ol>
				</div>
			</aside>
		</div>
		{%- endif -%}

		{%- assign pc_nh_vblog = settings.video_blog_handle | default: 'video' -%}

		{%- comment -%} ── Khối từng chuyên mục: tin lớn + 2 ô | danh sách 4 tin. ── {%- endcomment -%}
		{%- assign pc_nh_sec_n = settings.news_section_list_count | default: 4 | plus: 0 -%}
		{%- for pc_nh_h in pc_nh_list offset: 1 -%}
		{%- assign pc_nh_hs = pc_nh_h | strip -%}
		{%- assign pc_nh_b = blogs[pc_nh_hs] -%}
		{%- if pc_nh_b.articles.size > 0 -%}
		{%- comment -%} 2026-10-17 (người dùng: khối chuyên mục "quá to", muốn "tương tự Tin mới nhất"): bỏ ảnh lớn
		   phủ chữ ('big'/'sub') ⇒ dùng lại đúng bố cục cổng tin: tin tiêu điểm 'lead' (tiêu đề + tóm tắt + ảnh phải)
		   + lưới 'card' 2 cột | cột phải viền ngăn = danh sách 'thumb'. {%- endcomment -%}
		<section class="pc-nportal pc-nportal--sec">
			<div class="pc-nportal__main">
				<div class="pc-nhead">
					<h2 class="pc-nhead__title">{{ pc_nh_b.name | default: pc_nh_b.title | escape }}</h2>
					<a class="pc-nhead__more" href="{{ pc_nh_b.url }}">{{ settings.news_more_label | default: 'Xem tất cả' | escape }} ({{ pc_nh_b.articles_count }})</a>
				</div>
				{%- assign pc_ni_article = pc_nh_b.articles.first -%}{%- assign pc_ni_style = 'lead' -%}{% include 'news_item' %}
				{%- if pc_nh_b.articles.size > 1 -%}
				<div class="pc-ncards">
					{%- for pc_nh_a in pc_nh_b.articles offset: 1 limit: 2 -%}
					{%- assign pc_ni_article = pc_nh_a -%}{%- assign pc_ni_style = 'card' -%}{% include 'news_item' %}
					{%- endfor -%}
				</div>
				{%- endif -%}
			</div>
			{%- if pc_nh_b.articles.size > 3 and pc_nh_sec_n > 0 -%}
			<aside class="pc-nportal__side">
				<div class="pc-news-thumblist">
					{%- for pc_nh_a in pc_nh_b.articles offset: 3 limit: pc_nh_sec_n -%}
					{%- assign pc_ni_article = pc_nh_a -%}{%- assign pc_ni_style = 'thumb' -%}{% include 'news_item' %}
					{%- endfor -%}
				</div>
			</aside>
			{%- endif -%}
		</section>
		{%- endif -%}
		{%- endfor -%}

		{%- comment -%} ── Video: 4 bài mới nhất của blog Video. ── {%- endcomment -%}
		{%- assign pc_nh_vcount = settings.video_hub_count | default: 4 | plus: 0 -%}
		{%- if blogs[pc_nh_vblog].articles.size > 0 and pc_nh_vcount > 0 -%}
		<section class="pc-nsec pc-vhub">
			{%- comment -%} 2026-10-17 (người dùng): tiêu đề Video tư vấn dùng .pc-nhead (chữ hoa + viền chân) đồng bộ các khối trên; thẻ video giữ nguyên. {%- endcomment -%}
			<div class="pc-nhead">
				<h2 class="pc-nhead__title">{{ settings.video_hub_title | default: 'Video tư vấn' | escape }}</h2>
				<a class="pc-nhead__more" href="{{ blogs[pc_nh_vblog].url }}">{{ settings.video_hub_more_label | default: 'Xem tất cả video' | escape }}</a>
			</div>
			<div class="pc-nvideo">
				{%- assign pc_vc_layout = 'grid' -%}{%- assign pc_vc_heading = 'h3' -%}
				{%- for pc_nh_a in blogs[pc_nh_vblog].articles limit: pc_nh_vcount -%}{%- assign pc_vc_article = pc_nh_a -%}{% include 'video_card' %}{%- endfor -%}
			</div>
		</section>
		{%- endif -%}

		{% include 'news_cta' %}
	</div>
</section>
<script>
	/* Slider "Tin mới nhất" và "Tin nổi bật" + khối "Tin quan tâm của tôi" */
	(function () {
		/* "Tin mới nhất": Swiper (vuốt trên mobile + nút + chấm trang) */
		document.querySelectorAll('[data-pc-nlead]').forEach(function (box) {
			if (typeof Swiper === 'undefined' || box.swiper || box.querySelectorAll('.swiper-slide').length < 2) return;
			new Swiper(box, {
				slidesPerView: 1,
				spaceBetween: 16,
				autoHeight: true,
				navigation: { prevEl: box.querySelector('.pc-nslider__btn[data-dir="-1"]'), nextEl: box.querySelector('.pc-nslider__btn[data-dir="1"]') },
				pagination: { el: box.querySelector('.pc-nslider__dots'), clickable: true }
			});
		});
		document.querySelectorAll('[data-pc-nslider]').forEach(function (box) {
			var track = box.querySelector('.pc-nslider__track');
			var items = Array.prototype.slice.call(track.children);
			var per = parseInt(box.getAttribute('data-per') || '1', 10);
			var pages = Math.ceil(items.length / per), cur = 0;
			var btns = box.querySelectorAll('.pc-nslider__btn');
			function show() {
				items.forEach(function (el, i) { el.hidden = Math.floor(i / per) !== cur; });
				btns.forEach(function (b) { b.disabled = +b.getAttribute('data-dir') < 0 ? cur === 0 : cur >= pages - 1; });
			}
			btns.forEach(function (b) {
				b.addEventListener('click', function () { cur = Math.max(0, Math.min(pages - 1, cur + +b.getAttribute('data-dir'))); show(); });
			});
			show();
		});
		var mine = document.querySelector('[data-pc-nmine]');
		if (!mine) return;
		var list = [];
		try { list = JSON.parse(localStorage.getItem('pc_read_articles') || '[]'); } catch (e) { list = []; }
		if (!Array.isArray(list)) return;
		var ol = mine.querySelector('ol');
		list.filter(function (a) { return a && a.url && a.title; }).slice(0, parseInt(mine.getAttribute('data-max') || '5', 10) || 5).forEach(function (a, i) {
			var li = document.createElement('li'); li.className = 'pc-news-rank';
			var no = document.createElement('span'); no.className = 'pc-news-rank__no'; no.textContent = i + 1;
			var body = document.createElement('div'); body.className = 'pc-news-rank__body';
			var h = document.createElement('h3'); h.className = 'pc-news-rank__title';
			var link = document.createElement('a'); link.href = a.url; link.textContent = a.title;
			h.appendChild(link); body.appendChild(h);
			var meta = document.createElement('span'); meta.className = 'pc-news-meta';
			if (a.date) { var t = document.createElement('time'); t.textContent = a.date; meta.appendChild(t); }
			if (a.topic) { var c = document.createElement('span'); c.textContent = a.topic; meta.appendChild(c); }
			body.appendChild(meta); li.appendChild(no); li.appendChild(body); ol.appendChild(li);
		});
		if (ol.children.length) mine.hidden = false;
	})();
</script>
