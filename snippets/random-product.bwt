<a href='{{ product.url}}' class='jas-sale-pop-img mr__20'><img width='370' height='480' src='{{ product.featured_image.src}}' alt='{{ product.name }}'/></a><div class='jas-sale-pop-content'><h4 class='fs__12 fwm mg__0'>Sản phẩm</h4><h3 class='mg__0 mt__5 mb__5 fs__18'><a href='{{ product.url}}' title='{{ product.name }}'>{{ product.name }}</a></h3><span class='fs__12 jas-sale-pop-timeago'></span></div><span class='pe-7s-close pa fs__20'></span>