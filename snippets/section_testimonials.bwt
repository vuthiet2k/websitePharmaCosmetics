<section><div class="wrap">
  <div class="section-head"><div><p class="eyebrow">{{ settings.home_testi_eyebrow | default: 'Hành trình chăm sóc da' | escape }}</p><h2>{{ settings.home_testi_title | default: 'Minh chứng cho làn da rạng rỡ' | escape }}</h2></div><p class="lead">{{ settings.home_testi_subtitle | escape }} {{ settings.home_testi_disclaimer | default: 'Kết quả khác nhau tùy cơ địa.' | escape }}</p></div>
  {%- comment -%} 2026-10-16 (người dùng: "dùng swiper thêm animate tự chuyển động cho đồng bộ"): lưới 3 thẻ → carousel Swiper
    tự chạy (.pc-cards, JS assets/testimonial-swiper.js), mũi tên tròn 2 bên như Thương hiệu/Hoạt chất. Slider ảnh trong thẻ giữ nguyên. {%- endcomment -%}
  <div class="pc-cards pc-cards--proof" data-pc-cards>
    <button type="button" class="pc-brands__nav pc-brands__nav--prev" aria-label="Câu chuyện trước"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
    <div class="pc-cards__viewport swiper-container"><div class="swiper-wrapper">
    {% for i in (1..3) %}
      {% capture title %}home_testi_{{ i }}_result_title{% endcapture %}{% capture desc %}home_testi_{{ i }}_result_desc{% endcapture %}
      {% capture author %}home_testi_{{ i }}_author{% endcapture %}{% capture tag %}home_testi_{{ i }}_tag{% endcapture %}
      {% assign case_image_count = 0 %}
      {% if settings[title] != blank %}<article class="pcase swiper-slide">
        <div class="imgs swiper-container" data-pcase-media>
          <div class="swiper-wrapper">
            {% for n in (1..3) %}
              {% capture image_key %}home_testi_{{ i }}_image_{{ n }}{% endcapture %}
              {% assign case_image = settings[image_key] %}
              {% if case_image != blank %}
                {% assign case_image_count = case_image_count | plus: 1 %}
                <div class="swiper-slide"><img src="{{ case_image | img_url: 'large' }}" alt="{{ settings[title] | escape }} — Ảnh {{ n }}" width="540" height="540" loading="lazy"></div>
              {% endif %}
            {% endfor %}
            {% if case_image_count == 0 %}
              <div class="swiper-slide"><img src="{% include 'placeholder_img_url' %}" width="540" height="540" alt="Hình ảnh đang cập nhật" loading="lazy"></div>
            {% endif %}
          </div>
          {% if case_image_count > 1 %}
          <button type="button" aria-label="Ảnh trước" class="swiper-button-prev pcase-prev">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" aria-label="Ảnh tiếp theo" class="swiper-button-next pcase-next">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="swiper-pagination pcase-pagination"></div>
          {% endif %}
        </div>
        <div class="body"><h3>{{ settings[title] | escape }}</h3><p>{{ settings[desc] | escape }}</p><div class="meta"><span>{{ settings[author] | escape }}</span><b>{{ settings[tag] | escape }}</b></div></div>
      </article>{% endif %}
    {% endfor %}
    </div></div>
    <button type="button" class="pc-brands__nav pc-brands__nav--next" aria-label="Câu chuyện sau"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>
</div></section>
