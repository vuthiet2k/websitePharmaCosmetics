{%- comment -%}
  section_testimonials.bwt — "Hành trình da của khách hàng".
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- assign testi_tabs = '' -%}
{%- assign testi_panels = '' -%}
{%- assign testi_n = 0 -%}
{%- assign testi_step_sep = '§§' -%}
{%- assign testi_lb_before = settings.home_testi_before_label | default: 'Trước' -%}
{%- assign testi_lb_after = settings.home_testi_after_label | default: 'Sau' -%}
{%- assign testi_lb_steps = settings.home_testi_steps_label | default: 'Hành trình' -%}
{%- assign testi_case_handle = settings.home_testi_blog | default: settings.clinical_case_blog_handle | default: 'truoc-va-sau' -%}
{%- assign testi_case_blog = blogs[testi_case_handle] -%}
{%- if testi_case_blog == blank -%}{%- assign testi_case_blog = blogs['truoc-va-sau'] -%}{%- endif -%}
{%- assign testi_pin_tag = settings.home_testi_pin_tag | default: 'ghim-trang-chu' | strip -%}
{%- assign testi_more_lb = settings.clinical_case_more_label | default: 'Xem chi tiết ca' -%}
{%- for testi_a in testi_case_blog.articles limit: 50 -%}
  {%- if testi_n < 3 and testi_a.tags contains testi_pin_tag -%}
    {%- assign pc_bs_article = testi_a -%}{%- include 'ba_case_source' -%}
    {%- comment -%} M-03 (17/11/2026): ẩn ca còn dữ liệu giả ([DEMO], ảnh placehold.co) cho tới khi có ca thật. {%- endcomment -%}
    {%- assign testi_real = true -%}{%- if testi_a.title contains '[DEMO]' or pc_bs_before contains 'placehold.co' -%}{%- assign testi_real = false -%}{%- endif -%}
    {%- if pc_bs_before != blank and pc_bs_after != blank and testi_real -%}
      {%- assign t_key = testi_a.id -%}
      {%- assign t_title = testi_a.title -%}
      {%- assign t_concern = pc_bs_group | default: t_title -%}
      {%- assign t_tab_who = pc_bs_customer -%}
      {%- assign t_img1 = pc_bs_before -%}{%- assign t_img2 = pc_bs_after -%}
      {%- capture t_who -%}{{ pc_bs_customer }}{% if pc_bs_age != blank %}{% if pc_bs_customer != blank %}, {% endif %}{{ pc_bs_age }} tuổi{% endif %}{% if pc_bs_city != blank %}{% if pc_bs_customer != blank or pc_bs_age != blank %}, {% endif %}{{ pc_bs_city }}{% endif %}{% if testi_a.author != blank %}{% if pc_bs_customer != blank or pc_bs_age != blank or pc_bs_city != blank %} · {% endif %}{{ testi_a.author }}{% endif %}{%- endcapture -%}
      {%- assign t_initial = pc_bs_cond | default: pc_bs_group -%}
      {%- assign t_steps = '' -%}
      {%- if testi_a.content contains '<ol' -%}
        {%- assign testi_oseg = testi_a.content | prepend: '~' | split: '<ol' -%}
        {%- assign testi_oseg = testi_oseg[1] | split: '</ol>' | first | split: '<li' -%}
        {%- for testi_li in testi_oseg offset: 1 -%}
          {%- assign testi_li_txt = testi_li | prepend: '<i ' | strip_html | strip -%}
          {%- if testi_li_txt != blank -%}{%- assign t_steps = t_steps | append: testi_li_txt | append: testi_step_sep -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign t_desc = testi_a.summary | default: testi_a.excerpt | strip_html | strip | truncate: 220 -%}
      {%- assign t_products = pc_bs_plan -%}
      {%- assign t_duration = '' -%}{%- if pc_bs_weeks != blank -%}{%- assign t_duration = pc_bs_weeks | append: ' tuần' -%}{%- endif -%}
      {%- assign t_url = testi_a.url -%}
      {%- include 'section_testimonials_case' -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if testi_n > 0 -%}
<section class="bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-testimonials-title">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start" data-h4-tabs>
      <div class="flex flex-col lg:col-span-1">
        {%- capture testi_case_fb -%}/blogs/{{ testi_case_handle }}{%- endcapture -%}
        {%- assign testi_more_url = settings.home_testi_viewall_url | default: testi_case_blog.url | default: testi_case_fb -%}
        {%- capture testi_sub -%}{{ settings.home_testi_subtitle | default: 'Ảnh thật, đăng với sự đồng ý của khách. Kết quả phụ thuộc vào tình trạng da và cơ địa mỗi người.' | escape }}{% if settings.home_testi_disclaimer != blank %} {{ settings.home_testi_disclaimer | escape }}{% endif %}{%- endcapture -%}
        {%- assign testi_title_t = settings.home_testi_title | default: 'Hành trình da của khách hàng' | escape -%}
        {%- assign testi_eyebrow_t = settings.home_testi_eyebrow | default: 'Kết quả thực tế' | escape -%}
        {%- include 'ui_section_head', title: testi_title_t, title_id: 'section-testimonials-title', eyebrow: testi_eyebrow_t, desc: testi_sub, url: testi_more_url, label: 'Xem tất cả kết quả trước và sau', mobile_only: true, wrap_class: 'mb-0' -%}
        
        <div class="swiper-container mt-6 overflow-hidden lg:overflow-visible" data-pc-slider data-gap="8" data-desktop-off>
          <ul class="swiper-wrapper m-0 list-none p-0 lg:flex-col lg:gap-2" role="tablist" aria-label="Chọn câu chuyện khách hàng">{{ testi_tabs }}</ul>
        </div>
        
        <a class="hidden lg:inline-flex items-center gap-2 mt-8 text-sm font-bold text-brand-deep hover:text-primary no-underline transition-colors" href="{{ testi_more_url | escape }}">
          <span>{{ settings.home_testi_viewall_text | default: 'Xem tất cả kết quả trước & sau' | escape }}</span>
          {% include 'ui_icon', name: 'arrow-right' %}
        </a>
      </div>
      <div class="lg:col-span-2">{{ testi_panels }}</div>
    </div>
  </div>
</section>
{%- include 'home_tabs_script' -%}
{%- include 'pc_swiper_boot' -%}
{%- endif -%}
