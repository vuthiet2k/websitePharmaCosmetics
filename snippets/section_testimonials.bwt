<section class="pc-section section--brand pc-testimonials-section">
  <div class="container">
    <div class="pc-section-header">
      <p class="pc-section-eyebrow">{{ settings.home_testi_eyebrow | default: 'Hiệu quả lâm sàng' }}</p>
      <h2 class="pc-section-title">{{ settings.home_testi_title | default: 'Minh chứng cho làn da rạng rỡ' }}</h2>
      <p class="pc-section-subtitle">{{ settings.home_testi_subtitle | default: 'Hàng nghìn khách hàng đã thay đổi làn da và tìm lại sự tự tin cùng PHARMA COSMETICS.' }}</p>
    </div>

    <div class="pc-testimonials-swiper swiper-container">
      <div class="swiper-wrapper">

        <div class="swiper-slide pc-testi-card">
          <div class="pc-testi-card-inner">
            <div class="pc-testi-treatment-tag">{{ settings.home_testi_1_tag | default: 'Liệu trình Mesotherapy' }}</div>
            <div class="flex items-center gap-1.5 mt-1.5 text-amber-500 text-xs">
              <span aria-hidden="true">★★★★★</span>
              <span class="text-gray-500 font-medium">{{ settings.home_testi_1_rating | default: '4.9/5' }}</span>
            </div>
            <div class="pc-testi-image-wrap">
              {% if settings.home_testi_1_before != blank and settings.home_testi_1_after != blank %}
                <div class="pc-testi-compare swiper-no-swiping" data-pc-compare>
                  <img class="pc-testi-compare-img lazyload" width="900" height="900"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_1_before | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_1_tag | default: 'Kết quả điều trị' }} — Trước">
                  <img class="pc-testi-compare-img pc-testi-compare-after lazyload" width="900" height="900" style="clip-path: inset(0 0 0 50%);"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_1_after | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_1_tag | default: 'Kết quả điều trị' }} — Sau"
                    onerror="this.onerror=null;this.closest('.pc-testi-compare').classList.add('pc-testi-compare--single');this.remove();">
                  <div class="pc-testi-compare-handle" aria-hidden="true">
                    <span class="pc-testi-compare-grip">
                      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M4 1L1 5L4 9M10 1L13 5L10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                  <span class="pc-testi-compare-label pc-testi-compare-label--before">Trước</span>
                  <span class="pc-testi-compare-label pc-testi-compare-label--after">Sau</span>
                </div>
              {% elsif settings.home_testi_1_before != blank %}
                <img class="pc-testi-image lazyload" width="900" height="900"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_1_before | img_url: '1024x1024' }}"
                  alt="{{ settings.home_testi_1_tag | default: 'Kết quả điều trị' }} — Trước & Sau"
                  onerror="this.onerror=null;this.nextElementSibling.style.display='';this.remove();">
                <div class="pc-testi-image-placeholder" style="display:none;"></div>
              {% else %}
                <div class="pc-testi-image-placeholder"></div>
              {% endif %}
            </div>
            <h3 class="pc-testi-result-title">{{ settings.home_testi_1_result_title | default: 'Điều trị Mụn & Thâm' }}</h3>
            <p class="pc-testi-result-desc">{{ settings.home_testi_1_result_desc | default: 'Cải thiện 85% tình trạng mụn viêm và thâm sau 4 tuần sử dụng phác đồ kết hợp.' }}</p>
            <div class="pc-testi-author-row">
              <div class="pc-testi-avatar{% if settings.home_testi_1_avatar != blank %} pc-testi-avatar--img{% endif %}">
                {%- if settings.home_testi_1_avatar != blank -%}
                <img class="lazyload" width="40" height="40"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_1_avatar | img_url: 'compact' }}"
                  alt="{{ settings.home_testi_1_author | default: 'Hương Nam' | escape }}"
                  onerror="this.onerror=null;this.closest('.pc-testi-avatar').classList.remove('pc-testi-avatar--img');this.remove();">
                {%- endif -%}
                <span class="pc-testi-avatar-initials">{{ settings.home_testi_1_author | default: 'Hương Nam' | slice: 0, 2 | upcase }}</span>
              </div>
              <div class="pc-testi-author-info">
                <span class="pc-testi-author-name">{{ settings.home_testi_1_author | default: 'Hương Nam' }}</span>
                <span class="pc-testi-author-meta">{{ settings.home_testi_1_author_meta | default: '24 tuổi, Hà Nội' }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide pc-testi-card">
          <div class="pc-testi-card-inner">
            <div class="pc-testi-treatment-tag">{{ settings.home_testi_2_tag | default: 'Liệu trình Chemical Peel' }}</div>
            <div class="flex items-center gap-1.5 mt-1.5 text-amber-500 text-xs">
              <span aria-hidden="true">★★★★★</span>
              <span class="text-gray-500 font-medium">{{ settings.home_testi_2_rating | default: '4.9/5' }}</span>
            </div>
            <div class="pc-testi-image-wrap">
              {% if settings.home_testi_2_before != blank and settings.home_testi_2_after != blank %}
                <div class="pc-testi-compare swiper-no-swiping" data-pc-compare>
                  <img class="pc-testi-compare-img lazyload" width="900" height="900"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_2_before | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_2_tag | default: 'Kết quả điều trị' }} — Trước">
                  <img class="pc-testi-compare-img pc-testi-compare-after lazyload" width="900" height="900" style="clip-path: inset(0 0 0 50%);"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_2_after | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_2_tag | default: 'Kết quả điều trị' }} — Sau"
                    onerror="this.onerror=null;this.closest('.pc-testi-compare').classList.add('pc-testi-compare--single');this.remove();">
                  <div class="pc-testi-compare-handle" aria-hidden="true">
                    <span class="pc-testi-compare-grip">
                      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M4 1L1 5L4 9M10 1L13 5L10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                  <span class="pc-testi-compare-label pc-testi-compare-label--before">Trước</span>
                  <span class="pc-testi-compare-label pc-testi-compare-label--after">Sau</span>
                </div>
              {% elsif settings.home_testi_2_before != blank %}
                <img class="pc-testi-image lazyload" width="900" height="900"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_2_before | img_url: '1024x1024' }}"
                  alt="{{ settings.home_testi_2_tag | default: 'Kết quả điều trị' }} — Trước & Sau"
                  onerror="this.onerror=null;this.nextElementSibling.style.display='';this.remove();">
                <div class="pc-testi-image-placeholder" style="display:none;"></div>
              {% else %}
                <div class="pc-testi-image-placeholder"></div>
              {% endif %}
            </div>
            <h3 class="pc-testi-result-title">{{ settings.home_testi_2_result_title | default: 'Trị Nám & Tàn Nhang' }}</h3>
            <p class="pc-testi-result-desc">{{ settings.home_testi_2_result_desc | default: 'Xóa mờ 90% hắc sắc tố, mang lại làn da trắng sáng, đều màu và rạng rỡ tự nhiên.' }}</p>
            <div class="pc-testi-author-row">
              <div class="pc-testi-avatar{% if settings.home_testi_2_avatar != blank %} pc-testi-avatar--img{% endif %}">
                {%- if settings.home_testi_2_avatar != blank -%}
                <img class="lazyload" width="40" height="40"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_2_avatar | img_url: 'compact' }}"
                  alt="{{ settings.home_testi_2_author | default: 'Anh Lan' | escape }}"
                  onerror="this.onerror=null;this.closest('.pc-testi-avatar').classList.remove('pc-testi-avatar--img');this.remove();">
                {%- endif -%}
                <span class="pc-testi-avatar-initials">{{ settings.home_testi_2_author | default: 'Anh Lan' | slice: 0, 2 | upcase }}</span>
              </div>
              <div class="pc-testi-author-info">
                <span class="pc-testi-author-name">{{ settings.home_testi_2_author | default: 'Anh Lan' }}</span>
                <span class="pc-testi-author-meta">{{ settings.home_testi_2_author_meta | default: '42 tuổi, Đà Nẵng' }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide pc-testi-card">
          <div class="pc-testi-card-inner">
            <div class="pc-testi-treatment-tag">{{ settings.home_testi_3_tag | default: 'Liệu trình trẻ hóa tế bào' }}</div>
            <div class="flex items-center gap-1.5 mt-1.5 text-amber-500 text-xs">
              <span aria-hidden="true">★★★★★</span>
              <span class="text-gray-500 font-medium">{{ settings.home_testi_3_rating | default: '4.9/5' }}</span>
            </div>
            <div class="pc-testi-image-wrap">
              {% if settings.home_testi_3_before != blank and settings.home_testi_3_after != blank %}
                <div class="pc-testi-compare swiper-no-swiping" data-pc-compare>
                  <img class="pc-testi-compare-img lazyload" width="900" height="900"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_3_before | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_3_tag | default: 'Kết quả điều trị' }} — Trước">
                  <img class="pc-testi-compare-img pc-testi-compare-after lazyload" width="900" height="900" style="clip-path: inset(0 0 0 50%);"
                    src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                    data-src="{{ settings.home_testi_3_after | img_url: '1024x1024' }}"
                    alt="{{ settings.home_testi_3_tag | default: 'Kết quả điều trị' }} — Sau"
                    onerror="this.onerror=null;this.closest('.pc-testi-compare').classList.add('pc-testi-compare--single');this.remove();">
                  <div class="pc-testi-compare-handle" aria-hidden="true">
                    <span class="pc-testi-compare-grip">
                      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M4 1L1 5L4 9M10 1L13 5L10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                  <span class="pc-testi-compare-label pc-testi-compare-label--before">Trước</span>
                  <span class="pc-testi-compare-label pc-testi-compare-label--after">Sau</span>
                </div>
              {% elsif settings.home_testi_3_before != blank %}
                <img class="pc-testi-image lazyload" width="900" height="900"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_3_before | img_url: '1024x1024' }}"
                  alt="{{ settings.home_testi_3_tag | default: 'Kết quả điều trị' }} — Trước & Sau"
                  onerror="this.onerror=null;this.nextElementSibling.style.display='';this.remove();">
                <div class="pc-testi-image-placeholder" style="display:none;"></div>
              {% else %}
                <div class="pc-testi-image-placeholder"></div>
              {% endif %}
            </div>
            <h3 class="pc-testi-result-title">{{ settings.home_testi_3_result_title | default: 'Tái cấu trúc Collagen' }}</h3>
            <p class="pc-testi-result-desc">{{ settings.home_testi_3_result_desc | default: 'Công nghệ xóa nhăn độc quyền giúp làn da săn chắc, đàn hồi và trẻ hóa 5–10 tuổi chỉ sau một liệu trình.' }}</p>
            <div class="pc-testi-author-row">
              <div class="pc-testi-avatar{% if settings.home_testi_3_avatar != blank %} pc-testi-avatar--img{% endif %}">
                {%- if settings.home_testi_3_avatar != blank -%}
                <img class="lazyload" width="40" height="40"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
                  data-src="{{ settings.home_testi_3_avatar | img_url: 'compact' }}"
                  alt="{{ settings.home_testi_3_author | default: 'Minh Thảo' | escape }}"
                  onerror="this.onerror=null;this.closest('.pc-testi-avatar').classList.remove('pc-testi-avatar--img');this.remove();">
                {%- endif -%}
                <span class="pc-testi-avatar-initials">{{ settings.home_testi_3_author | default: 'Minh Thảo' | slice: 0, 2 | upcase }}</span>
              </div>
              <div class="pc-testi-author-info">
                <span class="pc-testi-author-name">{{ settings.home_testi_3_author | default: 'Minh Thảo' }}</span>
                <span class="pc-testi-author-meta">{{ settings.home_testi_3_author_meta | default: 'Giám đốc Sáng tạo' }}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="pc-testi-nav">
        <button class="pc-testi-btn-prev" aria-label="Trước">
          <svg width="7" height="12" viewBox="0 0 7 12" fill="none"><path d="M6 1L1 6L6 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pc-testi-dots"></div>
        <button class="pc-testi-btn-next" aria-label="Tiếp">
          <svg width="7" height="12" viewBox="0 0 7 12" fill="none"><path d="M1 1L6 6L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <div class="pc-testi-cta-row">
      <a href="{{ settings.home_testi_cta_url | default: '/phan-hoi-cua-khach-hang' }}" class="pc-btn pc-btn-secondary pc-testi-cta">
        {{ settings.home_testi_cta_text | default: 'Xem thêm phản hồi của khách hàng' }}
      </a>
    </div>
  </div>
</section>

<style>
.pc-testimonials-swiper {
  overflow: visible !important;
  padding: 20px 0 60px;
}
.pc-testimonials-swiper .swiper-wrapper {
  align-items: center;
}

.pc-testimonials-swiper .swiper-slide {
  width: 450px;
  transition: transform 0.5s ease, opacity 0.5s ease, filter 0.5s ease;
  transform: scale(0.85);
  opacity: 0.4;
  filter: blur(2px);
}
.pc-testimonials-swiper .swiper-slide-active {
  transform: scale(1.05);
  opacity: 1;
  filter: blur(0);
  z-index: 2;
}

.pc-testi-card {
  background: var(--white);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  border: 1px solid rgba(255,255,255,0.1);
}
.pc-testi-card-inner {
  padding: 24px 24px 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pc-testi-treatment-tag {
  display: inline-block;
  padding: 6px 16px;
  background: rgba(60, 179, 113, 0.1);
  color: var(--mainColorDark);
  border-radius: 50px;
  font-size: var(--fs-xs);
  font-weight: 700;
  font-family: var(--font-secondary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  align-self: flex-start;
}

/* Ảnh trước & sau — 1 ảnh thiết kế sẵn, vuông 1:1 */
.pc-testi-image-wrap {
  width: calc(100% + 48px);
  margin: 0 -24px;
  aspect-ratio: 1;
  overflow: hidden;
}
.pc-testi-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pc-testi-image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--bg-subtle) 0%, var(--lineColor) 100%);
}

/* Widget so sánh Trước/Sau — kéo thanh chia đôi (clip-path do JS cập nhật) */
.pc-testi-compare {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  cursor: ew-resize;
}
.pc-testi-compare-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
}
.pc-testi-compare-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2px;
  margin-left: -1px;
  background: #fff;
  box-shadow: 0 0 8px rgba(0,0,0,0.35);
}
.pc-testi-compare-grip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mainColorDark);
}
.pc-testi-compare-label {
  position: absolute;
  top: 12px;
  padding: 4px 10px;
  border-radius: 100px;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: var(--fs-xs);
  font-weight: 600;
  pointer-events: none;
}
.pc-testi-compare-label--before { left: 12px; }
.pc-testi-compare-label--after { right: 12px; }
.pc-testi-compare--single .pc-testi-compare-handle,
.pc-testi-compare--single .pc-testi-compare-label--after { display: none; }

/* Avatar ảnh thật — fallback chữ viết tắt khi ảnh trống/lỗi */
.pc-testi-avatar--img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.pc-testi-avatar--img .pc-testi-avatar-initials { display: none; }

/* CTA cuối section */
.pc-testi-cta-row {
  text-align: center;
  margin-top: 8px;
}

.pc-testi-result-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  font-family: var(--font-primary);
  color: var(--textBody);
  margin: 0;
}
.pc-testi-result-desc {
  font-size: var(--fs-base);
  color: var(--textSub);
  line-height: 1.6;
  margin: 0;
}
.pc-testi-author-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--lineColor);
}
.pc-testi-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--mainColorDark);
  color: #fff;
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.pc-testi-author-name {
  display: block;
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--textBody);
}
.pc-testi-author-meta {
  display: block;
  font-size: var(--fs-xs);
  color: var(--textSub);
  margin-top: 2px;
}

/* Navigation */
.pc-testi-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 48px;
}
.pc-testi-btn-prev,
.pc-testi-btn-next {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 1px solid var(--lineColor);
  background: transparent;
  color: var(--mainColorDark);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s, border-color .2s, color .2s;
  flex-shrink: 0;
}
.pc-testi-btn-prev:hover,
.pc-testi-btn-next:hover {
  background: var(--mainColorDark);
  border-color: var(--mainColorDark);
  color: #fff;
}

.pc-testi-dots {
  display: flex;
  gap: 8px;
  align-items: center;
}
.pc-testi-dot {
  width: 32px;
  height: 4px;
  border-radius: 2px;
  background: var(--lineColor);
  transition: background .3s, width .3s;
  cursor: pointer;
}
.pc-testi-dot--mid {
  background: var(--mainColorDark);
  width: 48px;
}

@media (max-width: 767px) {
  .pc-testimonials-swiper { padding-top: 0; }
  .pc-testimonials-swiper .swiper-slide {
    width: 85vw;
  }
  .pc-testimonials-swiper .swiper-slide-active {
    transform: scale(1);
  }
}
@media (max-width: 480px) {
  .pc-testimonials-swiper .swiper-slide { width: 90vw; }
  .pc-testi-card-inner { padding: 16px 16px 20px; gap: 12px; }
  .pc-testi-image-wrap { width: calc(100% + 32px); margin: 0 -16px; aspect-ratio: 1; }
}
</style>

<script>
$(function() {
  if (!$('.pc-testimonials-swiper').length) return;
  var testiSwiper = new Swiper('.pc-testimonials-swiper', {
    slidesPerView: 'auto',
    spaceBetween: 24,
    centeredSlides: true,
    loop: true,
    speed: 800,
    grabCursor: true,
    watchSlidesProgress: true,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
    navigation: {
      nextEl: '.pc-testi-btn-next',
      prevEl: '.pc-testi-btn-prev',
    },
    pagination: {
      el: '.pc-testi-dots',
      clickable: true,
      bulletClass: 'pc-testi-dot',
      bulletActiveClass: 'pc-testi-dot--mid',
      renderBullet: function(index, className) {
        return '<span class="' + className + '"></span>';
      },
    },
  });

  // Dừng auto-next khi khách đang xem: hover vào carousel (desktop)
  var autoStop  = function() { if (testiSwiper.autoplay) testiSwiper.autoplay.stop(); };
  var autoStart = function() { if (testiSwiper.autoplay) testiSwiper.autoplay.start(); };
  var testiEl = document.querySelector('.pc-testimonials-swiper');
  if (testiEl) {
    testiEl.addEventListener('mouseenter', autoStop);
    testiEl.addEventListener('mouseleave', autoStart);
  }

  // Widget so sánh Trước/Sau — init SAU new Swiper để bắt cả slide clone (loop: true)
  document.querySelectorAll('[data-pc-compare]').forEach(function(box) {
    var after = box.querySelector('.pc-testi-compare-after');
    var handle = box.querySelector('.pc-testi-compare-handle');
    if (!after || !handle) return;
    function setPos(clientX) {
      var r = box.getBoundingClientRect();
      if (!r.width) return;
      var p = Math.max(3, Math.min(97, (clientX - r.left) / r.width * 100));
      after.style.clipPath = 'inset(0 0 0 ' + p + '%)';
      handle.style.left = p + '%';
    }
    var dragging = false;
    box.addEventListener('pointerdown', function(e) {
      dragging = true;
      autoStop(); // đang kéo so sánh → không auto chuyển slide (mobile không có hover)
      if (box.setPointerCapture) box.setPointerCapture(e.pointerId);
      setPos(e.clientX);
      e.preventDefault();
    });
    box.addEventListener('pointermove', function(e) { if (dragging) setPos(e.clientX); });
    ['pointerup', 'pointercancel'].forEach(function(ev) {
      box.addEventListener(ev, function() { dragging = false; autoStart(); });
    });
  });
});
</script>
