{%- comment -%}
  section_testimonials.bwt — Khối "Trước & Sau" trang chủ (T-19).
  25/11/2026 (chủ dự án, theo ảnh mẫu + kênh youtube.com/@pharmacosmetics/shorts): dựng lại dạng Shorts —
  - Dữ liệu: bài trong blog Trước & Sau (settings.home_testi_blog ⇒ clinical_case_blog_handle). Tag mỗi bài:
    youtube:<ID|link short> (video_source), dichvu:<nhóm dịch vụ> (tab lọc), thoigian:<"6 tháng"> (nhãn thẻ),
    phacdo:<tiêu đề ngắn trên thẻ — trống thì dùng tiêu đề bài> (ba_case_source). Hướng dẫn: docs/huong-dan-tao-ca-truoc-sau.md.
  - Danh sách = Swiper (pc_swiper_boot › buildReelsSlider: nút ←/→ ở đầu khối + thanh tiến trình).
  - Ảnh thẻ = ảnh đại diện bài; chưa có thì ảnh dọc của short YouTube, rồi tới ảnh trong bài.
  - Rê chuột (máy có chuột) ⇒ phát video tắt tiếng ngay trong thẻ; bấm/chạm thẻ ⇒ mở short trên YouTube (bài không có
    video ⇒ mở trang chi tiết ca).
  - Tab lọc tự sinh từ các giá trị dichvu: (không ghi cứng); số "N hành trình" tự đếm theo tab.
  100% Tailwind theo token (UI-0), màu thương hiệu qua bg-primary / text-primary-deep (UI-BRAND).
{%- endcomment -%}
{%- assign testi_case_handle = settings.home_testi_blog | default: settings.clinical_case_blog_handle | default: 'truoc-va-sau' -%}
{%- assign testi_case_blog = blogs[testi_case_handle] -%}
{%- if testi_case_blog == blank -%}{%- assign testi_case_blog = blogs['truoc-va-sau'] -%}{%- endif -%}

{%- assign testi_eyebrow_t = settings.home_testi_eyebrow | default: 'Hành trình thật · Khách hàng trên khắp Việt Nam' -%}
{%- assign testi_title_t = settings.home_testi_title | default: 'Trước & Sau' -%}
{%- assign testi_tagline_t = settings.home_testi_tagline | default: 'Cá nhân hoá chăm sóc da từ xa' -%}
{%- assign testi_sub_t = settings.home_testi_subtitle | default: 'Mỗi video là một hành trình được theo dõi từ ảnh da ban đầu, qua phác đồ cá nhân hoá, đến kết quả sau nhiều tháng kiên trì tại nhà. Nhấn vào video để xem đầy đủ trên YouTube' -%}
{%- assign testi_channel_url = settings.video_youtube_url | default: 'https://www.youtube.com/@pharmacosmetics' -%}
{%- assign testi_channel_t = settings.home_testi_channel_label | default: '@pharmacosmetics' -%}
{%- assign testi_all_t = settings.home_testi_all_label | default: 'Tất cả' -%}
{%- assign testi_count_t = settings.home_testi_count_label | default: 'hành trình' -%}
{%- assign testi_badge_t = settings.home_testi_brand_badge | default: 'PC' -%}
{%- assign testi_yt_t = settings.video_open_youtube_label | default: 'Xem trên YouTube' -%}
{%- assign testi_more_t = settings.clinical_case_more_label | default: 'Xem chi tiết ca' -%}
{%- capture testi_case_fb -%}/blogs/{{ testi_case_handle }}{%- endcapture -%}
{%- assign testi_more_url = settings.home_testi_viewall_url | default: testi_case_blog.url | default: testi_case_fb -%}
{%- assign testi_more_lb = settings.home_testi_viewall_text | default: 'Xem tất cả kết quả trước & sau' -%}
{%- assign testi_note_t = settings.home_testi_disclaimer | default: 'Hình ảnh khách hàng thực tế của Pharma Cosmetics. Kết quả khác nhau tuỳ tình trạng da, cơ địa và mức độ tuân thủ phác đồ.' -%}

{%- if testi_case_blog.articles.size > 0 -%}
{%- comment -%} Lượt 1: gom các nhóm dịch vụ (tag dichvu:) không trùng, theo thứ tự xuất hiện ⇒ tab lọc. {%- endcomment -%}
{%- assign testi_services = '|' -%}
{%- assign testi_total = 0 -%}
{%- for testi_a in testi_case_blog.articles limit: 24 -%}
  {%- assign testi_total = testi_total | plus: 1 -%}
  {%- for testi_tag in testi_a.tags -%}
    {%- assign testi_tk = testi_tag | split: ':' | first | strip | downcase -%}
    {%- if testi_tk == 'dichvu' -%}
      {%- assign testi_tv = testi_tag | split: ':' | first -%}
      {%- assign testi_tv = testi_tag | remove_first: testi_tv | remove_first: ':' | strip -%}
      {%- assign testi_tw = '|' | append: testi_tv | append: '|' -%}
      {%- if testi_tv != blank -%}{%- unless testi_services contains testi_tw -%}{%- assign testi_services = testi_services | append: testi_tv | append: '|' -%}{%- endunless -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign testi_service_list = testi_services | remove_first: '|' | split: '|' -%}

<section class="border-t border-line-soft bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-testimonials-title" data-reels-section>
  <div class="container">
    <div class="flex items-end justify-between gap-6">
      <div class="min-w-0 max-w-2xl">
        {%- if testi_eyebrow_t != blank -%}<p class="m-0 text-xs font-bold uppercase tracking-widest text-primary-deep">{{ testi_eyebrow_t | escape }}</p>{%- endif -%}
        <h2 class="m-0 mt-2 text-3xl lg:text-4xl font-bold uppercase leading-tight text-primary-deep" id="section-testimonials-title">{{ testi_title_t | escape }}</h2>
        {%- if testi_tagline_t != blank -%}<p class="m-0 mt-2 text-lg lg:text-xl font-semibold text-primary-deep">{{ testi_tagline_t | escape }}</p>{%- endif -%}
        {%- if testi_sub_t != blank -%}
        <p class="m-0 mt-3 text-sm leading-relaxed text-ink-secondary">
          {{ testi_sub_t | escape }}
          {%- if testi_channel_url != blank and testi_channel_t != blank %} <a href="{{ testi_channel_url | escape }}" target="_blank" rel="noopener" class="font-semibold text-primary-deep underline underline-offset-2 hover:text-primary">{{ testi_channel_t | escape }}</a>.{%- endif -%}
        </p>
        {%- endif -%}
      </div>
      <div class="flex shrink-0 items-center gap-3 max-md:hidden">
        <button type="button" data-reels-prev aria-label="Hành trình trước" class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-solid border-primary-deep bg-white text-primary-deep transition-colors hover:bg-primary-tint disabled:cursor-default disabled:opacity-40">
          {%- include 'ui_icon', name: 'arrow-left', size: 20 -%}
        </button>
        <button type="button" data-reels-next aria-label="Hành trình kế tiếp" class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-solid border-primary-deep bg-primary-deep text-white transition-colors hover:bg-primary-darkest disabled:cursor-default disabled:opacity-40">
          {%- include 'ui_icon', name: 'arrow-right', size: 20 -%}
        </button>
      </div>
    </div>

    {%- comment -%} Tab lọc theo nhóm dịch vụ — chỉ hiện khi có ≥ 1 bài gắn tag dichvu:. {%- endcomment -%}
    <div class="mt-6 flex flex-nowrap items-center gap-2 overflow-x-auto pb-1" role="group" aria-label="Lọc theo dịch vụ">
      {%- if testi_service_list.size > 0 -%}
      <button type="button" data-reels-tab="all" aria-pressed="true" class="inline-flex min-h-[44px] shrink-0 items-center justify-center whitespace-nowrap rounded-full border border-solid border-primary-deep bg-primary-deep px-4 text-xs sm:text-sm font-semibold text-white transition-colors">{{ testi_all_t | escape }}</button>
      {%- for testi_sv in testi_service_list -%}
      <button type="button" data-reels-tab="{{ testi_sv | escape }}" aria-pressed="false" class="inline-flex min-h-[44px] shrink-0 items-center justify-center whitespace-nowrap rounded-full border border-solid border-line bg-white px-4 text-xs sm:text-sm font-semibold text-ink transition-colors hover:border-primary-deep hover:text-primary-deep">{{ testi_sv | escape }}</button>
      {%- endfor -%}
      {%- endif -%}
      <span class="shrink-0 whitespace-nowrap pl-2 text-xs text-ink-muted" aria-live="polite"><span data-reels-count>{{ testi_total }}</span> {{ testi_count_t | escape }}</span>
    </div>

    {%- comment -%} Swiper (pc_swiper_boot › buildReelsSlider). Rộng thẻ: mobile ~1.6 thẻ, md 3, lg 5 (khớp ảnh mẫu). {%- endcomment -%}
    <div class="swiper-container mt-6 overflow-hidden" data-reels-swiper>
      <div class="swiper-wrapper">
        {%- for testi_a in testi_case_blog.articles limit: 24 -%}
          {%- assign pc_bs_article = testi_a -%}{%- include 'ba_case_source' -%}
          {%- assign pc_vs_article = testi_a -%}{%- include 'video_source' -%}
          {%- assign r_title = pc_bs_plan | default: testi_a.title -%}
          {%- assign r_vid = '' -%}{%- if pc_vs_src == 'youtube' -%}{%- assign r_vid = pc_vs_id -%}{%- endif -%}
          {%- if r_vid != blank -%}
            {%- assign r_href = 'https://www.youtube.com/shorts/' | append: r_vid -%}
          {%- else -%}
            {%- assign r_href = testi_a.url -%}
          {%- endif -%}
          {%- assign r_cover = '' -%}
          {%- if testi_a.image.src != blank -%}{%- assign r_cover = testi_a.image.src | img_url: 'large' -%}
          {%- elsif r_vid != blank -%}{%- assign r_cover = 'https://i.ytimg.com/vi/' | append: r_vid | append: '/oar2.jpg' -%}
          {%- elsif pc_bs_after != blank -%}{%- assign r_cover = pc_bs_after -%}
          {%- elsif pc_bs_imgs != blank -%}{%- assign r_cover = pc_bs_imgs | split: '|' | first -%}
          {%- endif -%}
          <div class="swiper-slide !w-[62%] sm:!w-[40%] md:!w-[30%] lg:!w-[calc((100%_-_4rem)/5)]" data-reels-slide data-category="{{ pc_bs_service | escape }}">
            <a href="{{ r_href | escape }}"{% if r_vid != blank %} target="_blank" rel="noopener"{% endif %} title="{{ testi_a.title | escape }}" class="group relative block aspect-[9/16] w-full overflow-hidden rounded-2xl bg-slate-900 no-underline" data-reels-card{% if r_vid != blank %} data-video-id="{{ r_vid | escape }}"{% endif %}>
              {%- if r_cover != blank -%}
              <img src="{{ r_cover }}" alt="{{ testi_a.title | escape }}" width="360" height="640" loading="lazy" class="absolute inset-0 h-full w-full object-cover">
              {%- endif -%}
              <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-0 transition-opacity duration-300" data-reels-frame></div>

              <div class="pointer-events-none absolute inset-x-0 top-0 flex items-center justify-between p-3">
                {%- if pc_bs_time != blank -%}
                <span class="inline-flex items-center rounded-full bg-primary px-2.5 py-1 text-xs font-bold uppercase text-white">{{ pc_bs_time | escape }}</span>
                {%- else -%}<span></span>{%- endif -%}
                {%- if r_vid != blank -%}<span class="inline-flex text-white" aria-hidden="true">{%- include 'ui_icon', name: 'video', size: 18 -%}</span>{%- endif -%}
              </div>

              {%- if r_vid != blank -%}
              <span class="pointer-events-none absolute left-1/2 top-1/2 inline-flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-ink transition-opacity duration-300" data-reels-play aria-hidden="true">
                {%- include 'ui_icon', name: 'play', size: 18 -%}
              </span>
              {%- endif -%}

              <div class="absolute inset-x-2.5 bottom-2.5 flex items-center gap-2.5 rounded-xl bg-white p-2.5">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-deep text-xs font-bold text-white" aria-hidden="true">{{ testi_badge_t | escape }}</span>
                <span class="min-w-0 flex-1">
                  <span class="line-clamp-2 block text-xs font-bold leading-snug text-ink">{{ r_title | escape }}</span>
                  <span class="mt-0.5 block truncate text-xs text-ink-muted">{% if r_vid != blank %}{{ testi_yt_t | escape }}{% else %}{{ testi_more_t | escape }}{% endif %}</span>
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-line-soft" aria-hidden="true">
      <div class="h-full w-full origin-left scale-x-0 rounded-full bg-primary transition-transform duration-300" data-reels-progress></div>
    </div>
    <div class="mt-3 flex flex-col gap-2 md:flex-row md:items-start md:justify-between md:gap-6">
      {%- if testi_note_t != blank -%}<p class="m-0 text-xs text-ink-muted">{{ testi_note_t | escape }}</p>{%- endif -%}
      {%- if testi_more_url != blank and testi_more_lb != blank -%}
      <a href="{{ testi_more_url | escape }}" class="inline-flex min-h-[44px] shrink-0 items-center gap-1.5 whitespace-nowrap text-sm font-semibold text-primary-deep no-underline hover:text-primary md:min-h-0">{{ testi_more_lb | escape }} {% include 'ui_icon', name: 'arrow-right', size: 16 %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function () {
  // Rê chuột (chỉ máy có chuột) ⇒ phát short tắt tiếng ngay trong thẻ; rời chuột ⇒ gỡ iframe, trả lại ảnh đại diện.
  function initReelsVideo(section) {
    if (!(window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches)) return;
    Array.prototype.forEach.call(section.querySelectorAll('[data-reels-card][data-video-id]'), function (card) {
      if (card._reelsHoverBound) return;
      card._reelsHoverBound = true;
      var vid = card.getAttribute('data-video-id');
      var frame = card.querySelector('[data-reels-frame]');
      var play = card.querySelector('[data-reels-play]');
      if (!vid || !frame) return;
      var timer = null;
      card.addEventListener('mouseenter', function () {
        timer = setTimeout(function () {
          frame.innerHTML = '<iframe class="pointer-events-none absolute left-1/2 top-1/2 h-[120%] w-[220%] -translate-x-1/2 -translate-y-1/2 border-0" src="https://www.youtube-nocookie.com/embed/' + encodeURIComponent(vid) + '?autoplay=1&mute=1&playsinline=1&controls=0&loop=1&playlist=' + encodeURIComponent(vid) + '&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&cc_load_policy=0" allow="autoplay; encrypted-media" tabindex="-1" title=""></iframe>';
          var ifr = frame.firstChild;
          ifr.addEventListener('load', function () {
            setTimeout(function () {
              if (!frame.firstChild) return;
              frame.classList.remove('opacity-0');
              if (play) play.classList.add('opacity-0');
            }, 400);
          });
        }, 200);
      });
      card.addEventListener('mouseleave', function () {
        if (timer) clearTimeout(timer);
        frame.classList.add('opacity-0');
        frame.innerHTML = '';
        if (play) play.classList.remove('opacity-0');
      });
    });
  }

  // Tab lọc theo dịch vụ (khớp đúng giá trị tag dichvu:) + đếm số hành trình đang hiện.
  function initReelsTabs(section) {
    if (section._reelsTabsBound) return;
    section._reelsTabsBound = true;
    var tabs = section.querySelectorAll('[data-reels-tab]');
    var count = section.querySelector('[data-reels-count]');
    var swiperEl = section.querySelector('[data-reels-swiper]');
    var on = ['bg-primary-deep', 'border-primary-deep', 'text-white'];
    var off = ['bg-white', 'border-line', 'text-ink'];
    Array.prototype.forEach.call(tabs, function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-reels-tab');
        Array.prototype.forEach.call(tabs, function (b) {
          var active = b === btn;
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          (active ? off : on).forEach(function (c) { b.classList.remove(c); });
          (active ? on : off).forEach(function (c) { b.classList.add(c); });
        });
        var shown = 0;
        Array.prototype.forEach.call(section.querySelectorAll('[data-reels-slide]'), function (slide) {
          var match = cat === 'all' || slide.getAttribute('data-category') === cat;
          slide.classList.toggle('!hidden', !match);
          if (match) shown++;
        });
        if (count) count.textContent = shown;
        if (swiperEl && swiperEl.swiper) { swiperEl.swiper.update(); swiperEl.swiper.slideTo(0, 0); }
      });
    });
  }

  function boot() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-reels-section]'), function (section) {
      initReelsVideo(section);
      initReelsTabs(section);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{%- include 'pc_swiper_boot' -%}
{%- endif -%}
