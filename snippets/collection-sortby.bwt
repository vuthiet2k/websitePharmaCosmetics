<div class="sort-cate clearfix">
	{%- comment -%}
	  2026-10-08 (thiết kế trang danh mục): hàng công cụ = số sản phẩm | ô chọn sắp xếp + nút lưới/danh sách;
	  các nút sắp xếp nhanh (pill) ở hàng dưới. Ô chọn và pill gọi cùng sortby() trong col.js.
	  Chế độ lưới/danh sách lưu theo từng trình duyệt (localStorage) qua thuộc tính html[data-pc-view],
	  nằm ngoài #ajax-result nên không mất khi lọc AJAX.
	{%- endcomment -%}
	{%- assign _result_count = paginate.items | default: collection.products_count | default: search.results_count -%}
	{%- comment -%} 2026-10-10: paginate.items = 0 (không phải nil) thì default không thay ⇒ lấy số SP của danh mục. {%- endcomment -%}
	{%- if _result_count == 0 and collection.products_count > 0 -%}{%- assign _result_count = collection.products_count -%}{%- endif -%}
	<div class="sort-cate-bar">
	{%- if _result_count > 0 -%}
	<div class="sort-cate-count">
		{%- comment -%} 2026-10-10: "Sản phẩm (36)" theo thiết kế design/danh-muc/danh-muc-san-pham.png. {%- endcomment -%}
		<span class="sort-cate-count__label">{{ settings.collection_products_label | default: 'Sản phẩm' | escape }}</span> (<span class="sort-count-num">{{ _result_count }}</span>)
	</div>
	{%- endif -%}
	<div class="sort-cate-tools">
		<label class="sort-cate-select">
			<span class="sr-only">Sắp xếp</span>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3.5 2.5a.5.5 0 0 0-1 0v9.8l-1.15-1.15a.5.5 0 0 0-.7.7l2 2a.5.5 0 0 0 .7 0l2-2a.5.5 0 0 0-.7-.7L3.5 12.3V2.5ZM7 3.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5Zm0 3a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5Zm0 3a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z"/></svg>
			<select class="sort-cate-select__input" onchange="sortby(this.value)" aria-label="Sắp xếp">
				<option value="default">Sắp xếp</option>
				<option value="alpha-asc">Tên A-Z</option>
				<option value="alpha-desc">Tên Z-A</option>
				<option value="created-desc">Hàng mới</option>
				<option value="price-asc">Giá thấp đến cao</option>
				<option value="price-desc">Giá cao xuống thấp</option>
			</select>
		</label>
		<div class="pc-view-toggle" role="group" aria-label="Kiểu hiển thị">
			<button type="button" class="pc-view-toggle__btn" data-pc-view="grid" aria-pressed="true" title="Dạng lưới">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="1" y="1" width="6" height="6" rx="1.5"/><rect x="9" y="1" width="6" height="6" rx="1.5"/><rect x="1" y="9" width="6" height="6" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx="1.5"/></svg>
			</button>
			<button type="button" class="pc-view-toggle__btn" data-pc-view="list" aria-pressed="false" title="Dạng danh sách">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="1" y="2" width="3" height="3" rx="1"/><rect x="6" y="2.5" width="9" height="2" rx="1"/><rect x="1" y="6.5" width="3" height="3" rx="1"/><rect x="6" y="7" width="9" height="2" rx="1"/><rect x="1" y="11" width="3" height="3" rx="1"/><rect x="6" y="11.5" width="9" height="2" rx="1"/></svg>
			</button>
		</div>
	</div>
	</div>
	<div class="sort-cate-right">
		<h3>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sort-alpha-down" viewBox="0 0 16 16">
				<path fill-rule="evenodd" d="M10.082 5.629 9.664 7H8.598l1.789-5.332h1.234L13.402 7h-1.12l-.419-1.371h-1.781zm1.57-.785L11 2.687h-.047l-.652 2.157h1.351z"/>
				<path d="M12.96 14H9.028v-.691l2.579-3.72v-.054H9.098v-.867h3.785v.691l-2.567 3.72v.054h2.645V14zM4.5 2.5a.5.5 0 0 0-1 0v9.793l-1.146-1.147a.5.5 0 0 0-.708.708l2 1.999.007.007a.497.497 0 0 0 .7-.006l2-2a.5.5 0 0 0-.707-.708L4.5 12.293V2.5z"/>
			</svg> Sắp xếp</h3>
		<ul>
			<li class="btn-quick-sort" data-sort="default">
				<a href="javascript:;" onclick="sortby('default')" title="Mặc định"><i></i>Mặc định</a>
			</li>
			<li class="btn-quick-sort" data-sort="alpha-asc">
				<a href="javascript:;" onclick="sortby('alpha-asc')" title="Tên A-Z"><i></i>Tên A-Z</a>
			</li>
			<li class="btn-quick-sort" data-sort="alpha-desc">
				<a href="javascript:;" onclick="sortby('alpha-desc')" title="Tên Z-A"><i></i>Tên Z-A</a>
			</li>
			<li class="btn-quick-sort" data-sort="created-desc">
				<a href="javascript:;" onclick="sortby('created-desc')" title="Hàng mới"><i></i>Hàng mới</a>
			</li>
			<li class="btn-quick-sort" data-sort="price-asc">
				<a href="javascript:;" onclick="sortby('price-asc')" title="Giá thấp đến cao"><i></i>Giá thấp đến cao</a>
			</li>
			<li class="btn-quick-sort" data-sort="price-desc">
				<a href="javascript:;" onclick="sortby('price-desc')" title="Giá cao xuống thấp"><i></i>Giá cao xuống thấp</a>
			</li>
		</ul>
	</div>
	{%if settings.aside_filter_enable%}
	<div class="sudes-filter">
		<a class="btn btn-outline btn-filter btn-filter-mobile" title="Bộ lọc">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-funnel-fill" viewBox="0 0 16 16">
				<path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2z"/>
			</svg>
			Bộ lọc
			<span class="count-filter-val"></span>
		</a>
	</div>
	{%endif%}
</div>

<script>
(function () {
	/* B2: Sync sort active state from URL */
	var _sv = (function () {
		var m = /[?&]sortby=([^&#]*)/.exec(window.location.href);
		return m ? decodeURIComponent(m[1]) : 'default';
	})();
	document.querySelectorAll('.btn-quick-sort[data-sort]').forEach(function (li) {
		li.classList.toggle('active', li.dataset.sort === _sv);
	});
	document.querySelectorAll('.sort-cate-select__input').forEach(function (sel) { sel.value = _sv; });

	/* 2026-10-08: nút lưới/danh sách — trạng thái ở html[data-pc-view], nhớ theo trình duyệt. */
	var root = document.documentElement;
	if (!root.hasAttribute('data-pc-view')) {
		var saved = 'grid';
		try { saved = localStorage.getItem('pc_collection_view') === 'list' ? 'list' : 'grid'; } catch (e) {}
		root.setAttribute('data-pc-view', saved);
	}
	function syncViewButtons() {
		var cur = root.getAttribute('data-pc-view');
		document.querySelectorAll('.pc-view-toggle__btn').forEach(function (b) {
			b.setAttribute('aria-pressed', b.getAttribute('data-pc-view') === cur ? 'true' : 'false');
		});
	}
	syncViewButtons();
	if (!window.__pcViewToggleBound) {
		window.__pcViewToggleBound = true;
		document.addEventListener('click', function (ev) {
			var btn = ev.target.closest && ev.target.closest('.pc-view-toggle__btn');
			if (!btn) return;
			var v = btn.getAttribute('data-pc-view') === 'list' ? 'list' : 'grid';
			root.setAttribute('data-pc-view', v);
			try { localStorage.setItem('pc_collection_view', v); } catch (e) {}
			syncViewButtons();
		});
	}
})();

function countFilterItem() {
	/* Đọc count từ "Bạn chọn" bar mới (B13 refactor) — đếm chips trong #afw-active-chips */
	var n = $('#afw-active-chips .afw-chip').length;
	var $badge = $('.count-filter-val');
	if (n > 0) { $badge.text(n).show(); } else { $badge.text('').hide(); }
}
countFilterItem();
</script>
