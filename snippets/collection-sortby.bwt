{%- comment -%}
  collection-sortby.bwt — hàng công cụ lưới sản phẩm: "Sản phẩm (N)" | ô sắp xếp + nút lưới / danh sách + nút mở bộ lọc (mobile).
  14/11/2026: viết lại 100% class Tailwind (UI-0); bỏ hàng nút sắp xếp nhanh (đã ẩn bằng CSS từ 2026-10-10 — ô chọn là đủ).
  Móc JS (không có CSS): sort-cate-select__input (đồng bộ ?sortby), pc-view-toggle__btn + html[data-pc-view] (lưới / danh sách,
  nhớ theo trình duyệt), btn-filter-mobile (col.js mở ngăn bộ lọc), count-filter-val (số tiêu chí đang lọc), sort-count-num.
  Có hàng "Bộ lọc nhanh" (.pc-quick-filters, đã có nút Bộ lọc riêng) thì ẩn nút Bộ lọc ở đây.
{%- endcomment -%}
{%- assign _result_count = paginate.items | default: collection.products_count | default: search.results_count -%}
{%- comment -%} 2026-10-10: paginate.items = 0 (không phải nil) thì default không thay ⇒ lấy số SP của danh mục. {%- endcomment -%}
{%- if _result_count == 0 and collection.products_count > 0 -%}{%- assign _result_count = collection.products_count -%}{%- endif -%}
<div class="mb-4 flex items-center justify-between gap-3 font-sans">
	{%- if _result_count > 0 -%}
	<p class="m-0 text-base sm:text-lg font-bold text-ink whitespace-nowrap{% if compact %} max-lg:sr-only{% endif %}">{{ settings.collection_products_label | default: 'Sản phẩm' | escape }} (<span class="sort-count-num">{{ _result_count }}</span>)</p>
	{%- endif -%}
	<div class="ml-auto flex min-w-0 items-center justify-end gap-3">
		{%- if settings.aside_filter_enable -%}
		<button type="button" class="btn-filter-mobile relative flex h-[44px] w-[44px] shrink-0 cursor-pointer items-center justify-center rounded-xl border border-solid border-line bg-white p-0 text-ink aria-pressed:border-primary aria-pressed:text-primary min-[992px]:hidden" aria-label="Mở bộ lọc">
			{% include 'ui_icon', name: 'funnel', size: 20, label: '' %}
			<span class="count-filter-val absolute -top-1.5 -right-1.5 hidden h-5 min-w-5 rounded-full bg-sale px-1 text-center text-xs font-bold leading-5 text-white"></span>
		</button>
		{%- endif -%}
		{%- comment -%} 20/11/2026: icon sắp xếp bên trái (mất từ đợt viết lại 14/11) + bỏ đường kẻ dưới — đã gỡ CSS cũ .sort-cate (border-bottom, padding, min-width 220px) khỏi components.css. {%- endcomment -%}
		<div class="sort-cate relative flex items-center border-0 p-0">
			<span class="pointer-events-none absolute left-[12px] flex items-center text-brand-deep" aria-hidden="true">
				{% include 'ui_icon', name: 'arrow-down-up', size: 20, label: '' %}
			</span>
			<select class="sort-cate-select__input min-h-[44px] min-w-[180px] cursor-pointer appearance-none rounded-xl border border-solid border-line bg-white pl-[40px] pr-[36px] text-sm font-semibold text-ink outline-none transition-colors hover:border-primary focus:border-primary [background-image:none] max-sm:min-w-0" aria-label="Sắp xếp">
				<option value="default">Sắp xếp</option>
				<option value="alpha-asc">Tên A-Z</option>
				<option value="alpha-desc">Tên Z-A</option>
				<option value="created-desc">Hàng mới</option>
				<option value="price-asc">Giá thấp đến cao</option>
				<option value="price-desc">Giá cao xuống thấp</option>
			</select>
			<span class="pointer-events-none absolute right-[12px] flex items-center text-ink-secondary" aria-hidden="true">
				{% include 'ui_icon', name: 'chevron-down', size: 20, label: '' %}
			</span>
		</div>
		<div class="flex items-center gap-1" role="group" aria-label="Kiểu hiển thị">
			<button type="button" class="pc-view-toggle__btn max-[991px]:hidden flex h-[44px] w-[44px] cursor-pointer items-center justify-center border border-solid border-line bg-white p-0 text-ink-secondary rounded-xl aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white" data-pc-view="grid" aria-pressed="true" aria-label="Dạng lưới">{% include 'ui_icon', name: 'layout-grid', size: 20, label: '' %}</button>
			<button type="button" class="pc-view-toggle__btn max-[991px]:hidden flex h-[44px] w-[44px] cursor-pointer items-center justify-center border border-solid border-line bg-white p-0 text-ink-secondary rounded-xl aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white" data-pc-view="list" aria-pressed="false" aria-label="Dạng danh sách">{% include 'ui_icon', name: 'list', size: 20, label: '' %}</button>
		</div>
	</div>
</div>

<script>
(function () {
	/* Đồng bộ ô sắp xếp theo ?sortby trên URL */
	var _sv = (function () {
		var m = /[?&]sortby=([^&#]*)/.exec(window.location.href);
		return m ? decodeURIComponent(m[1]) : 'default';
	})();
	document.querySelectorAll('.sort-cate-select__input').forEach(function (sel) {
		sel.value = _sv;
		sel.addEventListener('change', function () { if (typeof sortby === 'function') sortby(sel.value); });
	});

	/* 2026-10-08: nút lưới/danh sách — trạng thái ở html[data-pc-view], nhớ theo trình duyệt. */
	var root = document.documentElement;
	if (!root.hasAttribute('data-pc-view')) {
		var saved = 'grid';
		try { saved = localStorage.getItem('pc_collection_view') === 'list' ? 'list' : 'grid'; } catch (e) {}
		root.setAttribute('data-pc-view', saved);
	}
	function syncViewButtons() {
		var cur = root.getAttribute('data-pc-view');
		document.querySelectorAll('.pc-view-toggle__btn').forEach(function (b) {
			b.setAttribute('aria-pressed', b.getAttribute('data-pc-view') === cur ? 'true' : 'false');
		});
	}
	syncViewButtons();
	if (!window.__pcViewToggleBound) {
		window.__pcViewToggleBound = true;
		document.addEventListener('click', function (ev) {
			var btn = ev.target.closest && ev.target.closest('.pc-view-toggle__btn');
			if (!btn) return;
			var v = btn.getAttribute('data-pc-view') === 'list' ? 'list' : 'grid';
			root.setAttribute('data-pc-view', v);
			try { localStorage.setItem('pc_collection_view', v); } catch (e) {}
			syncViewButtons();
		});
	}
})();

function countFilterItem() {
	/* Đếm chip trong thanh "Đang lọc" (#afw-active-chips) */
	var n = $('#afw-active-chips .afw-chip').length;
	var $badge = $('.count-filter-val');
	var $btn = $('.btn-filter-mobile');
	if (n > 0) {
		$badge.text(n).removeClass('hidden');
		$btn.attr('aria-pressed', 'true');
	} else {
		$badge.text('').addClass('hidden');
		$btn.attr('aria-pressed', 'false');
	}
}
countFilterItem();
</script>
