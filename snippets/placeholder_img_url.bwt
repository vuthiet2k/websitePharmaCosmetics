{%- comment -%}
  Trả về URL ảnh dự phòng (thay cho 'no-image.jpg' | asset_url — 2026-10-03, build:sapo cấm ảnh
  bitmap nội dung trong assets/). Ưu tiên ảnh admin upload ở settings.placeholder_image; để trống
  thì dùng khung SVG inline (không dấu nháy, an toàn trong cả thuộc tính HTML lẫn chuỗi JS).
{%- endcomment -%}
{%- if settings.placeholder_image != blank -%}{{ settings.placeholder_image | img_url: 'large' }}{%- else -%}data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27400%27%20height=%27300%27%20viewBox=%270%200%204%203%27%3E%3Crect%20width=%274%27%20height=%273%27%20fill=%27%23eef1ef%27/%3E%3C/svg%3E{%- endif -%}
