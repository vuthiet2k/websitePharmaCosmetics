{%- comment -%}19/09/2026: giữ reveal và giỏ dịch vụ khi bỏ layout riêng; header/menu dùng theme.bwt.{%- endcomment -%}
{%- assign sh_book_page = pages[settings.skinhealthy_booking_page] -%}
{%- comment -%} 22/11/2026 (chủ dự án: «sai hẳn thiết kế, màu button»): thanh giỏ dịch vụ làm lại 100% Tailwind theo token — nền trắng + viền trên (cùng ngôn ngữ thanh menu đáy), số lượng = chấm màu thương hiệu, nút Đặt lịch = nút chính (bg-btn) bo tròn, nút xoá bo tròn viền nhạt. Bỏ màu nâu «--sh-gold» + chữ hoa giãn chữ. Ẩn/hiện bằng data-open (JS bên dưới). Trên mobile nằm ngay trên thanh menu đáy. {%- endcomment -%}
<div class="fixed inset-x-0 bottom-[calc(56px+env(safe-area-inset-bottom,0px))] z-[120] invisible translate-y-full border-0 border-t border-solid border-line bg-white font-sans text-ink transition-transform duration-300 data-[open=true]:visible data-[open=true]:translate-y-0 min-[992px]:bottom-0" id="sh-cart-bar" role="complementary" aria-label="{{ settings.skinhealthy_cart_aria | default: 'Dịch vụ đã chọn' | escape }}">
  <div class="container flex items-center gap-3 py-3">
    <span class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded-full bg-primary px-2 text-xs font-bold text-white" data-sh-cart-count aria-live="polite">0</span>
    <span class="min-w-0 flex-1 text-sm font-semibold">{{ settings.skinhealthy_cart_label | default: 'dịch vụ đã chọn' }}</span>
    <span class="max-md:sr-only whitespace-nowrap text-sm font-bold text-primary-deep" data-sh-cart-deposit></span>
    <a href="{{ sh_book_page.url | default: pages['dat-lich-tu-van'].url | default: '/dat-lich-tu-van' }}" class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-2 rounded-full bg-btn px-5 text-sm font-bold text-btn-text no-underline hover:bg-btn-hover" data-sh-cart-cta>
      {{ settings.skinhealthy_cart_cta | default: 'Đặt lịch ngay' }}
      <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'arrow-right', size: 16 %}</i>
    </a>
    <button type="button" class="inline-flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-full border border-solid border-line-control bg-white p-0 text-ink-secondary" id="sh-cart-clear" aria-label="{{ settings.skinhealthy_cart_clear | default: 'Xóa tất cả dịch vụ đã chọn' | escape }}">
      <i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'x', size: 18 %}</i>
    </button>
  </div>
</div>
<script>
(function () {
  /* Scroll reveal */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -48px 0px' });
    document.querySelectorAll('.sh-reveal').forEach(function (el) { io.observe(el); });
  } else {
    document.querySelectorAll('.sh-reveal').forEach(function (el) { el.classList.add('is-visible'); });
  }

  /* ── SHCart — global service basket ───────────────────────── */
  {%- comment -%}
    skinhealthy_booking_page (setting "Trang đặt lịch / MOPS") tồn tại trong schema
    từ trước nhưng chưa nơi nào đọc — trỏ cứng "dat-lich-tu-van" (trang cũ, không
    còn dùng trong luồng MOPS hiện tại). Ưu tiên setting nếu owner đã chọn trang thật.
  {%- endcomment -%}
  {%- assign sh_book_page = pages[settings.skinhealthy_booking_page] -%}
  window.SHCart = (function () {
    var KEY       = 'sh_svc_cart';
    var BOOK_BASE = {{ sh_book_page.url | default: pages['dat-lich-tu-van'].url | default: '/dat-lich-tu-van' | json }};
    var bar, countEl, depositEl, ctaEl;

    function load() {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; }
    }

    function save(items) {
      try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {}
      render(items);
      document.dispatchEvent(new CustomEvent('shCartChange', { detail: { items: items } }));
    }

    function has(svc_id) {
      return load().some(function (i) { return i.svc_id === svc_id; });
    }

    function add(svc) {
      var items = load();
      if (!items.some(function (i) { return i.svc_id === svc.svc_id; })) {
        items.push(svc);
        save(items);
      }
    }

    function remove(svc_id) {
      save(load().filter(function (i) { return i.svc_id !== svc_id; }));
    }

    function clear() { save([]); }

    function render(items) {
      items = items || load();
      bar       = bar       || document.getElementById('sh-cart-bar');
      if (!bar) return;

      if (!items.length) { bar.removeAttribute('data-open'); return; }
      bar.setAttribute('data-open', 'true');

      countEl   = countEl   || bar.querySelector('[data-sh-cart-count]');
      depositEl = depositEl || bar.querySelector('[data-sh-cart-deposit]');
      ctaEl     = ctaEl     || bar.querySelector('[data-sh-cart-cta]');

      if (countEl) { countEl.textContent = items.length; }

      var total = items.reduce(function (s, i) { return s + (Number(i.deposit) || 0); }, 0);
      if (depositEl) {
        depositEl.textContent = total > 0
          ? {{ settings.skinhealthy_cart_deposit | default: 'Cọc' | json }} + ' ' + total.toLocaleString('vi-VN') + ' ₫'
          : {{ settings.skinhealthy_cart_free | default: 'Miễn phí' | json }};
      }

      if (ctaEl) {
        var params = items.map(function (i) {
          return 'svc=' + encodeURIComponent(i.svc_id);
        }).join('&');
        ctaEl.href = BOOK_BASE + '?' + params;
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      render();
      var clearBtn = document.getElementById('sh-cart-clear');
      if (clearBtn) { clearBtn.addEventListener('click', function () { clear(); }); }
    });

    return { add: add, remove: remove, clear: clear, has: has, load: load, render: render };
  }());
})();
</script>
