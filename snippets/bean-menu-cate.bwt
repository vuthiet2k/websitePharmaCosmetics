{%- comment -%} 2026-10-07: bỏ icon cate-icon-N.png + cate-icon.png — nhóm "Icon Danh mục sản phẩm" đã xoá khỏi cấu hình theo yêu cầu (sheet cấu hình). {%- endcomment -%}
{%- if linklists[settings.header_nav_cate].links.size > 0 -%}
{%- comment -%} N25 (31/10/2026, chủ dự án duyệt phương án (a)): icon trong template dùng ui_icon sprite 'use' — khai báo symbol 1 lần ở đây, NGOÀI div bên dưới
  (main.js / shim header thay innerHTML của div bằng template ⇒ đặt trong div sẽ mất). Trước: 252 SVG nội tuyến ≈ 235 KB HTML mỗi trang.
  Cùng việc: thẻ Liquid đứng riêng dòng dùng dấu gạch cắt khoảng trắng (bỏ dòng trống + thụt lề giữa các <li> — template lặp ~290 lần) và bỏ aria-hidden thừa trên <i>
  bọc icon layers (span cha đã aria-hidden). {%- endcomment -%}
{% include 'ui_icon', sprite: 'defs', name: 'menu,layers' %}
<div id="header-category-menu" class="sudes-list-cate" data-section="header_nav_cate">
	{%- comment -%} 04/11/2026: header_nav_lazy (mặc định bật) ⇒ để trống, script dưới tải /search?view=navcate rồi điền vào đây
	  (main.js / shim header đọc .html() của thẻ này như cũ). Tắt ⇒ nhúng sẵn như trước. {%- endcomment -%}
	{%- assign pc_nav_lazy = true -%}{%- if settings.header_nav_lazy == false or settings.header_nav_lazy == 'false' -%}{%- assign pc_nav_lazy = false -%}{%- endif -%}
	<script type="text/x-custom-template" data-template="header_nav_cate"{% if pc_nav_lazy %} data-pc-nav-src="/search?view=navcate"{% endif %}>
		{%- if pc_nav_lazy -%}<p class="pc-navcate-wait" role="status">{{ settings.header_nav_loading_text | default: 'Đang tải danh mục…' | escape }}</p>{%- else -%}{% include 'nav_cate_list' %}{%- endif -%}
	</script>
</div>
{%- if pc_nav_lazy -%}
<script>
/* 04/11/2026: tải cây Danh mục SAU khi trang hiện (không dựng ở server mỗi trang). Kích hoạt: ngay khi HTML dựng xong,
   hoặc sớm hơn nếu khách chạm/rê/focus nút Danh mục (.js-menu-toggle) hay ☰ (#btn-menu-mobile). Lưu sessionStorage 30 phút ⇒ trang sau
   có ngay. Đã tải xong mà menu đang mở + khung trống (bấm trước khi tải xong) ⇒ điền luôn. Lỗi mạng ⇒ thử lại lần bấm sau. */
(function () {
  var tpl = document.querySelector('script[data-template="header_nav_cate"][data-pc-nav-src]');
  if (!tpl) return;
  var KEY = 'pcNavCate:' + tpl.getAttribute('data-pc-nav-src'), TTL = 30 * 60 * 1000, busy = false, done = false;
  function fill(html) {
    tpl.innerHTML = html; done = true;
    var box = document.querySelector('div[data-section="header_nav_cate"]');
    var open = document.querySelector('.sudes-list-cate.active, .header-menu.current');
    if (box && open && !box.querySelector('.sudes-main-cate')) {
      box.innerHTML = html; if (window.awe_lazyloadImage) try { window.awe_lazyloadImage(); } catch (e) {}
      /* desktop: main.js chọn sẵn nhóm đầu có lưới con lúc bấm Danh mục — menu điền muộn ⇒ làm lại ở đây */
      if (window.matchMedia('(min-width: 992px)').matches && !box.querySelector('.sudes-main-cate > li.sudes-main-cate-has-child.active')) {
        var g = [].filter.call(box.querySelectorAll('.sudes-main-cate > li.sudes-main-cate-has-child'), function (li) { return li.querySelector(':scope > .sudes-sub-mega-menu'); })[0];
        if (g) g.classList.add('active');
      }
    }
  }
  /* Menu điền SAU khi main.js đã gắn handler trực tiếp (lúc bấm ☰) ⇒ phần tử mới chưa có handler. Uỷ quyền ở document: phần tử
     đã có handler cũ thì handler đó `return false` (chặn lan) nên đoạn này không chạy trùng. Hành vi y main.js (mobile < 992px). */
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented || window.matchMedia('(min-width: 992px)').matches || !e.target.closest) return; /* handler cũ đã xử lý */
    var a = e.target.closest('.sudes-main-cate li > a[href="javascript:void(0)"]');
    var t = e.target.closest('.sudes-main-cate li > .open_mnu') || (a && a.parentNode.querySelector(':scope > .open_mnu'));
    if (!t) return;
    e.preventDefault();
    var li = t.closest('li'), sub = li.querySelector(':scope > .menu-child');
    li.classList.toggle('current'); t.classList.toggle('current');
    if (sub) { sub.classList.toggle('current'); sub.style.display = sub.classList.contains('current') ? 'block' : 'none'; }
  });
  try { var c = JSON.parse(sessionStorage.getItem(KEY) || 'null'); if (c && Date.now() - c.t < TTL && c.h) fill(c.h); } catch (e) {}
  function load() {
    if (done || busy) return; busy = true;
    fetch(tpl.getAttribute('data-pc-nav-src'), { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.text() : ''; })
      .then(function (h) { busy = false; h = (h || '').trim(); if (h.indexOf('sudes-main-cate') < 0) return;
        fill(h); try { sessionStorage.setItem(KEY, JSON.stringify({ t: Date.now(), h: h })); } catch (e) {} })
      .catch(function () { busy = false; });
  }
  ['pointerenter', 'pointerdown', 'focusin', 'touchstart'].forEach(function (ev) {
    document.addEventListener(ev, function (e) { if (e.target.closest && e.target.closest('.js-menu-toggle, #btn-menu-mobile, .header-menu')) load(); }, { passive: true, capture: true });
  });
  /* Bắt đầu tải NGAY khi HTML dựng xong (chạy nền, không chặn hiển thị) ⇒ thường đã về trước khi khách kịp mở menu
     (luồng L01 ui-verify: mở ☰ ~0,8 s sau load phải thấy cây danh mục). */
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load); else load();
})();
</script>
{%- endif -%}
{%- endif -%}
