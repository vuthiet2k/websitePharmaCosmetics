{%- comment -%}
  snippets/search_empty_state.bwt — trạng thái tìm kiếm không có kết quả. M-31 (18/11/2026): gọn kiểu Shopee, 100% Tailwind (bỏ pc-search-empty*):
  1 dòng thông báo (icon nhỏ + chữ, h1), 1 hàng chip từ khoá gợi ý trượt ngang (Swiper, lấy từ settings.footer_search_menu), rồi "Sản phẩm được chọn mua nhiều"
  (ui_product_card) trong Swiper ngang; "Xem tất cả" theo M-11 (ui_section_head). Bỏ khối vấn đề da dạng lưới, ô nhập lại và khối CTA chuyên gia dài.
  Tham số: gọi kèm `assign empty_type = 'product'` hoặc 'article' trước khi include.
{%- endcomment -%}
{%- assign _es_type = empty_type | default: 'product' -%}
{%- assign _es_kw = settings.footer_search_menu | default: 'Phục hồi da;Trị mụn;Trị nám;Trẻ hoá da;Kem chống nắng' | split: ';' -%}
{%- assign _es_col = collections['san-pham-ban-chay-noi-bat'] -%}
{%- if _es_col.products.size == 0 -%}{%- assign _es_col = collections['all'] -%}{%- endif -%}
<div class="font-sans text-ink">
	{%- if _es_type != 'none' -%}
	<h1 class="m-0 flex items-center gap-2 py-3 text-sm font-semibold text-ink-secondary">
		<span class="shrink-0 text-ink-muted" aria-hidden="true">{% include 'ui_icon', name: 'frown', size: 20 %}</span>
		<span class="min-w-0">Không tìm thấy {% if _es_type == 'article' %}bài viết{% else %}sản phẩm{% endif %} cho “{{ search.terms | strip_html | escape }}”</span>
	</h1>
	{%- endif -%}

	{%- if _es_kw.size > 0 -%}
	<div class="swiper-container mb-4 overflow-hidden" data-pc-slider data-gap="8">
		<div class="swiper-wrapper">
			{%- for _k in _es_kw -%}
			{%- assign _kw = _k | strip -%}
			{%- if _kw != '' -%}
			<a class="swiper-slide inline-flex min-h-[44px] !w-auto items-center whitespace-nowrap rounded-full border border-solid border-line-soft bg-surface-soft px-4 text-sm text-ink no-underline hover:bg-brand-tint" href="/search?query={{ _kw | url_encode }}&amp;type={% if _es_type == 'article' %}article{% else %}product{% endif %}" title="Tìm {{ _kw | escape }}">{{ _kw }}</a>
			{%- endif -%}
			{%- endfor -%}
		</div>
	</div>
	{%- endif -%}

	{%- if _es_col.products.size > 0 -%}
	<section class="pb-4" aria-labelledby="search-empty-popular">
		{%- include 'ui_section_head', title: 'Sản phẩm được chọn mua nhiều', title_id: 'search-empty-popular', url: '/collections/all', label: 'Xem tất cả sản phẩm', title_class: 'text-base font-bold text-brand-deep', wrap_class: 'mb-2' -%}
		<div class="swiper-container overflow-hidden" data-pc-slider data-gap="12">
			<div class="swiper-wrapper">
				{%- for product in _es_col.products limit: 8 -%}
				<div class="swiper-slide !h-auto !w-44">
					{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}
				</div>
				{%- endfor -%}
			</div>
		</div>
	</section>
	{%- endif -%}
</div>
{%- include 'pc_swiper_boot' -%}
