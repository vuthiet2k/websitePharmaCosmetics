{% assign combine_pretext = false %}
{% assign description = collection.description %}
{% if description contains "<h5>" %}
{% assign tab_heads = '' %}
{% assign tab_texts = '' %}
{% assign pretext = '' %}
{% assign chunks = description | strip | split: "<h5>" %}
{% for c in chunks %}
{% if c contains "</h5>" %}
{% assign chunk = c | split: "</h5>" %}
{% assign tab_heads = tab_heads | append: ",," | append: chunk.first %}
{% assign tab_texts = tab_texts | append: ",," %}
{% if pretext != blank  and combine_pretext %}
{% assign tab_texts = tab_texts | append: pretext | append: "<br>" %}
{% assign pretext = '' %}
{% endif %}
{% assign tab_texts = tab_texts | append: chunk.last  %}
{% elsif forloop.first %}
{% assign pretext =  c %}
{% endif %}
{% endfor %}
{% assign tab_heads = tab_heads | remove_first: ",," | split: ",," %}
{% assign tab_texts = tab_texts | remove_first: ",," | split: ",," %}
{% assign index =  1  %}
{% for head in tab_heads%}
<aside class="aside-item filter-tag-style-{{index}} tag-filtster">
	<div class="aside-title">
		<h2 class="title-head margin-top-0"><span>{{ head }}</span></h2>
	</div>
	<div class="aside-content filter-group">
		<ul>
			{% assign tags = tab_texts[forloop.index0] |strip_html | split: ',' %} 
			{% for t in tags %}
			{% assign tag = t | strip %}
			{% assign tag_value = tag | handleize %}
			{% if tag != '' %}
			<li class="filter-item filter-item--check-box filter-item--green">
				<span>
					<label for="filter-{{ tag | handleize }}">
						<input type="checkbox" id="filter-{{ tag | handleize }}" data-group="tag2{{- index -}}" data-field="tags" data-text="{{ tag }}" value="({{ tag }})" data-operator="OR">
						<i class="fa"></i>
						{{tag}}
					</label>
				</span>
			</li>	
			{% endif %}
			{%endfor%}

		</ul>
	</div>
</aside>
{% assign index =  index | plus: 1  %}
{% endfor %}
{% endif %}