{%- comment -%}
  section_ingredients.bwt — Tìm theo hoạt chất.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- assign ing_icon = settings.home_ing_icon | default: 'flask-conical' -%}
{%- assign ing_ll = linklists[settings.home_ing_menu] -%}
{%- capture pc_ing_items -%}
{%- if settings.home_ing_menu != blank and ing_ll.links.size > 0 -%}
  {%- for link in ing_ll.links limit: 16 -%}
    {%- assign ing_img = link.object.image.src | default: link.object.featured_image.src -%}
    <a class="box-border flex min-h-[90px] flex-col justify-between rounded-xl border border-solid border-line-soft bg-white p-3 md:p-4 text-center hover:border-primary no-underline transition-all" href="{{ link.url | escape }}">
      <span class="m-0 block text-xs md:text-sm font-bold text-brand-deep leading-snug line-clamp-2">{{ link.title | escape }}</span>
      {%- if link.object.products_count > 0 -%}
        <span class="m-0 mt-2 block text-xs font-semibold text-primary">{{ link.object.products_count }} SP</span>
      {%- endif -%}
    </a>
  {%- endfor -%}
{%- endif -%}
{%- endcapture -%}
<section class="bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-ing-title">
  <div class="container">
    <div class="mb-6 lg:mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-wider text-primary hidden lg:block">{{ settings.home_ing_eyebrow | default: 'Thấu hiểu làn da bằng khoa học' | escape }}</p>
        <h2 class="m-0 text-2xl lg:text-3xl font-bold text-brand-deep mt-1" id="section-ing-title">{{ settings.home_ing_title | default: 'Tìm theo hoạt chất' | escape }}</h2>
        {%- if settings.home_ing_subtitle != blank -%}<p class="m-0 mt-2 text-sm text-ink-muted">{{ settings.home_ing_subtitle | escape }}</p>{%- endif -%}
      </div>
      {%- if ing_ll.links.size > 0 -%}<p class="m-0 text-xs font-semibold text-primary lg:hidden">{{ ing_ll.links.size }} {{ settings.home_ing_count_label | default: 'hoạt chất' | escape }}</p>{%- endif -%}
    </div>
    {%- if pc_ing_items != blank -%}
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">{{ pc_ing_items }}</div>
    {%- endif -%}
  </div>
</section>
