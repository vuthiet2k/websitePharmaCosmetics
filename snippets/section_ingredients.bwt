{%- comment -%}
  section_ingredients.bwt — Tìm theo hoạt chất.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- comment -%} M-01 (17/11/2026): mobile = ảnh tròn 56px + tên + số SP, 2 hàng Swiper (ui_circle_swiper); desktop giữ lưới 8 cột. Ảnh/số SP đọc từ object collection của link menu. {%- endcomment -%}
{%- assign ing_ll = linklists[settings.home_ing_menu] -%}
{%- assign ing_title_t = settings.home_ing_title | default: 'Tìm theo hoạt chất' | escape -%}
{%- assign ing_eyebrow_t = settings.home_ing_eyebrow | default: 'Thấu hiểu làn da bằng khoa học' | escape -%}
{%- assign ing_sub_t = settings.home_ing_subtitle | escape -%}
{%- capture ing_badge_t -%}{{ ing_ll.links.size }} {{ settings.home_ing_count_label | default: 'hoạt chất' | escape }}{%- endcapture -%}
<section class="bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-ing-title">
  <div class="container">
    {%- if ing_ll.links.size > 0 -%}
    {%- include 'ui_section_head', title: ing_title_t, title_id: 'section-ing-title', eyebrow: ing_eyebrow_t, desc: ing_sub_t, badge: ing_badge_t, badge_class: 'lg:hidden', wrap_class: 'mb-4 lg:mb-8' -%}
    {%- include 'ui_circle_swiper', links: ing_ll.links, limit: 16, kind: 'ingredient', cols: 'lg:grid-cols-8' -%}
    {%- else -%}
    {%- include 'ui_section_head', title: ing_title_t, title_id: 'section-ing-title', eyebrow: ing_eyebrow_t, desc: ing_sub_t -%}
    {%- endif -%}
  </div>
</section>
