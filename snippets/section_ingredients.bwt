<section class="portal-actives"><div class="wrap">
  <div class="section-head"><div><p class="eyebrow">{{ settings.home_ing_eyebrow | default: 'Thấu hiểu làn da bằng khoa học' | escape }}</p><h2>{{ settings.home_ing_title | default: 'Tìm theo hoạt chất' | escape }}</h2></div><p class="lead">{{ settings.home_ing_subtitle | escape }}</p></div>
  <div class="actives">
    {% assign ing_ll = linklists[settings.home_ing_menu] %}
    {% if ing_ll.links.size > 0 %}
      {% for link in ing_ll.links %}<a class="active" href="{{ link.url | escape }}">{{ link.title | escape }}{% if link.object.products_count > 0 %}<small>{{ link.object.products_count }} sản phẩm</small>{% endif %}</a>{% endfor %}
    {% else %}
      {% for i in (1..9) %}
        {% capture title %}ing_{{ i }}_title{% endcapture %}{% capture url %}ing_{{ i }}_url{% endcapture %}{% capture tag %}ing_{{ i }}_tag{% endcapture %}
        {% assign ingredient_name = settings[title] %}
        {% if i == 1 %}{% assign ingredient_name = ingredient_name | default: 'Retinol' %}{% elsif i == 2 %}{% assign ingredient_name = ingredient_name | default: 'Hyaluronic Acid' %}{% elsif i == 3 %}{% assign ingredient_name = ingredient_name | default: 'Ceramides' %}{% endif %}
        {% if ingredient_name != blank %}{% capture fallback_url %}/search?query={{ ingredient_name | url_encode }}&type=product{% endcapture %}<a class="active" href="{{ settings[url] | default: fallback_url | escape }}">{{ ingredient_name | escape }}<small>{{ settings[tag] | escape }}</small></a>{% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div></section>
