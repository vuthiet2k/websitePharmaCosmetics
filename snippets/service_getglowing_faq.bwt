{%- comment -%}
  snippets/service_getglowing_faq.bwt — Module 07: Câu hỏi thường gặp & FAQPage Schema
  Dự án: Pharma Cosmetics — Skin Health Beauty (Hà Nội).
  Đảm bảo: 4 câu hỏi FAQ chuẩn y khoa, accordion mượt mà, cấu trúc JSON-LD SEO FAQPage.
{%- endcomment -%}

<section id="service-faq-section" class="pc-peel-faq py-16 bg-slate-50 border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-emerald-700 text-xs font-bold uppercase tracking-wider bg-emerald-100/60 px-3 py-1 rounded-full border border-emerald-200">
        Hỏi đáp y khoa
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-heading mt-3">
        Câu hỏi thường gặp
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Giải đáp chi tiết các thắc mắc phổ biến về liệu trình GetGlowing Micro-Peel.
      </p>
    </div>

    {%- comment -%} Danh sách Accordion {%- endcomment -%}
    <div class="space-y-4" id="peel-faq-accordion">
      
      {%- comment -%} FAQ 1 {%- endcomment -%}
      <div class="pc-peel-faq-item rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm transition-all duration-200">
        <button type="button" class="w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-900 text-base font-heading focus:outline-none" aria-expanded="false">
          <span>GetGlowing có gây bong da không?</span>
          <i class="fas fa-chevron-down text-emerald-600 text-xs transition-transform duration-300" aria-hidden="true"></i>
        </button>
        <div class="pc-peel-faq-content hidden px-6 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
          Có thể bong da trong những ngày sau trị liệu; mức độ tùy thuộc vào nền sừng, tốc độ tái tạo và đáp ứng sinh học tự nhiên của từng cá nhân. Chuyên gia sẽ hướng dẫn chi tiết cách dưỡng ẩm phục hồi và bảo vệ da trong suốt giai đoạn này.
        </div>
      </div>

      {%- comment -%} FAQ 2 {%- endcomment -%}
      <div class="pc-peel-faq-item rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm transition-all duration-200">
        <button type="button" class="w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-900 text-base font-heading focus:outline-none" aria-expanded="false">
          <span>Cần bao nhiêu buổi trị liệu?</span>
          <i class="fas fa-chevron-down text-emerald-600 text-xs transition-transform duration-300" aria-hidden="true"></i>
        </button>
        <div class="pc-peel-faq-content hidden px-6 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
          Số buổi phụ thuộc vào tình trạng nền da, mức độ nghiêm trọng của vấn đề và mục tiêu cải thiện cụ thể. Kế hoạch buổi peel thực tế sẽ do chuyên gia đánh giá và chỉ định trực tiếp trước từng buổi thăm khám.
        </div>
      </div>

      {%- comment -%} FAQ 3 {%- endcomment -%}
      <div class="pc-peel-faq-item rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm transition-all duration-200">
        <button type="button" class="w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-900 text-base font-heading focus:outline-none" aria-expanded="false">
          <span>Da nhạy cảm có thực hiện được không?</span>
          <i class="fas fa-chevron-down text-emerald-600 text-xs transition-transform duration-300" aria-hidden="true"></i>
        </button>
        <div class="pc-peel-faq-content hidden px-6 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
          Nền da nhạy cảm cần được chuyên gia đánh giá và lập hồ sơ lâm sàng riêng biệt. Nếu da đang kích ứng, tổn thương hoặc hàng rào bảo vệ suy yếu, chuyên gia sẽ thiết lập phác đồ phục hồi trước khi chỉ định liệu trình peel.
        </div>
      </div>

      {%- comment -%} FAQ 4 {%- endcomment -%}
      <div class="pc-peel-faq-item rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm transition-all duration-200">
        <button type="button" class="w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-900 text-base font-heading focus:outline-none" aria-expanded="false">
          <span>Sau peel cần chăm sóc như thế nào?</span>
          <i class="fas fa-chevron-down text-emerald-600 text-xs transition-transform duration-300" aria-hidden="true"></i>
        </button>
        <div class="pc-peel-faq-content hidden px-6 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
          Khách hàng cần tuân thủ 4 nguyên tắc vàng: làm sạch dịu nhẹ, dưỡng ẩm phục hồi tích cực, chống nắng che chắn UV nghiêm ngặt và tuyệt đối không tự bóc vảy da đang bong. Chỉ sử dụng lại các hoạt chất treatment khi chuyên gia cho phép.
        </div>
      </div>

    </div>
  </div>
</section>

{%- comment -%} JSON-LD FAQPage Schema chuẩn SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "GetGlowing có gây bong da không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Có thể bong da trong những ngày sau trị liệu; mức độ tùy thuộc vào nền sừng, tốc độ tái tạo và đáp ứng sinh học tự nhiên của từng cá nhân."
      }
    },
    {
      "@type": "Question",
      "name": "Cần bao nhiêu buổi trị liệu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Số buổi phụ thuộc vào tình trạng nền da, mức độ nghiêm trọng của vấn đề và mục tiêu cải thiện cụ thể; do chuyên gia chỉ định."
      }
    },
    {
      "@type": "Question",
      "name": "Da nhạy cảm có thực hiện được không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nền da nhạy cảm cần được chuyên gia đánh giá và lập hồ sơ lâm sàng riêng biệt trước khi chỉ định peel."
      }
    },
    {
      "@type": "Question",
      "name": "Sau peel cần chăm sóc như thế nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Làm sạch dịu nhẹ, dưỡng ẩm phục hồi tích cực, chống nắng nghiêm ngặt và tuyệt đối không tự bóc da đang bong."
      }
    }
  ]
}
</script>
