{%- comment -%}
  service_getglowing_faq — 7. Câu hỏi thường gặp: tối đa 6 câu (settings gg_faq_N_q/_a), câu trống tự ẩn.
  Dùng <details>/<summary> (mở/đóng không cần JS, đọc được khi chưa chạy script) + JSON-LD FAQPage cho SEO.
{%- endcomment -%}
{%- assign gg_faq_n = 0 -%}
{%- for i in (1..6) -%}{%- assign kq = 'gg_faq_' | append: i | append: '_q' -%}{%- assign ka = 'gg_faq_' | append: i | append: '_a' -%}{%- if settings[kq] != blank and settings[ka] != blank -%}{%- assign gg_faq_n = gg_faq_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if gg_faq_n > 0 -%}
<section id="service-faq-section" class="gg-section gg-section--soft">
  <div class="container">
    <header class="gg-head"><h2 class="gg-title">{{ settings.gg_faq_title | default: 'Câu hỏi thường gặp' | escape }}</h2></header>
    <div class="gg-faq" id="peel-faq-accordion">
      {%- for i in (1..6) -%}
      {%- assign kq = 'gg_faq_' | append: i | append: '_q' -%}{%- assign ka = 'gg_faq_' | append: i | append: '_a' -%}
      {%- if settings[kq] != blank and settings[ka] != blank -%}
      <details class="gg-faq__item"{% if forloop.first %} open{% endif %}>
        <summary>{{ settings[kq] | escape }}<i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
        <p>{{ settings[ka] | escape }}</p>
      </details>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- assign gg_first = true -%}{%- for i in (1..6) -%}{%- assign kq = 'gg_faq_' | append: i | append: '_q' -%}{%- assign ka = 'gg_faq_' | append: i | append: '_a' -%}{%- if settings[kq] != blank and settings[ka] != blank -%}{%- unless gg_first -%},{%- endunless -%}{"@type":"Question","name":{{ settings[kq] | json }},"acceptedAnswer":{"@type":"Answer","text":{{ settings[ka] | json }}}}{%- assign gg_first = false -%}{%- endif -%}{%- endfor -%}]}
</script>
{%- endif -%}
