<div class="mega-content dropdown-menu">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="mega-menu-list col-lg-12">
				<ul class="level0">
					{% for l in linklists[link.alias].links %}
					{% if linklists[l.alias] != null %}
					<li class="level1 parent item fix-navs nav-item-lv2 has-childs2">
						<a class="hmega" href="{{ l.url }}" title="{{ l.title }}">{{ l.title }}</a>
						<i class="open_mnu down_icon"></i>
						<ul class="level1 dropdown-menu">
							{% for child_l in linklists[l.alias].links %}
							<li class="level2 nav-item-lv3">
								<a href="{{ child_l.url }}" title="{{ child_l.title }}">{{ child_l.title }}</a>
							</li>
							{% endfor %}
						</ul>
					</li>
					{% else %}
					<li class="level1 item nav-item-lv2">
						<a class="hmega nav-link" href="{{ l.url }}" title="{{ l.title }}">{{ l.title }}</a>
					</li>
					{% endif %}
					{% endfor %}
				</ul>	
			</div>
		</div>
	</div>
</div>