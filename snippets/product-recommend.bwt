    <div class="product-recommend-module-title">
    </div>
    <div id="owl-product-recommend" class="">
    </div>
    <script>
        var BizwebProductRecommendApp = BizwebProductRecommendApp || {};
        BizwebProductRecommendApp.productId = "{{ product.id }}";
    </script>
</div>
</div>
