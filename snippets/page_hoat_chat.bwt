{%- comment -%}
  snippets/page_hoat_chat.bwt (20/11/2026) — Khối nội dung hiển thị toàn bộ hoạt chất từ menu Sapo.
  Thiết kế đồng bộ theo chuẩn Mall: Header cam kết, Cột trái banner Khoa học Làn da, Cột phải lưới 2 hàng x 4 cột có phân trang mượt mà.
  QUY ƯỚC: 100% class Tailwind (assets/pc-ui.css) — KHÔNG class CSS tự đặt, không inline style attribute, không thẻ style.
  Dữ liệu lấy động từ menu hoạt chất của Sapo (`settings.all_ing_menu` | default: 'mua-sam-theo-thanh-phan' / 'hoat-chat') và object collection của từng hoạt chất.
{%- endcomment -%}
{%- assign pc_ing_menu_handle = settings.all_ing_menu | default: 'hoat-chat' -%}
{%- assign pc_ing_ll = linklists[pc_ing_menu_handle] -%}
{%- if pc_ing_ll == blank or pc_ing_ll.links.size == 0 -%}
  {%- assign pc_ing_ll = linklists['mua-sam-theo-thanh-phan'] -%}
{%- endif -%}
{%- if pc_ing_ll == blank or pc_ing_ll.links.size == 0 -%}
  {%- assign pc_ing_ll = linklists['thanh-phan-hoat-chat'] -%}
{%- endif -%}
{%- if pc_ing_ll == blank or pc_ing_ll.links.size == 0 -%}
  {%- assign pc_ing_ll = linklists['hoat-chat-trang-chu'] -%}
{%- endif -%}

{%- assign pc_ing_eyebrow = settings.all_ing_eyebrow | default: 'HOẠT CHẤT CHUẨN Y KHOA' -%}
{%- assign pc_ing_title = page.title | default: settings.all_ing_title | default: 'Thư viện Hoạt chất' -%}
{%- assign pc_ing_desc = settings.all_ing_subtitle | default: 'Tra cứu danh mục toàn bộ các hoạt chất vàng trong điều trị và chăm sóc da chuyên sâu tại Pharma Cosmetics.' -%}
{%- assign pc_ing_search_ph = settings.all_ing_search_placeholder | default: 'Tìm kiếm tên hoạt chất (Retinol, BHA, Niacinamide...)...' -%}
{%- assign pc_ing_empty = settings.all_ing_empty_text | default: 'Không tìm thấy hoạt chất phù hợp.' -%}

{% include 'breadcrumb' %}

<main class="bg-surface-page font-sans text-ink" id="main">
  <div class="container py-6 lg:py-8">
    
    {%- comment -%} 1. Thanh tiêu đề & dải cam kết hoạt chất {%- endcomment -%}
    <section class="mb-5 rounded-2xl border border-solid border-line-soft bg-white p-4 lg:p-6 shadow-sm" aria-labelledby="all-ingredients-heading">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-tint px-3 py-1 font-heading text-xs font-bold uppercase tracking-wider text-brand-deep">
              <i class="inline-flex leading-none text-primary" aria-hidden="true">{% include 'ui_icon', name: 'wand-sparkles', size: 'em' %}</i>
              {{ pc_ing_eyebrow | escape }}
            </span>
          </div>
          <div class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h1 class="m-0 font-heading text-2xl font-bold text-brand-deep lg:text-3xl" id="all-ingredients-heading">{{ pc_ing_title | escape }}</h1>
            {%- if pc_ing_ll.links.size > 0 -%}
            <span class="text-sm font-semibold text-ink-muted" data-ing-total>({{ pc_ing_ll.links.size }} hoạt chất)</span>
            {%- endif -%}
          </div>
          {%- if pc_ing_desc != blank -%}
          <p class="m-0 mt-1 max-w-3xl text-xs text-ink-secondary sm:text-sm">{{ pc_ing_desc | escape }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} 2. Ô tìm kiếm hoạt chất tức thời {%- endcomment -%}
        <div class="w-full shrink-0 lg:w-80">
          <label class="sr-only" for="pc-ing-search-input">{{ pc_ing_search_ph | escape }}</label>
          <div class="relative flex items-center">
            <span class="pointer-events-none absolute left-3.5 inline-flex items-center justify-center text-ink-muted" aria-hidden="true">
              {% include 'ui_icon', name: 'search', size: 18 %}
            </span>
            <input
              id="pc-ing-search-input"
              type="search"
              autocomplete="off"
              placeholder="{{ pc_ing_search_ph | escape }}"
              class="box-border h-11 w-full rounded-full border border-solid border-line bg-surface-page !pl-12 !pr-12 text-sm text-ink placeholder-slate-400 focus:border-primary focus:bg-white focus:outline-none transition-colors [&::-webkit-search-cancel-button]:appearance-none [&::-webkit-search-decoration]:appearance-none"
              data-ing-search
            >
            <button
              type="button"
              class="absolute right-0.5 inline-flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-ink-muted hover:bg-brand-tint hover:text-brand-deep transition-colors"
              aria-label="Xóa từ khóa tìm kiếm"
              data-ing-search-clear
              hidden
            >
              {% include 'ui_icon', name: 'x', size: 18 %}
            </button>
          </div>
        </div>
      </div>

      <div class="mt-5 border-0 border-t border-solid border-line-soft pt-4">
        {% include 'ui_trust_badges' %}
      </div>
    </section>

    {%- comment -%} 3. Khu vực chính: Cột trái Banner Khoa học Làn da + Cột phải Lưới 2 hàng x 4 cột có phân trang {%- endcomment -%}
    {%- if pc_ing_ll.links.size > 0 -%}
    <section class="rounded-2xl border border-solid border-line-soft bg-white p-4 lg:p-6 shadow-sm" aria-label="Danh sách hoạt chất điều trị chuyên sâu">
      
      {%- comment -%} Thanh tiêu đề khối Mall {%- endcomment -%}
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-0 border-b border-solid border-line-soft pb-3">
        <div class="flex items-center gap-2">
          <h2 class="m-0 font-heading text-base font-bold uppercase tracking-wide text-brand-deep lg:text-lg">DANH MỤC HOẠT CHẤT VÀNG</h2>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-ink-muted" data-ing-page-indicator>Trang 1</span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-stretch">
        
        {%- comment -%} Cột trái: Banner Khoa học Hoạt chất (chiếm 4/12 cột desktop) {%- endcomment -%}
        <div class="lg:col-span-4 flex flex-col">
          <div class="relative flex flex-1 flex-col justify-between overflow-hidden rounded-2xl bg-gradient-to-br from-brand-deep via-brand-darkest to-primary p-6 text-white shadow-md min-h-[380px] lg:min-h-[480px]">
            <div class="relative z-10">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 font-heading text-xs font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                <i class="inline-flex leading-none text-amber-300" aria-hidden="true">{% include 'ui_icon', name: 'wand-sparkles', size: 'em' %}</i>
                KHOA HỌC LÀN DA
              </span>
              <h3 class="m-0 mt-3 font-heading text-2xl font-black uppercase leading-tight text-white lg:text-3xl">
                CÔNG THỨC<br><span class="text-amber-300">ĐỘT PHÁ</span>
              </h3>
              <p class="m-0 mt-2 font-sans text-sm leading-relaxed text-slate-100">
                Thấu hiểu từng hoạt chất điều trị để xây dựng phác đồ khoa học, an toàn và tối ưu cho từng tình trạng da.
              </p>
            </div>

            <div class="relative z-10 my-4 space-y-2.5">
              <div class="flex items-center gap-2.5 rounded-xl border border-solid border-white/20 bg-white/10 p-2.5 backdrop-blur-sm">
                <span class="flex h-8 w-14 shrink-0 items-center justify-center rounded-lg bg-primary font-heading text-xs font-bold text-white">R&D</span>
                <span class="text-xs font-bold text-white">Nồng độ & pH chuẩn y khoa</span>
              </div>
              <div class="flex items-center gap-2.5 rounded-xl border border-solid border-white/20 bg-white/10 p-2.5 backdrop-blur-sm">
                <span class="flex h-8 w-14 shrink-0 items-center justify-center rounded-lg bg-amber-400 font-heading text-xs font-bold text-brand-darkest">1:1</span>
                <span class="text-xs font-bold text-white">Tư vấn phác đồ cá nhân hóa</span>
              </div>
              <div class="flex items-center gap-2.5 rounded-xl border border-solid border-white/20 bg-white/10 p-2.5 backdrop-blur-sm">
                <span class="flex h-8 w-14 shrink-0 items-center justify-center rounded-lg bg-emerald-400 font-heading text-xs font-bold text-brand-darkest">AN TOÀN</span>
                <span class="text-xs font-bold text-white">Kiểm chứng lâm sàng quốc tế</span>
              </div>
            </div>

            <div class="relative z-10 pt-2">
              <a
                href="/dat-lich-tu-van"
                class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full bg-white px-5 text-sm font-bold text-brand-deep shadow-md transition-all hover:bg-brand-tint hover:shadow-lg no-underline"
              >
                Đặt lịch tư vấn hoạt chất 1:1
              </a>
            </div>
          </div>
        </div>

        {%- comment -%} Cột phải: Lưới 2 hàng x 4 cột kèm mũi tên chuyển trang và thanh phân trang số (chiếm 8/12 cột desktop) {%- endcomment -%}
        <div class="lg:col-span-8 flex flex-col justify-between relative">
          
          <div class="relative flex-1">
            {%- comment -%} Nút mũi tên lật trang Trước (Tròn, nổi mép trái) {%- endcomment -%}
            <button
              type="button"
              data-ing-prev
              class="absolute -left-3.5 top-1/2 -translate-y-1/2 z-20 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-solid border-line-soft bg-white text-ink shadow-lg transition-transform hover:scale-110 disabled:opacity-30 disabled:pointer-events-none"
              aria-label="Trang hoạt chất trước"
            >
              <i class="inline-flex leading-none text-ink" aria-hidden="true">{% include 'ui_icon', name: 'chevron-left', size: 20 %}</i>
            </button>

            {%- comment -%} Lưới hoạt chất hiển thị 8 thẻ / trang (2 hàng x 4 cột desktop, 2 hàng x 2 cột mobile) {%- endcomment -%}
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 h-full" data-ing-grid>
              {%- for link in pc_ing_ll.links -%}
                {%- assign i_col = link.object -%}
                {%- assign i_img = i_col.image.src | default: i_col.featured_image.src -%}
                {%- assign i_title = link.title | strip -%}
                {%- assign i_first = i_title | upcase | slice: 0, 1 -%}
                {%- assign i_count = i_col.products_count | plus: 0 -%}
                
                {%- assign mod_idx = forloop.index | modulo: 4 -%}
                {%- if mod_idx == 1 -%}{%- assign i_tag = 'Tái tạo & Phục hồi' -%}
                {%- elsif mod_idx == 2 -%}{%- assign i_tag = 'Cấp ẩm & Làm dịu' -%}
                {%- elsif mod_idx == 3 -%}{%- assign i_tag = 'Sáng da & Mờ nám' -%}
                {%- else -%}{%- assign i_tag = 'Kiểm soát dầu & Mụn' -%}
                {%- endif -%}

                <a
                  href="{{ link.url | escape }}"
                  title="{{ i_title | escape }}"
                  data-ing-card
                  data-ing-name="{{ i_title | downcase | escape }}"
                  data-ing-char="{{ i_first | escape }}"
                  class="group flex flex-col justify-between items-center overflow-hidden rounded-xl border border-solid border-line-soft bg-white p-3 text-center no-underline transition-all duration-200 hover:border-primary hover:shadow-md"
                >
                  {%- comment -%} Ảnh hoạt chất / sản phẩm đại diện {%- endcomment -%}
                  <div class="relative flex h-24 sm:h-28 w-full items-center justify-center overflow-hidden rounded-lg bg-surface-soft/60 p-2">
                    {%- if i_img != blank -%}
                    <img
                      src="{{ i_img | img_url: 'medium' }}"
                      alt="{{ i_title | escape }}"
                      width="140"
                      height="100"
                      loading="lazy"
                      class="block max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                    >
                    {%- else -%}
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand-tint font-heading text-lg font-bold text-brand-deep">{{ i_first }}</span>
                    {%- endif -%}
                  </div>

                  {%- comment -%} Pill tên hoạt chất {%- endcomment -%}
                  <div class="mt-2.5 w-full flex justify-center">
                    <span class="inline-flex max-w-[95%] items-center justify-center rounded-full border border-solid border-line-soft bg-white px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-deep shadow-sm transition-colors group-hover:border-primary group-hover:bg-brand-tint">
                      <span class="truncate">{{ i_title | escape }}</span>
                    </span>
                  </div>

                  {%- comment -%} Dòng công dụng nổi bật {%- endcomment -%}
                  <div class="mt-2 text-center">
                    <span class="block text-xs font-bold text-primary transition-colors">
                      {{ i_tag }}
                    </span>
                    {%- if i_count > 0 -%}
                    <span class="block text-[11px] font-medium text-ink-muted">{{ i_count }} sản phẩm</span>
                    {%- else -%}
                    <span class="block text-[11px] font-medium text-ink-muted">Khám phá</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endfor -%}
            </div>

            {%- comment -%} Nút mũi tên lật trang Sau (Tròn, nổi mép phải) {%- endcomment -%}
            <button
              type="button"
              data-ing-next
              class="absolute -right-3.5 top-1/2 -translate-y-1/2 z-20 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-solid border-line-soft bg-white text-ink shadow-lg transition-transform hover:scale-110 disabled:opacity-30 disabled:pointer-events-none"
              aria-label="Trang hoạt chất sau"
            >
              <i class="inline-flex leading-none text-ink" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 20 %}</i>
            </button>
          </div>

          {%- comment -%} Thanh phân trang số trang (1, 2, 3...) {%- endcomment -%}
          {%- comment -%} 20/11/2026: dùng chung ui_pagination (chế độ js, UI-4.5) — bỏ thanh nút tròn « Trước / Sau » tự dựng. {%- endcomment -%}
          <div class="mt-5 pt-3 border-0 border-t border-solid border-line-soft" data-ing-pagination-wrap>
            {% include 'ui_pagination', pg_mode: 'js', pg_id: 'ing-pagination', pg_label: 'Phân trang hoạt chất' %}
          </div>

          {%- comment -%} Trạng thái rỗng khi tìm kiếm / lọc không khớp {%- endcomment -%}
          <div class="rounded-2xl border border-solid border-line-soft bg-surface-soft/40 px-4 py-12 text-center" data-ing-empty hidden>
            <p class="m-0 text-base font-semibold text-ink">{{ pc_ing_empty | escape }}</p>
            <button
              type="button"
              class="mt-4 inline-flex min-h-[44px] cursor-pointer items-center justify-center rounded-full border-0 bg-btn px-6 text-sm font-semibold text-btn-text transition-colors hover:bg-btn-hover"
              data-ing-reset
            >Xem tất cả hoạt chất</button>
          </div>

        </div>
      </div>
    </section>
    {%- else -%}
    <section class="rounded-2xl border border-solid border-line-soft bg-white px-4 py-12 text-center">
      <p class="m-0 text-sm text-ink-muted">Danh sách hoạt chất đang được cập nhật.</p>
    </section>
    {%- endif -%}

    {%- if page.content != blank -%}
    <section class="mt-8 rounded-2xl border border-solid border-line-soft bg-white p-4 lg:p-6 shadow-sm">
      <div class="rte text-sm leading-relaxed text-ink-secondary">
        {{ page.content }}
      </div>
    </section>
    {%- endif -%}
  </div>
</main>

<script>
(function () {
  var PAGE_SIZE = 8;
  var currentPage = 1;
  var searchQuery = '';

  var searchInput = document.querySelector('[data-ing-search]');
  var clearBtn = document.querySelector('[data-ing-search-clear]');
  var grid = document.querySelector('[data-ing-grid]');
  var emptyBox = document.querySelector('[data-ing-empty]');
  var resetBtn = document.querySelector('[data-ing-reset]');
  var totalEl = document.querySelector('[data-ing-total]');
  var pageIndicator = document.querySelector('[data-ing-page-indicator]');
  var prevBtn = document.querySelector('[data-ing-prev]');
  var nextBtn = document.querySelector('[data-ing-next]');
  var paginationBox = document.getElementById('ing-pagination');

  if (!grid) return;

  var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-ing-card]'));

  function foldVi(str) {
    return String(str || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .trim();
  }

  function getMatchingCards() {
    var q = foldVi(searchQuery);
    return cards.filter(function (card) {
      if (!q) return true;
      var name = foldVi(card.getAttribute('data-ing-name'));
      return name.indexOf(q) !== -1;
    });
  }

  /* 20/11/2026: thanh số trang = PcPagination (ui_pagination chế độ js) — giao diện chung toàn site (UI-4.5). */
  function renderPagination(totalPages) {
    if (!paginationBox || !window.PcPagination) return;
    window.PcPagination.render(paginationBox, totalPages, currentPage, goToPage);
    var wrap = paginationBox.closest('[data-ing-pagination-wrap]');
    if (wrap) wrap.hidden = totalPages <= 1;
  }

  function goToPage(page) {
    var matching = getMatchingCards();
    var totalPages = Math.ceil(matching.length / PAGE_SIZE) || 1;
    if (page < 1) page = 1;
    if (page > totalPages) page = totalPages;
    currentPage = page;
    render();
  }

  function render() {
    var matching = getMatchingCards();
    var totalPages = Math.ceil(matching.length / PAGE_SIZE) || 1;
    if (currentPage > totalPages) currentPage = totalPages;

    var startIdx = (currentPage - 1) * PAGE_SIZE;
    var endIdx = startIdx + PAGE_SIZE;

    cards.forEach(function (card) {
      card.hidden = true;
    });

    matching.slice(startIdx, endIdx).forEach(function (card) {
      card.hidden = false;
    });

    var hasResults = matching.length > 0;
    if (emptyBox) emptyBox.hidden = hasResults;
    grid.hidden = !hasResults;

    if (totalEl) totalEl.textContent = '(' + matching.length + ' hoạt chất)';
    if (pageIndicator) pageIndicator.textContent = 'Trang ' + currentPage + ' / ' + totalPages;

    if (prevBtn) {
      prevBtn.disabled = currentPage <= 1 || !hasResults;
      prevBtn.hidden = !hasResults || totalPages <= 1;
    }
    if (nextBtn) {
      nextBtn.disabled = currentPage >= totalPages || !hasResults;
      nextBtn.hidden = !hasResults || totalPages <= 1;
    }

    renderPagination(totalPages);
  }

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      searchQuery = searchInput.value;
      if (clearBtn) clearBtn.hidden = !searchQuery;
      currentPage = 1;
      render();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      searchInput.value = '';
      searchQuery = '';
      clearBtn.hidden = true;
      currentPage = 1;
      render();
      searchInput.focus();
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      goToPage(currentPage - 1);
    });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      goToPage(currentPage + 1);
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      if (clearBtn) clearBtn.hidden = true;
      currentPage = 1;
      render();
    });
  }

  render();
})();
</script>

