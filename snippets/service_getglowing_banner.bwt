{%- comment -%}
  service_getglowing_banner — 01 Banner chính + 1. Giới thiệu đầu trang (hồ sơ bàn giao IT 2026-10-17).
  Banner = ảnh đã duyệt (settings.gg_hero_image, 1920×900); H1 + giới thiệu là chữ HTML bên dưới (SEO, mobile) — ảnh có chữ
  thì không lặp tiêu đề lên ảnh. Không có ảnh ⇒ chỉ hiện phần giới thiệu.
{%- endcomment -%}
{%- assign gg_cta_url = settings.gg_cta_url | default: '/dat-lich-tu-van' -%}
{%- assign gg_h1 = settings.gg_hero_title | default: page.title -%}
{%- if settings.gg_hero_image != blank -%}
<section class="gg-hero-banner" aria-label="{{ gg_h1 | escape }}">
  <picture>
    {%- if settings.gg_hero_image_mobile != blank -%}
    <source media="(max-width: 767px)" srcset="{{ settings.gg_hero_image_mobile | img_url: '1024x1024' }}">
    {%- endif -%}
    <img src="{{ settings.gg_hero_image | img_url: '2048x2048' }}" alt="{{ gg_h1 | escape }}" width="1920" height="900" loading="eager" fetchpriority="high" decoding="async">
  </picture>
</section>
{%- endif -%}

<section id="service-hero-section" class="gg-intro">
  <div class="container">
    <div class="gg-intro__inner">
      {%- if settings.gg_hero_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_hero_eyebrow | escape }}</p>{%- endif -%}
      <h1 class="gg-intro__title">{{ gg_h1 | escape }}</h1>
      {%- if settings.gg_hero_subtitle != blank -%}<p class="gg-intro__subtitle">{{ settings.gg_hero_subtitle | escape }}</p>{%- endif -%}
      {%- assign gg_paras = settings.gg_hero_text | newline_to_br | split: '<br />' -%}
      {%- for gg_p in gg_paras -%}{%- assign gg_p = gg_p | strip -%}{%- if gg_p != blank -%}<p class="gg-intro__text">{{ gg_p | escape }}</p>{%- endif -%}{%- endfor -%}
      <div class="gg-actions">
        <a href="{{ gg_cta_url | escape }}" class="gg-btn gg-btn--primary"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> {{ settings.gg_cta_text | default: 'ĐẶT LỊCH TƯ VẤN 1:1' | escape }}</a>
        {%- if settings.gg_cta2_text != blank -%}
        <a href="#service-concerns-section" class="gg-btn gg-btn--ghost">{{ settings.gg_cta2_text | escape }} <i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
