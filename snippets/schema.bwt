{%unless template contains 'index' or template contains '404'%}
<script type="application/ld+json">
        {
        "@context": "http://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": 
        [
            {
                "@type": "ListItem",
                "position": 1,
                "item": 
                {
                  "@id": "https:{{store.url}}",
                  "name": "Trang chủ"
                }
            },
      {% if template contains 'product' %}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/{{ product.alias }}",
                  "name": "{{ product.name }}"
                }
            }
      {%endif%}
        {% if template contains 'collection' and collection.alias %}
      {%if collection.alias == 'all'%}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/collections/all",
                  "name": "{{ collection.name }}"
                }
            }{% if current_tags %},{%endif%}
      {%else%}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/{{ collection.alias }}",
                  "name": "{{ collection.name }}"
                }
            }{% if current_tags %},{%endif%}
      {%endif%}
      {% if current_tags %}
        {%if collection.alias == 'all'%}
        {
          "@type": "ListItem",
          "position": 3,
          "item": 
          {
            "@id": "https:{{store.url}}/collections/all/{{ current_tags.first }}",
            "name": "{{ current_tags.first }}"
          }
        }
        {%else%}
        {
          "@type": "ListItem",
          "position": 3,
          "item": 
          {
            "@id": "https:{{store.url}}/{{ collection.alias }}/{{ current_tags.first }}",
            "name": "{{ current_tags.first }}"
          }
        }
        {%endif%}
      {%endif%}
      {%endif%}
      {% if template contains 'article' %}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}{{ blog.url }}",
                  "name": "{{ blog.name }}"
                }
            },
      {
                "@type": "ListItem",
                "position": 3,
                "item": 
                {
                  "@id": "https:{{store.url}}{{ article.url }}",
                  "name": "{{ article.title }}"
                }
            }
      {%endif%}
      {% if template == 'blog' %}
      {%if current_url contains 'blogs/all'%}
            {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/blogs/all",
                  "name": "{{ blog.name }}"
                }
            }
      {%else%}
        {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}{{blog.url}}",
                  "name": "{{ blog.name }}"
                }
            }
      {%if current_tags%}
      ,
      {
                "@type": "ListItem",
                "position": 3,
                "item": 
                {
                  "@id": "https:{{store.url}}{{blog.url}}/{{ current_tags.first }}",
                  "name": "{{ current_tags.first }}"
                }
            }
      {%endif%}
      {%endif%}
      {%endif%}
      {% if template contains 'page' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/{{ page.alias }}",
                  "name": "{{ page.title }}"
                }
            }
      {% endif %}
      {% if template contains 'cart' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/cart",
                  "name": "Giỏ hàng"
                }
            }
      {% endif %}
    {% if template contains 'search' %}
      {
                "@type": "ListItem",
                "position": 2,
                "item": 
                {
                  "@id": "https:{{store.url}}/search",
                  "name": "Tìm kiếm"
                }
            }
      {% endif %}
        ]
        }
</script>
{%endunless%}
{%- comment -%}
  T-138 (2026-09-12) — SEO: nâng khối Organization lên HealthAndBeautyBusiness (phân nhóm
  LocalBusiness của schema.org, đúng bản chất hộ kinh doanh dược mỹ phẩm có địa điểm thật) và đổ
  đúng số liệu pháp lý người dùng cung cấp: tên hộ kinh doanh, MST, địa chỉ trên giấy phép, điện
  thoại, email. Google dùng chính các trường này cho Knowledge Panel / Local Pack, nên khai báo
  khớp với thông tin công bố ở chân trang là điều kiện để được tin cậy (số liệu lệch nhau giữa
  trang và structured data là một lỗi SEO thường gặp).
  Mọi giá trị đọc từ lớp schema-admin, KHÔNG hardcode — sửa trong Sapo Admin là schema tự đổi theo.
{%- endcomment -%}
<script type="application/ld+json">
{
	"@context" : "https://schema.org",
  	"@type" : "HealthAndBeautyBusiness",
  	"name" : "{{ settings.store_name | default: store.name }}",
  	"legalName" : "{{ settings.footer_legal_company | default: store.name }}",
  	"url" : "https:{{ store.url }}",
	{%- if settings.footer_legal_tax_code != blank %}
  	"taxID" : "{{ settings.footer_legal_tax_code }}",
	"vatID" : "{{ settings.footer_legal_tax_code }}",
	{%- endif %}
	{%- assign _seo_addr = settings.footer_legal_address | default: settings.store_address -%}
	{%- if _seo_addr != blank %}
	"address" : {
		"@type" : "PostalAddress",
		"streetAddress" : "{{ _seo_addr | strip_newlines | remove: 'Địa chỉ:' | strip | escape }}",
		"addressLocality" : "Hà Nội",
		"addressCountry" : "VN"
	},
	{%- endif %}
	{%- if settings.footer_legal_email != blank %}
	"email" : "{{ settings.footer_legal_email }}",
	{%- endif %}
  	"telephone" : "{{ settings.footer_legal_phone | default: settings.store_phone | default: store.phone_number }}",
  	"contactPoint":[{
    	"@type" : "ContactPoint",
    	"telephone" : "{{ settings.footer_legal_phone | default: settings.store_phone | default: store.phone_number }}",
    	"contactType" : "customer service",
		"availableLanguage" : ["vi", "en"]
  	}],
  	"logo":"{{ 'logo.png' | asset_url }}",
  	"sameAs":[
  	"{{ settings.social_facebook_link }}",
    "{{ settings.social_twitter_link }}"
	]
}
</script>
<script type="application/ld+json">
{
  "@context" : "http://schema.org",
  "@type" : "WebSite", 
  "name" : "{{ store.name }}",
  "url" : "https:{{ store.url }}",
  "potentialAction":{
    	"@type" : "SearchAction",
    	"target" : "https:{{ store.url}}/search?query={search_term}",
    	"query-input" : "required name=search_term"
  	}                     
}
</script>