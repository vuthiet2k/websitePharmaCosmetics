{%- comment -%}
  2026-10-03 SEO: dựng lại BreadcrumbList — mọi chuỗi qua | json (tên có dấu " không làm vỡ JSON),
  item in qua snippet jsonld_breadcrumb_item (dấu phẩy đứng trước), URL chuẩn hoá về https dù
  store.url dạng //domain hay https://domain. Trang chỉ có "Trang chủ" thì không in khối này.
{%- endcomment -%}
{%- assign pc_jsonld_base = store.url | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
{%unless template contains 'index' or template contains '404'%}
{%- capture pc_bc_items -%}
{%- if template contains 'product' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_url = '/' | append: product.alias -%}{%- assign pc_bc_name = product.name -%}{%- include 'jsonld_breadcrumb_item' -%}
{%- endif -%}
{%- if template contains 'collection' and collection.alias -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_name = collection.name -%}
  {%- if collection.alias == 'all' -%}{%- assign pc_bc_url = '/collections/all' -%}{%- else -%}{%- assign pc_bc_url = '/' | append: collection.alias -%}{%- endif -%}
  {%- include 'jsonld_breadcrumb_item' -%}
  {%- if current_tags -%}
    {%- assign pc_bc_pos = 3 -%}{%- assign pc_bc_url = pc_bc_url | append: '/' | append: current_tags.first -%}{%- assign pc_bc_name = current_tags.first -%}{%- include 'jsonld_breadcrumb_item' -%}
  {%- endif -%}
{%- endif -%}
{%- if template contains 'article' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_url = blog.url -%}{%- assign pc_bc_name = blog.name -%}{%- include 'jsonld_breadcrumb_item' -%}
  {%- assign pc_bc_pos = 3 -%}{%- assign pc_bc_url = article.url -%}{%- assign pc_bc_name = article.title -%}{%- include 'jsonld_breadcrumb_item' -%}
{%- endif -%}
{%- if template == 'blog' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_name = blog.name -%}
  {%- comment -%} 2026-10-03: current_url không tồn tại trên Sapo (luôn nil) → dùng canonical_url. {%- endcomment -%}
  {%- if canonical_url contains 'blogs/all' -%}{%- assign pc_bc_url = '/blogs/all' -%}{%- else -%}{%- assign pc_bc_url = blog.url -%}{%- endif -%}
  {%- include 'jsonld_breadcrumb_item' -%}
  {%- if current_tags and pc_bc_url != '/blogs/all' -%}
    {%- assign pc_bc_pos = 3 -%}{%- assign pc_bc_url = blog.url | append: '/' | append: current_tags.first -%}{%- assign pc_bc_name = current_tags.first -%}{%- include 'jsonld_breadcrumb_item' -%}
  {%- endif -%}
{%- endif -%}
{%- if template contains 'page' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_url = '/' | append: page.alias -%}{%- assign pc_bc_name = page.title -%}{%- include 'jsonld_breadcrumb_item' -%}
{%- endif -%}
{%- if template contains 'cart' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_url = '/cart' -%}{%- assign pc_bc_name = 'Giỏ hàng' -%}{%- include 'jsonld_breadcrumb_item' -%}
{%- endif -%}
{%- if template contains 'search' -%}
  {%- assign pc_bc_pos = 2 -%}{%- assign pc_bc_url = '/search' -%}{%- assign pc_bc_name = 'Tìm kiếm' -%}{%- include 'jsonld_breadcrumb_item' -%}
{%- endif -%}
{%- endcapture -%}
{%- if pc_bc_items != blank -%}
<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "item": {"@id": {{ pc_jsonld_base | json }}, "name": "Trang chủ"}}{{ pc_bc_items | strip }}]}
</script>
{%- endif -%}
{%endunless%}
{%- comment -%}
  T-138 (2026-09-12) — SEO: nâng khối Organization lên HealthAndBeautyBusiness (phân nhóm
  LocalBusiness của schema.org, đúng bản chất hộ kinh doanh dược mỹ phẩm có địa điểm thật) và đổ
  đúng số liệu pháp lý người dùng cung cấp: tên hộ kinh doanh, MST, địa chỉ trên giấy phép, điện
  thoại, email. Google dùng chính các trường này cho Knowledge Panel / Local Pack, nên khai báo
  khớp với thông tin công bố ở chân trang là điều kiện để được tin cậy (số liệu lệch nhau giữa
  trang và structured data là một lỗi SEO thường gặp).
  Mọi giá trị đọc từ lớp schema-admin, KHÔNG hardcode — sửa trong Sapo Admin là schema tự đổi theo.
{%- endcomment -%}
{%- comment -%} 2026-10-03: chuỗi qua | json, URL/logo chuẩn https, bỏ trường rỗng. {%- endcomment -%}
{%- assign pc_ld_phone = settings.footer_legal_phone | default: settings.store_phone | default: store.phone_number -%}
{%- assign pc_ld_logo = 'logo.png' | asset_url | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
{%- assign _seo_addr = settings.footer_legal_address | default: settings.store_address -%}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "HealthAndBeautyBusiness",
	"name": {{ settings.store_name | default: store.name | json }},
	"legalName": {{ settings.footer_legal_company | default: store.name | json }},
	"url": {{ pc_jsonld_base | json }},
	{%- if settings.footer_legal_tax_code != blank %}
	"taxID": {{ settings.footer_legal_tax_code | json }},
	"vatID": {{ settings.footer_legal_tax_code | json }},
	{%- endif %}
	{%- if _seo_addr != blank %}
	"address": {
		"@type": "PostalAddress",
		"streetAddress": {{ _seo_addr | strip_newlines | remove: 'Địa chỉ:' | strip | json }},
		{%- if settings.geo_placename != blank %}
		"addressLocality": {{ settings.geo_placename | strip | json }},
		{%- endif %}
		"addressCountry": "VN"
	},
	{%- endif %}
	{%- comment -%} 2026-10-03: GEO local (Section "SEO") — chỉ in khi admin đã nhập, không bịa toạ độ/giờ/giá. {%- endcomment -%}
	{%- if settings.geo_latitude != blank and settings.geo_longitude != blank %}
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": {{ settings.geo_latitude | strip | json }},
		"longitude": {{ settings.geo_longitude | strip | json }}
	},
	{%- endif %}
	{%- if settings.business_google_maps_url != blank %}
	"hasMap": {{ settings.business_google_maps_url | strip | json }},
	{%- endif %}
	{%- if settings.business_opening_hours != blank %}
	{%- assign pc_ld_hours = settings.business_opening_hours | split: ',' -%}
	"openingHours": [
		{%- for h in pc_ld_hours -%}{{ h | strip | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
	],
	{%- endif %}
	{%- if settings.business_price_range != blank %}
	"priceRange": {{ settings.business_price_range | strip | json }},
	{%- endif %}
	{%- if settings.footer_legal_email != blank %}
	"email": {{ settings.footer_legal_email | json }},
	{%- endif %}
	{%- comment -%} 2026-10-03: sameAs đọc footer_social_fb / footer_social_insta (field cũ social_facebook_link/social_twitter_link không tồn tại trong schema). {%- endcomment -%}
	{%- if settings.footer_social_fb != blank or settings.footer_social_insta != blank %}
	"sameAs": [
		{%- assign pc_ld_comma = "" -%}
		{%- if settings.footer_social_fb != blank -%}{{ pc_ld_comma }}{{ settings.footer_social_fb | strip | json }}{%- assign pc_ld_comma = "," -%}{%- endif -%}
		{%- if settings.footer_social_insta != blank -%}{{ pc_ld_comma }}{{ settings.footer_social_insta | strip | json }}{%- assign pc_ld_comma = "," -%}{%- endif -%}
	],
	{%- endif %}
	{%- if pc_ld_phone != blank %}
	"telephone": {{ pc_ld_phone | json }},
	"contactPoint": [{
		"@type": "ContactPoint",
		"telephone": {{ pc_ld_phone | json }},
		"contactType": "customer service",
		"availableLanguage": ["vi", "en"]
	}],
	{%- endif %}
	"logo": {{ pc_ld_logo | json }}
}
</script>
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": {{ store.name | json }},
	"url": {{ pc_jsonld_base | json }},
	"potentialAction": {
		"@type": "SearchAction",
		"target": {{ pc_jsonld_base | append: '/search?query={search_term}' | json }},
		"query-input": "required name=search_term"
	}
}
</script>
