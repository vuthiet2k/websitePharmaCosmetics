{%- comment -%}
  Chân trang (mọi trang).
  100% utility class Tailwind chuẩn, không class CSS tự chế, không lồng selector.
  Màu nền bám theo cấu hình theme (bg-primary), chữ trắng.
{%- endcomment -%}
{%- assign copyright = settings.footer_copyright -%}
{%- assign btt = settings.backtotop_enable -%}
{%- assign _ft_addr = settings.store_address -%}
{%- if _ft_addr == blank -%}
  {%- capture _ft_addr -%}{%if store.address!='' %}{{ store.address }}, {%endif%}{%if store.province!='' %}{{store.province}}, {%endif%}{%if store.district!='' %}{{store.district}}, {%endif%}{%if store.country!='' %}{{store.country}}{%endif%}{%- endcapture -%}
{%- endif -%}
{%- assign _ft_phone = settings.store_phone | default: store.phone_number -%}
{%- assign _ft_email = settings.store_email | default: store.customer_email -%}
<footer class="footer bg-primary text-white py-10 lg:py-14">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:flex lg:flex-row lg:justify-between gap-6 lg:gap-8">
      <div class="flex flex-col justify-between lg:max-w-xs">
        <div>
          {%- assign _ft_name = settings.store_name | default: store.name -%}
          <a class="inline-flex min-h-[44px] items-center mb-4 text-white no-underline" href="/" title="{{ _ft_name | escape }}">
            {%- if settings.footer_logo_use_image == true or settings.footer_logo_use_image == 'true' -%}
              <img class="block h-auto w-48 lg:w-56" src="{{ 'logo_footer.png' | asset_url }}" width="270" height="56" alt="{{ _ft_name | escape }}" loading="lazy">
            {%- else -%}
              <img class="block h-auto w-48 lg:w-56 brightness-0 invert" src="{{ 'PharmaCosmetics.svg' | asset_url }}" width="341" height="70" alt="{{ _ft_name | escape }}" loading="lazy">
            {%- endif -%}
          </a>
          {%- unless settings.enable_info_foo == false or settings.enable_info_foo == 'false' -%}
            {%- if settings.content_info_foo != blank -%}
              <div class="text-sm leading-relaxed text-white/90 mb-3">{{ settings.content_info_foo }}</div>
            {%- endif -%}
          {%- endunless -%}
          {%- if _ft_addr != blank -%}
            <p class="m-0 mb-2 text-sm leading-relaxed text-white/90">
              {%- assign _ft_addr_lines = _ft_addr | newline_to_br | split: '<br />' -%}
              {%- assign _ft_first = true -%}
              {%- for _l in _ft_addr_lines -%}
                {%- assign _l = _l | strip -%}
                {%- if _l != blank -%}
                  {%- unless _ft_first -%}<br>{%- endunless -%}{{ _l }}
                  {%- assign _ft_first = false -%}
                {%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}
          {%- comment -%} 21/11/2026: Hotline + Email nằm ngay dưới địa chỉ (mỗi dòng 1 nhãn), thay dòng «SĐT · email» tách riêng. {%- endcomment -%}
          {%- if _ft_phone != blank or _ft_email != blank -%}
            <ul class="m-0 p-0 list-none text-sm leading-relaxed text-white/90">
              {%- if _ft_phone != blank -%}<li class="flex flex-wrap items-center gap-x-1">Hotline: <a class="inline-flex min-h-[44px] items-center text-white hover:underline no-underline lg:min-h-0" href="tel:{{ _ft_phone | remove: ' ' | remove: '.' }}">{{ _ft_phone }}</a></li>{%- endif -%}
              {%- if _ft_email != blank -%}<li class="flex flex-wrap items-center gap-x-1">Email: <a class="inline-flex min-h-[44px] items-center text-white hover:underline no-underline lg:min-h-0" href="mailto:{{ _ft_email }}">{{ _ft_email }}</a></li>{%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- assign _fc_ll = linklists[settings.footer_custom_menu] -%}
      {%- if settings.footer_custom_menu != blank and _fc_ll.links.size > 0 -%}
        <div class="border-0 border-b border-solid border-white/15 lg:border-none lg:max-w-xs">
          <details class="group" data-pc-acc open>
            <summary class="flex items-center justify-between cursor-pointer list-none min-h-[44px] lg:min-h-0 lg:pointer-events-none [&::-webkit-details-marker]:hidden">
              <h4 class="m-0 text-base font-bold text-white">{{ settings.footer_custom_title | default: _fc_ll.title | escape }}</h4>
              <span class="lg:hidden inline-flex h-7 w-7 items-center justify-center text-white transition-transform duration-200 group-open:rotate-180" aria-hidden="true">{% include 'ui_icon', name: 'chevron-down' %}</span>
            </summary>
            <ul class="m-0 p-0 list-none flex flex-col gap-0 pb-3 lg:gap-2 lg:pb-0 lg:mt-4">
              {%- for link in _fc_ll.links -%}
                <li><a class="text-sm text-white hover:underline no-underline flex min-h-[44px] items-center py-2 lg:min-h-0 lg:py-0.5" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </details>
        </div>
      {%- endif -%}

      {%- assign _fs_ll = linklists[settings.footer_support_menu] -%}
      {%- assign _fp_ll = linklists[settings.footer_policy_menu] -%}
      {%- if _fs_ll.links.size > 0 or _fp_ll.links.size > 0 -%}
        <div class="border-0 border-b border-solid border-white/15 lg:border-none lg:max-w-xs">
          <details class="group" data-pc-acc open>
            <summary class="flex items-center justify-between cursor-pointer list-none min-h-[44px] lg:min-h-0 lg:pointer-events-none [&::-webkit-details-marker]:hidden">
              <h4 class="m-0 text-base font-bold text-white">{{ settings.footer_support_title | default: settings.footer_policy_title | default: 'Chính sách' | escape }}</h4>
              <span class="lg:hidden inline-flex h-7 w-7 items-center justify-center text-white transition-transform duration-200 group-open:rotate-180" aria-hidden="true">{% include 'ui_icon', name: 'chevron-down' %}</span>
            </summary>
            <ul class="m-0 p-0 list-none flex flex-col gap-0 pb-3 lg:gap-2 lg:pb-0 lg:mt-4">
              {%- assign _fs_urls = '|' -%}
              {%- for link in _fs_ll.links -%}
                <li><a class="text-sm text-white hover:underline no-underline flex min-h-[44px] items-center py-2 lg:min-h-0 lg:py-0.5" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- assign _fs_urls = _fs_urls | append: link.url | append: '|' -%}
              {%- endfor -%}
              {%- for link in _fp_ll.links -%}
                {%- capture _fs_mark -%}|{{ link.url }}|{%- endcapture -%}
                {%- unless _fs_urls contains _fs_mark -%}
                  <li><a class="text-sm text-white hover:underline no-underline flex min-h-[44px] items-center py-2 lg:min-h-0 lg:py-0.5" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </details>
        </div>
      {%- endif -%}

      <div class="border-0 border-b border-solid border-white/15 lg:border-none lg:max-w-xs">
        <details class="group" data-pc-acc open>
          <summary class="flex items-center justify-between cursor-pointer list-none min-h-[44px] lg:min-h-0 lg:pointer-events-none [&::-webkit-details-marker]:hidden">
            <h4 class="m-0 text-base font-bold text-white">{{ settings.footer_help_title | default: 'Hỗ trợ' | escape }}</h4>
            <span class="lg:hidden inline-flex h-7 w-7 items-center justify-center text-white transition-transform duration-200 group-open:rotate-180" aria-hidden="true">{% include 'ui_icon', name: 'chevron-down' %}</span>
          </summary>
          <div class="pb-3 lg:pb-0 lg:mt-4">
            <ul class="m-0 p-0 list-none flex flex-col gap-0 lg:gap-2.5">
              {%- assign _fh_phone = _ft_phone -%}
              {%- if _fh_phone != blank -%}
                <li class="flex min-h-[44px] items-center py-2 text-sm text-white lg:min-h-0 lg:py-0">
                  {{ settings.footer_help_hotline_label | default: 'Hotline' | escape }}:&nbsp;<a class="inline-flex min-h-[44px] items-center font-bold text-white hover:underline no-underline" href="tel:{{ _fh_phone | remove: ' ' | remove: '.' }}">{{ _fh_phone }}</a>
                </li>
              {%- endif -%}
              {%- if settings.contact_zalo != blank -%}
                <li class="flex min-h-[44px] items-center py-2 text-sm text-white lg:min-h-0 lg:py-0">
                  <a class="inline-flex min-h-[44px] items-center text-white hover:underline no-underline" href="https://zalo.me/{{ settings.contact_zalo | remove: ' ' | remove: '.' }}" target="_blank" rel="noopener">{{ settings.footer_help_zalo_label | default: 'Tư vấn qua Zalo' | escape }}</a>
                </li>
              {%- endif -%}
              {%- if settings.footer_social_enable -%}
                {%- capture _fh_social -%}
                  {%- if settings.footer_social_fb != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_fb }}" target="_blank" rel="noopener" aria-label="Facebook"><img src="{{ 'facebook_2.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                  {%- if settings.footer_social_insta != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_insta }}" target="_blank" rel="noopener" aria-label="Instagram"><img src="{{ 'instagram_1.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                  {%- if settings.footer_social_tiktok != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><img src="{{ 'tiktok.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                  {%- if settings.footer_social_whatsapp != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><img src="{{ 'whatsapp.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                  {%- if settings.footer_social_shopee != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_shopee }}" target="_blank" rel="noopener" aria-label="Shopee"><img src="{{ 'shopee.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                  {%- if settings.footer_social_lazada != blank -%}<a class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-colors" href="{{ settings.footer_social_lazada }}" target="_blank" rel="noopener" aria-label="Lazada"><img src="{{ 'lazada.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy"></a>{%- endif -%}
                {%- endcapture -%}
                {%- if _fh_social != blank -%}<li class="flex flex-wrap items-center gap-2 mt-2">{{ _fh_social }}</li>{%- endif -%}
              {%- endif -%}
            </ul>
          </div>
        </details>
      </div>
    </div>

    <div class="border-t border-white/15 pt-6 mt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/80">
      {%- unless settings.footer_payment_enable == false or settings.footer_payment_enable == 'false' -%}
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
          {%- if settings.footer_payment_title != blank -%}<span class="font-medium text-white/90">{{ settings.footer_payment_title | escape }}:</span>{%- endif -%}
          {%- for i in (1..5) -%}
            {%- capture enable -%}footer_payment_{{ i }}_enable{%- endcapture -%}
            {%- capture alt -%}footer_payment_{{ i }}_alt{%- endcapture -%}
            {%- capture logo -%}payment_{{ i }}.png{%- endcapture -%}
            {%- unless settings[enable] == false or settings[enable] == 'false' -%}
              <img class="h-6 w-auto rounded bg-white px-1.5 py-0.5 object-contain" src="{{ logo | asset_url }}" alt="{{ settings[alt] | default: 'Thanh toán' | escape }}" width="63" height="29" loading="lazy">
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- else -%}<div></div>{%- endunless -%}

      {%- if settings.footer_bct_url != blank -%}
        {%- if settings.footer_bct_logo != blank -%}{%- assign pc_bct_logo = settings.footer_bct_logo | img_url: 'large' -%}{%- else -%}{%- assign pc_bct_logo = 'https://fileserver.online.gov.vn/uploads/Resources/iconxacnhan/DaThongBao.png' -%}{%- endif -%}
        <a href="{{ settings.footer_bct_url | escape }}" target="_blank" rel="noopener nofollow" title="Đã thông báo Bộ Công Thương" class="inline-flex items-center">
          <img src="{{ pc_bct_logo }}" alt="Đã thông báo Bộ Công Thương" width="130" height="49" loading="lazy">
        </a>
      {%- endif -%}

      <p class="m-0 text-center md:text-right" id="copyright">
        {% if copyright != blank %}{{ copyright }}{% else %}© Bản quyền thuộc về <b>Pharma Cosmetics</b>{% endif %}
        <span class="hidden">Cung cấp bởi <a href="https://www.sapo.vn/" target="_blank" rel="nofollow noopener">Sapo</a></span>
      </p>
    </div>

    {%- if settings.footer_legal_enable == true or settings.footer_legal_enable == 'true' -%}
      <div class="border-t border-white/10 pt-4 mt-4 text-xs leading-relaxed text-white/70 footer-legal text-center">
        <p class="m-0 mb-1">
          <b class="font-semibold text-white/90">{{ settings.footer_legal_company | default: settings.store_name | default: store.name }}</b>
          {%- assign _legal_addr = settings.footer_legal_address | default: settings.store_address -%}
          {%- if _legal_addr != blank %}
            &bull; Địa chỉ: {{ _legal_addr | strip_newlines | remove: 'Phòng trị liệu da chuyên nghiệp 1:1 (Skin Health Beauty)' | remove: 'Địa chỉ:' | strip }}
          {%- endif %}
        </p>
        <p class="m-0 mb-1">
          Mã số thuế / Mã số doanh nghiệp:
          <b class="font-semibold text-white/90">{{ settings.footer_legal_tax_code | default: '(chưa cập nhật — nhập tại Sapo Admin › Cấu hình giao diện)' }}</b>
          {%- if settings.footer_legal_license_date != blank %}
            &bull; Ngày cấp: {{ settings.footer_legal_license_date }}
          {%- endif %}
          {%- if settings.footer_legal_license_issuer != blank %}
            &bull; Nơi cấp: {{ settings.footer_legal_license_issuer }}
          {%- endif %}
        </p>
        {%- if settings.footer_legal_representative != blank %}
          <p class="m-0">Người đại diện pháp luật: {{ settings.footer_legal_representative }}</p>
        {%- endif %}
      </div>
    {%- endif -%}

  </div>

  <script>
  (function() {
    function syncFootAcc() {
      var isDesktop = window.innerWidth >= 1024;
      document.querySelectorAll('footer.footer details[data-pc-acc], section[aria-labelledby="footer-quick-title"] details[data-pc-acc]').forEach(function(el) {
        if (isDesktop) {
          el.setAttribute('open', '');
        } else {
          el.removeAttribute('open');
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncFootAcc);
    } else {
      syncFootAcc();
    }
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(syncFootAcc, 150);
    }, { passive: true });
  })();
  </script>

  {% if btt %}
    <a href="#" class="backtop !h-11 !w-11 min-h-[44px] min-w-[44px] !bg-primary !text-white !z-fab" title="Lên đầu trang" aria-label="Lên đầu trang"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'arrow-up', size: 'em' %}</i></a>
  {% endif %}
</footer>
