{%- comment -%}
  Chân trang (mọi trang). 03/11/2026 (chủ dự án: trang chủ theo Figma "travel" node 5:2 — design/home-v4/full.png):
  nền xanh đậm nhất, viền trên xanh deco; hàng trên = cột thương hiệu (tên cửa hàng · giới thiệu content_info_foo · địa chỉ
  store_address · điện thoại · email) + 3 cột: Menu footer_custom_menu (footer_custom_title), Menu footer_support_menu
  (footer_support_title, thêm các link footer_policy_menu chưa trùng), cột "Hỗ trợ" (footer_help_title: hotline, Zalo, mạng xã hội
  footer_social_*); dải giữa = thanh toán (logo payment_N.png các cổng đang bật, alt footer_payment_N_alt) · logo Bộ Công Thương · bản quyền.
  DẢI PHÁP LÝ (T-126 / T-138 / T-141, NĐ 52/2013) GIỮ NGUYÊN CÂU CHỮ — chỉ đổi khung/màu (UI-STANDARD A.6).
  Dòng "Cung cấp bởi Sapo" giữ trong mã nguồn (quy định theme Sapo), ẩn khỏi giao diện. CSS: ui-src/css/components.css mục 14.12.
{%- endcomment -%}
{%- assign copyright = settings.footer_copyright -%}
{%- assign btt = settings.backtotop_enable -%}
{%- assign _ft_addr = settings.store_address -%}
{%- if _ft_addr == blank -%}
{%- capture _ft_addr -%}{%if store.address!='' %}{{ store.address }}, {%endif%}{%if store.province!='' %}{{store.province}}, {%endif%}{%if store.district!='' %}{{store.district}}, {%endif%}{%if store.country!='' %}{{store.country}}{%endif%}{%- endcapture -%}
{%- endif -%}
{%- assign _ft_phone = settings.store_phone | default: store.phone_number -%}
{%- assign _ft_email = settings.store_email | default: store.customer_email -%}
<footer class="pc-h4 pc-h4-foot footer">
  <div class="pc-h4-wrap">
    <div class="pc-h4-foot__top">
      <div>
        <a class="pc-h4-foot__name" href="/">{{ settings.store_name | default: store.name | escape }}</a>
        {%- comment -%} Logo chân trang cũ (footer_logo_use_image / logo_footer.png) — thiết kế mới dùng tên chữ; giữ đọc trường để Admin bật lại ảnh. {%- endcomment -%}
        {%- if settings.footer_logo_use_image == true -%}<img class="mt-4 block" src="{{ 'logo_footer.png' | asset_url }}" width="270" height="56" alt="{{ settings.store_name | default: store.name | escape }}" loading="lazy">{%- endif -%}
        {%- unless settings.enable_info_foo == false or settings.enable_info_foo == 'false' -%}{%- if settings.content_info_foo != blank -%}
        <div class="pc-h4-foot__info">{{ settings.content_info_foo }}</div>
        {%- endif -%}{%- endunless -%}
        {%- if _ft_addr != blank -%}
        <p class="pc-h4-foot__line">{%- assign _ft_addr_lines = _ft_addr | newline_to_br | split: '<br />' -%}{%- assign _ft_first = true -%}{%- for _l in _ft_addr_lines -%}{%- assign _l = _l | strip -%}{%- if _l != blank -%}{%- unless _ft_first -%}<br>{%- endunless -%}{{ _l }}{%- assign _ft_first = false -%}{%- endif -%}{%- endfor -%}</p>
        {%- endif -%}
        {%- if _ft_phone != blank or _ft_email != blank -%}
        <p class="pc-h4-foot__line">
          {%- if _ft_phone != blank -%}<a href="tel:{{ _ft_phone | remove: ' ' | remove: '.' }}">{{ _ft_phone }}</a>{%- endif -%}
          {%- if _ft_phone != blank and _ft_email != blank %} · {% endif -%}
          {%- if _ft_email != blank -%}<a href="mailto:{{ _ft_email }}">{{ _ft_email }}</a>{%- endif -%}
        </p>
        {%- endif -%}
      </div>
      {%- assign _fc_ll = linklists[settings.footer_custom_menu] -%}
      {%- if settings.footer_custom_menu != blank and _fc_ll.links.size > 0 -%}
      <div>
        <h2 class="pc-h4-foot__h">{{ settings.footer_custom_title | default: _fc_ll.title | escape }}</h2>
        <ul class="pc-h4-foot__list">{%- for link in _fc_ll.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
      {%- endif -%}
      {%- assign _fs_ll = linklists[settings.footer_support_menu] -%}
      {%- assign _fp_ll = linklists[settings.footer_policy_menu] -%}
      {%- if _fs_ll.links.size > 0 or _fp_ll.links.size > 0 -%}
      <div>
        <h2 class="pc-h4-foot__h">{{ settings.footer_support_title | default: settings.footer_policy_title | default: 'Chính sách' | escape }}</h2>
        <ul class="pc-h4-foot__list">
          {%- assign _fs_urls = '|' -%}
          {%- for link in _fs_ll.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- assign _fs_urls = _fs_urls | append: link.url | append: '|' -%}{%- endfor -%}
          {%- for link in _fp_ll.links -%}{%- capture _fs_mark -%}|{{ link.url }}|{%- endcapture -%}{%- unless _fs_urls contains _fs_mark -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endunless -%}{%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
      <div>
        <h2 class="pc-h4-foot__h">{{ settings.footer_help_title | default: 'Hỗ trợ' | escape }}</h2>
        <ul class="pc-h4-foot__list">
          {%- assign _fh_phone = _ft_phone -%}
          {%- if _fh_phone != blank -%}<li>{{ settings.footer_help_hotline_label | default: 'Hotline' | escape }}: <a href="tel:{{ _fh_phone | remove: ' ' | remove: '.' }}">{{ _fh_phone }}</a></li>{%- endif -%}
          {%- if settings.contact_zalo != blank -%}<li><a href="https://zalo.me/{{ settings.contact_zalo | remove: ' ' | remove: '.' }}" target="_blank" rel="noopener">{{ settings.footer_help_zalo_label | default: 'Tư vấn qua Zalo' | escape }}</a></li>{%- endif -%}
          {%- if settings.footer_social_enable -%}
          {%- capture _fh_social -%}
            {%- if settings.footer_social_fb != blank -%}<a href="{{ settings.footer_social_fb }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
            {%- if settings.footer_social_insta != blank -%}<a href="{{ settings.footer_social_insta }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
            {%- if settings.footer_social_tiktok != blank -%}<a href="{{ settings.footer_social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
            {%- if settings.footer_social_whatsapp != blank -%}<a href="{{ settings.footer_social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
            {%- if settings.footer_social_shopee != blank -%}<a href="{{ settings.footer_social_shopee }}" target="_blank" rel="noopener">Shopee</a>{%- endif -%}
            {%- if settings.footer_social_lazada != blank -%}<a href="{{ settings.footer_social_lazada }}" target="_blank" rel="noopener">Lazada</a>{%- endif -%}
          {%- endcapture -%}
          {%- if _fh_social != blank -%}<li>{{ _fh_social | replace: '</a><a', '</a> · <a' }}</li>{%- endif -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
    <div class="pc-h4-foot__bar">
      {%- unless settings.footer_payment_enable == false or settings.footer_payment_enable == 'false' -%}
      <p class="pc-h4-foot__pay"><span>{{ settings.footer_payment_title | default: 'Thanh toán' | escape }}:</span>
        {%- comment -%} Logo thật assets/payment_1..5.png (ô ảnh Admin "Icon N — logo" ghi đè đúng file), alt = footer_payment_N_alt. {%- endcomment -%}
        {%- for i in (1..5) -%}{%- capture enable -%}footer_payment_{{ i }}_enable{%- endcapture -%}{%- capture alt -%}footer_payment_{{ i }}_alt{%- endcapture -%}{%- capture logo -%}payment_{{ i }}.png{%- endcapture -%}
        {%- unless settings[enable] == false or settings[enable] == 'false' -%}<img src="{{ logo | asset_url }}" alt="{{ settings[alt] | default: 'Thanh toán' | escape }}" width="63" height="29" loading="lazy">{%- endunless -%}
        {%- endfor -%}
      </p>
      {%- else -%}<span></span>{%- endunless -%}
      {%- comment -%} Logo "Đã thông báo Bộ Công Thương" chỉ hiện khi admin dán link thật (online.gov.vn riêng từng DN); chưa tải footer_bct_logo ⇒ ảnh chính thức online.gov.vn. {%- endcomment -%}
      {%- if settings.footer_bct_url != blank -%}
      {%- if settings.footer_bct_logo != blank -%}{%- assign pc_bct_logo = settings.footer_bct_logo | img_url: 'large' -%}{%- else -%}{%- assign pc_bct_logo = 'https://fileserver.online.gov.vn/uploads/Resources/iconxacnhan/DaThongBao.png' -%}{%- endif -%}
      <a href="{{ settings.footer_bct_url | escape }}" target="_blank" rel="noopener nofollow" title="Đã thông báo Bộ Công Thương"><img src="{{ pc_bct_logo }}" alt="Đã thông báo Bộ Công Thương" width="130" height="49" loading="lazy"></a>
      {%- endif -%}
      <p class="pc-h4-foot__copy" id="copyright">
        {% if copyright != blank %}{{ copyright }}{% else %}© Bản quyền thuộc về <b>Pharma Cosmetics</b>{% endif %}
        <span class="pc-h4-foot__powered">Cung cấp bởi <a href="https://www.sapo.vn/" target="_blank" rel="nofollow noopener">Sapo</a></span>
      </p>
    </div>
    {%- comment -%}
      T-126 (2026-09-12) — Nghị định 52/2013/NĐ-CP (điều 29) buộc website TMĐT phải công bố tên thương nhân,
      địa chỉ trụ sở, MST/mã số doanh nghiệp, ngày cấp + nơi cấp và người đại diện. Toàn bộ giá trị lấy từ
      schema-admin — CỐ Ý không hardcode số MST/GPKD; field chưa nhập hiện rõ là ô cần điền, KHÔNG bịa số.
      T-138: HỘ KINH DOANH; địa chỉ pháp lý dùng field riêng footer_legal_address (khác địa chỉ phòng trị liệu).
      T-141: dải pháp lý không lặp điện thoại/email (đã có ở dòng liên hệ phía trên).
    {%- endcomment -%}
    <div class="pc-h4-foot__legal footer-legal">
      <p class="footer-legal__line">
        <b>{{ settings.footer_legal_company | default: settings.store_name | default: store.name }}</b>
        {%- assign _legal_addr = settings.footer_legal_address | default: settings.store_address -%}
        {%- if _legal_addr != blank %}
        &bull; Địa chỉ: {{ _legal_addr | strip_newlines | remove: 'Phòng trị liệu da chuyên nghiệp 1:1 (Skin Health Beauty)' | remove: 'Địa chỉ:' | strip }}
        {%- endif %}
      </p>
      <p class="footer-legal__line">
        Mã số thuế / Mã số doanh nghiệp:
        <b>{{ settings.footer_legal_tax_code | default: '(chưa cập nhật — nhập tại Sapo Admin › Cấu hình giao diện)' }}</b>
        {%- if settings.footer_legal_license_date != blank %}
        &bull; Ngày cấp: {{ settings.footer_legal_license_date }}
        {%- endif %}
        {%- if settings.footer_legal_license_issuer != blank %}
        &bull; Nơi cấp: {{ settings.footer_legal_license_issuer }}
        {%- endif %}
      </p>
      {%- if settings.footer_legal_representative != blank %}
      <p class="footer-legal__line">Người đại diện pháp luật: {{ settings.footer_legal_representative }}</p>
      {%- endif %}
      {%- if settings.contact_us_enable -%}
      {%- comment -%} D02 (phase home-shopping-ux): mở lại cụm liên hệ nổi khi người dùng đã ẩn (snippets/support.bwt). {%- endcomment -%}
      <p class="mt-2"><button type="button" class="footer-contact-reopen" data-contact-show>Hiện lại nút liên hệ nhanh</button></p>
      {%- endif -%}
    </div>
  </div>
  {% if btt %}
  <a href="#" class="backtop" title="Lên đầu trang"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'arrow-up', size: 'em' %}</i></a>
  {% endif %}
</footer>
