{%- comment -%}
  section_expert_team.bwt — khối "Đội ngũ chuyên gia" trên trang chủ (Home Portal v3).
  2026-10-03: người dùng chốt bật khối này (đưa vào valid_sections của home_portal.bwt, đặt ở chương
  II "Tin cậy" ngay sau Minh chứng). Viết lại theo khung v3 dùng chung (wrap / section-head / eyebrow,
  lưới .proof + thẻ .pcase của section_testimonials) thay cho markup Tailwind cũ để không lệch giao
  diện với các section xung quanh. Dữ liệu: blog chuyên gia (settings.expert_blog_handle), trường
  phụ qua snippets/expert_fields.bwt. Blog trống → không render. Lưới 3 cột → hiện 3 chuyên gia.
{%- endcomment -%}
{%- assign pc_ex_blog_handle = settings.expert_blog_handle | default: 'chuyen-gia' -%}
{%- assign pc_ex_blog = blogs[pc_ex_blog_handle] -%}
{%- if pc_ex_blog.articles.size > 0 -%}
{%- assign pc_ex_flagship = settings.expert_flagship_handle | default: '' | strip -%}
{%- assign pc_ex_first = pc_ex_blog.articles | first -%}
{%- if pc_ex_flagship == blank and pc_ex_first -%}{%- assign pc_ex_flagship = pc_ex_first.url | split: '/' | last -%}{%- endif -%}
<section class="pc-expert-team"><div class="wrap">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ settings.home_expert_eyebrow | default: 'Hội đồng chuyên môn' | escape }}</p>
      <h2>{{ settings.home_expert_title | default: 'Đội ngũ chuyên gia da liễu' | escape }}</h2>
    </div>
    {%- if settings.home_expert_subtitle != blank -%}<p class="lead">{{ settings.home_expert_subtitle | escape }}</p>{%- endif -%}
  </div>
  <div class="proof">
    {% for pc_ex in pc_ex_blog.articles limit: 3 %}
    {%- include 'expert_fields' -%}
    <article class="pcase">
      <div class="imgs">
        <div class="swiper-slide">
          <img src="{% if pc_ex.image.src != blank %}{{ pc_ex.image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ pc_ex.title | escape }}" width="540" height="540" loading="lazy">
        </div>
      </div>
      <div class="body">
        <h3>{{ pc_ex.title | escape }}</h3>
        {%- if pc_ex_title != blank or pc_ex_specialty != blank -%}
        <p>{{ pc_ex_title | escape }}{% if pc_ex_title != blank and pc_ex_specialty != blank %} — {% endif %}{{ pc_ex_specialty | escape }}</p>
        {%- endif -%}
        <div class="meta">
          <a href="{% if pc_ex_handle == pc_ex_flagship %}/chuyen-gia-detail{% else %}{{ pc_ex.url }}{% endif %}">Xem hồ sơ</a>
          {%- if pc_ex_years != blank -%}<b>{{ pc_ex_years }}+ năm kinh nghiệm</b>{%- endif -%}
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
  <p class="pc-expert-team__more"><a class="link-more" href="/chuyen-gia">{{ settings.home_expert_viewall | default: 'Xem tất cả chuyên gia' | escape }} →</a></p>
</div></section>
{%- endif -%}
