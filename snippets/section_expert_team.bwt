{%- comment -%}
  section_expert_team.bwt — khối "Đội ngũ chuyên gia" trên trang chủ (Home Portal).
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
  Đầu section: ui_section_head. Mobile trượt bằng Swiper (pc_swiper_boot), desktop lưới 3 cột.
{%- endcomment -%}
{%- assign pc_ex_blog_handle = settings.expert_blog_handle | default: 'chuyen-gia' -%}
{%- assign pc_ex_blog = blogs[pc_ex_blog_handle] -%}
{%- if pc_ex_blog.articles.size > 0 -%}
{%- assign pc_ex_flagship = settings.expert_flagship_handle | default: '' | strip -%}
{%- assign pc_ex_first = pc_ex_blog.articles | first -%}
{%- if pc_ex_flagship == blank and pc_ex_first -%}{%- assign pc_ex_flagship = pc_ex_first.url | split: '/' | last -%}{%- endif -%}
{%- assign pc_ex_title = settings.home_expert_title | default: 'Đội ngũ chuyên gia da liễu' | escape -%}
{%- assign pc_ex_eyebrow = settings.home_expert_eyebrow | default: 'Hội đồng chuyên môn' | escape -%}
{%- assign pc_ex_desc = settings.home_expert_subtitle | escape -%}
{%- assign pc_ex_viewall = settings.home_expert_viewall | default: 'Xem tất cả chuyên gia' | escape -%}
<section class="bg-surface-soft py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-expert-title">
  <div class="container">
    {%- include 'ui_section_head', title: pc_ex_title, title_id: 'section-expert-title', eyebrow: pc_ex_eyebrow, desc: pc_ex_desc, url: '/chuyen-gia-1', more_text: pc_ex_viewall, label: pc_ex_viewall, wrap_class: 'mb-6 lg:mb-8' -%}
    <div class="swiper-container overflow-hidden lg:overflow-visible" data-pc-slider data-gap="16" data-desktop-off>
      <div class="swiper-wrapper lg:grid lg:grid-cols-3 lg:gap-6">
        {% for pc_ex in pc_ex_blog.articles limit: 9 %}
        {%- include 'expert_fields' -%}
        <article class="swiper-slide flex !h-auto !w-72 lg:!w-auto flex-col rounded-2xl border border-solid border-line-soft bg-white p-4 shadow-none">
          <div class="aspect-square w-full overflow-hidden rounded-xl bg-surface-soft mb-3">
            <img class="h-full w-full object-cover" src="{% if pc_ex.image.src != blank %}{{ pc_ex.image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}" alt="{{ pc_ex.title | escape }}" width="540" height="540" loading="lazy">
          </div>
          <div class="flex flex-1 flex-col justify-between">
            <div>
              <h3 class="m-0 text-base font-bold text-brand-deep">{{ pc_ex.title | escape }}</h3>
              {%- if pc_ex_title != blank or pc_ex_specialty != blank -%}
              <p class="m-0 mt-1 text-xs text-ink-muted leading-relaxed">{{ pc_ex_title | escape }}{% if pc_ex_title != blank and pc_ex_specialty != blank %} — {% endif %}{{ pc_ex_specialty | escape }}</p>
              {%- endif -%}
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-solid border-line-soft pt-2 text-xs">
              <a class="inline-flex min-h-[44px] items-center font-semibold text-primary no-underline hover:underline" href="{% if pc_ex_handle == pc_ex_flagship %}/chuyen-gia-detail{% else %}{{ pc_ex.url }}{% endif %}">Xem hồ sơ</a>
              {%- if pc_ex_years != blank -%}<span class="font-medium text-ink-secondary">{{ pc_ex_years }}+ năm kinh nghiệm</span>{%- endif -%}
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{%- include 'pc_swiper_boot' -%}
{%- endif -%}
