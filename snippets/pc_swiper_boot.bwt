{%- comment -%}
  pc_swiper_boot.bwt — 17/11/2026 (M-01/04/08/13/15/17/22): khởi tạo Swiper dùng chung cho danh sách ngang trên mobile, nạp 1 lần / trang
  (như home_tabs_script). Không thanh cuộn, vuốt tự do, lộ một phần mục kế tiếp (slidesPerView auto).
  Markup: <div class="swiper-container overflow-hidden" data-pc-slider data-gap="12" data-desktop-off> <ul class="swiper-wrapper"> <li class="swiper-slide !w-auto"> …
    · data-gap (px, mặc định 12) · data-desktop-off ⇒ từ ≥ 1024px huỷ Swiper (desktop dùng lưới/cột của chính markup).
    · Có [role=tab] trong slider ⇒ tab được chọn / focus tự trượt vào vùng nhìn thấy (WAI-ARIA tabs).
  Không có style tĩnh hay CSS riêng; Swiper tự ghi transform lúc chạy.
{%- endcomment -%}
<script>
(function () {
  if (window.pcSliderBoot) return;
  window.pcSliderBoot = true;
  var mq = window.matchMedia ? window.matchMedia('(min-width: 1024px)') : { matches: false };
  function build(el) {
    if (el.swiper || typeof Swiper !== 'function') return;
    var gap = parseInt(el.getAttribute('data-gap'), 10);
    var sw = new Swiper(el, { slidesPerView: 'auto', spaceBetween: isNaN(gap) ? 12 : gap, freeMode: true, watchOverflow: true, observer: true, observeParents: true });
    var tabs = el.querySelectorAll('[role="tab"]');
    Array.prototype.forEach.call(tabs, function (t) {
      var go = function () { var s = t.closest('.swiper-slide'); if (s && el.swiper) el.swiper.slideTo(Array.prototype.indexOf.call(s.parentNode.children, s)); };
      t.addEventListener('click', go);
      t.addEventListener('focus', go);
    });
    return sw;
  }
  function sync() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-pc-slider]'), function (el) {
      var off = el.hasAttribute('data-desktop-off') && mq.matches;
      if (off && el.swiper) el.swiper.destroy(true, true);
      else if (!off) build(el);
    });
  }
  window.pcSliderSync = function () { sync(); Array.prototype.forEach.call(document.querySelectorAll('[data-pc-slider]'), function (el) { if (el.swiper) el.swiper.update(); }); }; /* gọi lại sau khi JS chèn thêm mục */
  function run() { if (typeof Swiper !== 'function') { window.addEventListener('load', sync); return; } sync(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  if (mq.addEventListener) mq.addEventListener('change', sync);
})();
</script>
