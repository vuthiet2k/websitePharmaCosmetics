{%- comment -%}
  pc_swiper_boot.bwt — 17/11/2026 (M-01/04/08/13/15/17/22, T-18, T-19):
  Khởi tạo Swiper dùng chung cho:
    1. Danh sách ngang mobile [data-pc-slider] (slidesPerView: 'auto', data-desktop-off)
    2. Khối thương hiệu 2 hàng [data-pc-brand-slider] (T-18: continuous ticker loop, hover pause, reverseDirection)
    3. Khối Reels Trước & Sau [data-reels-swiper] (T-19: slidesPerView: 'auto', navigation Next/Prev)
  Nạp 1 lần / trang. Không có style tĩnh hay CSS riêng.
{%- endcomment -%}
<script>
(function () {
  if (window.pcSliderBoot) return;
  window.pcSliderBoot = true;
  var mq = window.matchMedia ? window.matchMedia('(min-width: 1024px)') : { matches: false };

  function build(el) {
    if (el.swiper || typeof Swiper !== 'function') return;
    var gap = parseInt(el.getAttribute('data-gap'), 10);
    var sw = new Swiper(el, { slidesPerView: 'auto', spaceBetween: isNaN(gap) ? 12 : gap, freeMode: true, watchOverflow: true, observer: true, observeParents: true });
    var tabs = el.querySelectorAll('[role="tab"]');
    Array.prototype.forEach.call(tabs, function (t) {
      var go = function () { var s = t.closest('.swiper-slide'); if (s && el.swiper) el.swiper.slideTo(Array.prototype.indexOf.call(s.parentNode.children, s)); };
      t.addEventListener('click', go);
      t.addEventListener('focus', go);
    });
    return sw;
  }

  function buildBrandSlider(el) {
    if (el.swiper || typeof Swiper !== 'function') return;
    var isReverse = el.getAttribute('data-direction') === 'reverse';
    var speed = parseInt(el.getAttribute('data-speed'), 10) || 5000;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var sw = new Swiper(el, {
      slidesPerView: 'auto',
      spaceBetween: 16,
      loop: true,
      speed: speed,
      autoplay: reduceMotion ? false : {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
        reverseDirection: isReverse
      },
      observer: true,
      observeParents: true
    });
    el.addEventListener('focusin', function () {
      if (sw.autoplay && sw.autoplay.running) sw.autoplay.stop();
    });
    el.addEventListener('focusout', function () {
      if (!reduceMotion && sw.autoplay && !sw.autoplay.running) sw.autoplay.start();
    });
    return sw;
  }

  function buildReelsSlider(el) {
    if (el.swiper || typeof Swiper !== 'function') return;
    var p = el.parentElement || el;
    var nextEl = p.querySelector('[data-reels-next]');
    var prevEl = p.querySelector('[data-reels-prev]');
    var sw = new Swiper(el, {
      slidesPerView: 'auto',
      spaceBetween: 16,
      watchOverflow: true,
      observer: true,
      observeParents: true,
      navigation: (nextEl && prevEl) ? {
        nextEl: nextEl,
        prevEl: prevEl
      } : false
    });
    return sw;
  }

  function sync() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-pc-slider]'), function (el) {
      var off = el.hasAttribute('data-desktop-off') && mq.matches;
      if (off && el.swiper) el.swiper.destroy(true, true);
      else if (!off) build(el);
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-pc-brand-slider]'), function (el) {
      buildBrandSlider(el);
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-reels-swiper]'), function (el) {
      buildReelsSlider(el);
    });
  }

  window.buildBrandSlider = buildBrandSlider;
  window.buildReelsSlider = buildReelsSlider;
  window.pcSliderSync = function () {
    sync();
    Array.prototype.forEach.call(document.querySelectorAll('[data-pc-slider], [data-pc-brand-slider], [data-reels-swiper]'), function (el) {
      if (el.swiper) el.swiper.update();
    });
  };

  function run() {
    if (typeof Swiper !== 'function') {
      window.addEventListener('load', sync);
      return;
    }
    sync();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  if (mq.addEventListener) mq.addEventListener('change', sync);
})();
</script>
