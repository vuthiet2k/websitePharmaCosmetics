{%- when 'droplet-slash' -%}{%- assign pc_icon_name = 'droplet-off' -%}
{%- when 'face-smile' -%}{%- assign pc_icon_name = 'smile' -%}
{%- when 'file-lines' -%}{%- assign pc_icon_name = 'file-text' -%}
{%- when 'shield-halved' -%}{%- assign pc_icon_name = 'shield-half' -%}
{%- when 'share' -%}{%- assign pc_icon_name = 'forward' -%}
{%- when 'bolt' -%}{%- assign pc_icon_name = 'zap' -%}
{%- when 'money-bill' -%}{%- assign pc_icon_name = 'banknote' -%}
