{%- if pc_icon_paths == blank -%}<!-- PC-ERROR ui_icon: name "{{ pc_icon_raw }}" không có trong bộ icon -->
{%- elsif pc_icon_mode == 'defs' -%}<symbol id="pc-i-{{ pc_icon_name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ pc_icon_paths }}</symbol>
{%- elsif pc_icon_bad -%}<!-- PC-ERROR ui_icon: size "{{ pc_icon_s }}" không hợp lệ -->
{%- elsif pc_icon_mode == 'use' -%}
<svg class="shrink-0" width="{{ pc_icon_size }}" height="{{ pc_icon_size }}"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true"{% endif %}><use href="#pc-i-{{ pc_icon_name }}"/></svg>
{%- else -%}
<svg xmlns="http://www.w3.org/2000/svg" class="shrink-0" width="{{ pc_icon_size }}" height="{{ pc_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ pc_icon_paths }}</svg>
{%- endif -%}
{%- endfor -%}
{%- if pc_icon_mode == 'defs' -%}</svg>{%- endif -%}
{%- endif -%}
