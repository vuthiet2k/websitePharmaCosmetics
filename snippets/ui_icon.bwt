{%- when 'circle-exclamation' -%}{%- assign pc_icon_name = 'circle-alert' -%}
{%- when 'triangle-exclamation' -%}{%- assign pc_icon_name = 'triangle-alert' -%}
{%- when 'angle-down' -%}{%- assign pc_icon_name = 'chevron-down' -%}
{%- when 'angle-right' -%}{%- assign pc_icon_name = 'chevron-right' -%}
{%- when 'angle-left' -%}{%- assign pc_icon_name = 'chevron-left' -%}
{%- when 'home' -%}{%- assign pc_icon_name = 'house' -%}
{%- when 'rotate-right' -%}{%- assign pc_icon_name = 'rotate-cw' -%}
{%- when 'face-frown-open' -%}{%- assign pc_icon_name = 'frown' -%}
{%- when 'hourglass-half' -%}{%- assign pc_icon_name = 'hourglass' -%}
