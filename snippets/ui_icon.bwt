{%- comment -%}
  snippets/ui_icon.bwt — THƯ VIỆN PC (KHOÁ sau đợt 0, R5). Icon SVG nội tuyến, path chép từ Lucide (ISC/MIT).
  Tham số: name (bắt buộc), size = 20 | 24 (mặc định 20), label (có ⇒ role="img" + aria-label; trống ⇒ aria-hidden, trang trí).
  D04 (24/10/2026): bộ icon tối thiểu cho thư viện (slider, popup, nút nổi, thẻ SP, lỗi form); D07 bổ sung icon header/footer/form.
  Màu theo currentColor (đặt màu bằng class của phần tử cha). Tên sai ⇒ chỉ in PC-ERROR.
{%- endcomment -%}
{%- comment -%} Preview LiquidJS: `size` không truyền đọc ra SỐ khoá của scope (Sapo/DotLiquid ra nil) ⇒ số khác 24 coi như mặc định 20;
  chỉ chuỗi không phải số (vd 'lon') mới là tham số sai. {%- endcomment -%}
{%- assign pc_icon_s = size | append: '' -%}{%- assign pc_icon_n = size | plus: 0 | append: '' -%}
{%- assign pc_icon_size = 20 -%}{%- assign pc_icon_bad = false -%}
{%- if pc_icon_s == '24' -%}{%- assign pc_icon_size = 24 -%}
{%- elsif pc_icon_s != blank and pc_icon_s != '20' and pc_icon_s != pc_icon_n -%}{%- assign pc_icon_bad = true -%}
{%- endif -%}
{%- capture pc_icon_paths -%}
{%- case name -%}
{%- when 'chevron-left' -%}<path d="m15 18-6-6 6-6"/>
{%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
{%- when 'x' -%}<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
{%- when 'message-circle' -%}<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
{%- when 'shopping-cart' -%}<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
{%- when 'circle-alert' -%}<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
{%- when 'star' -%}<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
{%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
{%- endcase -%}
{%- endcapture -%}
{%- if name == blank -%}<!-- PC-ERROR ui_icon: thiếu name -->
{%- elsif pc_icon_paths == blank -%}<!-- PC-ERROR ui_icon: name "{{ name }}" không có trong bộ icon -->
{%- elsif pc_icon_bad -%}<!-- PC-ERROR ui_icon: size "{{ pc_icon_s }}" không hợp lệ -->
{%- else -%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ pc_icon_size }}" height="{{ pc_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ pc_icon_paths }}</svg>
{%- endif -%}
