{%- comment -%}
  snippets/ui_icon.bwt — THƯ VIỆN PC (KHOÁ sau đợt 0, R5). Icon SVG nội tuyến, path chép từ Lucide (ISC/MIT).
  Tham số: name (bắt buộc), size = 20 | 24 (mặc định 20), label (có ⇒ role="img" + aria-label; trống ⇒ aria-hidden, trang trí).
  D04 (24/10/2026): bộ icon tối thiểu cho thư viện (slider, popup, nút nổi, thẻ SP, lỗi form); D07 (24/10/2026) bổ sung 35 icon
  đang dùng (bằng Font Awesome) ở header / topbar / thanh đáy / footer / thẻ SP / trang form — tên FA cũ ghi trong comment từng nhóm.
  Màu theo currentColor (đặt màu bằng class của phần tử cha). Tên sai ⇒ chỉ in PC-ERROR.
{%- endcomment -%}
{%- comment -%} Preview LiquidJS: `size` không truyền đọc ra SỐ khoá của scope (Sapo/DotLiquid ra nil) ⇒ số khác 24 coi như mặc định 20;
  chỉ chuỗi không phải số (vd 'lon') mới là tham số sai. {%- endcomment -%}
{%- assign pc_icon_s = size | append: '' -%}{%- assign pc_icon_n = size | plus: 0 | append: '' -%}
{%- assign pc_icon_size = 20 -%}{%- assign pc_icon_bad = false -%}
{%- if pc_icon_s == '24' -%}{%- assign pc_icon_size = 24 -%}
{%- elsif pc_icon_s != blank and pc_icon_s != '20' and pc_icon_s != pc_icon_n -%}{%- assign pc_icon_bad = true -%}
{%- endif -%}
{%- capture pc_icon_paths -%}
{%- case name -%}
{%- when 'chevron-left' -%}<path d="m15 18-6-6 6-6"/>
{%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
{%- when 'x' -%}<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
{%- when 'message-circle' -%}<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
{%- when 'shopping-cart' -%}<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
{%- when 'circle-alert' -%}<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
{%- when 'star' -%}<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
{%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
{%- comment -%} D07 — header / topbar / thanh đáy (FA cũ → tên ui_icon): chevron-down, phone, user, bars → menu,
  magnifying-glass → search, ticket, clock-rotate-left → history, arrow-trend-up → trending-up, store, heart, house,
  bag-shopping → shopping-bag, newspaper {%- endcomment -%}
{%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
{%- when 'phone' -%}<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
{%- when 'user' -%}<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
{%- when 'menu' -%}<line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
{%- when 'search' -%}<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
{%- when 'ticket' -%}<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>
{%- when 'history' -%}<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>
{%- when 'trending-up' -%}<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
{%- when 'store' -%}<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/>
{%- when 'heart' -%}<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
{%- when 'house' -%}<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
{%- when 'shopping-bag' -%}<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
{%- when 'newspaper' -%}<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
{%- comment -%} D07 — footer: location-dot → map-pin, envelope → mail, instagram, facebook-f → facebook, tiktok, whatsapp,
  cube → box, arrow-up. tiktok / whatsapp: Lucide không có ⇒ path Tabler Icons (MIT, cùng lưới 24 nét 2). {%- endcomment -%}
{%- when 'map-pin' -%}<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
{%- when 'mail' -%}<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
{%- when 'instagram' -%}<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
{%- when 'facebook' -%}<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
{%- when 'tiktok' -%}<path d="M21 7.917v4.034a9.948 9.948 0 0 1-5-1.951v4.5a6.5 6.5 0 1 1-8-6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z"/>
{%- when 'whatsapp' -%}<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>
{%- when 'box' -%}<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
{%- when 'arrow-up' -%}<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>
{%- comment -%} D07 — thẻ SP: eye, ban, truck-fast → truck (heart, star, cart, ticket ở trên) {%- endcomment -%}
{%- when 'eye' -%}<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>
{%- when 'ban' -%}<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>
{%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
{%- comment -%} D07 — trang form (đại lý B2B, tra cứu đơn, giới thiệu / liên hệ, tra cứu hoạt chất): handshake, arrow-right,
  question → circle-help, leaf, calendar-check, user-doctor → stethoscope, clock, comments → messages-square, circle-check,
  circle-exclamation → circle-alert (ở trên), microscope, triangle-exclamation → triangle-alert {%- endcomment -%}
{%- when 'handshake' -%}<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>
{%- when 'arrow-right' -%}<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
{%- when 'circle-help' -%}<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
{%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
{%- when 'calendar-check' -%}<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>
{%- when 'stethoscope' -%}<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>
{%- when 'clock' -%}<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
{%- when 'messages-square' -%}<path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/>
{%- when 'circle-check' -%}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
{%- when 'microscope' -%}<path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>
{%- when 'triangle-alert' -%}<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>
{%- endcase -%}
{%- endcapture -%}
{%- if name == blank -%}<!-- PC-ERROR ui_icon: thiếu name -->
{%- elsif pc_icon_paths == blank -%}<!-- PC-ERROR ui_icon: name "{{ name }}" không có trong bộ icon -->
{%- elsif pc_icon_bad -%}<!-- PC-ERROR ui_icon: size "{{ pc_icon_s }}" không hợp lệ -->
{%- else -%}
<svg xmlns="http://www.w3.org/2000/svg" class="shrink-0" width="{{ pc_icon_size }}" height="{{ pc_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ pc_icon_paths }}</svg>
{%- endif -%}
