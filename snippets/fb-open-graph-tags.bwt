{% if template contains 'product' %}
	<meta property="og:type" content="product">
	<meta property="og:title" content="{{ product.name | strip_html}}">
	{% for image in product.images limit:3 %}
		<meta property="og:image" content="https:{{ image.src | img_url: 'grande' }}">
		<meta property="og:image:secure_url" content="https:{{ image.src | img_url: 'grande' }}">
	{% endfor %}
	{%- comment -%} 2026-10-05 (PDP V3): sản phẩm kê toa không công bố giá. {%- endcomment -%}
	{%- include 'pc_is_rx' -%}
	{%- unless pc_is_rx %}
	<meta property="og:price:amount" content="{{ product.price | money_without_currency }}">
	<meta property="og:price:currency" content="{{ store.currency }}">
	{%- endunless %}
{% elsif template contains 'article' %}
	<meta property="og:type" content="article">
	<meta property="og:title" content="{{ article.title | strip_html | escape }}">
  	{% assign img_tag = '<' | append: 'img' %}
	{% if article.image.src %}
		<meta property="og:image" content="https:{{ article.image.src | img_url: 'grande' }}">
		<meta property="og:image:secure_url" content="https:{{ article.image.src | img_url: 'grande' }}">
	{% else %}
		{% if article.content contains img_tag %}
			{% assign src = article.content | split: 'src="' %}
			{% assign src = src[1] | split: '"' | first | remove: 'https:' | remove: 'http:' %}
			{% if src %}
				<meta property="og:image" content="https:{{ src }}">
				<meta property="og:image:secure_url" content="https:{{ src }}">
			{% endif %}
		{% endif %}
	{% endif %}
{% else %}
	<meta property="og:type" content="website">
	<meta property="og:title" content="{{ page_title }}">
	{%- comment -%} 2026-10-03: ảnh chia sẻ mặc định cấu hình ở Section "SEO" (seo_og_image_default); để trống thì giữ logo_share.png. {%- endcomment -%}
	{%- if settings.seo_og_image_default != blank -%}
		{%- assign pc_og_default = settings.seo_og_image_default | img_url: 'grande' | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
	{%- else -%}
		{%- assign pc_og_default = 'logo_share.png' | asset_url | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
	{%- endif -%}
	<meta property="og:image" content="{{ pc_og_default }}">
	<meta property="og:image:secure_url" content="{{ pc_og_default }}">
{% endif %}
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ store.name }}">