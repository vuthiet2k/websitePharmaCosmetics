{%- comment -%}
  snippets/ui_badge.bwt — THƯ VIỆN PC (KHOÁ sau đợt 0, R5). Nhãn (C.2 #5).
  Tham số: text (bắt buộc — nhãn luôn có chữ, không truyền thông tin chỉ bằng màu), tone = brand | sale | warning | neutral (mặc định brand).
{%- endcomment -%}
{%- assign pc_bg_tone = tone | default: 'brand' -%}
{%- if pc_bg_tone != 'brand' and pc_bg_tone != 'sale' and pc_bg_tone != 'warning' and pc_bg_tone != 'neutral' -%}<!-- PC-ERROR ui_badge: tone "{{ pc_bg_tone }}" không hợp lệ -->
{%- elsif text == blank -%}<!-- PC-ERROR ui_badge: thiếu text -->
{%- else -%}
{%- comment -%} Tên class ghi nguyên văn để Tailwind sinh CSS (không ghép pc-badge--+biến). {%- endcomment -%}
{%- case pc_bg_tone -%}{%- when 'sale' -%}{%- assign pc_bg_c = 'pc-badge--sale' -%}{%- when 'warning' -%}{%- assign pc_bg_c = 'pc-badge--warning' -%}{%- when 'neutral' -%}{%- assign pc_bg_c = 'pc-badge--neutral' -%}{%- else -%}{%- assign pc_bg_c = 'pc-badge--brand' -%}{%- endcase -%}
<span class="pc-badge {{ pc_bg_c }}">{{ text | escape }}</span>
{%- endif -%}
