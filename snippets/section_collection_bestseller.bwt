{%- comment -%}
  Best Seller in this Collection — đặt cuối trang collection.bwt
  Logic: lọc collection.products theo tag 'ban-chay'. Nếu < 4 SP có tag → fallback
  sang top 8 SP đầu tiên theo default_sort_by của collection.
{%- endcomment -%}

{%- assign _bs_tag = settings.col_bestseller_tag | default: 'ban-chay' -%}
{%- assign _bs_col_handle = settings.col_bestseller_col -%}
{%- if _bs_col_handle != blank and _bs_col_handle != 'none' -%}
  {%- assign _bs_products = collections[_bs_col_handle].products -%}
  {%- assign _bs_total    = collections[_bs_col_handle].products_count -%}
  {%- assign _bs_url      = collections[_bs_col_handle].url -%}
{%- else -%}
  {%- assign _bs_products = collection.products -%}
  {%- assign _bs_total    = collection.products_count -%}
  {%- assign _bs_url      = collection.url -%}
{%- endif -%}
{%- assign _best_count = 0 -%}
{%- for p in _bs_products limit: 50 -%}
  {%- if p.tags contains _bs_tag -%}
    {%- assign _best_count = _best_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if _bs_total >= 4 -%}
{%- comment -%} 18/11/2026 (PO, M-11): dùng chung ui_section_head (Xem tất cả = nút tròn icon, hiện cả mobile) + ui_product_card cho MỌI slide; 100% Tailwind, bỏ <style> và class pc-*; Swiper khởi tạo như khối Flash sale. {%- endcomment -%}
{%- assign pc_bs_title = settings.col_bestseller_title | default: 'Khách hàng yêu thích trong danh mục này' | escape -%}
{%- assign pc_bs_eyebrow = settings.col_bestseller_eyebrow | default: 'Bán chạy nhất' | escape -%}
{%- assign pc_bs_viewall = settings.col_bestseller_viewall | default: 'Xem tất cả' | escape -%}
{%- capture pc_bs_url -%}{{ _bs_url }}?sortby=best-selling{%- endcapture -%}
<section id="col-bestseller" class="overflow-hidden bg-surface-soft py-10 font-sans text-ink lg:py-16" aria-labelledby="section-col-bestseller-title">
  <div class="container">
    {%- include 'ui_section_head', title: pc_bs_title, title_id: 'section-col-bestseller-title', eyebrow: pc_bs_eyebrow, url: pc_bs_url, more_text: pc_bs_viewall, label: pc_bs_viewall, wrap_class: 'mb-4 lg:mb-8' -%}

    <div class="relative">
      <div class="swiper-container overflow-hidden" id="col-bestseller-swiper">
        <div class="swiper-wrapper">
          {%- assign _rendered = 0 -%}
          {%- if _best_count >= 4 -%}
            {%- for product in _bs_products limit: 50 -%}
              {%- if product.tags contains _bs_tag and _rendered < 8 -%}
              <div class="swiper-slide !h-auto">{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}</div>
              {%- assign _rendered = _rendered | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for product in _bs_products limit: 8 -%}
            <div class="swiper-slide !h-auto">{%- include 'ui_product_card', product: product, tone: '', eager: false, wish: false -%}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <button type="button" class="col-bestseller-prev max-md:hidden md:inline-flex absolute -left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 min-h-[44px] min-w-[44px] rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm trước">{% include 'ui_icon', name: 'chevron-left', size: '18' %}</button>
      <button type="button" class="col-bestseller-next max-md:hidden md:inline-flex absolute -right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 min-h-[44px] min-w-[44px] rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm tiếp theo">{% include 'ui_icon', name: 'chevron-right', size: '18' %}</button>
    </div>
  </div>
</section>

<script>
(function () {
  function initColBestseller() {
    var el = document.getElementById('col-bestseller-swiper');
    if (!el || el.swiper) return;
    if (typeof Swiper !== 'function') { window.addEventListener('load', initColBestseller); return; }
    new Swiper(el, {
      slidesPerView: 2.2,
      spaceBetween: 12,
      watchOverflow: true,
      navigation: { prevEl: '.col-bestseller-prev', nextEl: '.col-bestseller-next' },
      breakpoints: { 640: { slidesPerView: 3, spaceBetween: 16 }, 768: { slidesPerView: 4, spaceBetween: 16 }, 1024: { slidesPerView: 5, spaceBetween: 16 } }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initColBestseller); else initColBestseller();
})();
</script>
{%- endif -%}
