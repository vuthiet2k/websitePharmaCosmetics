{%- comment -%}
  Best Seller in this Collection — đặt cuối trang collection.bwt
  Logic: lọc collection.products theo tag 'ban-chay'. Nếu < 4 SP có tag → fallback
  sang top 8 SP đầu tiên theo default_sort_by của collection.
{%- endcomment -%}

{%- assign _bs_tag = settings.col_bestseller_tag | default: 'ban-chay' -%}
{%- assign _bs_col_handle = settings.col_bestseller_col -%}
{%- if _bs_col_handle != blank and _bs_col_handle != 'none' -%}
  {%- assign _bs_products = collections[_bs_col_handle].products -%}
  {%- assign _bs_total    = collections[_bs_col_handle].products_count -%}
  {%- assign _bs_url      = collections[_bs_col_handle].url -%}
{%- else -%}
  {%- assign _bs_products = collection.products -%}
  {%- assign _bs_total    = collection.products_count -%}
  {%- assign _bs_url      = collection.url -%}
{%- endif -%}
{%- assign _best_count = 0 -%}
{%- for p in _bs_products limit: 50 -%}
  {%- if p.tags contains _bs_tag -%}
    {%- assign _best_count = _best_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if _bs_total >= 4 -%}
<section class="pc-section section--subtle pc-col-bestseller">
  <div class="container">

    <div class="pc-featured__header">
      <div class="pc-section-header pc-section-header--left">
        <p class="pc-section-eyebrow">{{ settings.col_bestseller_eyebrow | default: 'Bán chạy nhất' }}</p>
        <h2 class="pc-section-title">
          {{ settings.col_bestseller_title | default: 'Khách hàng yêu thích trong danh mục này' }}
        </h2>
      </div>
      <a href="{{ _bs_url }}?sortby=best-selling"
         class="pc-featured__viewall sm-hidden"
         title="{{ settings.col_bestseller_viewall | default: 'Xem tất cả' }}">
        {{ settings.col_bestseller_viewall | default: 'Xem tất cả' }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="m22.707 11.293-7-7a1 1 0 0 0-1.414 1.414l5.293 5.293H2a1 1 0 0 0 0 2h17.586l-5.293 5.293a1 1 0 1 0 1.414 1.414l7-7a1 1 0 0 0 0-1.414z" fill="currentColor"/>
        </svg>
      </a>
    </div>

    <div class="pc-col-bestseller__swiper swiper_col_bestseller swiper-container">
      <div class="swiper-wrapper load-after" data-section="section_col_bestseller">
        {%- for i in (1..4) -%}
        <div class="swiper-slide item_null">
          <div class="item_product_main"></div>
        </div>
        {%- endfor -%}

        {%- assign _bs_html = '' -%}
        {%- assign _rendered = 0 -%}
        {%- if _best_count >= 4 -%}
          {%- for product in _bs_products limit: 50 -%}
            {%- if product.tags contains _bs_tag and _rendered < 8 -%}
              {%- capture _bs_block -%}
              <div class="swiper-slide">
                <div class="item_product_main">
                  {%- include 'product_grid_office_sale' -%}
                </div>
              </div>
              {%- endcapture -%}
              {%- assign _bs_html = _bs_html | append: _bs_block -%}
              {%- assign _rendered = _rendered | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in _bs_products limit: 8 -%}
          {%- capture _bs_block -%}
          <div class="swiper-slide">
            <div class="item_product_main">
              {%- include 'product_grid_office_sale' -%}
            </div>
          </div>
          {%- endcapture -%}
          {%- assign _bs_html = _bs_html | append: _bs_block -%}
          {%- endfor -%}
        {%- endif -%}
        <script type="text/x-custom-template" data-template="section_col_bestseller">
          {{ _bs_html }}
        </script>
      </div>

      <div class="swiper-button-prev pc-featured__prev">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="swiper-button-next pc-featured__next">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="swiper-pagination pc-col-bestseller__pagination"></div>
    </div>

    <div class="pc-featured__footer md-hidden">
      <a href="{{ _bs_url }}?sortby=best-selling" class="pc-featured__viewall-mobile">
        {{ settings.col_bestseller_viewall | default: 'Xem tất cả' }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="m22.707 11.293-7-7a1 1 0 0 0-1.414 1.414l5.293 5.293H2a1 1 0 0 0 0 2h17.586l-5.293 5.293a1 1 0 1 0 1.414 1.414l7-7a1 1 0 0 0 0-1.414z" fill="currentColor"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
/* ── Section Collection Bestseller ── */
.pc-col-bestseller {
  overflow: hidden;
  margin-top: 0;
}

/* Header: title trái + link "xem tất cả" phải — dùng chung .pc-featured__header */
.pc-col-bestseller .pc-featured__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 32px;
}
.pc-col-bestseller .pc-featured__header .pc-section-header {
  margin-bottom: 0;
}
.pc-col-bestseller .pc-featured__header .pc-section-title {
  margin-bottom: 4px;
}

/* "Xem tất cả" — desktop */
.pc-col-bestseller .pc-featured__viewall {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-primary);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--mainColorDark);
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 1.5px solid var(--mainColorDark);
  padding-bottom: 2px;
  transition: color .2s, border-color .2s;
  flex-shrink: 0;
}
.pc-col-bestseller .pc-featured__viewall:hover {
  color: var(--mainColor);
  border-color: var(--mainColor);
}

/* Swiper wrapper */
.pc-col-bestseller__swiper {
  overflow: hidden;
  padding-bottom: 40px;
}

/* Navigation buttons */
.pc-col-bestseller .pc-featured__prev,
.pc-col-bestseller .pc-featured__next {
  width: 40px;
  height: 40px;
  background: #fff;
  border: 1.5px solid var(--lineColor);
  border-radius: 50%;
  color: var(--mainColorDark);
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
  transition: background .2s, border-color .2s, color .2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-col-bestseller .pc-featured__prev::after,
.pc-col-bestseller .pc-featured__next::after { display: none; }
.pc-col-bestseller .pc-featured__prev:hover,
.pc-col-bestseller .pc-featured__next:hover {
  background: var(--mainColorDark);
  border-color: var(--mainColorDark);
  color: #fff;
}

/* Pagination dots */
.pc-col-bestseller__pagination {
  bottom: 8px !important;
}
.pc-col-bestseller__pagination .swiper-pagination-bullet {
  background: var(--lineColor);
  opacity: 1;
  width: 8px;
  height: 8px;
  transition: background .2s, width .2s;
}
.pc-col-bestseller__pagination .swiper-pagination-bullet-active {
  background: var(--mainColorDark);
  width: 24px;
  border-radius: 4px;
}

/* "Xem tất cả" — mobile */
.pc-col-bestseller .pc-featured__footer {
  text-align: center;
  margin-top: 8px;
}
.pc-col-bestseller .pc-featured__viewall-mobile {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-primary);
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--mainColorDark);
  text-decoration: none;
  transition: color .2s;
}
.pc-col-bestseller .pc-featured__viewall-mobile:hover {
  color: var(--mainColor);
}

/* Override card flash-sale colors trong context này */
.pc-col-bestseller .pc-btn--action {
  background: var(--mainColorDark);
}
.pc-col-bestseller .pc-btn--action:hover {
  background: var(--mainColor);
  transform: translateY(-1px);
}
.pc-col-bestseller .pc-btn--action--disabled:hover {
  transform: none;
}
/* E01 (phase home-shopping-ux, 2026-09-20): bỏ override xanh — badge % giảm giá dùng chung 1 màu
   đỏ (--flashsale-badge-bg) ở mọi nơi tái dùng .pc-flashsale__badge, theo yêu cầu người dùng. */
.pc-col-bestseller .pc-flashsale__progress {
  display: none;
}

@media (max-width: 767px) {
  .pc-col-bestseller .pc-featured__header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .pc-col-bestseller__swiper {
    padding-bottom: 48px;
  }
}
</style>

<script>
$(document).ready(function($) {
  var swiperBs = null;
  var _resizeTimer = null;

  function initSwiper() {
    swiperBs = new Swiper('.swiper_col_bestseller', {
      slidesPerView: 4,
      spaceBetween: 20,
      slidesPerGroup: 1,
      pagination: {
        el: '.swiper_col_bestseller .pc-col-bestseller__pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper_col_bestseller .pc-featured__next',
        prevEl: '.swiper_col_bestseller .pc-featured__prev',
      },
      breakpoints: {
        280: { slidesPerView: 1.4, spaceBetween: 12 },
        480: { slidesPerView: 2,   spaceBetween: 12 },
        768: { slidesPerView: 3,   spaceBetween: 16 },
        993: { slidesPerView: 4,   spaceBetween: 20 },
      }
    });
  }

  function destroySwiper() {
    if (swiperBs) { swiperBs.destroy(true, true); swiperBs = null; }
  }

  function afterInject() {
    awe_lazyloadImage();
    {%- if settings.quickview_enable -%}
    if (typeof runQuickView === 'function') runQuickView();
    {%- endif -%}
    {%- if settings.iwish_enable -%}
    if (typeof favoriBean !== 'undefined') favoriBean.Wishlist.activityWishlist();
    {%- endif -%}
    initSwiper();
    $(window).on('resize.colBestseller', function() {
      clearTimeout(_resizeTimer);
      _resizeTimer = setTimeout(function() { destroySwiper(); initSwiper(); }, 200);
    });
  }

  var $section = $('.pc-col-bestseller');
  if (!$section.length) return;
  var template = $('script[data-template="section_col_bestseller"]').html();
  if (!template) return;

  if (!('IntersectionObserver' in window)) {
    $('div[data-section="section_col_bestseller"]', $section).html(template);
    afterInject();
    return;
  }

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      $('div[data-section="section_col_bestseller"]', entry.target).html(template);
      observer.unobserve(entry.target);
      afterInject();
    });
  }, { rootMargin: '0px 0px -200px 0px' });

  observer.observe($section[0]);
});
</script>
{%- endif -%}
