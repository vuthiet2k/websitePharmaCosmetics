{%- comment -%}
  Soi da AI 2026-09-24: camera chạy trên thiết bị; ảnh gốc chỉ tồn tại trong RAM trình duyệt.
  Giao diện thiết kế mới chuẩn y khoa Pharma Cosmetics 2026 (Mockup PharmaCosmetics (1).svg).
  Cập nhật: Đưa khối Tải 3 ảnh & Phân tích xuống hàng riêng col-12 toàn chiều rộng; tích hợp Auto-Shutter.
  Nâng cấp 2026-09-25: Báo cáo kết quả phân tích toàn diện tại chỗ (Inline Dashboard) không chuyển trang,
  quét AI Deliberate có tiến trình trực quan, và kiểm định ảnh khuôn mặt nghiêm ngặt.
{%- endcomment -%}
<section class="pc-skin-scan" id="pcSkinScan" data-skin-scan data-skin-scan-enabled="{{ settings.ai_skin_scan_enable | default: true }}" data-skin-analysis-mode="{{ settings.ai_skin_scan_mode | default: 'client_edge' | escape }}" data-skin-deid-enabled="{{ settings.ai_skin_scan_deid_enable | default: true }}" data-skin-min-light="{{ settings.ai_skin_scan_min_light | default: '80' | escape }}" data-skin-model-url="{{ settings.ai_skin_scan_onnx_model_url | default: '' | escape }}" data-skin-model-sha256="{{ settings.ai_skin_scan_onnx_model_sha256 | default: '' | escape }}" hidden>
  
  <!-- HÀNG TRÊN: LƯỚI 2 CỘT (THÔNG TIN Y KHOA & KHUNG CAMERA VIEWFINDER) -->
  <div class="pc-skin-scan__layout">
    <!-- CỘT TRÁI: TIÊU ĐỀ & LỢI ÍCH Y KHOA -->
    <div class="pc-skin-scan__col-info">
      <div class="pc-skin-scan__intro">
        <p class="pc-skin-scan__eyebrow">{{ settings.ai_skin_scan_eyebrow | default: 'SOI DA THAM KHẢO TẠI THIẾT BỊ' | escape }}</p>
        <h2>{{ settings.ai_skin_scan_title | default: 'Phân tích ảnh 3 góc tại thiết bị' | escape }}</h2>
        <p class="pc-skin-scan__desc">{{ settings.ai_skin_scan_intro | default: 'Chụp chính diện, má trái và má phải. Khi chưa có model đã thẩm định, hệ thống chỉ chạy phép đo Canvas thử nghiệm. Kết quả mang tính tham khảo; ảnh xử lý trên thiết bị và không tự động lưu hoặc giữ dữ liệu.' | escape }}</p>
      </div>

      <!-- 3 Khối tính năng y khoa chuẩn Mockup -->
      <div class="pc-skin-features">
        <div class="pc-skin-feature-item">
          <div class="pc-skin-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
          </div>
          <div class="pc-skin-feature-text">
            <div class="pc-skin-feature-title">Chụp 3 góc khuôn mặt</div>
            <div class="pc-skin-feature-subtitle">Chính diện, má trái, má phải</div>
          </div>
        </div>

        <div class="pc-skin-feature-item">
          <div class="pc-skin-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <rect x="9" y="9" width="6" height="6" />
              <line x1="9" y1="1" x2="9" y2="4" /><line x1="15" y1="1" x2="15" y2="4" />
              <line x1="9" y1="20" x2="9" y2="23" /><line x1="15" y1="20" x2="15" y2="23" />
              <line x1="20" y1="9" x2="23" y2="9" /><line x1="20" y1="14" x2="23" y2="14" />
              <line x1="1" y1="9" x2="4" y2="9" /><line x1="1" y1="14" x2="4" y2="14" />
            </svg>
          </div>
          <div class="pc-skin-feature-text">
            <div class="pc-skin-feature-title">Phân tích bằng AI</div>
            <div class="pc-skin-feature-subtitle">Đánh giá tình trạng da</div>
          </div>
        </div>

        <div class="pc-skin-feature-item">
          <div class="pc-skin-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="pc-skin-feature-text">
            <div class="pc-skin-feature-title">Kết quả mang tính tham khảo</div>
            <div class="pc-skin-feature-subtitle">Không thay thế chẩn đoán y khoa</div>
          </div>
        </div>
      </div>

      <!-- Họa tiết lá cây thực vật góc trái dưới -->
      <div class="pc-skin-leaf-accent" aria-hidden="true">
        <svg width="84" height="84" viewBox="0 0 100 100" fill="none">
          <path d="M15 90 C 25 50, 60 20, 90 10 C 85 45, 55 75, 15 90 Z" fill="#267348" fill-opacity="0.14"/>
          <path d="M25 80 C 40 55, 65 35, 90 10" stroke="#267348" stroke-width="2" stroke-opacity="0.22" stroke-linecap="round"/>
          <path d="M45 60 C 35 55, 30 50, 25 45" stroke="#267348" stroke-width="1.5" stroke-opacity="0.22" stroke-linecap="round"/>
          <path d="M60 45 C 55 40, 50 32, 45 28" stroke="#267348" stroke-width="1.5" stroke-opacity="0.22" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- CỘT PHẢI: KHUNG CAMERA VIEWFINDER STAGE -->
    <div class="pc-skin-scan__col-stage">
      <div class="pc-skin-scan__stage" id="skinCameraStageContainer">
        <!-- Live Video & Mesh Guidance Canvas -->
        <video id="skinCameraStream" playsinline muted aria-label="{{ settings.ai_skin_scan_video_label | default: 'Luồng camera soi da' | escape }}"></video>
        <canvas id="skinGuidanceCanvas" aria-hidden="true"></canvas>

        <!-- Nút lật camera (Floating Switch) -->
        <button type="button" class="pc-skin-scan__flip-btn" data-skin-camera-switch hidden aria-label="{{ settings.ai_skin_scan_switch_label | default: 'Đổi camera' | escape }}" title="Đổi camera">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0-4.418-3.582-8-8-8s-8 3.582-8 8c0 1.954.702 3.744 1.874 5.132L4 17h6v-6L8.147 12.853C7.427 12.016 7 11.056 7 10c0-2.761 2.239-5 5-5s5 2.239 5 5c0 1.258-.466 2.408-1.237 3.284"/>
            <path d="M4 14c0 4.418 3.582 8 8 8s8-3.582 8-8c0-1.954-.702-3.744-1.874-5.132L20 7h-6v6l1.853-1.853C16.573 11.984 17 12.944 17 14c0 2.761-2.239 5-5 5s-5-2.239-5-5c0-1.258.466-2.408 1.237-3.284"/>
          </svg>
        </button>

        <!-- Trạng thái phản hồi / Cảnh báo -->
        <p class="pc-skin-scan__status" data-skin-mode-unavailable hidden role="status"></p>
        <p class="pc-skin-scan__status" id="skinCameraStatus" aria-live="polite"></p>

        <!-- GIAO DIỆN CHỜ TRƯỚC KHI BẬT CAMERA (STANDBY STATE) -->
        <div class="pc-skin-standby" id="skinStandbyOverlay">
          <div class="pc-skin-standby__ring-icon">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
              <path d="M18 9h.01"/>
            </svg>
          </div>
          <h3 class="pc-skin-standby__title">Đưa mặt vào khung và chụp ảnh</h3>
          <p class="pc-skin-standby__subtitle">Hệ thống sẽ phân tích làn da của bạn ngay lập tức.</p>
          <button type="button" class="pc-skin-scan__primary pc-btn-start-pill" data-skin-camera-start>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
            <span>{{ settings.ai_skin_scan_start_label | default: 'Bắt đầu soi da' | escape }}</span>
          </button>
        </div>

        <!-- Nút chụp ảnh dạng Floating Shutter khi đang Live Stream -->
        <div class="pc-skin-stream-controls">
          <button type="button" class="pc-skin-scan__primary pc-btn-shutter" data-skin-camera-capture disabled>
            <span class="pc-shutter-outer-ring">
              <span class="pc-shutter-inner-dot"></span>
            </span>
            <span>{{ settings.ai_skin_scan_capture_label | default: 'Chụp góc này' | escape }}</span>
          </button>
        </div>

        <!-- 3 Bước / Góc chụp dạng badge tròn ở chân khung nhìn -->
        <ol class="pc-skin-scan__steps" aria-label="{{ settings.ai_skin_scan_steps_label | default: 'Tiến độ chụp ảnh' | escape }}">
          <li data-skin-step="front" class="is-active" title="Góc chính diện">
            <span class="pc-step-dot" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </span>
            <span class="pc-step-text">{{ settings.ai_skin_scan_step_front | default: 'Chính diện' | escape }}</span>
          </li>
          <li data-skin-step="left" title="Góc nghiêng trái 45°">
            <span class="pc-step-dot" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </span>
            <span class="pc-step-text">{{ settings.ai_skin_scan_step_left | default: 'Má trái 45 độ' | escape }}</span>
          </li>
          <li data-skin-step="right" title="Góc nghiêng phải 45°">
            <span class="pc-step-dot" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </span>
            <span class="pc-step-text">{{ settings.ai_skin_scan_step_right | default: 'Má phải 45 độ' | escape }}</span>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <!-- HÀNG DƯỚI COL-12: THANH TÁC VỤ & PHÂN HỆ TẢI ẢNH CHUẨN Y KHOA -->
  <div class="pc-skin-scan__bottom-bar">
    <div class="pc-skin-scan__actions">
      <button type="button" class="pc-skin-scan__secondary pc-btn-upload-trigger" data-skin-open-upload>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <span>{{ settings.ai_skin_scan_upload_label | default: 'Tải 3 ảnh từ thiết bị' | escape }}</span>
      </button>
      <button type="button" class="pc-skin-scan__primary pc-btn-analyze" data-skin-analyze disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>{{ settings.ai_skin_scan_analyze_label | default: 'Phân tích 3 ảnh đã chụp' | escape }}</span>
      </button>
    </div>

    <!-- Phân hệ tải ảnh dạng 3 Dropzone Cards rộng rãi toàn chiều rộng (col-12) -->
    <div class="pc-skin-scan__upload" data-skin-upload hidden>
      <div class="pc-dropzone-grid">
        <div class="pc-upload-card" data-dropzone-card="front">
          <label>
            <div class="pc-dropzone-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <span class="pc-upload-label">{{ settings.ai_skin_scan_step_front | default: 'Chính diện' | escape }}</span>
            <span class="pc-dropzone-hint">Chọn ảnh rõ mặt góc 0°</span>
            <input type="file" accept="image/*" data-skin-upload-angle="front">
          </label>
        </div>

        <div class="pc-upload-card" data-dropzone-card="left">
          <label>
            <div class="pc-dropzone-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <span class="pc-upload-label">{{ settings.ai_skin_scan_step_left | default: 'Má trái 45 độ' | escape }}</span>
            <span class="pc-dropzone-hint">Chọn ảnh rõ mặt nghiêng trái 45°</span>
            <input type="file" accept="image/*" data-skin-upload-angle="left">
          </label>
        </div>

        <div class="pc-upload-card" data-dropzone-card="right">
          <label>
            <div class="pc-dropzone-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <span class="pc-upload-label">{{ settings.ai_skin_scan_step_right | default: 'Má phải 45 độ' | escape }}</span>
            <span class="pc-dropzone-hint">Chọn ảnh rõ mặt nghiêng phải 45°</span>
            <input type="file" accept="image/*" data-skin-upload-angle="right">
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal / Overlay tiến trình quét da AI Deliberate (~2s) -->
  <div class="pc-skin-scanning-overlay" data-skin-scanning-progress hidden aria-hidden="true">
    <div class="pc-scanning-card">
      <div class="pc-scanning-radar-pulse">
        <div class="pc-pulse-ring"></div>
        <div class="pc-pulse-ring-delay"></div>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#267348" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <h3 class="pc-scanning-title">AI Đang Phân Tích Làn Da</h3>
      <p class="pc-scanning-status-text">Đang trích xuất đặc trưng khuôn mặt 3 góc…</p>
      <div class="pc-scanning-bar-track">
        <div class="pc-scanning-bar-fill"></div>
      </div>
      <span class="pc-scanning-percent">0%</span>
      <p class="pc-scanning-subhint">Quá trình xử lý diễn ra an toàn ngay trên thiết bị của bạn.</p>
    </div>
  </div>

  <!-- Báo cáo kết quả phân tích toàn diện tại chỗ (Inline Dashboard) -->
  <section class="pc-skin-scan__report" data-skin-inline-report hidden aria-live="polite">
    <div class="pc-report-header">
      <div class="pc-report-badge">KẾT QUẢ PHÂN TÍCH LÂM SÀNG TẠI THIẾT BỊ</div>
      <h3>{{ settings.ai_skin_scan_report_title | default: 'Ảnh soi da và vùng được nhận diện' | escape }}</h3>
      <p class="pc-skin-scan__method" data-skin-analysis-method role="status"></p>
      <p data-skin-overlay-empty>{{ settings.ai_skin_scan_overlay_empty | default: 'Chưa có vùng được nhận diện. Để hiển thị đánh dấu, cần cấu hình model ONNX đã được thẩm định.' | escape }}</p>
    </div>

    <!-- Toggle các lớp đánh dấu -->
    <fieldset class="pc-skin-scan__layers">
      <legend>{{ settings.ai_skin_scan_layers_label | default: 'Lớp đánh dấu' | escape }}</legend>
      <label><input type="checkbox" data-skin-layer="acne" checked> {{ settings.ai_skin_scan_layer_acne | default: 'Mụn' | escape }}</label>
      <label><input type="checkbox" data-skin-layer="pigmentation" checked> {{ settings.ai_skin_scan_layer_pigmentation | default: 'Sắc tố' | escape }}</label>
      <label><input type="checkbox" data-skin-layer="pores" checked> {{ settings.ai_skin_scan_layer_pores | default: 'Lỗ chân lông' | escape }}</label>
      <label><input type="checkbox" data-skin-layer="wrinkles" checked> {{ settings.ai_skin_scan_layer_wrinkles | default: 'Nếp nhăn' | escape }}</label>
      <label><input type="checkbox" data-skin-layer="redness" checked> {{ settings.ai_skin_scan_layer_redness | default: 'Vùng đỏ' | escape }}</label>
    </fieldset>

    <!-- 3 Canvases hiển thị ảnh soi da khử định danh -->
    <div class="pc-skin-scan__previews">
      <figure><figcaption>{{ settings.ai_skin_scan_step_front | default: 'Chính diện' | escape }}</figcaption><canvas data-skin-preview="front"></canvas></figure>
      <figure><figcaption>{{ settings.ai_skin_scan_step_left | default: 'Má trái 45 độ' | escape }}</figcaption><canvas data-skin-preview="left"></canvas></figure>
      <figure><figcaption>{{ settings.ai_skin_scan_step_right | default: 'Má phải 45 độ' | escape }}</figcaption><canvas data-skin-preview="right"></canvas></figure>
    </div>

    <!-- Bảng 5 chỉ số sức khỏe làn da -->
    <div class="pc-inline-scores-section">
      <div class="pc-inline-section-header">
        <h4 class="pc-inline-section-heading">5 Chỉ Số Lâm Sàng Tham Khảo</h4>
        <span class="pc-inline-section-badge">Thang điểm 0 - 100</span>
      </div>
      <div class="pc-inline-scores-grid" data-inline-scan-scores></div>
      <div class="pc-inline-meta-row">
        <div class="pc-inline-meta-chip" data-inline-skin-age hidden>
          <span class="pc-meta-label">Tuổi da tham khảo:</span>
          <span class="pc-meta-val" data-inline-skin-age-val>—</span>
        </div>
        <div class="pc-inline-meta-chip" data-inline-primary-concern hidden>
          <span class="pc-meta-label">Vấn đề trọng tâm:</span>
          <span class="pc-meta-val" data-inline-primary-concern-val>—</span>
        </div>
      </div>
    </div>

    <!-- Biểu đồ tương quan Radar 5 trục hiển thị tại chỗ -->
    <div class="pc-inline-radar-section">
      <figure class="pc-skin-radar pc-inline-radar-box">
        <h4 class="pc-radar-heading">Biểu đồ tương quan 5 khía cạnh da</h4>
        <svg viewBox="0 0 360 320" role="img" aria-label="Biểu đồ 5 chỉ số soi da">
          <g class="pc-skin-radar__grid" aria-hidden="true">
            <polygon points="180,139 200,153 192,176 168,176 160,153"></polygon>
            <polygon points="180,118 220,147 205,192 155,192 140,147"></polygon>
            <polygon points="180,97 240,140 218,208 142,208 120,140"></polygon>
            <polygon points="180,76 260,133 230,224 130,224 100,133"></polygon>
            <polygon points="180,55 280,127 242,245 118,245 80,127"></polygon>
            <path d="M180 160V55 M180 160L280 127 M180 160L242 245 M180 160L118 245 M180 160L80 127"></path>
          </g>
          <polygon class="pc-skin-radar__area" data-inline-radar-shape points="180,160 180,160 180,160 180,160 180,160"></polygon>
          <g class="pc-skin-radar__labels" aria-hidden="true">
            <text x="180" y="34" text-anchor="middle">Mụn</text>
            <text x="300" y="121" text-anchor="start">Sắc tố</text>
            <text x="256" y="273" text-anchor="middle">Nếp nhăn</text>
            <text x="104" y="273" text-anchor="middle">Độ đỏ</text>
            <text x="60" y="121" text-anchor="end">Lỗ chân lông</text>
          </g>
        </svg>
        <figcaption class="pc-radar-caption">Vùng tô đậm biểu thị mức độ concern (0–1); diện tích càng gọn chứng tỏ nền da càng cân bằng, khỏe mạnh.</figcaption>
      </figure>
    </div>

    <!-- Định hướng phác đồ 3 giai đoạn & gợi ý hoạt chất -->
    <div class="pc-inline-regimen-section">
      <div class="pc-inline-section-header">
        <h4 class="pc-inline-section-heading">Định Hướng Phác Đồ Tham Khảo</h4>
        <span class="pc-inline-section-badge">3 Giai Đoạn Khoa Học</span>
      </div>
      <div class="pc-inline-regimen-grid" data-inline-regimen-grid></div>
    </div>

    <!-- Thanh nút tác vụ tại chân báo cáo -->
    <div class="pc-report-actions">
      <button type="button" class="pc-skin-scan__secondary pc-btn-rescan" data-skin-rescan>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        <span>Soi da lại</span>
      </button>
      <a href="https://zalo.me/0967194063" target="_blank" rel="noopener" class="pc-skin-scan__primary pc-btn-zalo-doctor">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>Tư vấn 1:1 cùng Chuyên gia</span>
      </a>
      <a class="pc-skin-scan__secondary pc-skin-scan__report-link" href="/pages/ai-skin-quiz-results" target="_blank" rel="noopener">
        <span>{{ settings.ai_skin_scan_report_link | default: 'Mở trang kết quả chi tiết' | escape }}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <p class="pc-skin-scan__disclaimer">{{ settings.ai_skin_scan_disclaimer | default: 'Kết quả là gợi ý tự động để tham khảo, không phải chẩn đoán y khoa và không thay thế đánh giá trực tiếp từ chuyên gia phù hợp. Nếu có lo ngại về da, hãy trao đổi với chuyên gia y tế.' | escape }}</p>
</section>
