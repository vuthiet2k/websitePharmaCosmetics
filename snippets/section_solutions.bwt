{%- comment -%}
  section_solutions.bwt — Giải pháp cho từng vấn đề da.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- capture sol_tiles -%}
{%- assign sol_ll = linklists[settings.home_solutions_menu] -%}
{%- if sol_ll.links.size > 0 -%}
  {%- for link in sol_ll.links limit: 7 -%}
    {%- assign sol_img = link.object.image.src -%}
    {%- if sol_img == blank -%}{%- assign sol_img = link.object.featured_image.src -%}{%- endif -%}
    {%- if sol_img != blank -%}{%- assign sol_src = sol_img | img_url: 'large' -%}{%- elsif forloop.index <= 6 -%}{%- capture sol_asset -%}home_concern_{{ forloop.index }}.jpg{%- endcapture -%}{%- assign sol_src = sol_asset | asset_url -%}{%- else -%}{%- assign sol_src = '' -%}{%- endif -%}
    {%- capture k_sub -%}home_solutions_{{ forloop.index }}_sub{%- endcapture -%}
    <a class="flex flex-col overflow-hidden rounded-2xl border border-solid border-line-soft bg-white no-underline hover:border-primary transition-all group" href="{{ link.url | escape }}">
      <span class="block aspect-[307/130] w-full overflow-hidden bg-brand-tint">
        {%- if sol_src != blank -%}<img class="block h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="{{ sol_src }}" alt="{{ link.title | escape }}" width="614" height="260" loading="lazy">{%- endif -%}
      </span>
      <span class="p-3 md:p-4 flex flex-col">
        <span class="m-0 block text-xs md:text-sm font-bold text-brand-deep group-hover:text-primary transition-colors">{{ link.title | escape }}</span>
        {%- if settings[k_sub] != blank -%}<span class="m-0 mt-1 block text-xs text-ink-muted">{{ settings[k_sub] | escape }}</span>{%- endif -%}
      </span>
    </a>
  {%- endfor -%}
{%- endif -%}
{%- endcapture -%}
<section class="py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-solutions-title">
  <div class="container">
    <div class="mb-6 lg:mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-wider text-primary hidden lg:block">{{ settings.home_solutions_eyebrow | default: 'Mua theo vấn đề da' | escape }}</p>
        <h2 class="m-0 text-2xl lg:text-3xl font-bold text-brand-deep mt-1" id="section-solutions-title">{{ settings.home_solutions_title | default: 'Giải pháp cho từng vấn đề' | escape }}</h2>
        {%- if settings.home_solutions_subtitle != blank -%}<p class="m-0 mt-2 text-sm text-ink-muted">{{ settings.home_solutions_subtitle | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
      {{ sol_tiles }}
      {%- unless settings.home_sol_ai_enable == false or settings.home_sol_ai_enable == 'false' -%}
      {%- assign sol_ai_icon = settings.home_sol_ai_icon | default: 'wand-sparkles' -%}
      <a class="col-span-2 md:col-span-1 flex flex-col justify-between rounded-2xl bg-brand-tint p-5 md:p-6 text-brand-deep no-underline hover:opacity-95 transition-opacity" href="{{ settings.home_sol_ai_cta_url | default: settings.home_ai_guide_cta_url | default: '/kham-da-ai' | escape }}">
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-deep">{% include 'ui_icon', name: sol_ai_icon %}{{ settings.home_sol_ai_eyebrow | default: 'Pharma AI' | escape }}</span>
          <span class="block text-base md:text-lg font-bold text-brand-deep mt-2 leading-snug">{{ settings.home_sol_ai_title | default: 'Chưa biết da mình thuộc nhóm nào?' | escape }}</span>
          {%- assign sol_ai_desc = settings.home_sol_ai_desc | default: 'Trả lời vài câu hỏi để nhận gợi ý hoạt chất và sản phẩm tham khảo.' -%}
          <span class="block text-xs md:text-sm text-brand-deep mt-2 leading-relaxed opacity-90">{{ sol_ai_desc | escape }}</span>
        </div>
        <span class="inline-flex items-center gap-1.5 text-xs md:text-sm font-bold text-brand-deep mt-4 pt-2 border-t border-brand-deep/20">
          <span>{{ settings.home_sol_ai_cta_text | default: settings.home_ai_guide_cta_text | default: 'Bắt đầu khảo sát da' | escape }}</span>
          {% include 'ui_icon', name: 'arrow-right' %}
        </span>
      </a>
      {%- endunless -%}
    </div>
  </div>
</section>
