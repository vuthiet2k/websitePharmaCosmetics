{%- comment -%}
  03/11/2026 (chủ dự án: trang chủ theo Figma "travel" node 5:2): lưới 4 cột thẻ ảnh + tên + dòng phụ, ô cuối là thẻ Pharma AI
  (khảo sát da — thay khối section_ai_guide riêng). Nguồn giữ nguyên:
  - Menu settings.home_solutions_menu: ảnh = ảnh danh mục link trỏ tới (link.object.image → featured_image) → ảnh mặc định
    assets/home_concern_N.jpg (6 mục đầu). Dòng phụ = home_solutions_N_sub theo THỨ TỰ mục menu (trống ⇒ ẩn dòng).
  - Chưa có menu ⇒ 6 thẻ nhập tay home_solutions_N_* như trước (danh mục giai-phap-* → trang tìm kiếm theo từ khoá).
  - Thẻ AI: home_sol_ai_eyebrow / _title / _desc / _cta_text / _cta_url (tắt bằng home_sol_ai_enable).
  CSS: ui-src/css/components.css mục 14.4.
{%- endcomment -%}
{%- capture sol_tiles -%}
{%- assign sol_ll = linklists[settings.home_solutions_menu] -%}
{%- if sol_ll.links.size > 0 -%}
  {%- for link in sol_ll.links limit: 7 -%}
    {%- assign sol_img = link.object.image.src -%}
    {%- if sol_img == blank -%}{%- assign sol_img = link.object.featured_image.src -%}{%- endif -%}
    {%- if sol_img != blank -%}{%- assign sol_src = sol_img | img_url: 'large' -%}{%- elsif forloop.index <= 6 -%}{%- capture sol_asset -%}home_concern_{{ forloop.index }}.jpg{%- endcapture -%}{%- assign sol_src = sol_asset | asset_url -%}{%- else -%}{%- assign sol_src = '' -%}{%- endif -%}
    {%- capture k_sub -%}home_solutions_{{ forloop.index }}_sub{%- endcapture -%}
    <a class="pc-h4-con" href="{{ link.url | escape }}">
      <span class="pc-h4-con__media">{%- if sol_src != blank -%}<img src="{{ sol_src }}" alt="{{ link.title | escape }}" width="614" height="260" loading="lazy">{%- endif -%}</span>
      <span class="pc-h4-con__body"><span class="pc-h4-con__t block">{{ link.title | escape }}</span>{%- if settings[k_sub] != blank -%}<span class="pc-h4-con__d block">{{ settings[k_sub] | escape }}</span>{%- endif -%}</span>
    </a>
  {%- endfor -%}
{%- else -%}
  {%- for i in (1..6) -%}
    {%- capture enabled -%}home_solutions_{{ i }}_enable{%- endcapture -%}
    {%- capture label -%}home_solutions_{{ i }}_label{%- endcapture -%}
    {%- capture query -%}home_solutions_{{ i }}_url{%- endcapture -%}
    {%- capture image -%}home_solutions_{{ i }}_image{%- endcapture -%}
    {%- capture col_key -%}home_solutions_{{ i }}_collection{%- endcapture -%}
    {%- capture k_sub -%}home_solutions_{{ i }}_sub{%- endcapture -%}
    {%- unless settings[enabled] == false or settings[enabled] == 'false' -%}{%- if settings[label] != blank -%}
      {%- capture sol_url -%}/search?query={{ settings[query] | default: settings[label] | url_encode }}&type=product{%- endcapture -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign sol_default = 'giai-phap-mun-trung-ca' -%}
        {%- when 2 -%}{%- assign sol_default = 'giai-phap-nam-tan-nhang' -%}
        {%- when 3 -%}{%- assign sol_default = 'giai-phap-da-kho-thieu-am' -%}
        {%- when 4 -%}{%- assign sol_default = 'giai-phap-lao-hoa-da' -%}
        {%- when 5 -%}{%- assign sol_default = 'giai-phap-kiem-soat-dau-thua' -%}
        {%- else -%}{%- assign sol_default = 'giai-phap-da-nhay-cam' -%}
      {%- endcase -%}
      {%- assign sol_handle = settings[col_key] | default: sol_default -%}
      {%- assign sol_col = collections[sol_handle] -%}
      {%- if sol_col.products_count > 0 -%}{%- assign sol_url = sol_col.url -%}{%- endif -%}
      {%- if settings[image] != blank -%}{%- assign sol_src = settings[image] | img_url: 'large' -%}{%- else -%}{%- capture sol_asset -%}home_concern_{{ i }}.jpg{%- endcapture -%}{%- assign sol_src = sol_asset | asset_url -%}{%- endif -%}
      <a class="pc-h4-con" href="{{ sol_url | escape }}">
        <span class="pc-h4-con__media"><img src="{{ sol_src }}" alt="{{ settings[label] | escape }}" width="614" height="260" loading="lazy"></span>
        <span class="pc-h4-con__body"><span class="pc-h4-con__t block">{{ settings[label] | escape }}</span>{%- if settings[k_sub] != blank -%}<span class="pc-h4-con__d block">{{ settings[k_sub] | escape }}</span>{%- endif -%}</span>
      </a>
    {%- endif -%}{%- endunless -%}
  {%- endfor -%}
{%- endif -%}
{%- endcapture -%}
<section class="pc-h4 pc-h4-sec pc-h4-sec--tight-t" aria-labelledby="pc-h4-sol-title">
  <div class="pc-h4-wrap">
    <div class="pc-h4-head">
      <div>
        <p class="pc-h4-eyebrow">{{ settings.home_solutions_eyebrow | default: 'Mua theo vấn đề da' | escape }}</p>
        <h2 class="pc-h4-title" id="pc-h4-sol-title">{{ settings.home_solutions_title | default: 'Giải pháp cho từng vấn đề' | escape }}</h2>
      </div>
      {%- if settings.home_solutions_subtitle != blank -%}<p class="pc-h4-lead">{{ settings.home_solutions_subtitle | escape }}</p>{%- endif -%}
    </div>
    <div class="pc-h4-concerns">
      {{ sol_tiles }}
      {%- unless settings.home_sol_ai_enable == false or settings.home_sol_ai_enable == 'false' -%}
      {%- assign sol_count = sol_tiles | split: 'class="pc-h4-con"' | size | minus: 1 | modulo: 4 -%}
      <a class="pc-h4-ai{% if sol_count == 2 %} pc-h4-ai--wide{% endif %}" href="{{ settings.home_sol_ai_cta_url | default: settings.home_ai_guide_cta_url | default: '/kham-da-ai' | escape }}">
        <span class="pc-h4-ai__k block">{{ settings.home_sol_ai_eyebrow | default: 'Pharma AI' | escape }}</span>
        <span class="pc-h4-ai__t block">{{ settings.home_sol_ai_title | default: 'Chưa biết da mình thuộc nhóm nào?' | escape }}</span>
        {%- assign sol_ai_desc = settings.home_sol_ai_desc | default: 'Trả lời vài câu hỏi để nhận gợi ý hoạt chất và sản phẩm tham khảo.' -%}
        <span class="pc-h4-ai__d block">{{ sol_ai_desc | escape }}</span>
        <span class="pc-h4-go">{{ settings.home_sol_ai_cta_text | default: settings.home_ai_guide_cta_text | default: 'Bắt đầu khảo sát da' | escape }}{% include 'ui_icon', name: 'arrow-right' %}</span>
      </a>
      {%- endunless -%}
    </div>
  </div>
</section>
