{%- comment -%}
  section_testimonials_case.bwt — 1 tab + 1 panel ca trị liệu lâm sàng cho section_testimonials.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{%- assign testi_n = testi_n | plus: 1 -%}
{%- capture t_sel -%}{% if testi_n == 1 %}true{% else %}false{% endif %}{%- endcapture -%}
{%- capture t_tab -%}
<li class="swiper-slide m-0 !w-auto lg:!w-full">
  <a role="tab" id="tab-case-{{ t_key }}" aria-controls="panel-case-{{ t_key }}" aria-selected="{{ t_sel }}" tabindex="{% if testi_n == 1 %}0{% else %}-1{% endif %}" href="#panel-case-{{ t_key }}"
     class="box-border inline-flex lg:flex min-h-[44px] lg:min-h-14 items-center whitespace-nowrap lg:whitespace-normal rounded-full lg:rounded-xl border border-solid border-line-soft bg-white px-4 lg:px-5 text-xs lg:text-sm font-semibold text-brand-deep no-underline hover:border-primary aria-selected:border-primary aria-selected:bg-primary aria-selected:text-white transition-all">
    0{{ testi_n }} · {{ t_concern | escape }}{% if t_tab_who != blank %} – {{ t_tab_who | escape }}{% endif %}
  </a>
</li>
{%- endcapture -%}
{%- capture t_panel -%}
<article role="tabpanel" id="panel-case-{{ t_key }}" aria-labelledby="tab-case-{{ t_key }}" class="rounded-2xl bg-white p-4 md:p-6 lg:p-7 flex flex-col"{% if testi_n > 1 %} hidden{% endif %}>
  {%- comment -%} M-18: cặp ảnh Trước/Sau dùng chung với trang /blogs/truoc-va-sau (pc_ba_pair). {%- endcomment -%}
  {%- capture t_dur_sfx -%}{% if t_duration != blank %}{{ t_duration | escape }}{% endif %}{%- endcapture -%}
  {%- include 'pc_ba_pair', ba_before: t_img1, ba_after: t_img2, ba_title: t_title, ba_bl: testi_lb_before, ba_al: testi_lb_after, ba_after_suffix: t_dur_sfx -%}
  <div class="flex flex-col mt-4 md:mt-6">
    <div class="flex flex-col">
      <h3 class="m-0 text-lg md:text-xl lg:text-2xl font-bold text-brand-deep leading-snug">{{ t_title | escape }}</h3>
      {%- if t_who != blank -%}<p class="m-0 mt-1 text-xs md:text-sm text-ink-muted">{{ t_who | strip | escape }}</p>{%- endif -%}
      {%- if t_products != blank -%}<p class="md:hidden m-0 mt-2 inline-block self-start rounded-full bg-brand-tint px-3 py-1 text-xs font-bold text-brand-deep">{{ t_products | escape }}</p>{%- endif -%}
    </div>
    {%- if t_duration != blank or t_products != blank -%}
      <ul class="m-0 mt-3 hidden md:flex list-none flex-wrap gap-2 p-0">
        {%- if t_duration != blank -%}
          <li class="inline-flex items-center gap-1.5 rounded-full bg-surface-soft px-3 py-1 text-xs font-semibold text-brand-deep">
            {% include 'ui_icon', name: 'clock' %}
            <span>{{ t_duration | escape }}</span>
          </li>
        {%- endif -%}
        {%- if t_products != blank -%}
          <li class="inline-flex items-center gap-1.5 rounded-full bg-surface-soft px-3 py-1 text-xs font-semibold text-brand-deep">
            {% include 'ui_icon', name: 'flask-conical' %}
            <span>{{ t_products | escape }}</span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
    {%- if t_desc != blank -%}
      <p class="m-0 mt-3 line-clamp-3 text-sm leading-relaxed text-ink-muted">{{ t_desc | escape }}</p>
    {%- endif -%}
    <div class="mt-4 pt-3 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <details class="cursor-pointer">
        <summary class="flex items-center gap-2 text-sm font-bold text-brand-deep list-none select-none">
          <span>{{ testi_lb_steps | escape }}</span>
          {% include 'ui_icon', name: 'chevron-down' %}
        </summary>
        <dl class="m-0 mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
          {%- if t_initial != blank -%}<dt class="font-bold text-brand-deep sm:col-span-1">{{ settings.home_testi_initial_label | default: 'Tình trạng ban đầu' | escape }}</dt><dd class="m-0 text-ink sm:col-span-3">{{ t_initial | escape }}</dd>{%- endif -%}
          {%- assign t_step_list = t_steps | split: testi_step_sep -%}
          {%- if t_steps != blank and t_step_list.size > 0 -%}
            <dt class="font-bold text-brand-deep sm:col-span-1">{{ testi_lb_steps | escape }}</dt>
            <dd class="m-0 text-ink sm:col-span-3">
              <ol class="m-0 p-0 list-none flex flex-col gap-1.5">
                {%- assign t_step_i = 0 -%}
                {%- for st in t_step_list -%}
                  {%- assign st_s = st | strip -%}
                  {%- if st_s != blank -%}
                    {%- assign t_step_i = t_step_i | plus: 1 -%}
                    <li class="flex items-start gap-2"><b class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-tint text-xs font-bold text-brand-deep">{{ t_step_i }}</b><span>{{ st_s | escape }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
            </dd>
          {%- elsif t_desc != blank -%}
            <dt class="font-bold text-brand-deep sm:col-span-1">{{ testi_lb_steps | escape }}</dt><dd class="m-0 text-ink sm:col-span-3">{{ t_desc | escape }}</dd>
          {%- endif -%}
          {%- if t_products != blank -%}<dt class="font-bold text-brand-deep sm:col-span-1">{{ settings.home_testi_products_label | default: 'Sản phẩm sử dụng' | escape }}</dt><dd class="m-0 text-ink sm:col-span-3">{{ t_products | escape }}</dd>{%- endif -%}
          {%- if t_duration != blank -%}<dt class="font-bold text-brand-deep sm:col-span-1">{{ settings.home_testi_duration_label | default: 'Thời gian theo dõi' | escape }}</dt><dd class="m-0 text-ink sm:col-span-3">{{ t_duration | escape }}</dd>{%- endif -%}
        </dl>
      </details>
      {%- assign t_zalo = settings.contact_zalo | remove: ' ' | remove: '.' | remove: '-' | remove: '+' | strip -%}
      {%- if t_zalo != blank -%}
        <a class="inline-flex min-h-11 w-full md:w-auto items-center justify-center rounded-full bg-primary hover:bg-btn-hover px-6 text-sm font-bold text-white no-underline transition-colors" href="https://zalo.me/{{ t_zalo }}" target="_blank" rel="noopener">{{ settings.clinical_case_cta_label | default: 'Liên hệ tư vấn' | escape }}</a>
      {%- else -%}
        <a class="inline-flex min-h-11 w-full md:w-auto items-center justify-center rounded-full bg-primary hover:bg-btn-hover px-6 text-sm font-bold text-white no-underline transition-colors" href="/dat-lich-tu-van">{{ settings.portal_booking_text | default: 'Liên hệ tư vấn' | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</article>
{%- endcapture -%}
{%- assign testi_tabs = testi_tabs | append: t_tab -%}
{%- assign testi_panels = testi_panels | append: t_panel -%}
