{%- comment -%}
  aside-filter.bwt — ruột bộ lọc sản phẩm (collection + search). M-24 (17/11/2026): viết lại 100% Tailwind — bỏ khối <style> (hex #bbb/#e4e4e4/#f8f8f8, !important), bỏ SVG nhúng tay
  (ui_icon), tiện ích JS dựng bằng <template> (class nằm ở markup, JS không chứa class). Móc JS giữ nguyên (không CSS): filter-group, filter-group-toggle, filter-items-list,
  sapo-filter-item, filter-checkbox-input, filter-pill-btn (+ .active), filter-range-input, #afw-price-min/#afw-price-max (col.js đọc giá trị), is-active.
  Thanh Khoảng giá: 2 input range giữ làm nguồn giá trị + bàn phím (sr-only); nút kéo là 2 <button> vùng chạm 44px, vị trí/đoạn chọn do JS đặt lúc chạy.
{%- endcomment -%}
<div class="filter-content">
	<div class="filter-container">
		<div class="aside-filter-groups flex w-full flex-col gap-[4px]">{%- comment -%} 20/11/2026: khoảng giữa nhóm 4px (CSS cũ gap 40px + padding 10px đã gỡ khỏi components.css) {%- endcomment -%}

			{%- if settings.filter_type and collection.all_types.size > 0 -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-2 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_type_title | default: 'LOẠI SẢN PHẨM' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-items-list flex flex-col">
					{%- for type in collection.all_types -%}
					{%- if type != '' -%}
					<label class="sapo-filter-item flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-1 cursor-pointer items-center gap-2.5 text-sm text-ink [&.is-active]:font-semibold [&.is-active]:text-brand-deep">
						<input type="checkbox" class="sapo-filter-checkbox filter-checkbox-input h-5 w-5 shrink-0 cursor-pointer accent-primary" data-group="PRODUCT_TYPE" data-field="product_type.filter_key" data-text="{{ type }}" data-operator="OR" value="(&#34;{{ type }}&#34;)">
						<span class="sapo-filter-text">{{ type }}</span>
					</label>
					{%- endif -%}
					{%- endfor -%}
				</div>
			</div>
			{%- endif -%}

			{%- if settings.filter_tag1 and settings.filter_tag1_list != '' -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-2 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_tag1_title | default: 'BỘ LỌC' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-items-list flex flex-col">
					{%- assign tags1 = settings.filter_tag1_list | split: ';' -%}
					{%- for t in tags1 -%}
					{%- assign tag = t | strip -%}
					{%- if tag != '' -%}
					<label class="sapo-filter-item flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-1 cursor-pointer items-center gap-2.5 text-sm text-ink [&.is-active]:font-semibold [&.is-active]:text-brand-deep">
						<input type="checkbox" class="sapo-filter-checkbox filter-checkbox-input h-5 w-5 shrink-0 cursor-pointer accent-primary" data-group="{{ settings.filter_tag1_title | default: 'tag1' }}" data-field="tags" data-text="{{ tag }}" data-operator="OR" value="(&#34;{{ tag }}&#34;)">
						<span class="sapo-filter-text">{{ tag }}</span>
					</label>
					{%- endif -%}
					{%- endfor -%}
				</div>
			</div>
			{%- endif -%}

			{%- if settings.filter_tag2 and settings.filter_tag2_list != '' -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-3 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_tag2_title | default: 'VẤN ĐỀ VỀ DA' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-pills-wrapper flex flex-wrap gap-2">
					{%- assign tags2 = settings.filter_tag2_list | split: ';' -%}
					{%- for t in tags2 -%}
					{%- assign tag = t | strip -%}
					{%- if tag != '' -%}
					<button type="button" class="filter-pill-btn min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-1 py-1 cursor-pointer rounded-full border border-solid border-line-soft bg-surface-soft px-3.5 text-xs sm:text-sm text-ink transition-colors hover:bg-brand-tint [&.active]:border-primary [&.active]:bg-primary [&.active]:font-semibold [&.active]:text-white" data-group="{{ settings.filter_tag2_title | default: 'tag2' }}" data-field="tags" data-text="{{ tag }}" data-operator="OR" data-value="(&#34;{{ tag }}&#34;)">{{ tag }}</button>
					{%- endif -%}
					{%- endfor -%}
				</div>
			</div>
			{%- endif -%}

			{%- if settings.filter_tag3 and settings.filter_tag3_list != '' -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-2 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_tag3_title | default: 'BỘ LỌC' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-items-list flex flex-col">
					{%- assign tags3 = settings.filter_tag3_list | split: ';' -%}
					{%- for t in tags3 -%}
					{%- assign tag = t | strip -%}
					{%- if tag != '' -%}
					<label class="sapo-filter-item flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-1 cursor-pointer items-center gap-2.5 text-sm text-ink [&.is-active]:font-semibold [&.is-active]:text-brand-deep">
						<input type="checkbox" class="sapo-filter-checkbox filter-checkbox-input h-5 w-5 shrink-0 cursor-pointer accent-primary" data-group="{{ settings.filter_tag3_title | default: 'tag3' }}" data-field="tags" data-text="{{ tag }}" data-operator="OR" value="(&#34;{{ tag }}&#34;)">
						<span class="sapo-filter-text">{{ tag }}</span>
					</label>
					{%- endif -%}
					{%- endfor -%}
				</div>
			</div>
			{%- endif -%}

			{%- if settings.filter_vendor and collection.all_vendors.size > 0 -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-2 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_vendor_title | default: 'THƯƠNG HIỆU' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-items-list flex flex-col">
					{%- for vendor in collection.all_vendors -%}
					{%- if vendor != '' -%}
					<label class="sapo-filter-item flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-1 cursor-pointer items-center gap-2.5 text-sm text-ink [&.is-active]:font-semibold [&.is-active]:text-brand-deep">
						<input type="checkbox" class="sapo-filter-checkbox filter-checkbox-input h-5 w-5 shrink-0 cursor-pointer accent-primary" data-group="Hãng" data-field="vendor" data-text="{{ vendor }}" data-operator="OR" value="(&#34;{{ vendor }}&#34;)">
						<span class="sapo-filter-text">{{ vendor }}</span>
					</label>
					{%- endif -%}
					{%- endfor -%}
				</div>
			</div>
			{%- endif -%}

			{%- if settings.filter_price -%}
			<div class="filter-group border-0 border-b border-solid border-line-soft pb-3 last:border-b-0">
				<h3 class="m-0"><button type="button" class="filter-group-toggle [&[aria-expanded=true]>svg]:rotate-180 [&>svg]:transition-transform flex min-h-[44px] min-[992px]:min-h-0 min-[992px]:py-2 w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left text-sm font-bold uppercase tracking-wider text-brand-deep" aria-expanded="true"><span>{{ settings.filter_price_title | default: 'KHOẢNG GIÁ' }}</span>{% include 'ui_icon', name: 'chevron-down', size: 20 %}</button></h3>
				<div class="filter-price-slider pt-1">
					<div class="relative h-12" id="afw-price-ui">
						<div class="absolute inset-x-3 top-1/2 -translate-y-1/2" id="afw-price-track">
							<div class="h-1.5 w-full rounded-full bg-line"></div>
							<div class="absolute top-0 h-1.5 rounded-full bg-primary" id="afw-price-fill"></div>
							<button type="button" tabindex="-1" aria-hidden="true" class="absolute top-1/2 flex min-h-[44px] min-w-[44px] -translate-x-1/2 -translate-y-1/2 cursor-grab touch-none items-center justify-center border-0 bg-transparent p-0" data-afw-thumb="min"><span class="block h-6 w-6 rounded-full border-2 border-solid border-white bg-primary"></span></button>
							<button type="button" tabindex="-1" aria-hidden="true" class="absolute top-1/2 flex min-h-[44px] min-w-[44px] -translate-x-1/2 -translate-y-1/2 cursor-grab touch-none items-center justify-center border-0 bg-transparent p-0" data-afw-thumb="max"><span class="block h-6 w-6 rounded-full border-2 border-solid border-white bg-primary"></span></button>
						</div>
						<input type="range" min="0" max="5000000" step="50000" value="0" class="filter-range-input filter-range-min sr-only" id="afw-price-min" aria-label="Giá tối thiểu">
						<input type="range" min="0" max="5000000" step="50000" value="5000000" class="filter-range-input filter-range-max sr-only" id="afw-price-max" aria-label="Giá tối đa">
					</div>
					<div class="flex items-center justify-between text-xs font-semibold text-brand-deep">
						<span id="afw-label-min">0đ</span>
						<span id="afw-label-max">5.000.000đ+</span>
					</div>
				</div>
			</div>
			{%- endif -%}

		</div>

		{%- include 'filter-cate-col' -%}
	</div>
</div>

<template id="afw-search-tpl">
	<div class="relative mt-1 mb-1">
		<span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted" aria-hidden="true">{% include 'ui_icon', name: 'search', size: 20 %}</span>
		<input type="search" class="filter-group-search min-h-[44px] w-full rounded-xl border border-solid border-line-soft bg-surface-soft !pl-11 !pr-3 text-sm text-ink outline-none focus:border-primary focus:bg-white" placeholder="Tìm trong nhóm..." autocomplete="off" aria-label="Tìm trong nhóm">
	</div>
	<p class="filter-no-results m-0 hidden py-1 text-center text-sm italic text-ink-muted">Không tìm thấy kết quả.</p>
</template>
<template id="afw-more-tpl">
	<button type="button" class="filter-showmore-btn mt-2 flex min-h-[44px] w-full cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-primary bg-transparent px-3 text-sm text-brand-deep transition-colors hover:bg-brand-tint">
		<span class="afw-more-ico-down" aria-hidden="true">{% include 'ui_icon', name: 'chevron-down', size: 20 %}</span>
		<span class="afw-more-ico-up hidden" aria-hidden="true">{% include 'ui_icon', name: 'arrow-up', size: 20 %}</span>
		<span class="afw-more-label"></span>
	</button>
</template>

<script>
(function () {
	/* ── toggleFilter: visual feedback when checkbox is checked ── */
	function toggleFilter(el) {
		var item = el.closest('.sapo-filter-item');
		if (item) item.classList.toggle('is-active', el.checked);
	}
	window.toggleFilter = toggleFilter;

	/* ── Price range slider (M-24): nút kéo = <button> pointer events; giá trị ghi vào 2 input range (col.js đọc) ── */
	var PRICE_MAX = 5000000, PRICE_STEP = 50000;
	var elMin  = document.getElementById('afw-price-min');
	var elMax  = document.getElementById('afw-price-max');
	var fill   = document.getElementById('afw-price-fill');
	var lblMin = document.getElementById('afw-label-min');
	var lblMax = document.getElementById('afw-label-max');
	var track  = document.getElementById('afw-price-track');

	if (elMin && elMax && track) {
		var thumbMin = track.querySelector('[data-afw-thumb="min"]');
		var thumbMax = track.querySelector('[data-afw-thumb="max"]');
		function formatPrice(val) {
			return parseInt(val, 10).toLocaleString('vi-VN') + 'đ';
		}
		function updateSlider() {
			var min = parseInt(elMin.value, 10);
			var max = parseInt(elMax.value, 10);
			if (min > max) {
				var tmp = min; min = max; max = tmp;
				elMin.value = min; elMax.value = max;
			}
			var pMin = (min / PRICE_MAX) * 100;
			var pMax = (max / PRICE_MAX) * 100;
			/* giá trị động theo lúc kéo ⇒ chỉ đặt bằng JS lúc chạy (không có thuộc tính style tĩnh trong markup) */
			fill.style.left  = pMin + '%';
			fill.style.width = (pMax - pMin) + '%';
			thumbMin.style.left = pMin + '%';
			thumbMax.style.left = pMax + '%';
			lblMin.textContent = formatPrice(min);
			lblMax.textContent = max >= PRICE_MAX ? '5.000.000đ+' : formatPrice(max);
		}
		function valueAt(clientX) {
			var r = track.getBoundingClientRect();
			var p = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
			return Math.round((p * PRICE_MAX) / PRICE_STEP) * PRICE_STEP;
		}
		function drag(thumb, input) {
			thumb.addEventListener('pointerdown', function (e) {
				e.preventDefault();
				thumb.setPointerCapture(e.pointerId);
				function move(ev) { input.value = valueAt(ev.clientX); updateSlider(); }
				function up() {
					thumb.removeEventListener('pointermove', move);
					thumb.removeEventListener('pointerup', up);
					thumb.removeEventListener('pointercancel', up);
					input.dispatchEvent(new Event('change', { bubbles: true }));
				}
				thumb.addEventListener('pointermove', move);
				thumb.addEventListener('pointerup', up);
				thumb.addEventListener('pointercancel', up);
			});
		}
		drag(thumbMin, elMin);
		drag(thumbMax, elMax);
		elMin.addEventListener('input', updateSlider);
		elMax.addEventListener('input', updateSlider);
		updateSlider();
	}

	/* ════════════════════════════════════════════════
	   ── Show-more + Search cho filter groups ──
	   Chạy sau tất cả DOMContentLoaded handlers
	   (setTimeout 0 để đợi jQuery ready và restore-from-URL)
	   ════════════════════════════════════════════════ */
	var FILTER_LIMIT = 8;

	function isHidden(el) { return el.classList.contains('hidden'); }

	/* Collapse: ẩn item > LIMIT (trừ item đang bật) */
	function applyCollapse(items, isOn) {
		var visible = 0;
		items.forEach(function (item) {
			if (isOn(item)) {
				item.classList.remove('hidden');
			} else if (visible < FILTER_LIMIT) {
				item.classList.remove('hidden');
				visible++;
			} else {
				item.classList.add('hidden');
			}
		});
	}
	function checkedItem(item) { return !!item.querySelector('input:checked'); }
	function activePill(item) { return item.classList.contains('active'); }

	function makeMoreButton(list, items, collapse) {
		var btn = document.getElementById('afw-more-tpl').content.firstElementChild.cloneNode(true);
		list.parentNode.insertBefore(btn, list.nextSibling);
		function updateBtn() {
			var h = items.filter(isHidden).length;
			btn.querySelector('.afw-more-label').textContent = h > 0 ? 'Xem thêm (' + h + ')' : 'Thu gọn';
			btn.querySelector('.afw-more-ico-down').classList.toggle('hidden', h === 0);
			btn.querySelector('.afw-more-ico-up').classList.toggle('hidden', h > 0);
			/* Mở rộng hết ⇒ vùng danh sách cuộn trong (không kéo dài sidebar) */
			list.classList.toggle('max-h-64', h === 0);
			list.classList.toggle('overflow-y-auto', h === 0);
			list.classList.toggle('pr-1', h === 0);
		}
		btn.addEventListener('click', function () {
			if (items.some(isHidden)) items.forEach(function (i) { i.classList.remove('hidden'); });
			else collapse();
			updateBtn();
		});
		updateBtn();
		return { btn: btn, update: updateBtn };
	}

	/* ── Checkbox group (filter-items-list) ── */
	function initCheckboxGroup(group) {
		var list = group.querySelector('.filter-items-list');
		if (!list) return;
		var items = Array.prototype.slice.call(list.querySelectorAll('.sapo-filter-item'));
		if (items.length <= FILTER_LIMIT) return;
		var collapse = function () { applyCollapse(items, checkedItem); };
		collapse();

		var frag = document.getElementById('afw-search-tpl').content.cloneNode(true);
		var searchWrap = frag.firstElementChild;
		var noResults = frag.querySelector('.filter-no-results');
		list.parentNode.insertBefore(searchWrap, list);
		list.parentNode.insertBefore(noResults, list);
		var more = makeMoreButton(list, items, collapse);

		searchWrap.querySelector('.filter-group-search').addEventListener('input', function () {
			var q = this.value.trim().toLowerCase();
			var matched = 0;
			if (!q) {
				collapse();
				noResults.classList.add('hidden');
				more.btn.classList.remove('hidden');
				more.update();
				return;
			}
			more.btn.classList.add('hidden');
			items.forEach(function (item) {
				var text = (item.querySelector('.sapo-filter-text') || item).textContent.trim().toLowerCase();
				var show = text.indexOf(q) !== -1;
				item.classList.toggle('hidden', !show);
				if (show) matched++;
			});
			noResults.classList.toggle('hidden', matched !== 0);
			list.classList.add('max-h-64', 'overflow-y-auto', 'pr-1');
		});

		/* Khi checkbox được check từ JS (restore-from-URL): un-hide item */
		list.addEventListener('change', function (e) {
			if (e.target.matches('.filter-checkbox-input') && e.target.checked) {
				var item = e.target.closest('.sapo-filter-item');
				if (item) item.classList.remove('hidden');
			}
			more.update();
		});
	}

	/* ── Pill group (filter-pills-wrapper) ── */
	function initPillGroup(group) {
		var list = group.querySelector('.filter-pills-wrapper');
		if (!list) return;
		var items = Array.prototype.slice.call(list.querySelectorAll('.filter-pill-btn'));
		if (items.length <= FILTER_LIMIT) return;
		var collapse = function () { applyCollapse(items, activePill); };
		collapse();
		makeMoreButton(list, items, collapse);
	}

	/* Chạy sau tất cả DOMContentLoaded handlers (kể cả jQuery restore-from-URL) */
	document.addEventListener('DOMContentLoaded', function () {
		setTimeout(function () {
			document.querySelectorAll('.filter-group').forEach(function (group) {
				initCheckboxGroup(group);
				initPillGroup(group);
			});
			/* Mặc định chỉ mở nhóm đầu; nhóm có mục đang chọn vẫn mở. */
			document.querySelectorAll('.filter-group').forEach(function (group, idx) {
				if (idx === 0) return;
				if (group.querySelector('input:checked, .filter-pill-btn.active, .is-active')) return;
				var tg = group.querySelector('.filter-group-toggle');
				if (tg && tg.getAttribute('aria-expanded') === 'true') tg.click();
			});
		}, 0);
	});
})();
</script>
