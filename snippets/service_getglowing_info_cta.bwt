{%- comment -%}
  service_getglowing_info_cta — 6. Thông tin dịch vụ và đặt lịch: bảng 5 dòng (settings gg_info_N_*), khối "Đặt lịch phân tích
  da 1:1" + hotline, dòng thương hiệu cuối; thanh đặt lịch bám đáy trên mobile (gg_sticky_cta).
  2026-10-03: store.phone/store.address không có trên Sapo ⇒ hotline lấy settings.store_phone.
{%- endcomment -%}
{%- assign gg_cta_url = settings.gg_cta_url | default: '/dat-lich-tu-van' -%}
{%- assign gg_phone = settings.store_phone -%}
<section id="service-booking-section" class="gg-section gg-section--white">
  <div class="container">
    <div class="gg-info">
      <div class="gg-info__main">
        {%- if settings.gg_info_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_info_eyebrow | escape }}</p>{%- endif -%}
        <h2 class="gg-title">{{ settings.gg_info_title | default: 'GetGlowing Micro-Peel 1:1' | escape }}</h2>
        {%- if settings.gg_info_text != blank -%}<p class="gg-lead">{{ settings.gg_info_text | escape }}</p>{%- endif -%}
        <dl class="gg-spec">
          {%- for i in (1..5) -%}
          {%- assign kl = 'gg_info_' | append: i | append: '_label' -%}{%- assign kv = 'gg_info_' | append: i | append: '_value' -%}
          {%- if settings[kl] != blank and settings[kv] != blank -%}
          <div class="gg-spec__row"><dt>{{ settings[kl] | escape }}</dt><dd>{{ settings[kv] | escape }}</dd></div>
          {%- endif -%}
          {%- endfor -%}
        </dl>
      </div>
      <div class="gg-booking">
        <h3 class="gg-booking__title">{{ settings.gg_booking_title | default: 'Đặt lịch phân tích da 1:1' | escape }}</h3>
        <div class="gg-actions">
          <a href="{{ gg_cta_url | escape }}" class="gg-btn gg-btn--primary"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> {{ settings.gg_cta_text | default: 'ĐẶT LỊCH TƯ VẤN 1:1' | escape }}</a>
          {%- if gg_phone != blank -%}
          <a href="tel:{{ gg_phone | remove: ' ' | remove: '.' }}" class="gg-btn gg-btn--light"><i class="fa-solid fa-phone" aria-hidden="true"></i> {{ gg_phone | escape }}</a>
          {%- endif -%}
        </div>
        {%- if settings.gg_brand_lines != blank -%}
        <div class="gg-brand">
          {%- assign gg_lines = settings.gg_brand_lines | newline_to_br | split: '<br />' -%}
          {%- for gg_l in gg_lines -%}{%- assign gg_l = gg_l | strip -%}{%- if gg_l != blank -%}<p{% if forloop.first %} class="gg-brand__name"{% endif %}>{{ gg_l | escape }}</p>{%- endif -%}{%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- if settings.gg_sticky_cta -%}
<div id="peel-mobile-sticky-cta" class="gg-sticky" aria-hidden="true">
  {%- if gg_phone != blank -%}<a href="tel:{{ gg_phone | remove: ' ' | remove: '.' }}" class="gg-btn gg-btn--light" tabindex="-1"><i class="fa-solid fa-phone" aria-hidden="true"></i> Hotline</a>{%- endif -%}
  <a href="{{ gg_cta_url | escape }}" class="gg-btn gg-btn--primary" tabindex="-1"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> {{ settings.gg_cta_text | default: 'ĐẶT LỊCH TƯ VẤN 1:1' | escape }}</a>
</div>
{%- endif -%}
