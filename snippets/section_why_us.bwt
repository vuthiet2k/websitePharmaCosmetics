<section class="pc-section section--subtle pc-why-us-section">
  <div class="container">
    <div class="pc-why-us-grid">

      
      <div class="pc-why-us-quote">
        <div class="pc-quote-card{% if settings.home_why_quote_img != blank %} pc-quote-card--has-img{% endif %}">
          <div class="pc-quote-pattern"></div>
          {% if settings.home_why_quote_img != blank %}
          <div class="pc-quote-card-img">
            <img class="lazyload" width="600" height="450"
              src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVQI12NgAAIABQAABjE+ibYAAAAASUVORK5CYII="
              data-src="{{ settings.home_why_quote_img | img_url: '1024x1024' }}"
              alt="{{ settings.home_why_cite | default: 'Chuyên gia Pharma Cosmetics' | escape }}"
              onerror="this.onerror=null;this.closest('.pc-quote-card').classList.remove('pc-quote-card--has-img');this.closest('.pc-quote-card-img').remove();">
          </div>
          {% endif %}
          <blockquote>
            "{{ settings.home_why_quote | default: 'Làn da là tấm gương phản chiếu sức khỏe. Hãy chăm sóc bằng khoa học.' }}"
          </blockquote>
          <cite>{{ settings.home_why_cite | default: 'Chuyên gia Nguyễn Hoàng Anh — Giám đốc chuyên môn' }}</cite>
        </div>
      </div>

      
      <div class="pc-why-us-content">
        <div class="pc-section-header pc-section-header--left">
          <p class="pc-section-eyebrow">{{ settings.home_why_eyebrow | default: 'Tại sao chọn chúng tôi' }}</p>
          <h2 class="pc-section-title">{{ settings.home_why_title | default: 'Chuyên gia đồng hành cùng lộ trình của bạn' }}</h2>
        </div>
        <div class="pc-features-list">
          <div class="pc-feature-item">
            <div class="pc-feature-icon">
              <i class="{{ settings.home_why_1_icon | default: 'fas fa-user-md' }}"></i>
            </div>
            <div class="pc-feature-text">
              <h4>{{ settings.home_why_1_title | default: 'Chuyên gia tư vấn trực tiếp' }}</h4>
              <p>{{ settings.home_why_1_desc | default: 'Mọi sản phẩm đều được kê đơn dựa trên tình trạng da thực tế qua các buổi tư vấn 1:1 với đội ngũ chuyên gia.' }}</p>
            </div>
          </div>
          <div class="pc-feature-item">
            <div class="pc-feature-icon">
              <i class="{{ settings.home_why_2_icon | default: 'fas fa-certificate' }}"></i>
            </div>
            <div class="pc-feature-text">
              <h4>{{ settings.home_why_2_title | default: '100% Chính hãng' }}</h4>
              <p>{{ settings.home_why_2_desc | default: 'Cam kết nguồn gốc xuất xứ rõ ràng từ các tập đoàn dược phẩm hàng đầu thế giới.' }}</p>
            </div>
          </div>
          <div class="pc-feature-item">
            <div class="pc-feature-icon">
              <i class="{{ settings.home_why_3_icon | default: 'fas fa-flask' }}"></i>
            </div>
            <div class="pc-feature-text">
              <h4>{{ settings.home_why_3_title | default: 'Clinical Results' }}</h4>
              <p>{{ settings.home_why_3_desc | default: 'Hơn 10.000 ca điều trị thành công các vấn đề về mụn, nám và lão hóa chuyên sâu với kết quả được kiểm chứng lâm sàng.' }}</p>
            </div>
          </div>
        </div>
        <a href="{{ settings.home_why_cta_url | default: '/dat-lich-tu-van' }}" class="pc-btn pc-btn-primary pc-why-us-cta">
          {{ settings.home_why_cta_text | default: 'Đặt lịch tư vấn miễn phí' }}
        </a>
      </div>

    </div>
  </div>
</section>
