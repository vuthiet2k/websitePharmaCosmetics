{%- if settings.aside_category_enable -%}
{%- include 'aside-cate' -%}
{%- endif -%}
{%- if settings.aside_filter_enable -%}
{%- comment -%} 2026-10-10: đầu cột lọc "Bộ lọc sản phẩm" + "Xóa tất cả" theo thiết kế (clearAllFiltered trong col.js). {%- endcomment -%}
<div class="pc-filter-head">
	<p class="pc-filter-head__title">{{ settings.collection_filter_heading | default: 'Bộ lọc sản phẩm' | escape }}</p>
	<button type="button" class="pc-filter-head__clear" onclick="clearAllFiltered()">{{ settings.collection_filter_clear_label | default: 'Xóa tất cả' | escape }}</button>
</div>
{%- include 'aside-filter' -%}
{%- endif -%}