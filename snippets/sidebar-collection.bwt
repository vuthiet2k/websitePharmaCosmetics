{%- if settings.aside_category_enable -%}
{%- include 'aside-cate' -%}
{%- endif -%}
{%- if settings.aside_filter_enable -%}
{%- comment -%} 2026-10-10: đầu cột lọc "Bộ lọc sản phẩm" + "Xóa tất cả" theo thiết kế (clearAllFiltered trong col.js). {%- endcomment -%}
<div class="mb-2 flex items-center justify-between gap-3 font-sans">
	<p class="m-0 text-base font-bold text-ink">{{ settings.collection_filter_heading | default: 'Bộ lọc sản phẩm' | escape }}</p>
	<button type="button" class="min-h-[44px] cursor-pointer border-0 bg-transparent p-0 text-sm font-semibold text-primary underline underline-offset-4" onclick="clearAllFiltered()">{{ settings.collection_filter_clear_label | default: 'Xóa tất cả' | escape }}</button>
</div>
{%- include 'aside-filter' -%}
{%- endif -%}