{%- comment -%}
  snippets/page_skinhealthy_services.bwt (viết lại 22/11/2026 — chuẩn dùng chung, PO bỏ CSS riêng Skin Health)
  Danh sách dịch vụ & liệu trình: hero → lưới thẻ ui_product_card (phân trang phía client ui_pagination) → CTA đặt lịch.
  100% Tailwind theo token; không class svcs-*/lt-*, không style tĩnh. Nội dung cấu hình qua settings.skinhealthy_*.
{%- endcomment -%}

{%- assign hero_col = collections[settings.skinhealthy_col_maintenance | default: 'dieu-tri-chuyen-nghiep'] -%}
{%- assign hero_img = hero_col.image.src | default: hero_col.image -%}
{%- if hero_img == blank and hero_col.products.size > 0 -%}
  {%- assign hero_img = hero_col.products.first.featured_image.src | default: hero_col.products.first.featured_image -%}
{%- endif -%}

{%- comment -%} 1. HERO {%- endcomment -%}
<div class="relative overflow-hidden bg-primary-darkest py-14 text-center text-white font-sans lg:py-20">
  {%- if hero_img != blank -%}
    <img src="{{ hero_img | img_url: '1024x1024' }}" alt="{{ hero_col.name | default: 'Dịch vụ Skin Health Beauty' | escape }}" width="1024" height="1024" class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-25" loading="eager" fetchpriority="high">
  {%- endif -%}
  <div class="container relative">
    <div class="mx-auto max-w-4xl">
      <p class="m-0 mb-3 text-xs font-semibold uppercase tracking-wider text-primary-tint">{{ settings.skinhealthy_brand_name | default: 'Skin Health Beauty' }} by Pharma Cosmetics</p>
      <h1 class="m-0 mb-4 text-2xl font-bold leading-tight tracking-tight text-white md:text-4xl">Liệu Trình Chăm Sóc Da Chuyên Sâu Chuẩn Y Khoa</h1>
      <p class="mx-auto mb-6 max-w-2xl text-sm leading-relaxed text-white md:text-base">Mỗi dịch vụ được thiết kế cá nhân hóa theo tình trạng da — từ chăm sóc phục hồi duy trì đến các liệu trình chuyên sâu nhắm mục tiêu, luôn có chuyên gia đồng hành tư vấn 1:1.</p>
      <a href="#danh-sach-dich-vu" class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-btn px-6 text-sm font-semibold !text-btn-text no-underline transition-colors hover:bg-btn-hover">
        <span>Khám phá dịch vụ</span>
        {% include 'ui_icon', name: 'chevron-down', size: 16, label: '' %}
      </a>
    </div>
  </div>
</div>

{%- comment -%} 2. LƯỚI DỊCH VỤ + PHÂN TRANG {%- endcomment -%}
<section id="danh-sach-dich-vu" class="scroll-mt-20 bg-surface-soft py-10 font-sans md:py-16">
  <div class="container">
    {%- assign col_handles = 'dieu-tri-chuyen-nghiep,dieu-tri-chuyen-nghiep-1,dieu-tri-chuyen-nghiep-2,dich-vu' | split: ',' -%}
    <div class="mb-8 flex flex-col justify-between gap-4 border-0 border-b border-solid border-line pb-4 md:flex-row md:items-end">
      <div>
        <p class="m-0 mb-1 text-xs font-semibold uppercase text-primary">Danh mục liệu trình</p>
        <h2 class="m-0 text-xl font-bold text-ink md:text-2xl">Tất cả dịch vụ &amp; Liệu trình trị liệu</h2>
      </div>
      <p class="m-0 text-xs text-ink-muted md:text-sm" id="svcs-count-label">Hiển thị liệu trình chuyên nghiệp</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" id="svcs-grid-container">
      {%- assign rendered_handles = '' -%}
      {%- assign total_svcs = 0 -%}
      {%- for handle in col_handles -%}
        {%- assign c_obj = collections[handle] -%}
        {%- if c_obj and c_obj.products.size > 0 -%}
          {%- for prod in c_obj.products -%}
            {%- unless rendered_handles contains prod.handle -%}
              {%- assign rendered_handles = rendered_handles | append: prod.handle | append: ',' -%}
              {%- assign total_svcs = total_svcs | plus: 1 -%}
              <div class="h-full" data-svc-item>
                {%- include 'ui_product_card', product: prod, tone: '', eager: false, wish: false -%}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if total_svcs == 0 -%}
        <p class="col-span-full m-0 rounded-2xl border border-solid border-line bg-white p-8 text-center text-ink-muted">Hiện chưa có dịch vụ nào trong danh mục. Vui lòng quay lại sau!</p>
      {%- endif -%}
    </div>

    {% include 'ui_pagination', pg_mode: 'js', pg_id: 'svcs-pagination', pg_label: 'Phân trang dịch vụ' %}
  </div>
</section>

{%- comment -%} 3. CTA ĐẶT LỊCH {%- endcomment -%}
{%- assign sh_book_page = pages[settings.skinhealthy_booking_page] -%}
{%- assign sh_book_url = sh_book_page.url | default: pages['dat-lich-tu-van'].url | default: '/dat-lich-tu-van' -%}
<section class="bg-primary-darkest py-12 text-center font-sans text-white md:py-16">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <h2 class="m-0 mb-3 text-xl font-bold text-white md:text-3xl">Chưa Chắc Chắn Nên Bắt Đầu Từ Liệu Trình Nào?</h2>
      <p class="m-0 mb-6 text-sm leading-relaxed text-white md:text-base">Đặt lịch tư vấn miễn phí ngay hôm nay — chuyên gia sẽ phân tích tình trạng da và đề xuất phác đồ điều trị phù hợp nhất cho bạn.</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="{{ sh_book_url }}" class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-btn px-6 text-sm font-semibold !text-btn-text no-underline transition-colors hover:bg-btn-hover">Đặt lịch tư vấn chuyên gia</a>
        <a href="{{ settings.header_stores_url | default: '/he-thong-cua-hang' }}" class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-solid border-white bg-transparent px-6 text-sm font-semibold !text-white no-underline transition-colors hover:bg-white hover:!text-primary-darkest">Xem phòng khám &amp; Cơ sở</a>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  /* 22/11/2026: phân trang phía client — ẩn/hiện bằng thuộc tính hidden (không style tĩnh, không CSS riêng). */
  function init() {
    var perPage = 12;
    var box = document.getElementById('svcs-grid-container');
    var nav = document.getElementById('svcs-pagination');
    var label = document.getElementById('svcs-count-label');
    if (!box || !nav || !window.PcPagination) return;
    var items = Array.prototype.slice.call(box.querySelectorAll('[data-svc-item]'));
    var total = items.length;
    var pages = Math.ceil(total / perPage) || 1;
    if (pages <= 1) {
      window.PcPagination.render(nav, 1, 1);
      if (label) label.textContent = 'Tổng số ' + total + ' liệu trình';
      return;
    }
    function show(page, scroll) {
      var start = (page - 1) * perPage, end = start + perPage;
      items.forEach(function (it, i) { it.hidden = !(i >= start && i < end); });
      if (label) label.textContent = 'Hiển thị ' + (start + 1) + ' - ' + Math.min(end, total) + ' / ' + total + ' liệu trình';
      window.PcPagination.render(nav, pages, page, function (p) { show(p, true); });
      if (scroll) {
        var a = document.getElementById('danh-sach-dich-vu');
        if (a) a.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    show(1, false);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
