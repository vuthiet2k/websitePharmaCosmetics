{%- comment -%}
  collection_vouchers.bwt (2026-10-10) — dải voucher riêng dưới banner trang danh mục (thiết kế design/danh-muc/danh-muc-san-pham.png).
  Người dùng yêu cầu: voucher tách riêng phía trên; ô màu bên trái hiện theo loại giảm — số tiền ("-50K"), phần trăm ("-10%")
  hoặc icon freeship. Dữ liệu = 6 mã promo_coupon_N_* (Admin › Mã giảm giá): N_min_order = mức giảm ("50K", "10%"),
  N_type = loại (để trống ⇒ có "%" là phần trăm, còn lại là số tiền; "freeship" phải chọn tay).
  Giữ lớp .js-copy / .info-button / .popup-coupon để main.js xử lý "Lấy mã" và popup điều kiện như cũ.
{%- endcomment -%}
{%- assign pc_v_count = 0 -%}
{%- for i in (1..6) -%}
  {%- capture pc_v_en -%}promo_coupon_{{ i }}_enable{%- endcapture -%}
  {%- capture pc_v_code -%}promo_coupon_{{ i }}_code{%- endcapture -%}
  {%- if settings[pc_v_en] and settings[pc_v_code] != blank -%}{%- assign pc_v_count = pc_v_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if settings.aside_coupon_enable and pc_v_count > 0 -%}
{%- comment -%} M-22 (17/11/2026): bỏ khung/nền thẻ ngoài, thẻ voucher gọn, khối giảm giá bg-primary, "Lấy mã" nhỏ (vùng bấm 44px mở bằng before:), dải trượt Swiper (pc_swiper_boot) — bỏ class pc-voucher*; giữ móc JS js-copy / info-button / popup-coupon. {%- endcomment -%}
<section class="mb-4 min-[1024px]:max-[1599px]:pr-32" data-vouchers aria-label="{{ settings.collection_voucher_title | default: 'Voucher cho danh mục này' | escape }}">
	{%- capture pc_v_title_html -%}<span class="inline-flex items-center gap-2"><span class="text-primary">{% include 'ui_icon', name: 'ticket', size: 20 %}</span>{{ settings.collection_voucher_title | default: 'Voucher cho danh mục này' | escape }}</span>{%- endcapture -%}
	{%- assign pc_v_sub_t = settings.collection_voucher_subtitle | default: 'Tiết kiệm ngay khi mua sản phẩm' | escape -%}
	{%- assign pc_v_more_t = settings.collection_voucher_more_label | default: 'Xem tất cả' | escape -%}
	{%- include 'ui_section_head', title_html: pc_v_title_html, desc: pc_v_sub_t, url: settings.collection_voucher_more_url, more_text: pc_v_more_t, label: pc_v_more_t, title_class: 'text-base font-bold text-brand-deep', wrap_class: 'mb-2' -%}
	<div class="swiper-container overflow-hidden" data-pc-slider data-gap="12">
		<div class="swiper-wrapper">
		{%- for i in (1..6) -%}
		{%- capture pc_v_en -%}promo_coupon_{{ i }}_enable{%- endcapture -%}
		{%- capture pc_v_code -%}promo_coupon_{{ i }}_code{%- endcapture -%}
		{%- capture pc_v_amount -%}promo_coupon_{{ i }}_min_order{%- endcapture -%}
		{%- capture pc_v_value -%}promo_coupon_{{ i }}_value{%- endcapture -%}
		{%- capture pc_v_cond -%}promo_coupon_{{ i }}_condition{%- endcapture -%}
		{%- capture pc_v_time -%}promo_coupon_{{ i }}_expires{%- endcapture -%}
		{%- capture pc_v_type_key -%}promo_coupon_{{ i }}_type{%- endcapture -%}
		{%- if settings[pc_v_en] and settings[pc_v_code] != blank -%}
		{%- assign pc_v_type = settings[pc_v_type_key] -%}
		{%- if pc_v_type == blank or pc_v_type == 'auto' -%}
			{%- if settings[pc_v_amount] contains '%' -%}{%- assign pc_v_type = 'percent' -%}{%- else -%}{%- assign pc_v_type = 'amount' -%}{%- endif -%}
		{%- endif -%}
		<article data-voucher class="swiper-slide flex !h-auto !w-64 overflow-hidden rounded-xl border border-solid border-line-soft bg-white">
			<div data-voucher-badge class="flex w-16 shrink-0 flex-col items-center justify-center gap-1 bg-primary px-1 text-center text-white" aria-hidden="true">
				{%- if pc_v_type == 'freeship' -%}
				{% include 'ui_icon', name: 'truck', size: 20 %}<span class="text-xs font-bold">{{ settings.collection_voucher_freeship_label | default: 'FREESHIP' | escape }}</span>
				{%- elsif settings[pc_v_amount] != blank -%}
				<strong class="text-sm">-{{ settings[pc_v_amount] | remove: '-' | upcase | escape }}</strong>
				{%- else -%}
				{% include 'ui_icon', name: 'ticket', size: 20 %}
				{%- endif -%}
			</div>
			<div class="flex min-w-0 flex-1 flex-col gap-1 p-2">
				<p class="notranslate m-0 truncate text-sm font-bold text-brand-deep" translate="no">{{ settings[pc_v_code] | escape }}</p>
				{%- if settings[pc_v_value] != blank -%}<p class="m-0 line-clamp-1 text-xs text-ink-muted">{{ settings[pc_v_value] | escape }}</p>{%- endif -%}
				<div class="mt-auto flex items-center justify-between gap-2">
					<button type="button" class="coupon-code js-copy relative min-h-[44px] cursor-pointer rounded-full border-0 bg-btn px-3 text-xs font-bold text-btn-text transition-colors before:absolute before:-inset-2 hover:bg-btn-hover" data-copy="{{ settings[pc_v_code] | escape }}" title="Sao chép mã {{ settings[pc_v_code] | escape }}">{{ settings.collection_voucher_take_label | default: 'Lấy mã' | escape }}</button>
					<button type="button" class="info-button relative inline-flex min-h-[44px] min-w-[44px] shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-ink-muted before:absolute before:-inset-1.5 hover:text-primary" title="Điều kiện áp dụng" aria-label="Điều kiện áp dụng mã {{ settings[pc_v_code] | escape }}" data-coupon="{{ settings[pc_v_code] | escape }}" data-time="{{ settings[pc_v_time] | remove: 'Ngày hết hạn: ' | escape }}" data-content="{{ settings[pc_v_cond] | escape }}">{% include 'ui_icon', name: 'info', size: 20 %}</button>
				</div>
			</div>
		</article>
		{%- endif -%}
		{%- endfor -%}
		</div>
	</div>
</section>
<div class="popup-coupon">
	<div class="content">
		<div class="title">Thông tin voucher</div>
		<div class="close-popup-coupon" title="Đóng"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'x', size: 'em' %}</i></div>
		<ul>
			<li><span>Mã giảm giá:</span> <span class="code"></span></li>
			<li><span>Ngày hết hạn:</span> <span class="time"></span></li>
			<li><span>Điều kiện:</span> <span class="dieukien"></span></li>
		</ul>
	</div>
</div>
{%- include 'pc_swiper_boot' -%}
{%- endif -%}
