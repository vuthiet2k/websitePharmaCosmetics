{%- comment -%}
  pc_article_card.bwt (2026-10-10) — thẻ bài viết theo thiết kế "Kiến thức chăm sóc da" ở trang sản phẩm:
  ảnh + nhãn chủ đề (tag chude:<Nhãn> của bài; không có thì tag thường đầu tiên, '-' đổi thành dấu cách), tiêu đề, tóm tắt,
  chân thẻ: ảnh + tên chuyên gia (tag chuyengia:<handle> tra trong blog settings.expert_blog_handle, như
  templates/article.bwt) hoặc tác giả bài, ngày đăng, nút "Đọc tiếp".
  Đầu vào: article, pc_card_i (thứ tự thẻ, đổi màu nhãn), pc_card_ex_blog (blog chuyên gia đã tra sẵn).
{%- endcomment -%}
{%- assign pc_card_cat = '' -%}
{%- assign pc_card_ex_handle = '' -%}
{%- assign pc_card_topic = '' -%}
{%- for pc_card_tag in article.tags -%}
	{%- if pc_card_tag contains ':' -%}
		{%- assign pc_card_key = pc_card_tag | split: ':' | first | strip | downcase -%}
		{%- if pc_card_key == 'chude' -%}{%- assign pc_card_topic = pc_card_tag | remove_first: 'chude:' | strip -%}{%- endif -%}
		{%- if pc_card_key == 'chuyengia' -%}{%- assign pc_card_ex_handle = pc_card_tag | split: ':' | last | strip -%}{%- endif -%}
	{%- elsif pc_card_cat == blank -%}
		{%- unless pc_card_tag contains 'duocsi_' or pc_card_tag contains 'video' -%}{%- assign pc_card_cat = pc_card_tag -%}{%- endunless -%}
	{%- endif -%}
{%- endfor -%}
{%- if pc_card_topic != blank -%}{%- assign pc_card_cat = pc_card_topic -%}{%- else -%}{%- assign pc_card_cat = pc_card_cat | replace: '-', ' ' -%}{%- endif -%}
{%- assign pc_card_ex = false -%}
{%- if pc_card_ex_handle != blank -%}
	{%- for pc_card_item in pc_card_ex_blog.articles -%}
		{%- assign pc_card_item_handle = pc_card_item.url | split: '/' | last -%}
		{%- if pc_card_item_handle == pc_card_ex_handle -%}{%- assign pc_card_ex = pc_card_item -%}{%- endif -%}
	{%- endfor -%}
{%- endif -%}
{%- assign pc_card_tone = pc_card_i | modulo: 3 -%}
<article class="pc-acard pc-acard--tone{{ pc_card_tone }}">
	<a class="pc-acard__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
		<img src="{% if article.image.src != blank %}{{ article.image.src | img_url: 'large' }}{% else %}{% include 'placeholder_img_url' %}{% endif %}"
			alt="{{ article.title | replace: '"', '' | escape }}" width="580" height="314" loading="lazy">
		{%- if pc_card_cat != blank -%}
		<span class="pc-acard__cat">
			{%- case pc_card_tone -%}
			{%- when 1 -%}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
			{%- when 2 -%}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M10 2l1.8 5.2L17 9l-5.2 1.8L10 16l-1.8-5.2L3 9l5.2-1.8zM18 13l.9 2.1L21 16l-2.1.9L18 19l-.9-2.1L15 16l2.1-.9z"/></svg>
			{%- else -%}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15M5 19l7-7"/></svg>
			{%- endcase -%}
			{{ pc_card_cat | escape }}
		</span>
		{%- endif -%}
	</a>
	<div class="pc-acard__body">
		<h3 class="pc-acard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
		<p class="pc-acard__excerpt">{{ article.summary | default: article.content | strip_html | truncatewords: 26 }}</p>
		<div class="pc-acard__foot">
			<div class="pc-acard__by">
				{%- if pc_card_ex and pc_card_ex.image.src != blank -%}
				<img class="pc-acard__avatar" src="{{ pc_card_ex.image.src | img_url: 'thumb' }}" alt="{{ pc_card_ex.title | escape }}" width="48" height="48" loading="lazy">
				{%- else -%}
				<span class="pc-acard__avatar pc-acard__avatar--blank" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z"/></svg></span>
				{%- endif -%}
				<div class="pc-acard__by-text">
					<span class="pc-acard__name">{% if pc_card_ex %}{{ pc_card_ex.title | escape }}{% else %}{{ article.author | escape }}{% endif %}</span>
					<time class="pc-acard__date" datetime="{{ article.published_on | date: 'yyyy-MM-dd' }}">{{ article.published_on | date: 'dd/MM/yyyy' }}</time>
				</div>
			</div>
			<a class="pc-acard__more" href="{{ article.url }}">{{ settings.product_article_read_label | default: 'Đọc tiếp ...' | escape }} <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg></a>
		</div>
	</div>
</article>
