{%- comment -%}
  pc_article_card.bwt — thẻ bài viết 100% Tailwind (BATCH-05/09 overhaul).
  Đầu vào: article, pc_card_i (thứ tự thẻ), pc_card_ex_blog (blog chuyên gia tra sẵn).
{%- endcomment -%}
{%- assign pc_card_cat = '' -%}
{%- assign pc_card_ex_handle = '' -%}
{%- assign pc_card_topic = '' -%}
{%- for pc_card_tag in article.tags -%}
	{%- if pc_card_tag contains ':' -%}
		{%- assign pc_card_key = pc_card_tag | split: ':' | first | strip | downcase -%}
		{%- if pc_card_key == 'chude' -%}{%- assign pc_card_topic = pc_card_tag | remove_first: 'chude:' | strip -%}{%- endif -%}
		{%- if pc_card_key == 'chuyengia' -%}{%- assign pc_card_ex_handle = pc_card_tag | split: ':' | last | strip -%}{%- endif -%}
	{%- elsif pc_card_cat == blank -%}
		{%- unless pc_card_tag contains 'duocsi_' or pc_card_tag contains 'video' -%}{%- assign pc_card_cat = pc_card_tag -%}{%- endunless -%}
	{%- endif -%}
{%- endfor -%}
{%- if pc_card_topic != blank -%}{%- assign pc_card_cat = pc_card_topic -%}{%- else -%}{%- assign pc_card_cat = pc_card_cat | replace: '-', ' ' -%}{%- endif -%}
{%- assign pc_card_ex = false -%}
{%- if pc_card_ex_handle != blank -%}
	{%- for pc_card_item in pc_card_ex_blog.articles -%}
		{%- assign pc_card_item_handle = pc_card_item.url | split: '/' | last -%}
		{%- if pc_card_item_handle == pc_card_ex_handle -%}{%- assign pc_card_ex = pc_card_item -%}{%- endif -%}
	{%- endfor -%}
{%- endif -%}
<article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-card border border-solid border-line transition-all duration-300">
	<a class="relative block aspect-video overflow-hidden bg-surface" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
		{%- if article.image.src != blank -%}
		<img src="{{ article.image.src | img_url: 'large' }}" alt="{{ article.title | replace: '"', '' | escape }}" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width="580" height="314"{% if pc_card_first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
		{%- else -%}
		<img src="{{ 'PharmaCosmetics.svg' | asset_url }}" alt="{{ article.title | replace: '"', '' | escape }}" class="block h-full w-full bg-white object-contain p-6" width="580" height="314" loading="lazy">
		{%- endif -%}
		{%- if pc_card_cat != blank -%}
		<span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">
			{% include 'ui_icon', name: 'leaf', size: 'em' %}
			{{ pc_card_cat | escape }}
		</span>
		{%- endif -%}
	</a>
	<div class="flex flex-1 flex-col p-4 sm:p-5">
		<h3 class="m-0 mb-2 font-bold text-base leading-snug line-clamp-2">
			<a class="text-ink transition-colors hover:text-primary no-underline" href="{{ article.url }}">{{ article.title | escape }}</a>
		</h3>
		<p class="m-0 mb-4 flex-1 text-sm text-slate-500 line-clamp-3 leading-relaxed">
			{{ article.summary | default: article.content | strip_html | truncatewords: 26 }}
		</p>
		<div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-0 border-t border-solid border-line-soft pt-3">
			<div class="flex items-center gap-2 min-w-0">
				{%- if pc_card_ex and pc_card_ex.image.src != blank -%}
				<img class="h-8 w-8 rounded-full object-cover flex-shrink-0" src="{{ pc_card_ex.image.src | img_url: 'thumb' }}" alt="{{ pc_card_ex.title | escape }}" width="32" height="32" loading="lazy">
				{%- else -%}
				<span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface text-primary flex-shrink-0" aria-hidden="true">
					{% include 'ui_icon', name: 'user', size: 'em' %}
				</span>
				{%- endif -%}
				<div class="flex flex-col min-w-0">
					<span class="text-xs font-semibold text-ink whitespace-nowrap truncate">{% if pc_card_ex %}{{ pc_card_ex.title | escape }}{% else %}{{ article.author | escape }}{% endif %}</span>
					<time class="text-xs text-slate-400 whitespace-nowrap" datetime="{{ article.published_on | date: 'yyyy-MM-dd' }}">{{ article.published_on | date: 'dd/MM/yyyy' }}</time>
				</div>
			</div>
			<a class="inline-flex items-center gap-1 text-xs font-bold uppercase text-primary transition-colors hover:text-secondary whitespace-nowrap no-underline" href="{{ article.url }}">
				{{ settings.product_article_read_label | default: 'Đọc tiếp' | escape }}
				{% include 'ui_icon', name: 'arrow-right', size: 'em' %}
			</a>
		</div>
	</div>
</article>
