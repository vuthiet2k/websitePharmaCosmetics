{% if settings.portal_newsletter_action != blank %}
<section class="news"><div class="wrap"><div><h2>{{ settings.portal_newsletter_title | default: 'Nhận bản tin da liễu mỗi tuần' | escape }}</h2><p>{{ settings.portal_newsletter_desc | escape }}</p></div>
  <form action="{{ settings.portal_newsletter_action | escape }}" method="post" target="_blank" rel="noopener noreferrer"><label class="visually-hidden" for="portal-newsletter-email">Email của bạn</label><input id="portal-newsletter-email" name="EMAIL" type="email" autocomplete="email" placeholder="Email của bạn" required><button class="btn btn-p" type="submit">Đăng ký</button></form>
</div></section>
{% endif %}
