{% if settings.portal_newsletter_action != blank %}
<section class="bg-primary-deep text-white py-10 lg:py-16 font-sans" aria-labelledby="section-newsletter-title">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center">
      <div>
        <h2 class="m-0 text-2xl lg:text-3xl font-bold text-white" id="section-newsletter-title">{{ settings.portal_newsletter_title | default: 'Nhận bản tin da liễu mỗi tuần' | escape }}</h2>
        {%- if settings.portal_newsletter_desc != blank -%}
        <p class="m-0 mt-2 text-sm text-white/80 leading-relaxed">{{ settings.portal_newsletter_desc | escape }}</p>
        {%- endif -%}
      </div>
      <form action="{{ settings.portal_newsletter_action | escape }}" method="post" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row gap-2.5">
        <label class="sr-only" for="portal-newsletter-email">Email của bạn</label>
        <input id="portal-newsletter-email" name="EMAIL" type="email" autocomplete="email" placeholder="Nhập địa chỉ email của bạn" required class="min-h-[44px] flex-1 rounded-full border border-solid border-white/20 bg-white/10 px-4 text-base text-white placeholder:text-white/60 focus:border-white focus:outline-none">
        <button class="inline-flex min-h-[44px] cursor-pointer items-center justify-center rounded-full bg-btn px-6 text-sm font-bold text-btn-text hover:bg-btn-hover transition-colors border-0" type="submit">Đăng ký</button>
      </form>
    </div>
  </div>
</section>
{% endif %}
