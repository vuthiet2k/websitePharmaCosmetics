{%- comment -%}
  03/11/2026 (chủ dự án: trang chủ theo Figma "travel" node 5:2): tiêu đề "Flash sale" + viên tối "Kết thúc sau [đồng hồ]" + "Xem tất cả",
  1 hàng 5 thẻ (home_product_card) — desktop lưới 5 cột (thẻ thứ 6+ ẩn), mobile vuốt ngang tối đa 10 thẻ. Bỏ carousel Swiper,
  khối <style> cũ (nền tối/vàng gold) và tia sét. Giữ nguyên dữ liệu: danh mục home_flashsale_collection, số lượng home_flashsale_limit, phần chữ tô đỏ home_flashsale_title_hl (trống ⇒ không tô),
  bộ đếm ngược chu kỳ (data-countdown + home_flashsale_countdown_end / _cycle_hours, L09), khối mã giảm giá coupon_products.
  CSS: ui-src/css/components.css mục 14.6.
{%- endcomment -%}
{% assign flash_collection = collections[settings.home_flashsale_collection] %}
{% capture flash_fallback_url %}/{{ settings.home_flashsale_collection }}{% endcapture %}
{% assign flash_collection_url = flash_collection.url | default: flash_fallback_url %}
{% assign count = collections[settings.home_flashsale_collection].products_count %}
{%- assign pc_fs_viewall = settings.home_flashsale_viewall_text | default: 'Xem tất cả' -%}
{%- assign pc_fs_limit = settings.home_flashsale_limit | plus: 0 -%}
{%- if pc_fs_limit < 1 or pc_fs_limit > 10 -%}{%- assign pc_fs_limit = 10 -%}{%- endif -%}
<section class="pc-h4 pc-h4-sec section_flash_sale" aria-labelledby="pc-h4-fs-title">
  <div class="pc-h4-wrap">
    <div class="pc-h4-head lg:items-center">
      <div class="pc-h4-fs__top">
        {%- assign pc_fs_title = settings.home_flashsale_title | default: 'Flash sale' | escape -%}
        {%- assign pc_fs_hl = settings.home_flashsale_title_hl | escape -%}
        {%- capture pc_fs_hl_html -%}<em class="pc-h4-hl">{{ pc_fs_hl }}</em>{%- endcapture -%}
        <h2 class="pc-h4-title" id="pc-h4-fs-title">{%- if pc_fs_hl != blank and pc_fs_title contains pc_fs_hl -%}{{ pc_fs_title | replace_first: pc_fs_hl, pc_fs_hl_html }}{%- else -%}{{ pc_fs_title }}{%- endif -%}</h2>
        {%- if settings.home_flashsale_countdown_enable -%}
        <p class="pc-h4-timer m-0"><span>{{ settings.home_flashsale_countdown_title | default: 'Kết thúc sau' | escape }}</span><span class="pc-h4-timer__clock" role="timer" data-countdown="countdown" data-date="{{ settings.home_flashsale_countdown_end }}" data-cycle-hours="{{ settings.home_flashsale_countdown_cycle_hours | default: 0 }}"></span></p>
        {%- endif -%}
      </div>
      {%- if count > 0 -%}<a class="pc-h4-more" href="{{ flash_collection_url | escape }}">{{ pc_fs_viewall | escape }}{% include 'ui_icon', name: 'arrow-right' %}</a>{%- endif -%}
    </div>
    {%- if count > 0 -%}
    <div class="pc-h4-prow pc-h4-prow--one">
      {%- for product in collections[settings.home_flashsale_collection].products limit: pc_fs_limit -%}
        {%- include 'home_product_card', product: product, eager: false -%}
      {%- endfor -%}
    </div>
    {%- else -%}
    <p class="text-sm text-ink-secondary">{{ settings.home_flashsale_empty_text | default: 'Danh mục đang cập nhật sản phẩm.' | escape }}</p>
    {%- endif -%}
    {%- if settings.promo_coupon_home_enable -%}<div class="pc-flashsale__coupons mt-6">{% include 'coupon_products' %}</div>{%- endif -%}
  </div>
</section>
{%- if settings.home_flashsale_countdown_enable -%}
<script>
	(function($){
		"user strict";
		$.fn.Dqdt_CountDown = function( options ) {
			return this.each(function() {
				new  $.Dqdt_CountDown( this, options );
			});
		}
		$.Dqdt_CountDown = function( obj, options ){
			this.options = $.extend({
				autoStart			: true,
				LeadingZero:true,
				DisplayFormat:"<div><span>%%D%%</span> Days</div><div><span>%%H%%</span> Hours</div><div><span>%%M%%</span> Mins</div><div><span>%%S%%</span> Secs</div>",
				FinishMessage:"Hết hạn",
				CountActive:true,
				TargetDate:null
			}, options || {} );
			if( this.options.TargetDate == null || this.options.TargetDate == '' ){
				return ;
			}
			this.timer  = null;
			this.element = obj;
			this.CountStepper = -1;
			this.CountStepper = Math.ceil(this.CountStepper);
			this.SetTimeOutPeriod = (Math.abs(this.CountStepper)-1)*1000 + 990;
			var dthen = new Date(this.options.TargetDate);
			var dnow = new Date();
			if( this.CountStepper > 0 ) {
				ddiff = new Date(dnow-dthen);
			}
			else {
				ddiff = new Date(dthen-dnow);
			}
			gsecs = Math.floor(ddiff.valueOf()/1000);
			this.CountBack(gsecs, this);
		};
		$.Dqdt_CountDown.fn =  $.Dqdt_CountDown.prototype;
		$.Dqdt_CountDown.fn.extend =  $.Dqdt_CountDown.extend = $.extend;
		$.Dqdt_CountDown.fn.extend({
			calculateDate:function( secs, num1, num2 ){
				var s = ((Math.floor(secs/num1))%num2).toString();
				if ( this.options.LeadingZero && s.length < 2) {
					s = "0" + s;
				}
				return "<b>" + s + "</b>";
			},
			CountBack:function( secs, self ){
				if (secs < 0) {
					self.element.innerHTML = '<div class="lof-labelexpired"> '+self.options.FinishMessage+"</div>";
					return;
				}
				clearInterval(self.timer);
				DisplayStr = self.options.DisplayFormat.replace(/%%D%%/g, self.calculateDate( secs,86400,100000) );
				DisplayStr = DisplayStr.replace(/%%H%%/g, self.calculateDate(secs,3600,24));
				DisplayStr = DisplayStr.replace(/%%M%%/g, self.calculateDate(secs,60,60));
				DisplayStr = DisplayStr.replace(/%%S%%/g, self.calculateDate(secs,1,60));
				self.element.innerHTML = DisplayStr;
				if (self.options.CountActive) {
					self.timer = null;
					self.timer =  setTimeout( function(){
						self.CountBack((secs+self.CountStepper),self);
					},( self.SetTimeOutPeriod ) );
				}
			}
		});
		$(document).ready(function(){
			function pad2(n){ return (n < 10 ? '0' : '') + n; }
			$('[data-countdown="countdown"]').each(function(index, el) {
				var $this = $(this);
				var $date = $this.data('date').split("-");
				var anchor = new Date($date[0]+"/"+$date[1]+"/"+$date[2]+" "+$date[3]+":"+$date[4]+":"+$date[5]);
				var cycleHours = parseFloat($this.data('cycle-hours')) || 0;
				var target = anchor;
				// Chu kỳ lặp lại: nếu đã qua mốc, nhảy tới mốc kế tiếp cách nhau cycleHours giờ — tránh hiện "Hết hạn"
				if (cycleHours > 0 && !isNaN(anchor.getTime())) {
					var now = new Date();
					if (now.getTime() > anchor.getTime()) {
						var cycleMs = cycleHours * 3600 * 1000;
						var cycles = Math.ceil((now.getTime() - anchor.getTime()) / cycleMs);
						target = new Date(anchor.getTime() + cycles * cycleMs);
					}
				}
				var targetStr = pad2(target.getMonth()+1)+"/"+pad2(target.getDate())+"/"+target.getFullYear()+" "+pad2(target.getHours())+":"+pad2(target.getMinutes())+":"+pad2(target.getSeconds());
				$this.Dqdt_CountDown({
					TargetDate: targetStr,
					DisplayFormat:"<span class=\"block-timer\"><b>%%D%%</b><span class=\"sr-only\"> ngày</span></span><span class=\"block-timer\"><b>%%H%%</b><span class=\"sr-only\"> giờ</span></span><span class=\"block-timer\"><b>%%M%%</b><span class=\"sr-only\"> phút</span></span><span class=\"block-timer\"><b>%%S%%</b><span class=\"sr-only\"> giây</span></span>",
					FinishMessage: {{ settings.home_flashsale_finish_text | default: 'Hết hạn' | escape | json }}
				});
			});
		});
	})(jQuery);
</script>
{%- endif -%}
