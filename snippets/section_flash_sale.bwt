{%- comment -%}
  section_flash_sale.bwt — Khối Flash sale trang chủ.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa, không dùng class CSS tự sinh.
{%- endcomment -%}
{% assign flash_collection = collections[settings.home_flashsale_collection] %}
{% capture flash_fallback_url %}/{{ settings.home_flashsale_collection }}{% endcapture %}
{% assign flash_collection_url = flash_collection.url | default: flash_fallback_url %}
{% assign count = collections[settings.home_flashsale_collection].products_count %}
{%- assign pc_fs_viewall = settings.home_flashsale_viewall_text | default: 'Xem tất cả' -%}
{%- assign pc_fs_limit = settings.home_flashsale_limit | plus: 0 -%}
{%- if pc_fs_limit < 1 or pc_fs_limit > 10 -%}{%- assign pc_fs_limit = 10 -%}{%- endif -%}
<section class="py-10 lg:py-16 font-sans text-ink section_flash_sale" aria-labelledby="section-flash-sale-title">
  <div class="container">
    {%- comment -%} M-02/M-11 (17/11/2026): đầu section dùng ui_section_head (link "Xem tất cả" = nút tròn icon ở mobile); nhãn đồng hồ "Thời gian khuyến mãi", bỏ dấu ":" thừa. {%- endcomment -%}
    {%- assign pc_fs_title = settings.home_flashsale_title | default: 'Flash sale' | escape -%}
    {%- assign pc_fs_hl = settings.home_flashsale_title_hl | escape -%}
    {%- capture pc_fs_hl_html -%}<em class="not-italic text-sale">{{ pc_fs_hl }}</em>{%- endcapture -%}
    {%- capture pc_fs_countdown -%}{%- if settings.home_flashsale_countdown_enable -%}<span class="inline-flex items-center text-base font-bold text-sale" role="timer" aria-label="{{ settings.home_flashsale_countdown_title | default: 'Thời gian khuyến mãi' | escape }}" data-countdown="countdown" data-date="{{ settings.home_flashsale_countdown_end }}" data-cycle-hours="{{ settings.home_flashsale_countdown_cycle_hours | default: 0 }}"></span>{%- endif -%}{%- endcapture -%}
    {%- comment -%} 20/11/2026 (chủ dự án gửi mẫu): icon lớn bên trái cao bằng 2 dòng; cột phải = tiêu đề ở trên, đồng hồ đếm ngược xuống dòng ngay dưới tiêu đề. {%- endcomment -%}
    {%- capture pc_fs_title_html -%}<span class="flex items-center gap-x-2"><img src="{{ 'flash_-1.png' | asset_url }}" alt="" width="70" height="70" class="block h-[70px] w-[70px] shrink-0 object-contain animate-bounce lg:h-[76px] lg:w-[76px]" data-pc-motion aria-hidden="true"><span class="flex flex-col items-start gap-y-1"><span class="block">{%- if pc_fs_hl != blank and pc_fs_title contains pc_fs_hl -%}{{ pc_fs_title | replace_first: pc_fs_hl, pc_fs_hl_html }}{%- else -%}{{ pc_fs_title }}{%- endif -%}</span>{%- if pc_fs_countdown != blank -%}<span class="block">{{ pc_fs_countdown }}</span>{%- endif -%}</span></span>{%- endcapture -%}
    {%- if count > 0 -%}{%- assign pc_fs_url = flash_collection_url | escape -%}{%- else -%}{%- assign pc_fs_url = '' -%}{%- endif -%}
    {%- assign pc_fs_viewall_t = pc_fs_viewall | escape -%}
    {%- include 'ui_section_head', title_html: pc_fs_title_html, title_id: 'section-flash-sale-title', url: pc_fs_url, more_text: pc_fs_viewall_t, label: pc_fs_viewall_t, wrap_class: 'mb-4 lg:mb-8' -%}

    {%- if count > 0 -%}
    <div class="relative group/fs">
      <div class="swiper-container overflow-hidden" id="flashsale-swiper">
        <div class="swiper-wrapper">
          {%- for product in collections[settings.home_flashsale_collection].products limit: pc_fs_limit -%}
            <div class="swiper-slide !h-auto">
              {%- include 'ui_product_card', product: product, tone: 'sale', eager: false, wish: false -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <button type="button" class="flashsale-prev max-md:hidden md:inline-flex absolute -left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm trước">
        {% include 'ui_icon', name: 'chevron-left', size: '18' %}
      </button>
      <button type="button" class="flashsale-next max-md:hidden md:inline-flex absolute -right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-solid border-line-soft items-center justify-center text-brand-deep hover:bg-primary hover:text-white hover:border-primary transition-all disabled:opacity-0 disabled:pointer-events-none cursor-pointer" aria-label="Sản phẩm tiếp theo">
        {% include 'ui_icon', name: 'chevron-right', size: '18' %}
      </button>
      <div class="flashsale-pagination flex justify-center items-center gap-1.5 mt-4 md:hidden"></div>
    </div>
    {%- else -%}
    <p class="text-sm text-ink-muted m-0">{{ settings.home_flashsale_empty_text | default: 'Danh mục đang cập nhật sản phẩm.' | escape }}</p>
    {%- endif -%}

    {%- if settings.promo_coupon_home_enable -%}
      <div class="mt-6">{% include 'coupon_products' %}</div>
    {%- endif -%}
  </div>
</section>

{%- if settings.home_flashsale_countdown_enable -%}
<script>
(function () {
  var FINISH = {{ settings.home_flashsale_finish_text | default: 'Hết hạn' | escape | json }};
  var UNITS = [['d', 86400, ' ngày'], ['h', 3600, ' giờ'], ['m', 60, ' phút'], ['s', 1, ' giây']];
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function target(el) {
    var p = String(el.getAttribute('data-date') || '').split('-');
    if (p.length < 6) return null;
    var t = new Date(+p[0], +p[1] - 1, +p[2], +p[3], +p[4], +p[5]).getTime();
    if (isNaN(t)) return null;
    var cyc = parseFloat(el.getAttribute('data-cycle-hours')) || 0, now = Date.now();
    if (cyc > 0 && now > t) { var ms = cyc * 3600000; t += Math.ceil((now - t) / ms) * ms; }
    return t;
  }
  function init(el) {
    var end = target(el); if (end == null) return;
    var boxes = {};
    UNITS.forEach(function (u, k) {
      if (k > 0) {
        var sep = document.createElement('span');
        sep.className = 'mx-px text-base font-bold text-sale';
        sep.setAttribute('aria-hidden', 'true');
        sep.textContent = ':';
        el.appendChild(sep);
        boxes[u[0] + 'sep'] = sep;
      }
      var b = document.createElement('span');
      b.className = 'inline-flex h-7 min-w-7 items-center justify-center overflow-hidden rounded-[6px] bg-sale px-1 text-sm font-bold tabular-nums text-white';
      b.innerHTML = '<b class="inline-block"></b><span class="sr-only">' + u[2] + '</span>';
      el.appendChild(b);
      boxes[u[0]] = b;
    });
    function tick() {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left < 0) { clearInterval(timer); el.textContent = FINISH; return; }
      var showDay = left >= 86400;
      boxes.d.classList.toggle('hidden', !showDay); boxes.hsep.classList.toggle('hidden', !showDay);
      UNITS.forEach(function (u) {
        var v = u[0] === 'd' ? Math.floor(left / 86400) : Math.floor(left / u[1]) % (u[0] === 'h' ? 24 : 60);
        var b = boxes[u[0]], num = b.firstChild, txt = pad(v);
        if (num.textContent !== txt) {
          var changed = num.textContent !== '';
          num.textContent = txt;
          /* Số mới trượt vào như Shopee: gỡ rồi gắn lại class để chạy lại animation (motion-safe: tôn trọng reduced-motion). */
          num.classList.remove('motion-safe:animate-tick');
          if (changed) { void num.offsetWidth; num.classList.add('motion-safe:animate-tick'); }
        }
      });
    }
    tick();
    var timer = setInterval(tick, 1000);
  }
  function run() { Array.prototype.forEach.call(document.querySelectorAll('[data-countdown="countdown"]'), init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
})();
</script>
{%- endif -%}

{%- if count > 0 -%}
<script>
(function () {
  function initFlashSaleSwiper() {
    var el = document.getElementById('flashsale-swiper');
    if (!el || el.swiper) return;
    if (typeof Swiper !== 'function') {
      window.addEventListener('load', initFlashSaleSwiper);
      return;
    }
    new Swiper(el, {
      slidesPerView: 2.2,
      spaceBetween: 12,
      watchOverflow: true,
      navigation: {
        prevEl: '.flashsale-prev',
        nextEl: '.flashsale-next'
      },
      pagination: {
        el: '.flashsale-pagination',
        clickable: true,
        dynamicBullets: true
      },
      breakpoints: {
        640: {
          slidesPerView: 3,
          spaceBetween: 16
        },
        768: {
          slidesPerView: 4,
          spaceBetween: 16
        },
        1024: {
          slidesPerView: 5,
          spaceBetween: 16
        }
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlashSaleSwiper);
  } else {
    initFlashSaleSwiper();
  }
})();
</script>
{%- endif -%}
