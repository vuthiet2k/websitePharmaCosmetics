{%- comment -%}
  03/11/2026 (chủ dự án: trang chủ theo Figma "travel" node 5:2): tiêu đề "Flash sale" + viên tối "Kết thúc sau [đồng hồ]" + "Xem tất cả",
  03/11/2026 (chủ dự án, lần 2): thêm lại icon tia sét (assets/flash_-1.png), tiêu đề + giá + nút thẻ màu đỏ (tone 'sale'),
  đồng hồ ô số đỏ có hiệu ứng lật (script cuối file, thay plugin jQuery Dqdt_CountDown).
  1 hàng 5 thẻ (home_product_card) — desktop lưới 5 cột (thẻ thứ 6+ ẩn), mobile vuốt ngang tối đa 10 thẻ. Bỏ carousel Swiper,
  khối <style> cũ (nền tối/vàng gold) và tia sét. Giữ nguyên dữ liệu: danh mục home_flashsale_collection, số lượng home_flashsale_limit, phần chữ tô đỏ home_flashsale_title_hl (trống ⇒ không tô),
  bộ đếm ngược chu kỳ (data-countdown + home_flashsale_countdown_end / _cycle_hours, L09), khối mã giảm giá coupon_products.
  CSS: ui-src/css/components.css mục 14.6.
{%- endcomment -%}
{% assign flash_collection = collections[settings.home_flashsale_collection] %}
{% capture flash_fallback_url %}/{{ settings.home_flashsale_collection }}{% endcapture %}
{% assign flash_collection_url = flash_collection.url | default: flash_fallback_url %}
{% assign count = collections[settings.home_flashsale_collection].products_count %}
{%- assign pc_fs_viewall = settings.home_flashsale_viewall_text | default: 'Xem tất cả' -%}
{%- assign pc_fs_limit = settings.home_flashsale_limit | plus: 0 -%}
{%- if pc_fs_limit < 1 or pc_fs_limit > 10 -%}{%- assign pc_fs_limit = 10 -%}{%- endif -%}
<section class="pc-h4 pc-h4-sec section_flash_sale" aria-labelledby="pc-h4-fs-title">
  <div class="pc-h4-wrap">
    <div class="pc-h4-head lg:items-center">
      <div class="pc-h4-fs__top">
        {%- assign pc_fs_title = settings.home_flashsale_title | default: 'Flash sale' | escape -%}
        {%- assign pc_fs_hl = settings.home_flashsale_title_hl | escape -%}
        {%- capture pc_fs_hl_html -%}<em class="pc-h4-hl">{{ pc_fs_hl }}</em>{%- endcapture -%}
        <h2 class="pc-h4-title pc-h4-fs__title" id="pc-h4-fs-title"><img class="pc-h4-fs__bolt" src="{{ 'flash_-1.png' | asset_url }}" alt="" width="32" height="32" aria-hidden="true">{%- if pc_fs_hl != blank and pc_fs_title contains pc_fs_hl -%}{{ pc_fs_title | replace_first: pc_fs_hl, pc_fs_hl_html }}{%- else -%}{{ pc_fs_title }}{%- endif -%}</h2>
        {%- if settings.home_flashsale_countdown_enable -%}
        <p class="pc-h4-timer m-0"><span class="pc-h4-timer__label">{{ settings.home_flashsale_countdown_title | default: 'Kết thúc sau' | escape }}</span><span class="pc-h4-timer__clock" role="timer" data-countdown="countdown" data-date="{{ settings.home_flashsale_countdown_end }}" data-cycle-hours="{{ settings.home_flashsale_countdown_cycle_hours | default: 0 }}"></span></p>
        {%- endif -%}
      </div>
      {%- if count > 0 -%}<a class="pc-h4-more" href="{{ flash_collection_url | escape }}">{{ pc_fs_viewall | escape }}{% include 'ui_icon', name: 'arrow-right' %}</a>{%- endif -%}
    </div>
    {%- if count > 0 -%}
    <div class="pc-h4-prow pc-h4-prow--one">
      {%- for product in collections[settings.home_flashsale_collection].products limit: pc_fs_limit -%}
        {%- include 'home_product_card', product: product, eager: false, tone: 'sale' -%}
      {%- endfor -%}
    </div>
    {%- else -%}
    <p class="text-sm text-ink-secondary">{{ settings.home_flashsale_empty_text | default: 'Danh mục đang cập nhật sản phẩm.' | escape }}</p>
    {%- endif -%}
    {%- if settings.promo_coupon_home_enable -%}<div class="pc-flashsale__coupons mt-6">{% include 'coupon_products' %}</div>{%- endif -%}
  </div>
</section>
{%- if settings.home_flashsale_countdown_enable -%}
<script>
/* 03/11/2026 (chủ dự án): đồng hồ kiểu ô số đỏ (giống sàn TMĐT) — dựng ô 1 lần, mỗi giây chỉ đổi chữ số; ô vừa đổi
   chạy hiệu ứng lật (CSS .is-tick, tắt khi prefers-reduced-motion). Ô "ngày" chỉ hiện khi còn ≥ 1 ngày.
   Giữ logic cũ: mốc data-date "YYYY-MM-DD-hh-mm-ss", chu kỳ lặp data-cycle-hours (L09 — giá đổi theo ngày, không phải dark pattern). */
(function () {
  var FINISH = {{ settings.home_flashsale_finish_text | default: 'Hết hạn' | escape | json }};
  var UNITS = [['d', 86400, ' ngày'], ['h', 3600, ' giờ'], ['m', 60, ' phút'], ['s', 1, ' giây']];
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function target(el) {
    var p = String(el.getAttribute('data-date') || '').split('-');
    if (p.length < 6) return null;
    var t = new Date(+p[0], +p[1] - 1, +p[2], +p[3], +p[4], +p[5]).getTime();
    if (isNaN(t)) return null;
    var cyc = parseFloat(el.getAttribute('data-cycle-hours')) || 0, now = Date.now();
    if (cyc > 0 && now > t) { var ms = cyc * 3600000; t += Math.ceil((now - t) / ms) * ms; }
    return t;
  }
  function init(el) {
    var end = target(el); if (end == null) return;
    var boxes = {};
    UNITS.forEach(function (u, k) {
      if (k > 0) { var sep = document.createElement('span'); sep.className = 'pc-h4-timer__sep'; sep.setAttribute('aria-hidden', 'true'); sep.textContent = ':'; el.appendChild(sep); boxes[u[0] + 'sep'] = sep; }
      var b = document.createElement('span'); b.className = 'pc-h4-timer__box';
      b.innerHTML = '<b></b><span class="sr-only">' + u[2] + '</span>';
      el.appendChild(b); boxes[u[0]] = b;
    });
    function tick() {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left < 0) { clearInterval(timer); el.textContent = FINISH; return; }
      var showDay = left >= 86400;
      boxes.d.hidden = !showDay; boxes.hsep.hidden = !showDay;
      UNITS.forEach(function (u) {
        var v = u[0] === 'd' ? Math.floor(left / 86400) : Math.floor(left / u[1]) % (u[0] === 'h' ? 24 : 60);
        var b = boxes[u[0]], num = b.firstChild, txt = pad(v);
        if (num.textContent !== txt) {
          var first = num.textContent === '';
          num.textContent = txt;
          if (!first) { b.classList.remove('is-tick'); void b.offsetWidth; b.classList.add('is-tick'); }
        }
      });
    }
    tick(); var timer = setInterval(tick, 1000);
  }
  function run() { Array.prototype.forEach.call(document.querySelectorAll('[data-countdown="countdown"]'), init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
})();
</script>
{%- endif -%}
