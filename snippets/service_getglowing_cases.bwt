{%- comment -%}
  service_getglowing_cases — 5. Thư viện kết quả trước và sau. Chỉ ca có ĐỦ ảnh trước + sau mới hiện; không ca nào đủ ⇒ ẩn cả
  phần (2026-10-17: trước đây hiện ô "[Vị trí ảnh trước]" + nhãn "Chờ đối soát" cho khách xem). Ảnh phải là ca GetGlowing thực tế
  có đồng ý, cùng góc chụp/ánh sáng; không dùng ảnh Skin Renewal Peeling System.
{%- endcomment -%}
{%- assign gg_cases = 0 -%}
{%- for n in (1..2) -%}
{%- assign kb = 'gg_case_' | append: n | append: '_before' -%}{%- assign ka = 'gg_case_' | append: n | append: '_after' -%}
{%- if settings[kb] != blank and settings[ka] != blank -%}{%- assign gg_cases = gg_cases | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if gg_cases > 0 -%}
<section id="service-cases-section" class="gg-section gg-section--soft">
  <div class="container">
    <header class="gg-head">
      {%- if settings.gg_cases_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_cases_eyebrow | escape }}</p>{%- endif -%}
      <h2 class="gg-title">{{ settings.gg_cases_title | default: 'Theo dõi sự thay đổi của từng làn da' | escape }}</h2>
      {%- if settings.gg_cases_text != blank -%}<p class="gg-lead">{{ settings.gg_cases_text | escape }}</p>{%- endif -%}
    </header>
    <div class="gg-cases">
      {%- for n in (1..2) -%}
      {%- assign kb = 'gg_case_' | append: n | append: '_before' -%}{%- assign ka = 'gg_case_' | append: n | append: '_after' -%}
      {%- assign kt = 'gg_case_' | append: n | append: '_title' -%}{%- assign kn = 'gg_case_' | append: n | append: '_note' -%}
      {%- if settings[kb] != blank and settings[ka] != blank -%}
      <article class="gg-card gg-case">
        <h3 class="gg-card__title"><span class="gg-step__no">Case 0{{ n }}</span> {{ settings[kt] | escape }}</h3>
        <div class="gg-case__pair">
          <figure><div class="gg-media gg-media--4x3"><img src="{{ settings[kb] | img_url: 'large' }}" alt="{{ settings[kt] | escape }} — trước điều trị" width="1200" height="900" loading="lazy" decoding="async"></div><figcaption>Trước điều trị</figcaption></figure>
          <figure><div class="gg-media gg-media--4x3"><img src="{{ settings[ka] | img_url: 'large' }}" alt="{{ settings[kt] | escape }} — sau điều trị" width="1200" height="900" loading="lazy" decoding="async"></div><figcaption>Sau điều trị</figcaption></figure>
        </div>
        {%- if settings[kn] != blank -%}<p class="gg-card__text">{{ settings[kn] | escape }}</p>{%- endif -%}
      </article>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if settings.gg_cases_disclaimer != blank -%}<p class="gg-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ settings.gg_cases_disclaimer | escape }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}
