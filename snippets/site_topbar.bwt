{% assign announcement_text = settings.header_topbar_text %}
{% if topbar_context == 'clinic' and settings.skinhealthy_announce != blank %}{% assign announcement_text = settings.skinhealthy_announce %}{% endif %}
{% assign announcements = announcement_text | split: ';' %}
{% assign topbar_phone = settings.store_phone | default: store.phone_number %}
{% assign topbar_account_label = settings.header_topbar_account_label | default: 'Tài khoản' %}
<div class="pc-topbar" data-topbar data-delay="{{ settings.header_topbar_delay | default: 4000 }}" data-autoplay="{{ settings.header_topbar_autoplay }}" style="--pc-topbar-bg:{{ settings.header_topbar_bg | default: '#3CB371' }};--pc-topbar-fg:{{ settings.header_topbar_text_color | default: '#FFFFFF' }}">
  <div class="container pc-topbar__inner">
    <div class="pc-topbar__announcements" aria-label="{{ settings.header_topbar_label | default: 'Thông tin nổi bật' | escape }}">
      <div class="topbar-slider swiper-container" aria-roledescription="carousel">
        <div class="swiper-wrapper">
          {% for message in announcements %}{% assign message_text = message | strip %}{% if message_text != blank %}
          <div class="swiper-slide"><span class="pc-topbar__dot" aria-hidden="true"></span><span class="pc-topbar__message">{{ message_text | escape }}</span></div>
          {% endif %}{% endfor %}
        </div>
      </div>
      {%- comment -%} 2026-10-13 (người dùng): bỏ nút tạm dừng dải thông báo; vẫn dừng khi rê chuột, tắt khi giảm chuyển động (assets/site-topbar.js). {%- endcomment -%}
    </div>
    <div class="pc-topbar__actions">
      <div class="lang-switcher pc-topbar__action notranslate" id="langSwitcher" translate="no">
        <button class="lang-btn" id="langBtn" type="button" aria-label="Chọn ngôn ngữ" aria-expanded="false" aria-controls="langList">
          <img id="langFlag" src="{{ 'flag-vn.svg' | asset_url }}" width="20" height="14" alt="">
          <span id="langLabel">Tiếng Việt</span>
          <i class="fa-solid fa-chevron-down pc-topbar__chevron" aria-hidden="true"></i>
        </button>
        <ul class="lang-list" id="langList" hidden>
          {% assign languages = 'vi,en,zh-CN,ja,ko' | split: ',' %}
          {% assign language_labels = 'Tiếng Việt,English,中文,日本語,한국어' | split: ',' %}
          {% assign language_flags = 'flag-vn.svg,flag-us.svg,flag-cn.svg,flag-jp.svg,flag-kr.svg' | split: ',' %}
          {% for language in languages %}<li><button type="button" data-lang="{{ language }}" data-label="{{ language_labels[forloop.index0] }}" data-flag="{{ language_flags[forloop.index0] | asset_url }}"><img src="{{ language_flags[forloop.index0] | asset_url }}" width="20" height="14" alt="">{{ language_labels[forloop.index0] }}</button></li>{% endfor %}
        </ul>
      </div>
      {% if topbar_phone != blank %}
      <a class="pc-topbar__phone pc-topbar__action" href="tel:{{ topbar_phone | remove: ' ' | remove: '.' | remove: '-' }}" aria-label="Gọi {{ topbar_phone | escape }}">
        <i class="fa-solid fa-phone pc-topbar__icon" aria-hidden="true"></i>
        <span>{{ topbar_phone | escape }}</span>
      </a>
      {% endif %}
      <div class="topbar-account pc-topbar__action" id="topbarAccount">
        <button class="topbar-account-btn" type="button" aria-expanded="false" aria-controls="topbarAccountList">
          <i class="fa-regular fa-user pc-topbar__icon" aria-hidden="true"></i>
          <span>{% if customer %}{{ customer.name | escape }}{% else %}{{ topbar_account_label | escape }}{% endif %}</span>
          <i class="fa-solid fa-chevron-down pc-topbar__chevron" aria-hidden="true"></i>
        </button>
        <ul class="topbar-account-list" id="topbarAccountList" hidden>
          {% if customer %}<li><a href="/account">{{ topbar_account_label | escape }}</a></li><li><a href="/account/logout">Đăng xuất</a></li>{% else %}<li><a href="/account/login">Đăng nhập</a></li><li><a href="/account/register">Đăng ký</a></li>{% endif %}
        </ul>
      </div>
    </div>
  </div>
  <div id="google_translate_element" hidden></div>
  <span id="translation-status" class="pc-topbar__status" role="status"></span>
</div>
