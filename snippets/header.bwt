{%if settings.use_banner_top%}
<div class="banner-top" style="background: {{settings.color_banner_top}}">
	<a class="duration-300" href="{{settings.link_banner_top}}" title="{{settings.alt_banner_top}}">
		<picture>
			<source media="(max-width: 767px)" srcset="{{ 'banner_top.jpg' | asset_url }}"/>
			<img width="1920" height="80" loading="lazy" class="lazyload duration-300" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{'banner_top.jpg' | asset_url}}" alt="{{settings.alt_banner_top}}"/>
		</picture>
	</a>
</div>
{%endif%}
{%- comment -%}
  Header top: khuyến mãi, ngôn ngữ, hotline và tài khoản.
  Header main: logo, menu, tìm kiếm và giỏ hàng nằm cùng một hàng trên desktop.
  Khi cuộn qua header, menu tách thành thanh cố định và mới hiện nút Danh mục.
  Giữ một menu duy nhất để dùng chung điều hướng desktop và drawer mobile.
{%- endcomment -%}
<header class="header">
	<div class="main-header">
			{%- comment -%} ============ PHẦN 1 — HEADER TOP (topbar xanh) ============ {%- endcomment -%}
		{% include 'site_topbar' %}
			{%- comment -%} ============ PHẦN 2 — HEADER MAIN (logo + menu + tìm kiếm + giỏ hàng, nền trắng) ============ {%- endcomment -%}
			<div class="box-hearder">
		<div class="container">
				<div class="row d-flex align-items-center pc-header-row">
					<div class="col-6 col-xl-3 col-lg-3 col-md-4 header-logo">
						<a href="/" class="logo-wrapper pc-logo-master" title="{{settings.store_name | default: store.name}}">
							{%- comment -%}
								T-121 (2026-09-12) — người dùng yêu cầu trực tiếp: "logo lấy từ
								design/Pharma Cosmetics/test_full_logo.html để màu main". Logo Master Vector
								đầy đủ (icon + tên + tagline dệt sẵn trong SVG, fill="currentColor") thay cho
								icon nhỏ + text HTML rời trước đây. Màu do CSS `color` của .pc-logo-master quyết
								định (xem snippets/pharma_ui_kit.bwt — đặt var(--mainColor) trên nền trắng của
								.box-hearder). aria-label/title vẫn dùng settings.store_name để giữ SEO/tên
								store thật có thể tuỳ biến qua schema-admin dù logo là ảnh vector cố định.
							{%- endcomment -%}
							{% include 'logo-master-svg' %}
						</a>
					</div>
					{%- comment -%} Menu dùng chung: nằm trong header chính, tách ra khi cuộn trên desktop. {%- endcomment -%}
					<div class="header-menu">
						<div class="container">
							<div class="navigation-horizontal">
								<div class="mb-drawer-topbar md-hidden">
									<a href="/" class="mb-drawer-logo" title="{{settings.store_name | default: store.name}}">
										{%- if settings['logo.png'] != blank -%}
										<img src="{{ settings['logo.png'] | img_url: 'large' }}"
											width="146" height="36"
											alt="{{settings.store_name | default: store.name}}"
											onerror="this.onerror=null;this.src='{{ 'logoPC.svg' | asset_url }}'">
										{%- else -%}
										<img src="{{ 'logoPC.svg' | asset_url }}" width="40" height="40" alt="{{settings.store_name | default: store.name}}">
										{%- endif -%}
									</a>
									<button class="close-mb-menu mb-drawer-close" aria-label="Đóng menu">
										<i class="fas fa-xmark"></i>
									</button>
								</div>
								<div class="row">
									<div class="col-lg-2 col-sm-12 col-xs-12 col-12 sudes-cate-header">
										<button type="button" class="title js-menu-toggle" aria-expanded="false" aria-controls="header-category-menu">
											<span class="line-clamp line-clamp-1">{{settings.header_nav_title}}</span>
											<svg class="scg_drop" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.7138 16.7077L21.7048 7.71374C22.0984 7.31909 22.0984 6.6797 21.7048 6.28406C21.3111 5.88941 20.6717 5.88941 20.2781 6.28406L12.0005 14.5646L3.72293 6.28505C3.32928 5.89041 2.68989 5.89041 2.29524 6.28505C1.90159 6.6797 1.90159 7.32009 2.29524 7.71474L11.2861 16.7087C11.6757 17.0973 12.3251 17.0973 12.7138 16.7077Z" fill="currentColor"></path></svg>
										</button>
										{%include 'bean-menu-cate'%}
									</div>
									<div class="col-lg-10 col-sm-12 col-xs-12 col-12 sudes-main-header">
										<div class="col-menu {%if settings.btn_promotion_enable%}has-promo-btn{%endif%}">
											{%include 'site-nav'%}
										</div>
										<div class="control-menu">
											<a href="#" id="prev" aria-label="Mục menu trước"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="#fff" d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 278.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"/></svg></a>
											<a href="#" id="next" aria-label="Mục menu tiếp theo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="#fff" d="M342.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L274.7 256 105.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/></svg></a>
										</div>
										{%if settings.header_live_enable%}
										<div class="header-box-live">
											<button style="--header-live-color:#ff0000" class="btn-live transition-all hover:scale-105">{{settings.header_live_title}}</button>
										</div>
										{%endif%}
										{%if settings.btn_promotion_enable%}
										<div class="button-promo">
											<a  href="{{settings.btn_promotion_url}}" title="{{settings.btn_promotion_title}}" class="duration-300">
												<img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{'search_order.png' | asset_url}}" alt="{{settings.btn_promotion_title}}" class="lazyload"/>
												<span>{{settings.btn_promotion_title}}</span>
											</a>
										</div>
										{%endif%}
									</div>

								</div>
												<ul class="md-hidden mb-drawer-secondary">
									{%- comment -%}
										G01 (phase home-shopping-ux, 2026-09-20): ẩn mục "Tích điểm đổi quà" khỏi menu
										mobile theo yêu cầu. Không xoá hẳn để còn bật lại được bằng 1 setting khi cần —
										không phải CSS display:none (phần tử vẫn còn DOM/focus được), mà loại hẳn khỏi
										cây render khi tắt. Dữ liệu/tích hợp loyalty thật (appbulk-loyalty-widgets,
										page.loyalty, data/loyalty-tiers.js) giữ nguyên, chỉ ẩn đường điều hướng này.
									{%- endcomment -%}
									{%- if settings.header_loyalty_enable -%}
									<li><a href="https://pharmacosmetics-vn.com/apps/tich-diem-doi-qua" title="Tích điểm đổi quà">Tích điểm đổi quà</a></li>
									{%- endif -%}
									{%- if settings.home_ai_guide_menu_enable -%}
									<li><a href="{{ settings.home_ai_guide_cta_url | default: '/kham-da-ai' | escape }}" title="Quiz da cùng AI">{{ settings.home_ai_guide_menu_label | default: 'Quiz da cùng AI' | escape }}</a></li>
									{%- endif -%}
									{%- if settings.iwish_enable -%}
									<li><a href="{{ pages[settings.wishlist_page].url }}" title="Sản phẩm yêu thích">Sản phẩm yêu thích <span class="js-wishlist-count" style="display:none">0</span></a></li>
									{%- endif -%}
									{%- if settings.header_stores_enable -%}
									<li><a href="{{settings.header_stores_url}}" title="{{settings.header_stores_title}}">{{settings.header_stores_title}}</a></li>
									{%- endif -%}
								</ul>

								<div class="md-hidden mb-drawer-lang notranslate" translate="no">
									<div class="mb-drawer-lang-opts" id="drawerLangOpts">
										<button class="mb-drawer-lang-opt" type="button" data-lang="vi">
											<img src="{{ 'flag-vn.svg' | asset_url }}" width="22" height="15" alt="VN">
											<span>Việt</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="en">
											<img src="{{ 'flag-us.svg' | asset_url }}" width="22" height="15" alt="EN">
											<span>EN</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="zh-CN">
											<img src="{{ 'flag-cn.svg' | asset_url }}" width="22" height="15" alt="CN">
											<span>中文</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="ja">
											<img src="{{ 'flag-jp.svg' | asset_url }}" width="22" height="15" alt="JP">
											<span>日本語</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="ko">
											<img src="{{ 'flag-kr.svg' | asset_url }}" width="22" height="15" alt="KR">
											<span>한국어</span>
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-12 col-xl-5 col-lg-4 header-mid">
						<div class="list-top-item header_tim_kiem">
							<form action="/search" method="get" class="header-search-form input-group search-bar" role="search">
								<input name="query" class="input-group-field auto-search search-auto form-control" placeholder="Tìm sản phẩm..." autocomplete="off" type="text">
								<input type="hidden" name="type" value="product">
								<button type="submit" class="btn icon-fallback-text" aria-label="Tìm kiếm" title="Tìm kiếm">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
										<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
									</svg>
								</button>
								{%if settings.header_search_suggest or settings.header_search_smart%}
								<div class="search-suggest">
									{% if settings.header_search_gg_title.size > 0%}
									<a class="coupon_search" href="{{settings.header_search_gg_url}}" title="{{settings.header_search_gg_title}}">
										<div class="icon_ma_gg">
											<svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
												<path d="M43.9570312,12.78125 L38.4728789,12.78125 C39.3208242,11.65425 39.8242188,10.2540352 39.8242188,8.73828125 C39.8242188,5.02279297 36.8014258,2 33.0859375,2 C30.8478398,2 29.1975,2.80185547 27.8921602,4.52344141 C26.8001094,5.96381641 26.0015781,7.97487891 25,10.5158398 C23.9984219,7.97478906 23.1998906,5.96381641 22.1078398,4.52344141 C20.8025,2.80185547 19.1521602,2 16.9140625,2 C13.1985742,2 10.1757812,5.02279297 10.1757812,8.73828125 C10.1757812,10.2540352 10.6791758,11.65425 11.5271211,12.78125 L6.04296875,12.78125 C3.81367578,12.78125 2,14.5949258 2,16.8242188 L2,19.5195312 C2,21.2764258 3.12673047,22.7743906 4.6953125,23.3307031 L4.6953125,43.9570312 C4.6953125,46.1863242 6.50898828,48 8.73828125,48 L41.2617188,48 C43.4910117,48 45.3046875,46.1863242 45.3046875,43.9570312 L45.3046875,23.3307031 C46.8732695,22.7743906 48,21.2764258 48,19.5195312 L48,16.8242188 C48,14.5949258 46.1863242,12.78125 43.9570312,12.78125 Z M27.4737578,11.5899219 C29.5382773,6.35221094 30.3231523,4.6953125 33.0859375,4.6953125 C35.3152305,4.6953125 37.1289062,6.50898828 37.1289062,8.73828125 C37.1289062,10.9675742 35.3152305,12.78125 33.0859375,12.78125 L27.0023477,12.78125 C27.1674805,12.3666211 27.3249766,11.9674453 27.4737578,11.5899219 Z M16.9140625,4.6953125 C19.6768477,4.6953125 20.4617227,6.35221094 22.5262422,11.5899219 C22.6750234,11.9674453 22.8325195,12.3666211 22.9976523,12.78125 L16.9140625,12.78125 C14.6847695,12.78125 12.8710938,10.9675742 12.8710938,8.73828125 C12.8710938,6.50898828 14.6847695,4.6953125 16.9140625,4.6953125 Z M19.609375,45.3046875 L8.73828125,45.3046875 C7.99518359,45.3046875 7.390625,44.7001289 7.390625,43.9570312 L7.390625,23.5625 L19.609375,23.5625 L19.609375,45.3046875 Z M19.609375,20.8671875 L6.04296875,20.8671875 C5.29987109,20.8671875 4.6953125,20.2626289 4.6953125,19.5195312 L4.6953125,16.8242188 C4.6953125,16.0811211 5.29987109,15.4765625 6.04296875,15.4765625 L19.609375,15.4765625 L19.609375,20.8671875 Z M27.6953125,45.3046875 L22.3046875,45.3046875 L22.3046875,15.4765625 C22.5870664,15.4765625 26.1464062,15.4765625 27.6953125,15.4765625 L27.6953125,45.3046875 Z M42.609375,43.9570312 C42.609375,44.7001289 42.0048164,45.3046875 41.2617188,45.3046875 L30.390625,45.3046875 L30.390625,23.5625 L42.609375,23.5625 L42.609375,43.9570312 Z M45.3046875,19.5195312 C45.3046875,20.2626289 44.7001289,20.8671875 43.9570312,20.8671875 L30.390625,20.8671875 L30.390625,15.4765625 L43.9570312,15.4765625 C44.7001289,15.4765625 45.3046875,16.0811211 45.3046875,16.8242188 L45.3046875,19.5195312 Z"></path>
											</svg>
										</div>
										<span class="txt_sea_coupon">
											{{settings.header_search_gg_title}}
										</span>
										<div class="icon_next_gg">
											<svg viewBox="0 0 23 41" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
												<path d="M21.9048339,19.0696472 L3.93022809,1.10101651 C3.14151439,0.314294512 1.86367209,0.314294512 1.07296669,1.10101651 C0.284252985,1.88773851 0.284252985,3.16558081 1.07296669,3.95230281 L17.6218463,20.4952073 L1.07495839,37.0381119 C0.286244685,37.8248339 0.286244685,39.1026762 1.07495839,39.8913899 C1.86367209,40.6781119 3.14350609,40.6781119 3.93221979,39.8913899 L21.9068256,21.9229252 C22.6834231,21.144336 22.6834231,19.8464107 21.9048339,19.0696472 Z" id="Path" fill-rule="nonzero">
												</path>
											</svg>
										</div>
									</a>
									{% endif %}
									{%if settings.header_search_recent%}
									<div class="search-recent d-none">
										<div class="search-title">
											<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
												<path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
												<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
											</svg>
											Tìm kiếm gần đây
										</div>
										<div class="search-list">
										</div>
									</div>
									{% endif %}
									{%if settings.header_search_suggest%}
									<div class="item-suggest">
										<div class="search-title">
											<svg height="20" viewBox="0 0 512 512" width="20" xmlns="http://www.w3.org/2000/svg"><g data-name="Layer 2"><g id="trend_up"><path id="background" d="m256 31a225.07 225.07 0 0 1 87.57 432.33 225.07 225.07 0 0 1 -175.14-414.66 223.45 223.45 0 0 1 87.57-17.67m0-31c-141.38 0-256 114.62-256 256s114.62 256 256 256 256-114.62 256-256-114.62-256-256-256z"/><path d="m133.35 334.73a18.11 18.11 0 0 1 -8-1.9c-6.59-3.23-10.36-10.21-9.17-17a22.45 22.45 0 0 1 5.4-11.46c27.31-27.74 54.67-55 75.46-75.63a18 18 0 0 1 12.75-5.63c4.83 0 9.49 2.1 13.47 6.08l47 47 64-64h-6.46c-8.21 0-19.46-.1-25.91-.16-10.16-.08-17.28-7.16-17.33-17.22a17.52 17.52 0 0 1 4.84-12.53 17.19 17.19 0 0 1 12.31-4.88c13-.05 26-.07 38.52-.07 13.05 0 26.06 0 38.67.07 9.73 0 16.84 7 16.9 16.56.18 26.67.17 53 0 78.22-.06 9.58-7.33 16.54-17.28 16.54h-.2c-9.88-.09-16.89-7.06-17.05-16.94-.12-7.75-.1-15.63-.07-23.24q0-5 0-10v-2c-.25.22-.48.44-.7.66q-32.46 32.6-64.89 65.22l-9 9c-5.4 5.43-10.45 8.07-15.44 8.07s-9.9-2.58-15.16-7.88l-46.26-46.25-3.75 3.81c-4 4-7.82 7.76-11.52 11.48l-17.38 17.49c-10 10.08-20.34 20.51-30.55 30.73a18.58 18.58 0 0 1 -13.2 5.86z"/></g></g></svg>
											{{settings.header_search_suggest_title}}
										</div>
										<div class="search-list">
											{% assign list_search = settings.header_search_suggest_list | split:"," %}
											{% for search_item in list_search %}
											<a href="/search?query={{ search_item | url_encode }}&type=product" class="search-item" title="Tìm kiếm {{search_item}}">
												{{search_item}}
											</a>
											{%endfor%}
										</div>
									</div>
									{%endif%}
									{%if settings.header_search_smart%}
									<div class="list-search list-search-style">
									</div>
									<div class="list-search2 list-search-style">
									</div>
									{%endif%}
								</div>
								{%endif%}
							</form>
						</div>
						<ul class="list-search-key">{% assign key = settings.header_search_default_key | split:";" %}{%for item in key%}
							<li><a href="/search?query=tags:({{item | url_encode}})&type=product" title="{{item}}">{{item}} </a>
								{%unless forloop.last%}<span></span>{%endunless%}
							</li>{%endfor%}
						</ul>
					</div>
					<div class="col-6 col-xl-4 col-lg-5  col-md-8 header-right">
						<button type="button" class="header-action-search" id="mb-search-open" aria-label="Tìm kiếm" title="Tìm kiếm">
							<span class="box-icon">
								<i class="fas fa-magnifying-glass"></i>
							</span>
						</button>
						{%- if settings.header_stores_enable -%}
						<div class="sudes-header-stores sm-hidden">
							<a href="{{settings.header_stores_url}}" title="{{settings.header_stores_title}}">
								<span class="box-icon">
									<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M10 0C6.12297 0 2.96875 3.15422 2.96875 7.03125C2.96875 8.34117 3.3316 9.61953 4.01832 10.7286L9.59977 19.723C9.70668 19.8953 9.89504 20 10.0976 20C10.0992 20 10.1007 20 10.1023 20C10.3066 19.9984 10.4954 19.8905 10.6003 19.7152L16.0395 10.6336C16.6883 9.54797 17.0312 8.3023 17.0312 7.03125C17.0312 3.15422 13.877 0 10 0ZM15.0338 10.032L10.0888 18.2885L5.01434 10.1112C4.44273 9.18805 4.13281 8.12305 4.13281 7.03125C4.13281 3.80039 6.76914 1.16406 10 1.16406C13.2309 1.16406 15.8633 3.80039 15.8633 7.03125C15.8633 8.09066 15.5738 9.12844 15.0338 10.032Z" fill="white"/>
										<path d="M10 3.51562C8.06148 3.51562 6.48438 5.09273 6.48438 7.03125C6.48438 8.95738 8.03582 10.5469 10 10.5469C11.9884 10.5469 13.5156 8.93621 13.5156 7.03125C13.5156 5.09273 11.9385 3.51562 10 3.51562ZM10 9.38281C8.7009 9.38281 7.64844 8.32684 7.64844 7.03125C7.64844 5.73891 8.70766 4.67969 10 4.67969C11.2923 4.67969 12.3477 5.73891 12.3477 7.03125C12.3477 8.30793 11.3197 9.38281 10 9.38281Z" fill="white"/>
									</svg>
								</span>
								<span class="item-title sm-hidden">{{settings.header_stores_title}} <br><span>{{settings.header_stores_sub}}</span></span>
							</a>
						</div>
						{%- endif -%}

						{%- if settings.iwish_enable -%}
						<div class="sudes-header-iwish sm-hidden">
							<a href="{{ pages[settings.wishlist_page].url }}" title="Danh sách yêu thích">
								<span class="box-icon">
									<i class="far fa-heart"></i>
									<span class="js-wishlist-count">0</span>
								</span>
							</a>
						</div>
						{%- endif -%}
						<div class="sudes-header-cart header-action_cart">
							<a class="a-hea" href="/cart" aria-label="Giỏ hàng" title="Giỏ hàng">
								<span class="box-icon">
									<i class="fas fa-cart-shopping"></i>
									<span class="count_item count_item_pr{% if cart.item_count == 0 %} hidden-count{% endif %}">{{ cart.item_count }}</span>
								</span>
							</a>
							<div class="top-cart-content">		
								<div class="CartHeaderContainer">
								</div>
							</div>
						</div>
						<button class="menu-icon md-hidden" aria-label="Menu" id="btn-menu-mobile" title="Menu">
							<i class="fas fa-bars"></i>
						</button>
					</div>
				</div>
			</div>
		</div> 
		{%- if settings.header_bg_enable -%}
		<img class="img_opacity" width="1920" height="200" src="{{'bg_header.jpg' | asset_url}}" alt="{{store.name}}"/>
		{%- endif -%}
	</div>
	<div class="mobile-nav-overflow"></div>
</header>
<script>
/* Early shim: menu mobile bấm được NGAY khi header parse xong, không chờ main.js (defer).
   main.js đặt window.__pcMenuJSReady = true khi handler đầy đủ sẵn sàng → shim tự nhường. */
(function () {
	function q(s) { return document.querySelector(s); }
	document.addEventListener('click', function (e) {
		if (window.__pcMenuJSReady || !e.target.closest) return;
		if (e.target.closest('#btn-menu-mobile')) {
			var tc = q('script[data-template="header_nav_cate"]');
			var dc = q('div[data-section="header_nav_cate"]');
			if (tc && dc) { dc.innerHTML = tc.innerHTML; }
			document.querySelectorAll('script[data-template="header_nav"]').forEach(function (s) {
				s.outerHTML = s.innerHTML;
			});
			var hm = q('.header-menu'); if (hm) hm.classList.add('current');
			var ov = q('.mobile-nav-overflow'); if (ov) ov.classList.toggle('open');
			return;
		}
		if (e.target.closest('.header-menu .close-mb-menu') || (e.target.classList && e.target.classList.contains('mobile-nav-overflow'))) {
			var hm2 = q('.header-menu'); if (hm2) hm2.classList.remove('current');
			var ov2 = q('.mobile-nav-overflow'); if (ov2) ov2.classList.remove('open');
		}
	});
})();
</script>
<script>
/* D01 (phase home-shopping-ux, 2026-09-20): drawer menu mobile (#btn-menu-mobile → .header-menu
   .current) mở/đóng qua 2 cơ chế riêng — shim ở trên (trước khi main.js sẵn sàng) và jQuery
   handler thật trong main.js.bwt (sau khi window.__pcMenuJSReady = true). Quan sát trực tiếp class
   ".current" bằng MutationObserver thay vì viết lại logic khoá cuộn/aria/focus ở cả 2 nơi — chạy
   đúng dù bên nào bật/tắt class. Khoá cuộn nền + Escape để đóng + trả focus về nút mở (trước đây
   không có cả 3, đo được bằng cách bấm mở drawer rồi bắn KeyboardEvent Escape: class "current"
   không đổi). */
(function () {
	var headerMenu = document.querySelector('.header-menu');
	var btn = document.getElementById('btn-menu-mobile');
	if (!headerMenu || !btn) return;
	var wasOpen = false;
	function sync() {
		var isOpen = headerMenu.classList.contains('current');
		if (isOpen === wasOpen) return;
		document.body.classList.toggle('pc-drawer-open', isOpen);
		btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		if (wasOpen && !isOpen) btn.focus();
		wasOpen = isOpen;
	}
	new MutationObserver(sync).observe(headerMenu, { attributes: true, attributeFilter: ['class'] });
	document.addEventListener('keydown', function (e) {
		if (e.key !== 'Escape' || !headerMenu.classList.contains('current')) return;
		headerMenu.classList.remove('current');
		var overflow = document.querySelector('.mobile-nav-overflow');
		if (overflow) overflow.classList.remove('open');
	});
})();
</script>
<script>
	const header = document.querySelector('header.header');
	let offsetStickyHeader = 0;
	let resizeTimer;
	const desktopHeader = window.matchMedia('(min-width: 992px)');
	const tabLinks = document.querySelectorAll('.tab-link');
	const tabContents = document.querySelectorAll('.tab-content-mb');

	const closeHeaderCategories = () => {
		const trigger = header.querySelector('.js-menu-toggle');
		if (!trigger || !trigger.classList.contains('active')) return;
		trigger.classList.remove('active');
		trigger.setAttribute('aria-expanded', 'false');
		header.querySelector('.sudes-list-cate')?.classList.remove('active');
		header.querySelector('.sudes-main-header')?.classList.remove('actimenucol');
		header.querySelector('.mobile-nav-overflow')?.classList.remove('open');
	};

	const handleScroll = () => {
		const sticky = desktopHeader.matches && window.scrollY > offsetStickyHeader;
		if (header.classList.contains('hSticky') === sticky) return;
		closeHeaderCategories();
		header.classList.toggle('hSticky', sticky);
	};

	const measureHeader = () => {
		header.classList.remove('hSticky');
		header.style.minHeight = '';
		const headerHeight = header.offsetHeight;
		offsetStickyHeader = header.getBoundingClientRect().top + window.scrollY + headerHeight;
		if (desktopHeader.matches) header.style.minHeight = headerHeight + 'px';
		else closeHeaderCategories();
		handleScroll();
	};

	const handleResize = () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(measureHeader, 150);
	};

	header.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			const trigger = header.querySelector('.js-menu-toggle.active');
			closeHeaderCategories();
			if (trigger) trigger.focus();
		}
	});
	window.addEventListener('load', measureHeader);
	window.addEventListener('pageshow', measureHeader);
	if (document.fonts) document.fonts.ready.then(measureHeader);
	measureHeader();

	const handleTabClick = (tabLink) => {
		const tabId = tabLink.dataset.tab;

		tabLinks.forEach((link) => link.classList.remove('active'));
		tabLink.classList.add('active');

		tabContents.forEach((tabContent) => tabContent.classList.remove('active'));
		document.getElementById(tabId).classList.add('active');
	};

	const initializeTabs = () => {
		if (window.innerWidth <= 991 && tabLinks.length > 0) {
			const tabMenu1 = document.getElementById('tab-menu-1');
			const tabLinkMenu1 = document.querySelector('.tab-link[data-tab="tab-menu-1"]');
			if (tabMenu1) tabMenu1.classList.add('active');
			if (tabLinkMenu1) tabLinkMenu1.classList.add('active');
			tabLinks.forEach((tabLink) => {
				tabLink.addEventListener('click', () => handleTabClick(tabLink));
			});
		}
	};

	window.addEventListener('resize', handleResize);
	window.addEventListener('scroll', handleScroll, { passive: true });

	tabLinks.forEach((tabLink) => {
		tabLink.addEventListener('click', () => handleTabClick(tabLink));
	});

	// Pre-fill header search input từ URL param khi ở trang search
	// Bỏ qua khi q chứa filter syntax (vd: vendor:..., tags:..., collection:...)
	(function() {
		var params = new URLSearchParams(location.search);
		var term = params.get('query') || params.get('q') || '';
		if (term && !/\w+\s*:/.test(term)) {
			document.querySelectorAll('input[name="query"], input[name="q"]').forEach(function(inp) {
				if (!inp.value) inp.value = term;
			});
		}
	})();

	document.addEventListener('DOMContentLoaded', initializeTabs);

</script>
