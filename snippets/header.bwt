{%if settings.use_banner_top%}
<div class="banner-top" style="background: {{settings.color_banner_top}}">
	<a class="duration-300" href="{{settings.link_banner_top}}" title="{{settings.alt_banner_top}}">
		<picture>
			<source media="(max-width: 767px)" srcset="{{ 'banner_top.jpg' | asset_url }}"/>
			<img width="1920" height="80" loading="lazy" class="lazyload duration-300" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{'banner_top.jpg' | asset_url}}" alt="{{settings.alt_banner_top}}"/>
		</picture>
	</a>
</div>
{%endif%}
{%- comment -%}
  T-107 (2026-09-11) — người dùng yêu cầu review lại header.bwt, chia rõ 2 phần TOP/MAIN cho dễ
  đọc/bảo trì. KHÔNG đổi tên class hiện có (.top-main-header/.box-hearder/.header-menu — bị tham
  chiếu ở hàng trăm chỗ trong assets/global_core.scss.bwt, đổi tên = rủi ro vỡ CSS toàn site).
  Thêm ranh giới rõ ràng bằng comment để dễ định vị khi sửa sau này:
    PHẦN 1 — HEADER TOP  (.top-main-header): thanh tiện ích xanh — slider khuyến mãi, ngôn ngữ,
             hotline, tài khoản. Ẩn hoàn toàn trên mobile (≤991px).
    PHẦN 2 — HEADER MAIN (.box-hearder, chứa cả .header-menu đã gộp từ T-104): logo, danh mục +
             menu chính, tìm kiếm, wishlist/giỏ hàng — nền trắng, đây là phần "header" người dùng
             nhìn thấy thường trực kể cả khi cuộn (dùng chung 1 hàng ở desktop >=992px).
{%- endcomment -%}
<header class="header">
	<div class="main-header">
			{%- comment -%} ============ PHẦN 1 — HEADER TOP (topbar xanh) ============ {%- endcomment -%}
		<div class="container">
			<div class="top-main-header">
				<div class="row align-items-center">
					<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 col-12">
						<div class="topbar-slider swiper-container">
							<div class="swiper-wrapper">
								{%- assign text = settings.header_topbar_text | split:";" -%}
								{%- for item in text -%}
								<div class="swiper-slide line-clamp-1-new"> <span class="pulsingButton rounded-circle"></span> {{item}}</div>
								{%- endfor -%}
							</div>
						</div>
					</div>
					<div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 col-12 text-hea-right d-none d-md-block">
						
						<div class="box_top_hea lang-switcher notranslate" id="langSwitcher" translate="no">
							<button class="lang-btn" id="langBtn" type="button">
								<img id="langFlag" src="{{ 'flag-vn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img">
								<span id="langLabel">Tiếng Việt</span>
								<svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</button>
							<ul class="lang-list" id="langList">
								<li data-lang="vi"    data-flag="{{ 'flag-vn.svg' | asset_url }}" data-label="Tiếng Việt">
									<img src="{{ 'flag-vn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> Tiếng Việt
								</li>
								<li data-lang="en"    data-flag="{{ 'flag-us.svg' | asset_url }}" data-label="English">
									<img src="{{ 'flag-us.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> English
								</li>
								<li data-lang="zh-CN" data-flag="{{ 'flag-cn.svg' | asset_url }}" data-label="中文">
									<img src="{{ 'flag-cn.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 中文
								</li>
								<li data-lang="ja"    data-flag="{{ 'flag-jp.svg' | asset_url }}" data-label="日本語">
									<img src="{{ 'flag-jp.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 日本語
								</li>
								<li data-lang="ko"    data-flag="{{ 'flag-kr.svg' | asset_url }}" data-label="한국어">
									<img src="{{ 'flag-kr.svg' | asset_url }}" width="20" height="14" alt="" class="lang-flag-img"> 한국어
								</li>
							</ul>
						</div>
						<div id="google_translate_element" style="display:none;visibility:hidden;"></div>
						
						<div class="box_top_hea hotline-box">
							<a title="{{settings.store_phone | default: store.phone_number}}" href="tel:{{settings.store_phone | default: store.phone_number | remove: ' ' | remove: '.'}}">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.81a16 16 0 0 0 6.29 6.29l1.93-1.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
								<b>{{settings.store_phone | default: store.phone_number}}</b>
							</a>
						</div>
						
						<div class="box_top_hea topbar-account" id="topbarAccount">
							<button class="topbar-account-btn" type="button">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
								<span class="topbar-account-label">{% if customer %}{{ customer.name }}{% else %}Tài khoản{% endif %}</span>
								<svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</button>
							<ul class="topbar-account-list">
								{% if customer %}
								<li><a rel="nofollow" href="/account" title="Tài khoản">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/></svg>
									Tài khoản
								</a></li>
								<li><a rel="nofollow" href="https://pharmacosmetics-vn.com/apps/tich-diem-doi-qua" title="Tích điểm đổi quà">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M3 2.5a2.5 2.5 0 0 1 5 0 2.5 2.5 0 0 1 5 0v.006c0 .07 0 .27-.038.494H15a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 14.5V7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h2.038A2.968 2.968 0 0 1 3 2.506zm1.068.5H7v-.5a1.5 1.5 0 1 0-3 0c0 .085.002.274.045.43zM9 3h2.932l.023-.07c.043-.156.045-.345.045-.43a1.5 1.5 0 0 0-3 0zm6 4v-2H8v2zM2.943 7H1v2h6V7zm-1 3v3.5a.5.5 0 0 0 .5.5H7v-4zm8 3.5V10H8v4h4.5a.5.5 0 0 0 .5-.5zm1.443-3.5H9v2h6V10h-2.557z"/></svg>
									Tích điểm đổi quà
								</a></li>
								<li><a rel="nofollow" href="/account/logout" title="Đăng xuất">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0v2z"/><path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3z"/></svg>
									Đăng xuất
								</a></li>
								{% else %}
								<li><a rel="nofollow" href="/account/login" title="Đăng nhập">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0v-2z"/><path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/></svg>
									Đăng nhập
								</a></li>
								<li><a rel="nofollow" href="/account/register" title="Đăng ký">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/><path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z"/></svg>
									Đăng ký
								</a></li>
								{% endif %}
							</ul>
						</div>
					</div>
				</div>
			</div>
			</div>
			{%- comment -%} ============ PHẦN 2 — HEADER MAIN (logo + danh mục + menu + tìm kiếm + giỏ hàng, nền trắng) ============ {%- endcomment -%}
			<div class="box-hearder">
		<div class="container">
				<div class="row align-items-center">
					<div class="col-6 col-xl-3 col-lg-3 col-md-4 header-logo">
						<a href="/" class="logo-wrapper pc-logo-master" title="{{settings.store_name | default: store.name}}">
							{%- comment -%}
								T-121 (2026-09-12) — người dùng yêu cầu trực tiếp: "logo lấy từ
								design/Pharma Cosmetics/test_full_logo.html để màu main". Logo Master Vector
								đầy đủ (icon + tên + tagline dệt sẵn trong SVG, fill="currentColor") thay cho
								icon nhỏ + text HTML rời trước đây. Màu do CSS `color` của .pc-logo-master quyết
								định (xem snippets/pharma_ui_kit.bwt — đặt var(--mainColor) trên nền trắng của
								.box-hearder). aria-label/title vẫn dùng settings.store_name để giữ SEO/tên
								store thật có thể tuỳ biến qua schema-admin dù logo là ảnh vector cố định.
							{%- endcomment -%}
							{% include 'logo-master-svg' %}
						</a>
					</div>
					{%- comment -%}
					  T-104 (2026-09-11) — người dùng yêu cầu trực tiếp: "bỏ đi header-menu, tích hợp
					  vào header, top-header xanh, header trắng, chèn menu vào header luôn". Chuyển
					  NGUYÊN VẸN (không duplicate) khối .header-menu (Danh mục + site-nav mega-menu +
					  toàn bộ phần drawer mobile bên trong) từ hàng riêng thành 1 flex-item chung hàng
					  với .box-hearder. Giữ nguyên mọi id/class bên trong (#nav, .sudes-list-cate...)
					  nên KHÔNG cần đổi JS (mobile hamburger vẫn document.querySelector('.header-menu')
					  đúng 1 instance, .current vẫn toggle đúng; position:fixed của drawer mobile tính
					  theo viewport, không phụ thuộc độ sâu lồng DOM — xác nhận an toàn trước khi làm).
					  Nếu nav không đủ chỗ ở 1 số độ rộng desktop hẹp: dùng cơ chế cuộn ngang có sẵn
					  (.navigation-horizontal.overflow + #prev/#next, đã sửa lỗi off-by-one ở T-103) —
					  không cần logic mới, không phá layout.
					{%- endcomment -%}
					<div class="header-menu">
						<div class="container">
							<div class="navigation-horizontal">
								<div class="mb-drawer-topbar md-hidden">
									<a href="/" class="mb-drawer-logo" title="{{settings.store_name | default: store.name}}">
										{%- if settings['logo.png'] != blank -%}
										<img src="{{ settings['logo.png'] | img_url: 'large' }}"
											width="146" height="36"
											alt="{{settings.store_name | default: store.name}}"
											onerror="this.onerror=null;this.src='{{ 'logoPC.svg' | asset_url }}'">
										{%- else -%}
										<img src="{{ 'logoPC.svg' | asset_url }}" width="40" height="40" alt="{{settings.store_name | default: store.name}}">
										{%- endif -%}
									</a>
									<button class="close-mb-menu mb-drawer-close" aria-label="Đóng menu">
										<i class="fas fa-xmark"></i>
									</button>
								</div>
								<div class="row">
									<div class="col-lg-2 col-sm-12 col-xs-12 col-12 sudes-cate-header">
										<div class="title js-menu-toggle">
											<span class="line-clamp line-clamp-1">{{settings.header_nav_title}}</span>
											<svg class="scg_drop" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.7138 16.7077L21.7048 7.71374C22.0984 7.31909 22.0984 6.6797 21.7048 6.28406C21.3111 5.88941 20.6717 5.88941 20.2781 6.28406L12.0005 14.5646L3.72293 6.28505C3.32928 5.89041 2.68989 5.89041 2.29524 6.28505C1.90159 6.6797 1.90159 7.32009 2.29524 7.71474L11.2861 16.7087C11.6757 17.0973 12.3251 17.0973 12.7138 16.7077Z" fill="currentColor"></path></svg>
										</div>
										{%include 'bean-menu-cate'%}
									</div>
									<div class="col-lg-10 col-sm-12 col-xs-12 col-12 sudes-main-header">
										<div class="col-menu {%if settings.btn_promotion_enable%}has-promo-btn{%endif%}">
											{%include 'site-nav'%}
										</div>
										<div class="control-menu">
											<a href="#" id="prev"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="#fff" d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 278.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"/></svg></a>
											<a href="#" id="next"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path fill="#fff" d="M342.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L274.7 256 105.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/></svg></a>
										</div>
										{%if settings.header_live_enable%}
										<div class="header-box-live">
											<button style="--header-live-color:#ff0000" class="btn-live transition-all hover:scale-105">{{settings.header_live_title}}</button>
										</div>
										{%endif%}
										{%if settings.btn_promotion_enable%}
										<div class="button-promo">
											<a  href="{{settings.btn_promotion_url}}" title="{{settings.btn_promotion_title}}" class="duration-300">
												<img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{'search_order.png' | asset_url}}" alt="{{settings.btn_promotion_title}}" class="lazyload"/>
												<span>{{settings.btn_promotion_title}}</span>
											</a>
										</div>
										{%endif%}
									</div>

								</div>
												<ul class="md-hidden mb-drawer-secondary">
									<li><a href="https://pharmacosmetics-vn.com/apps/tich-diem-doi-qua" title="Tích điểm đổi quà">Tích điểm đổi quà</a></li>
									{%- if settings.iwish_enable -%}
									<li><a href="{{ pages[settings.wishlist_page].url }}" title="Sản phẩm yêu thích">Sản phẩm yêu thích <span class="js-wishlist-count" style="display:none">0</span></a></li>
									{%- endif -%}
									{%- if settings.header_stores_enable -%}
									<li><a href="{{settings.header_stores_url}}" title="{{settings.header_stores_title}}">{{settings.header_stores_title}}</a></li>
									{%- endif -%}
								</ul>

								<div class="md-hidden mb-drawer-lang notranslate" translate="no">
									<div class="mb-drawer-lang-opts" id="drawerLangOpts">
										<button class="mb-drawer-lang-opt" type="button" data-lang="vi">
											<img src="{{ 'flag-vn.svg' | asset_url }}" width="22" height="15" alt="VN">
											<span>Việt</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="en">
											<img src="{{ 'flag-us.svg' | asset_url }}" width="22" height="15" alt="EN">
											<span>EN</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="zh-CN">
											<img src="{{ 'flag-cn.svg' | asset_url }}" width="22" height="15" alt="CN">
											<span>中文</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="ja">
											<img src="{{ 'flag-jp.svg' | asset_url }}" width="22" height="15" alt="JP">
											<span>日本語</span>
										</button>
										<button class="mb-drawer-lang-opt" type="button" data-lang="ko">
											<img src="{{ 'flag-kr.svg' | asset_url }}" width="22" height="15" alt="KR">
											<span>한국어</span>
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-12 col-xl-5 col-lg-4 header-mid">
						<div class="list-top-item header_tim_kiem">
							<form action="/search" method="get" class="header-search-form input-group search-bar" role="search">
								<input name="query" class="input-group-field auto-search search-auto form-control" placeholder="Tìm sản phẩm..." autocomplete="off" type="text">
								<input type="hidden" name="type" value="product">
								<button type="submit" class="btn icon-fallback-text" aria-label="Tìm kiếm" title="Tìm kiếm">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
										<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
									</svg>
								</button>
								{%if settings.header_search_suggest or settings.header_search_smart%}
								<div class="search-suggest">
									{% if settings.header_search_gg_title.size > 0%}
									<a class="coupon_search" href="{{settings.header_search_gg_url}}" title="{{settings.header_search_gg_title}}">
										<div class="icon_ma_gg">
											<svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
