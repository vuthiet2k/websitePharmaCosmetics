<div class="ai-skin-crm-modal pc-skin-consent-modal" id="aiSkinCrmConsentModal" hidden aria-hidden="true">
  <div class="ai-skin-crm-modal__backdrop" data-crm-consent-close></div>
  <section class="ai-skin-crm-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="aiSkinCrmConsentTitle" aria-describedby="aiSkinCrmConsentBody">
    <h2 id="aiSkinCrmConsentTitle">{{ settings.skin_consent_title | default: 'Xác nhận lưu hồ sơ chăm sóc da cá nhân' | escape }}</h2>
    <div id="aiSkinCrmConsentBody">
      <p>{{ settings.skin_consent_description | default: 'Chúng tôi chỉ lưu các chỉ số định lượng và phác đồ để chuyên gia hỗ trợ theo dõi tiến triển khi bạn đồng ý.' | escape }}</p>
      <ul>
        <li>{{ settings.skin_consent_privacy | default: 'Ảnh khuôn mặt được xử lý tức thời trên thiết bị, không tự động lưu vào hồ sơ.' | escape }}</li>
        <li>{{ settings.skin_consent_rights | default: 'Bạn có thể yêu cầu xoá hồ sơ qua kênh hỗ trợ của Pharma Cosmetics.' | escape }}</li>
      </ul>
      <p>{{ settings.ai_skin_scan_disclaimer | default: 'Kết quả chỉ mang tính tham khảo khoa học, không thay thế chẩn đoán y khoa chính thức.' | escape }}</p>
    </div>
    <p class="ai-skin-crm-modal__status" id="aiSkinCrmConsentStatus" aria-live="polite"></p>
    <div class="ai-skin-crm-modal__actions">
      <button type="button" class="ai-skin-crm-modal__cancel" data-crm-consent-close>{{ settings.crm_consent_cancel_label | default: 'Không lưu' | escape }}</button>
      <button type="button" class="ai-skin-crm-modal__accept" id="aiSkinCrmConsentAccept">{{ settings.skin_consent_accept_label | default: 'Tôi hiểu và đồng ý lưu hồ sơ' | escape }}</button>
    </div>
  </section>
</div>
