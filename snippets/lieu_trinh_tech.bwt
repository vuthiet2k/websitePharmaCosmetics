{%- comment -%}
  lieu_trinh_tech — công nghệ & cơ chế: nhãn = hãng (product.vendor), tiêu đề = tên ngắn (CHỮ HOA), mô tả = tag congthuc:,
  ảnh [congthuc] (hoặc [sanpham]/ảnh đại diện) bên trái; hoạt chất = bài blog hoạt chất qua tag hoatchat:<handle> (quy ước có sẵn
  của trang sản phẩm), vai trò = tag vaitro: trên bài. Không ảnh + không hoạt chất ⇒ ẩn phần.
{%- endcomment -%}
{%- assign lt_iblog = blogs[settings.ingredient_blog_handle] -%}
{%- assign lt_hlist = lt_hoatchat | split: '|' -%}
{%- assign lt_an = 0 -%}
{%- capture lt_actives -%}
{%- for lt_h in lt_hlist -%}{%- assign lt_h = lt_h | strip -%}
  {%- for lt_a in lt_iblog.articles -%}{%- if lt_a.handle == lt_h -%}
  {%- assign lt_an = lt_an | plus: 1 -%}
  {%- assign lt_role = '' -%}
  {%- for lt_t in lt_a.tags -%}{%- if lt_t contains ':' -%}{%- assign lt_tr = lt_t | split: ':' | first -%}{%- assign lt_tk = lt_tr | strip | downcase -%}{%- if lt_tk == 'vaitro' -%}{%- assign lt_role = lt_t | remove_first: lt_tr | remove_first: ':' | strip -%}{%- endif -%}{%- endif -%}{%- endfor -%}
  <article class="lt-card lt-active">
    <span class="lt-active__mark" aria-hidden="true">{{ lt_a.title | slice: 0, 1 | upcase }}</span>
    <div>
      <h4 class="lt-active__name"><span class="lt-upper">{{ lt_a.title | escape }}</span>{% if lt_role != blank %} <span class="lt-active__role">{{ lt_role | escape }}</span>{% endif %}</h4>
      {%- assign lt_sum = lt_a.summary | default: lt_a.excerpt | strip_html | strip -%}
      {%- if lt_sum != blank -%}<p class="lt-card__text">{{ lt_sum }}</p>{%- endif -%}
    </div>
  </article>
  {%- endif -%}{%- endfor -%}
{%- endfor -%}
{%- endcapture -%}
{%- if lt_an > 0 or lt_img_tech != blank -%}
<section id="service-mechanism-section" class="lt-section lt-section--soft">
  <div class="container">
    <header class="lt-head">
      {%- if lt_product.vendor != blank -%}<p class="lt-eyebrow">{{ lt_product.vendor | escape }}</p>{%- endif -%}
      <h2 class="lt-title lt-upper">{{ lt_short | escape }}</h2>
      {%- if lt_congthuc != blank -%}<p class="lt-lead">{{ lt_congthuc | escape }}</p>{%- endif -%}
    </header>
    <div class="lt-tech{% if lt_img_tech == blank or lt_an == 0 %} lt-tech--full{% endif %}">
      {%- if lt_img_tech != blank -%}
      <div class="lt-card lt-tech__media"><div class="lt-media lt-media--1x1"><img src="{{ lt_img_tech | img_url: '1024x1024' }}" alt="{{ lt_short | escape }}" width="960" height="960" loading="lazy" decoding="async"></div></div>
      {%- endif -%}
      {%- if lt_an > 0 -%}
      <div class="lt-actives">
        {%- if settings.lt_actives_title != blank -%}<h3 class="lt-subtitle">{{ settings.lt_actives_title | escape }}</h3>{%- endif -%}
        {{ lt_actives }}
        {%- if settings.lt_actives_note != blank -%}<p class="lt-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ settings.lt_actives_note | escape }}</p>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
