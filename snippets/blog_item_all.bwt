<div class="item-blog-all">
	<a  class="image-blog" href="{{ article.url }}" title="{{ article.title }}">
		{% if article.image == null %}
		<img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{ 'no-image.jpg' | asset_url }}" alt="{{ article.title | replace: '"', '' | escape }}" class="lazyload duration-300" />
		{%else%}
		<img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsQAAA7EAZUrDhsAAAANSURBVBhXYzh8+PB/AAffA0nNPuCLAAAAAElFTkSuQmCC" data-src="{{ article.image.src | img_url:'large'}}" alt="{{ article.title | replace: '"', '' | escape }}" class="lazyload duration-300" />
		{%endif%}
		<span class="user_date"> {{ article.published_on | date:'dd/MM/yyy' }}</span> 
	</a>
	<div class="blog_content"> 
		<h3><a href="{{ article.url }}" title="{{ article.title }}">{{ article.title }}</a></h3>
		<p class="update_date clearfix">
			<span class="user_name">Đăng bởi: <b>{{article.author}}</b></span> 

		</p>
		<p class="blog_description">{{ article.content | strip_html | truncatewords: 20 }}</p>
		{%if article.content.size > 0%}
		<a href="{{article.url}}" title="Đọc tiếp" class="read_more">Đọc tiếp >></a>
		{%endif%}
	</div>
</div>