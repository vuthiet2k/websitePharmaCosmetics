<section class="bread-crumb">
	<div class="container">
		<ul class="breadcrumb" >					
			<li class="home">
				<a  href="/" title="Trang chủ"><span >Trang chủ</span></a>						
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>
			{% if template contains 'product' %}
			{% if product.collections.size > 0 %}
			<li>
				<a class="changeurl"  href="{{ product.collections.first.url }}" title="{{ product.collections.first.name }}"><span >{{ product.collections.first.name }}</span></a>						
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>
			{% endif %}
			<li><strong><span>{{ product.name }}</span></strong></li>
			{% elsif template contains 'list_collections' %}
			<li><strong><span>{{ settings.list_collections_title | default: page_title }}</span></strong></li>
			{% elsif template contains 'collection' and collection.alias %}
			{% if current_tags %}					
			{% capture url %}/collections/{{ collection.alias }}{% endcapture %}
			<li>						
				<a  href="{{ collection.url }}" title="{{ collection.name}}"><span >{{ collection.name}}</span></a>												
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>					
			<li>						
				<strong ><span >{{ current_tags | join: ', ' }}</span></strong>											
			</li>
			{% else %}
			<li><strong ><span>{%if collection.name == 'All' or collection.name == 'all'%}Tất cả sản phẩm{%else%} {{ collection.name }}{%endif%}</span></strong></li>
			{% endif %}
			{% elsif template contains 'addresses' %}
			<li>
				<a  href="/account" title="Tài khoản"><span>Tài khoản</span></a>
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>
			<li><strong><span >Địa chỉ khách hàng</span></strong></li>
			{% elsif template contains 'order' %}
			<li>
				<a  href="/account" title="Tài khoản"><span>Tài khoản</span></a>
				<span class="mr_lr"> &nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp; </span>
			</li>

			<li><strong ><span>Đơn hàng {{ order.name}}</span></strong></li>

			{%- comment -%} 2026-10-18: mọi giao diện bài viết (article.*, vd article.truoc-va-sau) có đường dẫn Blog › bài — trước chỉ liệt kê 3 tên ⇒ trang ca rơi vào nhánh mặc định. {%- endcomment -%}
			{% elsif template contains 'article' %}
			<li>
				<a href="{{ blog.url }}" title="{{ blog.name }}"><span>{{ blog.name }}</span></a>	
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>
			<li><strong><span >{{ article.title }}</span></strong></li>
			{% elsif template == 'blog' or template == 'blog.duoc_si' or template == 'blog.video' %}
			{% if current_tags %}
			<li>
				<a href="{{ blog.url }}" title="{{ blog.name }}"><span>{{ blog.name }}</span></a>
				<span class="mr_lr">&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>&nbsp;</span>
			</li>
			<li><strong><span>{{current_tags}}</span></strong></li>
			{%else%}
			<li><strong ><span>{{ blog.name }}</span></strong></li>
			{%endif%}
			{% elsif template contains 'search' %}<li><strong><span>Tìm kiếm</span></strong></li>
			{% else %}
			<li><strong ><span>{{ page_title }}</span></strong></li>
			{% endif %}
		</ul>
	</div>
</section>