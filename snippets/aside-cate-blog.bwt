<div class="aside-content aside-content-blog !border-0 !rounded-none !p-0 !shadow-none !bg-transparent mb-6">
	<h2 class="title-head text-base lg:text-lg font-bold text-brand-deep m-0 !border-b-0 !pb-0 !mb-0">
		<span>{{ settings.aside_category_blog_title }}</span>
	</h2>
	<hr class="border-t border-line-soft my-3">
	<nav class="nav-category">
		<ul class="nav navbar-pills list-none p-0 m-0 divide-y divide-line-soft">
			{%if settings.aside_category_blog_menu.size > 1%}
			{%- for link in linklists[settings.aside_category_blog_menu].links -%}
			{%- if linklists[link.alias] -%}
			<li class="nav-item {% if link.active %}active{% endif %} relative">
				<a title="{{ link.title }}" href="{{ link.url }}" class="nav-link pr-11 min-h-[44px] flex items-center text-sm text-ink no-underline hover:text-primary transition-colors">{{ link.title }}</a>
				<button type="button" class="open_mnu down_icon min-h-[44px] min-w-[44px] absolute right-0 top-0 inline-flex items-center justify-center border-0 bg-transparent cursor-pointer text-ink-muted transition-transform duration-200 [&.cls_mn]:rotate-180" aria-label="Mở rộng">{% include 'ui_icon', name: 'chevron-down', size: 16 %}</button>
				<ul class="menu_down hidden list-none pl-4 m-0">
					{%- for childlink in linklists[link.alias].links -%}
					{%- if linklists[childlink.alias] -%}
					<li class="dropdown-submenu nav-item {% if childlink.active %}active{% endif %} relative">
						<a title="{{ childlink.title }}" class="nav-link pr-11 min-h-[44px] flex items-center text-sm text-ink-secondary no-underline hover:text-primary transition-colors" href="{{ childlink.url }}">{{ childlink.title }}</a>
						<button type="button" class="open_mnu down_icon min-h-[44px] min-w-[44px] absolute right-0 top-0 inline-flex items-center justify-center border-0 bg-transparent cursor-pointer text-ink-muted transition-transform duration-200 [&.cls_mn]:rotate-180" aria-label="Mở rộng">{% include 'ui_icon', name: 'chevron-down', size: 16 %}</button>
						<ul class="menu_down hidden list-none pl-4 m-0">
							{%- for childlink2 in linklists[childlink.alias].links -%}
							{%- if linklists[childlink2.alias] -%}
							<li class="dropdown-submenu nav-item {% if childlink2.active %}active{% endif %} relative">
								<a title="{{ childlink2.title }}" class="nav-link pr-11 min-h-[44px] flex items-center text-sm text-ink-secondary no-underline hover:text-primary transition-colors" href="{{ childlink2.url }}">{{ childlink2.title }}</a>
								<button type="button" class="open_mnu down_icon min-h-[44px] min-w-[44px] absolute right-0 top-0 inline-flex items-center justify-center border-0 bg-transparent cursor-pointer text-ink-muted transition-transform duration-200 [&.cls_mn]:rotate-180" aria-label="Mở rộng">{% include 'ui_icon', name: 'chevron-down', size: 16 %}</button>
								<ul class="menu_down hidden list-none pl-4 m-0">
									{%- for childlink3 in linklists[childlink2.alias].links -%}
									<li class="dropdown-submenu nav-item {% if childlink3.active %}active{% endif %}">
										<a title="{{ childlink3.title }}" class="nav-link min-h-[44px] flex items-center text-sm text-ink-muted no-underline hover:text-primary transition-colors" href="{{ childlink3.url }}">{{ childlink3.title }}</a>
									</li>
									{%- endfor -%}
								</ul>
							</li>
							{%- else -%}
							<li class="nav-item">
								<a title="{{ childlink2.title }}" class="nav-link min-h-[44px] flex items-center text-sm text-ink-secondary no-underline hover:text-primary transition-colors" href="{{ childlink2.url }}">{{ childlink2.title }} </a>
							</li>
							{%- endif -%}
							{%- endfor -%}
						</ul>                      
					</li>
					{%- else -%}
					<li class="nav-item">
						<a  title="{{ childlink.title }}" class="nav-link min-h-[44px] flex items-center text-sm text-ink-secondary no-underline hover:text-primary transition-colors" href="{{ childlink.url }}">{{ childlink.title }}</a>
					</li>
					{%- endif -%}
					{%- endfor -%}
				</ul>
			</li>
			{%- else -%}
			<li class="nav-item {% if link.active %}active{% endif %} relative">
				<a title="{{ link.title }}" class="nav-link min-h-[44px] flex items-center text-sm text-ink no-underline hover:text-primary transition-colors" href="{{ link.url }}">{{ link.title }}</a>
			</li>
			{%- endif -%}
			{%- endfor -%}
			{%- else -%}
			<li class="nav-item relative py-2">
				<span class="text-ink cursor-default text-sm">Chưa cập nhật</span>
			</li>
				{%- endif -%}
		</ul>
	</nav>
</div>
<script>
	$(".aside-content-blog .nav-category .open_mnu").click(function(){
		$(this).toggleClass('cls_mn').next('.menu_down').toggleClass('hidden');
	});
</script>
