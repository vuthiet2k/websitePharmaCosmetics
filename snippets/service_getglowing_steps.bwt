{%- comment -%}
  service_getglowing_steps — 4. Quy trình trị liệu cá nhân hóa 1:1: 5 bước (ảnh 4:3 tuỳ chọn). Desktop 5 cột tiến trình,
  mobile xếp dọc (theo hướng dẫn bố cục bàn giao).
{%- endcomment -%}
<section id="service-steps-section" class="gg-section gg-section--white">
  <div class="container">
    <header class="gg-head">
      {%- if settings.gg_steps_eyebrow != blank -%}<p class="gg-eyebrow">{{ settings.gg_steps_eyebrow | escape }}</p>{%- endif -%}
      <h2 class="gg-title">{{ settings.gg_steps_title | default: 'Mỗi làn da một hồ sơ. Mỗi khách hàng một phác đồ.' | escape }}</h2>
    </header>
    <ol class="gg-steps">
      {%- for i in (1..5) -%}
      {%- assign k_img = 'gg_step_' | append: i | append: '_image' -%}
      {%- assign k_title = 'gg_step_' | append: i | append: '_title' -%}
      {%- assign k_text = 'gg_step_' | append: i | append: '_text' -%}
      {%- if settings[k_title] != blank -%}
      <li class="gg-card gg-step">
        {%- if settings[k_img] != blank -%}
        <div class="gg-media gg-media--4x3"><img src="{{ settings[k_img] | img_url: 'large' }}" alt="{{ settings[k_title] | escape }}" width="1200" height="900" loading="lazy" decoding="async"></div>
        {%- endif -%}
        <div class="gg-card__body">
          <span class="gg-step__no">Bước 0{{ i }}</span>
          <h3 class="gg-card__title">{{ settings[k_title] | escape }}</h3>
          {%- if settings[k_text] != blank -%}<p class="gg-card__text">{{ settings[k_text] | escape }}</p>{%- endif -%}
        </div>
      </li>
      {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
