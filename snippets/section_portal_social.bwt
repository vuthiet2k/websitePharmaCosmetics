<section class="social"><div class="wrap">
  <div class="social-top"><div><p class="eyebrow">Theo dõi hành trình mỗi ngày</p><h2>{{ settings.store_name | default: store.name | escape }}</h2><p class="bio">{{ settings.portal_social_desc | escape }}</p></div><a class="btn btn-w" href="{{ settings.home_hero_btn1_url | default: '/dat-lich-tu-van' | escape }}">Đặt lịch tư vấn →</a></div>
  <div class="chan">
    {% assign channels = 'fb,insta,tiktok,youtube' | split: ',' %}{% assign labels = 'Facebook,Instagram,TikTok,YouTube' | split: ',' %}
    {% for channel in channels %}{% capture key %}footer_social_{{ channel }}{% endcapture %}{% if settings[key] != blank %}<a href="{{ settings[key] | escape }}" target="_blank" rel="noopener noreferrer"><div><b>{{ labels[forloop.index0] }}</b><small>Theo dõi chúng tôi ↗</small></div></a>{% endif %}{% endfor %}
  </div>
</div></section>
