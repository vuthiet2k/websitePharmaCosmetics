{%- comment -%} 2026-10-08: bật sao đánh giá thật trên thẻ ở trang danh mục (xem product_grid_office). {%- endcomment -%}
{%- assign pc_card_rating = true -%}
<div class="products-view products-view-grid list_hover_pro">
	<div class="row">
		{% for product in collection.products %}
		<div class="col-6 col-xl-3 col-lg-4 col-md-4">
			<div class="item_product_main">
				{%- comment -%} 2026-10-10: thẻ mới theo thiết kế trang danh mục (snippets/product_card_collection.bwt). {%- endcomment -%}{%- include 'product_card_collection' -%}	
			</div>
		</div>			
		{% endfor %}
	</div>
</div>
<div class="pagenav">
	{% if paginate.pages > 1 %}
	{% include 'collection-paginate-pages' %}
	{% endif %}
</div>