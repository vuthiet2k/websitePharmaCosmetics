{%- comment -%}
  snippets/ui_field.bwt — THƯ VIỆN PC (KHOÁ sau đợt 0, R5). Ô nhập (C.2 #4).
  Tham số: name, label (bắt buộc), type = text | email | tel | password | number | search | date | textarea | checkbox (mặc định text),
  id (mặc định pc-f-<name>), value, placeholder, required, autocomplete, inputmode, hint, error (lỗi tiếng Việt có sẵn từ máy chủ).
  Nhãn trên ô; ô 16px cao 44px (class pc-input); lỗi ngay dưới ô, nối bằng aria-describedby. Ô lỗi luôn có sẵn (ẩn bằng class
  hidden khi trống) để assets/pc-ui.js (data-pc-form, D05) điền lỗi và bỏ hidden. Form chứa ô phải có novalidate.
{%- endcomment -%}
{%- assign pc_ft = type | default: 'text' -%}
{%- assign pc_fid = name | prepend: 'pc-f-' -%}{%- if id != blank -%}{%- assign pc_fid = id -%}{%- endif -%}
{%- if name == blank -%}<!-- PC-ERROR ui_field: thiếu name -->
{%- elsif label == blank -%}<!-- PC-ERROR ui_field: thiếu label -->
{%- elsif pc_ft != 'text' and pc_ft != 'email' and pc_ft != 'tel' and pc_ft != 'password' and pc_ft != 'number' and pc_ft != 'search' and pc_ft != 'date' and pc_ft != 'textarea' and pc_ft != 'checkbox' -%}<!-- PC-ERROR ui_field: type "{{ pc_ft }}" không hợp lệ -->
{%- else -%}
  {%- capture pc_fdesc -%}{% if hint != blank %}{{ pc_fid }}-hint {% endif %}{{ pc_fid }}-error{%- endcapture -%}
  {%- capture pc_fattrs -%} id="{{ pc_fid }}" name="{{ name }}" aria-describedby="{{ pc_fdesc }}"{% if required %} required aria-required="true"{% endif %}{% if autocomplete != blank %} autocomplete="{{ autocomplete }}"{% endif %}{% if inputmode != blank %} inputmode="{{ inputmode }}"{% endif %}{% if error != blank %} aria-invalid="true"{% endif %}{%- endcapture -%}
  {%- if pc_ft == 'checkbox' -%}
  <div class="pc-field">
    <label class="pc-check"><input class="pc-check__box" type="checkbox"{{ pc_fattrs }} value="{{ value | default: 'true' | escape }}"> <span>{{ label }}</span></label>
  {%- else -%}
  <div class="pc-field">
    <label class="pc-label" for="{{ pc_fid }}">{{ label }}{% if required %} <span aria-hidden="true">*</span>{% endif %}</label>
    {%- if pc_ft == 'textarea' -%}
    <textarea class="pc-input" rows="4"{{ pc_fattrs }}{% if placeholder != blank %} placeholder="{{ placeholder | escape }}"{% endif %}>{{ value | escape }}</textarea>
    {%- else -%}
    <input class="pc-input" type="{{ pc_ft }}"{{ pc_fattrs }}{% if value != blank %} value="{{ value | escape }}"{% endif %}{% if placeholder != blank %} placeholder="{{ placeholder | escape }}"{% endif %}>
    {%- endif -%}
  {%- endif -%}
    {%- if hint != blank -%}<p id="{{ pc_fid }}-hint" class="pc-hint">{{ hint }}</p>{%- endif -%}
    <p id="{{ pc_fid }}-error" class="pc-error{% if error == blank %} hidden{% endif %}" data-pc-error>{% if error != blank %}{% include 'ui_icon', name: 'circle-alert', size: 20, label: '' %}<span>{{ error }}</span>{% endif %}</p>
  </div>
{%- endif -%}
