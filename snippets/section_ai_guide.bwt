{%- comment -%}
  C02 (phase home-shopping-ux, 2026-09-20; nội dung hiệu chỉnh 2026-09-24): khối hướng dẫn ngay sau Hero để người mới biết bắt
  đầu Quiz da AI từ trang chủ (trước đây Hero chỉ có "Đặt lịch phân tích da" và "Chọn theo vấn đề
  da", không có đường dẫn nào tới /kham-da-ai). Mô tả đúng luồng hiện có: trả lời khảo sát,
  nhận gợi ý tham khảo từ câu trả lời/danh mục, rồi xem thông tin sản phẩm hoặc liên hệ chuyên gia.
  Không mô tả đây là chẩn đoán hoặc phác đồ y khoa.
{%- endcomment -%}
{%- comment -%}
  section_ai_guide.bwt — Khối hướng dẫn Quiz da AI sau Hero.
  100% Tailwind utility class trực tiếp trên thẻ ngữ nghĩa.
{%- endcomment -%}
{%- assign ai_guide_eyebrow = settings.home_ai_guide_eyebrow | default: 'Chưa biết bắt đầu từ đâu?' | escape -%}
{%- assign ai_guide_title = settings.home_ai_guide_title | default: 'Chưa biết chọn sản phẩm phù hợp với làn da?' | escape -%}
{%- assign ai_guide_desc = settings.home_ai_guide_desc | default: 'Trả lời một số câu hỏi về làn da để nhận gợi ý tham khảo từ Pharma Cosmetics.' | escape -%}
{%- assign ai_guide_cta_url = settings.home_ai_guide_cta_url | default: '/kham-da-ai' | escape -%}
{%- assign ai_guide_cta_text = settings.home_ai_guide_cta_text | default: 'Bắt đầu khảo sát da' | escape -%}
<section class="pc-ai-guide bg-white py-10 lg:py-16 font-sans text-ink" aria-labelledby="section-ai-guide-title">
  <div class="container">
    {%- include 'ui_section_head', title: ai_guide_title, title_id: 'section-ai-guide-title', eyebrow: ai_guide_eyebrow, desc: ai_guide_desc, wrap_class: 'mb-6 lg:mb-8' -%}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="flex flex-col gap-6">
        <ol class="m-0 list-none p-0 flex flex-col gap-4">
          <li class="flex items-start gap-3.5 rounded-2xl border border-solid border-line-soft bg-surface-soft p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white" aria-hidden="true">1</span>
            <span class="text-sm font-medium leading-relaxed text-ink">{{ settings.home_ai_guide_step1 | default: 'Trả lời khảo sát cùng trợ lý Pharma AI' | escape }}</span>
          </li>
          <li class="flex items-start gap-3.5 rounded-2xl border border-solid border-line-soft bg-surface-soft p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white" aria-hidden="true">2</span>
            <span class="text-sm font-medium leading-relaxed text-ink">{{ settings.home_ai_guide_step2 | default: 'Nhận kết quả tham khảo và gợi ý hoạt chất' | escape }}</span>
          </li>
          <li class="flex items-start gap-3.5 rounded-2xl border border-solid border-line-soft bg-surface-soft p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white" aria-hidden="true">3</span>
            <span class="text-sm font-medium leading-relaxed text-ink">{{ settings.home_ai_guide_step3 | default: 'Xem sản phẩm tham khảo hoặc liên hệ chuyên gia' | escape }}</span>
          </li>
        </ol>
        <div>
          <a class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-btn px-6 py-2.5 text-sm font-bold text-btn-text hover:bg-btn-hover transition-colors no-underline" href="{{ ai_guide_cta_url }}">
            {{ ai_guide_cta_text }}
            {% include 'ui_icon', name: 'arrow-right' %}
          </a>
        </div>
      </div>
      {%- capture pc_skin_photo -%}{% include 'skin_scan_photo_url' %}{%- endcapture -%}
      {%- if pc_skin_photo != blank -%}
      <figure class="m-0 overflow-hidden rounded-2xl border border-solid border-line-soft bg-surface-soft">
        <img class="block h-auto w-full object-cover" src="{{ pc_skin_photo | strip }}" alt="{{ settings.home_skin_scan_image_alt | default: 'Khách hàng chăm sóc da mặt' | escape }}" width="1200" height="800" loading="lazy">
      </figure>
      {%- endif -%}
    </div>
  </div>
</section>
