{%- if template contains 'product' -%}{%- if settings.product_tab3_enable -%}{%- include 'bpr-products-module' -%}{%- endif -%}{%- endif -%}
{%- include 'ajaxcart' -%}
{%- if template contains 'index' or template contains 'collection' or template contains 'product' or template contains 'search' or template contains 'article'  or template contains 'page.khuyen-mai' or template contains 'cart' or template contains 'favorite' -%}
{%- if settings.quickview_enable -%}	
{%- unless template contains 'page.dat_hang_nhanh' -%}
{%- include 'quickview-template' -%} 
<link rel="preload" as="script" href="{{ 'quickview.js' | asset_url }}" />
<script type="text/javascript" defer src="{{ 'quickview.js' | asset_url }}"></script>
{%- endunless -%}
{%- endif -%}
{%- endif -%}
<link rel="preload" as="script" href="{{ 'main.js' | asset_url }}" />
<script defer src="{{ 'main.js' | asset_url }}"></script>
<script defer src="{{ 'mobile-ui.js' | asset_url }}"></script>
<script>
(function() {
  var header = document.querySelector('.main-header');
  if (!header) return;
  window.addEventListener('scroll', function() {
    header.classList.toggle('is-scrolled', window.scrollY > 10);
  }, { passive: true });
})();

/* Global scroll-reveal — observe .pc-reveal elements */
(function() {
  var els = document.querySelectorAll('.pc-reveal');
  if (!els.length) return;
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(el) { el.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
  els.forEach(function(el) { io.observe(el); });
})();
</script>
{%- if template contains 'index' -%}
{%- comment -%} defer: script sync ở đây chặn parse cuối body → tap chết trên mobile lúc load {%- endcomment -%}
<link rel="preload" as="script" href="{{ 'index.js' | asset_url }}" />
<script defer src="{{ 'index.js' | asset_url }}"></script>
{%- endif -%}
{%- comment -%}
  T-22: mở rộng sang 'search' để trang tìm kiếm dùng ĐÚNG cơ chế lọc thật
  (Bizweb.SearchFilter/col.js) thay vì bộ lọc tĩnh giả trước đây trong search.bwt.
  filter.addValue("collection", ...) vẫn chỉ chạy khi collection.id > 0 (context search
  không có object collection → điều kiện tự false, không ảnh hưởng).
{%- endcomment -%}
{%- if template contains 'collection' or template contains 'search' -%}
<link rel="preload" as='style'  type="text/css" href="{{ 'vendor_jquery_ui.scss.css' | asset_url }}">
<link rel="preload" as="script" href="{{ 'jquery-ui-min.js' | asset_url }}" />
{{ 'vendor_jquery_ui.scss.css' | asset_url | stylesheet_tag }}
{{ 'jquery-ui-min.js' | asset_url | script_tag }}
<script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js"></script>
{{ 'search_filter.js'  | asset_url | script_tag }}
<script>
	var filter = new Bizweb.SearchFilter();
	{%- if collection.id > 0 -%}
	filter.addValue("collection", "collections", "{{ collection.id }}", "AND");
	{%- endif -%}
	/* clearAllFiltered() — canonical version trong col.js.bwt (Sprint 3 refactor) */
</script>
<link rel="preload" as="script" href="{{ 'col.js' | asset_url }}" />
{{ 'col.js' | asset_url | script_tag }}
{%- endif -%}
{%- if template contains 'product' or template contains 'page.combo_mix_match'-%}
<link rel="preload" as="script" href="{{ 'picbox.js' | asset_url }}" />
<link rel="preload" as='style'  type="text/css" href="{{ 'comp_picbox.scss.css' | asset_url }}">
{{ 'comp_picbox.scss.css' | asset_url | stylesheet_tag }}
{{ 'picbox.js' | asset_url | script_tag }}
{%- endif -%}

{%- if template contains 'page.dat_hang_nhanh' -%}
{%- include 'quickview-buy' -%}
{%- endif -%}
{%- if settings.popup_banner_enable -%}
{%- include 'popup_banner' -%}
{%- endif -%}