{%- comment -%}
  Product JSON-LD (2026-10-03) — thay microdata cũ (itemprop rải trong <section> + product-reviews.bwt,
  tạo 2 thực thể Product tách rời). Giữ nguyên các dữ kiện cũ đã khai báo; bỏ phần sai kiểu schema.org
  (ItemAvailability/supersededBy, Downpayment) và sửa URL "http:"/"https:https:". aggregateRating lấy
  từ app Sapo Product Reviews (metafields.bpr), chỉ in khi có đánh giá thật.
  shippingDetails / hasMerchantReturnPolicy: chỉ in khi admin bật enable_shipping_policy /
  enable_return_policy VÀ nhập đủ số liệu (nhóm "Trang sản phẩm") — không khai báo chính sách giả định
  (quyết định 2026-10-03: bản cũ hardcode "miễn phí ship, đổi trả 30 ngày").
{%- endcomment -%}
{%- comment -%} Mỗi số liệu phải là số nguyên thuần (cho phép dấu . , ngăn cách nghìn) — nhập "7 ngày" thì bỏ cả khối thay vì khai báo 0. {%- endcomment -%}
{%- assign pc_ld_ship = settings.enable_shipping_policy -%}
{%- assign pc_ld_keys = 'shipping_policy_rate,shipping_policy_handling_min_days,shipping_policy_handling_max_days,shipping_policy_transit_min_days,shipping_policy_transit_max_days' | split: ',' -%}
{%- for pc_ld_key in pc_ld_keys -%}
  {%- assign pc_ld_raw = settings[pc_ld_key] | append: '' | remove: '.' | remove: ',' | strip -%}
  {%- assign pc_ld_num = pc_ld_raw | plus: 0 | append: '' -%}
  {%- if pc_ld_raw == blank or pc_ld_num != pc_ld_raw -%}{%- assign pc_ld_ship = false -%}{%- endif -%}
{%- endfor -%}
{%- assign pc_ld_return = settings.enable_return_policy -%}
{%- assign pc_ld_raw = settings.return_policy_days | append: '' | strip -%}
{%- assign pc_ld_num = pc_ld_raw | plus: 0 | append: '' -%}
{%- if pc_ld_raw == blank or pc_ld_num != pc_ld_raw or pc_ld_num == '0' -%}{%- assign pc_ld_return = false -%}{%- endif -%}
{%- assign pc_ld_base = store.url | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
{%- assign pc_ld_variant = product.variants[0] -%}
{%- capture pc_ld_images -%}
  {%- for image in product.images limit: 5 -%}
    {%- assign pc_ld_img = image.src | img_url: 'grande' | remove: 'https:' | remove: 'http:' | prepend: 'https:' -%}
    {{ pc_ld_img | json }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endcapture -%}
{%- if pc_ld_images == blank and product.featured_image.src != blank -%}
  {%- capture pc_ld_images -%}{{ product.featured_image.src | img_url: 'grande' | remove: 'https:' | remove: 'http:' | prepend: 'https:' | json }}{%- endcapture -%}
{%- endif -%}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Product",
	"name": {{ product.name | json }},
	"url": {{ pc_ld_base | append: product.url | json }},
	{%- if pc_ld_images != blank %}
	"image": [{{ pc_ld_images | strip }}],
	{%- endif %}
	{%- assign pc_ld_desc = product.summary_or_content | strip_html | strip_newlines | strip -%}
	{%- if pc_ld_desc != blank %}
	"description": {{ pc_ld_desc | json }},
	{%- endif %}
	{%- if product.collections.first.name != blank %}
	"category": {{ product.collections.first.name | json }},
	{%- endif %}
	{%- if product.vendor != blank %}
	"brand": {"@type": "Brand", "name": {{ product.vendor | json }}},
	{%- endif %}
	{%- if product.style != blank %}
	"model": {{ product.style | json }},
	{%- endif %}
	{%- if pc_ld_variant.sku != blank %}
	"sku": {{ pc_ld_variant.sku | json }},
	{%- endif %}
	{%- if pc_ld_variant.barcode != blank %}
	"gtin": {{ pc_ld_variant.barcode | json }},
	{%- endif %}
	{%- if product.metafields.bpr.votes > 0 %}
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": {{ product.metafields.bpr.rating | json }},
		"ratingCount": {{ product.metafields.bpr.votes | json }},
		"bestRating": 5,
		"worstRating": 1
	},
	{%- endif %}
	"offers": {
		"@type": "Offer",
		"url": {{ pc_ld_base | append: product.url | json }},
		"price": {{ pc_ld_variant.price | round | json }},
		"priceCurrency": {{ store.currency | default: 'VND' | json }},
		"priceValidUntil": "2099-01-01",
		"availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
		"itemCondition": "https://schema.org/NewCondition",
		{%- if pc_ld_ship %}
		"shippingDetails": {
			"@type": "OfferShippingDetails",
			"shippingRate": {"@type": "MonetaryAmount", "value": {{ settings.shipping_policy_rate | remove: '.' | remove: ',' | strip | plus: 0 }}, "currency": {{ store.currency | default: 'VND' | json }}},
			"shippingDestination": {"@type": "DefinedRegion", "addressCountry": "VN"},
			"deliveryTime": {
				"@type": "ShippingDeliveryTime",
				"handlingTime": {"@type": "QuantitativeValue", "minValue": {{ settings.shipping_policy_handling_min_days | plus: 0 }}, "maxValue": {{ settings.shipping_policy_handling_max_days | plus: 0 }}, "unitCode": "DAY"},
				"transitTime": {"@type": "QuantitativeValue", "minValue": {{ settings.shipping_policy_transit_min_days | plus: 0 }}, "maxValue": {{ settings.shipping_policy_transit_max_days | plus: 0 }}, "unitCode": "DAY"}
			}
		},
		{%- endif %}
		{%- if pc_ld_return %}
		"hasMerchantReturnPolicy": {
			"@type": "MerchantReturnPolicy",
			"applicableCountry": "VN",
			"returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
			"merchantReturnDays": {{ settings.return_policy_days | plus: 0 }},
			"returnMethod": {{ settings.return_policy_method | default: 'ReturnByMail' | prepend: 'https://schema.org/' | json }},
			"returnFees": {{ settings.return_policy_fees | default: 'FreeReturn' | prepend: 'https://schema.org/' | json }}
		},
		{%- endif %}
		"seller": {"@type": "Organization", "name": {{ store.name | json }}, "url": {{ pc_ld_base | json }}}
	}
}
</script>
