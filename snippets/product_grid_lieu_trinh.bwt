{% assign my_collection_1 = collections['dieu-tri-chuyen-nghiep-1'] %}
{% assign my_collection_2 = collections['dieu-tri-chuyen-nghiep-2'] %}

<div class="products-view products-view-grid list_hover_pro">
	<div class="products-row">
		<h3 class="card-title text-uppercase font-weight-bold text-primary mb-3 title-0" style="color: #4d4d4d;font-size: var(--fs-xl);/* TODO confirm — rounded from 25px */">

		  </h3>
		  <p class="card-text des-0" style="color: #4d4d4dbf;font-size: var(--fs-base);">

		  </p>
		<div class="row">
			{% for product in collection.products %}
			<div class="col-6 col-xl-3 col-lg-4 col-md-4">
				<div class="item_product_main">
					{%include 'product_grid_office_lieu_trinh'%}	
				</div>
			</div>			
			{% endfor %}
		</div>
	</div>
	
	<div class="products-row" style="margin-top: 25px;">
		<h3 class="card-title text-uppercase font-weight-bold text-primary mb-3 title-1" style="color: #4d4d4d;font-size: var(--fs-xl);/* TODO confirm — rounded from 25px */">

		  </h3>
		  <p class="card-text des-1" style="color: #4d4d4dbf;font-size: var(--fs-base);">

		  </p>
		<div class="row">
			{% for product in my_collection_1.products %}
			<div class="col-6 col-xl-3 col-lg-4 col-md-4">
				<div class="item_product_main">
					{%include 'product_grid_office_lieu_trinh'%}	
				</div>
			</div>			
			{% endfor %}
		</div>
	</div>
	
	<div class="products-row" style="margin-top: 25px;">
		<h3 class="card-title text-uppercase font-weight-bold text-primary mb-3 title-2" style="color: #4d4d4d;font-size: var(--fs-xl);/* TODO confirm — rounded from 25px */">

		  </h3>
		  <p class="card-text des-2" style="color: #4d4d4dbf;font-size: var(--fs-base);">

		  </p>
		<div class="row">
			{% for product in my_collection_2.products %}
			<div class="col-6 col-xl-3 col-lg-4 col-md-4">
				<div class="item_product_main">
					{%include 'product_grid_office_lieu_trinh'%}	
				</div>
			</div>			
			{% endfor %}
		</div>
	</div>
	
</div>
<div class="pagenav">
	{% if paginate.pages > 1 %}
	{% include 'collection-paginate-pages' %}
	{% endif %}
</div>

<script>
function convertDescriptionToJson(htmlString) {
	const parser = new DOMParser();
	const doc = parser.parseFromString(htmlString, "text/html");

	const result = [];
	const h2s = doc.querySelectorAll("h2");

	h2s.forEach(h2 => {
		const p = h2.nextElementSibling;
		if (p && p.tagName.toLowerCase() === "p") {
			result.push({
				title: h2.innerText.trim(),
				des: p.innerText.trim()
			});
		}
	});

	return result;
}
	
// T-131 (2026-09-12): lỗi JS THẬT trên /dieu-tri-chuyen-nghiep (bắt qua pageerror Playwright):
// "TypeError: Cannot read properties of undefined (reading 'title')". convertDescriptionToJson
// trả MẢNG RỖNG khi mô tả danh mục không có cặp <h2>+<p> (hoặc rỗng hẳn — đúng trường hợp danh
// mục placeholder hiện tại), nhưng code cũ truy cập thẳng data[0].title → ném lỗi và CHẶN TOÀN BỘ
// script chạy sau đó trên trang. Mô tả danh mục là nội dung người quản trị tự nhập trong Sapo
// Admin nên rỗng/không đúng cấu trúc là tình huống hợp lệ, phải chịu được.
function applyBlock(data, idx) {
	const item = (data || [])[0];
	if (!item) return;              // giữ nguyên nội dung tĩnh sẵn có trong markup
	$('.title-' + idx).text(item.title);
	$('.des-' + idx).text(item.des);
}

const rawHtml = `{{ collection.description }}`;
applyBlock(convertDescriptionToJson(rawHtml), 0);

const rawHtml_1 = `{{ my_collection_1.description }}`;
applyBlock(convertDescriptionToJson(rawHtml_1), 1);

const rawHtml_2 = `{{ my_collection_2.description }}`;
applyBlock(convertDescriptionToJson(rawHtml_2), 2);

</script>