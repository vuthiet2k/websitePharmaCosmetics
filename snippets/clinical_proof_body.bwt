{%- comment -%}
  clinical_proof_body.bwt (13/11/2026) — thân trang «Trước & Sau · Chăm sóc da từ xa», dùng chung cho
  blog.truoc-va-sau (gán thẳng cho danh mục bài viết; 14/11/2026 đã bỏ page.clinical-proof).
  Đầu vào: pc_ba_blog (blog chứa ca), pc_ba_title (tiêu đề dự phòng cho H1/alt). Nguồn dữ liệu & quy ước: snippets/ba_case_source.bwt + docs/huong-dan-tao-ca-truoc-sau.md.
  Gọi từ blog.truoc-va-sau phải bọc trong khối paginate (50 bài) để blog.articles trả đủ bài.
{%- endcomment -%}
{%- assign pc_ba_cta_link = settings.clinical_hero_cta_link | default: '/kham-da-ai' -%}
{%- assign pc_ba_group_other = settings.clinical_group_other | default: 'Kết quả khác' -%}

{%- comment -%} Lượt 1: gom tên nhóm (giữ thứ tự xuất hiện) + tìm cặp ảnh dự phòng cho hero. {%- endcomment -%}
{%- assign pc_ba_groups = '' -%}{%- assign pc_ba_has_other = false -%}
{%- assign pc_ba_first_before = '' -%}
{%- assign pc_ba_first_after = '' -%}
{%- assign pc_ba_first_title = '' -%}{%- assign pc_ba_first_single = '' -%}
{%- for pc_ba in pc_ba_blog.articles limit: 50 -%}
  {%- assign pc_bs_article = pc_ba -%}{%- include 'ba_case_source' -%}
  {%- assign pc_ba_before = pc_bs_before -%}{%- assign pc_ba_after = pc_bs_after -%}{%- assign pc_ba_group = pc_bs_group -%}
  {%- if pc_bs_single or pc_ba_before != blank and pc_ba_after != blank -%}
    {%- comment -%} 2026-10-18: ca không gắn nhom: gom vào nhóm "khác" — luôn đứng cuối (tab lọc). {%- endcomment -%}
    {%- if pc_ba_group == blank or pc_ba_group == pc_ba_group_other -%}{%- assign pc_ba_has_other = true -%}{%- else -%}
    {%- assign pc_ba_wrapped = '|' | append: pc_ba_group | append: '|' -%}
    {%- unless pc_ba_groups contains pc_ba_wrapped -%}{%- assign pc_ba_groups = pc_ba_groups | append: pc_ba_wrapped -%}{%- endunless -%}
    {%- endif -%}
    {%- if pc_ba_first_before == blank and pc_ba_first_single == blank -%}
      {%- assign pc_ba_first_title = pc_ba.title -%}
      {%- if pc_bs_single -%}{%- assign pc_ba_first_single = pc_bs_imgs | split: '|' | first -%}
      {%- else -%}{%- assign pc_ba_first_before = pc_ba_before -%}{%- assign pc_ba_first_after = pc_ba_after -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if pc_ba_has_other -%}{%- assign pc_ba_groups = pc_ba_groups | append: '|' | append: pc_ba_group_other | append: '|' -%}{%- endif -%}
{%- assign pc_ba_group_list = pc_ba_groups | split: '|' -%}

{%- comment -%}
  12/11/2026 (người dùng): media hero ưu tiên lấy từ ô MÔ TẢ của danh mục bài viết Trước & Sau (Sapo › Danh mục bài viết):
    1. Có nhúng <iframe> (video YouTube…) ⇒ hero là video đó (khung 16:9).
    2. Không có video, có ảnh ⇒ ảnh ĐẦU TIÊN, hiện nguyên khung (1 ảnh, không tách trước/sau).
    3. Mô tả không có ảnh/video ⇒ cặp ảnh Theme Settings clinical_hero_before/after (đủ cả hai) ⇒ ca đầu tiên (cặp hoặc 1 ảnh).
{%- endcomment -%}
{%- assign pc_ba_hero_video = '' -%}{%- assign pc_ba_hero_single = '' -%}
{%- assign pc_ba_hero_before = '' -%}{%- assign pc_ba_hero_after = '' -%}
{%- comment -%} 14/11/2026: ô Mô tả của danh mục bài viết — Sapo có thể trả qua description hoặc content (body_html/summary dự phòng); lấy trường đầu tiên có dữ liệu. {%- endcomment -%}
{%- assign pc_ba_desc = pc_ba_blog.description -%}
{%- if pc_ba_desc == blank -%}{%- assign pc_ba_desc = pc_ba_blog.content -%}{%- endif -%}
{%- if pc_ba_desc == blank -%}{%- assign pc_ba_desc = pc_ba_blog.body_html -%}{%- endif -%}
{%- if pc_ba_desc == blank -%}{%- assign pc_ba_desc = pc_ba_blog.summary -%}{%- endif -%}
{%- if pc_ba_desc contains '<iframe' -%}
  {%- assign pc_ba_v = pc_ba_desc | prepend: '~' | split: '<iframe' -%}
  {%- for pc_ba_vp in pc_ba_v offset: 1 limit: 1 -%}
    {%- assign pc_ba_hero_video = pc_ba_vp | split: '</iframe>' | first | prepend: '<iframe' | append: '</iframe>' -%}
  {%- endfor -%}
{%- elsif pc_ba_desc contains '<img' -%}
  {%- assign pc_ba_d = pc_ba_desc | prepend: '~' | split: '<img' -%}
  {%- for pc_ba_dp in pc_ba_d offset: 1 limit: 1 -%}
    {%- assign pc_ba_d_attr = pc_ba_dp | split: '>' | first -%}
    {%- if pc_ba_d_attr contains 'src="' -%}{%- assign pc_ba_hero_single = pc_ba_d_attr | split: 'src="' | last | split: '"' | first -%}
    {%- elsif pc_ba_d_attr contains "src='" -%}{%- assign pc_ba_hero_single = pc_ba_d_attr | split: "src='" | last | split: "'" | first -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if pc_ba_hero_video == blank and pc_ba_hero_single == blank -%}
  {%- if settings.clinical_hero_before != blank and settings.clinical_hero_after != blank -%}
    {%- assign pc_ba_hero_before = settings.clinical_hero_before | img_url: 'large' -%}
    {%- assign pc_ba_hero_after = settings.clinical_hero_after | img_url: 'large' -%}
  {%- elsif pc_ba_first_before != blank -%}
    {%- assign pc_ba_hero_before = pc_ba_first_before -%}{%- assign pc_ba_hero_after = pc_ba_first_after -%}
  {%- else -%}
    {%- assign pc_ba_hero_single = pc_ba_first_single -%}
  {%- endif -%}
{%- endif -%}
{%- assign pc_ba_hero_media = true -%}
{%- if pc_ba_hero_video == blank and pc_ba_hero_single == blank and pc_ba_hero_before == blank -%}{%- assign pc_ba_hero_media = false -%}{%- endif -%}

{% include 'breadcrumb' %}
<main class="pc-ba">
  <section class="container pc-ba-hero{% unless pc_ba_hero_media %} pc-ba-hero--text{% endunless %}">
    <div class="pc-ba-hero__text">
      <p class="pc-ba-kicker">{{ settings.clinical_hero_kicker | default: 'TRƯỚC & SAU · CHĂM SÓC DA TỪ XA' }}</p>
      <h1 class="pc-ba-hero__title">{{ settings.clinical_hero_title | default: pc_ba_title }}</h1>
      {%- if settings.clinical_intro != blank -%}<p class="pc-ba-hero__lead">{{ settings.clinical_intro }}</p>{%- endif -%}
      <div class="pc-ba-actions">
        <a href="{{ pc_ba_cta_link }}" class="pc-ba-btn pc-ba-btn--primary">{{ settings.clinical_hero_cta_label | default: 'Nhận phân tích da miễn phí' }}</a>
        {%- if pc_ba_groups != blank -%}
        <a href="#pc-ba-results" class="pc-ba-btn pc-ba-btn--outline">{{ settings.clinical_hero_cta2_label | default: 'Xem kết quả khách hàng' }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if pc_ba_hero_video != blank -%}
    <div class="pc-ba-hero__media pc-ba-hero__media--video">{{ pc_ba_hero_video }}</div>
    {%- elsif pc_ba_hero_single != blank -%}
    <figure class="pc-ba-hero__media"><img src="{{ pc_ba_hero_single }}" alt="{{ settings.clinical_hero_title | default: pc_ba_title | strip_html | escape }}" width="840" height="630" fetchpriority="high"></figure>
    {%- elsif pc_ba_hero_before != blank -%}
    <div class="pc-ba-pair pc-ba-pair--hero">
      <figure class="pc-ba-frame pc-ba-frame--before">
        <img src="{{ pc_ba_hero_before }}" alt="{{ pc_ba_first_title | default: pc_ba_title | escape }} — trước" width="420" height="420" fetchpriority="high">
        <figcaption class="pc-ba-badge">TRƯỚC</figcaption>
      </figure>
      <figure class="pc-ba-frame pc-ba-frame--after">
        <img src="{{ pc_ba_hero_after }}" alt="{{ pc_ba_first_title | default: pc_ba_title | escape }} — sau" width="420" height="420" fetchpriority="high">
        <figcaption class="pc-ba-badge pc-ba-badge--after">SAU</figcaption>
      </figure>
    </div>
    {%- endif -%}
  </section>

  {%- assign pc_ba_strip = settings.clinical_strip | default: 'Dược mỹ phẩm toàn cầu;Giao hàng toàn quốc;Phân tích da;Phác đồ cá nhân hóa;Trị liệu da 1:1 tại Hà Nội' | split: ';' -%}
  <section class="pc-ba-strip">
    <div class="container pc-ba-strip__inner">
      {%- for pc_ba_item in pc_ba_strip -%}{%- assign pc_ba_item_s = pc_ba_item | strip -%}{%- if pc_ba_item_s != blank -%}<span>{{ pc_ba_item_s }}</span>{%- endif -%}{%- endfor -%}
    </div>
  </section>

  <section class="container pc-ba-section">
    <h2 class="pc-ba-h2">{{ settings.clinical_steps_title | default: 'Chăm sóc từ xa hoạt động như thế nào' }}</h2>
    {%- if settings.clinical_steps_sub != blank -%}<p class="pc-ba-sub">{{ settings.clinical_steps_sub }}</p>{%- endif -%}
    <div class="pc-ba-steps">
      {%- for i in (1..4) -%}
      {%- capture pc_ba_k_t -%}clinical_step_{{ i }}_title{%- endcapture -%}
      {%- capture pc_ba_k_d -%}clinical_step_{{ i }}_desc{%- endcapture -%}
      {%- if settings[pc_ba_k_t] != blank -%}
      <div class="pc-ba-card pc-ba-step">
        <div class="pc-ba-step__no">0{{ i }}</div>
        <h3 class="pc-ba-step__title">{{ settings[pc_ba_k_t] }}</h3>
        {%- if settings[pc_ba_k_d] != blank -%}<p class="pc-ba-step__desc">{{ settings[pc_ba_k_d] }}</p>{%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="container pc-ba-section">
    <div class="pc-ba-card pc-ba-time">
      <h2 class="pc-ba-h2 pc-ba-h2--sm">{{ settings.clinical_time_title | default: 'Hãy cho làn da một khoảng thời gian thực tế' }}</h2>
      {%- if settings.clinical_time_sub != blank -%}<p class="pc-ba-time__sub">{{ settings.clinical_time_sub }}</p>{%- endif -%}
      <div class="pc-ba-time__grid">
        {%- for i in (1..3) -%}
        {%- capture pc_ba_k_t -%}clinical_time_{{ i }}_title{%- endcapture -%}
        {%- capture pc_ba_k_d -%}clinical_time_{{ i }}_desc{%- endcapture -%}
        {%- if settings[pc_ba_k_t] != blank -%}
        <div class="pc-ba-time__item">
          <div class="pc-ba-time__title">{{ settings[pc_ba_k_t] }}</div>
          {%- if settings[pc_ba_k_d] != blank -%}<div class="pc-ba-time__desc">{{ settings[pc_ba_k_d] }}</div>{%- endif -%}
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 2026-10-03: 4 ô chỉ số chỉ hiện khi nhập số liệu thật (clinical_stat_*), trống cả 4 ⇒ ẩn. {%- endcomment -%}
  {%- assign pc_cp_stats = 0 -%}
  {%- for i in (1..4) -%}
    {%- capture pc_k_val -%}clinical_stat_{{ i }}_value{%- endcapture -%}
    {%- if settings[pc_k_val] != blank -%}{%- assign pc_cp_stats = pc_cp_stats | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- if pc_cp_stats > 0 -%}
  <section class="container pc-ba-section">
    <div class="pc-ba-stats">
      {%- for i in (1..4) -%}
      {%- capture pc_k_val -%}clinical_stat_{{ i }}_value{%- endcapture -%}
      {%- capture pc_k_lbl -%}clinical_stat_{{ i }}_label{%- endcapture -%}
      {%- if settings[pc_k_val] != blank -%}
      <div class="pc-ba-card pc-ba-stat"><div class="pc-ba-stat__value">{{ settings[pc_k_val] }}</div><div class="pc-ba-stat__label">{{ settings[pc_k_lbl] }}</div></div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- if pc_ba_groups != blank -%}
  {%- comment -%}
    12/11/2026 (người dùng duyệt lại thiết kế Claude Design / Figma 751:1281 "Body-trước&sau"): bỏ bản 18/10 (tab lọc +
    trình chiếu 1 ca, cả slide là link bài) — trở lại lưới thẻ theo NHÓM vấn đề da (2 cột, ≤ 991px 1 cột). Mỗi thẻ:
    tên nhóm + "Case x / n", cặp ảnh có nhãn TRƯỚC/SAU, ‹ chấm › chuyển ca trong nhóm, mô tả ngắn
    (tuổi · tỉnh · theo dõi n tuần / Phác đồ) và nút "Tư vấn phác đồ qua Zalo". Không link sang bài viết chi tiết.
    Dữ liệu ca vẫn là bài viết blog clinical_case_blog_handle đọc qua ba_case_source; thiếu tag nào ⇒ ẩn phần đó.
  {%- endcomment -%}
  {%- assign pc_ba_zalo = settings.contact_zalo | remove: ' ' | remove: '.' | strip -%}
  {%- assign pc_ba_bl = settings.clinical_card_before_label | default: 'Trước' -%}
  {%- assign pc_ba_al = settings.clinical_card_after_label | default: 'Sau' -%}
  <section class="container pc-ba-section" id="pc-ba-results">
    <h2 class="pc-ba-h2">{{ settings.clinical_results_title | default: 'Kết quả của khách hàng' | escape }}</h2>
    {%- if settings.clinical_results_sub != blank -%}<p class="pc-ba-sub">{{ settings.clinical_results_sub | escape }}</p>{%- endif -%}
    {%- comment -%} 12/11/2026 (người dùng: «vẫn giữ thanh nav bên trên»): tab lọc theo nhóm nằm trên lưới thẻ; ≥ 2 nhóm mới hiện. {%- endcomment -%}
    {%- assign pc_ba_gn = 0 -%}{%- for pc_ba_g in pc_ba_group_list -%}{%- if pc_ba_g != blank -%}{%- assign pc_ba_gn = pc_ba_gn | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if pc_ba_gn > 1 -%}
    <div class="pc-bg-tabs" role="toolbar" aria-label="{{ settings.clinical_filter_label | default: 'Lọc theo vấn đề da' | escape }}">
      <button type="button" class="pc-bg-tab" data-ba-filter="" aria-pressed="true">{{ settings.clinical_filter_all | default: 'Tất cả' | escape }}</button>
      {%- for pc_ba_group_name in pc_ba_group_list -%}
      {%- if pc_ba_group_name != blank -%}
      <button type="button" class="pc-bg-tab" data-ba-filter="{{ pc_ba_group_name | handleize }}" aria-pressed="false">{{ pc_ba_group_name | escape }}</button>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- comment -%} 12/11/2026 (người dùng: «cho phân trang vào, 4 mục 1»): 4 thẻ nhóm / trang, áp sau tab lọc; thẻ thứ 5+ ẩn sẵn từ server để không nháy. {%- endcomment -%}
    {%- assign pc_ba_per = 4 -%}{%- assign pc_ba_gi = 0 -%}
    <div class="pc-ba-groups" data-ba-per="{{ pc_ba_per }}">
      {%- for pc_ba_group_name in pc_ba_group_list -%}
      {%- if pc_ba_group_name != blank -%}
      {%- assign pc_ba_pairs = '' -%}{%- assign pc_ba_infos = '' -%}{%- assign pc_ba_n = 0 -%}
      {%- for pc_ba in pc_ba_blog.articles limit: 50 -%}
        {%- assign pc_bs_article = pc_ba -%}{%- include 'ba_case_source' -%}
        {%- assign pc_ba_group = pc_bs_group | default: pc_ba_group_other -%}
        {%- assign pc_ba_ok = false -%}
        {%- if pc_bs_single or pc_bs_before != blank and pc_bs_after != blank -%}{%- assign pc_ba_ok = true -%}{%- endif -%}
        {%- if pc_ba_ok and pc_ba_group == pc_ba_group_name -%}
        {%- comment -%}
          Ảnh và mô tả in thành 2 dãy riêng để thanh ‹ chấm › nằm giữa (đúng thiết kế); JS bật cùng chỉ số.
          12/11/2026: ca 1 ảnh (pc_bs_single) ⇒ MỖI ảnh (đại diện + ảnh trong Nội dung) là 1 slide nguyên khung, không nhãn,
          dùng chung mô tả của ca.
        {%- endcomment -%}
        {%- capture pc_ba_meta -%}
          {%- if pc_bs_age != blank -%}{%- assign pc_ba_age_l = pc_bs_age | downcase -%}<span>{{ pc_bs_age | escape }}{% unless pc_ba_age_l contains 'tuổi' %} tuổi{% endunless %}</span>{%- endif -%}
          {%- if pc_bs_city != blank -%}<span>{{ pc_bs_city | escape }}</span>{%- endif -%}
          {%- if pc_bs_weeks != blank -%}<span>Theo dõi {{ pc_bs_weeks | escape }} tuần</span>{%- endif -%}
        {%- endcapture -%}
        {%- capture pc_ba_info -%}
          {%- if pc_ba_meta != blank -%}<p class="pc-ba-case__meta">{{ pc_ba_meta }}</p>{%- endif -%}
          {%- if pc_bs_plan != blank -%}<p class="pc-ba-case__plan">{{ settings.clinical_article_plan_label | default: 'Phác đồ' | escape }}: {{ pc_bs_plan | escape }}</p>{%- endif -%}
          {%- comment -%} 14/11/2026 (chủ dự án): mô tả ca = Tóm tắt của bài; trống ⇒ thẻ văn bản (đoạn) ĐẦU TIÊN trong Nội dung. CSS chặn 3 dòng + «…». {%- endcomment -%}
          {%- assign pc_ba_desc_t = pc_ba.summary | strip_html | strip -%}
          {%- if pc_ba_desc_t == blank -%}{%- assign pc_ba_desc_parts = pc_ba.content | split: '</p>' -%}{%- for pc_ba_desc_p in pc_ba_desc_parts -%}{%- assign pc_ba_desc_x = pc_ba_desc_p | strip_html | strip -%}{%- if pc_ba_desc_x != blank and pc_ba_desc_t == blank -%}{%- assign pc_ba_desc_t = pc_ba_desc_x -%}{%- endif -%}{%- endfor -%}{%- endif -%}
          {%- if pc_ba_desc_t != blank -%}<p class="pc-ba-case__desc">{{ pc_ba_desc_t | truncate: 240 }}</p>{%- endif -%}
        {%- endcapture -%}
        {%- if pc_bs_single -%}
        {%- assign pc_ba_imgs = pc_bs_imgs | split: '|' -%}
        {%- for pc_ba_src in pc_ba_imgs -%}{%- if pc_ba_src != blank -%}
        {%- assign pc_ba_n = pc_ba_n | plus: 1 -%}
        {%- capture pc_ba_one -%}
          <figure class="pc-ba-frame pc-ba-frame--single" data-ba-case{% if pc_ba_n > 1 %} hidden{% endif %}>
            <img src="{{ pc_ba_src }}" alt="{{ pc_ba.title | escape }}{% if pc_ba_imgs.size > 1 %} — ảnh {{ forloop.index }}{% endif %}" width="560" height="420" loading="lazy" decoding="async">
          </figure>
        {%- endcapture -%}
        {%- assign pc_ba_pairs = pc_ba_pairs | append: pc_ba_one -%}
        {%- capture pc_ba_one -%}<div class="pc-ba-case__info" data-ba-info{% if pc_ba_n > 1 %} hidden{% endif %}>{{ pc_ba_info }}</div>{%- endcapture -%}
        {%- assign pc_ba_infos = pc_ba_infos | append: pc_ba_one -%}
        {%- endif -%}{%- endfor -%}
        {%- else -%}
        {%- assign pc_ba_n = pc_ba_n | plus: 1 -%}
        {%- capture pc_ba_one -%}
          <div class="pc-ba-pair" data-ba-case{% if pc_ba_n > 1 %} hidden{% endif %}>
            <figure class="pc-ba-frame pc-ba-frame--before">
              <img src="{{ pc_bs_before }}" alt="{{ pc_ba.title | escape }} — {{ pc_ba_bl | escape }}" width="280" height="280" loading="lazy" decoding="async">
              <figcaption class="pc-ba-badge" aria-hidden="true">{{ pc_ba_bl | upcase | escape }}</figcaption>
            </figure>
            <figure class="pc-ba-frame pc-ba-frame--after">
              <img src="{{ pc_bs_after }}" alt="{{ pc_ba.title | escape }} — {{ pc_ba_al | escape }}" width="280" height="280" loading="lazy" decoding="async">
              <figcaption class="pc-ba-badge pc-ba-badge--after" aria-hidden="true">{{ pc_ba_al | upcase | escape }}</figcaption>
            </figure>
          </div>
        {%- endcapture -%}
        {%- assign pc_ba_pairs = pc_ba_pairs | append: pc_ba_one -%}
        {%- capture pc_ba_one -%}<div class="pc-ba-case__info" data-ba-info{% if pc_ba_n > 1 %} hidden{% endif %}>{{ pc_ba_info }}</div>{%- endcapture -%}
        {%- assign pc_ba_infos = pc_ba_infos | append: pc_ba_one -%}
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign pc_ba_gi = pc_ba_gi | plus: 1 -%}
      <div class="pc-ba-card pc-ba-group" data-ba-group data-ba-cat="{{ pc_ba_group_name | handleize }}"{% if pc_ba_gi > pc_ba_per %} hidden{% endif %}>
        <div class="pc-ba-group__head">
          <h3 class="pc-ba-group__title">{{ pc_ba_group_name | upcase | escape }}</h3>
          <p class="pc-ba-group__counter" aria-live="polite">Case <span data-ba-current>1</span> / {{ pc_ba_n }}</p>
        </div>
        {{ pc_ba_pairs }}
        {%- if pc_ba_n > 1 -%}
        <div class="pc-ba-nav">
          <button type="button" class="pc-ba-nav__btn" data-ba-prev aria-label="Ca trước"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-left', size: 'em' %}</i></button>
          <div class="pc-ba-nav__dots">
            {%- for i in (1..pc_ba_n) -%}
            <button type="button" class="pc-ba-nav__dot" data-ba-dot aria-label="Xem ca {{ i }}"{% if i == 1 %} aria-current="true"{% endif %}><span></span></button>
            {%- endfor -%}
          </div>
          <button type="button" class="pc-ba-nav__btn pc-ba-nav__btn--solid" data-ba-next aria-label="Ca sau"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 'em' %}</i></button>
        </div>
        {%- endif -%}
        {{ pc_ba_infos }}
        {%- if pc_ba_zalo != blank -%}
        <a href="https://zalo.me/{{ pc_ba_zalo }}" target="_blank" rel="noopener" class="pc-ba-btn pc-ba-btn--primary pc-ba-group__cta">{{ settings.clinical_case_cta_label | default: 'Tư vấn phác đồ qua Zalo' | escape }}</a>
        {%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
    <nav class="pc-ba-pager" data-ba-pager aria-label="Phân trang kết quả" hidden>
      <button type="button" class="pc-ba-pager__btn" data-ba-page-prev aria-label="Trang trước"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-left', size: 'em' %}</i></button>
      <span class="pc-ba-pager__nums" data-ba-page-nums></span>
      <button type="button" class="pc-ba-pager__btn" data-ba-page-next aria-label="Trang sau"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'chevron-right', size: 'em' %}</i></button>
    </nav>
    {%- if settings.clinical_note != blank -%}<p class="pc-ba-note">{{ settings.clinical_note | escape }}</p>{%- endif -%}
  </section>
  {%- endif -%}

  <section class="container pc-ba-section pc-ba-section--last">
    <div class="pc-ba-final">
      <div class="pc-ba-final__text">
        <h2 class="pc-ba-final__title">{{ settings.clinical_final_title | default: 'Bạn gặp tình trạng da tương tự?' }}</h2>
        {%- if settings.clinical_final_text != blank -%}<p class="pc-ba-final__desc">{{ settings.clinical_final_text }}</p>{%- endif -%}
      </div>
      <div class="pc-ba-actions">
        <a href="{{ pc_ba_cta_link }}" class="pc-ba-btn pc-ba-btn--light">{{ settings.clinical_final_cta_label | default: 'Phân tích da miễn phí' }}</a>
        {%- if settings.clinical_final_cta2_label != blank -%}
        <a href="{{ settings.clinical_final_cta2_link | default: '/dat-lich-tu-van' }}" class="pc-ba-btn pc-ba-btn--ghost">{{ settings.clinical_final_cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</main>
<script>
  /* 12/11/2026: chuyển ca trong từng thẻ nhóm (‹ ›, chấm, vuốt ngang) — ảnh và mô tả đổi cùng chỉ số. */
  /* Tab lọc ("" = tất cả) + phân trang N thẻ / trang trên danh sách đã lọc. */
  (function () {
    var grid = document.querySelector('[data-ba-per]');
    if (!grid) return;
    var per = parseInt(grid.getAttribute('data-ba-per'), 10) || 4;
    var pager = document.querySelector('[data-ba-pager]');
    var tabs = document.querySelectorAll('[data-ba-filter]');
    var cards = [].slice.call(grid.querySelectorAll('[data-ba-group]'));
    var cat = '', page = 0;
    var nums = pager.querySelector('[data-ba-page-nums]');
    var prev = pager.querySelector('[data-ba-page-prev]'), next = pager.querySelector('[data-ba-page-next]');
    prev.addEventListener('click', function () { page -= 1; render(true); });
    next.addEventListener('click', function () { page += 1; render(true); });
    function render(scroll) {
      var list = cards.filter(function (c) { return cat === '' || c.getAttribute('data-ba-cat') === cat; });
      var pages = Math.max(1, Math.ceil(list.length / per));
      if (page >= pages) page = pages - 1;
      cards.forEach(function (c) { c.hidden = true; });
      list.slice(page * per, page * per + per).forEach(function (c) { c.hidden = false; });
      pager.hidden = pages < 2;
      prev.disabled = page === 0; next.disabled = page === pages - 1;
      nums.innerHTML = '';
      for (var i = 0; i < pages; i++) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'pc-ba-pager__btn'; b.textContent = i + 1; b.setAttribute('aria-label', 'Trang ' + (i + 1));
        if (i === page) b.setAttribute('aria-current', 'page');
        b.addEventListener('click', (function (k) { return function () { page = k; render(true); }; })(i));
        nums.appendChild(b);
      }
      if (scroll) document.getElementById('pc-ba-results').scrollIntoView({ block: 'start' });
    }
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        cat = tab.getAttribute('data-ba-filter'); page = 0;
        tabs.forEach(function (t) { t.setAttribute('aria-pressed', t === tab ? 'true' : 'false'); });
        render(false);
      });
    });
    render(false);
  })();
  document.querySelectorAll('[data-ba-group]').forEach(function (group) {
    var cases = group.querySelectorAll('[data-ba-case]');
    if (cases.length < 2) return;
    var infos = group.querySelectorAll('[data-ba-info]');
    var dots = group.querySelectorAll('[data-ba-dot]');
    var current = group.querySelector('[data-ba-current]');
    var index = 0;
    function show(i) {
      index = (i + cases.length) % cases.length;
      cases.forEach(function (c, k) { c.hidden = k !== index; });
      infos.forEach(function (c, k) { c.hidden = k !== index; });
      dots.forEach(function (d, k) { if (k === index) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); } });
      if (current) current.textContent = index + 1;
    }
    group.querySelector('[data-ba-prev]').addEventListener('click', function () { show(index - 1); });
    group.querySelector('[data-ba-next]').addEventListener('click', function () { show(index + 1); });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { show(k); }); });
    var x0 = null;
    group.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    group.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });
</script>
