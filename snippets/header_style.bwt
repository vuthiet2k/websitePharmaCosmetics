{%if template contains 'blog' or template contains 'article'%}{{ 'comp_sidebar.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'product'%}{{ 'page_product.scss.css' | asset_url | stylesheet_tag }}{%endif%}
