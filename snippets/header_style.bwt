{%if template contains 'index'%}{{ 'page_home.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains '404'%}{{ 'page_404.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'page'%}{{ 'page_static.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'cart'%}{{ 'page_cart.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'blog' or template contains 'article'%}{{ 'page_blog.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'blog' or template contains 'article'%}{{ 'comp_sidebar.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'product'%}{{ 'page_product.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'contact'%}{{ 'page_contact.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'customers'%}{{ 'page_account.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'page.khuyen-mai'%}{{ 'page_promo.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'collection' or template contains 'search'%}{{ 'page_collection.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%if template contains 'search'%}{{ 'page_search.scss.css' | asset_url | stylesheet_tag }}{%endif%}
{%- if customer -%}{{ 'comp_loyalty.scss.css' | asset_url | stylesheet_tag }}{%- endif -%}
