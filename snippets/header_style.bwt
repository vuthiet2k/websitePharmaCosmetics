{%- unless template contains 'page.dat_hang_nhanh' -%}
{{ 'comp_quickview_cart.scss.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%endif%}
{%- if template contains 'page.dat_hang_nhanh' -%}
<link rel="preload" as='style'  type="text/css" href="{{ 'comp_quickview_buy.scss.css' | asset_url }}">
{{ 'comp_quickview_buy.scss.css' | asset_url | stylesheet_tag }}
{%- endif -%}