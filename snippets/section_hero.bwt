<section class="hero">
  <div class="wrap">
    <div>
      <p class="eyebrow">{{ settings.home_hero_badge | default: 'Dược mỹ phẩm toàn cầu · Chuẩn y khoa' | escape }}</p>
      {% assign portal_hero_heading = settings.home_hero_title | default: 'Làn da của bạn là một hồ sơ khoa học riêng biệt.' | escape | newline_to_br %}
      {% assign portal_hero_highlight = settings.portal_hero_highlight | escape %}
      {% if portal_hero_highlight != blank %}{% capture portal_hero_emphasis %}<em>{{ portal_hero_highlight }}</em>{% endcapture %}{% assign portal_hero_heading = portal_hero_heading | replace: portal_hero_highlight, portal_hero_emphasis %}{% endif %}
      <h1>{{ portal_hero_heading }}</h1>
      <p class="sub">{{ settings.home_hero_desc | escape }}</p>
      <div class="cta">
        <a class="btn btn-p" href="{{ settings.home_hero_btn1_url | default: '/dat-lich-tu-van' | escape }}">{{ settings.home_hero_btn1_text | default: 'Đặt lịch phân tích da' | escape }} →</a>
        <a class="btn btn-o" href="{{ settings.home_hero_btn2_url | default: '/collections/all' | escape }}">{{ settings.home_hero_btn2_text | default: 'Khám phá sản phẩm' | escape }}</a>
      </div>
      <div class="trust">
        {% for i in (1..3) %}
          {% capture trust_key %}portal_hero_trust_{{ i }}{% endcapture %}
          {% if settings[trust_key] != blank %}<div>{{ settings[trust_key] | escape }}</div>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% if settings.portal_hero_visual == 'image' and settings.home_hero_image != blank %}
      <img class="portal-hero-image" src="{{ settings.home_hero_image | img_url: '1024x' }}" alt="{{ settings.home_hero_title | escape }}" width="470" height="470" fetchpriority="high">
    {% else %}{% include 'portal_skin_diagram' %}{% endif %}
  </div>
</section>
