{% assign hero_slide_count = 0 %}
<section class="hero portal-hero" data-portal-hero data-delay="{{ settings.home_hero_delay | default: 5000 }}" data-autoplay="{{ settings.home_hero_autoplay }}" aria-labelledby="portal-hero-title">
  <div class="portal-hero__media swiper-container" id="portalHeroMedia" aria-hidden="true">
    {% if settings.portal_hero_visual == 'image' and settings.home_hero_image != blank %}
    <div class="swiper-wrapper">
      {% for i in (1..5) %}
        {% if i == 1 %}
          {% assign hero_image = settings.home_hero_image %}
          {% assign hero_image_alt = settings.home_hero_image_alt | default: settings.home_hero_title %}
        {% else %}
          {% capture hero_image_key %}home_hero_image_{{ i }}{% endcapture %}
          {% capture hero_alt_key %}home_hero_image_{{ i }}_alt{% endcapture %}
          {% assign hero_image = settings[hero_image_key] %}
          {% assign hero_image_alt = settings[hero_alt_key] | default: settings.home_hero_title %}
        {% endif %}
        {% if hero_image != blank %}
          {% assign hero_slide_count = hero_slide_count | plus: 1 %}
          <div class="swiper-slide portal-hero__slide portal-hero__slide--{{ i }}">
            {% if i == 1 and settings.home_hero_mobile_image != blank %}
            <picture>
              <source media="(max-width: 680px)" srcset="{{ settings.home_hero_mobile_image | img_url: '800x' }}">
            {% endif %}
              <img class="portal-hero__image portal-hero__image--{{ i }}" src="{{ hero_image | img_url: '1920x' }}" data-hero-source="{{ hero_image | img_url: '1920x' }}" alt="{{ hero_image_alt | escape }}" width="1920" height="800"{% if i == 1 %} loading="eager" fetchpriority="high"{% else %} loading="lazy" fetchpriority="low"{% endif %}>
            {% if i == 1 and settings.home_hero_mobile_image != blank %}
            </picture>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% else %}
    <div class="portal-hero__diagram">{% include 'portal_skin_diagram' %}</div>
    {% endif %}
  </div>
  <div class="portal-hero__mask" aria-hidden="true"></div>
  <div class="wrap portal-hero__content">
    <div class="portal-hero__copy">
      <p class="eyebrow">{{ settings.home_hero_badge | default: 'Dược mỹ phẩm toàn cầu · Chuẩn y khoa' | escape }}</p>
      {% assign portal_hero_heading = settings.home_hero_title | default: 'Làn da của bạn là một hồ sơ khoa học riêng biệt.' | escape | newline_to_br %}
      {% assign portal_hero_highlight = settings.portal_hero_highlight | escape %}
      {% if portal_hero_highlight != blank %}{% capture portal_hero_emphasis %}<em>{{ portal_hero_highlight }}</em>{% endcapture %}{% assign portal_hero_heading = portal_hero_heading | replace: portal_hero_highlight, portal_hero_emphasis %}{% endif %}
      <h1 id="portal-hero-title">{{ portal_hero_heading }}</h1>
      <p class="sub">{{ settings.home_hero_desc | escape }}</p>
      <div class="cta">
        <a class="btn btn-p" href="{{ settings.home_hero_btn1_url | default: '/dat-lich-tu-van' | escape }}">{{ settings.home_hero_btn1_text | default: 'Đặt lịch phân tích da' | escape }} →</a>
        <a class="btn btn-o" href="{{ settings.home_hero_btn2_url | default: '#section_solutions' | escape }}">{{ settings.home_hero_btn2_text | default: 'Chọn theo vấn đề da' | escape }}</a>
      </div>
      <div class="trust">
        {% for i in (1..3) %}
          {% capture trust_key %}portal_hero_trust_{{ i }}{% endcapture %}
          {% if settings[trust_key] != blank %}<div>{{ settings[trust_key] | escape }}</div>{% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
  {% if hero_slide_count > 1 %}
  <button class="portal-hero__pause" type="button" data-hero-pause aria-controls="portalHeroMedia" aria-label="Tạm dừng ảnh nền" aria-pressed="false">
    <svg data-icon-pause width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    <svg data-icon-play width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false" hidden><path d="m5 3 8 5-8 5V3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  </button>
  {% endif %}
</section>
