{%- comment -%}
  lieu_trinh_info — thông tin dịch vụ & đặt lịch: bảng (hình thức · thời gian · liệu trình · giá · địa điểm) từ tag sản phẩm +
  giá sản phẩm; khối đặt lịch (nút gắn ?handle=<alias> ⇒ trang đặt lịch chọn sẵn liệu trình) + hotline + dòng thương hiệu;
  thanh đặt lịch bám đáy mobile (lt_sticky_cta).
{%- endcomment -%}
{%- assign lt_phone = settings.store_phone -%}
{%- assign lt_price = lt_product.selected_or_first_available_variant.price | default: lt_product.price -%}
<section id="service-booking-section" class="lt-section lt-section--white">
  <div class="container">
    <div class="lt-info">
      <div>
        {%- if settings.lt_info_eyebrow != blank -%}<p class="lt-eyebrow">{{ settings.lt_info_eyebrow | escape }}</p>{%- endif -%}
        <h2 class="lt-title lt-upper">{{ lt_short | escape }} 1:1</h2>
        {%- if settings.lt_info_text != blank -%}<p class="lt-lead">{{ settings.lt_info_text | replace: '[ten]', lt_short | escape }}</p>{%- endif -%}
        <dl class="lt-spec">
          {%- assign lt_v = lt_hinhthuc | default: settings.lt_info_form_default -%}
          {%- if lt_v != blank -%}<div class="lt-spec__row"><dt>{{ settings.lt_info_form_label | escape }}</dt><dd>{{ lt_v | escape }}</dd></div>{%- endif -%}
          {%- if lt_thoigian != blank -%}<div class="lt-spec__row"><dt>{{ settings.lt_info_time_label | escape }}</dt><dd>{{ lt_thoigian | escape }}</dd></div>{%- endif -%}
          {%- assign lt_v = lt_sobuoi | default: settings.lt_info_sessions_default -%}
          {%- if lt_v != blank -%}<div class="lt-spec__row"><dt>{{ settings.lt_info_sessions_label | escape }}</dt><dd>{{ lt_v | escape }}</dd></div>{%- endif -%}
          {%- unless lt_hide_price -%}<div class="lt-spec__row"><dt>{{ settings.lt_info_price_label | escape }}</dt><dd>{% if lt_price > 0 %}<strong>{{ lt_price | money }}</strong>{% else %}{{ settings.lt_info_price_contact | escape }}{% endif %}</dd></div>{%- endunless -%}
          {%- assign lt_v = lt_diadiem | default: settings.lt_info_place_default -%}
          {%- if lt_v != blank -%}<div class="lt-spec__row"><dt>{{ settings.lt_info_place_label | escape }}</dt><dd>{{ lt_v | escape }}</dd></div>{%- endif -%}
        </dl>
        {%- comment -%} 2026-10-18: mô tả chi tiết sản phẩm mở trong modal (snippets/lieu_trinh_details.bwt). {%- endcomment -%}
        {%- if lt_product.content != blank -%}
        {%- comment -%} L03b6 (31/10/2026): icon ui_icon thay FA — `text-xs` thay quy tắc cũ `.lt-spec__more .fa-arrow-right` (12px),
          `-mx-px` bù hộp SVG 1em rộng hơn glyph FA 0,75em ⇒ nút giữ bề rộng cũ. {%- endcomment -%}
        <button type="button" class="lt-spec__more" data-lt-modal-open="lt-details-modal" aria-haspopup="dialog"><i class="inline-block leading-none -mx-px" aria-hidden="true">{% include 'ui_icon', name: 'file-text', size: 'em' %}</i> {{ settings.lt_details_title | default: 'Thông tin chi tiết liệu trình' | escape }} <i class="inline-block leading-none text-xs -mx-px" aria-hidden="true">{% include 'ui_icon', name: 'arrow-right', size: 'em' %}</i></button>
        {%- endif -%}
      </div>
      <div class="lt-booking">
        <h3 class="lt-booking__title">{{ settings.lt_booking_title | escape }}</h3>
        <div class="lt-actions">
          <a href="{{ lt_cta_url | escape }}" class="lt-btn lt-btn--primary"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'calendar-check', size: 'em' %}</i> {{ lt_cta_text | escape }}</a>
          {%- if lt_zalo_url != blank -%}<a href="{{ lt_zalo_url | escape }}" class="lt-btn lt-btn--light" target="_blank" rel="noopener"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 'em' %}</i> {{ lt_zalo_text | escape }}</a>{%- endif -%}
          {%- if lt_phone != blank -%}<a href="tel:{{ lt_phone | remove: ' ' | remove: '.' }}" class="lt-btn lt-btn--light"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'phone', size: 'em' %}</i> {{ lt_phone | escape }}</a>{%- endif -%}
        </div>
        {%- if settings.lt_brand_lines != blank -%}
        <div class="lt-brand">
          {%- assign lt_lines = settings.lt_brand_lines | newline_to_br | split: '<br />' -%}
          {%- for lt_l in lt_lines -%}{%- assign lt_l = lt_l | strip -%}{%- if lt_l != blank -%}<p{% if forloop.first %} class="lt-brand__name"{% endif %}>{{ lt_l | escape }}</p>{%- endif -%}{%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- if settings.lt_sticky_cta -%}
<div id="peel-mobile-sticky-cta" class="lt-sticky" aria-hidden="true">
  {%- comment -%} 04/11/2026: có Zalo ⇒ nút Liên hệ tư vấn (Zalo) thay Hotline trên thanh bám đáy. {%- endcomment -%}
  {%- if lt_zalo_url != blank -%}<a href="{{ lt_zalo_url | escape }}" class="lt-btn lt-btn--light" target="_blank" rel="noopener" tabindex="-1"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'message-circle', size: 'em' %}</i> {{ lt_zalo_text | escape }}</a>
  {%- elsif lt_phone != blank -%}<a href="tel:{{ lt_phone | remove: ' ' | remove: '.' }}" class="lt-btn lt-btn--light" tabindex="-1"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'phone', size: 'em' %}</i> Hotline</a>{%- endif -%}
  <a href="{{ lt_cta_url | escape }}" class="lt-btn lt-btn--primary" tabindex="-1"><i class="inline-block leading-none" aria-hidden="true">{% include 'ui_icon', name: 'calendar-check', size: 'em' %}</i> {{ lt_cta_text | escape }}</a>
</div>
{%- endif -%}
