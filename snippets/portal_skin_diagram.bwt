<div class="ring">
      <svg viewBox="0 0 400 400" role="img" aria-label="Sơ đồ phân tích lớp da">
        <circle cx="200" cy="200" r="152" fill="none" stroke="#DCE5DF" stroke-width="1"/>
        <circle cx="200" cy="200" r="112" fill="none" stroke="#DCE5DF" stroke-width="1"/>
        <circle cx="200" cy="200" r="72" fill="none" stroke="#3CB371" stroke-width="1.4" stroke-dasharray="2 6"/>
        <circle cx="200" cy="200" r="36" fill="#003F2D"/>
        <path d="M186 200l9 9 19-19" fill="none" stroke="#3CB371" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="286" cy="148" r="4.5" fill="#075B40"/>
        <circle cx="118" cy="256" r="4.5" fill="#3CB371"/>
        <circle cx="216" cy="332" r="4.5" fill="#075B40"/>
        <line x1="286" y1="148" x2="332" y2="104" stroke="#DCE5DF" stroke-width="1"/>
        <line x1="118" y1="256" x2="54" y2="272" stroke="#DCE5DF" stroke-width="1"/>
        <line x1="216" y1="332" x2="240" y2="374" stroke="#DCE5DF" stroke-width="1"/>
      </svg>
      <div class="tag t1"><i></i>{% if portal_diagram_clinic %}Chỉ số đo được{% else %}Vùng tăng sắc tố{% endif %}</div>
      <div class="tag t2"><i></i>{% if portal_diagram_clinic %}Phác đồ theo giai đoạn{% else %}Hàng rào bảo vệ{% endif %}</div>
      <div class="tag t3"><i></i>{% if portal_diagram_clinic %}Tái khám &amp; hiệu chỉnh{% else %}Vùng cần phục hồi{% endif %}</div>
    </div>
