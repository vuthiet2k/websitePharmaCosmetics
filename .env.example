# ── Zero-Wait Path (2026-08-10) ─────────────────────────────────────────────
# Vercel deployment reads these env vars via Project Settings → Environment
# Variables. `.env` is loaded by dev-server.js locally too — see there for
# how mops_gas_url / mops_edge_url settings get injected into preview.

# Google Apps Script Web App /exec URL. Called by api/gas.js proxy and by FE
# fallback when EDGE URL is empty. REQUIRED to run anything.
GAS_URL=
# Legacy alias — kept for backward compat with dev-server.js. If set, wins over
# the Sapo settings_data value in local preview.
MOPS_GAS_URL=

# ── Vercel KV (Upstash Redis REST) — populated automatically when you connect
#    KV via Vercel dashboard → Storage → Create → KV. If left blank, the Edge
#    Function soft-disables rate limit / edge cache / queue and just proxies. ─
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Shared secret for /api/queue/pop and /api/queue/nack ─────────────────────
# GAS ScriptProperties.MOPS_EDGE_SECRET must equal this. Generate with:
#   openssl rand -hex 32
MOPS_EDGE_SECRET=

# ── Optional preview server settings ─────────────────────────────────────────
# PORT=3000
# WS_PORT=3001
